{
  "name": "dbasic",
  "displayName": "DBasic",
  "description": "DBasic language support - syntax highlighting, snippets, and LSP integration for the BASIC-to-Go transpiler",
  "version": "0.5.0",
  "publisher": "zditech",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zditech/dbasic"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dbasic"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dbasic",
        "aliases": [
          "DBasic",
          "dbasic",
          "DBASIC"
        ],
        "extensions": [
          ".dbas",
          ".dbasic"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dbasic.png",
          "dark": "./icons/dbasic.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "dbasic",
        "scopeName": "source.dbasic",
        "path": "./syntaxes/dbasic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dbasic",
        "path": "./snippets/dbasic.json"
      }
    ],
    "configuration": {
      "title": "DBasic",
      "properties": {
        "dbasic.lspPath": {
          "type": "string",
          "default": "dbasic-lsp",
          "description": "Path to the dbasic-lsp binary. If left as the default, it must be on your PATH."
        },
        "dbasic.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the dbasic-lsp language server (diagnostics, hover, completions, definition, references, rename, signature help)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
