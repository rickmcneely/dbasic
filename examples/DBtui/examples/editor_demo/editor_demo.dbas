' Fired for every mouse event. We only act on clicks (handled via cv_Click);
' motion and wheel are ignored here.
SUB Form_Mouse(kind AS STRING, button AS STRING, x AS INTEGER, y AS INTEGER)
    _ = kind
    _ = button
    _ = x
    _ = y
END SUB
