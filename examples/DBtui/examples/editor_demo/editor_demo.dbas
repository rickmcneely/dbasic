IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "runtime"
IMPORT "os/exec" AS exec
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM _formW AS INTEGER
    DIM _formH AS INTEGER
    DIM _maximized AS BOOLEAN
    DIM _minimized AS BOOLEAN
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentProgram AS POINTER TO tea.Program
TYPE _dbtuiWakeMsg
    DIM n AS INTEGER
END TYPE
SUB _dbtuiWake()
    IF _currentProgram <> NIL THEN
        DIM _wm AS _dbtuiWakeMsg
        _currentProgram.Send(_wm)
    END IF
END SUB
DIM _dbtuiKeyConsumed AS BOOLEAN
SUB ConsumeKey()
    _dbtuiKeyConsumed = TRUE
END SUB
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM _wkMsg AS _dbtuiWakeMsg
    DIM _wkOk AS BOOLEAN
    _wkMsg, _wkOk = msg.(_dbtuiWakeMsg)
    IF _wkOk THEN
        _ = _wkMsg
        Form_Wake()
        RETURN m, NIL
    END IF
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        _formSize(@m)
        Terminal_Resize(m.Width, m.Height)
        RETURN m, NIL
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk THEN
        DIM _fmb AS STRING = "left"
        IF mc.Button = tea.MouseRight THEN _fmb = "right"
        Form_Mouse("click", _fmb, mc.X, mc.Y)
    END IF
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF mc.Y = 0 THEN
            DIM gstart AS INTEGER = m._formW - 1 - 2
            DIM ggi AS INTEGER = (mc.X - gstart) / 2
            IF mc.X >= gstart AND ggi = 0 THEN
                Form_Close()
                RETURN m, tea.Quit
            END IF
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 74 AND mc.Y >= 2 AND mc.Y < 2 + 18 THEN
            m.Focus = 1
            cv_Click(mc.X - 2, mc.Y - 2)
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 66 AND mc.Y >= 1 AND mc.Y < 1 + 1 THEN
            m.Focus = 0
            _ = mc
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        Form_Mouse("motion", "", mm.X, mm.Y)
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 2 AND mm.X < 2 + 74 AND mm.Y >= 2 AND mm.Y < 2 + 18 THEN mmHit = 1
        IF mmHit < 0 AND mm.X >= 2 AND mm.X < 2 + 66 AND mm.Y >= 1 AND mm.Y < 1 + 1 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        DIM _fmw AS STRING = "up"
        IF mw.Button = tea.MouseWheelDown THEN _fmw = "down"
        Form_Mouse("wheel", _fmw, mw.X, mw.Y)
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        _dbtuiKeyConsumed = FALSE
        Form_Key(key)
        IF _dbtuiKeyConsumed THEN RETURN m, NIL
        IF key = "ctrl+c" OR key = "esc" THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 2
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 1
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            _ = key
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

SUB _formSize(m AS POINTER TO Model)
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    IF m._maximized THEN
        m._formW = w
        m._formH = h
    ELSE
        m._formW = (w)
        m._formH = (h)
    END IF
    IF m._formW < 3 THEN m._formW = 3
    IF m._formW > w THEN m._formW = w
    IF m._formH < 2 THEN m._formH = 2
    IF m._formH > h THEN m._formH = h
    IF m._minimized THEN m._formH = 1
END SUB

FUNCTION _formBox(fw AS INTEGER, fh AS INTEGER, gh AS STRING, gv AS STRING, tl AS STRING, tr AS STRING, bl AS STRING, br AS STRING, caption AS STRING, glyphs AS STRING) AS STRING
    DIM innerW AS INTEGER = fw - 2
    IF innerW < 0 THEN innerW = 0
    DIM cap AS STRING = ""
    IF caption <> "" THEN cap = " " + caption + " "
    DIM used AS INTEGER = lipgloss.Width(cap) + lipgloss.Width(glyphs)
    DIM fill AS INTEGER = innerW - used
    IF fill < 0 THEN fill = 0
    DIM out AS STRING = tl + cap + strings.Repeat(gh, fill) + glyphs + tr
    IF fh <= 1 THEN RETURN out
    DIM r AS INTEGER
    FOR r = 0 TO fh - 3
        out = out + "\n" + gv + strings.Repeat(" ", innerW) + gv
    NEXT r
    out = out + "\n" + bl + strings.Repeat(gh, innerW) + br
    RETURN out
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM body0 AS STRING
    body0 = "arrows/home/end move · enter splits · backspace joins · ^S status"
    DIM vw0 AS STRING = compFocusView(body0, m.Focus = 0, m.Hover = 0)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw0).X(2).Y(1).Z(10)
    DIM cv1 AS STRING = cv_Render(74 + (m._formW - 77), 18 + (m._formH - 21))
    cv1 = lipgloss.NewStyle().Width(74 + (m._formW - 77)).Height(18 + (m._formH - 21)).Render(cv1)
    DIM ly1 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(cv1).X(2).Y(2).Z(11)
    DIM formBoxStr AS STRING = _formBox(m._formW, m._formH, "─", "│", "╭", "╮", "╰", "╯", "Editor Demo", "✕ ")
    DIM formLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(formBoxStr).X(0).Y(0).Z(1)
    IF m._minimized THEN
        DIM mBase AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
        DIM mCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(mBase, formLy)
        DIM mvw AS tea.View = tea.NewView(mCmp.Render())
        mvw.MouseMode = tea.MouseModeAllMotion
        mvw.AltScreen = TRUE
        RETURN mvw
    END IF
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, formLy, ly0, ly1)
    fullView = cmpLy.Render()
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

' _dbtuiRelaunchInTerminal — on Windows, relaunch this program inside
' Windows Terminal (wt.exe) at the form size, then exit. No-op when
' already inside Terminal, when wt.exe is missing, or off Windows.
SUB _dbtuiRelaunchInTerminal()
    IF runtime.GOOS <> "windows" THEN RETURN
    IF os.Getenv("WT_SESSION") <> "" THEN RETURN
    IF os.Getenv("DBTUI_IN_TERMINAL") <> "" THEN RETURN
    DIM _wt AS STRING
    DIM _e AS ERROR
    _wt, _e = exec.LookPath("wt.exe")
    IF _e <> NIL THEN RETURN
    DIM _self AS STRING
    _self, _e = os.Executable()
    IF _e <> NIL THEN RETURN
    DIM _c AS POINTER TO exec.Cmd = exec.Command(_wt, "--size", "77,21", "--title", "Editor Demo", _self)
    _c.Env = APPEND(os.Environ(), "DBTUI_IN_TERMINAL=1")
    _e = _c.Start()
    IF _e <> NIL THEN RETURN
    os.Exit(0)
END SUB

' _dbtuiApplyRequestedSize — honor a "--size cols,rows" argument by
' resizing the terminal (CSI 8;rows;cols t) before the UI starts.
SUB _dbtuiApplyRequestedSize()
    DIM _args AS []STRING = os.Args
    DIM _i AS INTEGER
    FOR _i = 1 TO LEN(_args) - 1
        IF _args[_i] = "--size" AND _i + 1 <= LEN(_args) - 1 THEN
            DIM _p AS []STRING = strings.Split(_args[_i + 1], ",")
            IF LEN(_p) = 2 THEN fmt.Print(Chr(27) + "[8;" + strings.TrimSpace(_p[1]) + ";" + strings.TrimSpace(_p[0]) + "t")
        END IF
    NEXT _i
END SUB

SUB Main()
    _dbtuiRelaunchInTerminal()
    _dbtuiApplyRequestedSize()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    _formSize(@m)
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    _currentProgram = prog
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE =====
' Your code below — DBtui preserves everything here on F5.

' === editor_demo ===========================================================
' A complete multi-line text editor built entirely on ONE Canvas widget plus
' the raw Form_Key / cv_Click hooks. There is no TextArea widget here: DBtui
' hands us a W x H rectangle and we own every cell. This proves that DBtui's
' own source editor (internal/pad.dbas) is reproducible in generated DBasic.
'
' State model (all the editor's memory lives in these globals):
'   gLines  the text buffer, one STRING per line (always at least one line).
'   gRow    cursor line   (0-based index into gLines).
'   gCol    cursor column (0-based character offset within gLines[gRow]).
'   gTop    first visible line  — vertical scroll offset.
'   gLeft   first visible column — horizontal scroll offset.
'   gW,gH   the canvas size we were last asked to render (so the key handler
'           and click handler can clamp without guessing the screen size).
'   gStatus a one-line message shown in the gutter's last row.
DIM gLines AS []STRING
DIM gRow AS INTEGER
DIM gCol AS INTEGER
DIM gTop AS INTEGER
DIM gLeft AS INTEGER
DIM gW AS INTEGER = 74
DIM gH AS INTEGER = 18
DIM gStatus AS STRING

' --- small buffer helpers -------------------------------------------------

' curLine — the text of the line the cursor is on. Safe even if the buffer
' somehow emptied (returns "").
FUNCTION curLine() AS STRING
    IF gRow < 0 OR gRow >= LEN(gLines) THEN RETURN ""
    RETURN gLines[gRow]
END FUNCTION

' lineInsert — return xs with val spliced in at index idx (BASIC-style copy,
' no slice aliasing surprises).
FUNCTION lineInsert(xs AS []STRING, idx AS INTEGER, val AS STRING) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i = idx THEN out = APPEND(out, val)
        out = APPEND(out, xs[i])
    NEXT i
    IF idx >= LEN(xs) THEN out = APPEND(out, val)
    RETURN out
END FUNCTION

' lineRemove — return xs with the entry at idx dropped.
FUNCTION lineRemove(xs AS []STRING, idx AS INTEGER) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i <> idx THEN out = APPEND(out, xs[i])
    NEXT i
    RETURN out
END FUNCTION

' gutterDigits — how many digit columns the line-number gutter needs for the
' current buffer size (minimum 2, e.g. "_7", "42", "128").
FUNCTION gutterDigits() AS INTEGER
    DIM n AS INTEGER = LEN(gLines)
    DIM digits AS INTEGER = 1
    WHILE n >= 10
        n = n / 10
        digits = digits + 1
    WEND
    IF digits < 2 THEN digits = 2
    RETURN digits
END FUNCTION

' --- rendering ------------------------------------------------------------

' Render for canvas cv — paint the visible window of the buffer with a
' line-number gutter and a reverse-video cursor cell. Called every frame, so
' this is also where we keep the cursor scrolled into view (we finally know
' the real w x h here).
FUNCTION cv_Render(w AS INTEGER, h AS INTEGER) AS STRING
    gW = w
    gH = h

    ' Gutter is: <digits right-aligned> + " | " (a space, a bar, a space).
    DIM dig AS INTEGER = gutterDigits()
    DIM gutW AS INTEGER = dig + 3
    DIM textW AS INTEGER = w - gutW
    IF textW < 1 THEN textW = 1

    ' Scroll so the cursor stays on screen, both axes.
    IF gRow < gTop THEN gTop = gRow
    IF gRow >= gTop + h THEN gTop = gRow - h + 1
    IF gCol < gLeft THEN gLeft = gCol
    IF gCol >= gLeft + textW THEN gLeft = gCol - textW + 1
    IF gTop < 0 THEN gTop = 0
    IF gLeft < 0 THEN gLeft = 0

    DIM gutStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#565f89"))
    DIM curNumStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#e0af68")).Bold(TRUE)
    DIM revStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

    DIM rows AS []STRING
    DIM sy AS INTEGER
    FOR sy = 0 TO h - 1
        DIM li AS INTEGER = gTop + sy
        IF li >= LEN(gLines) THEN
            ' Past end-of-buffer: a faint tilde, vi-style.
            rows = APPEND(rows, gutStyle.Render(strings.Repeat(" ", dig) + " ~ "))
        ELSE
            ' Gutter: the current line's number is highlighted.
            DIM numTxt AS STRING = fmt.Sprintf("%*d", dig, li + 1)
            DIM gut AS STRING
            IF li = gRow THEN
                gut = curNumStyle.Render(numTxt) + gutStyle.Render(" | ")
            ELSE
                gut = gutStyle.Render(numTxt + " | ")
            END IF
            ' Text: the horizontally-scrolled window of this line.
            DIM seg AS STRING = Mid(gLines[li], gLeft + 1, textW)
            IF li = gRow THEN
                rows = APPEND(rows, gut + drawWithCursor(seg, gCol - gLeft, revStyle))
            ELSE
                rows = APPEND(rows, gut + seg)
            END IF
        END IF
    NEXT sy

    ' Bottom row doubles as a status line when there's a message. lipgloss
    ' .Width(w) pads/truncates to w display cells, so no manual (and
    ' panic-prone) padding math is needed.
    IF gStatus <> "" AND h > 0 THEN
        DIM stStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#1a1b26")).Background(lipgloss.Color("#7aa2f7")).Width(w)
        rows[h - 1] = stStyle.Render(" " + gStatus)
    END IF

    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' drawWithCursor — render one visible text segment with the cell at column
' hlCol reverse-videoed. hlCol is relative to the segment; if it falls outside
' the segment we draw a reverse space at the end (the cursor past line-end).
FUNCTION drawWithCursor(seg AS STRING, hlCol AS INTEGER, rev AS lipgloss.Style) AS STRING
    IF hlCol < 0 THEN RETURN seg
    DIM before AS STRING = Left(seg, hlCol)
    DIM ch AS STRING = Mid(seg, hlCol + 1, 1)
    IF ch = "" THEN ch = " "
    DIM after AS STRING = ""
    IF hlCol + 1 < LEN(seg) THEN after = Right(seg, LEN(seg) - hlCol - 1)
    RETURN before + rev.Render(ch) + after
END FUNCTION

' --- mouse ----------------------------------------------------------------

' Left-click inside canvas cv — drop the cursor at the clicked cell. x,y are
' 0-based cells within the canvas; we subtract the gutter width and add the
' scroll offsets to land on a real buffer position.
SUB cv_Click(x AS INTEGER, y AS INTEGER)
    DIM li AS INTEGER = gTop + y
    IF li >= LEN(gLines) THEN li = LEN(gLines) - 1
    IF li < 0 THEN li = 0
    gRow = li
    DIM gutW AS INTEGER = gutterDigits() + 3
    DIM col AS INTEGER = (x - gutW) + gLeft
    IF col < 0 THEN col = 0
    IF col > LEN(gLines[gRow]) THEN col = LEN(gLines[gRow])
    gCol = col
    gStatus = ""
END SUB

' --- keyboard -------------------------------------------------------------

' Fired for every key press, before built-in handling. We implement the full
' editing surface here: cursor movement, insertion, line split/join.
' (TAB is left alone — DBtui's chrome still uses it to cycle widget focus.)
SUB Form_Key(key AS STRING)
    DIM cur AS STRING = curLine()

    ' --- cursor movement ---
    IF key = "left" THEN
        IF gCol > 0 THEN
            gCol = gCol - 1
        ELSEIF gRow > 0 THEN
            gRow = gRow - 1
            gCol = LEN(gLines[gRow])
        END IF
        RETURN
    END IF
    IF key = "right" THEN
        IF gCol < LEN(cur) THEN
            gCol = gCol + 1
        ELSEIF gRow < LEN(gLines) - 1 THEN
            gRow = gRow + 1
            gCol = 0
        END IF
        RETURN
    END IF
    IF key = "up" THEN
        IF gRow > 0 THEN gRow = gRow - 1
        IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
        RETURN
    END IF
    IF key = "down" THEN
        IF gRow < LEN(gLines) - 1 THEN gRow = gRow + 1
        IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
        RETURN
    END IF
    IF key = "home" THEN
        gCol = 0
        RETURN
    END IF
    IF key = "end" THEN
        gCol = LEN(cur)
        RETURN
    END IF
    IF key = "pgup" THEN
        gRow = gRow - gH
        IF gRow < 0 THEN gRow = 0
        IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
        RETURN
    END IF
    IF key = "pgdown" THEN
        gRow = gRow + gH
        IF gRow > LEN(gLines) - 1 THEN gRow = LEN(gLines) - 1
        IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
        RETURN
    END IF

    ' --- ENTER: split the current line at the cursor ---
    IF key = "enter" THEN
        DIM head AS STRING = Left(cur, gCol)
        DIM tail AS STRING = Right(cur, LEN(cur) - gCol)
        gLines[gRow] = head
        gLines = lineInsert(gLines, gRow + 1, tail)
        gRow = gRow + 1
        gCol = 0
        gStatus = ""
        RETURN
    END IF

    ' --- BACKSPACE: delete left, or join with the previous line ---
    IF key = "backspace" THEN
        IF gCol > 0 THEN
            gLines[gRow] = Left(cur, gCol - 1) + Right(cur, LEN(cur) - gCol)
            gCol = gCol - 1
        ELSEIF gRow > 0 THEN
            DIM prevLen AS INTEGER = LEN(gLines[gRow - 1])
            gLines[gRow - 1] = gLines[gRow - 1] + cur
            gLines = lineRemove(gLines, gRow)
            gRow = gRow - 1
            gCol = prevLen
        END IF
        gStatus = ""
        RETURN
    END IF

    ' --- DELETE: delete right, or pull up the next line ---
    IF key = "delete" THEN
        IF gCol < LEN(cur) THEN
            gLines[gRow] = Left(cur, gCol) + Right(cur, LEN(cur) - gCol - 1)
        ELSEIF gRow < LEN(gLines) - 1 THEN
            gLines[gRow] = cur + gLines[gRow + 1]
            gLines = lineRemove(gLines, gRow + 1)
        END IF
        gStatus = ""
        RETURN
    END IF

    ' --- Ctrl+S: a fake "save", just to show command keys work ---
    IF key = "ctrl+s" THEN
        gStatus = fmt.Sprintf("saved %d lines (demo only - nothing written)", LEN(gLines))
        RETURN
    END IF

    ' --- text entry: SPACE and any single printable character insert ---
    DIM ch AS STRING = ""
    IF key = "space" THEN ch = " "
    IF LEN(key) = 1 THEN ch = key
    IF ch <> "" THEN
        gLines[gRow] = Left(cur, gCol) + ch + Right(cur, LEN(cur) - gCol)
        gCol = gCol + 1
        gStatus = ""
    END IF
END SUB

' --- lifecycle ------------------------------------------------------------

' Fired once at startup — seed the buffer with a little welcome text so the
' editor opens with something to move around in.
SUB Form_Load()
    gLines = APPEND(gLines, "' editor_demo — a text editor on a single Canvas.")
    gLines = APPEND(gLines, "'")
    gLines = APPEND(gLines, "' Type to insert.  Arrows / Home / End / PgUp / PgDn move.")
    gLines = APPEND(gLines, "' Enter splits a line, Backspace joins, Delete pulls up.")
    gLines = APPEND(gLines, "' Click anywhere to place the cursor.  Ctrl+S = demo save.")
    gLines = APPEND(gLines, "")
    gLines = APPEND(gLines, "FUNCTION greet(name AS STRING) AS STRING")
    gLines = APPEND(gLines, "    RETURN \"Hello, \" + name + \"!\"")
    gLines = APPEND(gLines, "END FUNCTION")
    gRow = 6
    gCol = 0
END SUB

' Fired whenever the TERMINAL size changes. The Canvas stretches on its own
' (Anchors T,B,L,R); cv_Render reclamps scrolling, so nothing to do here.
SUB Terminal_Resize(w AS INTEGER, h AS INTEGER)
    _ = w
    _ = h
END SUB

