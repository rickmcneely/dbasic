' Fired on the UI thread after a background goroutine calls _dbtuiWake().
' Use it to push async updates (e.g. fresh data) into widgets. Edit freely.
SUB Form_Wake()
    ' TODO: your code here.
END SUB

' Fired for every key press. Arrow keys move the cursor (clamped to the
' canvas size we recorded last render); space/enter toggles the dot under it.
SUB Form_Key(key AS STRING)
    IF key = "up" AND gCurY > 0 THEN gCurY = gCurY - 1
    IF key = "down" AND gCurY < gH - 1 THEN gCurY = gCurY + 1
    IF key = "left" AND gCurX > 0 THEN gCurX = gCurX - 1
    IF key = "right" AND gCurX < gW - 1 THEN gCurX = gCurX + 1
    IF key = "space" OR key = "enter" THEN
        gDots[cellKey(gCurX, gCurY)] = NOT gDots[cellKey(gCurX, gCurY)]
    END IF
END SUB

' Fired for every mouse event. kind = "click" | "motion" | "wheel";
' button = "left" / "right" / "up" / "down" / ""; x,y are terminal cells. Edit freely.
SUB Form_Mouse(kind AS STRING, button AS STRING, x AS INTEGER, y AS INTEGER)
    ' TODO: your code here.
    _ = kind
    _ = button
    _ = x
    _ = y
END SUB
