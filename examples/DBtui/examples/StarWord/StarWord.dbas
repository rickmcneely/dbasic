' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "runtime"
IMPORT "os/exec" AS exec
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM _formW AS INTEGER
    DIM _formH AS INTEGER
    DIM _maximized AS BOOLEAN
    DIM _minimized AS BOOLEAN
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentProgram AS POINTER TO tea.Program
TYPE _dbtuiWakeMsg
    DIM n AS INTEGER
END TYPE
SUB _dbtuiWake()
    IF _currentProgram <> NIL THEN
        DIM _wm AS _dbtuiWakeMsg
        _currentProgram.Send(_wm)
    END IF
END SUB
DIM _dbtuiKeyConsumed AS BOOLEAN
SUB ConsumeKey()
    _dbtuiKeyConsumed = TRUE
END SUB
DIM _dbtuiQuitReq AS BOOLEAN
SUB RequestQuit()
    _dbtuiQuitReq = TRUE
END SUB
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM _wkMsg AS _dbtuiWakeMsg
    DIM _wkOk AS BOOLEAN
    _wkMsg, _wkOk = msg.(_dbtuiWakeMsg)
    IF _wkOk THEN
        _ = _wkMsg
        Form_Wake()
        RETURN m, NIL
    END IF
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        _formSize(@m)
        Terminal_Resize(m.Width, m.Height)
        RETURN m, NIL
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk THEN
        DIM _fmb AS STRING = "left"
        IF mc.Button = tea.MouseRight THEN _fmb = "right"
        Form_Mouse("click", _fmb, mc.X, mc.Y)
        IF _dbtuiQuitReq THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
    END IF
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF mc.Y = 0 THEN
            DIM gstart AS INTEGER = m._formW - 1 - 2
            DIM ggi AS INTEGER = (mc.X - gstart) / 2
            IF mc.X >= gstart AND ggi = 0 THEN
                Form_Close()
                RETURN m, tea.Quit
            END IF
        END IF
        IF mc.X >= 1 AND mc.X < 1 + 78 AND mc.Y >= 1 AND mc.Y < 1 + 22 THEN
            m.Focus = 0
            sw_Click(mc.X - 1, mc.Y - 1)
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        Form_Mouse("motion", "", mm.X, mm.Y)
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 1 AND mm.X < 1 + 78 AND mm.Y >= 1 AND mm.Y < 1 + 22 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        DIM _fmw AS STRING = "up"
        IF mw.Button = tea.MouseWheelDown THEN _fmw = "down"
        Form_Mouse("wheel", _fmw, mw.X, mw.Y)
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        _dbtuiKeyConsumed = FALSE
        Form_Key(key)
        IF _dbtuiQuitReq THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF _dbtuiKeyConsumed THEN RETURN m, NIL
        IF key = "ctrl+c" OR key = "esc" THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 1
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 0
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

SUB _formSize(m AS POINTER TO Model)
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    IF m._maximized THEN
        m._formW = w
        m._formH = h
    ELSE
        m._formW = (w)
        m._formH = (h)
    END IF
    IF m._formW < 3 THEN m._formW = 3
    IF m._formW > w THEN m._formW = w
    IF m._formH < 2 THEN m._formH = 2
    IF m._formH > h THEN m._formH = h
    IF m._minimized THEN m._formH = 1
END SUB

FUNCTION _formBox(fw AS INTEGER, fh AS INTEGER, gh AS STRING, gv AS STRING, tl AS STRING, tr AS STRING, bl AS STRING, br AS STRING, caption AS STRING, glyphs AS STRING) AS STRING
    DIM innerW AS INTEGER = fw - 2
    IF innerW < 0 THEN innerW = 0
    DIM cap AS STRING = ""
    IF caption <> "" THEN cap = " " + caption + " "
    DIM used AS INTEGER = lipgloss.Width(cap) + lipgloss.Width(glyphs)
    DIM fill AS INTEGER = innerW - used
    IF fill < 0 THEN fill = 0
    DIM out AS STRING = tl + cap + strings.Repeat(gh, fill) + glyphs + tr
    IF fh <= 1 THEN RETURN out
    DIM r AS INTEGER
    FOR r = 0 TO fh - 3
        out = out + "\n" + gv + strings.Repeat(" ", innerW) + gv
    NEXT r
    out = out + "\n" + bl + strings.Repeat(gh, innerW) + br
    RETURN out
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM cv0 AS STRING = sw_Render(78 + (m._formW - 80), 22 + (m._formH - 24))
    cv0 = lipgloss.NewStyle().Width(78 + (m._formW - 80)).Height(22 + (m._formH - 24)).Render(cv0)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(cv0).X(1).Y(1).Z(10)
    DIM formBoxStr AS STRING = _formBox(m._formW, m._formH, "─", "│", "╭", "╮", "╰", "╯", "StarWord", "✕ ")
    DIM formLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(formBoxStr).X(0).Y(0).Z(1)
    IF m._minimized THEN
        DIM mBase AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
        DIM mCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(mBase, formLy)
        DIM mvw AS tea.View = tea.NewView(mCmp.Render())
        mvw.MouseMode = tea.MouseModeAllMotion
        mvw.AltScreen = TRUE
        RETURN mvw
    END IF
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, formLy, ly0)
    fullView = cmpLy.Render()
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

' _dbtuiRelaunchInTerminal — on Windows, relaunch this program inside
' Windows Terminal (wt.exe) at the form size, then exit. No-op when
' already inside Terminal, when wt.exe is missing, or off Windows.
SUB _dbtuiRelaunchInTerminal()
    IF runtime.GOOS <> "windows" THEN RETURN
    IF os.Getenv("WT_SESSION") <> "" THEN RETURN
    IF os.Getenv("DBTUI_IN_TERMINAL") <> "" THEN RETURN
    DIM _wt AS STRING
    DIM _e AS ERROR
    _wt, _e = exec.LookPath("wt.exe")
    IF _e <> NIL THEN RETURN
    DIM _self AS STRING
    _self, _e = os.Executable()
    IF _e <> NIL THEN RETURN
    DIM _c AS POINTER TO exec.Cmd = exec.Command(_wt, "--size", "80,24", "--title", "StarWord", _self)
    _c.Env = APPEND(os.Environ(), "DBTUI_IN_TERMINAL=1")
    _e = _c.Start()
    IF _e <> NIL THEN RETURN
    os.Exit(0)
END SUB

' _dbtuiApplyRequestedSize — honor a "--size cols,rows" argument by
' resizing the terminal (CSI 8;rows;cols t) before the UI starts.
SUB _dbtuiApplyRequestedSize()
    DIM _args AS []STRING = os.Args
    DIM _i AS INTEGER
    FOR _i = 1 TO LEN(_args) - 1
        IF _args[_i] = "--size" AND _i + 1 <= LEN(_args) - 1 THEN
            DIM _p AS []STRING = strings.Split(_args[_i + 1], ",")
            IF LEN(_p) = 2 THEN fmt.Print(Chr(27) + "[8;" + strings.TrimSpace(_p[1]) + ";" + strings.TrimSpace(_p[0]) + "t")
        END IF
    NEXT _i
END SUB

SUB Main()
    _dbtuiRelaunchInTerminal()
    _dbtuiApplyRequestedSize()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    _formSize(@m)
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    _currentProgram = prog
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE =====
' Your code below — DBtui preserves everything here on F5.

' === StarWord =============================================================
' A modern reimplementation of WordStar 7.0 for DOS, built on ONE DBtui
' Canvas plus the raw Form_Key/Form_Mouse hooks. It is FUNCTIONALLY identical
' to WordStar (the same control-key "diamond", the ^K / ^Q prefix menus, block
' operations, find/replace, the status line + ruler) but VISUALLY modern
' (a clean WordStar-blue palette). It reads & writes both classic WordStar
' files and Unicode files; a Unicode file is marked by appending "u" to the
' WordStar extension (e.g. LETTER.WS -> LETTER.WSu).
'
' Layout inside the canvas (h rows):
'   row 0          status line  (file, line/col, insert mode, encoding)
'   row 1          ruler line   (margins L..R, tab stops)
'   rows 2..h-2    text area    (the document; cursor + block highlight)
'   row h-1        message / prompt line
'
' v1 note: editing is byte-based (Mid/Left/Right), which is exact for ASCII
' and classic WordStar text. Unicode FILES round-trip correctly via
' Encode/Decode; rune-precise cursor motion through multibyte glyphs is a
' planned refinement.

' --- document + cursor state ----------------------------------------------
DIM gLines AS []STRING       ' the document, one STRING per line (>=1 line)
DIM gRow AS INTEGER          ' cursor line   (0-based)
DIM gCol AS INTEGER          ' cursor column (0-based byte offset)
DIM gTop AS INTEGER          ' first visible line   (vertical scroll)
DIM gLeft AS INTEGER         ' first visible column (horizontal scroll)
DIM gW AS INTEGER = 78       ' last-rendered canvas size (for clamping)
DIM gH AS INTEGER = 22
DIM gInsert AS BOOLEAN = TRUE ' INSERT (TRUE) vs OVERTYPE (FALSE) — ^V toggles

' --- file state -----------------------------------------------------------
DIM gFileName AS STRING = "untitled.WSu"
DIM gIsUnicode AS BOOLEAN = TRUE     ' .WSu etc. -> UTF-8; otherwise WS/ASCII
DIM gModified AS BOOLEAN

' --- command state --------------------------------------------------------
DIM gPrefix AS STRING        ' pending prefix: "" | "K" | "Q" | "O" | "P" | "J"
DIM gMessage AS STRING       ' transient status message on the message line

' --- pull-down menu bar (WordStar 7 keybindings: Alt+F/E/V/I/S/L/U/H) ------
DIM gMenuOpen AS INTEGER = 0 - 1   ' -1 = closed; else index of the open menu
DIM gMenuSel AS INTEGER            ' highlighted item in the open menu

' --- block markers (row/col; -1 = unset) ----------------------------------
DIM gBBRow AS INTEGER = 0 - 1
DIM gBBCol AS INTEGER
DIM gBERow AS INTEGER = 0 - 1
DIM gBECol AS INTEGER
DIM gBlockShow AS BOOLEAN = TRUE      ' ^KH toggles marker/highlight display

' --- ruler / margins ------------------------------------------------------
DIM gLeftMargin AS INTEGER = 0
DIM gRightMargin AS INTEGER = 65

' --- find / replace -------------------------------------------------------
DIM gFindStr AS STRING
DIM gReplaceStr AS STRING

' --- modal prompt on the message line -------------------------------------
DIM gPromptMode AS STRING    ' "" | "find" | "rfind" | "rwith" | "saveas"
DIM gPromptText AS STRING
DIM gPromptLabel AS STRING

' ==========================================================================
' Small buffer helpers
' ==========================================================================

FUNCTION curLine() AS STRING
    IF gRow < 0 OR gRow >= LEN(gLines) THEN RETURN ""
    RETURN gLines[gRow]
END FUNCTION

FUNCTION lastRow() AS INTEGER
    RETURN LEN(gLines) - 1
END FUNCTION

' clampCursor — keep gRow/gCol inside the buffer.
SUB clampCursor()
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    IF gRow < 0 THEN gRow = 0
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gCol < 0 THEN gCol = 0
    IF gCol > LEN(gLines[gRow]) THEN gCol = LEN(gLines[gRow])
END SUB

' --- UTF-8 rune helpers ---------------------------------------------------
' gCol is a byte offset, but a Unicode glyph can be 1-4 bytes. These keep the
' cursor on rune boundaries and let edits act on whole runes, so a multibyte
' character is never split (e.g. backspacing over "é" deletes both its bytes).

' runeLenAt — byte length of the rune that begins at byte offset pos.
FUNCTION runeLenAt(line AS STRING, pos AS INTEGER) AS INTEGER
    DIM b AS BYTES = Encode(line)
    IF pos < 0 OR pos >= LEN(line) THEN RETURN 1
    DIM lead AS INTEGER = Int(b[pos])
    IF lead < 128 THEN RETURN 1
    IF lead < 224 THEN RETURN 2
    IF lead < 240 THEN RETURN 3
    RETURN 4
END FUNCTION

' prevRuneStart — byte offset of the rune ending just before pos (steps back
' over UTF-8 continuation bytes 0x80..0xBF).
FUNCTION prevRuneStart(line AS STRING, pos AS INTEGER) AS INTEGER
    IF pos <= 0 THEN RETURN 0
    DIM b AS BYTES = Encode(line)
    DIM k AS INTEGER = pos - 1
    WHILE k > 0 AND Int(b[k]) >= 128 AND Int(b[k]) < 192
        k = k - 1
    WEND
    RETURN k
END FUNCTION

' nextRuneStart — byte offset of the rune after the one beginning at pos.
FUNCTION nextRuneStart(line AS STRING, pos AS INTEGER) AS INTEGER
    DIM n AS INTEGER = LEN(line)
    IF pos >= n THEN RETURN n
    DIM nx AS INTEGER = pos + runeLenAt(line, pos)
    IF nx > n THEN nx = n
    RETURN nx
END FUNCTION

' runeIndexOf — count of runes before byte offset bytePos (for the Col display).
FUNCTION runeIndexOf(line AS STRING, bytePos AS INTEGER) AS INTEGER
    DIM cnt AS INTEGER = 0
    DIM p AS INTEGER = 0
    WHILE p < bytePos AND p < LEN(line)
        p = nextRuneStart(line, p)
        cnt = cnt + 1
    WEND
    RETURN cnt
END FUNCTION

' snapToRune — nudge a byte offset back onto the nearest rune start at or
' before it (used to keep horizontal scroll on a rune boundary).
FUNCTION snapToRune(line AS STRING, pos AS INTEGER) AS INTEGER
    IF pos <= 0 THEN RETURN 0
    IF pos >= LEN(line) THEN RETURN LEN(line)
    DIM b AS BYTES = Encode(line)
    DIM k AS INTEGER = pos
    WHILE k > 0 AND Int(b[k]) >= 128 AND Int(b[k]) < 192
        k = k - 1
    WEND
    RETURN k
END FUNCTION

' isWordCh — alphanumeric or underscore (for ^A / ^F word motion).
FUNCTION isWordCh(ch AS STRING) AS BOOLEAN
    IF ch = "" THEN RETURN FALSE
    ' A multibyte rune (é, ñ, …) is a word character (accented letters, CJK).
    IF LEN(ch) > 1 THEN RETURN TRUE
    DIM a AS INTEGER = Asc(ch)
    IF a >= 48 AND a <= 57 THEN RETURN TRUE
    IF a >= 65 AND a <= 90 THEN RETURN TRUE
    IF a >= 97 AND a <= 122 THEN RETURN TRUE
    IF a = 95 THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' runeAt — the rune (1-4 byte string) beginning at byte offset pos, or "".
FUNCTION runeAt(line AS STRING, pos AS INTEGER) AS STRING
    IF pos < 0 OR pos >= LEN(line) THEN RETURN ""
    RETURN Mid(line, pos + 1, runeLenAt(line, pos))
END FUNCTION

' setDoc / cursorFromOffset — flat-string model used by block operations.
SUB setDoc(s AS STRING)
    gLines = strings.Split(s, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
END SUB

FUNCTION offsetOf(r AS INTEGER, c AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO r - 1
        off = off + LEN(gLines[i]) + 1
    NEXT i
    DIM cc AS INTEGER = c
    IF cc > LEN(gLines[r]) THEN cc = LEN(gLines[r])
    RETURN off + cc
END FUNCTION

SUB cursorFromOffset(off AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        DIM ll AS INTEGER = LEN(gLines[i])
        IF off <= ll THEN
            gRow = i
            gCol = off
            RETURN
        END IF
        off = off - (ll + 1)
    NEXT i
    gRow = lastRow()
    gCol = LEN(gLines[gRow])
END SUB

' ==========================================================================
' Block helpers
' ==========================================================================

' blockSet — both markers placed?
FUNCTION blockSet() AS BOOLEAN
    RETURN gBBRow >= 0 AND gBERow >= 0
END FUNCTION

' blockBounds — markers normalized so (sR,sC) precedes (eR,eC) in the document.
FUNCTION blockBounds() AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM beforeBE AS BOOLEAN = (gBBRow < gBERow) OR (gBBRow = gBERow AND gBBCol <= gBECol)
    IF beforeBE THEN RETURN gBBRow, gBBCol, gBERow, gBECol
    RETURN gBERow, gBECol, gBBRow, gBBCol
END FUNCTION

' isInBlock — is cell (r,c) inside the marked, shown block?
FUNCTION isInBlock(r AS INTEGER, c AS INTEGER) AS BOOLEAN
    IF NOT gBlockShow THEN RETURN FALSE
    IF NOT blockSet() THEN RETURN FALSE
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM afterStart AS BOOLEAN = (r > sR) OR (r = sR AND c >= sC)
    DIM beforeEnd AS BOOLEAN = (r < eR) OR (r = eR AND c < eC)
    RETURN afterStart AND beforeEnd
END FUNCTION

' blockText — the marked text as one string (with embedded newlines).
FUNCTION blockText() AS STRING
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    RETURN Mid(doc, s + 1, e - s)
END FUNCTION

SUB blockDelete()
    IF NOT blockSet() THEN RETURN
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    setDoc(Left(doc, s) + Right(doc, LEN(doc) - e))
    cursorFromOffset(s)
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Block deleted"
END SUB

SUB blockCopyTo(destR AS INTEGER, destC AS INTEGER)
    IF NOT blockSet() THEN RETURN
    DIM blk AS STRING = blockText()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM d AS INTEGER = offsetOf(destR, destC)
    setDoc(Left(doc, d) + blk + Right(doc, LEN(doc) - d))
    cursorFromOffset(d + LEN(blk))
    gModified = TRUE
    gMessage = "Block copied"
END SUB

SUB blockMoveTo(destR AS INTEGER, destC AS INTEGER)
    IF NOT blockSet() THEN RETURN
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    DIM blk AS STRING = Mid(doc, s + 1, e - s)
    DIM d AS INTEGER = offsetOf(destR, destC)
    ' Adjust the insertion point for the about-to-be-removed span.
    DIM d2 AS INTEGER = s
    IF d >= e THEN
        d2 = d - (e - s)
    ELSEIF d <= s THEN
        d2 = d
    END IF
    DIM removed AS STRING = Left(doc, s) + Right(doc, LEN(doc) - e)
    setDoc(Left(removed, d2) + blk + Right(removed, LEN(removed) - d2))
    cursorFromOffset(d2 + LEN(blk))
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Block moved"
END SUB

' ==========================================================================
' File I/O — reads/writes WordStar and Unicode (.WSu) files
' ==========================================================================

' detectUnicode — a file is Unicode when its name ends in "u"/"U" (the .WSu
' convention: a "u" appended to the WordStar extension).
FUNCTION detectUnicode(path AS STRING) AS BOOLEAN
    RETURN strings.HasSuffix(LCase(path), "u")
END FUNCTION

SUB loadFile(path AS STRING)
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(path)
    gFileName = path
    gIsUnicode = detectUnicode(path)
    IF e <> NIL THEN
        gLines = nil
        gLines = APPEND(gLines, "")
        gMessage = "New file: " + path
        RETURN
    END IF
    DIM text AS STRING = Decode(data)
    text = strings.ReplaceAll(text, Chr(13) + Chr(10), Chr(10))
    text = strings.ReplaceAll(text, Chr(13), Chr(10))
    gLines = strings.Split(text, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    gMessage = "Opened " + path + "  (" + fmt.Sprintf("%d", LEN(gLines)) + " lines)"
END SUB

SUB saveFile()
    DIM nl AS STRING = Chr(13) + Chr(10)
    IF gIsUnicode THEN nl = Chr(10)
    DIM out AS STRING = strings.Join(gLines, nl)
    DIM e AS ERROR = os.WriteFile(gFileName, Encode(out), 420)
    IF e <> NIL THEN
        gMessage = "Save FAILED: " + e.Error()
        RETURN
    END IF
    gModified = FALSE
    gMessage = "Saved " + gFileName
END SUB

' ==========================================================================
' Find
' ==========================================================================

' findFrom — search forward for gFindStr starting just after (sr,sc).
FUNCTION findFrom(sr AS INTEGER, sc AS INTEGER) AS BOOLEAN
    IF gFindStr = "" THEN RETURN FALSE
    DIM r AS INTEGER
    FOR r = sr TO lastRow()
        DIM startc AS INTEGER = 0
        IF r = sr THEN startc = sc
        DIM hay AS STRING = gLines[r]
        IF startc <= LEN(hay) THEN
            DIM hayb AS STRING = Mid(hay, startc + 1, LEN(hay) - startc)
            DIM idx AS INTEGER = strings.Index(hayb, gFindStr)
            IF idx >= 0 THEN
                gRow = r
                gCol = startc + idx
                RETURN TRUE
            END IF
        END IF
    NEXT r
    RETURN FALSE
END FUNCTION

SUB doFindNext()
    IF findFrom(gRow, gCol + 1) THEN
        gMessage = "Found"
    ELSE
        gMessage = "Not found: " + gFindStr
    END IF
END SUB

' replaceAllFromCursor — replace every gFindStr with gReplaceStr from the
' cursor to end of file (WordStar's ^QA, simplified to replace-all).
SUB replaceAllFromCursor()
    IF gFindStr = "" THEN RETURN
    DIM n AS INTEGER = 0
    WHILE findFrom(gRow, gCol)
        DIM ln AS STRING = gLines[gRow]
        gLines[gRow] = Left(ln, gCol) + gReplaceStr + Right(ln, LEN(ln) - gCol - LEN(gFindStr))
        gCol = gCol + LEN(gReplaceStr)
        n = n + 1
    WEND
    gModified = (n > 0)
    gMessage = fmt.Sprintf("Replaced %d occurrence(s)", n)
END SUB

' ==========================================================================
' Rendering
' ==========================================================================

' swFit — clip (by char count) or space-pad s to exactly width cells.
FUNCTION swFit(s AS STRING, width AS INTEGER) AS STRING
    IF width <= 0 THEN RETURN ""
    IF LEN(s) >= width THEN RETURN Left(s, width)
    RETURN s + strings.Repeat(" ", width - LEN(s))
END FUNCTION

' renderTextRow — one document row, windowed to [gLeft, gLeft+w), with the
' cursor cell and any block cells highlighted. Uses run-length batching so a
' plain row costs a single styled Render.
FUNCTION renderTextRow(rowIdx AS INTEGER, w AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    RETURN renderTextRange(rowIdx, 0, w, baseSt, cur, blk)
END FUNCTION

' renderTextRange — render display cells [fromCell, fromCell+count) of a
' document row (used to splice a dropdown box over part of a text row).
FUNCTION renderTextRange(rowIdx AS INTEGER, fromCell AS INTEGER, count AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    DIM line AS STRING = ""
    IF rowIdx >= 0 AND rowIdx <= lastRow() THEN line = gLines[rowIdx]
    DIM out AS STRING = ""
    DIM buf AS STRING = ""
    DIM bufCls AS INTEGER = 0 - 1     ' 0 base, 1 cursor, 2 block
    ' Walk one rune per display cell (snapped to a rune boundary) so a
    ' multibyte glyph occupies a single cell and is highlighted as a unit.
    DIM pos AS INTEGER = snapToRune(line, gLeft)
    DIM skip AS INTEGER
    FOR skip = 1 TO fromCell
        IF pos < LEN(line) THEN pos = nextRuneStart(line, pos)
    NEXT skip
    DIM i AS INTEGER
    FOR i = 0 TO count - 1
        DIM ch AS STRING = " "
        DIM rl AS INTEGER = 1
        IF pos < LEN(line) THEN
            rl = runeLenAt(line, pos)
            ch = Mid(line, pos + 1, rl)
        END IF
        DIM cls AS INTEGER = 0
        IF rowIdx = gRow AND pos = gCol THEN
            cls = 1
        ELSEIF isInBlock(rowIdx, pos) THEN
            cls = 2
        END IF
        pos = pos + rl
        IF cls <> bufCls AND buf <> "" THEN
            IF bufCls = 1 THEN
                out = out + cur.Render(buf)
            ELSEIF bufCls = 2 THEN
                out = out + blk.Render(buf)
            ELSE
                out = out + baseSt.Render(buf)
            END IF
            buf = ""
        END IF
        bufCls = cls
        buf = buf + ch
    NEXT i
    IF buf <> "" THEN
        IF bufCls = 1 THEN
            out = out + cur.Render(buf)
        ELSEIF bufCls = 2 THEN
            out = out + blk.Render(buf)
        ELSE
            out = out + baseSt.Render(buf)
        END IF
    END IF
    RETURN out
END FUNCTION

' prefixMenuLines — the modernized pop-up help band for the active prefix.
FUNCTION prefixMenuLines() AS []STRING
    DIM xs AS []STRING
    IF gPrefix = "K" THEN
        xs = APPEND(xs, "BLOCK & SAVE    ^KB Begin   ^KK End   ^KC Copy   ^KV Move   ^KY Delete   ^KH Hide   ^K< Unmark")
        xs = APPEND(xs, "                ^KS Save    ^KD Save+Exit   ^KX Save+Exit   ^KQ Abandon   (Esc cancels)")
    ELSEIF gPrefix = "Q" THEN
        xs = APPEND(xs, "QUICK MOVE      ^QS LineStart  ^QD LineEnd  ^QE ScrTop  ^QX ScrBot  ^QR FileTop  ^QC FileEnd")
        xs = APPEND(xs, "                ^QF Find   ^QA Replace   ^QB BlockStart   ^QK BlockEnd   ^QY Del->EOL")
    ELSEIF gPrefix = "O" THEN
        xs = APPEND(xs, "ONSCREEN FORMAT   margins, tabs, justification, word-wrap — coming in a later StarWord build.")
        xs = APPEND(xs, "                  (Esc cancels)")
    ELSEIF gPrefix = "P" THEN
        xs = APPEND(xs, "PRINT CONTROLS    bold/italic/underline tags & dot commands — coming in a later StarWord build.")
        xs = APPEND(xs, "                  (Esc cancels)")
    ELSEIF gPrefix = "J" THEN
        xs = APPEND(xs, "HELP   Cursor: ^E up ^X down ^S left ^D right  |  ^A/^F word  |  ^R/^C screen  |  Home/End line")
        xs = APPEND(xs, "       Edit:   ^G del  ^T del-word  ^Y del-line  ^N ins-line  ^V ins/over   Prefixes: ^K ^Q ^O ^P")
    END IF
    RETURN xs
END FUNCTION

' ==========================================================================
' Pull-down menu bar (WordStar 7 keybindings)
' ==========================================================================

' The eight editing-screen menus, opened with Alt+<first letter>.
FUNCTION menuCount() AS INTEGER
    RETURN 8
END FUNCTION

FUNCTION menuTitle(i AS INTEGER) AS STRING
    SELECT CASE i
    CASE 0
        RETURN "File"
    CASE 1
        RETURN "Edit"
    CASE 2
        RETURN "View"
    CASE 3
        RETURN "Insert"
    CASE 4
        RETURN "Style"
    CASE 5
        RETURN "Layout"
    CASE 6
        RETURN "Utilities"
    CASE 7
        RETURN "Help"
    END SELECT
    RETURN ""
END FUNCTION

' menuTitleX — starting column of menu i in the bar (1 leading space, then
' each title followed by two spaces).
FUNCTION menuTitleX(i AS INTEGER) AS INTEGER
    DIM x AS INTEGER = 1
    DIM j AS INTEGER
    FOR j = 0 TO i - 1
        x = x + LEN(menuTitle(j)) + 2
    NEXT j
    RETURN x
END FUNCTION

' menuItems — items for menu i, each encoded "hotkey|label|accelerator".
FUNCTION menuItems(i AS INTEGER) AS []STRING
    DIM xs AS []STRING
    SELECT CASE i
    CASE 0
        xs = APPEND(xs, "O|Open/Switch|Alt+F O")
        xs = APPEND(xs, "S|Save|Alt+F S")
        xs = APPEND(xs, "A|Save As|Alt+F A")
        xs = APPEND(xs, "P|Print|Alt+F P")
        xs = APPEND(xs, "V|Change Dir|Alt+F V")
        xs = APPEND(xs, "R|Run DOS|Alt+F R")
        xs = APPEND(xs, "X|Exit StarWord|Alt+F X")
    CASE 1
        xs = APPEND(xs, "U|Undo|Alt+E U")
        xs = APPEND(xs, "B|Mark Block Begin|Alt+E B")
        xs = APPEND(xs, "E|Mark Block End|Alt+E E")
        xs = APPEND(xs, "V|Move Block|Alt+E V")
        xs = APPEND(xs, "C|Copy Block|Alt+E C")
        xs = APPEND(xs, "D|Delete Block|Alt+E D")
        xs = APPEND(xs, "F|Find|Alt+E F")
        xs = APPEND(xs, "R|Find and Replace|Alt+E R")
        xs = APPEND(xs, "N|Next Find|Alt+E X")
    CASE 2
        xs = APPEND(xs, "B|Block Highlighting|Alt+V B")
        xs = APPEND(xs, "C|Command Tags|Alt+V C")
        xs = APPEND(xs, "P|Preview|Alt+V P")
        xs = APPEND(xs, "S|Screen Settings|Alt+V S")
    CASE 3
        xs = APPEND(xs, "P|Page Break|Alt+I P")
        xs = APPEND(xs, "T|Todays Date|Alt+I T")
        xs = APPEND(xs, "F|File|Alt+I F")
    CASE 4
        xs = APPEND(xs, "B|Bold|Alt+S B")
        xs = APPEND(xs, "I|Italic|Alt+S I")
        xs = APPEND(xs, "U|Underline|Alt+S U")
        xs = APPEND(xs, "C|Convert Case|Alt+S C")
    CASE 5
        xs = APPEND(xs, "C|Center Line|Alt+L C")
        xs = APPEND(xs, "R|Ruler Line|Alt+L R")
        xs = APPEND(xs, "P|Page|Alt+L P")
    CASE 6
        xs = APPEND(xs, "W|Word Count|Alt+U W")
        xs = APPEND(xs, "C|Calculator|Alt+U C")
        xs = APPEND(xs, "M|Macros|Alt+U M")
    CASE 7
        xs = APPEND(xs, "H|Help|Alt+H H")
        xs = APPEND(xs, "C|Change Help Level|Alt+H C")
    END SELECT
    RETURN xs
END FUNCTION

FUNCTION itemField(item AS STRING, n AS INTEGER) AS STRING
    DIM parts AS []STRING = strings.Split(item, "|")
    IF n < LEN(parts) THEN RETURN parts[n]
    RETURN ""
END FUNCTION

' menuBoxWidth — inner content width of menu i's dropdown.
FUNCTION menuBoxWidth(i AS INTEGER) AS INTEGER
    DIM items AS []STRING = menuItems(i)
    DIM mw AS INTEGER = 8
    DIM k AS INTEGER
    FOR k = 0 TO LEN(items) - 1
        DIM lbl AS STRING = itemField(items[k], 1)
        DIM acc AS STRING = itemField(items[k], 2)
        DIM lw AS INTEGER = LEN(lbl) + 3 + LEN(acc)
        IF lw > mw THEN mw = lw
    NEXT k
    RETURN mw
END FUNCTION

' renderMenuBar — the top row: titles with the Alt hotkey letter tinted, the
' open menu reverse-highlighted.
FUNCTION renderMenuBar(w AS INTEGER) AS STRING
    DIM barStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#cfe0ff")).Background(lipgloss.Color("#21305c"))
    DIM hotStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#21305c")).Bold(TRUE)
    DIM actStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#ffd166")).Bold(TRUE)
    DIM out AS STRING = barStyle.Render(" ")
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        DIM t AS STRING = menuTitle(i)
        IF i = gMenuOpen THEN
            out = out + actStyle.Render(t)
        ELSE
            out = out + hotStyle.Render(Left(t, 1)) + barStyle.Render(Right(t, LEN(t) - 1))
        END IF
        out = out + barStyle.Render("  ")
    NEXT i
    ' Pad the rest of the bar.
    DIM used AS INTEGER = menuTitleX(menuCount() - 1) + LEN(menuTitle(menuCount() - 1)) + 2
    IF used < w THEN out = out + barStyle.Render(strings.Repeat(" ", w - used))
    RETURN out
END FUNCTION

' menuBoxLine — one styled line of the open dropdown, width boxW (= inner+4).
' lineIdx 0 = top border, 1..n = items, n+1 = bottom border.
FUNCTION menuBoxLine(menuIdx AS INTEGER, lineIdx AS INTEGER, inner AS INTEGER, selIdx AS INTEGER) AS STRING
    DIM boxStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#9cc1ff")).Background(lipgloss.Color("#14336e"))
    DIM txtStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#e6eeff")).Background(lipgloss.Color("#14336e"))
    DIM hotStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#14336e")).Bold(TRUE)
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#8ad0ff")).Bold(TRUE)
    DIM items AS []STRING = menuItems(menuIdx)
    DIM n AS INTEGER = LEN(items)
    IF lineIdx = 0 THEN
        RETURN boxStyle.Render("╭" + strings.Repeat("─", inner + 2) + "╮")
    END IF
    IF lineIdx = n + 1 THEN
        RETURN boxStyle.Render("╰" + strings.Repeat("─", inner + 2) + "╯")
    END IF
    DIM it AS STRING = items[lineIdx - 1]
    DIM lbl AS STRING = itemField(it, 1)
    DIM acc AS STRING = itemField(it, 2)
    ' content: label, spaces, accelerator (right-aligned) within `inner`.
    DIM gap AS INTEGER = inner - LEN(lbl) - LEN(acc)
    IF gap < 1 THEN gap = 1
    DIM content AS STRING = lbl + strings.Repeat(" ", gap) + acc
    content = swFit(content, inner)
    IF lineIdx - 1 = selIdx THEN
        RETURN boxStyle.Render("│") + selStyle.Render(" " + content + " ") + boxStyle.Render("│")
    END IF
    ' Tint the hotkey (first matching letter of the label) amber.
    DIM hk AS STRING = itemField(it, 0)
    DIM hpos AS INTEGER = strings.Index(content, hk)
    DIM mid AS STRING = txtStyle.Render(content)
    IF hpos >= 0 THEN
        mid = txtStyle.Render(Left(content, hpos)) + hotStyle.Render(hk) + txtStyle.Render(Right(content, LEN(content) - hpos - 1))
    END IF
    RETURN boxStyle.Render("│") + txtStyle.Render(" ") + mid + txtStyle.Render(" ") + boxStyle.Render("│")
END FUNCTION

' menuAtX — index of the bar title under column x (-1 if none).
FUNCTION menuAtX(x AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        DIM sx AS INTEGER = menuTitleX(i)
        IF x >= sx AND x < sx + LEN(menuTitle(i)) THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' doMenuItem — perform the action for (menuIdx, hotkey). Unimplemented WordStar
' features report a friendly message; the rest drive StarWord's real commands.
SUB doMenuItem(menuIdx AS INTEGER, hk AS STRING)
    DIM label AS STRING = ""
    DIM items AS []STRING = menuItems(menuIdx)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(items) - 1
        IF itemField(items[k], 0) = hk THEN label = itemField(items[k], 1)
    NEXT k
    gMenuOpen = 0 - 1
    IF menuIdx = 0 THEN
        IF hk = "S" THEN
            saveFile()
        ELSEIF hk = "A" THEN
            gPromptMode = "saveas"
            gPromptLabel = "Save as: "
            gPromptText = ""
        ELSEIF hk = "O" THEN
            gPromptMode = "open"
            gPromptLabel = "Open file: "
            gPromptText = ""
        ELSEIF hk = "X" THEN
            saveFile()
            RequestQuit()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 1 THEN
        IF hk = "B" THEN
            gBBRow = gRow
            gBBCol = gCol
            gBlockShow = TRUE
            gMessage = "Block begin marked"
        ELSEIF hk = "E" THEN
            gBERow = gRow
            gBECol = gCol
            gBlockShow = TRUE
            gMessage = "Block end marked"
        ELSEIF hk = "V" THEN
            blockMoveTo(gRow, gCol)
        ELSEIF hk = "C" THEN
            blockCopyTo(gRow, gCol)
        ELSEIF hk = "D" THEN
            blockDelete()
        ELSEIF hk = "F" THEN
            gPromptMode = "find"
            gPromptLabel = "Find: "
            gPromptText = ""
        ELSEIF hk = "R" THEN
            gPromptMode = "rfind"
            gPromptLabel = "Replace - find: "
            gPromptText = ""
        ELSEIF hk = "N" THEN
            doFindNext()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 2 THEN
        IF hk = "B" THEN
            gBlockShow = NOT gBlockShow
            gMessage = "Block highlighting toggled"
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 6 THEN
        IF hk = "W" THEN
            wordCount()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 7 THEN
        IF hk = "H" THEN
            gPrefix = "J"
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSE
        gMessage = label + " — coming in a later StarWord build"
    END IF
END SUB

' wordCount — count words / lines / characters (runes) in the document.
SUB wordCount()
    DIM words AS INTEGER = 0
    DIM chars AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        words = words + LEN(strings.Fields(gLines[i]))
        chars = chars + runeIndexOf(gLines[i], LEN(gLines[i]))
    NEXT i
    gMessage = fmt.Sprintf("Words: %d    Lines: %d    Characters: %d", words, LEN(gLines), chars)
END SUB

FUNCTION sw_Render(w AS INTEGER, h AS INTEGER) AS STRING
    gW = w
    gH = h
    clampCursor()

    ' Layout: menubar=0, status=1, ruler=2, text=3..h-2, message=h-1.
    DIM txTop AS INTEGER = 3
    DIM txRows AS INTEGER = h - 4
    IF txRows < 1 THEN txRows = 1

    ' Keep the cursor on screen (both axes).
    IF gRow < gTop THEN gTop = gRow
    IF gRow >= gTop + txRows THEN gTop = gRow - txRows + 1
    IF gCol < gLeft THEN gLeft = gCol
    IF gCol >= gLeft + w THEN gLeft = gCol - w + 1
    IF gTop < 0 THEN gTop = 0
    IF gLeft < 0 THEN gLeft = 0
    gLeft = snapToRune(curLine(), gLeft)

    ' Palette — modernized WordStar blue.
    DIM stStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#3b6fe0")).Bold(TRUE)
    DIM ruStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#a9c4ff")).Background(lipgloss.Color("#16306a"))
    DIM ruMark AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#16306a")).Bold(TRUE)
    DIM txStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#0f2350"))
    DIM curStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#0f2350")).Background(lipgloss.Color("#8ad0ff")).Bold(TRUE)
    DIM blkStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#2f5bb0"))
    DIM msgStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#a9c0ee")).Background(lipgloss.Color("#0a1838"))
    DIM panStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#14336e"))
    DIM panLbl AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#14336e")).Bold(TRUE)

    DIM rows AS []STRING

    ' --- row 0: pull-down menu bar ---
    rows = APPEND(rows, renderMenuBar(w))

    ' --- row 1: status line ---
    DIM modeStr AS STRING = "OVERTYPE"
    IF gInsert THEN modeStr = "INSERT"
    DIM encStr AS STRING = "WS/ASCII"
    IF gIsUnicode THEN encStr = "UTF-8"
    DIM modFlag AS STRING = " "
    IF gModified THEN modFlag = "*"
    DIM colNum AS INTEGER = runeIndexOf(curLine(), gCol) + 1
    DIM status AS STRING = " StarWord   " + modFlag + gFileName + "    Line " + fmt.Sprintf("%d", gRow + 1) + "  Col " + fmt.Sprintf("%d", colNum) + "    " + modeStr + "    " + encStr
    DIM statusFit AS STRING = swFit(status, w)
    rows = APPEND(rows, stStyle.Render(statusFit))

    ' --- row 1: ruler line ---
    DIM ruler AS STRING = ""
    DIM rx AS INTEGER
    FOR rx = 0 TO w - 1
        DIM dc AS INTEGER = gLeft + rx
        DIM rc AS STRING = "-"
        IF dc = gLeftMargin THEN
            rc = "L"
        ELSEIF dc = gRightMargin THEN
            rc = "R"
        ELSEIF dc MOD 5 = 0 THEN
            rc = "!"
        END IF
        ruler = ruler + rc
    NEXT rx
    rows = APPEND(rows, ruStyle.Render(ruler))
    _ = ruMark

    ' --- rows 2..h-2: text area ---
    DIM sy AS INTEGER
    FOR sy = 0 TO txRows - 1
        rows = APPEND(rows, renderTextRow(gTop + sy, w, txStyle, curStyle, blkStyle))
    NEXT sy

    ' --- row h-1: message / modal prompt line ---
    DIM msg AS STRING
    IF gPromptMode <> "" THEN
        msg = " " + gPromptLabel + gPromptText + Chr(9617)
    ELSEIF gMessage <> "" THEN
        msg = " " + gMessage
    ELSE
        msg = " ^J Help   ^K Block/Save   ^Q Quick   ^KS Save   ^KX Save+Exit   ^KQ Abandon"
    END IF
    rows = APPEND(rows, msgStyle.Render(swFit(msg, w)))

    ' --- pop-up prefix menu: overwrite the top text rows (WordStar-style) ---
    IF gPrefix <> "" THEN
        DIM menu AS []STRING = prefixMenuLines()
        DIM mi AS INTEGER
        FOR mi = 0 TO LEN(menu) - 1
            DIM rr AS INTEGER = txTop + mi
            IF rr <= h - 2 THEN
                ' Split the leading label (up to 2 spaces) from the rest so the
                ' label can be tinted amber.
                DIM full AS STRING = menu[mi]
                DIM cut AS INTEGER = strings.Index(full, "  ")
                IF cut > 0 THEN
                    rows[rr] = panLbl.Render(Left(full, cut)) + panStyle.Render(swFit(Right(full, LEN(full) - cut), w - cut))
                ELSE
                    rows[rr] = panStyle.Render(swFit(full, w))
                END IF
            END IF
        NEXT mi
    END IF

    ' --- open pull-down: splice its box over rows 1.. under the menu title ---
    IF gMenuOpen >= 0 THEN
        DIM inner AS INTEGER = menuBoxWidth(gMenuOpen)
        DIM boxW AS INTEGER = inner + 4
        DIM boxX AS INTEGER = menuTitleX(gMenuOpen)
        IF boxX + boxW > w THEN boxX = w - boxW
        IF boxX < 0 THEN boxX = 0
        DIM nItems AS INTEGER = LEN(menuItems(gMenuOpen))
        DIM li AS INTEGER
        FOR li = 0 TO nItems + 1
            DIM mr AS INTEGER = 1 + li
            IF mr <= h - 2 THEN
                DIM boxLine AS STRING = menuBoxLine(gMenuOpen, li, inner, gMenuSel)
                DIM leftPart AS STRING = ""
                DIM rightPart AS STRING = ""
                DIM rEnd AS INTEGER = boxX + boxW
                IF mr = 1 THEN
                    leftPart = stStyle.Render(Left(statusFit, boxX))
                    rightPart = stStyle.Render(Mid(statusFit, rEnd + 1, w - rEnd))
                ELSEIF mr = 2 THEN
                    leftPart = ruStyle.Render(Left(ruler, boxX))
                    rightPart = ruStyle.Render(Mid(ruler, rEnd + 1, w - rEnd))
                ELSE
                    DIM docRow AS INTEGER = gTop + (mr - txTop)
                    leftPart = renderTextRange(docRow, 0, boxX, txStyle, curStyle, blkStyle)
                    rightPart = renderTextRange(docRow, rEnd, w - rEnd, txStyle, curStyle, blkStyle)
                END IF
                rows[mr] = leftPart + boxLine + rightPart
            END IF
        NEXT li
    END IF

    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' Left-click inside canvas sw — drive the menu bar, an open dropdown, or
' (otherwise) drop the cursor at the clicked text cell.
SUB sw_Click(x AS INTEGER, y AS INTEGER)
    ' Click the menu bar (row 0): open / switch to that menu.
    IF y = 0 THEN
        DIM mhit AS INTEGER = menuAtX(x)
        IF mhit >= 0 THEN
            gMenuOpen = mhit
            gMenuSel = 0
        ELSE
            gMenuOpen = 0 - 1
        END IF
        RETURN
    END IF
    ' With a dropdown open: a click inside it selects an item; outside closes.
    IF gMenuOpen >= 0 THEN
        DIM inner AS INTEGER = menuBoxWidth(gMenuOpen)
        DIM boxW AS INTEGER = inner + 4
        DIM boxX AS INTEGER = menuTitleX(gMenuOpen)
        IF boxX + boxW > gW THEN boxX = gW - boxW
        IF boxX < 0 THEN boxX = 0
        DIM nItems AS INTEGER = LEN(menuItems(gMenuOpen))
        ' Item rows are canvas rows 2 .. 1+nItems (row 1 is the top border).
        IF x >= boxX AND x < boxX + boxW AND y >= 2 AND y <= 1 + nItems THEN
            DIM idx AS INTEGER = y - 2
            doMenuItem(gMenuOpen, itemField(menuItems(gMenuOpen)[idx], 0))
        ELSE
            gMenuOpen = 0 - 1
        END IF
        RETURN
    END IF
    IF gPrefix <> "" OR gPromptMode <> "" THEN RETURN
    IF y < 3 OR y > gH - 2 THEN RETURN
    gRow = gTop + (y - 3)
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gRow < 0 THEN gRow = 0
    ' Map the clicked display cell x to a rune boundary: advance x runes from
    ' the (rune-snapped) left scroll offset.
    DIM ln AS STRING = curLine()
    DIM pos AS INTEGER = snapToRune(ln, gLeft)
    DIM cellsX AS INTEGER
    FOR cellsX = 1 TO x
        IF pos >= LEN(ln) THEN
            pos = LEN(ln)
        ELSE
            pos = nextRuneStart(ln, pos)
        END IF
    NEXT cellsX
    gCol = pos
    clampCursor()
    gMessage = ""
END SUB

' ==========================================================================
' Editing primitives
' ==========================================================================

SUB insertChar(ch AS STRING)
    DIM ln AS STRING = curLine()
    IF gInsert OR gCol >= LEN(ln) THEN
        gLines[gRow] = Left(ln, gCol) + ch + Right(ln, LEN(ln) - gCol)
    ELSE
        ' overtype: replace the char under the cursor
        gLines[gRow] = Left(ln, gCol) + ch + Right(ln, LEN(ln) - gCol - 1)
    END IF
    ' gCol is a byte offset, so advance by the byte length of ch (1 for
    ' ASCII, more for a multibyte Unicode rune).
    gCol = gCol + LEN(ch)
    gModified = TRUE
END SUB

SUB splitLine()
    DIM ln AS STRING = curLine()
    DIM head AS STRING = Left(ln, gCol)
    DIM tail AS STRING = Right(ln, LEN(ln) - gCol)
    gLines[gRow] = head
    gLines = lineInsertAt(gLines, gRow + 1, tail)
    gRow = gRow + 1
    gCol = 0
    gModified = TRUE
END SUB

FUNCTION lineInsertAt(xs AS []STRING, idx AS INTEGER, val AS STRING) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i = idx THEN out = APPEND(out, val)
        out = APPEND(out, xs[i])
    NEXT i
    IF idx >= LEN(xs) THEN out = APPEND(out, val)
    RETURN out
END FUNCTION

FUNCTION lineRemoveAt(xs AS []STRING, idx AS INTEGER) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i <> idx THEN out = APPEND(out, xs[i])
    NEXT i
    IF LEN(out) = 0 THEN out = APPEND(out, "")
    RETURN out
END FUNCTION

SUB deleteCharLeft()
    DIM ln AS STRING = curLine()
    IF gCol > 0 THEN
        ' Delete the whole rune to the left (1-4 bytes), never half of one.
        DIM ps AS INTEGER = prevRuneStart(ln, gCol)
        gLines[gRow] = Left(ln, ps) + Right(ln, LEN(ln) - gCol)
        gCol = ps
    ELSEIF gRow > 0 THEN
        DIM prevLen AS INTEGER = LEN(gLines[gRow - 1])
        gLines[gRow - 1] = gLines[gRow - 1] + ln
        gLines = lineRemoveAt(gLines, gRow)
        gRow = gRow - 1
        gCol = prevLen
    END IF
    gModified = TRUE
END SUB

SUB deleteCharAt()
    DIM ln AS STRING = curLine()
    IF gCol < LEN(ln) THEN
        ' Delete the whole rune at the cursor (1-4 bytes).
        DIM ns AS INTEGER = nextRuneStart(ln, gCol)
        gLines[gRow] = Left(ln, gCol) + Right(ln, LEN(ln) - ns)
    ELSEIF gRow < lastRow() THEN
        gLines[gRow] = ln + gLines[gRow + 1]
        gLines = lineRemoveAt(gLines, gRow + 1)
    END IF
    gModified = TRUE
END SUB

SUB deleteWordRight()
    DIM ln AS STRING = curLine()
    DIM c AS INTEGER = gCol
    WHILE c < LEN(ln) AND isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    WHILE c < LEN(ln) AND NOT isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    gLines[gRow] = Left(ln, gCol) + Right(ln, LEN(ln) - c)
    gModified = TRUE
END SUB

SUB deleteLine()
    gLines = lineRemoveAt(gLines, gRow)
    IF gRow > lastRow() THEN gRow = lastRow()
    gCol = 0
    gModified = TRUE
END SUB

SUB insertBlankLine()
    gLines = lineInsertAt(gLines, gRow, "")
    gModified = TRUE
END SUB

' ==========================================================================
' Cursor motion
' ==========================================================================

SUB moveLeft()
    IF gCol > 0 THEN
        ' Move by a whole rune so the cursor never lands inside a glyph.
        gCol = prevRuneStart(curLine(), gCol)
    ELSEIF gRow > 0 THEN
        gRow = gRow - 1
        gCol = LEN(curLine())
    END IF
END SUB

SUB moveRight()
    IF gCol < LEN(curLine()) THEN
        gCol = nextRuneStart(curLine(), gCol)
    ELSEIF gRow < lastRow() THEN
        gRow = gRow + 1
        gCol = 0
    END IF
END SUB

SUB moveUp()
    IF gRow > 0 THEN gRow = gRow - 1
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
    gCol = snapToRune(curLine(), gCol)
END SUB

SUB moveDown()
    IF gRow < lastRow() THEN gRow = gRow + 1
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
    gCol = snapToRune(curLine(), gCol)
END SUB

SUB wordLeft()
    DIM ln AS STRING = curLine()
    IF gCol = 0 THEN
        IF gRow > 0 THEN
            gRow = gRow - 1
            gCol = LEN(curLine())
        END IF
        RETURN
    END IF
    ' Step left over runes: skip non-word runes, then the word itself. Each
    ' test inspects the rune immediately left of c (at prevRuneStart(ln,c)).
    DIM c AS INTEGER = gCol
    WHILE c > 0 AND NOT isWordCh(runeAt(ln, prevRuneStart(ln, c)))
        c = prevRuneStart(ln, c)
    WEND
    WHILE c > 0 AND isWordCh(runeAt(ln, prevRuneStart(ln, c)))
        c = prevRuneStart(ln, c)
    WEND
    gCol = c
END SUB

SUB wordRight()
    DIM ln AS STRING = curLine()
    DIM c AS INTEGER = gCol
    WHILE c < LEN(ln) AND isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    WHILE c < LEN(ln) AND NOT isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    IF c >= LEN(ln) AND gRow < lastRow() THEN
        gRow = gRow + 1
        gCol = 0
    ELSE
        gCol = c
    END IF
END SUB

SUB pageUp()
    DIM pstep AS INTEGER = gH - 4
    IF pstep < 1 THEN pstep = 1
    gRow = gRow - pstep
    IF gRow < 0 THEN gRow = 0
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
END SUB

SUB pageDown()
    DIM pstep AS INTEGER = gH - 4
    IF pstep < 1 THEN pstep = 1
    gRow = gRow + pstep
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
END SUB

' ==========================================================================
' Key dispatch
' ==========================================================================

' isNamedKey — TRUE for the multi-character key names bubbletea reports for
' non-text keys (so the text-insert fallback never types them literally).
FUNCTION isNamedKey(key AS STRING) AS BOOLEAN
    IF LEN(key) <= 1 THEN RETURN FALSE
    SELECT CASE key
    CASE "enter", "tab", "space", "esc", "backspace", "delete", "insert"
        RETURN TRUE
    CASE "up", "down", "left", "right", "home", "end", "pgup", "pgdown"
        RETURN TRUE
    CASE "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"
        RETURN TRUE
    END SELECT
    RETURN FALSE
END FUNCTION

' isTextKey — TRUE when key is a character to insert (one rune, possibly
' multibyte for Unicode). Excludes modified chords (they contain "+") and the
' named keys above. A single byte is always text (covers "+", letters, etc.).
FUNCTION isTextKey(key AS STRING) AS BOOLEAN
    IF key = "" THEN RETURN FALSE
    IF LEN(key) = 1 THEN RETURN TRUE
    IF strings.Contains(key, "+") THEN RETURN FALSE
    IF isNamedKey(key) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' secondKey — normalize a prefix's second key: strip a leading "ctrl+" (WordStar
' lets you keep Ctrl held) and lowercase, so "B"/"b"/"ctrl+b" all become "b".
FUNCTION secondKey(key AS STRING) AS STRING
    DIM k AS STRING = key
    IF strings.HasPrefix(k, "ctrl+") THEN k = Right(k, LEN(k) - 5)
    RETURN LCase(k)
END FUNCTION

' handlePrefixK — the ^K Block & Save menu.
SUB handlePrefixK(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "b" THEN
        gBBRow = gRow
        gBBCol = gCol
        gBlockShow = TRUE
        gMessage = "Block begin marked"
    ELSEIF k = "k" THEN
        gBERow = gRow
        gBECol = gCol
        gBlockShow = TRUE
        gMessage = "Block end marked"
    ELSEIF k = "c" THEN
        blockCopyTo(gRow, gCol)
    ELSEIF k = "v" THEN
        blockMoveTo(gRow, gCol)
    ELSEIF k = "y" THEN
        blockDelete()
    ELSEIF k = "h" THEN
        gBlockShow = NOT gBlockShow
        gMessage = "Block display toggled"
    ELSEIF k = "<" THEN
        gBBRow = 0 - 1
        gBERow = 0 - 1
        gMessage = "Block unmarked"
    ELSEIF k = "s" THEN
        saveFile()
    ELSEIF k = "d" OR k = "x" THEN
        saveFile()
        RequestQuit()
    ELSEIF k = "q" THEN
        RequestQuit()
    ELSE
        gMessage = "^K" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' handlePrefixQ — the ^Q Quick menu (navigation + find).
SUB handlePrefixQ(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "s" THEN
        gCol = 0
    ELSEIF k = "d" THEN
        gCol = LEN(curLine())
    ELSEIF k = "e" THEN
        gRow = gTop
    ELSEIF k = "x" THEN
        gRow = gTop + (gH - 4)
        IF gRow > lastRow() THEN gRow = lastRow()
    ELSEIF k = "r" THEN
        gRow = 0
        gCol = 0
    ELSEIF k = "c" THEN
        gRow = lastRow()
        gCol = LEN(curLine())
    ELSEIF k = "b" THEN
        IF gBBRow >= 0 THEN
            gRow = gBBRow
            gCol = gBBCol
        END IF
    ELSEIF k = "k" THEN
        IF gBERow >= 0 THEN
            gRow = gBERow
            gCol = gBECol
        END IF
    ELSEIF k = "y" THEN
        DIM ln AS STRING = curLine()
        gLines[gRow] = Left(ln, gCol)
        gModified = TRUE
    ELSEIF k = "f" THEN
        gPromptMode = "find"
        gPromptLabel = "Find: "
        gPromptText = ""
    ELSEIF k = "a" THEN
        gPromptMode = "rfind"
        gPromptLabel = "Replace - find: "
        gPromptText = ""
    ELSE
        gMessage = "^Q" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' handlePrompt — modal text entry on the message line (find / replace / etc).
SUB handlePrompt(key AS STRING)
    IF key = "esc" THEN
        gPromptMode = ""
        gMessage = "Cancelled"
        RETURN
    END IF
    IF key = "enter" THEN
        DIM mode AS STRING = gPromptMode
        DIM txt AS STRING = gPromptText
        gPromptMode = ""
        IF mode = "find" THEN
            gFindStr = txt
            ' Search from the cursor inclusive (^L repeats from after it).
            IF findFrom(gRow, gCol) THEN
                gMessage = "Found"
            ELSE
                gMessage = "Not found: " + gFindStr
            END IF
        ELSEIF mode = "rfind" THEN
            gFindStr = txt
            gPromptMode = "rwith"
            gPromptLabel = "Replace with: "
            gPromptText = ""
        ELSEIF mode = "rwith" THEN
            gReplaceStr = txt
            replaceAllFromCursor()
        ELSEIF mode = "saveas" THEN
            gFileName = txt
            gIsUnicode = detectUnicode(txt)
            saveFile()
        ELSEIF mode = "open" THEN
            IF txt <> "" THEN loadFile(txt)
        END IF
        RETURN
    END IF
    IF key = "backspace" OR key = "ctrl+h" THEN
        IF LEN(gPromptText) > 0 THEN gPromptText = Left(gPromptText, LEN(gPromptText) - 1)
        RETURN
    END IF
    IF key = "space" THEN
        gPromptText = gPromptText + " "
        RETURN
    END IF
    IF isTextKey(key) THEN gPromptText = gPromptText + key
END SUB

' Fired for every key press. StarWord owns the whole keyboard, so we
' ConsumeKey() on every key (this also lets ^C be page-down, not quit).
' altMenuIndex — map "alt+f"/"alt+e"/… to a menu index, else -1.
FUNCTION altMenuIndex(key AS STRING) AS INTEGER
    IF NOT strings.HasPrefix(key, "alt+") THEN RETURN 0 - 1
    DIM letter AS STRING = UCase(Right(key, LEN(key) - 4))
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        IF UCase(Left(menuTitle(i), 1)) = letter THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' handleMenuKey — navigate the open pull-down (arrows, Enter, hotkey letter,
' Alt+letter to switch menus, Esc to close).
SUB handleMenuKey(key AS STRING)
    DIM n AS INTEGER = LEN(menuItems(gMenuOpen))
    IF key = "esc" THEN
        gMenuOpen = 0 - 1
        RETURN
    END IF
    IF key = "up" THEN
        gMenuSel = (gMenuSel - 1 + n) MOD n
        RETURN
    END IF
    IF key = "down" THEN
        gMenuSel = (gMenuSel + 1) MOD n
        RETURN
    END IF
    IF key = "left" THEN
        gMenuOpen = (gMenuOpen - 1 + menuCount()) MOD menuCount()
        gMenuSel = 0
        RETURN
    END IF
    IF key = "right" THEN
        gMenuOpen = (gMenuOpen + 1) MOD menuCount()
        gMenuSel = 0
        RETURN
    END IF
    IF key = "enter" THEN
        doMenuItem(gMenuOpen, itemField(menuItems(gMenuOpen)[gMenuSel], 0))
        RETURN
    END IF
    ' Alt+letter switches directly to another menu.
    DIM am AS INTEGER = altMenuIndex(key)
    IF am >= 0 THEN
        gMenuOpen = am
        gMenuSel = 0
        RETURN
    END IF
    ' A bare letter selects the item with that hotkey.
    IF LEN(key) = 1 THEN
        DIM up AS STRING = UCase(key)
        DIM items AS []STRING = menuItems(gMenuOpen)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(items) - 1
            IF itemField(items[k], 0) = up THEN
                doMenuItem(gMenuOpen, up)
                RETURN
            END IF
        NEXT k
    END IF
END SUB

SUB Form_Key(key AS STRING)
    ConsumeKey()
    gMessage = ""

    ' An open pull-down menu is modal — it owns the keyboard.
    IF gMenuOpen >= 0 THEN
        handleMenuKey(key)
        RETURN
    END IF

    ' Alt+<letter> opens the matching pull-down (WordStar keybinding).
    DIM amOpen AS INTEGER = altMenuIndex(key)
    IF amOpen >= 0 THEN
        gMenuOpen = amOpen
        gMenuSel = 0
        RETURN
    END IF

    ' Modal prompt takes priority.
    IF gPromptMode <> "" THEN
        handlePrompt(key)
        RETURN
    END IF

    ' A pending prefix consumes the next key as its second key.
    IF gPrefix = "K" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixK(key)
        RETURN
    END IF
    IF gPrefix = "Q" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixQ(key)
        RETURN
    END IF
    IF gPrefix = "O" OR gPrefix = "P" OR gPrefix = "J" THEN
        ' These menus are informational in v1; any key dismisses them.
        gPrefix = ""
        RETURN
    END IF

    ' --- prefixes ---
    IF key = "ctrl+k" THEN
        gPrefix = "K"
        RETURN
    END IF
    IF key = "ctrl+q" THEN
        gPrefix = "Q"
        RETURN
    END IF
    IF key = "ctrl+o" THEN
        gPrefix = "O"
        RETURN
    END IF
    IF key = "ctrl+p" THEN
        gPrefix = "P"
        RETURN
    END IF
    IF key = "ctrl+j" THEN
        gPrefix = "J"
        RETURN
    END IF

    ' --- cursor diamond + arrows ---
    IF key = "ctrl+e" OR key = "up" THEN
        moveUp()
        RETURN
    END IF
    IF key = "ctrl+x" OR key = "down" THEN
        moveDown()
        RETURN
    END IF
    IF key = "ctrl+s" OR key = "left" THEN
        moveLeft()
        RETURN
    END IF
    IF key = "ctrl+d" OR key = "right" THEN
        moveRight()
        RETURN
    END IF
    IF key = "ctrl+a" THEN
        wordLeft()
        RETURN
    END IF
    IF key = "ctrl+f" THEN
        wordRight()
        RETURN
    END IF
    IF key = "ctrl+r" OR key = "pgup" THEN
        pageUp()
        RETURN
    END IF
    IF key = "ctrl+c" OR key = "pgdown" THEN
        pageDown()
        RETURN
    END IF
    IF key = "home" THEN
        gCol = 0
        RETURN
    END IF
    IF key = "end" THEN
        gCol = LEN(curLine())
        RETURN
    END IF

    ' --- editing ---
    IF key = "ctrl+g" OR key = "delete" THEN
        deleteCharAt()
        RETURN
    END IF
    IF key = "backspace" OR key = "ctrl+h" THEN
        deleteCharLeft()
        RETURN
    END IF
    IF key = "ctrl+t" THEN
        deleteWordRight()
        RETURN
    END IF
    IF key = "ctrl+y" THEN
        deleteLine()
        RETURN
    END IF
    IF key = "ctrl+n" THEN
        insertBlankLine()
        RETURN
    END IF
    IF key = "ctrl+v" THEN
        gInsert = NOT gInsert
        RETURN
    END IF
    IF key = "ctrl+l" THEN
        doFindNext()
        RETURN
    END IF
    IF key = "enter" THEN
        splitLine()
        RETURN
    END IF
    IF key = "tab" OR key = "ctrl+i" THEN
        ' Insert spaces to the next 5-column tab stop.
        DIM ts AS INTEGER = 5 - (gCol MOD 5)
        DIM ti AS INTEGER
        FOR ti = 1 TO ts
            insertChar(" ")
        NEXT ti
        RETURN
    END IF
    IF key = "esc" THEN
        gMessage = ""
        RETURN
    END IF

    ' --- text entry (printable chars, incl. multibyte Unicode runes) ---
    IF key = "space" THEN
        insertChar(" ")
        RETURN
    END IF
    IF isTextKey(key) THEN insertChar(key)
END SUB

' Fired once at startup — open a file given on the command line, else start
' with an empty Unicode document.
SUB Form_Load()
    DIM args AS []STRING = os.Args
    IF LEN(args) > 1 THEN
        loadFile(args[1])
    ELSE
        gLines = APPEND(gLines, "")
        gMessage = "New document — ^J for help, ^KS to save, ^KX to save & exit"
    END IF
END SUB

' Fired on terminal resize — sw_Render re-clamps against the new size.
SUB Terminal_Resize(w AS INTEGER, h AS INTEGER)
    _ = w
    _ = h
END SUB

' Fired just before the program quits.
SUB Form_Close()
    ' Nothing to flush — saving is explicit (^KS/^KX).
END SUB

' Fired on the UI thread after a background goroutine calls _dbtuiWake().
SUB Form_Wake()
    ' StarWord has no background workers in v1.
END SUB

' Fired for every mouse event; we use clicks (routed via sw_Click) to place
' the cursor. Motion and wheel are ignored in v1.
SUB Form_Mouse(kind AS STRING, button AS STRING, x AS INTEGER, y AS INTEGER)
    _ = kind
    _ = button
    _ = x
    _ = y
END SUB
