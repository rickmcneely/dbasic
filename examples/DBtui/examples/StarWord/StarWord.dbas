IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "runtime"
IMPORT "os/exec" AS exec
IMPORT "time"
IMPORT "net/http" AS http
IMPORT "io"
IMPORT "github.com/atotto/clipboard" AS clipboard
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM _formW AS INTEGER
    DIM _formH AS INTEGER
    DIM _maximized AS BOOLEAN
    DIM _minimized AS BOOLEAN
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentProgram AS POINTER TO tea.Program
TYPE _dbtuiWakeMsg
    DIM n AS INTEGER
END TYPE
SUB _dbtuiWake()
    IF _currentProgram <> NIL THEN
        DIM _wm AS _dbtuiWakeMsg
        _currentProgram.Send(_wm)
    END IF
END SUB
DIM _dbtuiKeyConsumed AS BOOLEAN
SUB ConsumeKey()
    _dbtuiKeyConsumed = TRUE
END SUB
DIM _dbtuiQuitReq AS BOOLEAN
SUB RequestQuit()
    _dbtuiQuitReq = TRUE
END SUB
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM _wkMsg AS _dbtuiWakeMsg
    DIM _wkOk AS BOOLEAN
    _wkMsg, _wkOk = msg.(_dbtuiWakeMsg)
    IF _wkOk THEN
        _ = _wkMsg
        Form_Wake()
        RETURN m, NIL
    END IF
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        _formSize(@m)
        Terminal_Resize(m.Width, m.Height)
        RETURN m, NIL
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk THEN
        DIM _fmb AS STRING = "left"
        IF mc.Button = tea.MouseRight THEN _fmb = "right"
        Form_Mouse("click", _fmb, mc.X, mc.Y)
        IF _dbtuiQuitReq THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
    END IF
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF mc.Y = 0 THEN
            DIM gstart AS INTEGER = m._formW - 1 - 2
            DIM ggi AS INTEGER = (mc.X - gstart) / 2
            IF mc.X >= gstart AND ggi = 0 THEN
                Form_Close()
                RETURN m, tea.Quit
            END IF
        END IF
        IF mc.X >= 1 AND mc.X < 1 + 78 AND mc.Y >= 1 AND mc.Y < 1 + 22 THEN
            m.Focus = 0
            sw_Click(mc.X - 1, mc.Y - 1)
            IF _dbtuiQuitReq THEN
                Form_Close()
                RETURN m, tea.Quit
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        Form_Mouse("motion", "", mm.X, mm.Y)
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 1 AND mm.X < 1 + 78 AND mm.Y >= 1 AND mm.Y < 1 + 22 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        DIM _fmw AS STRING = "up"
        IF mw.Button = tea.MouseWheelDown THEN _fmw = "down"
        Form_Mouse("wheel", _fmw, mw.X, mw.Y)
        _ = mw
        RETURN m, NIL
    END IF
    DIM pst AS tea.PasteMsg
    DIM pstOk AS BOOLEAN
    pst, pstOk = msg.(tea.PasteMsg)
    IF pstOk THEN
        Form_Paste(pst.Content)
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        _dbtuiKeyConsumed = FALSE
        Form_Key(key)
        IF _dbtuiQuitReq THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF _dbtuiKeyConsumed THEN RETURN m, NIL
        IF key = "ctrl+c" OR key = "esc" THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 1
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 0
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

SUB _formSize(m AS POINTER TO Model)
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    IF m._maximized THEN
        m._formW = w
        m._formH = h
    ELSE
        m._formW = (w)
        m._formH = (h)
    END IF
    IF m._formW < 3 THEN m._formW = 3
    IF m._formW > w THEN m._formW = w
    IF m._formH < 2 THEN m._formH = 2
    IF m._formH > h THEN m._formH = h
    IF m._minimized THEN m._formH = 1
END SUB

FUNCTION _formBox(fw AS INTEGER, fh AS INTEGER, gh AS STRING, gv AS STRING, tl AS STRING, tr AS STRING, bl AS STRING, br AS STRING, caption AS STRING, glyphs AS STRING) AS STRING
    DIM innerW AS INTEGER = fw - 2
    IF innerW < 0 THEN innerW = 0
    DIM cap AS STRING = ""
    IF caption <> "" THEN cap = " " + caption + " "
    DIM used AS INTEGER = lipgloss.Width(cap) + lipgloss.Width(glyphs)
    DIM fill AS INTEGER = innerW - used
    IF fill < 0 THEN fill = 0
    DIM out AS STRING = tl + cap + strings.Repeat(gh, fill) + glyphs + tr
    IF fh <= 1 THEN RETURN out
    DIM r AS INTEGER
    FOR r = 0 TO fh - 3
        out = out + "\n" + gv + strings.Repeat(" ", innerW) + gv
    NEXT r
    out = out + "\n" + bl + strings.Repeat(gh, innerW) + br
    RETURN out
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM cv0 AS STRING = sw_Render(78 + (m._formW - 80), 22 + (m._formH - 24))
    cv0 = lipgloss.NewStyle().Width(78 + (m._formW - 80)).Height(22 + (m._formH - 24)).Render(cv0)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(cv0).X(1).Y(1).Z(10)
    DIM formBoxStr AS STRING = _formBox(m._formW, m._formH, "─", "│", "╭", "╮", "╰", "╯", "StarWord", "✕ ")
    DIM formLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(formBoxStr).X(0).Y(0).Z(1)
    IF m._minimized THEN
        DIM mBase AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
        DIM mCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(mBase, formLy)
        DIM mvw AS tea.View = tea.NewView(mCmp.Render())
        mvw.MouseMode = tea.MouseModeAllMotion
        mvw.AltScreen = TRUE
        RETURN mvw
    END IF
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, formLy, ly0)
    fullView = cmpLy.Render()
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

' _dbtuiRelaunchInTerminal — on Windows, relaunch this program inside
' Windows Terminal (wt.exe) at the form size, then exit. No-op when
' already inside Terminal, when wt.exe is missing, or off Windows.
SUB _dbtuiRelaunchInTerminal()
    IF runtime.GOOS <> "windows" THEN RETURN
    IF os.Getenv("WT_SESSION") <> "" THEN RETURN
    IF os.Getenv("DBTUI_IN_TERMINAL") <> "" THEN RETURN
    DIM _wt AS STRING
    DIM _e AS ERROR
    _wt, _e = exec.LookPath("wt.exe")
    IF _e <> NIL THEN RETURN
    DIM _self AS STRING
    _self, _e = os.Executable()
    IF _e <> NIL THEN RETURN
    ' Relaunch into Windows Terminal, preserving the working directory and
    ' forwarding our own command-line arguments to the new instance. Build the
    ' full argv (wt, its options, then "<self> <forwarded args...>") and set it
    ' on the Cmd directly so a dynamic arg list needs no variadic spread.
    DIM _cwd AS STRING
    _cwd, _e = os.Getwd()
    IF _e <> NIL THEN _cwd = "."
    ' Load the config so the new window opens at the configured size.
    loadConfig()
    DIM _full AS []STRING
    _full = APPEND(_full, _wt)
    _full = APPEND(_full, "--size")
    _full = APPEND(_full, fmt.Sprintf("%d,%d", gStartCols, gStartRows))
    _full = APPEND(_full, "--title")
    _full = APPEND(_full, "StarWord")
    _full = APPEND(_full, "-d")
    _full = APPEND(_full, _cwd)
    _full = APPEND(_full, _self)
    DIM _argv AS []STRING = os.Args
    DIM _ai AS INTEGER
    FOR _ai = 1 TO LEN(_argv) - 1
        _full = APPEND(_full, _argv[_ai])
    NEXT _ai
    DIM _c AS POINTER TO exec.Cmd = exec.Command(_wt)
    _c.Args = _full
    _c.Env = APPEND(os.Environ(), "DBTUI_IN_TERMINAL=1")
    _e = _c.Start()
    IF _e <> NIL THEN RETURN
    os.Exit(0)
END SUB

' _dbtuiApplyRequestedSize — honor a "--size cols,rows" argument by
' resizing the terminal (CSI 8;rows;cols t) before the UI starts.
SUB _dbtuiApplyRequestedSize()
    DIM _args AS []STRING = os.Args
    DIM _i AS INTEGER
    FOR _i = 1 TO LEN(_args) - 1
        IF _args[_i] = "--size" AND _i + 1 <= LEN(_args) - 1 THEN
            DIM _p AS []STRING = strings.Split(_args[_i + 1], ",")
            IF LEN(_p) = 2 THEN fmt.Print(Chr(27) + "[8;" + strings.TrimSpace(_p[1]) + ";" + strings.TrimSpace(_p[0]) + "t")
        END IF
    NEXT _i
END SUB

SUB Main()
    _dbtuiRelaunchInTerminal()
    _dbtuiApplyRequestedSize()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    _formSize(@m)
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    _currentProgram = prog
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE =====
' Your code below — DBtui preserves everything here on F5.

' === StarWord =============================================================
' A modern reimplementation of WordStar 7.0 for DOS, built on ONE DBtui
' Canvas plus the raw Form_Key/Form_Mouse hooks. It is FUNCTIONALLY identical
' to WordStar (the same control-key "diamond", the ^K / ^Q prefix menus, block
' operations, find/replace, the status line + ruler) but VISUALLY modern
' (a clean WordStar-blue palette). It reads & writes both classic WordStar
' files and Unicode files; a Unicode file is marked by appending "u" to the
' WordStar extension (e.g. LETTER.WS -> LETTER.WSu).
'
' Layout inside the canvas (h rows):
'   row 0          status line  (file, line/col, insert mode, encoding)
'   row 1          ruler line   (margins L..R, tab stops)
'   rows 2..h-2    text area    (the document; cursor + block highlight)
'   row h-1        message / prompt line
'
' v1 note: editing is byte-based (Mid/Left/Right), which is exact for ASCII
' and classic WordStar text. Unicode FILES round-trip correctly via
' Encode/Decode; rune-precise cursor motion through multibyte glyphs is a
' planned refinement.

' --- document + cursor state ----------------------------------------------
DIM gLines AS []STRING       ' the document, one STRING per line (>=1 line)
DIM gRow AS INTEGER          ' cursor line   (0-based)
DIM gCol AS INTEGER          ' cursor column (0-based byte offset)
DIM gTop AS INTEGER          ' first visible line   (vertical scroll)
DIM gLeft AS INTEGER         ' first visible column (horizontal scroll)
DIM gW AS INTEGER = 78       ' last-rendered canvas size (for clamping)
DIM gH AS INTEGER = 22
DIM gInsert AS BOOLEAN = TRUE ' INSERT (TRUE) vs OVERTYPE (FALSE) — ^V toggles

' --- file state -----------------------------------------------------------
DIM gFileName AS STRING = "untitled.WSu"
DIM gIsUnicode AS BOOLEAN = TRUE     ' .WSu etc. -> UTF-8; otherwise WS/ASCII
DIM gModified AS BOOLEAN

' --- command state --------------------------------------------------------
DIM gPrefix AS STRING        ' pending prefix: "" | "K" | "Q" | "O" | "P" | "J"
DIM gMessage AS STRING       ' transient status message on the message line

' --- pull-down menu bar (WordStar 7 keybindings: Alt+F/E/V/I/S/L/U/H) ------
DIM gMenuOpen AS INTEGER = 0 - 1   ' -1 = closed; else index of the open menu
DIM gMenuSel AS INTEGER            ' highlighted item in the open menu

' --- screen mode + Opening Menu (WordStar's classic opening screen) --------
DIM gMode AS STRING = "edit"       ' "edit" | "open" (Opening Menu)
DIM gOpenDir AS STRING = "."       ' directory the Opening Menu is browsing
DIM gOpenFiles AS []STRING         ' "..", dirs (with "/"), then files
DIM gOpenSel AS INTEGER            ' highlighted entry in the file list
DIM gOpFile AS STRING              ' file targeted by an Opening-Menu rename/copy/delete
DIM gOpenTop AS INTEGER            ' scroll offset of the file list

' --- block markers (row/col; -1 = unset) ----------------------------------
DIM gBBRow AS INTEGER = 0 - 1
DIM gBBCol AS INTEGER
DIM gBERow AS INTEGER = 0 - 1
DIM gBECol AS INTEGER
DIM gBlockShow AS BOOLEAN = TRUE      ' ^KH toggles marker/highlight display
DIM gClip AS STRING                   ' internal mirror of the OS clipboard
                                      ' (Ctrl+Shift+X/C/V), used as fallback
DIM gColumnMode AS BOOLEAN            ' ^KN: rectangular (column) block mode
DIM gRepeatNext AS INTEGER            ' ^QQ: repeat the next keystroke N times
DIM gTabStops AS []INTEGER            ' ^OI/^ON: explicit ruler tab stops (display cols)
DIM gPrevRow AS INTEGER = 0 - 1       ' ^QP: previous cursor position before a jump
DIM gPrevCol AS INTEGER
DIM gFindRow AS INTEGER = 0 - 1       ' ^QV: position of the last find
DIM gFindCol AS INTEGER
DIM gAutoScroll AS INTEGER            ' ^QW/^QZ: -1 up, +1 down, 0 off (auto-scroll)

' --- ruler / margins ------------------------------------------------------
DIM gLeftMargin AS INTEGER = 0
DIM gRightMargin AS INTEGER = 65

' --- formatting (^P character attributes, ^O onscreen, dot commands) -------
' Character attributes are stored in the text as WordStar toggle control bytes
' that flip an attribute on/off: ^B (Chr 2) bold, ^Y (Chr 25) italic,
' ^S (Chr 19) underline. gShowTags (^OD) shows those tags instead of applying
' them. gJustify/gWordWrap are stored layout flags.
DIM gShowTags AS BOOLEAN          ' ^OD: TRUE = reveal print-control tags
DIM gJustify AS BOOLEAN = TRUE    ' ^OJ
DIM gWordWrap AS BOOLEAN = TRUE   ' ^OW

' --- find / replace -------------------------------------------------------
DIM gFindStr AS STRING
DIM gReplaceStr AS STRING
DIM gFindIgnore AS BOOLEAN        ' U : ignore case
DIM gFindWhole AS BOOLEAN         ' W : whole words only
DIM gFindBack AS BOOLEAN          ' B : search backward
DIM gReplNoConfirm AS BOOLEAN     ' N : replace all without asking
DIM gReplCount AS INTEGER         ' matches replaced in the current operation

' --- modal prompt on the message line -------------------------------------
DIM gPromptMode AS STRING    ' "" | "find" | "rfind" | "rwith" | "saveas" | …
DIM gPromptText AS STRING
DIM gPromptLabel AS STRING

' --- undo (whole-document snapshots; one step per changing keystroke) -------
' Each snapshot is the document joined by LF, with the pre-change cursor.
DIM gUndoDoc AS []STRING
DIM gUndoRow AS []INTEGER
DIM gUndoCol AS []INTEGER
DIM gRedoDoc AS []STRING          ' redo stack (cleared by a fresh edit)
DIM gRedoRow AS []INTEGER
DIM gRedoCol AS []INTEGER
DIM gLastDoc AS STRING            ' doc as of the end of the previous keystroke
DIM gLastRow AS INTEGER
DIM gLastCol AS INTEGER

' --- misc WordStar feature state ------------------------------------------
DIM gHelpLevel AS INTEGER = 3     ' WordStar help level 0..3 (Help > Change Help Level)
DIM gShowRuler AS BOOLEAN = TRUE  ' View > Screen Settings toggles the ruler line
DIM gPageLength AS INTEGER = 66   ' Layout > Page / .pl : lines per printed page
DIM gMarginTop AS INTEGER = 3     ' .mt : blank lines above the body
DIM gMarginBottom AS INTEGER = 8  ' .mb : blank lines below the body
DIM gHeader AS STRING             ' .he : running header ("#" -> page number)
DIM gFooter AS STRING             ' .fo : running footer ("#" -> page number)
DIM gPageNumbering AS BOOLEAN = TRUE  ' .pn on / .op off
DIM gLineSpacing AS INTEGER = 1   ' .ls / ^OS : 1 single, 2 double, ...
DIM gPageOffset AS INTEGER = 0    ' .po : left indent of the printed page
DIM gPrintCommand AS STRING       ' config: shell command to pipe the print image to
DIM gPrevTop AS INTEGER           ' first visible line in print-preview mode
DIM gNonDocument AS BOOLEAN       ' non-document mode (WS /N): no wrap/justify/dot cmds

' --- configurable defaults (persisted via the WSCHANGE-style config) -------
DIM gWrapMode AS STRING = "hard"  ' "hard" (insert breaks) | "soft" (display) | "off"
DIM gTabWidth AS INTEGER = 5      ' columns per tab stop
DIM gStartCols AS INTEGER = 80    ' startup window columns (Windows wt relaunch)
DIM gStartRows AS INTEGER = 24    ' startup window rows
DIM gDefaultUnicode AS BOOLEAN = TRUE  ' new documents default to UTF-8 (.WSu)
DIM gCfgReturn AS STRING = "edit"      ' screen mode to return to after config
DIM gCfgSnapshot AS STRING             ' settings serialized on config entry (for Abandon)

' --- spell check + thesaurus -----------------------------------------------
DIM gDictPath AS STRING = "/usr/share/dict/words"  ' word list (config: dictionary)
DIM gDict AS MAP OF STRING TO BOOLEAN  ' loaded lowercase words (+ personal dict)
DIM gDictLoaded AS BOOLEAN
DIM gDictCount AS INTEGER
DIM gAffRules AS MAP OF STRING TO STRING  ' hunspell affix flag -> "TYPE|strip|add|cond" lines
DIM gSpellWord AS STRING                ' word currently flagged
DIM gSpellEnd AS INTEGER               ' byte offset just past the flagged word
DIM gSpellSugg AS []STRING             ' suggested corrections
DIM gThes AS MAP OF STRING TO STRING   ' synonyms (comma-separated)
DIM gThesInit AS BOOLEAN
DIM gThesPath AS STRING = "/usr/share/mythes/th_en_US_v2.dat"  ' MyThes data file
DIM gThesLoaded AS BOOLEAN
DIM gThesWord AS STRING
DIM gThesStart AS INTEGER
DIM gThesEnd AS INTEGER
DIM gThesSyn AS []STRING

' --- MailMerge -------------------------------------------------------------
DIM gMergeRecords AS INTEGER       ' records merged by the last merge

' --- transient "size" popup shown while the terminal is being resized ------
DIM gResizeShow AS BOOLEAN
DIM gResizeGen AS INTEGER          ' bumped per resize; the timer clears only the latest

' --- soft-wrap visual-row table (rebuilt each render when wrap mode = soft) -
DIM gVisLine AS []INTEGER          ' logical line index for each visual row
DIM gVisStart AS []INTEGER         ' segment start byte
DIM gVisEnd AS []INTEGER           ' segment end byte (exclusive)
DIM gTopVis AS INTEGER             ' first visible visual row (soft-mode scroll)

' --- place markers 0..9 (^K0..^K9 set, ^Q0..^Q9 jump) ---------------------
DIM gMarkRow AS []INTEGER         ' 10 entries; row = -1 means unset
DIM gMarkCol AS []INTEGER

' --- single-register keyboard macro (Utilities > Macros) -------------------
DIM gMacroKeys AS []STRING        ' recorded key names
DIM gMacroRecording AS BOOLEAN
DIM gMacroPlaying AS BOOLEAN

' --- calculator expression scanner state (Utilities > Calculator) ----------
DIM gCalcSrc AS STRING
DIM gCalcPos AS INTEGER

' --- on-screen calculator widget (Utilities > Calculator) ------------------
DIM gCalcOpen AS BOOLEAN           ' the calculator panel is showing
DIM gCalcInput AS STRING           ' the expression being entered
DIM gCalcResult AS STRING          ' last evaluated result
DIM gCalcTape AS []STRING          ' recent "expr = result" history
DIM gCalcJustEval AS BOOLEAN       ' just pressed = (a digit starts fresh)

' ==========================================================================
' Small buffer helpers
' ==========================================================================

FUNCTION curLine() AS STRING
    IF gRow < 0 OR gRow >= LEN(gLines) THEN RETURN ""
    RETURN gLines[gRow]
END FUNCTION

FUNCTION lastRow() AS INTEGER
    RETURN LEN(gLines) - 1
END FUNCTION

' clampCursor — keep gRow/gCol inside the buffer.
SUB clampCursor()
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    IF gRow < 0 THEN gRow = 0
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gCol < 0 THEN gCol = 0
    IF gCol > LEN(gLines[gRow]) THEN gCol = LEN(gLines[gRow])
END SUB

' --- UTF-8 rune helpers ---------------------------------------------------
' gCol is a byte offset, but a Unicode glyph can be 1-4 bytes. These keep the
' cursor on rune boundaries and let edits act on whole runes, so a multibyte
' character is never split (e.g. backspacing over "é" deletes both its bytes).

' runeLenAt — byte length of the rune that begins at byte offset pos.
FUNCTION runeLenAt(line AS STRING, pos AS INTEGER) AS INTEGER
    DIM b AS BYTES = Encode(line)
    IF pos < 0 OR pos >= LEN(line) THEN RETURN 1
    DIM lead AS INTEGER = Int(b[pos])
    IF lead < 128 THEN RETURN 1
    IF lead < 224 THEN RETURN 2
    IF lead < 240 THEN RETURN 3
    RETURN 4
END FUNCTION

' prevRuneStart — byte offset of the rune ending just before pos (steps back
' over UTF-8 continuation bytes 0x80..0xBF).
FUNCTION prevRuneStart(line AS STRING, pos AS INTEGER) AS INTEGER
    IF pos <= 0 THEN RETURN 0
    DIM b AS BYTES = Encode(line)
    DIM k AS INTEGER = pos - 1
    WHILE k > 0 AND Int(b[k]) >= 128 AND Int(b[k]) < 192
        k = k - 1
    WEND
    RETURN k
END FUNCTION

' nextRuneStart — byte offset of the rune after the one beginning at pos.
FUNCTION nextRuneStart(line AS STRING, pos AS INTEGER) AS INTEGER
    DIM n AS INTEGER = LEN(line)
    IF pos >= n THEN RETURN n
    DIM nx AS INTEGER = pos + runeLenAt(line, pos)
    IF nx > n THEN nx = n
    RETURN nx
END FUNCTION

' runeIndexOf — count of runes before byte offset bytePos (for the Col display).
FUNCTION runeIndexOf(line AS STRING, bytePos AS INTEGER) AS INTEGER
    DIM cnt AS INTEGER = 0
    DIM p AS INTEGER = 0
    WHILE p < bytePos AND p < LEN(line)
        p = nextRuneStart(line, p)
        cnt = cnt + 1
    WEND
    RETURN cnt
END FUNCTION

' snapToRune — nudge a byte offset back onto the nearest rune start at or
' before it (used to keep horizontal scroll on a rune boundary).
FUNCTION snapToRune(line AS STRING, pos AS INTEGER) AS INTEGER
    IF pos <= 0 THEN RETURN 0
    IF pos >= LEN(line) THEN RETURN LEN(line)
    DIM b AS BYTES = Encode(line)
    DIM k AS INTEGER = pos
    WHILE k > 0 AND Int(b[k]) >= 128 AND Int(b[k]) < 192
        k = k - 1
    WEND
    RETURN k
END FUNCTION

' isWordCh — alphanumeric or underscore (for ^A / ^F word motion).
FUNCTION isWordCh(ch AS STRING) AS BOOLEAN
    IF ch = "" THEN RETURN FALSE
    ' A multibyte rune (é, ñ, …) is a word character (accented letters, CJK).
    IF LEN(ch) > 1 THEN RETURN TRUE
    DIM a AS INTEGER = Asc(ch)
    IF a >= 48 AND a <= 57 THEN RETURN TRUE
    IF a >= 65 AND a <= 90 THEN RETURN TRUE
    IF a >= 97 AND a <= 122 THEN RETURN TRUE
    IF a = 95 THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' runeAt — the rune (1-4 byte string) beginning at byte offset pos, or "".
FUNCTION runeAt(line AS STRING, pos AS INTEGER) AS STRING
    IF pos < 0 OR pos >= LEN(line) THEN RETURN ""
    RETURN Mid(line, pos + 1, runeLenAt(line, pos))
END FUNCTION

' setDoc / cursorFromOffset — flat-string model used by block operations.
SUB setDoc(s AS STRING)
    gLines = strings.Split(s, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
END SUB

FUNCTION offsetOf(r AS INTEGER, c AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO r - 1
        off = off + LEN(gLines[i]) + 1
    NEXT i
    DIM cc AS INTEGER = c
    IF cc > LEN(gLines[r]) THEN cc = LEN(gLines[r])
    RETURN off + cc
END FUNCTION

SUB cursorFromOffset(off AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        DIM ll AS INTEGER = LEN(gLines[i])
        IF off <= ll THEN
            gRow = i
            gCol = off
            RETURN
        END IF
        off = off - (ll + 1)
    NEXT i
    gRow = lastRow()
    gCol = LEN(gLines[gRow])
END SUB

' ==========================================================================
' Block helpers
' ==========================================================================

' blockSet — both markers placed?
FUNCTION blockSet() AS BOOLEAN
    RETURN gBBRow >= 0 AND gBERow >= 0
END FUNCTION

' blockBounds — markers normalized so (sR,sC) precedes (eR,eC) in the document.
FUNCTION blockBounds() AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM beforeBE AS BOOLEAN = (gBBRow < gBERow) OR (gBBRow = gBERow AND gBBCol <= gBECol)
    IF beforeBE THEN RETURN gBBRow, gBBCol, gBERow, gBECol
    RETURN gBERow, gBECol, gBBRow, gBBCol
END FUNCTION

' isInBlock — is cell (r,c) inside the marked, shown block?
FUNCTION isInBlock(r AS INTEGER, c AS INTEGER) AS BOOLEAN
    IF NOT gBlockShow THEN RETURN FALSE
    IF NOT blockSet() THEN RETURN FALSE
    IF gColumnMode THEN
        DIM cr1 AS INTEGER
        DIM cr2 AS INTEGER
        DIM cd1 AS INTEGER
        DIM cd2 AS INTEGER
        cr1, cr2, cd1, cd2 = columnBounds()
        IF r < cr1 OR r > cr2 THEN RETURN FALSE
        DIM dc AS INTEGER = runeIndexOf(gLines[r], c)
        RETURN dc >= cd1 AND dc < cd2
    END IF
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM afterStart AS BOOLEAN = (r > sR) OR (r = sR AND c >= sC)
    DIM beforeEnd AS BOOLEAN = (r < eR) OR (r = eR AND c < eC)
    RETURN afterStart AND beforeEnd
END FUNCTION

' --- column (rectangular) block mode --------------------------------------

' columnBounds — the rectangle (rowtop, rowbot, leftDispCol, rightDispCol).
FUNCTION columnBounds() AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM r1 AS INTEGER = gBBRow
    DIM r2 AS INTEGER = gBERow
    IF r2 < r1 THEN
        r1 = gBERow
        r2 = gBBRow
    END IF
    DIM d1 AS INTEGER = runeIndexOf(gLines[gBBRow], gBBCol)
    DIM d2 AS INTEGER = runeIndexOf(gLines[gBERow], gBECol)
    IF d2 < d1 THEN
        DIM t AS INTEGER = d1
        d1 = d2
        d2 = t
    END IF
    RETURN r1, r2, d1, d2
END FUNCTION

' byteAtDispCol — byte offset of display column dc in line (clamped to end).
FUNCTION byteAtDispCol(line AS STRING, dc AS INTEGER) AS INTEGER
    DIM p AS INTEGER = 0
    DIM n AS INTEGER = 0
    WHILE n < dc AND p < LEN(line)
        p = nextRuneStart(line, p)
        n = n + 1
    WEND
    RETURN p
END FUNCTION

' columnText — the rectangle's text, one (space-padded) string per row.
FUNCTION columnText() AS []STRING
    DIM r1 AS INTEGER
    DIM r2 AS INTEGER
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    r1, r2, c1, c2 = columnBounds()
    DIM width AS INTEGER = c2 - c1
    DIM out AS []STRING
    DIM r AS INTEGER
    FOR r = r1 TO r2
        DIM line AS STRING = gLines[r]
        DIM sB AS INTEGER = byteAtDispCol(line, c1)
        DIM eB AS INTEGER = byteAtDispCol(line, c2)
        DIM seg AS STRING = Mid(line, sB + 1, eB - sB)
        DIM have AS INTEGER = runeIndexOf(line, eB) - runeIndexOf(line, sB)
        IF have < width THEN seg = seg + strings.Repeat(" ", width - have)
        out = APPEND(out, seg)
    NEXT r
    RETURN out
END FUNCTION

' columnDeleteRange — remove display columns [c1,c2) from rows r1..r2.
SUB columnDeleteRange(r1 AS INTEGER, r2 AS INTEGER, c1 AS INTEGER, c2 AS INTEGER)
    DIM r AS INTEGER
    FOR r = r1 TO r2
        DIM line AS STRING = gLines[r]
        DIM sB AS INTEGER = byteAtDispCol(line, c1)
        DIM eB AS INTEGER = byteAtDispCol(line, c2)
        gLines[r] = Left(line, sB) + Right(line, LEN(line) - eB)
    NEXT r
END SUB

' columnInsertAt — splice the rectangle `rect` in at (destR, destDispCol),
' creating rows and padding short lines with spaces as needed.
SUB columnInsertAt(rect AS []STRING, destR AS INTEGER, destDisp AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(rect) - 1
        DIM tr AS INTEGER = destR + i
        WHILE tr > lastRow()
            gLines = APPEND(gLines, "")
        WEND
        DIM line AS STRING = gLines[tr]
        DIM curDisp AS INTEGER = runeIndexOf(line, LEN(line))
        IF curDisp < destDisp THEN line = line + strings.Repeat(" ", destDisp - curDisp)
        DIM insB AS INTEGER = byteAtDispCol(line, destDisp)
        gLines[tr] = Left(line, insB) + rect[i] + Right(line, LEN(line) - insB)
    NEXT i
END SUB

SUB columnDelete()
    DIM r1 AS INTEGER
    DIM r2 AS INTEGER
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    r1, r2, c1, c2 = columnBounds()
    columnDeleteRange(r1, r2, c1, c2)
    gRow = r1
    gCol = byteAtDispCol(gLines[r1], c1)
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Column block deleted"
END SUB

SUB columnCopyTo(destR AS INTEGER, destC AS INTEGER)
    DIM rect AS []STRING = columnText()
    DIM destDisp AS INTEGER = runeIndexOf(gLines[destR], destC)
    columnInsertAt(rect, destR, destDisp)
    gModified = TRUE
    gMessage = "Column block copied"
END SUB

SUB columnMoveTo(destR AS INTEGER, destC AS INTEGER)
    DIM r1 AS INTEGER
    DIM r2 AS INTEGER
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    r1, r2, c1, c2 = columnBounds()
    DIM rect AS []STRING = columnText()
    DIM destDisp AS INTEGER = runeIndexOf(gLines[destR], destC)
    columnDeleteRange(r1, r2, c1, c2)
    ' If the deletion was to the left of the destination on the same rows,
    ' the destination column shifted left by the rectangle's width.
    IF destR >= r1 AND destR <= r2 AND destDisp >= c2 THEN destDisp = destDisp - (c2 - c1)
    columnInsertAt(rect, destR, destDisp)
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Column block moved"
END SUB

' --- block math (^KM): sum the numbers in the marked block ----------------

' parseNumeric — leading number of a cell; returns (isNumber, value).
FUNCTION parseNumeric(cell AS STRING) AS (BOOLEAN, DOUBLE)
    DIM s AS STRING = strings.TrimSpace(cell)
    IF strings.HasPrefix(s, "$") THEN s = strings.TrimSpace(Mid(s, 2, LEN(s) - 1))
    s = strings.ReplaceAll(s, ",", "")
    IF s = "" THEN RETURN FALSE, 0
    DIM a AS INTEGER = Asc(Left(s, 1))
    DIM isNum AS BOOLEAN = (a >= 48 AND a <= 57) OR Left(s, 1) = "-" OR Left(s, 1) = "+" OR Left(s, 1) = "."
    IF NOT isNum THEN RETURN FALSE, 0
    RETURN TRUE, Val(s)
END FUNCTION

' blockMath — ^KM: sum / count / average the numbers in the marked block.
SUB blockMath()
    IF NOT blockSet() THEN
        gMessage = "Mark a block first (^KB begin, ^KK end)"
        RETURN
    END IF
    DIM cells AS []STRING
    IF gColumnMode THEN
        cells = columnText()
    ELSE
        cells = strings.Split(blockText(), Chr(10))
    END IF
    DIM sum AS DOUBLE = 0
    DIM count AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(cells) - 1
        DIM ok AS BOOLEAN
        DIM v AS DOUBLE
        ok, v = parseNumeric(cells[i])
        IF ok THEN
            sum = sum + v
            count = count + 1
        END IF
    NEXT i
    DIM avg AS DOUBLE = 0
    IF count > 0 THEN avg = sum / Dbl(count)
    gMessage = fmt.Sprintf("Sum: %g   Count: %d   Average: %g", sum, count, avg)
END SUB

' blockText — the marked text as one string (with embedded newlines).
FUNCTION blockText() AS STRING
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    RETURN Mid(doc, s + 1, e - s)
END FUNCTION

SUB blockDelete()
    IF NOT blockSet() THEN RETURN
    IF gColumnMode THEN
        columnDelete()
        RETURN
    END IF
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    setDoc(Left(doc, s) + Right(doc, LEN(doc) - e))
    cursorFromOffset(s)
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Block deleted"
END SUB

SUB blockCopyTo(destR AS INTEGER, destC AS INTEGER)
    IF NOT blockSet() THEN RETURN
    IF gColumnMode THEN
        columnCopyTo(destR, destC)
        RETURN
    END IF
    DIM blk AS STRING = blockText()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM d AS INTEGER = offsetOf(destR, destC)
    setDoc(Left(doc, d) + blk + Right(doc, LEN(doc) - d))
    cursorFromOffset(d + LEN(blk))
    gModified = TRUE
    gMessage = "Block copied"
END SUB

SUB blockMoveTo(destR AS INTEGER, destC AS INTEGER)
    IF NOT blockSet() THEN RETURN
    IF gColumnMode THEN
        columnMoveTo(destR, destC)
        RETURN
    END IF
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    DIM blk AS STRING = Mid(doc, s + 1, e - s)
    DIM d AS INTEGER = offsetOf(destR, destC)
    ' Adjust the insertion point for the about-to-be-removed span.
    DIM d2 AS INTEGER = s
    IF d >= e THEN
        d2 = d - (e - s)
    ELSEIF d <= s THEN
        d2 = d
    END IF
    DIM removed AS STRING = Left(doc, s) + Right(doc, LEN(doc) - e)
    setDoc(Left(removed, d2) + blk + Right(removed, LEN(removed) - d2))
    cursorFromOffset(d2 + LEN(blk))
    gBBRow = 0 - 1
    gBERow = 0 - 1
    gModified = TRUE
    gMessage = "Block moved"
END SUB

' --- OS clipboard (Ctrl+Shift+X/C/V) --------------------------------------
' Copy/cut the marked block to, and paste from, the operating-system
' clipboard via github.com/atotto/clipboard. gClip mirrors the last value we
' wrote so paste still works on a host with no clipboard utility installed.

' clipCopy — Ctrl+Shift+C: marked block -> OS clipboard.
SUB clipCopy()
    IF NOT blockSet() THEN
        gMessage = "No block marked (^KB begin, ^KK end)"
        RETURN
    END IF
    DIM txt AS STRING = blockText()
    gClip = txt
    DIM e AS ERROR = clipboard.WriteAll(txt)
    IF e <> NIL THEN
        gMessage = fmt.Sprintf("Copied %d chars (internal — OS clipboard unavailable)", LEN(txt))
    ELSE
        gMessage = fmt.Sprintf("Copied %d chars to clipboard", LEN(txt))
    END IF
END SUB

' clipCut — Ctrl+Shift+X: marked block -> OS clipboard, then delete it.
SUB clipCut()
    IF NOT blockSet() THEN
        gMessage = "No block marked (^KB begin, ^KK end)"
        RETURN
    END IF
    DIM txt AS STRING = blockText()
    gClip = txt
    DIM e AS ERROR = clipboard.WriteAll(txt)
    blockDelete()
    IF e <> NIL THEN
        gMessage = fmt.Sprintf("Cut %d chars (internal — OS clipboard unavailable)", LEN(txt))
    ELSE
        gMessage = fmt.Sprintf("Cut %d chars to clipboard", LEN(txt))
    END IF
END SUB

' pasteString — splice text in at the cursor (line endings normalized).
' Shared by clipPaste (^Shift+V) and Form_Paste (bracketed terminal paste).
SUB pasteString(txt AS STRING)
    IF txt = "" THEN
        gMessage = "Nothing to paste"
        RETURN
    END IF
    txt = strings.ReplaceAll(txt, Chr(13) + Chr(10), Chr(10))
    txt = strings.ReplaceAll(txt, Chr(13), Chr(10))
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM d AS INTEGER = offsetOf(gRow, gCol)
    setDoc(Left(doc, d) + txt + Right(doc, LEN(doc) - d))
    cursorFromOffset(d + LEN(txt))
    gModified = TRUE
    gMessage = fmt.Sprintf("Pasted %d chars", LEN(txt))
END SUB

' clipPaste — Ctrl+Shift+V: OS clipboard -> document at the cursor.
SUB clipPaste()
    DIM txt AS STRING
    DIM e AS ERROR
    txt, e = clipboard.ReadAll()
    IF e <> NIL THEN txt = gClip
    IF txt = "" THEN
        gMessage = "Clipboard is empty"
        RETURN
    END IF
    pasteString(txt)
END SUB

' Form_Paste — a bracketed paste from the terminal (this is what fires when
' the terminal handles Ctrl+Shift+V itself and sends the text as a paste
' event rather than a key). Route it like a paste, or into an open prompt.
SUB Form_Paste(txt AS STRING)
    IF gPromptMode <> "" THEN
        gPromptText = gPromptText + strings.ReplaceAll(strings.ReplaceAll(txt, Chr(13), ""), Chr(10), "")
        RETURN
    END IF
    IF gMode <> "edit" THEN RETURN
    IF gMenuOpen >= 0 THEN RETURN
    pasteString(txt)
END SUB

' ==========================================================================
' File I/O — reads/writes WordStar and Unicode (.WSu) files
' ==========================================================================

' detectUnicode — a file is Unicode when its name ends in "u"/"U" (the .WSu
' convention: a "u" appended to the WordStar extension).
FUNCTION detectUnicode(path AS STRING) AS BOOLEAN
    RETURN strings.HasSuffix(LCase(path), "u")
END FUNCTION

SUB loadFile(path AS STRING)
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(path)
    gFileName = path
    gIsUnicode = detectUnicode(path)
    IF e <> NIL THEN
        gLines = nil
        gLines = APPEND(gLines, "")
        gMessage = "New file: " + path
        syncUndoBaseline()
        RETURN
    END IF
    DIM text AS STRING = Decode(data)
    text = strings.ReplaceAll(text, Chr(13) + Chr(10), Chr(10))
    text = strings.ReplaceAll(text, Chr(13), Chr(10))
    gLines = strings.Split(text, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    gMessage = "Opened " + path + "  (" + fmt.Sprintf("%d", LEN(gLines)) + " lines)"
    syncUndoBaseline()
END SUB

SUB saveFile()
    DIM nl AS STRING = Chr(13) + Chr(10)
    IF gIsUnicode THEN nl = Chr(10)
    DIM out AS STRING = strings.Join(gLines, nl)
    DIM e AS ERROR = os.WriteFile(gFileName, Encode(out), 420)
    IF e <> NIL THEN
        gMessage = "Save FAILED: " + e.Error()
        RETURN
    END IF
    gModified = FALSE
    gMessage = "Saved " + gFileName
END SUB

' ==========================================================================
' Find
' ==========================================================================

' matchAt — does gFindStr occur at byte offset pos in line, honoring the
' ignore-case (U) and whole-word (W) options?
FUNCTION matchAt(line AS STRING, pos AS INTEGER) AS BOOLEAN
    DIM hay AS STRING = line
    DIM nee AS STRING = gFindStr
    IF gFindIgnore THEN
        hay = LCase(line)
        nee = LCase(gFindStr)
    END IF
    IF pos < 0 OR pos + LEN(nee) > LEN(hay) THEN RETURN FALSE
    IF Mid(hay, pos + 1, LEN(nee)) <> nee THEN RETURN FALSE
    IF gFindWhole THEN
        IF pos > 0 THEN
            IF isWordCh(runeAt(line, prevRuneStart(line, pos))) THEN RETURN FALSE
        END IF
        DIM after AS INTEGER = pos + LEN(nee)
        IF after < LEN(line) THEN
            IF isWordCh(runeAt(line, after)) THEN RETURN FALSE
        END IF
    END IF
    RETURN TRUE
END FUNCTION

' searchFrom — find gFindStr from (sr,sc) in the given direction; on success
' set gRow/gCol to the match start and return TRUE.
FUNCTION searchFrom(sr AS INTEGER, sc AS INTEGER, forward AS BOOLEAN) AS BOOLEAN
    IF gFindStr = "" THEN RETURN FALSE
    IF forward THEN
        DIM r AS INTEGER
        FOR r = sr TO lastRow()
            DIM hay AS STRING = gLines[r]
            DIM startc AS INTEGER = 0
            IF r = sr THEN startc = sc
            IF startc < 0 THEN startc = 0
            DIM pos AS INTEGER = startc
            WHILE pos <= LEN(hay)
                IF matchAt(hay, pos) THEN
                    gRow = r
                    gCol = pos
                    RETURN TRUE
                END IF
                pos = pos + 1
            WEND
        NEXT r
    ELSE
        DIM r2 AS INTEGER
        FOR r2 = sr TO 0 STEP -1
            DIM hay2 AS STRING = gLines[r2]
            DIM startc2 AS INTEGER = LEN(hay2)
            IF r2 = sr THEN startc2 = sc
            IF startc2 > LEN(hay2) THEN startc2 = LEN(hay2)
            DIM pos2 AS INTEGER = startc2
            WHILE pos2 >= 0
                IF matchAt(hay2, pos2) THEN
                    gRow = r2
                    gCol = pos2
                    RETURN TRUE
                END IF
                pos2 = pos2 - 1
            WEND
        NEXT r2
    END IF
    RETURN FALSE
END FUNCTION

' parseFindOpts — set the W/U/B option flags from a typed option string.
SUB parseFindOpts(opts AS STRING)
    DIM o AS STRING = LCase(opts)
    gFindIgnore = strings.Contains(o, "u")
    gFindWhole = strings.Contains(o, "w")
    gFindBack = strings.Contains(o, "b")
END SUB

' doFind — run a find from the cursor in the active direction.
SUB doFind()
    savePrevPos()
    DIM ok AS BOOLEAN = FALSE
    IF gFindBack THEN
        ok = searchFrom(gRow, gCol - 1, FALSE)
    ELSE
        ok = searchFrom(gRow, gCol, TRUE)
    END IF
    IF ok THEN
        gFindRow = gRow
        gFindCol = gCol
        gMessage = "Found"
    ELSE
        gMessage = "Not found: " + gFindStr
    END IF
END SUB

' doFindNext — ^L: repeat the last find, skipping the current match.
SUB doFindNext()
    savePrevPos()
    DIM ok AS BOOLEAN = FALSE
    IF gFindBack THEN
        ok = searchFrom(gRow, gCol - 1, FALSE)
    ELSE
        ok = searchFrom(gRow, gCol + 1, TRUE)
    END IF
    IF ok THEN
        gFindRow = gRow
        gFindCol = gCol
        gMessage = "Found"
    ELSE
        gMessage = "Not found: " + gFindStr
    END IF
END SUB

' replaceCurrentMatch — replace the gFindStr-length span at the cursor.
SUB replaceCurrentMatch()
    DIM ln AS STRING = gLines[gRow]
    gLines[gRow] = Left(ln, gCol) + gReplaceStr + Right(ln, LEN(ln) - gCol - LEN(gFindStr))
    gCol = gCol + LEN(gReplaceStr)
    gModified = TRUE
    gReplCount = gReplCount + 1
END SUB

' startReplace — begin a replace run: all-at-once with N, else interactive
' (Y/N/A/Esc) confirmation via the "confirmrepl" prompt.
SUB startReplace()
    gReplCount = 0
    IF gReplNoConfirm THEN
        WHILE searchFrom(gRow, gCol, TRUE)
            replaceCurrentMatch()
        WEND
        gMessage = fmt.Sprintf("Replaced %d occurrence(s)", gReplCount)
    ELSEIF searchFrom(gRow, gCol, TRUE) THEN
        gPromptMode = "confirmrepl"
        gPromptLabel = "Replace? (Y / N / A=all / Esc=stop): "
        gPromptText = ""
    ELSE
        gMessage = "Not found: " + gFindStr
    END IF
END SUB

' handleConfirmRepl — keystrokes while confirming each replacement.
SUB handleConfirmRepl(key AS STRING)
    DIM k AS STRING = LCase(key)
    IF key = "esc" THEN
        gPromptMode = ""
        gMessage = fmt.Sprintf("Replaced %d occurrence(s)", gReplCount)
        RETURN
    END IF
    IF k = "a" THEN
        replaceCurrentMatch()
        WHILE searchFrom(gRow, gCol, TRUE)
            replaceCurrentMatch()
        WEND
        gPromptMode = ""
        gMessage = fmt.Sprintf("Replaced %d occurrence(s)", gReplCount)
        RETURN
    END IF
    IF k = "y" THEN
        replaceCurrentMatch()
    ELSEIF k = "n" THEN
        gCol = gCol + LEN(gFindStr)
    ELSE
        RETURN
    END IF
    IF NOT searchFrom(gRow, gCol, TRUE) THEN
        gPromptMode = ""
        gMessage = fmt.Sprintf("Replaced %d occurrence(s)", gReplCount)
    END IF
END SUB

' ==========================================================================
' Rendering
' ==========================================================================

' swFit — clip (by char count) or space-pad s to exactly width cells.
FUNCTION swFit(s AS STRING, width AS INTEGER) AS STRING
    IF width <= 0 THEN RETURN ""
    IF LEN(s) >= width THEN RETURN Left(s, width)
    RETURN s + strings.Repeat(" ", width - LEN(s))
END FUNCTION

' markerLetter — for a 1-byte print-control toggle, the tag letter; else "".
' markerLetter — the tag letter for a 1-byte ^P print-control toggle, else "".
'   ^B(2)=Bold  ^Y(25)=italic  ^S(19)=underline  ^X(24)=strikeout
'   ^D(4)=Double-strike(bold)  ^T(20)=superscripT  ^V(22)=subscript(V)
FUNCTION markerLetter(ch AS STRING) AS STRING
    IF LEN(ch) <> 1 THEN RETURN ""
    DIM a AS INTEGER = Asc(ch)
    IF a = 2 THEN RETURN "B"
    IF a = 25 THEN RETURN "Y"
    IF a = 19 THEN RETURN "S"
    IF a = 24 THEN RETURN "X"
    IF a = 4 THEN RETURN "D"
    IF a = 20 THEN RETURN "T"
    IF a = 22 THEN RETURN "V"
    RETURN ""
END FUNCTION

' attrsAt — the (bold, italic, underline, strike) state at byte offset pos,
' found by replaying the toggle markers from the start of the line.
FUNCTION attrsAt(line AS STRING, pos AS INTEGER) AS (BOOLEAN, BOOLEAN, BOOLEAN, BOOLEAN)
    DIM bold AS BOOLEAN = FALSE
    DIM ital AS BOOLEAN = FALSE
    DIM undl AS BOOLEAN = FALSE
    DIM strk AS BOOLEAN = FALSE
    DIM p AS INTEGER = 0
    WHILE p < pos AND p < LEN(line)
        DIM a AS INTEGER = Asc(Mid(line, p + 1, 1))
        IF a = 2 OR a = 4 THEN bold = NOT bold
        IF a = 25 THEN ital = NOT ital
        IF a = 19 THEN undl = NOT undl
        IF a = 24 THEN strk = NOT strk
        p = p + runeLenAt(line, p)
    WEND
    RETURN bold, ital, undl, strk
END FUNCTION

' renderRun — style one buffered run by class (0 base / 1 cursor / 2 block) and
' the active character attributes.
FUNCTION renderRun(buf AS STRING, cls AS INTEGER, b AS BOOLEAN, it AS BOOLEAN, u AS BOOLEAN, st AS BOOLEAN, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    IF buf = "" THEN RETURN ""
    IF cls = 1 THEN RETURN cur.Render(buf)
    IF cls = 2 THEN RETURN blk.Render(buf)
    DIM s AS lipgloss.Style = baseSt
    IF b THEN s = s.Bold(TRUE)
    IF it THEN s = s.Italic(TRUE)
    IF u THEN s = s.Underline(TRUE)
    IF st THEN s = s.Strikethrough(TRUE)
    RETURN s.Render(buf)
END FUNCTION

' renderTextRow — one document row, windowed to [gLeft, gLeft+w), with the
' cursor cell and any block cells highlighted. Uses run-length batching so a
' plain row costs a single styled Render.
FUNCTION renderTextRow(rowIdx AS INTEGER, w AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    RETURN renderTextRange(rowIdx, 0, w, baseSt, cur, blk)
END FUNCTION

' renderTextRange — render display cells [fromCell, fromCell+count) of a
' document row (used to splice a dropdown box over part of a text row).
FUNCTION renderTextRange(rowIdx AS INTEGER, fromCell AS INTEGER, count AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    DIM line AS STRING = ""
    IF rowIdx >= 0 AND rowIdx <= lastRow() THEN line = gLines[rowIdx]

    ' A dot-command line (".lm 8", ".pa", …) is a non-printing format line —
    ' render it dim, with no attribute/marker processing.
    DIM isDot AS BOOLEAN = (Left(line, 1) = ".")
    DIM useBase AS lipgloss.Style = baseSt
    IF isDot THEN useBase = lipgloss.NewStyle().Foreground(lipgloss.Color("#6b7bb5")).Background(lipgloss.Color("#0f2350")).Italic(TRUE)
    DIM tagSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#e0af68")).Bold(TRUE)

    ' Walk one rune per display cell (snapped to a rune boundary) so a
    ' multibyte glyph occupies a single cell and is highlighted as a unit.
    DIM pos AS INTEGER = snapToRune(line, gLeft)
    DIM skip AS INTEGER
    FOR skip = 1 TO fromCell
        IF pos < LEN(line) THEN pos = nextRuneStart(line, pos)
    NEXT skip

    ' Character-attribute state at the window start (replay markers from 0).
    DIM bold AS BOOLEAN = FALSE
    DIM ital AS BOOLEAN = FALSE
    DIM undl AS BOOLEAN = FALSE
    DIM strk AS BOOLEAN = FALSE
    IF NOT isDot THEN bold, ital, undl, strk = attrsAt(line, pos)

    DIM out AS STRING = ""
    DIM buf AS STRING = ""
    DIM bufCls AS INTEGER = 0 - 1
    DIM bufB AS BOOLEAN = FALSE
    DIM bufI AS BOOLEAN = FALSE
    DIM bufU AS BOOLEAN = FALSE
    DIM bufX AS BOOLEAN = FALSE
    DIM cell AS INTEGER = 0
    WHILE cell < count
        DIM ch AS STRING = " "
        DIM rl AS INTEGER = 1
        IF pos < LEN(line) THEN
            rl = runeLenAt(line, pos)
            ch = Mid(line, pos + 1, rl)
        END IF
        DIM mk AS STRING = ""
        IF NOT isDot THEN mk = markerLetter(ch)
        IF mk <> "" THEN
            ' Print-control toggle: flip the attribute. When tags are revealed
            ' (^OD) it shows as a tag cell; otherwise it is zero-width.
            DIM mc AS INTEGER = Asc(ch)
            IF mc = 2 OR mc = 4 THEN bold = NOT bold
            IF mc = 25 THEN ital = NOT ital
            IF mc = 19 THEN undl = NOT undl
            IF mc = 24 THEN strk = NOT strk
            pos = pos + rl
            IF gShowTags THEN
                out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
                buf = ""
                bufCls = 0 - 1
                out = out + tagSt.Render(mk)
                cell = cell + 1
            END IF
        ELSE
            DIM cls AS INTEGER = 0
            IF rowIdx = gRow AND pos = gCol THEN
                cls = 1
            ELSEIF isInBlock(rowIdx, pos) THEN
                cls = 2
            END IF
            pos = pos + rl
            DIM diff AS BOOLEAN = cls <> bufCls OR bold <> bufB OR ital <> bufI OR undl <> bufU OR strk <> bufX
            IF diff AND buf <> "" THEN
                out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
                buf = ""
            END IF
            bufCls = cls
            bufB = bold
            bufI = ital
            bufU = undl
            bufX = strk
            buf = buf + ch
            cell = cell + 1
        END IF
    WEND
    out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
    RETURN out
END FUNCTION

' prefixMenuLines — the modernized pop-up help band for the active prefix.
FUNCTION prefixMenuLines() AS []STRING
    DIM xs AS []STRING
    IF gPrefix = "K" THEN
        xs = APPEND(xs, "BLOCK & SAVE    ^KB Begin   ^KK End   ^KC Copy   ^KV Move   ^KY Delete   ^KH Hide   ^K< Unmark")
        xs = APPEND(xs, "                ^KS Save    ^KD Save+Menu   ^KX Save+Exit   ^KQ Abandon   (Esc cancels)")
    ELSEIF gPrefix = "Q" THEN
        xs = APPEND(xs, "QUICK MOVE      ^QS LineStart  ^QD LineEnd  ^QE ScrTop  ^QX ScrBot  ^QR FileTop  ^QC FileEnd")
        xs = APPEND(xs, "                ^QF Find   ^QA Replace   ^QB BlockStart   ^QK BlockEnd   ^QY Del->EOL")
    ELSEIF gPrefix = "O" THEN
        xs = APPEND(xs, "ONSCREEN FORMAT   ^OC Center line   ^OL Left margin   ^OR Right margin   ^OD Show tags")
        xs = APPEND(xs, "                  ^OJ Justify   ^OW Word-wrap        (Esc cancels)")
    ELSEIF gPrefix = "P" THEN
        xs = APPEND(xs, "PRINT CONTROLS    ^PB Bold   ^PY Italic   ^PS Underline   (press again to end the run)")
        xs = APPEND(xs, "                  ^OD reveals the tags in the text.   (Esc cancels)")
    ELSEIF gPrefix = "J" THEN
        xs = APPEND(xs, "HELP   Cursor: ^E up ^X down ^S left ^D right  |  ^A/^F word  |  ^R/^C screen  |  Home/End line")
        xs = APPEND(xs, "       Edit:   ^G del  ^T del-word  ^Y del-line  ^N ins-line  ^V ins/over   Prefixes: ^K ^Q ^O ^P")
    END IF
    RETURN xs
END FUNCTION

' ==========================================================================
' Pull-down menu bar (WordStar 7 keybindings)
' ==========================================================================

' The eight editing-screen menus, opened with Alt+<first letter>.
FUNCTION menuCount() AS INTEGER
    RETURN 8
END FUNCTION

FUNCTION menuTitle(i AS INTEGER) AS STRING
    SELECT CASE i
    CASE 0
        RETURN "File"
    CASE 1
        RETURN "Edit"
    CASE 2
        RETURN "View"
    CASE 3
        RETURN "Insert"
    CASE 4
        RETURN "Style"
    CASE 5
        RETURN "Layout"
    CASE 6
        RETURN "Utilities"
    CASE 7
        RETURN "Help"
    END SELECT
    RETURN ""
END FUNCTION

' menuTitleX — starting column of menu i in the bar (1 leading space, then
' each title followed by two spaces).
FUNCTION menuTitleX(i AS INTEGER) AS INTEGER
    DIM x AS INTEGER = 1
    DIM j AS INTEGER
    FOR j = 0 TO i - 1
        x = x + LEN(menuTitle(j)) + 2
    NEXT j
    RETURN x
END FUNCTION

' menuItems — items for menu i, each encoded "hotkey|label|accelerator".
FUNCTION menuItems(i AS INTEGER) AS []STRING
    DIM xs AS []STRING
    SELECT CASE i
    CASE 0
        xs = APPEND(xs, "O|Open/Switch|Alt+F O")
        xs = APPEND(xs, "S|Save|Alt+F S")
        xs = APPEND(xs, "A|Save As|Alt+F A")
        xs = APPEND(xs, "P|Print|Alt+F P")
        xs = APPEND(xs, "V|Change Dir|Alt+F V")
        xs = APPEND(xs, "R|Run DOS|Alt+F R")
        xs = APPEND(xs, "X|Exit StarWord|Alt+F X")
    CASE 1
        xs = APPEND(xs, "U|Undo|Alt+E U")
        xs = APPEND(xs, "Y|Redo|Alt+E Y")
        xs = APPEND(xs, "B|Mark Block Begin|Alt+E B")
        xs = APPEND(xs, "E|Mark Block End|Alt+E E")
        xs = APPEND(xs, "V|Move Block|Alt+E V")
        xs = APPEND(xs, "C|Copy Block|Alt+E C")
        xs = APPEND(xs, "D|Delete Block|Alt+E D")
        xs = APPEND(xs, "F|Find|Alt+E F")
        xs = APPEND(xs, "R|Find and Replace|Alt+E R")
        xs = APPEND(xs, "N|Next Find|Alt+E N")
        xs = APPEND(xs, "O|Column Block Mode|Alt+E O")
        xs = APPEND(xs, "M|Block Math|Alt+E M")
    CASE 2
        xs = APPEND(xs, "B|Block Highlighting|Alt+V B")
        xs = APPEND(xs, "C|Command Tags|Alt+V C")
        xs = APPEND(xs, "P|Preview|Alt+V P")
        xs = APPEND(xs, "S|Screen Settings|Alt+V S")
    CASE 3
        xs = APPEND(xs, "P|Page Break|Alt+I P")
        xs = APPEND(xs, "T|Todays Date|Alt+I T")
        xs = APPEND(xs, "F|File|Alt+I F")
        xs = APPEND(xs, "N|Footnote|Alt+I N")
        xs = APPEND(xs, "X|Index Entry|Alt+I X")
        xs = APPEND(xs, "C|Contents Entry|Alt+I C")
        xs = APPEND(xs, "I|Make Index|Alt+I I")
        xs = APPEND(xs, "G|Make Contents|Alt+I G")
    CASE 4
        xs = APPEND(xs, "B|Bold|Alt+S B")
        xs = APPEND(xs, "I|Italic|Alt+S I")
        xs = APPEND(xs, "U|Underline|Alt+S U")
        xs = APPEND(xs, "C|Convert Case|Alt+S C")
    CASE 5
        xs = APPEND(xs, "C|Center Line|Alt+L C")
        xs = APPEND(xs, "R|Ruler Line|Alt+L R")
        xs = APPEND(xs, "P|Page|Alt+L P")
        xs = APPEND(xs, "S|Line Spacing|Alt+L S")
        xs = APPEND(xs, "F|Print to Printer|Alt+L F")
    CASE 6
        xs = APPEND(xs, "W|Word Count|Alt+U W")
        xs = APPEND(xs, "S|Spell Check|Alt+U S")
        xs = APPEND(xs, "T|Thesaurus|Alt+U T")
        xs = APPEND(xs, "G|Mail Merge|Alt+U G")
        xs = APPEND(xs, "C|Calculator|Alt+U C")
        xs = APPEND(xs, "M|Macros|Alt+U M")
    CASE 7
        xs = APPEND(xs, "H|Help|Alt+H H")
        xs = APPEND(xs, "C|Change Help Level|Alt+H C")
    END SELECT
    RETURN xs
END FUNCTION

FUNCTION itemField(item AS STRING, n AS INTEGER) AS STRING
    DIM parts AS []STRING = strings.Split(item, "|")
    IF n < LEN(parts) THEN RETURN parts[n]
    RETURN ""
END FUNCTION

' menuBoxWidth — inner content width of menu i's dropdown.
FUNCTION menuBoxWidth(i AS INTEGER) AS INTEGER
    DIM items AS []STRING = menuItems(i)
    DIM mw AS INTEGER = 8
    DIM k AS INTEGER
    FOR k = 0 TO LEN(items) - 1
        DIM lbl AS STRING = itemField(items[k], 1)
        DIM acc AS STRING = itemField(items[k], 2)
        DIM lw AS INTEGER = LEN(lbl) + 3 + LEN(acc)
        IF lw > mw THEN mw = lw
    NEXT k
    RETURN mw
END FUNCTION

' renderMenuBar — the top row: titles with the Alt hotkey letter tinted, the
' open menu reverse-highlighted.
FUNCTION renderMenuBar(w AS INTEGER) AS STRING
    DIM barStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#cfe0ff")).Background(lipgloss.Color("#21305c"))
    DIM hotStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#21305c")).Bold(TRUE)
    DIM actStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#ffd166")).Bold(TRUE)
    DIM out AS STRING = barStyle.Render(" ")
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        DIM t AS STRING = menuTitle(i)
        IF i = gMenuOpen THEN
            out = out + actStyle.Render(t)
        ELSE
            out = out + hotStyle.Render(Left(t, 1)) + barStyle.Render(Right(t, LEN(t) - 1))
        END IF
        out = out + barStyle.Render("  ")
    NEXT i
    ' Pad the rest of the bar.
    DIM used AS INTEGER = menuTitleX(menuCount() - 1) + LEN(menuTitle(menuCount() - 1)) + 2
    IF used < w THEN out = out + barStyle.Render(strings.Repeat(" ", w - used))
    RETURN out
END FUNCTION

' menuBoxLine — one styled line of the open dropdown, width boxW (= inner+4).
' lineIdx 0 = top border, 1..n = items, n+1 = bottom border.
FUNCTION menuBoxLine(menuIdx AS INTEGER, lineIdx AS INTEGER, inner AS INTEGER, selIdx AS INTEGER) AS STRING
    DIM boxStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#9cc1ff")).Background(lipgloss.Color("#14336e"))
    DIM txtStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#e6eeff")).Background(lipgloss.Color("#14336e"))
    DIM hotStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#14336e")).Bold(TRUE)
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#8ad0ff")).Bold(TRUE)
    DIM items AS []STRING = menuItems(menuIdx)
    DIM n AS INTEGER = LEN(items)
    IF lineIdx = 0 THEN
        RETURN boxStyle.Render("╭" + strings.Repeat("─", inner + 2) + "╮")
    END IF
    IF lineIdx = n + 1 THEN
        RETURN boxStyle.Render("╰" + strings.Repeat("─", inner + 2) + "╯")
    END IF
    DIM it AS STRING = items[lineIdx - 1]
    DIM lbl AS STRING = itemField(it, 1)
    DIM acc AS STRING = itemField(it, 2)
    ' content: label, spaces, accelerator (right-aligned) within `inner`.
    DIM gap AS INTEGER = inner - LEN(lbl) - LEN(acc)
    IF gap < 1 THEN gap = 1
    DIM content AS STRING = lbl + strings.Repeat(" ", gap) + acc
    content = swFit(content, inner)
    IF lineIdx - 1 = selIdx THEN
        RETURN boxStyle.Render("│") + selStyle.Render(" " + content + " ") + boxStyle.Render("│")
    END IF
    ' Tint the hotkey (first matching letter of the label) amber.
    DIM hk AS STRING = itemField(it, 0)
    DIM hpos AS INTEGER = strings.Index(content, hk)
    DIM mid AS STRING = txtStyle.Render(content)
    IF hpos >= 0 THEN
        mid = txtStyle.Render(Left(content, hpos)) + hotStyle.Render(hk) + txtStyle.Render(Right(content, LEN(content) - hpos - 1))
    END IF
    RETURN boxStyle.Render("│") + txtStyle.Render(" ") + mid + txtStyle.Render(" ") + boxStyle.Render("│")
END FUNCTION

' menuAtX — index of the bar title under column x (-1 if none).
FUNCTION menuAtX(x AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        DIM sx AS INTEGER = menuTitleX(i)
        IF x >= sx AND x < sx + LEN(menuTitle(i)) THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' ==========================================================================
' WordStar feature implementations (the menu actions that drive them)
' ==========================================================================

' --- Undo (whole-document snapshots, one step per changing keystroke) ------

' joinDoc — the whole buffer as one string (LF-separated), for snapshots.
FUNCTION joinDoc() AS STRING
    RETURN strings.Join(gLines, Chr(10))
END FUNCTION

' pushUndoState — record one undo step (the document + cursor BEFORE a change).
SUB pushUndoState(doc AS STRING, r AS INTEGER, c AS INTEGER)
    gUndoDoc = APPEND(gUndoDoc, doc)
    gUndoRow = APPEND(gUndoRow, r)
    gUndoCol = APPEND(gUndoCol, c)
    ' Cap the history so a long session can't grow without bound.
    IF LEN(gUndoDoc) > 200 THEN
        gUndoDoc = gUndoDoc[1:]
        gUndoRow = gUndoRow[1:]
        gUndoCol = gUndoCol[1:]
    END IF
END SUB

' reconcileUndo — called at the top of every keystroke. If the document
' changed during the PREVIOUS keystroke, gLastDoc still holds its pre-change
' state, so push that as an undo point. Then resync the baseline.
SUB reconcileUndo()
    DIM cur AS STRING = joinDoc()
    IF cur <> gLastDoc THEN
        pushUndoState(gLastDoc, gLastRow, gLastCol)
        gLastDoc = cur
        ' A fresh edit invalidates the redo history.
        gRedoDoc = nil
        gRedoRow = nil
        gRedoCol = nil
    END IF
    gLastRow = gRow
    gLastCol = gCol
END SUB

' syncUndoBaseline — adopt the current document as the baseline WITHOUT making
' it an undo step (used after load/new, where there's nothing to undo back to).
SUB syncUndoBaseline()
    gLastDoc = joinDoc()
    gLastRow = gRow
    gLastCol = gCol
END SUB

' doUndo — restore the most recent undo snapshot (Edit > Undo), pushing the
' current state onto the redo stack so it can be re-applied.
SUB doUndo()
    DIM n AS INTEGER = LEN(gUndoDoc)
    IF n = 0 THEN
        gMessage = "Nothing to undo"
        RETURN
    END IF
    gRedoDoc = APPEND(gRedoDoc, joinDoc())
    gRedoRow = APPEND(gRedoRow, gRow)
    gRedoCol = APPEND(gRedoCol, gCol)
    DIM doc AS STRING = gUndoDoc[n - 1]
    gRow = gUndoRow[n - 1]
    gCol = gUndoCol[n - 1]
    gUndoDoc = gUndoDoc[0:n - 1]
    gUndoRow = gUndoRow[0:n - 1]
    gUndoCol = gUndoCol[0:n - 1]
    gLines = strings.Split(doc, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    clampCursor()
    syncUndoBaseline()
    gModified = TRUE
    gMessage = "Undid last change"
END SUB

' doRedo — re-apply the most recently undone change (Edit > Redo).
SUB doRedo()
    DIM n AS INTEGER = LEN(gRedoDoc)
    IF n = 0 THEN
        gMessage = "Nothing to redo"
        RETURN
    END IF
    pushUndoState(joinDoc(), gRow, gCol)
    DIM doc AS STRING = gRedoDoc[n - 1]
    gRow = gRedoRow[n - 1]
    gCol = gRedoCol[n - 1]
    gRedoDoc = gRedoDoc[0:n - 1]
    gRedoRow = gRedoRow[0:n - 1]
    gRedoCol = gRedoCol[0:n - 1]
    gLines = strings.Split(doc, Chr(10))
    IF LEN(gLines) = 0 THEN gLines = APPEND(gLines, "")
    clampCursor()
    syncUndoBaseline()
    gModified = TRUE
    gMessage = "Redid change"
END SUB

' --- Insert menu: text/date/page-break/file -------------------------------

' insertTextAtCursor — splice a (newline-free) string in at the cursor.
SUB insertTextAtCursor(s AS STRING)
    DIM ln AS STRING = curLine()
    gLines[gRow] = Left(ln, gCol) + s + Right(ln, LEN(ln) - gCol)
    gCol = gCol + LEN(s)
    gModified = TRUE
END SUB

' insertTodaysDate — Insert > Today's Date.
SUB insertTodaysDate()
    insertTextAtCursor(time.Now().Format("January 2, 2006"))
    gMessage = "Date inserted"
END SUB

' insertPageBreak — Insert > Page Break: WordStar's .pa dot command on its
' own line, with a fresh line after it for the next page's text.
SUB insertPageBreak()
    IF gCol > 0 OR strings.TrimSpace(curLine()) <> "" THEN
        gLines = lineInsertAt(gLines, gRow + 1, ".pa")
        gRow = gRow + 1
    ELSE
        gLines[gRow] = ".pa"
    END IF
    gLines = lineInsertAt(gLines, gRow + 1, "")
    gRow = gRow + 1
    gCol = 0
    gModified = TRUE
    gMessage = "Page break (.pa) inserted"
END SUB

' insertDotLine — drop a dot-command line (footnote / index / TOC mark or a
' .index/.toc generator) on its own line after the cursor.
SUB insertDotLine(content AS STRING, note AS STRING)
    IF strings.TrimSpace(curLine()) = "" THEN
        gLines[gRow] = content
    ELSE
        gLines = lineInsertAt(gLines, gRow + 1, content)
        gRow = gRow + 1
    END IF
    gCol = 0
    gModified = TRUE
    gMessage = note
END SUB

' doInsertFile — Insert > File: read a file and splice its lines in at the
' cursor (the current line is split around the insertion).
SUB doInsertFile(path AS STRING)
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(path)
    IF e <> NIL THEN
        gMessage = "Cannot read " + path
        RETURN
    END IF
    DIM text AS STRING = Decode(data)
    text = strings.ReplaceAll(text, Chr(13) + Chr(10), Chr(10))
    text = strings.ReplaceAll(text, Chr(13), Chr(10))
    DIM flines AS []STRING = strings.Split(text, Chr(10))
    DIM nf AS INTEGER = LEN(flines)
    IF nf = 0 THEN
        gMessage = "Empty file: " + path
        RETURN
    END IF
    DIM ln AS STRING = curLine()
    DIM head AS STRING = Left(ln, gCol)
    DIM tail AS STRING = Right(ln, LEN(ln) - gCol)
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO gRow - 1
        out = APPEND(out, gLines[i])
    NEXT i
    IF nf = 1 THEN
        out = APPEND(out, head + flines[0] + tail)
    ELSE
        out = APPEND(out, head + flines[0])
        FOR i = 1 TO nf - 2
            out = APPEND(out, flines[i])
        NEXT i
        out = APPEND(out, flines[nf - 1] + tail)
    END IF
    FOR i = gRow + 1 TO lastRow()
        out = APPEND(out, gLines[i])
    NEXT i
    gLines = out
    gRow = gRow + nf - 1
    gCol = LEN(flines[nf - 1])
    gModified = TRUE
    gMessage = fmt.Sprintf("Inserted %s (%d line(s))", path, nf)
END SUB

' --- Style menu: convert case ---------------------------------------------

' convertCaseWord — Style > Convert Case: flip the case of the word at the
' cursor (all-caps -> lower, otherwise -> upper).
' convertCaseBlock — flip the case of the whole marked (stream) block.
SUB convertCaseBlock()
    DIM sR AS INTEGER
    DIM sC AS INTEGER
    DIM eR AS INTEGER
    DIM eC AS INTEGER
    sR, sC, eR, eC = blockBounds()
    DIM doc AS STRING = strings.Join(gLines, Chr(10))
    DIM s AS INTEGER = offsetOf(sR, sC)
    DIM e AS INTEGER = offsetOf(eR, eC)
    DIM blk AS STRING = Mid(doc, s + 1, e - s)
    DIM newBlk AS STRING = UCase(blk)
    IF blk = UCase(blk) THEN newBlk = LCase(blk)
    setDoc(Left(doc, s) + newBlk + Right(doc, LEN(doc) - e))
    gModified = TRUE
    gMessage = "Block case converted"
END SUB

SUB convertCaseWord()
    ' With a stream block marked, convert the whole block; else the word.
    IF blockSet() AND gBlockShow AND NOT gColumnMode THEN
        convertCaseBlock()
        RETURN
    END IF
    DIM ln AS STRING = curLine()
    DIM s AS INTEGER = gCol
    WHILE s > 0 AND isWordCh(runeAt(ln, prevRuneStart(ln, s)))
        s = prevRuneStart(ln, s)
    WEND
    DIM e AS INTEGER = gCol
    WHILE e < LEN(ln) AND isWordCh(runeAt(ln, e))
        e = nextRuneStart(ln, e)
    WEND
    IF s >= e THEN
        gMessage = "No word at cursor"
        RETURN
    END IF
    DIM word AS STRING = Mid(ln, s + 1, e - s)
    DIM newWord AS STRING = UCase(word)
    IF word = UCase(word) THEN newWord = LCase(word)
    gLines[gRow] = Left(ln, s) + newWord + Right(ln, LEN(ln) - e)
    gCol = e
    gModified = TRUE
    gMessage = "Case converted"
END SUB

' --- File menu: change dir / run DOS / print ------------------------------

' doChdir — File > Change Dir.
SUB doChdir(path AS STRING)
    DIM e AS ERROR = os.Chdir(path)
    IF e <> NIL THEN
        gMessage = "Cannot change to " + path
        RETURN
    END IF
    gOpenDir = "."
    gMessage = "Working directory: " + path
END SUB

' doRunDos — File > Run DOS: run a shell command, show its output on the
' message line (newlines flattened to " | ").
SUB doRunDos(cmd AS STRING)
    IF strings.TrimSpace(cmd) = "" THEN RETURN
    DIM shell AS STRING = "sh"
    DIM flag AS STRING = "-c"
    IF runtime.GOOS = "windows" THEN
        shell = "cmd"
        flag = "/C"
    END IF
    DIM out AS BYTES
    DIM e AS ERROR
    out, e = exec.Command(shell, flag, cmd).CombinedOutput()
    DIM res AS STRING = strings.TrimSpace(Decode(out))
    res = strings.ReplaceAll(res, Chr(13), "")
    res = strings.ReplaceAll(res, Chr(10), " | ")
    IF e <> NIL THEN
        gMessage = "Run failed: " + res
    ELSEIF res = "" THEN
        gMessage = "Ran (no output)"
    ELSE
        gMessage = "Run: " + res
    END IF
END SUB

' stripMarkers — drop the zero-width ^P print-control toggle bytes from a line.
FUNCTION stripMarkers(s AS STRING) AS STRING
    DIM acc AS STRING = ""
    DIM p AS INTEGER = 0
    WHILE p < LEN(s)
        DIM ch AS STRING = runeAt(s, p)
        IF markerLetter(ch) = "" THEN acc = acc + ch
        p = nextRuneStart(s, p)
    WEND
    RETURN acc
END FUNCTION

' doPrint — File > Print: write a paginated print image (<base>.prn) with
' headers/footers, page numbers, markers stripped and dot lines dropped.
SUB doPrint()
    applyDotCommands()
    DIM out AS []STRING = buildPaginated(FALSE)
    DIM stem AS STRING = gFileName
    DIM dotPos AS INTEGER = strings.LastIndex(stem, ".")
    IF dotPos > 0 THEN stem = Left(stem, dotPos)
    DIM target AS STRING = stem + ".prn"
    DIM body AS STRING = strings.Join(out, Chr(13) + Chr(10))
    DIM e AS ERROR = os.WriteFile(target, Encode(body), 420)
    IF e <> NIL THEN
        gMessage = "Print failed: " + e.Error()
        RETURN
    END IF
    DIM np AS INTEGER = LEN(paginate())
    ' If a print command is configured, pipe the print image to it too.
    IF strings.TrimSpace(gPrintCommand) <> "" THEN
        DIM shell AS STRING = "sh"
        DIM flag AS STRING = "-c"
        IF runtime.GOOS = "windows" THEN
            shell = "cmd"
            flag = "/C"
        END IF
        DIM c AS POINTER TO exec.Cmd = exec.Command(shell, flag, gPrintCommand)
        (^c).Stdin = strings.NewReader(body)
        DIM pe AS ERROR = (^c).Run()
        IF pe <> NIL THEN
            gMessage = fmt.Sprintf("Wrote %s; printer failed: %v", target, pe)
        ELSE
            gMessage = fmt.Sprintf("Printed %d pages to %s and to '%s'", np, target, gPrintCommand)
        END IF
        RETURN
    END IF
    gMessage = fmt.Sprintf("Printed %d pages to %s", np, target)
END SUB

' ==========================================================================
' MailMerge — form-letter printing from a data file
'   .df <file>        the comma-delimited data file (one record per line)
'   .rv v1,v2,...     bind the current record's fields to these variables
'   &name&            substituted with the variable's value
' The document is merge-printed once per record, separated by page breaks.
' ==========================================================================

' splitCSV — split a data record into trimmed fields, honoring double quotes
' so a quoted field may contain commas (the quotes themselves are dropped).
FUNCTION splitCSV(line AS STRING) AS []STRING
    DIM out AS []STRING
    DIM cur AS STRING = ""
    DIM inq AS BOOLEAN = FALSE
    DIM p AS INTEGER = 0
    WHILE p < LEN(line)
        DIM ch AS STRING = Mid(line, p + 1, 1)
        IF ch = Chr(34) THEN
            inq = NOT inq
        ELSEIF ch = "," AND NOT inq THEN
            out = APPEND(out, strings.TrimSpace(cur))
            cur = ""
        ELSE
            cur = cur + ch
        END IF
        p = p + 1
    WEND
    out = APPEND(out, strings.TrimSpace(cur))
    RETURN out
END FUNCTION

' substVars — replace every &name& in a line with the variable's value.
FUNCTION substVars(line AS STRING, vars AS MAP OF STRING TO STRING) AS STRING
    DIM out AS STRING = ""
    DIM p AS INTEGER = 0
    WHILE p < LEN(line)
        IF Mid(line, p + 1, 1) = "&" THEN
            DIM rest AS STRING = Mid(line, p + 2, LEN(line) - p - 1)
            DIM e AS INTEGER = strings.Index(rest, "&")
            IF e >= 0 THEN
                DIM nm AS STRING = strings.TrimSpace(Mid(line, p + 2, e))
                out = out + vars[nm]
                p = p + 2 + e
            ELSE
                out = out + "&"
                p = p + 1
            END IF
        ELSE
            out = out + Mid(line, p + 1, 1)
            p = p + 1
        END IF
    WEND
    RETURN out
END FUNCTION

' mergeExpand — expand the template once per data record (vars substituted),
' separated by page breaks. Empty if there is no .df or no records.
FUNCTION mergeExpand() AS []STRING
    DIM out AS []STRING
    gMergeRecords = 0
    DIM dfPath AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        IF Left(gLines[i], 4) = ".df " THEN dfPath = strings.TrimSpace(Mid(gLines[i], 5, LEN(gLines[i]) - 4))
    NEXT i
    IF dfPath = "" THEN RETURN out
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(dfPath)
    IF e <> NIL THEN RETURN out
    DIM text AS STRING = Decode(data)
    text = strings.ReplaceAll(text, Chr(13) + Chr(10), Chr(10))
    text = strings.ReplaceAll(text, Chr(13), Chr(10))
    DIM rawlines AS []STRING = strings.Split(text, Chr(10))
    DIM records AS []STRING
    FOR i = 0 TO LEN(rawlines) - 1
        IF strings.TrimSpace(rawlines[i]) <> "" THEN records = APPEND(records, rawlines[i])
    NEXT i
    gMergeRecords = LEN(records)
    DIM r AS INTEGER
    FOR r = 0 TO LEN(records) - 1
        DIM fields AS []STRING = splitCSV(records[r])
        DIM vars AS MAP OF STRING TO STRING
        DIM j AS INTEGER
        FOR j = 0 TO lastRow()
            DIM ln AS STRING = gLines[j]
            IF Left(ln, 4) = ".rv " THEN
                DIM names AS []STRING = strings.Split(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4)), ",")
                DIM k AS INTEGER
                FOR k = 0 TO LEN(names) - 1
                    DIM v AS STRING = ""
                    IF k < LEN(fields) THEN v = fields[k]
                    vars[strings.TrimSpace(names[k])] = v
                NEXT k
            ELSEIF Left(ln, 4) <> ".df " THEN
                out = APPEND(out, substVars(ln, vars))
            END IF
        NEXT j
        IF r < LEN(records) - 1 THEN out = APPEND(out, ".pa")
    NEXT r
    RETURN out
END FUNCTION

' mergePrintLines — the merged document, paginated for printing (empty if no
' merge data). Temporarily swaps the merged lines in for buildPaginated.
FUNCTION mergePrintLines() AS []STRING
    DIM merged AS []STRING = mergeExpand()
    IF LEN(merged) = 0 THEN RETURN merged
    DIM saveLines AS []STRING = gLines
    gLines = merged
    applyDotCommands()
    DIM outp AS []STRING = buildPaginated(FALSE)
    gLines = saveLines
    applyDotCommands()
    RETURN outp
END FUNCTION

' doMailMerge — Utilities > Mail Merge: write the merged result to <stem>.mrg.
SUB doMailMerge()
    DIM outp AS []STRING = mergePrintLines()
    IF LEN(outp) = 0 THEN
        gMessage = "MailMerge needs a readable .df data file (and records)"
        RETURN
    END IF
    DIM stem AS STRING = gFileName
    DIM dotPos AS INTEGER = strings.LastIndex(stem, ".")
    IF dotPos > 0 THEN stem = Left(stem, dotPos)
    DIM target AS STRING = stem + ".mrg"
    DIM e AS ERROR = os.WriteFile(target, Encode(strings.Join(outp, Chr(13) + Chr(10))), 420)
    IF e <> NIL THEN
        gMessage = "Merge failed: " + e.Error()
        RETURN
    END IF
    gMessage = fmt.Sprintf("Merged %d records to %s", gMergeRecords, target)
END SUB

' --- Utilities menu: calculator -------------------------------------------
' A small recursive-descent evaluator for + - * / and parentheses over
' gCalcSrc, advanced by gCalcPos (0-based byte index).

SUB calcSkip()
    WHILE gCalcPos < LEN(gCalcSrc) AND Mid(gCalcSrc, gCalcPos + 1, 1) = " "
        gCalcPos = gCalcPos + 1
    WEND
END SUB

FUNCTION calcPeek() AS STRING
    IF gCalcPos >= LEN(gCalcSrc) THEN RETURN ""
    RETURN Mid(gCalcSrc, gCalcPos + 1, 1)
END FUNCTION

FUNCTION calcNumber() AS DOUBLE
    DIM startp AS INTEGER = gCalcPos
    DIM more AS BOOLEAN = TRUE
    WHILE gCalcPos < LEN(gCalcSrc) AND more
        DIM c AS STRING = Mid(gCalcSrc, gCalcPos + 1, 1)
        DIM a AS INTEGER = Asc(c)
        IF (a >= 48 AND a <= 57) OR c = "." THEN
            gCalcPos = gCalcPos + 1
        ELSE
            more = FALSE
        END IF
    WEND
    RETURN Val(Mid(gCalcSrc, startp + 1, gCalcPos - startp))
END FUNCTION

FUNCTION calcFactor() AS DOUBLE
    calcSkip()
    DIM c AS STRING = calcPeek()
    IF c = "(" THEN
        gCalcPos = gCalcPos + 1
        DIM v AS DOUBLE = calcExpr()
        calcSkip()
        IF calcPeek() = ")" THEN gCalcPos = gCalcPos + 1
        RETURN v
    END IF
    IF c = "-" THEN
        gCalcPos = gCalcPos + 1
        RETURN 0 - calcFactor()
    END IF
    IF c = "+" THEN
        gCalcPos = gCalcPos + 1
        RETURN calcFactor()
    END IF
    RETURN calcNumber()
END FUNCTION

FUNCTION calcTerm() AS DOUBLE
    DIM v AS DOUBLE = calcFactor()
    DIM more AS BOOLEAN = TRUE
    WHILE more
        calcSkip()
        DIM c AS STRING = calcPeek()
        IF c = "*" THEN
            gCalcPos = gCalcPos + 1
            v = v * calcFactor()
        ELSEIF c = "/" THEN
            gCalcPos = gCalcPos + 1
            DIM d AS DOUBLE = calcFactor()
            IF d <> 0 THEN
                v = v / d
            ELSE
                v = 0
            END IF
        ELSE
            more = FALSE
        END IF
    WEND
    RETURN v
END FUNCTION

FUNCTION calcExpr() AS DOUBLE
    DIM v AS DOUBLE = calcTerm()
    DIM more AS BOOLEAN = TRUE
    WHILE more
        calcSkip()
        DIM c AS STRING = calcPeek()
        IF c = "+" THEN
            gCalcPos = gCalcPos + 1
            v = v + calcTerm()
        ELSEIF c = "-" THEN
            gCalcPos = gCalcPos + 1
            v = v - calcTerm()
        ELSE
            more = FALSE
        END IF
    WEND
    RETURN v
END FUNCTION

' doCalc — Utilities > Calculator: evaluate and show the result.
SUB doCalc(expr AS STRING)
    IF strings.TrimSpace(expr) = "" THEN RETURN
    gCalcSrc = expr
    gCalcPos = 0
    DIM v AS DOUBLE = calcExpr()
    gMessage = expr + " = " + fmt.Sprintf("%g", v)
END SUB

' openCalculator — Utilities > Calculator: show the on-screen calculator.
SUB openCalculator()
    gCalcOpen = TRUE
    gCalcInput = ""
    gCalcResult = ""
END SUB

' handleCalcWidget — keystrokes while the calculator panel is open.
SUB handleCalcWidget(key AS STRING)
    IF key = "esc" THEN
        gCalcOpen = FALSE
        gMessage = ""
        RETURN
    END IF
    IF key = "enter" THEN
        IF strings.TrimSpace(gCalcInput) <> "" THEN
            gCalcSrc = gCalcInput
            gCalcPos = 0
            DIM v AS DOUBLE = calcExpr()
            gCalcResult = fmt.Sprintf("%g", v)
            gCalcTape = APPEND(gCalcTape, gCalcInput + " = " + gCalcResult)
            IF LEN(gCalcTape) > 6 THEN gCalcTape = gCalcTape[1:]
            gCalcInput = gCalcResult
            gCalcJustEval = TRUE
        END IF
        RETURN
    END IF
    IF key = "backspace" OR key = "ctrl+h" THEN
        IF LEN(gCalcInput) > 0 THEN gCalcInput = Left(gCalcInput, LEN(gCalcInput) - 1)
        gCalcJustEval = FALSE
        RETURN
    END IF
    DIM lk AS STRING = LCase(key)
    IF lk = "c" THEN
        gCalcInput = ""
        gCalcJustEval = FALSE
        RETURN
    END IF
    IF lk = "i" THEN
        IF gCalcResult <> "" THEN insertTextAtCursor(gCalcResult)
        gCalcOpen = FALSE
        gMessage = "Result inserted"
        RETURN
    END IF
    IF key = "space" THEN
        gCalcInput = gCalcInput + " "
        RETURN
    END IF
    ' Accept only calculator characters (digits / operators / parens). After a
    ' result, a digit/paren starts a fresh expression; an operator continues it.
    IF LEN(key) = 1 AND strings.Contains("0123456789+-*/().%", key) THEN
        IF gCalcJustEval THEN
            IF NOT strings.Contains("+-*/.%", key) THEN gCalcInput = ""
            gCalcJustEval = FALSE
        END IF
        gCalcInput = gCalcInput + key
    END IF
END SUB

' --- Utilities menu: keyboard macro ---------------------------------------

' macroToggle — Utilities > Macros cycles: start recording -> stop -> play.
SUB macroToggle()
    IF gMacroRecording THEN
        gMacroRecording = FALSE
        ' Trim the trailing Alt+U, M used to reopen the menu and stop.
        DIM n AS INTEGER = LEN(gMacroKeys)
        IF n >= 2 AND gMacroKeys[n - 2] = "alt+u" AND gMacroKeys[n - 1] = "m" THEN
            gMacroKeys = gMacroKeys[0:n - 2]
        END IF
        gMessage = fmt.Sprintf("Macro recorded (%d keys) — Utilities>Macros plays it", LEN(gMacroKeys))
    ELSEIF LEN(gMacroKeys) > 0 THEN
        macroPlay()
    ELSE
        gMacroKeys = nil
        gMacroRecording = TRUE
        gMessage = "Recording macro… Utilities>Macros again to stop"
    END IF
END SUB

' macroPlay — replay the recorded keys through the normal key handler.
SUB macroPlay()
    DIM keys AS []STRING = gMacroKeys
    gMacroPlaying = TRUE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(keys) - 1
        Form_Key(keys[i])
    NEXT i
    gMacroPlaying = FALSE
    gMessage = fmt.Sprintf("Macro played (%d keys)", LEN(keys))
END SUB

' --- Help menu: help level ------------------------------------------------

' cycleHelpLevel — Help > Change Help Level: WordStar levels 0..3.
SUB cycleHelpLevel()
    gHelpLevel = (gHelpLevel + 1) MOD 4
    gMessage = fmt.Sprintf("Help level = %d", gHelpLevel)
END SUB

' --- View menu: print preview ---------------------------------------------

' renderPreview — a clean, read-only page image: dot commands hidden and
' print-control toggles stripped. Any key returns to the editor.
FUNCTION renderPreview(w AS INTEGER, h AS INTEGER) AS STRING
    DIM hdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#ffd166")).Bold(TRUE)
    DIM pg AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#101010")).Background(lipgloss.Color("#f4f4f4"))
    applyDotCommands()
    DIM body AS []STRING = buildPaginated(TRUE)
    IF gPrevTop > LEN(body) - 1 THEN gPrevTop = LEN(body) - 1
    IF gPrevTop < 0 THEN gPrevTop = 0
    DIM rows AS []STRING
    rows = APPEND(rows, hdr.Render(swFit(" PREVIEW  -  " + gFileName + fmt.Sprintf("    line %d/%d    (arrows/PgUp/PgDn scroll, Esc exits)", gPrevTop + 1, LEN(body)), w)))
    DIM shown AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = gPrevTop TO LEN(body) - 1
        IF shown < h - 1 THEN
            rows = APPEND(rows, pg.Render(swFit(body[i], w)))
            shown = shown + 1
        END IF
    NEXT i
    WHILE LEN(rows) < h
        rows = APPEND(rows, pg.Render(swFit("", w)))
    WEND
    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' ==========================================================================
' Configuration — a WSCHANGE-style settings program + ~/.starword file
' WordStar configured itself by patching WS.EXE via WSCHANGE; StarWord keeps
' the same idea but persists to a small text file you can also hand-edit.
' ==========================================================================

FUNCTION onoff(b AS BOOLEAN) AS STRING
    IF b THEN RETURN "on"
    RETURN "off"
END FUNCTION

' configPath — the ~/.starword file (current dir if there is no home).
FUNCTION configPath() AS STRING
    DIM home AS STRING
    DIM e AS ERROR
    home, e = os.UserHomeDir()
    IF e <> NIL OR home = "" THEN RETURN ".starword"
    RETURN home + "/.starword"
END FUNCTION

' cycleWrapMode — hard -> soft -> off -> hard; keep gWordWrap (hard-insert) in sync.
SUB cycleWrapMode()
    IF gWrapMode = "hard" THEN
        gWrapMode = "soft"
    ELSEIF gWrapMode = "soft" THEN
        gWrapMode = "off"
    ELSE
        gWrapMode = "hard"
    END IF
    gWordWrap = (gWrapMode = "hard")
END SUB

' applySetting — set one configuration key to a value.
SUB applySetting(k AS STRING, v AS STRING)
    DIM lv AS STRING = LCase(v)
    IF k = "wrapmode" THEN
        IF lv = "hard" OR lv = "soft" OR lv = "off" THEN gWrapMode = lv
        gWordWrap = (gWrapMode = "hard")
    ELSEIF k = "justify" THEN
        gJustify = (lv = "on" OR lv = "true" OR lv = "1")
    ELSEIF k = "leftmargin" THEN
        gLeftMargin = Int(Val(v))
    ELSEIF k = "rightmargin" THEN
        DIM rv AS INTEGER = Int(Val(v))
        IF rv > 0 THEN gRightMargin = rv
    ELSEIF k = "pagelength" THEN
        DIM pv AS INTEGER = Int(Val(v))
        IF pv > 0 THEN gPageLength = pv
    ELSEIF k = "tabwidth" THEN
        DIM tv AS INTEGER = Int(Val(v))
        IF tv > 0 THEN gTabWidth = tv
    ELSEIF k = "startcols" THEN
        DIM sc AS INTEGER = Int(Val(v))
        IF sc > 0 THEN gStartCols = sc
    ELSEIF k = "startrows" THEN
        DIM sr AS INTEGER = Int(Val(v))
        IF sr > 0 THEN gStartRows = sr
    ELSEIF k = "helplevel" THEN
        gHelpLevel = Int(Val(v))
    ELSEIF k = "unicode" THEN
        gDefaultUnicode = (lv = "on" OR lv = "true" OR lv = "1")
    ELSEIF k = "dictionary" THEN
        IF v <> "" THEN gDictPath = v
    ELSEIF k = "thesaurus" THEN
        IF v <> "" THEN gThesPath = v
    ELSEIF k = "printcommand" THEN
        gPrintCommand = v
    END IF
END SUB

' serializeConfig — the current settings as the ~/.starword file body.
FUNCTION serializeConfig() AS STRING
    DIM b AS STRING = "# StarWord configuration (edit here or via the in-app config)" + Chr(10)
    b = b + "wrapmode = " + gWrapMode + Chr(10)
    b = b + "justify = " + onoff(gJustify) + Chr(10)
    b = b + "leftmargin = " + fmt.Sprintf("%d", gLeftMargin) + Chr(10)
    b = b + "rightmargin = " + fmt.Sprintf("%d", gRightMargin) + Chr(10)
    b = b + "pagelength = " + fmt.Sprintf("%d", gPageLength) + Chr(10)
    b = b + "tabwidth = " + fmt.Sprintf("%d", gTabWidth) + Chr(10)
    b = b + "startcols = " + fmt.Sprintf("%d", gStartCols) + Chr(10)
    b = b + "startrows = " + fmt.Sprintf("%d", gStartRows) + Chr(10)
    b = b + "helplevel = " + fmt.Sprintf("%d", gHelpLevel) + Chr(10)
    b = b + "unicode = " + onoff(gDefaultUnicode) + Chr(10)
    b = b + "dictionary = " + gDictPath + Chr(10)
    b = b + "thesaurus = " + gThesPath + Chr(10)
    b = b + "printcommand = " + gPrintCommand + Chr(10)
    RETURN b
END FUNCTION

' applyConfigText — parse "key = value" lines (and # comments) into settings.
SUB applyConfigText(text AS STRING)
    DIM lines AS []STRING = strings.Split(text, Chr(10))
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        DIM ln AS STRING = strings.TrimSpace(lines[i])
        IF ln <> "" AND Left(ln, 1) <> "#" THEN
            DIM eq AS INTEGER = strings.Index(ln, "=")
            IF eq > 0 THEN
                DIM k AS STRING = LCase(strings.TrimSpace(Left(ln, eq)))
                DIM v AS STRING = strings.TrimSpace(Mid(ln, eq + 2, LEN(ln) - eq - 1))
                applySetting(k, v)
            END IF
        END IF
    NEXT i
END SUB

' loadConfig — read ~/.starword at startup (silent if absent).
SUB loadConfig()
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(configPath())
    IF e <> NIL THEN RETURN
    applyConfigText(Decode(data))
END SUB

' saveConfig — write the current settings to ~/.starword.
SUB saveConfig()
    DIM e AS ERROR = os.WriteFile(configPath(), Encode(serializeConfig()), 420)
    IF e <> NIL THEN
        gMessage = "Config save failed: " + e.Error()
    ELSE
        gMessage = "Configuration saved to " + configPath()
    END IF
END SUB

' enterConfig — open the WSCHANGE-style screen, remembering where to return.
SUB enterConfig()
    gCfgReturn = gMode
    IF gCfgReturn = "config" THEN gCfgReturn = "edit"
    gCfgSnapshot = serializeConfig()
    gMode = "config"
    gMessage = ""
END SUB

' renderConfig — the configuration screen (WordStar WSCHANGE-style menu).
FUNCTION renderConfig(w AS INTEGER, h AS INTEGER) AS STRING
    DIM hdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#3b6fe0")).Bold(TRUE)
    DIM bg AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#0f2350"))
    DIM key AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#0f2350")).Bold(TRUE)
    DIM val AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#9ece6a")).Background(lipgloss.Color("#0f2350")).Bold(TRUE)
    DIM rows AS []STRING
    rows = APPEND(rows, hdr.Render(swFit(" StarWord  -  Configuration (WSCHANGE)", w)))
    rows = APPEND(rows, bg.Render(swFit("", w)))
    _ = key
    rows = APPEND(rows, cfgRow("A", "Word wrap", UCase(gWrapMode), val, bg, w))
    rows = APPEND(rows, cfgRow("B", "Justification", onoff(gJustify), val, bg, w))
    rows = APPEND(rows, cfgRow("C", "Left margin", fmt.Sprintf("%d", gLeftMargin), val, bg, w))
    rows = APPEND(rows, cfgRow("D", "Right margin", fmt.Sprintf("%d", gRightMargin), val, bg, w))
    rows = APPEND(rows, cfgRow("E", "Page length", fmt.Sprintf("%d", gPageLength), val, bg, w))
    rows = APPEND(rows, cfgRow("F", "Tab width", fmt.Sprintf("%d", gTabWidth), val, bg, w))
    rows = APPEND(rows, cfgRow("G", "Help level", fmt.Sprintf("%d", gHelpLevel), val, bg, w))
    rows = APPEND(rows, cfgRow("H", "New files Unicode", onoff(gDefaultUnicode), val, bg, w))
    rows = APPEND(rows, cfgRow("I", "Startup columns", fmt.Sprintf("%d", gStartCols), val, bg, w))
    rows = APPEND(rows, cfgRow("J", "Startup rows", fmt.Sprintf("%d", gStartRows), val, bg, w))
    rows = APPEND(rows, cfgRow("K", "Dictionary", gDictPath, val, bg, w))
    rows = APPEND(rows, cfgRow("L", "Thesaurus", gThesPath, val, bg, w))
    rows = APPEND(rows, cfgRow("M", "Print command", gPrintCommand, val, bg, w))
    rows = APPEND(rows, bg.Render(swFit("", w)))
    rows = APPEND(rows, bg.Render(swFit("  Press a letter to change a setting.", w)))
    WHILE LEN(rows) < h - 1
        rows = APPEND(rows, bg.Render(swFit("", w)))
    WEND
    DIM foot AS STRING = "  S Save & exit    Esc Use without saving    Q Abandon changes"
    IF gPromptMode <> "" THEN foot = " " + gPromptLabel + gPromptText + Chr(9617)
    rows = APPEND(rows, hdr.Render(swFit(foot, w)))
    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' cfgRow — one "  A   Label .......... VALUE" configuration line.
FUNCTION cfgRow(letter AS STRING, label AS STRING, value AS STRING, val AS lipgloss.Style, bg AS lipgloss.Style, w AS INTEGER) AS STRING
    DIM lbl AS STRING = "  " + letter + "   " + label + " "
    DIM dots AS INTEGER = 30 - LEN(lbl)
    IF dots < 1 THEN dots = 1
    lbl = lbl + strings.Repeat(".", dots) + " "
    DIM pad AS INTEGER = w - LEN(lbl) - LEN(value)
    IF pad < 0 THEN pad = 0
    RETURN bg.Render(lbl) + val.Render(value) + bg.Render(strings.Repeat(" ", pad))
END FUNCTION

' handleConfigKey — keyboard for the configuration screen.
SUB handleConfigKey(key AS STRING)
    IF key = "esc" THEN
        gMode = gCfgReturn
        gMessage = "Settings applied for this session (not saved)"
        RETURN
    END IF
    DIM k AS STRING = LCase(key)
    IF strings.HasPrefix(k, "ctrl+") THEN k = Right(k, LEN(k) - 5)
    IF k = "a" THEN
        cycleWrapMode()
    ELSEIF k = "b" THEN
        gJustify = NOT gJustify
    ELSEIF k = "c" THEN
        gPromptMode = "cfg_lm"
        gPromptLabel = "Left margin: "
        gPromptText = ""
    ELSEIF k = "d" THEN
        gPromptMode = "cfg_rm"
        gPromptLabel = "Right margin: "
        gPromptText = ""
    ELSEIF k = "e" THEN
        gPromptMode = "cfg_pl"
        gPromptLabel = "Page length: "
        gPromptText = ""
    ELSEIF k = "f" THEN
        gPromptMode = "cfg_tw"
        gPromptLabel = "Tab width: "
        gPromptText = ""
    ELSEIF k = "g" THEN
        gHelpLevel = (gHelpLevel + 1) MOD 4
    ELSEIF k = "h" THEN
        gDefaultUnicode = NOT gDefaultUnicode
    ELSEIF k = "i" THEN
        gPromptMode = "cfg_sc"
        gPromptLabel = "Startup columns: "
        gPromptText = ""
    ELSEIF k = "j" THEN
        gPromptMode = "cfg_sr"
        gPromptLabel = "Startup rows: "
        gPromptText = ""
    ELSEIF k = "k" THEN
        gPromptMode = "cfg_dict"
        gPromptLabel = "Dictionary path: "
        gPromptText = ""
    ELSEIF k = "l" THEN
        gPromptMode = "cfg_thes"
        gPromptLabel = "Thesaurus path: "
        gPromptText = ""
    ELSEIF k = "m" THEN
        gPromptMode = "cfg_printcmd"
        gPromptLabel = "Print command (e.g. lp): "
        gPromptText = ""
    ELSEIF k = "s" THEN
        saveConfig()
        gMode = gCfgReturn
    ELSEIF k = "q" THEN
        applyConfigText(gCfgSnapshot)
        gMode = gCfgReturn
        gMessage = "Configuration unchanged"
    END IF
END SUB

' ==========================================================================
' Spell check (CorrectStar-style) + a small built-in thesaurus
' ==========================================================================

' personalDictPath — ~/.starword.dict (words added via "A" during a check).
FUNCTION personalDictPath() AS STRING
    DIM home AS STRING
    DIM e AS ERROR
    home, e = os.UserHomeDir()
    IF e <> NIL OR home = "" THEN RETURN ".starword.dict"
    RETURN home + "/.starword.dict"
END FUNCTION

' addWord — add a lowercased word to the dictionary (deduped count).
SUB addWord(w AS STRING)
    DIM lw AS STRING = LCase(strings.TrimSpace(w))
    IF lw <> "" THEN
        IF NOT gDict[lw] THEN gDictCount = gDictCount + 1
        gDict[lw] = TRUE
    END IF
END SUB

FUNCTION isAllDigits(s AS STRING) AS BOOLEAN
    IF s = "" THEN RETURN FALSE
    DIM i AS INTEGER = 0
    WHILE i < LEN(s)
        DIM a AS INTEGER = Asc(Mid(s, i + 1, 1))
        IF a < 48 OR a > 57 THEN RETURN FALSE
        i = i + 1
    WEND
    RETURN TRUE
END FUNCTION

' --- hunspell affix expansion (.dic stems + .aff rules) -------------------

' parseCondAtoms — break a hunspell condition into per-character atoms:
'   "." -> any, "X" -> "=X", "[abc]" -> "+abc", "[^abc]" -> "-abc".
FUNCTION parseCondAtoms(cond AS STRING) AS []STRING
    DIM atoms AS []STRING
    DIM p AS INTEGER = 0
    WHILE p < LEN(cond)
        DIM c AS STRING = Mid(cond, p + 1, 1)
        IF c = "." THEN
            atoms = APPEND(atoms, ".")
            p = p + 1
        ELSEIF c = "[" THEN
            DIM q AS INTEGER = p + 1
            DIM neg AS BOOLEAN = FALSE
            IF q < LEN(cond) AND Mid(cond, q + 1, 1) = "^" THEN
                neg = TRUE
                q = q + 1
            END IF
            DIM setstr AS STRING = ""
            WHILE q < LEN(cond) AND Mid(cond, q + 1, 1) <> "]"
                setstr = setstr + Mid(cond, q + 1, 1)
                q = q + 1
            WEND
            IF neg THEN
                atoms = APPEND(atoms, "-" + setstr)
            ELSE
                atoms = APPEND(atoms, "+" + setstr)
            END IF
            p = q + 1
        ELSE
            atoms = APPEND(atoms, "=" + c)
            p = p + 1
        END IF
    WEND
    RETURN atoms
END FUNCTION

FUNCTION matchAtom(atom AS STRING, ch AS STRING) AS BOOLEAN
    DIM t AS STRING = Left(atom, 1)
    IF t = "." THEN RETURN TRUE
    DIM rest AS STRING = Right(atom, LEN(atom) - 1)
    IF t = "=" THEN RETURN rest = ch
    IF t = "+" THEN RETURN strings.Contains(rest, ch)
    IF t = "-" THEN RETURN NOT strings.Contains(rest, ch)
    RETURN FALSE
END FUNCTION

' condMatch — does s satisfy the condition at its end (suffix) or start (prefix)?
FUNCTION condMatch(s AS STRING, cond AS STRING, atEnd AS BOOLEAN) AS BOOLEAN
    DIM atoms AS []STRING = parseCondAtoms(cond)
    DIM n AS INTEGER = LEN(atoms)
    IF n = 0 THEN RETURN TRUE
    IF LEN(s) < n THEN RETURN FALSE
    DIM bpos AS INTEGER = 0
    IF atEnd THEN bpos = LEN(s) - n
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF NOT matchAtom(atoms[i], Mid(s, bpos + i + 1, 1)) THEN RETURN FALSE
    NEXT i
    RETURN TRUE
END FUNCTION

' loadAffix — parse a hunspell .aff into gAffRules (flag -> rule lines).
SUB loadAffix(affPath AS STRING)
    DIM am AS MAP OF STRING TO STRING
    gAffRules = am
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(affPath)
    IF e <> NIL THEN RETURN
    DIM lines AS []STRING = strings.Split(Decode(data), Chr(10))
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        DIM f AS []STRING = strings.Fields(lines[i])
        IF LEN(f) >= 5 AND (f[0] = "SFX" OR f[0] = "PFX") THEN
            DIM flag AS STRING = f[1]
            DIM add AS STRING = f[3]
            DIM sl AS INTEGER = strings.Index(add, "/")
            IF sl >= 0 THEN add = Left(add, sl)
            DIM enc AS STRING = f[0] + "|" + f[2] + "|" + add + "|" + f[4]
            IF gAffRules[flag] = "" THEN
                gAffRules[flag] = enc
            ELSE
                gAffRules[flag] = gAffRules[flag] + Chr(10) + enc
            END IF
        END IF
    NEXT i
END SUB

' applyFlag — emit the words a single affix flag derives from stem.
SUB applyFlag(stem AS STRING, flag AS STRING)
    DIM rules AS STRING = gAffRules[flag]
    IF rules = "" THEN RETURN
    DIM rl AS []STRING = strings.Split(rules, Chr(10))
    DIM i AS INTEGER
    FOR i = 0 TO LEN(rl) - 1
        DIM parts AS []STRING = strings.Split(rl[i], "|")
        DIM typ AS STRING = parts[0]
        DIM strip AS STRING = parts[1]
        DIM add AS STRING = parts[2]
        DIM cond AS STRING = parts[3]
        IF typ = "SFX" THEN
            IF condMatch(stem, cond, TRUE) THEN
                DIM sb AS STRING = stem
                IF strip <> "0" AND strings.HasSuffix(stem, strip) THEN sb = Left(stem, LEN(stem) - LEN(strip))
                addWord(sb + add)
            END IF
        ELSE
            IF condMatch(stem, cond, FALSE) THEN
                DIM sb2 AS STRING = stem
                IF strip <> "0" AND strings.HasPrefix(stem, strip) THEN sb2 = Right(stem, LEN(stem) - LEN(strip))
                addWord(add + sb2)
            END IF
        END IF
    NEXT i
END SUB

' cacheDir — where downloaded dictionaries/thesauri are cached.
FUNCTION cacheDir() AS STRING
    DIM home AS STRING
    DIM e AS ERROR
    home, e = os.UserHomeDir()
    IF e <> NIL OR home = "" THEN RETURN ".starword-cache"
    RETURN home + "/.starword-cache"
END FUNCTION

' resolveDataPath — if p is an http(s) URL, download it once to the cache and
' return the local path (reused next time); otherwise return p unchanged. This
' lets a dictionary/thesaurus be hosted on a website and fetched on demand.
FUNCTION resolveDataPath(p AS STRING) AS STRING
    DIM lp AS STRING = LCase(p)
    IF NOT strings.HasPrefix(lp, "http://") AND NOT strings.HasPrefix(lp, "https://") THEN RETURN p
    DIM nm AS STRING = p
    DIM sl AS INTEGER = strings.LastIndex(nm, "/")
    IF sl >= 0 THEN nm = Right(nm, LEN(nm) - sl - 1)
    IF nm = "" THEN nm = "download.dat"
    DIM dir AS STRING = cacheDir()
    DIM target AS STRING = dir + "/" + nm
    DIM fi AS os.FileInfo
    DIM se AS ERROR
    fi, se = os.Stat(target)
    IF se = NIL THEN
        _ = fi
        RETURN target
    END IF
    DIM mkerr AS ERROR = os.MkdirAll(dir, 493)
    _ = mkerr
    DIM resp AS POINTER TO http.Response
    DIM ge AS ERROR
    resp, ge = http.Get(p)
    IF ge <> NIL THEN RETURN p
    DIM body AS BYTES
    DIM re AS ERROR
    body, re = io.ReadAll((^resp).Body)
    (^resp).Body.Close()
    IF re <> NIL THEN RETURN p
    DIM we AS ERROR = os.WriteFile(target, body, 420)
    IF we <> NIL THEN RETURN p
    RETURN target
END FUNCTION

' loadDictionary — read the word list + personal dictionary once (lazy).
' A flat list is one word per line; a hunspell .dic uses "stem/AFFIXFLAGS"
' with rules in the companion .aff (inflections are expanded).
SUB loadDictionary()
    IF gDictLoaded THEN RETURN
    gDictLoaded = TRUE
    ' Global maps aren't auto-initialized; seed from an (auto-init) local.
    DIM dnew AS MAP OF STRING TO BOOLEAN
    gDict = dnew
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(resolveDataPath(gDictPath))
    IF e = NIL THEN
        DIM isHunspell AS BOOLEAN = strings.HasSuffix(LCase(gDictPath), ".dic")
        IF isHunspell THEN loadAffix(resolveDataPath(Left(gDictPath, LEN(gDictPath) - 4) + ".aff"))
        DIM lines AS []STRING = strings.Split(Decode(data), Chr(10))
        DIM i AS INTEGER
        FOR i = 0 TO LEN(lines) - 1
            DIM raw AS STRING = strings.TrimSpace(lines[i])
            DIM isCount AS BOOLEAN = isHunspell AND i = 0 AND isAllDigits(raw)
            IF raw <> "" AND NOT isCount THEN
                DIM stem AS STRING = raw
                DIM flags AS STRING = ""
                DIM sl AS INTEGER = strings.Index(raw, "/")
                IF sl >= 0 THEN
                    stem = Left(raw, sl)
                    flags = Right(raw, LEN(raw) - sl - 1)
                END IF
                DIM tab AS INTEGER = strings.IndexAny(stem, Chr(9) + " ")
                IF tab >= 0 THEN stem = Left(stem, tab)
                addWord(stem)
                IF isHunspell AND flags <> "" THEN
                    DIM fi AS INTEGER = 0
                    WHILE fi < LEN(flags)
                        applyFlag(stem, Mid(flags, fi + 1, 1))
                        fi = fi + 1
                    WEND
                END IF
            END IF
        NEXT i
    END IF
    DIM pd AS BYTES
    DIM pe AS ERROR
    pd, pe = os.ReadFile(personalDictPath())
    IF pe = NIL THEN
        DIM plines AS []STRING = strings.Split(Decode(pd), Chr(10))
        DIM j AS INTEGER
        FOR j = 0 TO LEN(plines) - 1
            addWord(plines[j])
        NEXT j
    END IF
END SUB

' addToPersonalDict — accept a word and append it to ~/.starword.dict.
SUB addToPersonalDict(word AS STRING)
    DIM lw AS STRING = LCase(word)
    gDict[lw] = TRUE
    DIM existing AS STRING = ""
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(personalDictPath())
    IF e = NIL THEN existing = Decode(data)
    IF existing <> "" AND NOT strings.HasSuffix(existing, Chr(10)) THEN existing = existing + Chr(10)
    existing = existing + lw + Chr(10)
    DIM we AS ERROR = os.WriteFile(personalDictPath(), Encode(existing), 420)
    _ = we
END SUB

' isMisspelled — TRUE if word is alphabetic, ASCII, and not in the dictionary.
FUNCTION isMisspelled(word AS STRING) AS BOOLEAN
    IF word = "" THEN RETURN FALSE
    DIM i AS INTEGER = 0
    WHILE i < LEN(word)
        DIM a AS INTEGER = Asc(Mid(word, i + 1, 1))
        IF a >= 48 AND a <= 57 THEN RETURN FALSE
        IF a > 127 THEN RETURN FALSE
        i = i + 1
    WEND
    IF gDict[LCase(word)] THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' genSuggestions — dictionary words one edit away from `word` (up to 5).
FUNCTION genSuggestions(word AS STRING) AS []STRING
    DIM w AS STRING = LCase(word)
    DIM letters AS STRING = "abcdefghijklmnopqrstuvwxyz"
    DIM n AS INTEGER = LEN(w)
    DIM cands AS []STRING
    DIM i AS INTEGER
    DIM j AS INTEGER
    FOR i = 0 TO n - 1
        cands = APPEND(cands, Left(w, i) + Right(w, n - i - 1))
    NEXT i
    FOR i = 0 TO n - 2
        cands = APPEND(cands, Left(w, i) + Mid(w, i + 2, 1) + Mid(w, i + 1, 1) + Right(w, n - i - 2))
    NEXT i
    FOR i = 0 TO n - 1
        FOR j = 1 TO 26
            cands = APPEND(cands, Left(w, i) + Mid(letters, j, 1) + Right(w, n - i - 1))
        NEXT j
    NEXT i
    FOR i = 0 TO n
        FOR j = 1 TO 26
            cands = APPEND(cands, Left(w, i) + Mid(letters, j, 1) + Right(w, n - i))
        NEXT j
    NEXT i
    DIM out AS []STRING
    DIM seen AS MAP OF STRING TO BOOLEAN
    DIM k AS INTEGER
    FOR k = 0 TO LEN(cands) - 1
        DIM c AS STRING = cands[k]
        IF c <> "" AND c <> w AND gDict[c] AND NOT seen[c] THEN
            seen[c] = TRUE
            out = APPEND(out, c)
            IF LEN(out) >= 5 THEN RETURN out
        END IF
    NEXT k
    RETURN out
END FUNCTION

' nextMisspelled — first misspelled word at/after (r,c). Returns found + bounds.
FUNCTION nextMisspelled(r AS INTEGER, c AS INTEGER) AS (BOOLEAN, INTEGER, INTEGER, INTEGER)
    DIM rr AS INTEGER = r
    DIM cc AS INTEGER = c
    WHILE rr <= lastRow()
        DIM ln AS STRING = gLines[rr]
        IF Left(ln, 1) = "." THEN
            rr = rr + 1
            cc = 0
        ELSE
            DIM p AS INTEGER = cc
            WHILE p < LEN(ln) AND NOT isWordCh(runeAt(ln, p))
                p = nextRuneStart(ln, p)
            WEND
            IF p >= LEN(ln) THEN
                rr = rr + 1
                cc = 0
            ELSE
                DIM ws AS INTEGER = p
                WHILE p < LEN(ln) AND isWordCh(runeAt(ln, p))
                    p = nextRuneStart(ln, p)
                WEND
                DIM word AS STRING = Mid(ln, ws + 1, p - ws)
                IF isMisspelled(word) THEN RETURN TRUE, rr, ws, p
                cc = p
            END IF
        END IF
    WEND
    RETURN FALSE, 0, 0, 0
END FUNCTION

' spellFrom — flag the next misspelled word from (r,c) and open the prompt.
SUB spellFrom(r AS INTEGER, c AS INTEGER)
    DIM found AS BOOLEAN
    DIM wr AS INTEGER
    DIM ws AS INTEGER
    DIM we AS INTEGER
    found, wr, ws, we = nextMisspelled(r, c)
    IF NOT found THEN
        gPromptMode = ""
        gMessage = "Spell check complete"
        RETURN
    END IF
    gRow = wr
    gCol = ws
    gSpellEnd = we
    gSpellWord = Mid(gLines[wr], ws + 1, we - ws)
    gSpellSugg = genSuggestions(gSpellWord)
    DIM lbl AS STRING = "Misspelled '" + gSpellWord + "'  "
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gSpellSugg) - 1
        lbl = lbl + fmt.Sprintf("%d)", i + 1) + gSpellSugg[i] + " "
    NEXT i
    lbl = lbl + " I)gnore A)dd R)eplace Esc"
    gPromptMode = "spell"
    gPromptLabel = lbl
    gPromptText = ""
END SUB

' startSpell — Utilities > Spell Check / ^QN: check from the cursor onward.
SUB startSpell()
    loadDictionary()
    IF gDictCount = 0 THEN
        gMessage = "No dictionary found (set 'dictionary' in the config)"
        RETURN
    END IF
    spellFrom(gRow, gCol)
END SUB

' checkWordAtCursor — ^QL: spell-check just the word under the cursor.
SUB checkWordAtCursor()
    loadDictionary()
    DIM ln AS STRING = curLine()
    DIM s AS INTEGER = gCol
    WHILE s > 0 AND isWordCh(runeAt(ln, prevRuneStart(ln, s)))
        s = prevRuneStart(ln, s)
    WEND
    DIM e2 AS INTEGER = gCol
    WHILE e2 < LEN(ln) AND isWordCh(runeAt(ln, e2))
        e2 = nextRuneStart(ln, e2)
    WEND
    IF s >= e2 THEN
        gMessage = "No word at cursor"
        RETURN
    END IF
    DIM word AS STRING = Mid(ln, s + 1, e2 - s)
    IF isMisspelled(word) THEN
        DIM sug AS []STRING = genSuggestions(word)
        IF LEN(sug) > 0 THEN
            gMessage = "Misspelled '" + word + "' — try: " + strings.Join(sug, ", ")
        ELSE
            gMessage = "Misspelled '" + word + "' (no suggestions)"
        END IF
    ELSE
        gMessage = "'" + word + "' is correct"
    END IF
END SUB

' handleSpellKey — keystrokes while a misspelled word is flagged.
SUB handleSpellKey(key AS STRING)
    IF key = "esc" THEN
        gPromptMode = ""
        gMessage = "Spell check stopped"
        RETURN
    END IF
    DIM k AS STRING = LCase(key)
    IF k = "i" THEN
        DIM af AS INTEGER = gSpellEnd
        gPromptMode = ""
        spellFrom(gRow, af)
        RETURN
    END IF
    IF k = "a" THEN
        addToPersonalDict(gSpellWord)
        DIM af2 AS INTEGER = gSpellEnd
        gPromptMode = ""
        spellFrom(gRow, af2)
        RETURN
    END IF
    IF k = "r" THEN
        gPromptMode = "spellrepl"
        gPromptLabel = "Replace '" + gSpellWord + "' with: "
        gPromptText = ""
        RETURN
    END IF
    DIM d AS INTEGER = digitOf(k)
    IF d >= 1 AND d <= LEN(gSpellSugg) THEN replaceSpellWord(gSpellSugg[d - 1])
END SUB

' replaceSpellWord — swap the flagged word for repl, then resume the check.
SUB replaceSpellWord(repl AS STRING)
    DIM ln AS STRING = gLines[gRow]
    gLines[gRow] = Left(ln, gCol) + repl + Right(ln, LEN(ln) - gSpellEnd)
    gModified = TRUE
    DIM ne AS INTEGER = gCol + LEN(repl)
    gPromptMode = ""
    spellFrom(gRow, ne)
END SUB

' initThesaurus — a small built-in synonym table (a starter set).
SUB initThesaurus()
    IF gThesInit THEN RETURN
    gThesInit = TRUE
    DIM tnew AS MAP OF STRING TO STRING
    gThes = tnew
    gThes["good"] = "fine,excellent,great,superb,worthy"
    gThes["bad"] = "poor,inferior,awful,terrible,deficient"
    gThes["big"] = "large,huge,enormous,vast,great"
    gThes["small"] = "little,tiny,compact,minor,slight"
    gThes["happy"] = "glad,joyful,content,cheerful,pleased"
    gThes["sad"] = "unhappy,sorrowful,gloomy,downcast"
    gThes["fast"] = "quick,rapid,swift,speedy,brisk"
    gThes["slow"] = "sluggish,gradual,leisurely,unhurried"
    gThes["important"] = "significant,crucial,vital,key,major"
    gThes["want"] = "desire,wish,crave,need,covet"
    gThes["make"] = "create,build,produce,form,construct"
    gThes["show"] = "display,reveal,present,exhibit,demonstrate"
    gThes["use"] = "employ,utilize,apply,operate"
    gThes["get"] = "obtain,acquire,receive,gain,fetch"
    gThes["say"] = "state,declare,utter,mention,remark"
    gThes["think"] = "believe,consider,reckon,ponder,suppose"
    gThes["help"] = "aid,assist,support,abet"
    gThes["start"] = "begin,commence,initiate,launch"
    gThes["end"] = "finish,conclude,terminate,cease,close"
    gThes["change"] = "alter,modify,vary,adjust,transform"
    gThes["new"] = "fresh,recent,modern,novel,current"
    gThes["old"] = "aged,ancient,former,outdated,elderly"
    gThes["easy"] = "simple,effortless,straightforward,plain"
    gThes["hard"] = "difficult,tough,arduous,demanding"
    gThes["nice"] = "pleasant,agreeable,kind,lovely,delightful"
END SUB

' loadThesaurus — load a MyThes .dat thesaurus into gThes, or fall back to the
' built-in table. MyThes format: an encoding line, then for each headword a
' "word|N" line followed by N sense lines "(pos)|synonym|synonym|...".
SUB loadThesaurus()
    IF gThesLoaded THEN RETURN
    gThesLoaded = TRUE
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(resolveDataPath(gThesPath))
    IF e <> NIL THEN
        initThesaurus()
        RETURN
    END IF
    DIM tm AS MAP OF STRING TO STRING
    gThes = tm
    DIM lines AS []STRING = strings.Split(Decode(data), Chr(10))
    DIM i AS INTEGER = 1
    WHILE i < LEN(lines)
        DIM hdr AS []STRING = strings.Split(lines[i], "|")
        IF LEN(hdr) >= 2 AND isAllDigits(strings.TrimSpace(hdr[1])) THEN
            DIM word AS STRING = LCase(strings.TrimSpace(hdr[0]))
            DIM n AS INTEGER = Int(Val(hdr[1]))
            DIM syns AS STRING = ""
            DIM s AS INTEGER
            FOR s = 1 TO n
                IF i + s < LEN(lines) THEN
                    DIM sp AS []STRING = strings.Split(lines[i + s], "|")
                    DIM k AS INTEGER
                    FOR k = 1 TO LEN(sp) - 1
                        DIM syn AS STRING = strings.TrimSpace(sp[k])
                        IF syn <> "" AND Left(syn, 1) <> "(" THEN
                            IF syns = "" THEN
                                syns = syn
                            ELSE
                                syns = syns + "," + syn
                            END IF
                        END IF
                    NEXT k
                END IF
            NEXT s
            IF word <> "" AND syns <> "" THEN gThes[word] = syns
            i = i + n + 1
        ELSE
            i = i + 1
        END IF
    WEND
END SUB

' startThesaurus — Utilities > Thesaurus: synonyms for the word at the cursor.
SUB startThesaurus()
    loadThesaurus()
    DIM ln AS STRING = curLine()
    DIM s AS INTEGER = gCol
    WHILE s > 0 AND isWordCh(runeAt(ln, prevRuneStart(ln, s)))
        s = prevRuneStart(ln, s)
    WEND
    DIM e2 AS INTEGER = gCol
    WHILE e2 < LEN(ln) AND isWordCh(runeAt(ln, e2))
        e2 = nextRuneStart(ln, e2)
    WEND
    IF s >= e2 THEN
        gMessage = "No word at cursor"
        RETURN
    END IF
    DIM word AS STRING = Mid(ln, s + 1, e2 - s)
    DIM syn AS STRING = gThes[LCase(word)]
    IF syn = "" THEN
        gMessage = "No thesaurus entry for '" + word + "'"
        RETURN
    END IF
    gThesWord = word
    gThesStart = s
    gThesEnd = e2
    gThesSyn = strings.Split(syn, ",")
    DIM lbl AS STRING = "Synonyms for '" + word + "': "
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gThesSyn) - 1
        lbl = lbl + fmt.Sprintf("%d)", i + 1) + gThesSyn[i] + " "
    NEXT i
    lbl = lbl + " (#=replace, Esc)"
    gPromptMode = "thes"
    gPromptLabel = lbl
    gPromptText = ""
END SUB

' handleThesKey — pick a synonym (digit) to replace the word, or Esc.
SUB handleThesKey(key AS STRING)
    IF key = "esc" THEN
        gPromptMode = ""
        gMessage = ""
        RETURN
    END IF
    DIM d AS INTEGER = digitOf(LCase(key))
    IF d >= 1 AND d <= LEN(gThesSyn) THEN
        DIM repl AS STRING = gThesSyn[d - 1]
        DIM ln AS STRING = gLines[gRow]
        gLines[gRow] = Left(ln, gThesStart) + repl + Right(ln, LEN(ln) - gThesEnd)
        gCol = gThesStart + LEN(repl)
        gModified = TRUE
        gPromptMode = ""
        gMessage = "Replaced with '" + repl + "'"
    END IF
END SUB

' --- place markers + go-to (navigation) -----------------------------------

' digitOf — the 0..9 value of a single-character key, or -1.
FUNCTION digitOf(k AS STRING) AS INTEGER
    IF LEN(k) <> 1 THEN RETURN 0 - 1
    DIM a AS INTEGER = Asc(k)
    IF a >= 48 AND a <= 57 THEN RETURN a - 48
    RETURN 0 - 1
END FUNCTION

' setPlaceMarker — ^K0..^K9: remember the cursor as marker n.
SUB setPlaceMarker(n AS INTEGER)
    gMarkRow[n] = gRow
    gMarkCol[n] = gCol
    gMessage = fmt.Sprintf("Place marker %d set", n)
END SUB

' gotoPlaceMarker — ^Q0..^Q9: jump to marker n.
SUB gotoPlaceMarker(n AS INTEGER)
    IF gMarkRow[n] < 0 THEN
        gMessage = fmt.Sprintf("Marker %d not set", n)
        RETURN
    END IF
    gRow = gMarkRow[n]
    gCol = gMarkCol[n]
    clampCursor()
    gMessage = fmt.Sprintf("Jumped to marker %d", n)
END SUB

' gotoLine — move the cursor to 1-based line number ln (clamped).
SUB gotoLine(ln AS INTEGER)
    gRow = ln - 1
    IF gRow < 0 THEN gRow = 0
    IF gRow > lastRow() THEN gRow = lastRow()
    gCol = 0
    gMessage = fmt.Sprintf("Line %d", gRow + 1)
END SUB

' gotoPage — move to the first line of 1-based page p (uses paginate()).
SUB gotoPage(p AS INTEGER)
    DIM starts AS []INTEGER = paginate()
    IF p < 1 THEN p = 1
    IF p > LEN(starts) THEN p = LEN(starts)
    gRow = starts[p - 1]
    gCol = 0
    IF gRow > lastRow() THEN gRow = lastRow()
    gMessage = fmt.Sprintf("Page %d of %d", p, LEN(starts))
END SUB

' doGoto — handle the ^QI prompt text: a bare number is a line; "P<n>" a page.
SUB doGoto(txt AS STRING)
    DIM t AS STRING = strings.TrimSpace(txt)
    IF t = "" THEN RETURN
    IF LCase(Left(t, 1)) = "p" THEN
        gotoPage(Int(Val(strings.TrimSpace(Mid(t, 2, LEN(t) - 1)))))
    ELSE
        gotoLine(Int(Val(t)))
    END IF
END SUB

' doMenuItem — perform the action for (menuIdx, hotkey). Unimplemented WordStar
' features report a friendly message; the rest drive StarWord's real commands.
SUB doMenuItem(menuIdx AS INTEGER, hk AS STRING)
    DIM label AS STRING = ""
    DIM items AS []STRING = menuItems(menuIdx)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(items) - 1
        IF itemField(items[k], 0) = hk THEN label = itemField(items[k], 1)
    NEXT k
    gMenuOpen = 0 - 1
    IF menuIdx = 0 THEN
        IF hk = "S" THEN
            saveFile()
        ELSEIF hk = "A" THEN
            gPromptMode = "saveas"
            gPromptLabel = "Save as: "
            gPromptText = ""
        ELSEIF hk = "O" THEN
            gPromptMode = "open"
            gPromptLabel = "Open file: "
            gPromptText = ""
        ELSEIF hk = "X" THEN
            saveFile()
            RequestQuit()
        ELSEIF hk = "P" THEN
            doPrint()
        ELSEIF hk = "V" THEN
            gPromptMode = "chdir"
            gPromptLabel = "Change to directory: "
            gPromptText = ""
        ELSEIF hk = "R" THEN
            gPromptMode = "rundos"
            gPromptLabel = "Run command: "
            gPromptText = ""
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 1 THEN
        IF hk = "U" THEN
            doUndo()
        ELSEIF hk = "Y" THEN
            doRedo()
        ELSEIF hk = "B" THEN
            gBBRow = gRow
            gBBCol = gCol
            gBlockShow = TRUE
            gMessage = "Block begin marked"
        ELSEIF hk = "E" THEN
            gBERow = gRow
            gBECol = gCol
            gBlockShow = TRUE
            gMessage = "Block end marked"
        ELSEIF hk = "V" THEN
            blockMoveTo(gRow, gCol)
        ELSEIF hk = "C" THEN
            blockCopyTo(gRow, gCol)
        ELSEIF hk = "D" THEN
            blockDelete()
        ELSEIF hk = "F" THEN
            gPromptMode = "find"
            gPromptLabel = "Find: "
            gPromptText = ""
        ELSEIF hk = "R" THEN
            gPromptMode = "rfind"
            gPromptLabel = "Replace - find: "
            gPromptText = ""
        ELSEIF hk = "N" THEN
            doFindNext()
        ELSEIF hk = "O" THEN
            gColumnMode = NOT gColumnMode
            IF gColumnMode THEN
                gMessage = "Column (rectangular) block mode ON"
            ELSE
                gMessage = "Column block mode OFF (stream)"
            END IF
        ELSEIF hk = "M" THEN
            blockMath()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 2 THEN      ' VIEW
        IF hk = "B" THEN
            gBlockShow = NOT gBlockShow
            gMessage = "Block highlighting toggled"
        ELSEIF hk = "C" THEN
            gShowTags = NOT gShowTags
            gMessage = "Command tags display toggled"
        ELSEIF hk = "P" THEN
            gMode = "preview"
            gPrevTop = 0
            gMessage = ""
        ELSEIF hk = "S" THEN
            gShowRuler = NOT gShowRuler
            IF gShowRuler THEN
                gMessage = "Ruler shown"
            ELSE
                gMessage = "Ruler hidden"
            END IF
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 3 THEN      ' INSERT
        IF hk = "P" THEN
            insertPageBreak()
        ELSEIF hk = "T" THEN
            insertTodaysDate()
        ELSEIF hk = "F" THEN
            gPromptMode = "insfile"
            gPromptLabel = "Insert file: "
            gPromptText = ""
        ELSEIF hk = "N" THEN
            gPromptMode = "insfn"
            gPromptLabel = "Footnote text: "
            gPromptText = ""
        ELSEIF hk = "X" THEN
            gPromptMode = "insix"
            gPromptLabel = "Index entry: "
            gPromptText = ""
        ELSEIF hk = "C" THEN
            gPromptMode = "instc"
            gPromptLabel = "Contents entry: "
            gPromptText = ""
        ELSEIF hk = "I" THEN
            insertDotLine(".index", "Index will be generated here on print/preview")
        ELSEIF hk = "G" THEN
            insertDotLine(".toc", "Contents will be generated here on print/preview")
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 4 THEN      ' STYLE
        IF hk = "B" THEN
            insertMarker(2)
            gMessage = "Bold toggle inserted (^B)"
        ELSEIF hk = "I" THEN
            insertMarker(25)
            gMessage = "Italic toggle inserted (^Y)"
        ELSEIF hk = "U" THEN
            insertMarker(19)
            gMessage = "Underline toggle inserted (^S)"
        ELSEIF hk = "C" THEN
            convertCaseWord()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 5 THEN      ' LAYOUT
        IF hk = "C" THEN
            centerLine()
        ELSEIF hk = "R" THEN
            gShowTags = NOT gShowTags
            gMessage = "Ruler/command tags toggled"
        ELSEIF hk = "P" THEN
            gPromptMode = "pagelen"
            gPromptLabel = "Page length (lines): "
            gPromptText = ""
        ELSEIF hk = "S" THEN
            gPromptMode = "linespacing"
            gPromptLabel = "Line spacing (1=single, 2=double): "
            gPromptText = ""
        ELSEIF hk = "F" THEN
            doPrint()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 6 THEN      ' UTILITIES
        IF hk = "W" THEN
            wordCount()
        ELSEIF hk = "S" THEN
            startSpell()
        ELSEIF hk = "T" THEN
            startThesaurus()
        ELSEIF hk = "G" THEN
            doMailMerge()
        ELSEIF hk = "C" THEN
            openCalculator()
        ELSEIF hk = "M" THEN
            macroToggle()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSEIF menuIdx = 7 THEN
        IF hk = "H" THEN
            gPrefix = "J"
        ELSEIF hk = "C" THEN
            cycleHelpLevel()
        ELSE
            gMessage = label + " — coming in a later StarWord build"
        END IF
    ELSE
        gMessage = label + " — coming in a later StarWord build"
    END IF
END SUB

' wordCount — count words / lines / characters (runes) in the document.
SUB wordCount()
    DIM words AS INTEGER = 0
    DIM chars AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        words = words + LEN(strings.Fields(gLines[i]))
        chars = chars + runeIndexOf(gLines[i], LEN(gLines[i]))
    NEXT i
    gMessage = fmt.Sprintf("Words: %d    Lines: %d    Characters: %d", words, LEN(gLines), chars)
END SUB

' ==========================================================================
' Opening Menu (WordStar's classic opening screen) + file management
' ==========================================================================

FUNCTION joinPath(d AS STRING, n AS STRING) AS STRING
    IF d = "." OR d = "" THEN RETURN n
    RETURN d + "/" + n
END FUNCTION

FUNCTION parentDir(p AS STRING) AS STRING
    IF p = "." OR p = "" THEN RETURN ".."
    DIM i AS INTEGER = strings.LastIndex(p, "/")
    IF i < 0 THEN RETURN "."
    IF i = 0 THEN RETURN "/"
    RETURN Left(p, i)
END FUNCTION

' refreshFileList — read gOpenDir into gOpenFiles ("..", dirs/, then files).
SUB refreshFileList()
    gOpenFiles = nil
    gOpenFiles = APPEND(gOpenFiles, "..")
    DIM entries AS []os.DirEntry
    DIM e AS ERROR
    entries, e = os.ReadDir(gOpenDir)
    IF e <> NIL THEN
        gMessage = "Cannot read " + gOpenDir
        gOpenSel = 0
        gOpenTop = 0
        RETURN
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(entries) - 1
        IF entries[i].IsDir() THEN gOpenFiles = APPEND(gOpenFiles, entries[i].Name() + "/")
    NEXT i
    FOR i = 0 TO LEN(entries) - 1
        IF NOT entries[i].IsDir() THEN gOpenFiles = APPEND(gOpenFiles, entries[i].Name())
    NEXT i
    gOpenSel = 0
    gOpenTop = 0
END SUB

SUB enterOpeningMenu()
    gMode = "open"
    refreshFileList()
    gMessage = ""
END SUB

SUB newDoc()
    gLines = nil
    gLines = APPEND(gLines, "")
    gFileName = "untitled.WSu"
    gIsUnicode = gDefaultUnicode
    gRow = 0
    gCol = 0
    gTop = 0
    gLeft = 0
    gModified = FALSE
    gMode = "edit"
    gMessage = "New document"
    syncUndoBaseline()
END SUB

' openSelected — act on the highlighted Opening-Menu entry: ".." goes up, a
' "dir/" descends, a file opens into the editor.
SUB openSelected()
    IF LEN(gOpenFiles) = 0 THEN RETURN
    DIM nm AS STRING = gOpenFiles[gOpenSel]
    IF nm = ".." THEN
        gOpenDir = parentDir(gOpenDir)
        refreshFileList()
        RETURN
    END IF
    IF strings.HasSuffix(nm, "/") THEN
        gOpenDir = joinPath(gOpenDir, Left(nm, LEN(nm) - 1))
        refreshFileList()
        RETURN
    END IF
    loadFile(joinPath(gOpenDir, nm))
    gMode = "edit"
END SUB

' renderOpeningMenu — the full Opening Menu screen.
FUNCTION renderOpeningMenu(w AS INTEGER, h AS INTEGER) AS STRING
    DIM bg AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#0f2350"))
    DIM hdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#3b6fe0")).Bold(TRUE)
    DIM key AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#0f2350")).Bold(TRUE)
    DIM dimSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#8aa0d8")).Background(lipgloss.Color("#0f2350"))
    DIM selSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#8ad0ff")).Bold(TRUE)
    DIM dirSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#9ece6a")).Background(lipgloss.Color("#0f2350"))

    DIM rows AS []STRING
    rows = APPEND(rows, hdr.Render(swFit(" StarWord  -  Opening Menu", w)))
    rows = APPEND(rows, bg.Render(swFit("", w)))
    rows = APPEND(rows, bg.Render("  ") + key.Render("D ") + bg.Render("Open document   ") + key.Render("N ") + bg.Render("New document   ") + key.Render("L ") + bg.Render("Change dir   ") + key.Render("C ") + bg.Render("Configure   ") + key.Render("X ") + bg.Render(swFit("Exit", w - 68)))
    rows = APPEND(rows, dimSt.Render(swFit("  Up/Down select   Enter open   E rename  O copy  Y delete   Esc back to editor", w)))
    rows = APPEND(rows, bg.Render(swFit("", w)))
    rows = APPEND(rows, bg.Render("  Directory: ") + dirSt.Render(swFit(gOpenDir, w - 13)))
    DIM sepW AS INTEGER = w - 4
    IF sepW < 0 THEN sepW = 0
    rows = APPEND(rows, dimSt.Render("  " + strings.Repeat("-", sepW) + "  "))

    ' File list region: rows 7 .. h-2.
    DIM listTop AS INTEGER = 7
    DIM listRows AS INTEGER = h - 1 - listTop
    IF listRows < 1 THEN listRows = 1
    IF gOpenSel < gOpenTop THEN gOpenTop = gOpenSel
    IF gOpenSel >= gOpenTop + listRows THEN gOpenTop = gOpenSel - listRows + 1
    IF gOpenTop < 0 THEN gOpenTop = 0
    DIM r AS INTEGER
    FOR r = 0 TO listRows - 1
        DIM fi AS INTEGER = gOpenTop + r
        IF fi < LEN(gOpenFiles) THEN
            DIM nm AS STRING = gOpenFiles[fi]
            DIM isDir AS BOOLEAN = (nm = "..") OR strings.HasSuffix(nm, "/")
            DIM lineTxt AS STRING = "   " + nm
            IF fi = gOpenSel THEN
                rows = APPEND(rows, selSt.Render(swFit(" > " + nm, w)))
            ELSEIF isDir THEN
                rows = APPEND(rows, dirSt.Render(swFit(lineTxt, w)))
            ELSE
                rows = APPEND(rows, bg.Render(swFit(lineTxt, w)))
            END IF
        ELSE
            rows = APPEND(rows, bg.Render(swFit("", w)))
        END IF
    NEXT r

    ' Footer / modal prompt.
    DIM foot AS STRING = "  " + fmt.Sprintf("%d", LEN(gOpenFiles)) + " entries   ^KD from the editor returns here"
    IF gPromptMode <> "" THEN foot = " " + gPromptLabel + gPromptText + Chr(9617)
    rows = APPEND(rows, hdr.Render(swFit(foot, w)))
    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' handleOpenKey — keyboard for the Opening Menu.
SUB handleOpenKey(key AS STRING)
    DIM n AS INTEGER = LEN(gOpenFiles)
    IF key = "up" THEN
        IF n > 0 THEN gOpenSel = (gOpenSel - 1 + n) MOD n
        RETURN
    END IF
    IF key = "down" THEN
        IF n > 0 THEN gOpenSel = (gOpenSel + 1) MOD n
        RETURN
    END IF
    IF key = "pgup" THEN
        gOpenSel = gOpenSel - 10
        IF gOpenSel < 0 THEN gOpenSel = 0
        RETURN
    END IF
    IF key = "pgdown" THEN
        gOpenSel = gOpenSel + 10
        IF gOpenSel > n - 1 THEN gOpenSel = n - 1
        RETURN
    END IF
    IF key = "enter" THEN
        openSelected()
        RETURN
    END IF
    IF key = "esc" THEN
        gMode = "edit"
        RETURN
    END IF
    DIM lk AS STRING = LCase(key)
    IF lk = "d" THEN
        gPromptMode = "open"
        gPromptLabel = "Open file: "
        gPromptText = ""
    ELSEIF lk = "n" THEN
        newDoc()
    ELSEIF lk = "l" THEN
        gPromptMode = "opendir"
        gPromptLabel = "Directory: "
        gPromptText = ""
    ELSEIF lk = "c" THEN
        enterConfig()
    ELSEIF lk = "e" THEN
        startFileOp("renameto", "Rename to: ")
    ELSEIF lk = "o" THEN
        startFileOp("copyto", "Copy to: ")
    ELSEIF lk = "y" THEN
        IF validFileTarget() THEN
            gOpFile = gOpenFiles[gOpenSel]
            gPromptMode = "deleteconfirm"
            gPromptLabel = "Delete '" + gOpFile + "'? (Y/N): "
            gPromptText = ""
        ELSE
            gMessage = "Select a file first"
        END IF
    ELSEIF lk = "x" THEN
        RequestQuit()
    END IF
END SUB

' validFileTarget — the highlighted Opening-Menu entry is a real file (not ".."
' or a directory)?
FUNCTION validFileTarget() AS BOOLEAN
    IF gOpenSel < 0 OR gOpenSel >= LEN(gOpenFiles) THEN RETURN FALSE
    DIM nm AS STRING = gOpenFiles[gOpenSel]
    IF nm = ".." THEN RETURN FALSE
    IF strings.HasSuffix(nm, "/") THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' startFileOp — begin a rename/copy of the highlighted file (prompts for name).
SUB startFileOp(mode AS STRING, lbl AS STRING)
    IF NOT validFileTarget() THEN
        gMessage = "Select a file first"
        RETURN
    END IF
    gOpFile = gOpenFiles[gOpenSel]
    gPromptMode = mode
    gPromptLabel = lbl
    gPromptText = ""
END SUB

' doRenameFile / doCopyFile / doDeleteFile — Opening-Menu file management.
SUB doRenameFile(newName AS STRING)
    IF newName = "" THEN RETURN
    DIM e AS ERROR = os.Rename(joinPath(gOpenDir, gOpFile), joinPath(gOpenDir, newName))
    IF e <> NIL THEN
        gMessage = "Rename failed: " + e.Error()
    ELSE
        gMessage = "Renamed to " + newName
    END IF
    refreshFileList()
END SUB

SUB doCopyFile(newName AS STRING)
    IF newName = "" THEN RETURN
    DIM data AS BYTES
    DIM e AS ERROR
    data, e = os.ReadFile(joinPath(gOpenDir, gOpFile))
    IF e <> NIL THEN
        gMessage = "Copy failed: " + e.Error()
        RETURN
    END IF
    DIM we AS ERROR = os.WriteFile(joinPath(gOpenDir, newName), data, 420)
    IF we <> NIL THEN
        gMessage = "Copy failed: " + we.Error()
    ELSE
        gMessage = "Copied to " + newName
    END IF
    refreshFileList()
END SUB

SUB doDeleteFile()
    DIM e AS ERROR = os.Remove(joinPath(gOpenDir, gOpFile))
    IF e <> NIL THEN
        gMessage = "Delete failed: " + e.Error()
    ELSE
        gMessage = "Deleted " + gOpFile
    END IF
    refreshFileList()
END SUB

FUNCTION sw_Render(w AS INTEGER, h AS INTEGER) AS STRING
    gW = w
    gH = h
    IF gMode = "open" THEN RETURN renderOpeningMenu(w, h)
    IF gMode = "preview" THEN RETURN renderPreview(w, h)
    IF gMode = "config" THEN RETURN renderConfig(w, h)
    clampCursor()
    ' Non-document mode treats dot commands as literal text (no margin reflow).
    IF NOT gNonDocument THEN applyDotCommands()

    ' Layout: menubar=0, status=1, ruler=2, text=3..h-2, message=h-1.
    DIM txTop AS INTEGER = 3
    DIM txRows AS INTEGER = h - 4
    IF txRows < 1 THEN txRows = 1

    ' Keep the cursor on screen. Soft wrap scrolls by visual row (no
    ' horizontal scroll); hard/off mode scrolls by logical line + column.
    IF softWrapOn() THEN
        gLeft = 0
    ELSE
        IF gRow < gTop THEN gTop = gRow
        IF gRow >= gTop + txRows THEN gTop = gRow - txRows + 1
        IF gCol < gLeft THEN gLeft = gCol
        IF gCol >= gLeft + w THEN gLeft = gCol - w + 1
        IF gTop < 0 THEN gTop = 0
        IF gLeft < 0 THEN gLeft = 0
        gLeft = snapToRune(curLine(), gLeft)
    END IF

    ' Palette — modernized WordStar blue.
    DIM stStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#3b6fe0")).Bold(TRUE)
    DIM ruStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#a9c4ff")).Background(lipgloss.Color("#16306a"))
    DIM ruMark AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#16306a")).Bold(TRUE)
    DIM txStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#0f2350"))
    DIM curStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#0f2350")).Background(lipgloss.Color("#8ad0ff")).Bold(TRUE)
    DIM blkStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffffff")).Background(lipgloss.Color("#2f5bb0"))
    DIM msgStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#a9c0ee")).Background(lipgloss.Color("#0a1838"))
    DIM panStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#dbe6ff")).Background(lipgloss.Color("#14336e"))
    DIM panLbl AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#ffd166")).Background(lipgloss.Color("#14336e")).Bold(TRUE)

    DIM rows AS []STRING

    ' --- row 0: pull-down menu bar ---
    rows = APPEND(rows, renderMenuBar(w))

    ' --- row 1: status line ---
    DIM modeStr AS STRING = "OVERTYPE"
    IF gInsert THEN modeStr = "INSERT"
    DIM encStr AS STRING = "WS/ASCII"
    IF gIsUnicode THEN encStr = "UTF-8"
    DIM modFlag AS STRING = " "
    IF gModified THEN modFlag = "*"
    DIM colNum AS INTEGER = runeIndexOf(curLine(), gCol) + 1
    DIM docFlag AS STRING = ""
    IF gNonDocument THEN docFlag = "    NON-DOCUMENT"
    IF gColumnMode THEN docFlag = docFlag + "    COLUMN"
    DIM status AS STRING = " StarWord   " + modFlag + gFileName + "    Line " + fmt.Sprintf("%d", gRow + 1) + "  Col " + fmt.Sprintf("%d", colNum) + "    " + modeStr + "    " + encStr + docFlag
    DIM statusFit AS STRING = swFit(status, w)
    rows = APPEND(rows, stStyle.Render(statusFit))

    ' --- row 1: ruler line ---
    DIM ruler AS STRING = ""
    DIM rx AS INTEGER
    FOR rx = 0 TO w - 1
        DIM dc AS INTEGER = gLeft + rx
        DIM rc AS STRING = "-"
        IF dc = gLeftMargin THEN
            rc = "L"
        ELSEIF dc = gRightMargin THEN
            rc = "R"
        ELSEIF isTabStop(dc) THEN
            rc = "T"
        ELSEIF dc MOD 5 = 0 THEN
            rc = "!"
        END IF
        ruler = ruler + rc
    NEXT rx
    ' View > Screen Settings can hide the ruler (the row stays, for layout).
    IF NOT gShowRuler THEN ruler = strings.Repeat(" ", w)
    rows = APPEND(rows, ruStyle.Render(ruler))
    _ = ruMark

    ' --- rows 2..h-2: text area ---
    DIM sy AS INTEGER
    IF softWrapOn() THEN
        ' Build the visual-row table and scroll it to keep the cursor visible.
        buildVisRows(wrapWidth())
        DIM cvr AS INTEGER = cursorVisRow()
        IF cvr < gTopVis THEN gTopVis = cvr
        IF cvr >= gTopVis + txRows THEN gTopVis = cvr - txRows + 1
        IF gTopVis < 0 THEN gTopVis = 0
        FOR sy = 0 TO txRows - 1
            DIM vr AS INTEGER = gTopVis + sy
            IF vr < LEN(gVisLine) THEN
                rows = APPEND(rows, renderSegment(gVisLine[vr], gVisStart[vr], gVisEnd[vr], 0, w, txStyle, curStyle, blkStyle))
            ELSE
                rows = APPEND(rows, txStyle.Render(strings.Repeat(" ", w)))
            END IF
        NEXT sy
    ELSE
        FOR sy = 0 TO txRows - 1
            rows = APPEND(rows, renderTextRow(gTop + sy, w, txStyle, curStyle, blkStyle))
        NEXT sy
    END IF

    ' --- row h-1: message / modal prompt line ---
    DIM msg AS STRING
    IF gPromptMode <> "" THEN
        msg = " " + gPromptLabel + gPromptText + Chr(9617)
    ELSEIF gMessage <> "" THEN
        msg = " " + gMessage
    ELSE
        msg = " ^J Help   ^K Block/Save   ^Q Quick   ^KS Save   ^KX Save+Exit   ^KQ Abandon"
    END IF
    rows = APPEND(rows, msgStyle.Render(swFit(msg, w)))

    ' --- pop-up prefix menu: overwrite the top text rows (WordStar-style) ---
    IF gPrefix <> "" THEN
        DIM menu AS []STRING = prefixMenuLines()
        DIM mi AS INTEGER
        FOR mi = 0 TO LEN(menu) - 1
            DIM rr AS INTEGER = txTop + mi
            IF rr <= h - 2 THEN
                ' Split the leading label (up to 2 spaces) from the rest so the
                ' label can be tinted amber.
                DIM full AS STRING = menu[mi]
                DIM cut AS INTEGER = strings.Index(full, "  ")
                IF cut > 0 THEN
                    rows[rr] = panLbl.Render(Left(full, cut)) + panStyle.Render(swFit(Right(full, LEN(full) - cut), w - cut))
                ELSE
                    rows[rr] = panStyle.Render(swFit(full, w))
                END IF
            END IF
        NEXT mi
    END IF

    ' --- open pull-down: splice its box over rows 1.. under the menu title ---
    IF gMenuOpen >= 0 THEN
        DIM inner AS INTEGER = menuBoxWidth(gMenuOpen)
        DIM boxW AS INTEGER = inner + 4
        DIM boxX AS INTEGER = menuTitleX(gMenuOpen)
        IF boxX + boxW > w THEN boxX = w - boxW
        IF boxX < 0 THEN boxX = 0
        DIM nItems AS INTEGER = LEN(menuItems(gMenuOpen))
        DIM li AS INTEGER
        FOR li = 0 TO nItems + 1
            DIM mr AS INTEGER = 1 + li
            IF mr <= h - 2 THEN
                DIM boxLine AS STRING = menuBoxLine(gMenuOpen, li, inner, gMenuSel)
                DIM leftPart AS STRING = ""
                DIM rightPart AS STRING = ""
                DIM rEnd AS INTEGER = boxX + boxW
                IF mr = 1 THEN
                    leftPart = stStyle.Render(Left(statusFit, boxX))
                    rightPart = stStyle.Render(Mid(statusFit, rEnd + 1, w - rEnd))
                ELSEIF mr = 2 THEN
                    leftPart = ruStyle.Render(Left(ruler, boxX))
                    rightPart = ruStyle.Render(Mid(ruler, rEnd + 1, w - rEnd))
                ELSE
                    leftPart = renderBgRange(mr, 0, boxX, txStyle, curStyle, blkStyle)
                    rightPart = renderBgRange(mr, rEnd, w - rEnd, txStyle, curStyle, blkStyle)
                END IF
                rows[mr] = leftPart + boxLine + rightPart
            END IF
        NEXT li
    END IF

    ' --- transient size popup (shown while the terminal is being resized) ---
    IF gResizeShow THEN
        DIM popSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#ffd166")).Bold(TRUE)
        DIM c1 AS STRING = fmt.Sprintf("  Columns: %d  ", w)
        DIM c2 AS STRING = fmt.Sprintf("  Rows:    %d  ", h)
        DIM innerW AS INTEGER = LEN(c1)
        IF LEN(c2) > innerW THEN innerW = LEN(c2)
        DIM pbox AS []STRING
        pbox = APPEND(pbox, "╭" + strings.Repeat("─", innerW) + "╮")
        pbox = APPEND(pbox, "│" + swFit(c1, innerW) + "│")
        pbox = APPEND(pbox, "│" + swFit(c2, innerW) + "│")
        pbox = APPEND(pbox, "╰" + strings.Repeat("─", innerW) + "╯")
        DIM pboxW AS INTEGER = innerW + 2
        DIM pboxX AS INTEGER = (w - pboxW) / 2
        IF pboxX < 0 THEN pboxX = 0
        DIM pboxY AS INTEGER = txTop + (txRows - LEN(pbox)) / 2
        IF pboxY < txTop THEN pboxY = txTop
        DIM pi AS INTEGER
        FOR pi = 0 TO LEN(pbox) - 1
            DIM pmr AS INTEGER = pboxY + pi
            IF pmr >= txTop AND pmr <= h - 2 THEN
                DIM pEnd AS INTEGER = pboxX + pboxW
                DIM pleft AS STRING = renderBgRange(pmr, 0, pboxX, txStyle, curStyle, blkStyle)
                DIM pright AS STRING = renderBgRange(pmr, pEnd, w - pEnd, txStyle, curStyle, blkStyle)
                rows[pmr] = pleft + popSt.Render(pbox[pi]) + pright
            END IF
        NEXT pi
    END IF

    ' --- on-screen calculator panel (Utilities > Calculator) ---------------
    IF gCalcOpen THEN
        DIM calcSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#e6eeff")).Background(lipgloss.Color("#14336e"))
        DIM iw AS INTEGER = 34
        DIM clines AS []STRING
        ' Pad the ASCII part to iw-1, then add the 1-col cursor block. (swFit
        ' measures bytes, and Chr(9617) is 3 bytes / 1 column.)
        clines = APPEND(clines, swFit(" > " + gCalcInput, iw - 1) + Chr(9617))
        clines = APPEND(clines, swFit(" = " + gCalcResult, iw))
        clines = APPEND(clines, strings.Repeat("─", iw))
        DIM cti AS INTEGER
        FOR cti = 0 TO LEN(gCalcTape) - 1
            clines = APPEND(clines, swFit("   " + gCalcTape[cti], iw))
        NEXT cti
        clines = APPEND(clines, strings.Repeat("─", iw))
        clines = APPEND(clines, swFit(" Enter=calc  C=clear  I=insert  Esc", iw))
        DIM cbox AS []STRING
        cbox = APPEND(cbox, "╭ Calculator " + strings.Repeat("─", iw - 12) + "╮")
        DIM cl AS INTEGER
        FOR cl = 0 TO LEN(clines) - 1
            cbox = APPEND(cbox, "│" + clines[cl] + "│")
        NEXT cl
        cbox = APPEND(cbox, "╰" + strings.Repeat("─", iw) + "╯")
        DIM cboxW AS INTEGER = iw + 2
        DIM cboxX AS INTEGER = (w - cboxW) / 2
        IF cboxX < 0 THEN cboxX = 0
        DIM cboxY AS INTEGER = txTop + (txRows - LEN(cbox)) / 2
        IF cboxY < txTop THEN cboxY = txTop
        DIM ci AS INTEGER
        FOR ci = 0 TO LEN(cbox) - 1
            DIM cmr AS INTEGER = cboxY + ci
            IF cmr >= txTop AND cmr <= h - 2 THEN
                DIM cEnd AS INTEGER = cboxX + cboxW
                DIM cLeft AS STRING = renderBgRange(cmr, 0, cboxX, txStyle, curStyle, blkStyle)
                DIM cRight AS STRING = renderBgRange(cmr, cEnd, w - cEnd, txStyle, curStyle, blkStyle)
                rows[cmr] = cLeft + calcSt.Render(cbox[ci]) + cRight
            END IF
        NEXT ci
    END IF

    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' Left-click inside canvas sw — drive the menu bar, an open dropdown, or
' (otherwise) drop the cursor at the clicked text cell.
SUB sw_Click(x AS INTEGER, y AS INTEGER)
    ' Opening Menu: a click on a file-list row selects and opens it.
    IF gMode = "open" THEN
        DIM li AS INTEGER = gOpenTop + (y - 7)
        IF y >= 7 AND li >= 0 AND li < LEN(gOpenFiles) THEN
            gOpenSel = li
            openSelected()
        END IF
        RETURN
    END IF
    ' Click the menu bar (row 0): open / switch to that menu.
    IF y = 0 THEN
        DIM mhit AS INTEGER = menuAtX(x)
        IF mhit >= 0 THEN
            gMenuOpen = mhit
            gMenuSel = 0
        ELSE
            gMenuOpen = 0 - 1
        END IF
        RETURN
    END IF
    ' With a dropdown open: a click inside it selects an item; outside closes.
    IF gMenuOpen >= 0 THEN
        DIM inner AS INTEGER = menuBoxWidth(gMenuOpen)
        DIM boxW AS INTEGER = inner + 4
        DIM boxX AS INTEGER = menuTitleX(gMenuOpen)
        IF boxX + boxW > gW THEN boxX = gW - boxW
        IF boxX < 0 THEN boxX = 0
        DIM nItems AS INTEGER = LEN(menuItems(gMenuOpen))
        ' Item rows are canvas rows 2 .. 1+nItems (row 1 is the top border).
        IF x >= boxX AND x < boxX + boxW AND y >= 2 AND y <= 1 + nItems THEN
            DIM idx AS INTEGER = y - 2
            doMenuItem(gMenuOpen, itemField(menuItems(gMenuOpen)[idx], 0))
        ELSE
            gMenuOpen = 0 - 1
        END IF
        RETURN
    END IF
    IF gPrefix <> "" OR gPromptMode <> "" THEN RETURN
    IF y < 3 OR y > gH - 2 THEN RETURN
    IF softWrapOn() THEN
        ' Map the click to a visual row, then to a byte within its segment.
        DIM vr AS INTEGER = gTopVis + (y - 3)
        IF vr >= 0 AND vr < LEN(gVisLine) THEN
            gRow = gVisLine[vr]
            gCol = byteAtCol(gLines[gRow], gVisStart[vr], gVisEnd[vr], x)
        END IF
        clampCursor()
        gMessage = ""
        RETURN
    END IF
    gRow = gTop + (y - 3)
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gRow < 0 THEN gRow = 0
    ' Map the clicked display cell x to a rune boundary: advance x runes from
    ' the (rune-snapped) left scroll offset.
    DIM ln AS STRING = curLine()
    DIM pos AS INTEGER = snapToRune(ln, gLeft)
    DIM cellsX AS INTEGER
    FOR cellsX = 1 TO x
        IF pos >= LEN(ln) THEN
            pos = LEN(ln)
        ELSE
            pos = nextRuneStart(ln, pos)
        END IF
    NEXT cellsX
    gCol = pos
    clampCursor()
    gMessage = ""
END SUB

' ==========================================================================
' Editing primitives
' ==========================================================================

SUB insertChar(ch AS STRING)
    DIM ln AS STRING = curLine()
    IF gInsert OR gCol >= LEN(ln) THEN
        gLines[gRow] = Left(ln, gCol) + ch + Right(ln, LEN(ln) - gCol)
    ELSE
        ' overtype: replace the char under the cursor
        gLines[gRow] = Left(ln, gCol) + ch + Right(ln, LEN(ln) - gCol - 1)
    END IF
    ' gCol is a byte offset, so advance by the byte length of ch (1 for
    ' ASCII, more for a multibyte Unicode rune).
    gCol = gCol + LEN(ch)
    gModified = TRUE
END SUB

SUB splitLine()
    DIM ln AS STRING = curLine()
    DIM head AS STRING = Left(ln, gCol)
    DIM tail AS STRING = Right(ln, LEN(ln) - gCol)
    gLines[gRow] = head
    gLines = lineInsertAt(gLines, gRow + 1, tail)
    gRow = gRow + 1
    gCol = 0
    gModified = TRUE
END SUB

FUNCTION lineInsertAt(xs AS []STRING, idx AS INTEGER, val AS STRING) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i = idx THEN out = APPEND(out, val)
        out = APPEND(out, xs[i])
    NEXT i
    IF idx >= LEN(xs) THEN out = APPEND(out, val)
    RETURN out
END FUNCTION

FUNCTION lineRemoveAt(xs AS []STRING, idx AS INTEGER) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        IF i <> idx THEN out = APPEND(out, xs[i])
    NEXT i
    IF LEN(out) = 0 THEN out = APPEND(out, "")
    RETURN out
END FUNCTION

SUB deleteCharLeft()
    DIM ln AS STRING = curLine()
    IF gCol > 0 THEN
        ' Delete the whole rune to the left (1-4 bytes), never half of one.
        DIM ps AS INTEGER = prevRuneStart(ln, gCol)
        gLines[gRow] = Left(ln, ps) + Right(ln, LEN(ln) - gCol)
        gCol = ps
    ELSEIF gRow > 0 THEN
        DIM prevLen AS INTEGER = LEN(gLines[gRow - 1])
        gLines[gRow - 1] = gLines[gRow - 1] + ln
        gLines = lineRemoveAt(gLines, gRow)
        gRow = gRow - 1
        gCol = prevLen
    END IF
    gModified = TRUE
END SUB

SUB deleteCharAt()
    DIM ln AS STRING = curLine()
    IF gCol < LEN(ln) THEN
        ' Delete the whole rune at the cursor (1-4 bytes).
        DIM ns AS INTEGER = nextRuneStart(ln, gCol)
        gLines[gRow] = Left(ln, gCol) + Right(ln, LEN(ln) - ns)
    ELSEIF gRow < lastRow() THEN
        gLines[gRow] = ln + gLines[gRow + 1]
        gLines = lineRemoveAt(gLines, gRow + 1)
    END IF
    gModified = TRUE
END SUB

SUB deleteWordRight()
    DIM ln AS STRING = curLine()
    DIM c AS INTEGER = gCol
    WHILE c < LEN(ln) AND isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    WHILE c < LEN(ln) AND NOT isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    gLines[gRow] = Left(ln, gCol) + Right(ln, LEN(ln) - c)
    gModified = TRUE
END SUB

SUB deleteLine()
    gLines = lineRemoveAt(gLines, gRow)
    IF gRow > lastRow() THEN gRow = lastRow()
    gCol = 0
    gModified = TRUE
END SUB

SUB insertBlankLine()
    gLines = lineInsertAt(gLines, gRow, "")
    gModified = TRUE
END SUB

' insertMarker — insert a WordStar print-control toggle byte (Chr code) at the
' cursor. Inserting two (begin/end) makes the text between them bold/italic/etc.
SUB insertMarker(code AS INTEGER)
    insertChar(Chr(code))
END SUB

' centerLine — center the current line's text between the margins (^OC).
SUB centerLine()
    DIM t AS STRING = strings.TrimSpace(gLines[gRow])
    DIM span AS INTEGER = gRightMargin - gLeftMargin
    DIM pad AS INTEGER = gLeftMargin + (span - runeIndexOf(t, LEN(t))) / 2
    IF pad < 0 THEN pad = 0
    gLines[gRow] = strings.Repeat(" ", pad) + t
    gCol = LEN(gLines[gRow])
    gModified = TRUE
    gMessage = "Line centered"
END SUB

' applyDotCommands — scan the document for ".lm N" / ".rm N" dot commands and
' set the ruler margins (last one in the file wins). Called each render.
SUB applyDotCommands()
    ' Header/footer/page settings are dot-command-only, so reset them to
    ' defaults each pass (deleting a .he/.fo/.mt clears its effect). Margins
    ' and page length are also settable from menus, so those persist unless a
    ' dot command overrides them.
    gHeader = ""
    gFooter = ""
    gMarginTop = 3
    gMarginBottom = 8
    gPageNumbering = TRUE
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        DIM ln AS STRING = gLines[i]
        IF Left(ln, 4) = ".lm " THEN
            DIM v AS INTEGER = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
            IF v >= 0 THEN gLeftMargin = v
        ELSEIF Left(ln, 4) = ".rm " THEN
            DIM v2 AS INTEGER = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
            IF v2 > 0 THEN gRightMargin = v2
        ELSEIF Left(ln, 4) = ".pl " THEN
            DIM pv AS INTEGER = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
            IF pv > 0 THEN gPageLength = pv
        ELSEIF Left(ln, 4) = ".mt " THEN
            gMarginTop = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
        ELSEIF Left(ln, 4) = ".mb " THEN
            gMarginBottom = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
        ELSEIF Left(ln, 4) = ".he " THEN
            gHeader = Mid(ln, 5, LEN(ln) - 4)
        ELSEIF Left(ln, 4) = ".fo " THEN
            gFooter = Mid(ln, 5, LEN(ln) - 4)
        ELSEIF Left(ln, 4) = ".ls " THEN
            DIM lsv AS INTEGER = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
            IF lsv >= 1 THEN gLineSpacing = lsv
        ELSEIF Left(ln, 4) = ".po " THEN
            gPageOffset = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))))
        ELSEIF Left(ln, 3) = ".pn" THEN
            gPageNumbering = TRUE
        ELSEIF Left(ln, 3) = ".op" THEN
            gPageNumbering = FALSE
        END IF
    NEXT i
END SUB

' isDotCmd — a dot-command line (starts with ".") is not printed or paginated.
FUNCTION isDotCmd(ln AS STRING) AS BOOLEAN
    RETURN Left(ln, 1) = "."
END FUNCTION

' paginate — the document-line index that begins each printed page, honoring
' .pa forced breaks and the page length minus top/bottom margins.
FUNCTION paginate() AS []INTEGER
    DIM starts AS []INTEGER
    DIM perPage AS INTEGER = gPageLength - gMarginTop - gMarginBottom
    IF perPage < 1 THEN perPage = 1
    starts = APPEND(starts, 0)
    ' Ignore trailing blank lines so a final newline can't spawn an empty page.
    DIM lastContent AS INTEGER = lastRow()
    WHILE lastContent > 0 AND strings.TrimSpace(gLines[lastContent]) = ""
        lastContent = lastContent - 1
    WEND
    DIM sp AS INTEGER = gLineSpacing
    IF sp < 1 THEN sp = 1
    DIM count AS INTEGER = 0
    DIM forceBreak AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO lastContent
        DIM ln AS STRING = gLines[i]
        IF Left(ln, 3) = ".pa" THEN
            count = 0
            IF i + 1 <= lastRow() THEN starts = APPEND(starts, i + 1)
        ELSEIF Left(ln, 4) = ".cp " THEN
            ' conditional page: break now if the next N lines won't fit
            DIM need AS INTEGER = Int(Val(strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4)))) * sp
            IF count + need > perPage THEN forceBreak = TRUE
        ELSEIF isDotCmd(ln) THEN
            ' other dot command — no page advance
        ELSE
            IF forceBreak THEN
                starts = APPEND(starts, i)
                count = 0
                forceBreak = FALSE
            END IF
            count = count + sp
            IF count > perPage THEN
                starts = APPEND(starts, i)
                count = sp
            END IF
        END IF
    NEXT i
    RETURN starts
END FUNCTION

' subPageNum — replace "#" in a header/footer with the page number.
FUNCTION subPageNum(s AS STRING, p AS INTEGER) AS STRING
    RETURN strings.ReplaceAll(s, "#", fmt.Sprintf("%d", p))
END FUNCTION

' centerText — center s within the right margin (for the page-number footer).
FUNCTION centerText(s AS STRING) AS STRING
    IF gRightMargin <= LEN(s) THEN RETURN s
    RETURN strings.Repeat(" ", (gRightMargin - LEN(s)) / 2) + s
END FUNCTION

' buildPaginated — the document laid out into pages: header, body (markers
' stripped, dot commands dropped), footer/page number. forScreen inserts a
' visible separator between pages; otherwise a form-feed (Chr 12) for printing.
' pageOfLine — the 1-based page number that document line lineIdx prints on.
FUNCTION pageOfLine(starts AS []INTEGER, lineIdx AS INTEGER) AS INTEGER
    DIM p AS INTEGER = LEN(starts) - 1
    WHILE p > 0 AND starts[p] > lineIdx
        p = p - 1
    WEND
    RETURN p + 1
END FUNCTION

' sortStrings — in-place case-insensitive insertion sort (for the index).
SUB sortStrings(xs AS []STRING)
    DIM i AS INTEGER
    FOR i = 1 TO LEN(xs) - 1
        DIM keyv AS STRING = xs[i]
        DIM j AS INTEGER = i - 1
        WHILE j >= 0 AND strings.Compare(LCase(xs[j]), LCase(keyv)) > 0
            xs[j + 1] = xs[j]
            j = j - 1
        WEND
        xs[j + 1] = keyv
    NEXT i
END SUB

' refLine — "  entry ......... tail" for an index/TOC line.
FUNCTION refLine(entry AS STRING, tail AS STRING) AS STRING
    DIM lead AS STRING = "  " + entry + " "
    DIM dots AS INTEGER = 44 - LEN(lead) - LEN(tail)
    IF dots < 2 THEN dots = 2
    RETURN lead + strings.Repeat(".", dots) + " " + tail
END FUNCTION

' buildPaginated — lay the document into pages: header, body (markers stripped,
' dot commands dropped), per-page footnotes (.fn), expanded index (.index) and
' table of contents (.toc), and a footer/page number. forScreen inserts a
' visible separator between pages; otherwise a form-feed for printing.
FUNCTION buildPaginated(forScreen AS BOOLEAN) AS []STRING
    DIM starts AS []INTEGER = paginate()

    ' Pre-scan .ix index marks and .tc contents marks with their page numbers.
    DIM ixKeys AS []STRING
    DIM ixMap AS MAP OF STRING TO STRING
    DIM tcEntry AS []STRING
    DIM tcPage AS []INTEGER
    DIM li AS INTEGER
    FOR li = 0 TO lastRow()
        DIM ln AS STRING = gLines[li]
        IF Left(ln, 4) = ".ix " THEN
            DIM ent AS STRING = strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))
            IF ent <> "" THEN
                DIM tag AS STRING = fmt.Sprintf("%d", pageOfLine(starts, li))
                IF ixMap[ent] = "" THEN
                    ixKeys = APPEND(ixKeys, ent)
                    ixMap[ent] = tag
                ELSEIF NOT strings.Contains(" " + ixMap[ent] + " ", " " + tag + " ") THEN
                    ixMap[ent] = ixMap[ent] + " " + tag
                END IF
            END IF
        ELSEIF Left(ln, 4) = ".tc " THEN
            DIM tent AS STRING = strings.TrimSpace(Mid(ln, 5, LEN(ln) - 4))
            IF tent <> "" THEN
                tcEntry = APPEND(tcEntry, tent)
                tcPage = APPEND(tcPage, pageOfLine(starts, li))
            END IF
        END IF
    NEXT li
    sortStrings(ixKeys)

    DIM out AS []STRING
    DIM fnNum AS INTEGER = 0
    DIM p AS INTEGER
    FOR p = 0 TO LEN(starts) - 1
        DIM firstLine AS INTEGER = starts[p]
        DIM lastLine AS INTEGER = lastRow()
        IF p + 1 < LEN(starts) THEN lastLine = starts[p + 1] - 1
        IF gHeader <> "" THEN
            out = APPEND(out, subPageNum(gHeader, p + 1))
            out = APPEND(out, "")
        END IF
        DIM pageNotes AS []STRING
        DIM lastBodyIdx AS INTEGER = 0 - 1
        DIM i AS INTEGER
        FOR i = firstLine TO lastLine
            DIM bl AS STRING = gLines[i]
            DIM tb AS STRING = strings.TrimSpace(bl)
            IF Left(bl, 4) = ".fn " THEN
                fnNum = fnNum + 1
                DIM mk AS STRING = fmt.Sprintf("[%d]", fnNum)
                IF lastBodyIdx >= 0 THEN
                    out[lastBodyIdx] = out[lastBodyIdx] + mk
                ELSE
                    out = APPEND(out, mk)
                    lastBodyIdx = LEN(out) - 1
                END IF
                pageNotes = APPEND(pageNotes, mk + " " + strings.TrimSpace(Mid(bl, 5, LEN(bl) - 4)))
            ELSEIF tb = ".index" THEN
                out = APPEND(out, "")
                out = APPEND(out, centerText("INDEX"))
                DIM k AS INTEGER
                FOR k = 0 TO LEN(ixKeys) - 1
                    out = APPEND(out, refLine(ixKeys[k], ixMap[ixKeys[k]]))
                NEXT k
                lastBodyIdx = LEN(out) - 1
            ELSEIF tb = ".toc" THEN
                out = APPEND(out, "")
                out = APPEND(out, centerText("TABLE OF CONTENTS"))
                DIM t AS INTEGER
                FOR t = 0 TO LEN(tcEntry) - 1
                    out = APPEND(out, refLine(tcEntry[t], fmt.Sprintf("%d", tcPage[t])))
                NEXT t
                lastBodyIdx = LEN(out) - 1
            ELSEIF NOT isDotCmd(bl) THEN
                out = APPEND(out, stripMarkers(bl))
                lastBodyIdx = LEN(out) - 1
                DIM extra AS INTEGER
                FOR extra = 1 TO gLineSpacing - 1
                    out = APPEND(out, "")
                NEXT extra
            END IF
        NEXT i
        IF LEN(pageNotes) > 0 THEN
            out = APPEND(out, strings.Repeat("─", 20))
            DIM fi AS INTEGER
            FOR fi = 0 TO LEN(pageNotes) - 1
                out = APPEND(out, pageNotes[fi])
            NEXT fi
        END IF
        DIM foot AS STRING = ""
        IF gFooter <> "" THEN
            foot = subPageNum(gFooter, p + 1)
        ELSEIF gPageNumbering THEN
            foot = centerText(fmt.Sprintf("%d", p + 1))
        END IF
        IF foot <> "" THEN
            out = APPEND(out, "")
            out = APPEND(out, foot)
        END IF
        IF p + 1 < LEN(starts) THEN
            IF forScreen THEN
                out = APPEND(out, strings.Repeat("─", 24) + fmt.Sprintf(" page %d ", p + 2) + strings.Repeat("─", 12))
            ELSE
                out = APPEND(out, Chr(12))
            END IF
        END IF
    NEXT p
    ' .po page offset: indent every printed line (but not the form feeds).
    IF gPageOffset > 0 THEN
        DIM pad AS STRING = strings.Repeat(" ", gPageOffset)
        DIM oi AS INTEGER
        FOR oi = 0 TO LEN(out) - 1
            IF out[oi] <> Chr(12) THEN out[oi] = pad + out[oi]
        NEXT oi
    END IF
    RETURN out
END FUNCTION

' ==========================================================================
' Paragraph reflow + justification (^B reformat, ^OJ justify, ^OW word-wrap)
' ==========================================================================

' dispWidth — display columns of s: runes that aren't zero-width print-control
' toggle markers (^B/^Y/^S).
FUNCTION dispWidth(s AS STRING) AS INTEGER
    DIM n AS INTEGER = 0
    DIM p AS INTEGER = 0
    WHILE p < LEN(s)
        IF markerLetter(runeAt(s, p)) = "" THEN n = n + 1
        p = nextRuneStart(s, p)
    WEND
    RETURN n
END FUNCTION

' isTextLine — part of a paragraph? (not blank, not a dot command).
FUNCTION isTextLine(s AS STRING) AS BOOLEAN
    IF strings.TrimSpace(s) = "" THEN RETURN FALSE
    IF Left(s, 1) = "." THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' buildWrapLine — assemble one wrapped line from its words at the left margin.
' Justifies (pads gaps to the right margin) when gJustify is on and this is
' neither the paragraph's last line nor a single word.
FUNCTION buildWrapLine(words AS []STRING, maxW AS INTEGER, isLast AS BOOLEAN) AS STRING
    DIM leftPad AS STRING = strings.Repeat(" ", gLeftMargin)
    IF LEN(words) = 0 THEN RETURN leftPad
    IF NOT gJustify OR isLast OR LEN(words) = 1 THEN
        RETURN leftPad + strings.Join(words, " ")
    END IF
    DIM textW AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(words) - 1
        textW = textW + dispWidth(words[i])
    NEXT i
    DIM gaps AS INTEGER = LEN(words) - 1
    DIM spaces AS INTEGER = maxW - textW
    IF spaces < gaps THEN spaces = gaps
    DIM baseSp AS INTEGER = spaces / gaps
    DIM extra AS INTEGER = spaces MOD gaps
    DIM out AS STRING = words[0]
    FOR i = 1 TO gaps
        DIM sp AS INTEGER = baseSp
        IF i <= extra THEN sp = baseSp + 1
        out = out + strings.Repeat(" ", sp) + words[i]
    NEXT i
    RETURN leftPad + out
END FUNCTION

' replaceLines — splice newLines in for gLines[ps..pe].
SUB replaceLines(ps AS INTEGER, pe AS INTEGER, newLines AS []STRING)
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO ps - 1
        out = APPEND(out, gLines[i])
    NEXT i
    FOR i = 0 TO LEN(newLines) - 1
        out = APPEND(out, newLines[i])
    NEXT i
    FOR i = pe + 1 TO lastRow()
        out = APPEND(out, gLines[i])
    NEXT i
    IF LEN(out) = 0 THEN out = APPEND(out, "")
    gLines = out
END SUB

' reformatParagraph — ^B: re-wrap the paragraph at the cursor to the current
' margins, justifying when ^OJ is on. A paragraph is the run of non-blank,
' non-dot lines around the cursor.
SUB reformatParagraph()
    IF NOT isTextLine(gLines[gRow]) THEN
        gMessage = "Nothing to reformat here"
        RETURN
    END IF
    DIM ps AS INTEGER = gRow
    WHILE ps > 0 AND isTextLine(gLines[ps - 1])
        ps = ps - 1
    WEND
    DIM pe AS INTEGER = gRow
    WHILE pe < lastRow() AND isTextLine(gLines[pe + 1])
        pe = pe + 1
    WEND
    ' Gather every word in the paragraph.
    DIM words AS []STRING
    DIM i AS INTEGER
    FOR i = ps TO pe
        DIM fs AS []STRING = strings.Fields(gLines[i])
        DIM j AS INTEGER
        FOR j = 0 TO LEN(fs) - 1
            words = APPEND(words, fs[j])
        NEXT j
    NEXT i
    DIM maxW AS INTEGER = gRightMargin - gLeftMargin
    IF maxW < 1 THEN maxW = 1
    ' Greedy wrap.
    DIM newLines AS []STRING
    DIM curWords AS []STRING
    DIM curW AS INTEGER = 0
    DIM k AS INTEGER
    FOR k = 0 TO LEN(words) - 1
        DIM ww AS INTEGER = dispWidth(words[k])
        DIM add AS INTEGER = ww
        IF LEN(curWords) > 0 THEN add = add + 1
        IF LEN(curWords) > 0 AND curW + add > maxW THEN
            newLines = APPEND(newLines, buildWrapLine(curWords, maxW, FALSE))
            curWords = nil
            curW = 0
            add = ww
        END IF
        curWords = APPEND(curWords, words[k])
        curW = curW + add
    NEXT k
    IF LEN(curWords) > 0 THEN newLines = APPEND(newLines, buildWrapLine(curWords, maxW, TRUE))
    IF LEN(newLines) = 0 THEN newLines = APPEND(newLines, "")
    replaceLines(ps, pe, newLines)
    gRow = ps
    gCol = 0
    gModified = TRUE
    gMessage = "Paragraph reformatted"
END SUB

' wrapInsertIfNeeded — ^OW live word-wrap: after typing pushes the current
' line past the right margin, break it at the last space so the word in
' progress falls to a new line (the cursor follows it).
SUB wrapInsertIfNeeded()
    IF NOT gWordWrap THEN RETURN
    DIM ln AS STRING = curLine()
    IF dispWidth(ln) <= gRightMargin THEN RETURN
    ' Find the last space at/before the right margin to break at.
    DIM brk AS INTEGER = 0 - 1
    DIM p AS INTEGER = 0
    DIM col AS INTEGER = 0
    WHILE p < LEN(ln)
        IF Mid(ln, p + 1, 1) = " " AND col <= gRightMargin THEN brk = p
        IF markerLetter(runeAt(ln, p)) = "" THEN col = col + 1
        p = nextRuneStart(ln, p)
    WEND
    ' single long word — leave it
    IF brk < 0 THEN RETURN
    DIM head AS STRING = Left(ln, brk)
    DIM tail AS STRING = Right(ln, LEN(ln) - brk - 1)   ' drop the break space
    gLines[gRow] = head
    DIM moved AS INTEGER = gCol - brk - 1                ' cursor offset within tail
    gLines = lineInsertAt(gLines, gRow + 1, strings.Repeat(" ", gLeftMargin) + tail)
    gRow = gRow + 1
    gCol = gLeftMargin + moved
    IF gCol < gLeftMargin THEN gCol = gLeftMargin
END SUB

' ==========================================================================
' Soft word wrap (display only) — gWrapMode = "soft". A long logical line is
' shown across several screen rows ("visual rows") without changing the file.
' ==========================================================================

FUNCTION softWrapOn() AS BOOLEAN
    RETURN gWrapMode = "soft"
END FUNCTION

' wrapWidth — columns to wrap at: the right margin, clamped to the screen.
FUNCTION wrapWidth() AS INTEGER
    DIM ww AS INTEGER = gRightMargin
    IF ww < 1 OR ww >= gW THEN ww = gW - 1
    IF ww < 1 THEN ww = 1
    RETURN ww
END FUNCTION

' wrapSegments — byte offsets where each visual segment of `line` begins
' (always starts with 0), breaking at the last space before `ww` columns
' (hard break for an overlong word). Markers are counted as 1 column.
FUNCTION wrapSegments(line AS STRING, ww AS INTEGER) AS []INTEGER
    DIM segs AS []INTEGER
    segs = APPEND(segs, 0)
    IF ww < 1 THEN ww = 1
    DIM segStart AS INTEGER = 0
    DIM lastSpace AS INTEGER = 0 - 1
    DIM col AS INTEGER = 0
    DIM p AS INTEGER = 0
    WHILE p < LEN(line)
        IF Mid(line, p + 1, 1) = " " THEN lastSpace = p
        IF col >= ww AND p > segStart THEN
            DIM ns AS INTEGER = p
            IF lastSpace >= segStart AND lastSpace + 1 < p THEN ns = lastSpace + 1
            segs = APPEND(segs, ns)
            segStart = ns
            lastSpace = 0 - 1
            col = 0
            DIM q AS INTEGER = ns
            WHILE q < p
                col = col + 1
                q = nextRuneStart(line, q)
            WEND
        END IF
        col = col + 1
        p = nextRuneStart(line, p)
    WEND
    RETURN segs
END FUNCTION

' segIndexOf — index of the segment containing byte offset col.
FUNCTION segIndexOf(segs AS []INTEGER, col AS INTEGER) AS INTEGER
    DIM i AS INTEGER = LEN(segs) - 1
    WHILE i > 0 AND segs[i] > col
        i = i - 1
    WEND
    RETURN i
END FUNCTION

' colWithin — display columns from byte `start` to byte `col`.
FUNCTION colWithin(line AS STRING, start AS INTEGER, col AS INTEGER) AS INTEGER
    DIM p AS INTEGER = start
    DIM c AS INTEGER = 0
    WHILE p < col AND p < LEN(line)
        p = nextRuneStart(line, p)
        c = c + 1
    WEND
    RETURN c
END FUNCTION

' byteAtCol — byte offset `col` runes after `start`, clamped to `endb`.
FUNCTION byteAtCol(line AS STRING, start AS INTEGER, endb AS INTEGER, col AS INTEGER) AS INTEGER
    DIM p AS INTEGER = start
    DIM c AS INTEGER = 0
    WHILE c < col AND p < endb
        p = nextRuneStart(line, p)
        c = c + 1
    WEND
    RETURN p
END FUNCTION

' buildVisRows — (re)build the whole-document visual-row table for soft mode.
SUB buildVisRows(ww AS INTEGER)
    gVisLine = nil
    gVisStart = nil
    gVisEnd = nil
    DIM i AS INTEGER
    FOR i = 0 TO lastRow()
        DIM segs AS []INTEGER = wrapSegments(gLines[i], ww)
        DIM s AS INTEGER
        FOR s = 0 TO LEN(segs) - 1
            DIM en AS INTEGER = LEN(gLines[i])
            IF s + 1 < LEN(segs) THEN en = segs[s + 1]
            gVisLine = APPEND(gVisLine, i)
            gVisStart = APPEND(gVisStart, segs[s])
            gVisEnd = APPEND(gVisEnd, en)
        NEXT s
    NEXT i
END SUB

' cursorVisRow — index into gVis* of the row the cursor sits on.
FUNCTION cursorVisRow() AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gVisLine) - 1
        IF gVisLine[i] = gRow THEN
            IF gCol >= gVisStart[i] AND gCol < gVisEnd[i] THEN RETURN i
            DIM lastOfLine AS BOOLEAN = (i + 1 >= LEN(gVisLine)) OR (gVisLine[i + 1] <> gRow)
            IF gCol = gVisEnd[i] AND lastOfLine THEN RETURN i
        END IF
    NEXT i
    RETURN 0
END FUNCTION

' renderSegment — render display cells [fromCell, fromCell+count) of the byte
' range [segStart, segEnd) of a document row (the soft-wrap analog of
' renderTextRange, which windows by gLeft instead).
FUNCTION renderSegment(rowIdx AS INTEGER, segStart AS INTEGER, segEnd AS INTEGER, fromCell AS INTEGER, count AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    DIM line AS STRING = ""
    IF rowIdx >= 0 AND rowIdx <= lastRow() THEN line = gLines[rowIdx]
    DIM lineLen AS INTEGER = LEN(line)
    DIM isDot AS BOOLEAN = (Left(line, 1) = ".")
    DIM useBase AS lipgloss.Style = baseSt
    IF isDot THEN useBase = lipgloss.NewStyle().Foreground(lipgloss.Color("#6b7bb5")).Background(lipgloss.Color("#0f2350")).Italic(TRUE)
    DIM tagSt AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#10204a")).Background(lipgloss.Color("#e0af68")).Bold(TRUE)

    DIM pos AS INTEGER = segStart
    DIM skip AS INTEGER
    FOR skip = 1 TO fromCell
        IF pos < segEnd THEN pos = nextRuneStart(line, pos)
    NEXT skip

    DIM bold AS BOOLEAN = FALSE
    DIM ital AS BOOLEAN = FALSE
    DIM undl AS BOOLEAN = FALSE
    DIM strk AS BOOLEAN = FALSE
    IF NOT isDot THEN bold, ital, undl, strk = attrsAt(line, pos)

    DIM out AS STRING = ""
    DIM buf AS STRING = ""
    DIM bufCls AS INTEGER = 0 - 1
    DIM bufB AS BOOLEAN = FALSE
    DIM bufI AS BOOLEAN = FALSE
    DIM bufU AS BOOLEAN = FALSE
    DIM bufX AS BOOLEAN = FALSE
    DIM cell AS INTEGER = 0
    WHILE cell < count
        DIM ch AS STRING = " "
        DIM rl AS INTEGER = 1
        IF pos < segEnd THEN
            rl = runeLenAt(line, pos)
            ch = Mid(line, pos + 1, rl)
        END IF
        DIM mk AS STRING = ""
        IF NOT isDot AND pos < segEnd THEN mk = markerLetter(ch)
        IF mk <> "" THEN
            DIM mc AS INTEGER = Asc(ch)
            IF mc = 2 OR mc = 4 THEN bold = NOT bold
            IF mc = 25 THEN ital = NOT ital
            IF mc = 19 THEN undl = NOT undl
            IF mc = 24 THEN strk = NOT strk
            pos = pos + rl
            IF gShowTags THEN
                out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
                buf = ""
                bufCls = 0 - 1
                out = out + tagSt.Render(mk)
                cell = cell + 1
            END IF
        ELSE
            DIM cls AS INTEGER = 0
            DIM showCur AS BOOLEAN = FALSE
            IF rowIdx = gRow AND pos = gCol THEN
                IF pos < segEnd THEN
                    showCur = TRUE
                ELSEIF pos = segEnd AND segEnd = lineLen THEN
                    showCur = TRUE
                END IF
            END IF
            IF showCur THEN
                cls = 1
            ELSEIF isInBlock(rowIdx, pos) THEN
                cls = 2
            END IF
            pos = pos + rl
            DIM diff AS BOOLEAN = cls <> bufCls OR bold <> bufB OR ital <> bufI OR undl <> bufU OR strk <> bufX
            IF diff AND buf <> "" THEN
                out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
                buf = ""
            END IF
            bufCls = cls
            bufB = bold
            bufI = ital
            bufU = undl
            bufX = strk
            buf = buf + ch
            cell = cell + 1
        END IF
    WEND
    out = out + renderRun(buf, bufCls, bufB, bufI, bufU, bufX, useBase, cur, blk)
    RETURN out
END FUNCTION

' renderBgRange — render the background text under an overlay box at screen
' row mr, cells [fromCell, fromCell+count). Dispatches to the soft-wrap visual
' row or the hard/off logical row as appropriate.
FUNCTION renderBgRange(mr AS INTEGER, fromCell AS INTEGER, count AS INTEGER, baseSt AS lipgloss.Style, cur AS lipgloss.Style, blk AS lipgloss.Style) AS STRING
    IF softWrapOn() THEN
        DIM vr AS INTEGER = gTopVis + (mr - 3)
        IF vr >= 0 AND vr < LEN(gVisLine) THEN
            RETURN renderSegment(gVisLine[vr], gVisStart[vr], gVisEnd[vr], fromCell, count, baseSt, cur, blk)
        END IF
        RETURN baseSt.Render(strings.Repeat(" ", count))
    END IF
    RETURN renderTextRange(gTop + (mr - 3), fromCell, count, baseSt, cur, blk)
END FUNCTION

' ==========================================================================
' Cursor motion
' ==========================================================================

SUB moveLeft()
    IF gCol > 0 THEN
        ' Move by a whole rune so the cursor never lands inside a glyph.
        gCol = prevRuneStart(curLine(), gCol)
    ELSEIF gRow > 0 THEN
        gRow = gRow - 1
        gCol = LEN(curLine())
    END IF
END SUB

SUB moveRight()
    IF gCol < LEN(curLine()) THEN
        gCol = nextRuneStart(curLine(), gCol)
    ELSEIF gRow < lastRow() THEN
        gRow = gRow + 1
        gCol = 0
    END IF
END SUB

SUB moveUp()
    IF softWrapOn() THEN
        DIM ww AS INTEGER = wrapWidth()
        DIM line AS STRING = curLine()
        DIM segs AS []INTEGER = wrapSegments(line, ww)
        DIM si AS INTEGER = segIndexOf(segs, gCol)
        DIM col AS INTEGER = colWithin(line, segs[si], gCol)
        IF si > 0 THEN
            DIM pe AS INTEGER = segs[si]
            gCol = byteAtCol(line, segs[si - 1], pe, col)
        ELSEIF gRow > 0 THEN
            gRow = gRow - 1
            DIM nl AS STRING = curLine()
            DIM ns AS []INTEGER = wrapSegments(nl, ww)
            gCol = byteAtCol(nl, ns[LEN(ns) - 1], LEN(nl), col)
        END IF
        RETURN
    END IF
    IF gRow > 0 THEN gRow = gRow - 1
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
    gCol = snapToRune(curLine(), gCol)
END SUB

SUB moveDown()
    IF softWrapOn() THEN
        DIM ww AS INTEGER = wrapWidth()
        DIM line AS STRING = curLine()
        DIM segs AS []INTEGER = wrapSegments(line, ww)
        DIM si AS INTEGER = segIndexOf(segs, gCol)
        DIM col AS INTEGER = colWithin(line, segs[si], gCol)
        IF si < LEN(segs) - 1 THEN
            DIM nstart AS INTEGER = segs[si + 1]
            DIM nend AS INTEGER = LEN(line)
            IF si + 2 < LEN(segs) THEN nend = segs[si + 2]
            gCol = byteAtCol(line, nstart, nend, col)
        ELSEIF gRow < lastRow() THEN
            gRow = gRow + 1
            DIM nl AS STRING = curLine()
            DIM ns AS []INTEGER = wrapSegments(nl, ww)
            DIM e0 AS INTEGER = LEN(nl)
            IF LEN(ns) > 1 THEN e0 = ns[1]
            gCol = byteAtCol(nl, 0, e0, col)
        END IF
        RETURN
    END IF
    IF gRow < lastRow() THEN gRow = gRow + 1
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
    gCol = snapToRune(curLine(), gCol)
END SUB

SUB wordLeft()
    DIM ln AS STRING = curLine()
    IF gCol = 0 THEN
        IF gRow > 0 THEN
            gRow = gRow - 1
            gCol = LEN(curLine())
        END IF
        RETURN
    END IF
    ' Step left over runes: skip non-word runes, then the word itself. Each
    ' test inspects the rune immediately left of c (at prevRuneStart(ln,c)).
    DIM c AS INTEGER = gCol
    WHILE c > 0 AND NOT isWordCh(runeAt(ln, prevRuneStart(ln, c)))
        c = prevRuneStart(ln, c)
    WEND
    WHILE c > 0 AND isWordCh(runeAt(ln, prevRuneStart(ln, c)))
        c = prevRuneStart(ln, c)
    WEND
    gCol = c
END SUB

SUB wordRight()
    DIM ln AS STRING = curLine()
    DIM c AS INTEGER = gCol
    WHILE c < LEN(ln) AND isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    WHILE c < LEN(ln) AND NOT isWordCh(runeAt(ln, c))
        c = nextRuneStart(ln, c)
    WEND
    IF c >= LEN(ln) AND gRow < lastRow() THEN
        gRow = gRow + 1
        gCol = 0
    ELSE
        gCol = c
    END IF
END SUB

SUB pageUp()
    DIM pstep AS INTEGER = gH - 4
    IF pstep < 1 THEN pstep = 1
    IF softWrapOn() THEN
        DIM k AS INTEGER
        FOR k = 1 TO pstep
            moveUp()
        NEXT k
        RETURN
    END IF
    gRow = gRow - pstep
    IF gRow < 0 THEN gRow = 0
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
END SUB

SUB pageDown()
    DIM pstep AS INTEGER = gH - 4
    IF pstep < 1 THEN pstep = 1
    IF softWrapOn() THEN
        DIM k AS INTEGER
        FOR k = 1 TO pstep
            moveDown()
        NEXT k
        RETURN
    END IF
    gRow = gRow + pstep
    IF gRow > lastRow() THEN gRow = lastRow()
    IF gCol > LEN(curLine()) THEN gCol = LEN(curLine())
END SUB

' --- WordStar commands added in the "section A" batch ----------------------

' savePrevPos — remember the cursor before a jump, for ^QP.
SUB savePrevPos()
    gPrevRow = gRow
    gPrevCol = gCol
END SUB

' gotoPrevPos — ^QP: swap the cursor with the saved previous position.
SUB gotoPrevPos()
    IF gPrevRow < 0 THEN
        gMessage = "No previous position"
        RETURN
    END IF
    DIM r AS INTEGER = gRow
    DIM c AS INTEGER = gCol
    gRow = gPrevRow
    gCol = gPrevCol
    gPrevRow = r
    gPrevCol = c
    clampCursor()
    gMessage = "Previous position"
END SUB

' gotoLastFind — ^QV: jump to the position of the last successful find.
SUB gotoLastFind()
    IF gFindRow < 0 THEN
        gMessage = "No previous find"
        RETURN
    END IF
    savePrevPos()
    gRow = gFindRow
    gCol = gFindCol
    clampCursor()
    gMessage = "Last find"
END SUB

' deleteToLineStart — ^Q Del: delete from the start of the line to the cursor.
SUB deleteToLineStart()
    DIM ln AS STRING = curLine()
    gLines[gRow] = Right(ln, LEN(ln) - gCol)
    gCol = 0
    gModified = TRUE
END SUB

' writeBlockToFile — ^KW: write the marked block to a file.
SUB writeBlockToFile(path AS STRING)
    IF NOT blockSet() THEN
        gMessage = "Mark a block first (^KB / ^KK)"
        RETURN
    END IF
    IF strings.TrimSpace(path) = "" THEN RETURN
    DIM body AS STRING = blockText()
    IF gColumnMode THEN body = strings.Join(columnText(), Chr(10))
    DIM nl AS STRING = Chr(13) + Chr(10)
    IF gIsUnicode THEN nl = Chr(10)
    body = strings.ReplaceAll(body, Chr(10), nl)
    DIM e AS ERROR = os.WriteFile(path, Encode(body), 420)
    IF e <> NIL THEN
        gMessage = "Write failed: " + e.Error()
    ELSE
        gMessage = "Block written to " + path
    END IF
END SUB

' autoScrollTick — ^QW/^QZ: a background goroutine that wakes the UI a few
' times a second; the scroll itself runs in Form_Wake (UI thread, no races).
SUB autoScrollTick()
    WHILE gAutoScroll <> 0
        time.Sleep(110 * time.Millisecond)
        _dbtuiWake()
    WEND
END SUB

' ==========================================================================
' Key dispatch
' ==========================================================================

' isNamedKey — TRUE for the multi-character key names bubbletea reports for
' non-text keys (so the text-insert fallback never types them literally).
FUNCTION isNamedKey(key AS STRING) AS BOOLEAN
    IF LEN(key) <= 1 THEN RETURN FALSE
    SELECT CASE key
    CASE "enter", "tab", "space", "esc", "backspace", "delete", "insert"
        RETURN TRUE
    CASE "up", "down", "left", "right", "home", "end", "pgup", "pgdown"
        RETURN TRUE
    CASE "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"
        RETURN TRUE
    END SELECT
    RETURN FALSE
END FUNCTION

' isTextKey — TRUE when key is a character to insert (one rune, possibly
' multibyte for Unicode). Excludes modified chords (they contain "+") and the
' named keys above. A single byte is always text (covers "+", letters, etc.).
FUNCTION isTextKey(key AS STRING) AS BOOLEAN
    IF key = "" THEN RETURN FALSE
    IF LEN(key) = 1 THEN RETURN TRUE
    IF strings.Contains(key, "+") THEN RETURN FALSE
    IF isNamedKey(key) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' secondKey — normalize a prefix's second key: strip a leading "ctrl+" (WordStar
' lets you keep Ctrl held) and lowercase, so "B"/"b"/"ctrl+b" all become "b".
FUNCTION secondKey(key AS STRING) AS STRING
    DIM k AS STRING = key
    IF strings.HasPrefix(k, "ctrl+") THEN k = Right(k, LEN(k) - 5)
    RETURN LCase(k)
END FUNCTION

' handlePrefixK — the ^K Block & Save menu.
SUB handlePrefixK(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "b" THEN
        gBBRow = gRow
        gBBCol = gCol
        gBlockShow = TRUE
        gMessage = "Block begin marked"
    ELSEIF k = "k" THEN
        gBERow = gRow
        gBECol = gCol
        gBlockShow = TRUE
        gMessage = "Block end marked"
    ELSEIF k = "c" THEN
        blockCopyTo(gRow, gCol)
    ELSEIF k = "v" THEN
        blockMoveTo(gRow, gCol)
    ELSEIF k = "y" THEN
        blockDelete()
    ELSEIF k = "h" THEN
        gBlockShow = NOT gBlockShow
        gMessage = "Block display toggled"
    ELSEIF k = "<" THEN
        gBBRow = 0 - 1
        gBERow = 0 - 1
        gMessage = "Block unmarked"
    ELSEIF k = "s" THEN
        saveFile()
    ELSEIF k = "d" THEN
        ' ^KD: save and return to the Opening Menu (WordStar behavior).
        saveFile()
        enterOpeningMenu()
    ELSEIF k = "x" THEN
        ' ^KX: save and exit.
        saveFile()
        RequestQuit()
    ELSEIF k = "q" THEN
        RequestQuit()
    ELSEIF k = "n" THEN
        gColumnMode = NOT gColumnMode
        IF gColumnMode THEN
            gMessage = "Column (rectangular) block mode ON"
        ELSE
            gMessage = "Column block mode OFF (stream)"
        END IF
    ELSEIF k = "m" THEN
        blockMath()
    ELSEIF k = "w" THEN
        gPromptMode = "blockwrite"
        gPromptLabel = "Write block to file: "
        gPromptText = ""
    ELSEIF k = "r" THEN
        gPromptMode = "insfile"
        gPromptLabel = "Read file into document: "
        gPromptText = ""
    ELSEIF digitOf(k) >= 0 THEN
        setPlaceMarker(digitOf(k))
    ELSE
        gMessage = "^K" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' handlePrefixQ — the ^Q Quick menu (navigation + find).
SUB handlePrefixQ(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "s" THEN
        gCol = 0
    ELSEIF k = "d" THEN
        gCol = LEN(curLine())
    ELSEIF k = "e" THEN
        gRow = gTop
    ELSEIF k = "x" THEN
        gRow = gTop + (gH - 4)
        IF gRow > lastRow() THEN gRow = lastRow()
    ELSEIF k = "r" THEN
        gRow = 0
        gCol = 0
    ELSEIF k = "c" THEN
        gRow = lastRow()
        gCol = LEN(curLine())
    ELSEIF k = "b" THEN
        IF gBBRow >= 0 THEN
            gRow = gBBRow
            gCol = gBBCol
        END IF
    ELSEIF k = "k" THEN
        IF gBERow >= 0 THEN
            gRow = gBERow
            gCol = gBECol
        END IF
    ELSEIF k = "y" THEN
        DIM ln AS STRING = curLine()
        gLines[gRow] = Left(ln, gCol)
        gModified = TRUE
    ELSEIF k = "f" THEN
        gPromptMode = "find"
        gPromptLabel = "Find: "
        gPromptText = ""
    ELSEIF k = "a" THEN
        gPromptMode = "rfind"
        gPromptLabel = "Replace - find: "
        gPromptText = ""
    ELSEIF k = "i" THEN
        gPromptMode = "goto"
        gPromptLabel = "Go to line (P# = page): "
        gPromptText = ""
    ELSEIF k = "l" THEN
        checkWordAtCursor()
    ELSEIF k = "n" THEN
        startSpell()
    ELSEIF k = "q" THEN
        gPromptMode = "repeatcount"
        gPromptLabel = "Repeat next command how many times: "
        gPromptText = ""
    ELSEIF k = "p" THEN
        gotoPrevPos()
    ELSEIF k = "v" THEN
        gotoLastFind()
    ELSEIF k = "w" THEN
        gAutoScroll = 0 - 1
        SPAWN autoScrollTick()
        gMessage = "Auto-scroll up (any key stops)"
    ELSEIF k = "z" THEN
        gAutoScroll = 1
        SPAWN autoScrollTick()
        gMessage = "Auto-scroll down (any key stops)"
    ELSEIF k = "delete" OR k = "backspace" THEN
        deleteToLineStart()
    ELSEIF digitOf(k) >= 0 THEN
        gotoPlaceMarker(digitOf(k))
    ELSE
        gMessage = "^Q" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' handlePrefixP — the ^P Print Controls menu (character attribute toggles).
SUB handlePrefixP(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "b" THEN
        insertMarker(2)
        gMessage = "Bold toggle inserted (^B)"
    ELSEIF k = "y" THEN
        insertMarker(25)
        gMessage = "Italic toggle inserted (^Y)"
    ELSEIF k = "s" THEN
        insertMarker(19)
        gMessage = "Underline toggle inserted (^S)"
    ELSEIF k = "x" THEN
        insertMarker(24)
        gMessage = "Strikeout toggle inserted (^X)"
    ELSEIF k = "d" THEN
        insertMarker(4)
        gMessage = "Double-strike toggle inserted (^D)"
    ELSEIF k = "t" THEN
        insertMarker(20)
        gMessage = "Superscript toggle inserted (^T)"
    ELSEIF k = "v" THEN
        insertMarker(22)
        gMessage = "Subscript toggle inserted (^V)"
    ELSE
        gMessage = "^P" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' isTabStop — is display column dc an explicit ruler tab stop?
FUNCTION isTabStop(dc AS INTEGER) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gTabStops) - 1
        IF gTabStops[i] = dc THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' nextTabStop — the next stop past curCol: nearest explicit stop, else the
' configured tab-width grid.
FUNCTION nextTabStop(curCol AS INTEGER) AS INTEGER
    DIM best AS INTEGER = 0 - 1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gTabStops) - 1
        IF gTabStops[i] > curCol AND (best < 0 OR gTabStops[i] < best) THEN best = gTabStops[i]
    NEXT i
    IF best >= 0 THEN RETURN best
    DIM tw AS INTEGER = gTabWidth
    IF tw < 1 THEN tw = 1
    RETURN curCol + (tw - (curCol MOD tw))
END FUNCTION

' setTabStop — ^OI: add a tab stop at the cursor's display column.
SUB setTabStop()
    DIM dc AS INTEGER = runeIndexOf(curLine(), gCol)
    IF NOT isTabStop(dc) THEN gTabStops = APPEND(gTabStops, dc)
    gMessage = fmt.Sprintf("Tab stop set at column %d", dc + 1)
END SUB

' clearTabStop — ^ON: remove the tab stop at the cursor's display column.
SUB clearTabStop()
    DIM dc AS INTEGER = runeIndexOf(curLine(), gCol)
    DIM out AS []INTEGER
    DIM removed AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gTabStops) - 1
        IF gTabStops[i] = dc THEN
            removed = TRUE
        ELSE
            out = APPEND(out, gTabStops[i])
        END IF
    NEXT i
    gTabStops = out
    IF removed THEN
        gMessage = fmt.Sprintf("Tab stop cleared at column %d", dc + 1)
    ELSE
        gMessage = "No tab stop at this column"
    END IF
END SUB

' handlePrefixO — the ^O Onscreen Format menu.
SUB handlePrefixO(key AS STRING)
    DIM k AS STRING = secondKey(key)
    IF k = "d" THEN
        gShowTags = NOT gShowTags
        gMessage = "Command tags display toggled"
    ELSEIF k = "i" THEN
        setTabStop()
    ELSEIF k = "n" THEN
        clearTabStop()
    ELSEIF k = "s" THEN
        gPromptMode = "linespacing"
        gPromptLabel = "Line spacing (1=single, 2=double): "
        gPromptText = ""
    ELSEIF k = "c" THEN
        centerLine()
    ELSEIF k = "j" THEN
        gJustify = NOT gJustify
        gMessage = "Justification toggled"
    ELSEIF k = "w" THEN
        cycleWrapMode()
        gMessage = "Word wrap: " + UCase(gWrapMode)
    ELSEIF k = "l" THEN
        gPromptMode = "lmargin"
        gPromptLabel = "Left margin: "
        gPromptText = ""
    ELSEIF k = "r" THEN
        gPromptMode = "rmargin"
        gPromptLabel = "Right margin: "
        gPromptText = ""
    ELSE
        gMessage = "^O" + UCase(k) + " — not in this build"
    END IF
    gPrefix = ""
END SUB

' handlePrompt — modal text entry on the message line (find / replace / etc).
SUB handlePrompt(key AS STRING)
    ' Per-match replace confirmation answers single keys, not typed text.
    IF gPromptMode = "confirmrepl" THEN
        handleConfirmRepl(key)
        RETURN
    END IF
    ' Spell-check and thesaurus prompts answer single keys too.
    IF gPromptMode = "spell" THEN
        handleSpellKey(key)
        RETURN
    END IF
    IF gPromptMode = "thes" THEN
        handleThesKey(key)
        RETURN
    END IF
    ' Delete confirmation answers a single Y/N.
    IF gPromptMode = "deleteconfirm" THEN
        gPromptMode = ""
        IF LCase(key) = "y" THEN
            doDeleteFile()
        ELSE
            gMessage = "Delete cancelled"
        END IF
        RETURN
    END IF
    IF key = "esc" THEN
        gPromptMode = ""
        gMessage = "Cancelled"
        RETURN
    END IF
    IF key = "enter" THEN
        DIM mode AS STRING = gPromptMode
        DIM txt AS STRING = gPromptText
        gPromptMode = ""
        IF mode = "find" THEN
            gFindStr = txt
            gPromptMode = "findopts"
            gPromptLabel = "Find options (W=word U=ignore-case B=back, Enter=none): "
            gPromptText = ""
        ELSEIF mode = "findopts" THEN
            parseFindOpts(txt)
            doFind()
        ELSEIF mode = "rfind" THEN
            gFindStr = txt
            gPromptMode = "rwith"
            gPromptLabel = "Replace with: "
            gPromptText = ""
        ELSEIF mode = "rwith" THEN
            gReplaceStr = txt
            gPromptMode = "replopts"
            gPromptLabel = "Replace options (W U B  N=all  G=global): "
            gPromptText = ""
        ELSEIF mode = "replopts" THEN
            parseFindOpts(txt)
            gReplNoConfirm = strings.Contains(LCase(txt), "n")
            IF strings.Contains(LCase(txt), "g") THEN
                gRow = 0
                gCol = 0
            END IF
            startReplace()
        ELSEIF mode = "saveas" THEN
            gFileName = txt
            gIsUnicode = detectUnicode(txt)
            saveFile()
        ELSEIF mode = "open" THEN
            IF txt <> "" THEN
                ' From the Opening Menu, resolve against the browsed directory.
                IF gMode = "open" THEN
                    loadFile(joinPath(gOpenDir, txt))
                ELSE
                    loadFile(txt)
                END IF
                gMode = "edit"
            END IF
        ELSEIF mode = "opendir" THEN
            IF txt <> "" THEN
                gOpenDir = txt
                refreshFileList()
            END IF
        ELSEIF mode = "renameto" THEN
            doRenameFile(txt)
        ELSEIF mode = "copyto" THEN
            doCopyFile(txt)
        ELSEIF mode = "blockwrite" THEN
            writeBlockToFile(txt)
        ELSEIF mode = "lmargin" THEN
            gLeftMargin = Int(Val(txt))
            gMessage = fmt.Sprintf("Left margin = %d", gLeftMargin)
        ELSEIF mode = "rmargin" THEN
            DIM rmv AS INTEGER = Int(Val(txt))
            IF rmv > 0 THEN gRightMargin = rmv
            gMessage = fmt.Sprintf("Right margin = %d", gRightMargin)
        ELSEIF mode = "insfile" THEN
            IF txt <> "" THEN doInsertFile(txt)
        ELSEIF mode = "insfn" THEN
            IF txt <> "" THEN insertDotLine(".fn " + txt, "Footnote inserted")
        ELSEIF mode = "insix" THEN
            IF txt <> "" THEN insertDotLine(".ix " + txt, "Index entry inserted")
        ELSEIF mode = "instc" THEN
            IF txt <> "" THEN insertDotLine(".tc " + txt, "Contents entry inserted")
        ELSEIF mode = "chdir" THEN
            IF txt <> "" THEN doChdir(txt)
        ELSEIF mode = "rundos" THEN
            doRunDos(txt)
        ELSEIF mode = "pagelen" THEN
            DIM pl AS INTEGER = Int(Val(txt))
            IF pl > 0 THEN gPageLength = pl
            gMessage = fmt.Sprintf("Page length = %d", gPageLength)
        ELSEIF mode = "calc" THEN
            doCalc(txt)
        ELSEIF mode = "goto" THEN
            doGoto(txt)
        ELSEIF mode = "cfg_lm" THEN
            gLeftMargin = Int(Val(txt))
        ELSEIF mode = "cfg_rm" THEN
            DIM crm AS INTEGER = Int(Val(txt))
            IF crm > 0 THEN gRightMargin = crm
        ELSEIF mode = "cfg_pl" THEN
            DIM cpl AS INTEGER = Int(Val(txt))
            IF cpl > 0 THEN gPageLength = cpl
        ELSEIF mode = "cfg_tw" THEN
            DIM ctw AS INTEGER = Int(Val(txt))
            IF ctw > 0 THEN gTabWidth = ctw
        ELSEIF mode = "cfg_sc" THEN
            DIM csc AS INTEGER = Int(Val(txt))
            IF csc > 0 THEN gStartCols = csc
        ELSEIF mode = "cfg_sr" THEN
            DIM csr AS INTEGER = Int(Val(txt))
            IF csr > 0 THEN gStartRows = csr
        ELSEIF mode = "cfg_dict" THEN
            IF txt <> "" THEN gDictPath = txt
        ELSEIF mode = "cfg_thes" THEN
            IF txt <> "" THEN gThesPath = txt
        ELSEIF mode = "cfg_printcmd" THEN
            gPrintCommand = txt
        ELSEIF mode = "linespacing" THEN
            DIM ls AS INTEGER = Int(Val(txt))
            IF ls < 1 THEN ls = 1
            gLineSpacing = ls
            gMessage = fmt.Sprintf("Line spacing = %d", gLineSpacing)
        ELSEIF mode = "repeatcount" THEN
            DIM rc AS INTEGER = Int(Val(txt))
            IF rc < 1 THEN rc = 1
            IF rc > 9999 THEN rc = 9999
            gRepeatNext = rc
            gMessage = fmt.Sprintf("Repeat next command %d times…", rc)
        ELSEIF mode = "spellrepl" THEN
            replaceSpellWord(txt)
        END IF
        RETURN
    END IF
    IF key = "backspace" OR key = "ctrl+h" THEN
        IF LEN(gPromptText) > 0 THEN gPromptText = Left(gPromptText, LEN(gPromptText) - 1)
        RETURN
    END IF
    IF key = "space" THEN
        gPromptText = gPromptText + " "
        RETURN
    END IF
    IF isTextKey(key) THEN gPromptText = gPromptText + key
END SUB

' Fired for every key press. StarWord owns the whole keyboard, so we
' ConsumeKey() on every key (this also lets ^C be page-down, not quit).
' altMenuIndex — map "alt+f"/"alt+e"/… to a menu index, else -1.
FUNCTION altMenuIndex(key AS STRING) AS INTEGER
    IF NOT strings.HasPrefix(key, "alt+") THEN RETURN 0 - 1
    DIM letter AS STRING = UCase(Right(key, LEN(key) - 4))
    DIM i AS INTEGER
    FOR i = 0 TO menuCount() - 1
        IF UCase(Left(menuTitle(i), 1)) = letter THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' handleMenuKey — navigate the open pull-down (arrows, Enter, hotkey letter,
' Alt+letter to switch menus, Esc to close).
SUB handleMenuKey(key AS STRING)
    DIM n AS INTEGER = LEN(menuItems(gMenuOpen))
    IF key = "esc" THEN
        gMenuOpen = 0 - 1
        RETURN
    END IF
    IF key = "up" THEN
        gMenuSel = (gMenuSel - 1 + n) MOD n
        RETURN
    END IF
    IF key = "down" THEN
        gMenuSel = (gMenuSel + 1) MOD n
        RETURN
    END IF
    IF key = "left" THEN
        gMenuOpen = (gMenuOpen - 1 + menuCount()) MOD menuCount()
        gMenuSel = 0
        RETURN
    END IF
    IF key = "right" THEN
        gMenuOpen = (gMenuOpen + 1) MOD menuCount()
        gMenuSel = 0
        RETURN
    END IF
    IF key = "enter" THEN
        doMenuItem(gMenuOpen, itemField(menuItems(gMenuOpen)[gMenuSel], 0))
        RETURN
    END IF
    ' Alt+letter switches directly to another menu.
    DIM am AS INTEGER = altMenuIndex(key)
    IF am >= 0 THEN
        gMenuOpen = am
        gMenuSel = 0
        RETURN
    END IF
    ' A bare letter selects the item with that hotkey.
    IF LEN(key) = 1 THEN
        DIM up AS STRING = UCase(key)
        DIM items AS []STRING = menuItems(gMenuOpen)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(items) - 1
            IF itemField(items[k], 0) = up THEN
                doMenuItem(gMenuOpen, up)
                RETURN
            END IF
        NEXT k
    END IF
END SUB

SUB Form_Key(key AS STRING)
    ConsumeKey()
    ' Promote the previous keystroke's edit into an undo step (if any), then
    ' record the key when a macro is being captured.
    reconcileUndo()
    IF gMacroRecording AND NOT gMacroPlaying THEN gMacroKeys = APPEND(gMacroKeys, key)
    gMessage = ""

    ' Any key stops continuous auto-scroll (^QW/^QZ).
    IF gAutoScroll <> 0 THEN
        gAutoScroll = 0
        gMessage = "Scroll stopped"
        RETURN
    END IF

    ' Print preview is a read-only overlay — arrows/PgUp/PgDn scroll, any
    ' other key (Esc) returns to the editor.
    IF gMode = "preview" THEN
        IF key = "up" OR key = "ctrl+e" THEN
            gPrevTop = gPrevTop - 1
        ELSEIF key = "down" OR key = "ctrl+x" THEN
            gPrevTop = gPrevTop + 1
        ELSEIF key = "pgup" OR key = "ctrl+r" THEN
            gPrevTop = gPrevTop - (gH - 2)
        ELSEIF key = "pgdown" OR key = "ctrl+c" THEN
            gPrevTop = gPrevTop + (gH - 2)
        ELSE
            gMode = "edit"
            gMessage = "Left preview"
        END IF
        IF gPrevTop < 0 THEN gPrevTop = 0
        RETURN
    END IF

    ' The on-screen calculator panel owns the keyboard while it is open.
    IF gCalcOpen THEN
        handleCalcWidget(key)
        RETURN
    END IF

    ' A modal prompt (find / save-as / open / margin) is answered first, in
    ' either screen mode.
    IF gPromptMode <> "" THEN
        handlePrompt(key)
        RETURN
    END IF

    ' ^QQ: replay the next keystroke N times.
    IF gRepeatNext > 0 THEN
        DIM rn AS INTEGER = gRepeatNext
        gRepeatNext = 0
        DIM ri AS INTEGER
        FOR ri = 1 TO rn
            Form_Key(key)
        NEXT ri
        RETURN
    END IF

    ' The Opening Menu owns the keyboard while it is showing.
    IF gMode = "open" THEN
        handleOpenKey(key)
        RETURN
    END IF

    ' The configuration (WSCHANGE) screen owns the keyboard while open.
    IF gMode = "config" THEN
        handleConfigKey(key)
        RETURN
    END IF

    ' An open pull-down menu is modal — it owns the keyboard.
    IF gMenuOpen >= 0 THEN
        handleMenuKey(key)
        RETURN
    END IF

    ' Alt+<letter> opens the matching pull-down (WordStar keybinding).
    DIM amOpen AS INTEGER = altMenuIndex(key)
    IF amOpen >= 0 THEN
        gMenuOpen = amOpen
        gMenuSel = 0
        RETURN
    END IF

    ' Modern clipboard chords (the WordStar ^K block ops still apply): cut,
    ' copy and paste through the OS clipboard.
    IF key = "ctrl+shift+c" THEN
        clipCopy()
        RETURN
    END IF
    IF key = "ctrl+shift+x" THEN
        clipCut()
        RETURN
    END IF
    IF key = "ctrl+shift+v" THEN
        clipPaste()
        RETURN
    END IF

    ' A pending prefix consumes the next key as its second key.
    IF gPrefix = "K" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixK(key)
        RETURN
    END IF
    IF gPrefix = "Q" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixQ(key)
        RETURN
    END IF
    IF gPrefix = "O" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixO(key)
        RETURN
    END IF
    IF gPrefix = "P" THEN
        IF key = "esc" THEN
            gPrefix = ""
            RETURN
        END IF
        handlePrefixP(key)
        RETURN
    END IF
    IF gPrefix = "J" THEN
        ' Help is informational; any key dismisses it.
        gPrefix = ""
        RETURN
    END IF

    ' --- prefixes ---
    IF key = "ctrl+k" THEN
        gPrefix = "K"
        RETURN
    END IF
    IF key = "ctrl+q" THEN
        gPrefix = "Q"
        RETURN
    END IF
    IF key = "ctrl+o" THEN
        gPrefix = "O"
        RETURN
    END IF
    IF key = "ctrl+p" THEN
        gPrefix = "P"
        RETURN
    END IF
    IF key = "ctrl+j" THEN
        gPrefix = "J"
        RETURN
    END IF

    ' --- scroll the view a line without moving far (^W up / ^Z down) ---
    IF key = "ctrl+w" THEN
        scrollView(0 - 1)
        RETURN
    END IF
    IF key = "ctrl+z" THEN
        scrollView(1)
        RETURN
    END IF

    ' --- cursor diamond + arrows ---
    IF key = "ctrl+e" OR key = "up" THEN
        moveUp()
        RETURN
    END IF
    IF key = "ctrl+x" OR key = "down" THEN
        moveDown()
        RETURN
    END IF
    IF key = "ctrl+s" OR key = "left" THEN
        moveLeft()
        RETURN
    END IF
    IF key = "ctrl+d" OR key = "right" THEN
        moveRight()
        RETURN
    END IF
    IF key = "ctrl+a" THEN
        wordLeft()
        RETURN
    END IF
    IF key = "ctrl+f" THEN
        wordRight()
        RETURN
    END IF
    IF key = "ctrl+r" OR key = "pgup" THEN
        pageUp()
        RETURN
    END IF
    IF key = "ctrl+c" OR key = "pgdown" THEN
        pageDown()
        RETURN
    END IF
    IF key = "home" THEN
        IF softWrapOn() THEN
            DIM hsegs AS []INTEGER = wrapSegments(curLine(), wrapWidth())
            gCol = hsegs[segIndexOf(hsegs, gCol)]
        ELSE
            gCol = 0
        END IF
        RETURN
    END IF
    IF key = "end" THEN
        IF softWrapOn() THEN
            DIM esegs AS []INTEGER = wrapSegments(curLine(), wrapWidth())
            DIM esi AS INTEGER = segIndexOf(esegs, gCol)
            IF esi + 1 < LEN(esegs) THEN
                gCol = esegs[esi + 1]
            ELSE
                gCol = LEN(curLine())
            END IF
        ELSE
            gCol = LEN(curLine())
        END IF
        RETURN
    END IF

    ' --- editing ---
    IF key = "ctrl+g" OR key = "delete" THEN
        deleteCharAt()
        RETURN
    END IF
    IF key = "backspace" OR key = "ctrl+h" THEN
        deleteCharLeft()
        RETURN
    END IF
    IF key = "ctrl+t" THEN
        deleteWordRight()
        RETURN
    END IF
    IF key = "ctrl+y" THEN
        deleteLine()
        RETURN
    END IF
    IF key = "ctrl+n" THEN
        insertBlankLine()
        RETURN
    END IF
    IF key = "ctrl+v" THEN
        gInsert = NOT gInsert
        RETURN
    END IF
    IF key = "ctrl+l" THEN
        doFindNext()
        RETURN
    END IF
    IF key = "ctrl+b" THEN
        reformatParagraph()
        RETURN
    END IF
    IF key = "enter" THEN
        splitLine()
        RETURN
    END IF
    IF key = "tab" OR key = "ctrl+i" THEN
        ' Advance to the next explicit ruler tab stop past the cursor; if none,
        ' fall back to the configured tab-width grid.
        DIM curCol AS INTEGER = runeIndexOf(curLine(), gCol)
        DIM target AS INTEGER = nextTabStop(curCol)
        DIM ti AS INTEGER
        FOR ti = curCol + 1 TO target
            insertChar(" ")
        NEXT ti
        RETURN
    END IF
    IF key = "esc" THEN
        gMessage = ""
        RETURN
    END IF

    ' --- text entry (printable chars, incl. multibyte Unicode runes) ---
    IF key = "space" THEN
        insertChar(" ")
        wrapInsertIfNeeded()
        RETURN
    END IF
    IF isTextKey(key) THEN
        insertChar(key)
        wrapInsertIfNeeded()
    END IF
END SUB

' printUsage — the command-line help shown by -h / /? (WordStar-style).
SUB printUsage()
    fmt.Println("StarWord — a modern WordStar 7.0 clone")
    fmt.Println("")
    fmt.Println("Usage: starword [options] [file]")
    fmt.Println("")
    fmt.Println("  With no file, StarWord opens at the WordStar Opening Menu.")
    fmt.Println("")
    fmt.Println("Options (DOS /X switches and -/-- flags both accepted):")
    fmt.Println("  /D  -d  --document      open in document mode (word-wrap, justify) [default]")
    fmt.Println("  /N  -n  --nondocument   open in non-document mode (plain text: no wrap,")
    fmt.Println("                          no justify, dot commands left as literal text)")
    fmt.Println("  /P  -p  --print         print a clean copy of the file to stdout and exit")
    fmt.Println("  /M  -m  --merge         MailMerge the file (.df/.rv/&var&) to stdout and exit")
    fmt.Println("  /C  -c  --config        open the configuration (WSCHANGE) screen")
    fmt.Println("  /?  -h  --help          show this help and exit")
END SUB

' printDocToStdout — emit a copy of the loaded file (for -p): document mode
' paginates with headers/footers/page numbers; non-document mode is literal.
SUB printDocToStdout()
    DIM i AS INTEGER
    IF gNonDocument THEN
        FOR i = 0 TO lastRow()
            fmt.Println(gLines[i])
        NEXT i
        RETURN
    END IF
    applyDotCommands()
    DIM lines AS []STRING = buildPaginated(FALSE)
    FOR i = 0 TO LEN(lines) - 1
        fmt.Println(lines[i])
    NEXT i
END SUB

' Fired once at startup — parse WordStar-style command-line arguments, then
' open the named file (or the Opening Menu when none is given).
SUB Form_Load()
    ' Place markers 0..9 start unset.
    DIM mi AS INTEGER
    FOR mi = 0 TO 9
        gMarkRow = APPEND(gMarkRow, 0 - 1)
        gMarkCol = APPEND(gMarkCol, 0)
    NEXT mi
    ' Load persisted settings first; CLI flags below can still override them.
    loadConfig()
    DIM args AS []STRING = os.Args
    DIM fileArg AS STRING = ""
    DIM wantHelp AS BOOLEAN = FALSE
    DIM wantPrint AS BOOLEAN = FALSE
    DIM wantMerge AS BOOLEAN = FALSE
    DIM wantConfig AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 1 TO LEN(args) - 1
        DIM a AS STRING = args[i]
        DIM lo AS STRING = LCase(a)
        IF a = "/?" OR lo = "-h" OR lo = "/h" OR lo = "--help" THEN
            wantHelp = TRUE
        ELSEIF lo = "-n" OR lo = "/n" OR lo = "--nondocument" OR lo = "--nondoc" THEN
            gNonDocument = TRUE
        ELSEIF lo = "-d" OR lo = "/d" OR lo = "--document" OR lo = "--doc" THEN
            gNonDocument = FALSE
        ELSEIF lo = "-p" OR lo = "/p" OR lo = "--print" THEN
            wantPrint = TRUE
        ELSEIF lo = "-m" OR lo = "/m" OR lo = "--merge" THEN
            wantMerge = TRUE
        ELSEIF lo = "-c" OR lo = "/c" OR lo = "--config" THEN
            wantConfig = TRUE
        ELSEIF Left(a, 1) = "-" OR (Left(a, 1) = "/" AND LEN(a) = 2) THEN
            ' Unknown switch — ignore so a stray flag can't block startup.
            ' (A "/" token longer than 2 chars is a Unix absolute path, below.)
        ELSEIF fileArg = "" THEN
            fileArg = a
        END IF
    NEXT i

    IF wantHelp THEN
        printUsage()
        os.Exit(0)
    END IF

    ' Non-document mode turns off the document-formatting machinery.
    IF gNonDocument THEN
        gWordWrap = FALSE
        gJustify = FALSE
        gLeftMargin = 0
    END IF

    IF wantPrint THEN
        IF fileArg = "" THEN
            fmt.Println("starword: -p/--print needs a filename")
            os.Exit(2)
        END IF
        loadFile(fileArg)
        printDocToStdout()
        os.Exit(0)
    END IF

    IF wantMerge THEN
        IF fileArg = "" THEN
            fmt.Println("starword: -m/--merge needs a filename")
            os.Exit(2)
        END IF
        loadFile(fileArg)
        DIM mlines AS []STRING = mergePrintLines()
        IF LEN(mlines) = 0 THEN
            fmt.Println("starword: no .df data file / no records to merge")
            os.Exit(2)
        END IF
        DIM mi2 AS INTEGER
        FOR mi2 = 0 TO LEN(mlines) - 1
            fmt.Println(mlines[mi2])
        NEXT mi2
        os.Exit(0)
    END IF

    IF fileArg <> "" THEN
        loadFile(fileArg)
        gMode = "edit"
    ELSE
        ' No file given: start at the WordStar-style Opening Menu.
        gLines = APPEND(gLines, "")
        enterOpeningMenu()
    END IF
    ' --config jumps straight into the WSCHANGE-style settings screen.
    IF wantConfig THEN
        gMode = "edit"
        enterConfig()
        gCfgReturn = "edit"
    END IF
    syncUndoBaseline()
END SUB

' Fired on terminal resize — show the size popup and (re)arm the timer that
' hides it shortly after resizing stops. sw_Render re-clamps to the new size.
SUB Terminal_Resize(w AS INTEGER, h AS INTEGER)
    _ = w
    _ = h
    gResizeShow = TRUE
    gResizeGen = gResizeGen + 1
    SPAWN resizePopupTimer(gResizeGen)
END SUB

' resizePopupTimer — hide the size popup ~1.2s after the last resize. Each
' resize bumps gResizeGen, so only the most recent timer actually hides it.
SUB resizePopupTimer(gen AS INTEGER)
    time.Sleep(1200 * time.Millisecond)
    IF gen = gResizeGen THEN
        gResizeShow = FALSE
        _dbtuiWake()
    END IF
END SUB

' Fired just before the program quits.
SUB Form_Close()
    ' Nothing to flush — saving is explicit (^KS/^KX).
END SUB

' Fired on the UI thread after a background goroutine calls _dbtuiWake().
SUB Form_Wake()
    ' Auto-scroll (^QW/^QZ) advances the view on each wake until a key stops it.
    IF gAutoScroll <> 0 THEN scrollView(gAutoScroll)
END SUB

' scrollView — mouse-wheel scroll by `delta` rows. The view is coupled to the
' cursor, so we move the cursor just enough to stay in the new viewport (the
' text scrolls, the cursor rides the edge). Works in soft and hard/off modes.
SUB scrollView(delta AS INTEGER)
    DIM txRows AS INTEGER = gH - 4
    IF txRows < 1 THEN txRows = 1
    IF softWrapOn() THEN
        gTopVis = gTopVis + delta
        IF gTopVis < 0 THEN gTopVis = 0
        DIM maxv AS INTEGER = LEN(gVisLine) - 1
        IF maxv < 0 THEN maxv = 0
        IF gTopVis > maxv THEN gTopVis = maxv
        DIM cvr AS INTEGER = cursorVisRow()
        IF (cvr < gTopVis OR cvr >= gTopVis + txRows) AND gTopVis < LEN(gVisLine) THEN
            gRow = gVisLine[gTopVis]
            gCol = gVisStart[gTopVis]
        END IF
    ELSE
        gTop = gTop + delta
        IF gTop < 0 THEN gTop = 0
        IF gTop > lastRow() THEN gTop = lastRow()
        IF gRow < gTop THEN gRow = gTop
        IF gRow >= gTop + txRows THEN gRow = gTop + txRows - 1
        IF gRow > lastRow() THEN gRow = lastRow()
    END IF
END SUB

' Fired for every mouse event. Clicks are routed to sw_Click (cursor / menu
' selection); MOTION drives the pull-down menus by HOVER; WHEEL scrolls.
SUB Form_Mouse(kind AS STRING, button AS STRING, x AS INTEGER, y AS INTEGER)
    ' Mouse wheel: scroll the text (3 rows), the preview, or the file list.
    IF kind = "wheel" THEN
        DIM dir AS INTEGER = 1
        IF button = "up" THEN dir = 0 - 1
        IF gMode = "preview" THEN
            gPrevTop = gPrevTop + dir
            IF gPrevTop < 0 THEN gPrevTop = 0
        ELSEIF gMode = "open" THEN
            gOpenSel = gOpenSel + dir
            IF gOpenSel < 0 THEN gOpenSel = 0
            IF gOpenSel > LEN(gOpenFiles) - 1 THEN gOpenSel = LEN(gOpenFiles) - 1
        ELSEIF gMode = "edit" AND gPromptMode = "" AND gMenuOpen < 0 THEN
            scrollView(dir)
        END IF
        RETURN
    END IF
    _ = button
    IF kind <> "motion" THEN RETURN
    ' Terminal cells -> canvas-local (canvas origin is at (1,1)).
    DIM lx AS INTEGER = x - 1
    DIM ly AS INTEGER = y - 1

    ' Hovering the menu bar (canvas row 0) opens / switches to that menu.
    IF ly = 0 THEN
        DIM mhit AS INTEGER = menuAtX(lx)
        IF mhit >= 0 THEN
            gMenuOpen = mhit
            gMenuSel = 0
        END IF
        RETURN
    END IF

    ' With a menu open: hovering an item highlights it; moving down into the
    ' document (below the status/ruler, outside the box) closes the menu.
    IF gMenuOpen >= 0 THEN
        DIM inner AS INTEGER = menuBoxWidth(gMenuOpen)
        DIM boxW AS INTEGER = inner + 4
        DIM boxX AS INTEGER = menuTitleX(gMenuOpen)
        IF boxX + boxW > gW THEN boxX = gW - boxW
        IF boxX < 0 THEN boxX = 0
        DIM nItems AS INTEGER = LEN(menuItems(gMenuOpen))
        DIM inBox AS BOOLEAN = lx >= boxX AND lx < boxX + boxW AND ly >= 2 AND ly <= 1 + nItems
        IF inBox THEN
            gMenuSel = ly - 2
        ELSEIF ly >= 3 THEN
            gMenuOpen = 0 - 1
        END IF
    END IF
END SUB
