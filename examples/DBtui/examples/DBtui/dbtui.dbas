' =========================================================================
' DBtui — self-hosted IDE for DBasic, written in DBasic.
' =========================================================================
'
' Path B: written the way the original DBtui is written — as a Charm
' bubbletea Model / Update / View triple. lipgloss.JoinHorizontal /
' JoinVertical compose layout; reflow on terminal resize is automatic.
'
' Layout (mirroring the original):
'
'    File  Edit  View  Run  Help                                <- menubar
'   ╭─ Project ──╮ ─[ Editor caption ]──── [ Widgets ] [ Tools ]
'   │ tree       │ middle pane              │ widgets list      │
'   │            │ (form designer or        │                   │
'   │            │  code editor)            ├─ Properties ──────┤
'   │            │                          │ property grid     │
'   ╰────────────╯                          ╰───────────────────╯
'    DBtui — F10:Menu  F5:Run  ...                              <- statusbar

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "charm.land/bubbles/v2/textarea" AS textarea
IMPORT "charm.land/bubbles/v2/textinput" AS textinput
IMPORT "charm.land/lipgloss/v2" AS lipgloss
IMPORT "fmt"
IMPORT "os"
IMPORT "os/exec" AS osexec
IMPORT "strconv"
IMPORT "strings"

' -------------------------------------------------------------------------
' Theme — Tokyo-Night-ish palette borrowed from the original DBtui.
' -------------------------------------------------------------------------

CONST cBg        AS STRING = "#1a1b2e"   ' deep indigo background
CONST cFg        AS STRING = "#e0def4"   ' soft lavender text
CONST cAccent    AS STRING = "#7dcfff"   ' bright sky-blue (titles, accents)
CONST cBorder    AS STRING = "#3b3d5e"   ' muted panel borders
CONST cMenuBg    AS STRING = "#24273a"   ' menubar / status bar background
CONST cMenuFg    AS STRING = "#cad3f5"   ' menubar text
CONST cStatusFg  AS STRING = "#8087a2"   ' statusbar text (dimmer)
CONST cHotkey    AS STRING = "#f5a97f"   ' warm peach for hotkey letters

' -------------------------------------------------------------------------
' Tree model. The project tree on the left is a flat list of "visible"
' nodes — i.e. the result of walking the filesystem and skipping every
' child whose parent folder isn't currently expanded. Whenever the user
' expands or collapses a folder we just rebuild this flat list.
'
' Expanded paths are tracked in a separate parallel list; treating them
' as a set keeps the recursive walk simple (membership check at each
' folder).
' -------------------------------------------------------------------------

TYPE TreeNode
    DIM Path   AS STRING                 ' relative path from project root
    DIM Name   AS STRING                 ' display name (basename only)
    DIM Depth  AS INTEGER                ' indent level (0 = root)
    DIM IsDir  AS BOOLEAN
END TYPE

' -------------------------------------------------------------------------
' Menubar data model.
'
' A MenuDef is one top-level cell on the menu bar: "(F)ile", "(E)dit",
' etc. Each holds a list of MenuItem entries. An item with IsSep=TRUE
' renders as a horizontal separator inside the dropdown.
'
' The Label string uses the "(X)" convention to mark the hotkey letter
' that activates the menu / item — Alt+letter for top-level, plain
' letter (when the dropdown is already open) for items.
' -------------------------------------------------------------------------

TYPE MenuItem
    DIM Label  AS STRING                 ' "(S)ave"  or "─" for separator
    DIM Action AS STRING                 ' "file.save", "" for separators
    DIM IsSep  AS BOOLEAN
END TYPE

TYPE MenuDef
    DIM Label AS STRING                  ' "(F)ile"
    DIM Items AS []MenuItem
END TYPE

' -------------------------------------------------------------------------
' Tab — one open file in the code editor. Each tab owns its own
' textarea so switching tabs preserves cursor, selection, scroll
' position. Dirty is per-tab so the * marker is per-buffer.
' -------------------------------------------------------------------------

TYPE Tab
    DIM Path   AS STRING                 ' file path on disk
    DIM Editor AS textarea.Model         ' per-tab editor state
    DIM Dirty  AS BOOLEAN                ' buffer differs from disk
END TYPE

' -------------------------------------------------------------------------
' Model — the entire IDE state lives here.
' -------------------------------------------------------------------------

TYPE Model
    DIM Width   AS INTEGER               ' terminal width  (WindowSizeMsg)
    DIM Height  AS INTEGER               ' terminal height (WindowSizeMsg)
    DIM Status  AS STRING                ' message shown in the status bar

    ' Project tree state.
    DIM TreeRoot     AS STRING           ' filesystem root for the tree
    DIM TreeExpanded AS []STRING         ' paths the user has opened
    DIM TreeNodes    AS []TreeNode       ' flattened visible-node list
    DIM TreeSelected AS INTEGER          ' cursor index into TreeNodes
    DIM TreeOffset   AS INTEGER          ' vertical scroll offset

    ' Middle pane state.
    '
    ' ViewMode = "form" → form-designer placeholder; "code" → tabbed
    ' code editor. F7 flips between the two.
    '
    ' Tabs is the open-file list; TabIdx is the active tab (or -1 if
    ' no files are open yet). openFile pushes a new tab — or activates
    ' an existing one if the path is already present. closeTab pulls
    ' tabs out; when the last tab closes we fall back to form mode.
    DIM ViewMode AS STRING               ' "form" or "code"
    DIM Tabs     AS []Tab                ' open files
    DIM TabIdx   AS INTEGER              ' active tab; -1 = none

    ' Menubar state.
    DIM Menus       AS []MenuDef         ' definitions built once at startup
    DIM MenuActive  AS INTEGER           ' -1 = closed; else top-menu index
    DIM MenuItemIdx AS INTEGER           ' cursor inside the open dropdown

    ' Focused pane — which panel "owns" the keyboard right now. Valid
    ' values: "tree" or "editor". Tab/Shift+Tab cycles between them;
    ' clicks on a pane re-focus it. The focused pane gets a sharper
    ' border (titledBox(..., focused=TRUE)) and, for the editor,
    ' the textarea's blinking cursor.
    DIM FocusedPane AS STRING

    ' Mouse hover position, in screen cells, updated on every
    ' MouseMotionMsg. -1 means "no hover" (e.g. before any motion
    ' has been received). Hit-test helpers consume HoverX/HoverY
    ' to restyle the row / cell currently under the pointer.
    DIM HoverX AS INTEGER
    DIM HoverY AS INTEGER

    ' Last find query — F3 repeats it from the current cursor.
    DIM FindQuery AS STRING

    ' "Loading <path>" message shown while an async file load is in
    ' flight. Cleared when the LoadFinishedMsg lands. Empty string =
    ' no load in progress.
    DIM Loading AS STRING

    ' Bottom output pane — captures `dbasic check` / `run` output
    ' persistently instead of one-shot modals. F12 toggles
    ' visibility; auto-shows when something fails.
    DIM BottomVisible AS BOOLEAN
    DIM BottomTitle   AS STRING
    DIM BottomBody    AS STRING

    ' Splitter widths — left tree column and right widgets column,
    ' both resizable via mouse drag on the splitter column or via
    ' Alt+←/→ (left) and Alt+Shift+←/→ (right). Clamped so the
    ' middle pane never falls below 20 cells.
    DIM LeftW  AS INTEGER
    DIM RightW AS INTEGER

    ' Drag tracking. DragMode is "" (idle), "splitL" (left splitter
    ' is being dragged), or "splitR" (right splitter). When non-empty,
    ' MouseMotionMsg updates the corresponding width.
    DIM DragMode AS STRING

    ' Cached textarea.View() output. Re-rendering the editor is the
    ' single most expensive thing View() does, and bubbletea calls
    ' View() after every Update — including every mouse-motion
    ' event. Caching the output and only refreshing it when the
    ' editor's state actually changed makes hover feel snappy.
    DIM EditorCacheView AS STRING
    DIM EditorCacheW    AS INTEGER
    DIM EditorCacheH    AS INTEGER
    DIM EditorCacheDirty AS BOOLEAN

    ' Generic modal dialog state. Two flavours:
    '   • button modal  → ModalIsInput=FALSE; user picks one of
    '     ModalButtons via arrows + Enter.
    '   • input modal   → ModalIsInput=TRUE;  user types into
    '     ModalInput (a bubbles textinput) and commits with Enter.
    ' ModalContext tells dispatchModalClose what was being asked so
    ' the same handler can serve several dialog kinds.
    DIM ModalActive  AS BOOLEAN
    DIM ModalTitle   AS STRING
    DIM ModalMessage AS STRING
    DIM ModalButtons AS []STRING
    DIM ModalIdx     AS INTEGER
    DIM ModalContext AS STRING
    DIM ModalIsInput AS BOOLEAN
    DIM ModalInput   AS textinput.Model
END TYPE

' setExpanded — toggle whether `path` is in the TreeExpanded "set".
' Adds the path if it isn't there yet; removes it if it is. The set
' is just a list because the typical number of expanded folders is
' tiny so a linear scan is fine.
SUB setExpanded(m AS POINTER TO Model, path AS STRING, on AS BOOLEAN)
    DIM newList AS []STRING
    DIM found   AS BOOLEAN = FALSE
    DIM i       AS INTEGER
    FOR i = 0 TO LEN(m.TreeExpanded) - 1
        IF m.TreeExpanded[i] = path THEN
            found = TRUE
            ' Skip — we'll re-add below only when `on` is TRUE.
        ELSE
            newList = APPEND(newList, m.TreeExpanded[i])
        END IF
    NEXT i
    IF on THEN newList = APPEND(newList, path)
    _ = found
    m.TreeExpanded = newList
END SUB

' isExpanded — TRUE when the path is currently expanded.
FUNCTION isExpanded(m AS Model, path AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.TreeExpanded) - 1
        IF m.TreeExpanded[i] = path THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' joinPath — small "a"+"/"+"b" helper. Avoids filepath.Join because
' "Base"/"Dir"/etc. are reserved DBasic identifiers.
FUNCTION joinPath(a AS STRING, b AS STRING) AS STRING
    IF a = "" THEN RETURN b
    IF b = "" THEN RETURN a
    IF strings.HasSuffix(a, "/") THEN RETURN a + b
    RETURN a + "/" + b
END FUNCTION

' walkInto — recursive worker for buildTreeNodes. Appends every visible
' descendant of `dir` to `out` at the given depth. Dotfiles are skipped
' (no need to look at .git or editor backups in the tree).
SUB walkInto(m AS Model, out AS POINTER TO []TreeNode, dir AS STRING, depth AS INTEGER)
    DIM entries AS []os.DirEntry
    DIM err     AS ERROR
    entries, err = os.ReadDir(dir)
    IF err <> NIL THEN RETURN

    ' Two passes so directories appear before files at each level.
    DIM i AS INTEGER
    FOR i = 0 TO LEN(entries) - 1
        DIM nm AS STRING = entries[i].Name()
        IF strings.HasPrefix(nm, ".") THEN
            ' dotfile — skip
        ELSEIF entries[i].IsDir() THEN
            DIM child AS TreeNode
            child.Path  = joinPath(dir, nm)
            child.Name  = nm
            child.Depth = depth
            child.IsDir = TRUE
            ^out = APPEND(^out, child)
            ' Recurse only when the folder is expanded.
            IF isExpanded(m, child.Path) THEN
                walkInto(m, out, child.Path, depth + 1)
            END IF
        END IF
    NEXT i
    FOR i = 0 TO LEN(entries) - 1
        DIM nm2 AS STRING = entries[i].Name()
        IF NOT strings.HasPrefix(nm2, ".") AND NOT entries[i].IsDir() THEN
            DIM file AS TreeNode
            file.Path  = joinPath(dir, nm2)
            file.Name  = nm2
            file.Depth = depth
            file.IsDir = FALSE
            ^out = APPEND(^out, file)
        END IF
    NEXT i
END SUB

' buildTreeNodes — rebuild m.TreeNodes from the current expansion set.
' Always includes a root node at depth 0 representing the project
' directory itself (always "expanded" — it's just a visual anchor).
SUB buildTreeNodes(m AS POINTER TO Model)
    DIM nodes AS []TreeNode
    ' Root row: always shown, always treated as expanded.
    DIM root AS TreeNode
    root.Path  = m.TreeRoot
    root.Name  = baseName(m.TreeRoot) + "/"
    root.Depth = 0
    root.IsDir = TRUE
    nodes = APPEND(nodes, root)
    walkInto(^m, @nodes, m.TreeRoot, 1)
    m.TreeNodes = nodes
END SUB

' treeInnerH — number of rows the tree body has room to draw. View()
' uses bodyH = m.Height - 2 for the left pane, and titledBox eats two
' more rows (top title + bottom border), so the tree body is height-4.
' Floor at 1 so the math never goes negative when the window is tiny.
FUNCTION treeInnerH(m AS Model) AS INTEGER
    DIM h AS INTEGER = m.Height - 4
    IF h < 1 THEN h = 1
    RETURN h
END FUNCTION

' ensureSelectedVisible — slide TreeOffset so TreeSelected stays
' inside the visible window. Called from every nav action that
' moves the cursor (arrow keys, click, expand-rebuild). The two
' branches handle "cursor scrolled off the top" vs "off the bottom".
SUB ensureSelectedVisible(m AS POINTER TO Model)
    DIM innerH AS INTEGER = treeInnerH(^m)
    IF m.TreeSelected < m.TreeOffset THEN
        m.TreeOffset = m.TreeSelected
    ELSEIF m.TreeSelected >= m.TreeOffset + innerH THEN
        m.TreeOffset = m.TreeSelected - innerH + 1
    END IF
    IF m.TreeOffset < 0 THEN m.TreeOffset = 0
END SUB

' clampTreeOffset — used by the wheel-scroll path so the offset
' never runs past the end of the node list. Doesn't move the
' cursor — wheel scroll is independent of selection.
SUB clampTreeOffset(m AS POINTER TO Model)
    DIM maxOff AS INTEGER = LEN(m.TreeNodes) - treeInnerH(^m)
    IF maxOff < 0 THEN maxOff = 0
    IF m.TreeOffset > maxOff THEN m.TreeOffset = maxOff
    IF m.TreeOffset < 0 THEN m.TreeOffset = 0
END SUB

' baseName — last "/"-separated segment of a path. "examples/dbtui"
' returns "dbtui". Used for the tree root row's display name.
FUNCTION baseName(p AS STRING) AS STRING
    IF p = "" OR p = "." THEN RETURN "project"
    DIM idx AS INTEGER = strings.LastIndex(p, "/")
    IF idx < 0 THEN RETURN p
    RETURN Mid(p, idx + 2, LEN(p) - idx - 1)
END FUNCTION

' mkItem / mkSep — small constructors so the menu definition reads as
' a flat list of `APPEND` calls instead of nested struct literals.
FUNCTION mkItem(label AS STRING, action AS STRING) AS MenuItem
    DIM it AS MenuItem
    it.Label = label
    it.Action = action
    it.IsSep = FALSE
    RETURN it
END FUNCTION

FUNCTION mkSep() AS MenuItem
    DIM it AS MenuItem
    it.IsSep = TRUE
    RETURN it
END FUNCTION

FUNCTION mkMenu(label AS STRING, items AS []MenuItem) AS MenuDef
    DIM md AS MenuDef
    md.Label = label
    md.Items = items
    RETURN md
END FUNCTION

' buildMenus — define the menubar's contents. The "(X)" letters mark
' the hotkey for each menu/item. Actions are dispatched in dispatchAction.
FUNCTION buildMenus() AS []MenuDef
    DIM menus AS []MenuDef
    DIM fileItems AS []MenuItem
    fileItems = APPEND(fileItems, mkItem("(N)ew         Ctrl+N", "file.new"))
    fileItems = APPEND(fileItems, mkItem("(O)pen        Ctrl+O", "file.open"))
    fileItems = APPEND(fileItems, mkSep())
    fileItems = APPEND(fileItems, mkItem("(S)ave        Ctrl+S", "file.save"))
    fileItems = APPEND(fileItems, mkItem("Save (A)s          ", "file.saveas"))
    fileItems = APPEND(fileItems, mkSep())
    fileItems = APPEND(fileItems, mkItem("(C)lose       Ctrl+W", "file.close"))
    fileItems = APPEND(fileItems, mkItem("(Q)uit             q", "file.quit"))
    menus = APPEND(menus, mkMenu("(F)ile", fileItems))

    DIM viewItems AS []MenuItem
    viewItems = APPEND(viewItems, mkItem("(F)orm Designer  F7", "view.form"))
    viewItems = APPEND(viewItems, mkItem("(C)ode Editor    F7", "view.code"))
    menus = APPEND(menus, mkMenu("(V)iew", viewItems))

    DIM runItems AS []MenuItem
    runItems = APPEND(runItems, mkItem("(R)un             F5", "run.run"))
    runItems = APPEND(runItems, mkItem("(C)heck           F8", "run.check"))
    menus = APPEND(menus, mkMenu("(R)un", runItems))

    DIM helpItems AS []MenuItem
    helpItems = APPEND(helpItems, mkItem("(A)bout", "help.about"))
    helpItems = APPEND(helpItems, mkItem("(K)eys",  "help.keys"))
    menus = APPEND(menus, mkMenu("(H)elp", helpItems))
    RETURN menus
END FUNCTION

' menuHotkey — extract the lowercased "(X)" letter from a label.
' Returns "" if the label has no hotkey marker.
FUNCTION menuHotkey(label AS STRING) AS STRING
    DIM i AS INTEGER = strings.Index(label, "(")
    IF i < 0 OR i + 2 >= LEN(label) THEN RETURN ""
    IF Mid(label, i + 3, 1) <> ")" THEN RETURN ""
    RETURN strings.ToLower(Mid(label, i + 2, 1))
END FUNCTION

' menuStrip — strip the parens from a label, leaving the visible text.
' "(F)ile" → "File".
FUNCTION menuStrip(label AS STRING) AS STRING
    DIM i AS INTEGER = strings.Index(label, "(")
    IF i < 0 OR i + 2 >= LEN(label) THEN RETURN label
    IF Mid(label, i + 3, 1) <> ")" THEN RETURN label
    DIM pre AS STRING = ""
    IF i > 0 THEN pre = Mid(label, 1, i)
    DIM letter AS STRING = Mid(label, i + 2, 1)
    DIM post AS STRING = ""
    IF i + 3 < LEN(label) THEN post = Mid(label, i + 4, LEN(label) - i - 3)
    RETURN pre + letter + post
END FUNCTION

' -------------------------------------------------------------------------
' Tab helpers.
' -------------------------------------------------------------------------

' hasActiveTab — TRUE when there's at least one open file AND TabIdx
' points to a valid entry. All editor operations gate on this.
FUNCTION hasActiveTab(m AS Model) AS BOOLEAN
    IF m.TabIdx < 0 OR m.TabIdx >= LEN(m.Tabs) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' findTabIdx — return the index of the tab whose Path matches `path`,
' or -1 if no such tab is open. Used by openFile to avoid duplicate
' tabs when the user clicks the same file twice.
FUNCTION findTabIdx(m AS Model, path AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[i].Path = path THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' switchToTab — make tab `idx` active. Focuses its editor when the
' editor pane is already the focused one; otherwise just swaps the
' active buffer (leaves cursor in tree). No-op if idx is out of range.
SUB switchToTab(m AS POINTER TO Model, idx AS INTEGER)
    IF idx < 0 OR idx >= LEN(m.Tabs) THEN RETURN
    ' Blur the previous tab's editor so only one shows a cursor.
    IF hasActiveTab(^m) AND m.TabIdx <> idx THEN
        m.Tabs[m.TabIdx].Editor.Blur()
    END IF
    m.TabIdx = idx
    IF m.FocusedPane = "editor" AND m.ViewMode = "code" THEN
        DIM fcmd AS tea.Cmd = m.Tabs[m.TabIdx].Editor.Focus()
        _ = fcmd
    END IF
    invalidateEditorCache(m)
END SUB

' closeTab — drop tab `idx` from the list. Adjusts TabIdx so it still
' references something sensible, and flips back to form mode when the
' last tab is gone. Caller is responsible for any "are you sure"
' confirmation on a dirty buffer.
SUB closeTab(m AS POINTER TO Model, idx AS INTEGER)
    IF idx < 0 OR idx >= LEN(m.Tabs) THEN RETURN
    DIM keep AS []Tab
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        IF i <> idx THEN keep = APPEND(keep, m.Tabs[i])
    NEXT i
    m.Tabs = keep
    IF LEN(m.Tabs) = 0 THEN
        ' Nothing left — drop back to the form-designer placeholder
        ' and refocus the tree (since there's no editor to land in).
        m.TabIdx = 0 - 1
        m.ViewMode = "form"
        setFocus(m, "tree")
        m.Status = "all files closed"
        RETURN
    END IF
    ' Clamp the active index. Prefer staying near the closed tab.
    IF m.TabIdx >= LEN(m.Tabs) THEN m.TabIdx = LEN(m.Tabs) - 1
    IF m.FocusedPane = "editor" AND m.ViewMode = "code" THEN
        DIM fcmd AS tea.Cmd = m.Tabs[m.TabIdx].Editor.Focus()
        _ = fcmd
    END IF
    invalidateEditorCache(m)
END SUB

' invalidateEditorCache — flag the cached editor view as stale so
' the next render rebuilds it. Called from anywhere the editor's
' state could have changed (typing, tab switch, focus, file
' open/close, find/goto cursor jumps, window resize).
SUB invalidateEditorCache(m AS POINTER TO Model)
    m.EditorCacheDirty = TRUE
END SUB

' refreshEditorCache — re-render the active tab's textarea into
' the cache at the given pane dimensions. Cheap to call repeatedly:
' returns immediately when the cache is already fresh AND sized
' for `width` × `height`.
SUB refreshEditorCache(m AS POINTER TO Model, width AS INTEGER, height AS INTEGER)
    IF NOT hasActiveTab(^m) THEN
        m.EditorCacheView = ""
        m.EditorCacheDirty = FALSE
        RETURN
    END IF
    IF NOT m.EditorCacheDirty AND m.EditorCacheW = width AND m.EditorCacheH = height THEN RETURN
    m.Tabs[m.TabIdx].Editor.SetWidth(width)
    m.Tabs[m.TabIdx].Editor.SetHeight(height)
    m.EditorCacheView = m.Tabs[m.TabIdx].Editor.View()
    m.EditorCacheW = width
    m.EditorCacheH = height
    m.EditorCacheDirty = FALSE
END SUB

' helpText — the keybindings cheat-sheet shown in the Help modal.
' Kept tight (≤ 46 cols wide) so the existing modal innerW fits it
' without soft-wrapping the lines.
FUNCTION helpText() AS STRING
    DIM s AS STRING = ""
    s = s + "DBtui — self-hosted IDE for DBasic\n"
    s = s + "\n"
    s = s + "FILE\n"
    s = s + "  Ctrl+N   New file\n"
    s = s + "  Ctrl+O   Open file\n"
    s = s + "  Ctrl+S   Save (Save As if no path)\n"
    s = s + "  Ctrl+W   Close tab\n"
    s = s + "  q / Ctrl+C   Quit\n"
    s = s + "\n"
    s = s + "EDIT / NAVIGATE\n"
    s = s + "  Ctrl+F   Find    F3   Find next\n"
    s = s + "  Ctrl+G   Go to line\n"
    s = s + "  Esc      Focus tree from editor\n"
    s = s + "  Ctrl+Tab / F6   Cycle focus\n"
    s = s + "\n"
    s = s + "TABS\n"
    s = s + "  Ctrl+PgUp / Ctrl+PgDn   Cycle tabs\n"
    s = s + "  Click tab     Switch     Click ✕   Close\n"
    s = s + "\n"
    s = s + "VIEW / RUN\n"
    s = s + "  F5    Run         F7    Form / Code\n"
    s = s + "  F8    Check       F12   Toggle Output\n"
    s = s + "  F10   Open menu\n"
    s = s + "\n"
    s = s + "TREE\n"
    s = s + "  ↑/↓ PgUp PgDn Home End   Move\n"
    s = s + "  Enter   Open file / toggle folder\n"
    s = s + "  Wheel   Scroll\n"
    s = s + "\n"
    s = s + "LAYOUT\n"
    s = s + "  Drag pane border   Resize splitter\n"
    s = s + "  Alt+← / →          Resize left pane\n"
    s = s + "  Alt+Shift+← / →    Resize right pane\n"
    RETURN s
END FUNCTION

' showHelpModal — pop the keybindings cheat-sheet. Single OK button
' (or Enter/Esc to dismiss). Tagged "help" so dispatchModalClose
' doesn't run any action on close.
SUB showHelpModal(m AS POINTER TO Model)
    showModal(m, "Help — DBtui Keybindings", helpText(), "OK", "help")
END SUB

' clampSplitters — keep LeftW / RightW in the legal range:
' each at least 15 cells, middle pane at least 20 cells, total
' not exceeding the screen width. Whittles down whichever pane
' is larger when the screen is too narrow.
SUB clampSplitters(m AS POINTER TO Model)
    IF m.LeftW  < 15 THEN m.LeftW  = 15
    IF m.RightW < 15 THEN m.RightW = 15
    DIM minMid AS INTEGER = 20
    DIM tot AS INTEGER = m.LeftW + m.RightW + minMid
    IF tot > m.Width AND m.Width > 0 THEN
        DIM over AS INTEGER = tot - m.Width
        ' Trim from whichever side has more "give" first.
        IF m.LeftW - 15 >= over THEN
            m.LeftW = m.LeftW - over
        ELSEIF m.RightW - 15 >= over THEN
            m.RightW = m.RightW - over
        ELSE
            m.LeftW = 15
            m.RightW = 15
        END IF
    END IF
    invalidateEditorCache(m)
END SUB

' isMutatingKey — TRUE for keys that can change the editor buffer.
' Lets the editor dispatch flip the Dirty flag without a costly
' before/after Value() comparison on every keystroke.
FUNCTION isMutatingKey(k AS STRING) AS BOOLEAN
    IF LEN(k) = 1 THEN RETURN TRUE          ' single character — typed text
    IF k = "backspace" THEN RETURN TRUE
    IF k = "delete"    THEN RETURN TRUE
    IF k = "enter"     THEN RETURN TRUE
    IF k = "space"     THEN RETURN TRUE
    IF k = "tab"       THEN RETURN TRUE
    IF k = "ctrl+v"    THEN RETURN TRUE      ' paste
    IF k = "ctrl+x"    THEN RETURN TRUE      ' cut
    IF k = "ctrl+y"    THEN RETURN TRUE      ' redo (textarea default)
    IF k = "ctrl+z"    THEN RETURN TRUE      ' undo
    IF k = "ctrl+k"    THEN RETURN TRUE      ' kill to end-of-line
    IF k = "ctrl+u"    THEN RETURN TRUE      ' kill to start-of-line
    IF k = "ctrl+w"    THEN RETURN TRUE      ' (intercepted earlier, defensive)
    IF k = "alt+backspace" THEN RETURN TRUE  ' delete prev word
    IF k = "alt+d"     THEN RETURN TRUE      ' delete next word
    RETURN FALSE
END FUNCTION

' newTextarea — fresh, empty textarea.Model configured the way every
' tab wants. Centralised so all tabs look identical at birth.
FUNCTION newTextarea() AS textarea.Model
    DIM ed AS textarea.Model = textarea.New()
    ed.Prompt = ""
    ed.ShowLineNumbers = TRUE
    ed.Placeholder = ""
    RETURN ed
END FUNCTION

' -------------------------------------------------------------------------
' Cursor / find / goto helpers — work against the active tab's editor.
' -------------------------------------------------------------------------

' cursorOffset — current cursor position as a byte offset from the
' start of the buffer. Computed by summing prior line lengths +1
' (for the implicit '\n') and adding the column inside the line.
FUNCTION cursorOffset(m AS POINTER TO Model) AS INTEGER
    IF NOT hasActiveTab(^m) THEN RETURN 0
    DIM content AS STRING = m.Tabs[m.TabIdx].Editor.Value()
    DIM row AS INTEGER = m.Tabs[m.TabIdx].Editor.Line()
    DIM col AS INTEGER = m.Tabs[m.TabIdx].Editor.Column()
    DIM lines AS []STRING = strings.Split(content, "\n")
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO row - 1
        IF i < LEN(lines) THEN off = off + LEN(lines[i]) + 1
    NEXT i
    off = off + col
    RETURN off
END FUNCTION

' moveCursorToOffset — translate a byte offset back to (row, col)
' and walk the textarea cursor to that spot. textarea exposes
' MoveToBegin/CursorDown/SetCursorColumn but no "set absolute"
' helper, so we have to drive it step-by-step.
SUB moveCursorToOffset(m AS POINTER TO Model, offset AS INTEGER)
    IF NOT hasActiveTab(^m) THEN RETURN
    DIM content AS STRING = m.Tabs[m.TabIdx].Editor.Value()
    IF offset < 0 THEN offset = 0
    IF offset > LEN(content) THEN offset = LEN(content)
    DIM row AS INTEGER = 0
    DIM col AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO offset - 1
        IF Mid(content, i + 1, 1) = "\n" THEN
            row = row + 1
            col = 0
        ELSE
            col = col + 1
        END IF
    NEXT i
    m.Tabs[m.TabIdx].Editor.MoveToBegin()
    DIM r AS INTEGER
    FOR r = 0 TO row - 1
        m.Tabs[m.TabIdx].Editor.CursorDown()
    NEXT r
    m.Tabs[m.TabIdx].Editor.SetCursorColumn(col)
END SUB

' findNextInActive — search the active tab's content for FindQuery,
' starting at byte offset `fromOff`. Wraps around to the top of the
' buffer if nothing is found in the tail. Status bar reports the
' outcome (hit, wrapped, or not-found).
SUB findNextInActive(m AS POINTER TO Model, fromOff AS INTEGER)
    IF NOT hasActiveTab(^m) THEN
        m.Status = "no file open to search"
        RETURN
    END IF
    IF m.FindQuery = "" THEN
        m.Status = "Ctrl+F to set a find query"
        RETURN
    END IF
    DIM content AS STRING = m.Tabs[m.TabIdx].Editor.Value()
    IF fromOff < 0 THEN fromOff = 0
    IF fromOff > LEN(content) THEN fromOff = LEN(content)
    DIM tail AS STRING = ""
    IF fromOff < LEN(content) THEN tail = Mid(content, fromOff + 1, LEN(content) - fromOff)
    DIM rel AS INTEGER = strings.Index(tail, m.FindQuery)
    DIM abs AS INTEGER = 0 - 1
    DIM wrapped AS BOOLEAN = FALSE
    IF rel >= 0 THEN
        abs = fromOff + rel
    ELSE
        abs = strings.Index(content, m.FindQuery)
        wrapped = TRUE
    END IF
    IF abs < 0 THEN
        m.Status = "not found: " + m.FindQuery
        RETURN
    END IF
    moveCursorToOffset(m, abs)
    invalidateEditorCache(m)
    setFocus(m, "editor")
    IF wrapped THEN
        m.Status = "wrapped — '" + m.FindQuery + "'"
    ELSE
        m.Status = "found '" + m.FindQuery + "' (F3 = next)"
    END IF
END SUB

' gotoLine — jump the cursor to the start of line `line` (1-based)
' in the active tab AND scroll so that line lands at the *top* of
' the viewport (matching VBDOS / VS Code behaviour).
'
' textarea doesn't expose a scroll-offset setter — but it auto-
' scrolls to keep the cursor visible. So the trick is:
'   1. drive the cursor down to (target + viewH - 1)   →  textarea
'      scrolls so that line is at the bottom of the viewport.
'   2. walk back up to the actual target               →  cursor
'      moves from bottom of viewport to top, no further scroll.
SUB gotoLine(m AS POINTER TO Model, line AS INTEGER)
    IF NOT hasActiveTab(^m) THEN RETURN
    DIM lineCount AS INTEGER = m.Tabs[m.TabIdx].Editor.LineCount()
    DIM viewH AS INTEGER = m.Tabs[m.TabIdx].Editor.Height()
    IF viewH < 1 THEN viewH = 1
    IF line < 1 THEN line = 1
    IF line > lineCount THEN line = lineCount
    ' 0-based indices for textarea.
    DIM target AS INTEGER = line - 1
    DIM anchor AS INTEGER = target + viewH - 1
    IF anchor > lineCount - 1 THEN anchor = lineCount - 1
    ' Phase 1: reset to top, then walk down to the anchor.
    m.Tabs[m.TabIdx].Editor.MoveToBegin()
    DIM i AS INTEGER
    FOR i = 0 TO anchor - 1
        m.Tabs[m.TabIdx].Editor.CursorDown()
    NEXT i
    ' Phase 2: walk up to the target — viewport stays put.
    DIM up AS INTEGER = anchor - target
    FOR i = 0 TO up - 1
        m.Tabs[m.TabIdx].Editor.CursorUp()
    NEXT i
    m.Tabs[m.TabIdx].Editor.SetCursorColumn(0)
    invalidateEditorCache(m)
    setFocus(m, "editor")
    m.Status = "line " + fmt.Sprintf("%d", line)
END SUB

' setFocus — shift keyboard focus to `pane` ("tree" or "editor").
' Handles editor Focus()/Blur() so only the focused pane shows a
' cursor. Asking for "editor" focus when no editor is available
' silently falls back to "tree" — the safe pane is always available.
SUB setFocus(m AS POINTER TO Model, pane AS STRING)
    IF pane = "editor" AND hasActiveTab(^m) AND m.ViewMode = "code" THEN
        DIM cmd AS tea.Cmd = m.Tabs[m.TabIdx].Editor.Focus()
        _ = cmd
        m.FocusedPane = "editor"
        invalidateEditorCache(m)
        RETURN
    END IF
    ' Default: focus the tree (always available). Blur any tab editor
    ' so the cursor doesn't keep blinking in an inactive pane.
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    m.FocusedPane = "tree"
    invalidateEditorCache(m)
END SUB

' saveCurrent — write the active tab's buffer to its Path on disk.
' Status reports the byte count on success or the error on failure.
' No-op (with explanatory status) when there is no active tab.
SUB saveCurrent(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing open to save"
        RETURN
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    DIM body AS STRING = m.Tabs[m.TabIdx].Editor.Value()
    DIM err  AS ERROR  = os.WriteFile(path, Encode(body), 0644)
    IF err <> NIL THEN
        m.Status = "save failed: " + err.Error()
        RETURN
    END IF
    m.Tabs[m.TabIdx].Dirty = FALSE
    m.Status = fmt.Sprintf("saved %s (%d bytes)", path, LEN(body))
END SUB

' showModal — pop a button-style modal with `title`, `message`, and a
' comma-separated `buttonsCSV` (e.g. "Discard,Cancel"). `context` is
' a free-text tag forwarded to dispatchModalClose so the same handler
' can serve multiple dialog kinds. The active modal is rendered as a
' centered lipgloss-layer overlay in View().
SUB showModal(m AS POINTER TO Model, title AS STRING, message AS STRING, buttonsCSV AS STRING, context AS STRING)
    m.ModalTitle = title
    m.ModalMessage = message
    DIM buttons AS []STRING
    DIM parts AS []STRING = strings.Split(buttonsCSV, ",")
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(parts) - 1
        DIM p AS STRING = strings.TrimSpace(parts[bi])
        IF p <> "" THEN buttons = APPEND(buttons, p)
    NEXT bi
    IF LEN(buttons) = 0 THEN buttons = APPEND(buttons, "OK")
    m.ModalButtons = buttons
    m.ModalIdx = 0
    m.ModalContext = context
    m.ModalIsInput = FALSE
    m.ModalActive = TRUE
END SUB

' showInputModal — pop an input-style modal with `title`, a one-line
' `prompt` shown above the field, and `defaultText` pre-filled in
' the textinput. Enter commits; Esc cancels. dispatchModalClose
' receives the typed text via its `input` parameter.
SUB showInputModal(m AS POINTER TO Model, title AS STRING, prompt AS STRING, defaultText AS STRING, context AS STRING)
    m.ModalTitle = title
    m.ModalMessage = prompt
    m.ModalContext = context
    m.ModalIsInput = TRUE
    m.ModalInput = textinput.New()
    m.ModalInput.Placeholder = ""
    m.ModalInput.SetValue(defaultText)
    m.ModalInput.CursorEnd()
    DIM fcmd AS tea.Cmd = m.ModalInput.Focus()
    _ = fcmd
    m.ModalActive = TRUE
END SUB

' dispatchModalClose — called by Update when the user commits a modal
' choice. Returns TRUE if the program should terminate immediately
' after this call (e.g. "Discard" on the quit-confirm modal).
FUNCTION dispatchModalClose(m AS POINTER TO Model, button AS STRING, text AS STRING) AS (BOOLEAN, tea.Cmd)
    IF m.ModalContext = "quit" THEN
        IF button = "Discard" THEN RETURN TRUE, NIL
        m.Status = "quit cancelled"
        RETURN FALSE, NIL
    END IF
    ' "closetab:<idx>" — Discard removes the tab; Cancel keeps it.
    IF strings.HasPrefix(m.ModalContext, "closetab:") THEN
        IF button = "Discard" THEN
            DIM idxStr AS STRING = Mid(m.ModalContext, 10, LEN(m.ModalContext) - 9)
            DIM idx AS INTEGER
            DIM err AS ERROR
            idx, err = strconv.Atoi(idxStr)
            IF err = NIL THEN closeTab(m, idx)
        ELSE
            m.Status = "close cancelled"
        END IF
        RETURN FALSE, NIL
    END IF
    ' "open" — input modal asking for a file path. Empty/whitespace
    ' aborts; otherwise hand the path off to openFile (async).
    IF m.ModalContext = "open" THEN
        DIM p AS STRING = strings.TrimSpace(text)
        DIM oCmd AS tea.Cmd = NIL
        IF p <> "" THEN oCmd = openFile(m, p)
        RETURN FALSE, oCmd
    END IF
    ' "saveas" — input modal asking where to write the active tab.
    ' Updates the tab's Path then re-uses saveCurrent.
    IF m.ModalContext = "saveas" THEN
        DIM sp AS STRING = strings.TrimSpace(text)
        IF sp = "" OR NOT hasActiveTab(^m) THEN RETURN FALSE, NIL
        m.Tabs[m.TabIdx].Path = sp
        saveCurrent(m)
        RETURN FALSE, NIL
    END IF
    ' "new" — input modal asking for a name for the fresh buffer.
    ' Pushes a tab with empty contents at that path (or "untitled"
    ' when the user just hits Enter).
    IF m.ModalContext = "new" THEN
        DIM np AS STRING = strings.TrimSpace(text)
        IF np = "" THEN np = "untitled"
        newEmptyTab(m, np)
        RETURN FALSE, NIL
    END IF
    ' "find" — saves the query and runs a fresh search from the top
    ' of the buffer (Ctrl+F always restarts the search; F3 continues).
    IF m.ModalContext = "find" THEN
        DIM fq AS STRING = text
        IF fq = "" THEN
            m.Status = "find cancelled"
            RETURN FALSE, NIL
        END IF
        m.FindQuery = fq
        findNextInActive(m, 0)
        RETURN FALSE, NIL
    END IF
    ' "goto" — input modal asking for a 1-based line number.
    IF m.ModalContext = "goto" THEN
        DIM ln AS INTEGER
        DIM lnErr AS ERROR
        ln, lnErr = strconv.Atoi(strings.TrimSpace(text))
        IF lnErr <> NIL THEN
            m.Status = "not a line number: " + text
            RETURN FALSE, NIL
        END IF
        gotoLine(m, ln)
        RETURN FALSE, NIL
    END IF
    m.Status = "modal " + m.ModalContext + " → " + button
    RETURN FALSE, NIL
END FUNCTION

' newEmptyTab — create a fresh empty tab with `path` as its title.
' The file isn't touched on disk until the user saves. Used by
' both File → New and Ctrl+N.
SUB newEmptyTab(m AS POINTER TO Model, path AS STRING)
    DIM t AS Tab
    t.Path = path
    t.Editor = newTextarea()
    t.Dirty = FALSE
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    m.Tabs = APPEND(m.Tabs, t)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "code"
    setFocus(m, "editor")
    invalidateEditorCache(m)
    m.Status = "new file: " + path
END SUB

' -------------------------------------------------------------------------
' Run / Check — shell out to the `dbasic` CLI on the active tab.
'
' "Run" uses tea.ExecProcess so the child program gets the full terminal
' (interactive output, colour, raw keys). bubbletea suspends, the child
' runs to completion, then bubbletea resumes and dispatches
' RunFinishedMsg with the exit error (or NIL on success).
'
' "Check" runs synchronously — `dbasic check` is quick (~100ms) and we
' want the result inline in the IDE rather than taking over the screen.
' On failure the (truncated) compiler output goes into a popup modal.
' -------------------------------------------------------------------------

' -------------------------------------------------------------------------
' Bottom output pane helpers.
'
' The pane stores its accumulated text in m.BottomBody and a short
' caption in m.BottomTitle. appendBottomOutput is the chokepoint for
' anything that wants to write into the pane — it joins on newlines,
' updates the title, and auto-shows the pane so the user sees the
' new content immediately.
' -------------------------------------------------------------------------

SUB appendBottomOutput(m AS POINTER TO Model, title AS STRING, content AS STRING)
    m.BottomTitle = title
    IF m.BottomBody = "" THEN
        m.BottomBody = content
    ELSE
        m.BottomBody = m.BottomBody + "\n" + content
    END IF
    m.BottomVisible = TRUE
    ' Editor area shrinks/grows when the bottom pane toggles, so the
    ' cached textarea view (which is sized for the *previous* height)
    ' is now stale.
    invalidateEditorCache(m)
END SUB

SUB toggleBottomPane(m AS POINTER TO Model)
    m.BottomVisible = NOT m.BottomVisible
    invalidateEditorCache(m)
END SUB

' clearBottomOutput — reset the pane to empty. Currently unused but
' kept on hand for a future "Clear" menu item.
SUB clearBottomOutput(m AS POINTER TO Model)
    m.BottomBody = ""
END SUB

TYPE RunFinishedMsg
    DIM Err AS ERROR
END TYPE

' runFinishedHandler — tea.ExecProcess callback. Wraps the child's
' exit error in a RunFinishedMsg so Update can react in the regular
' message-dispatch flow (status bar, future result panes, etc.).
FUNCTION runFinishedHandler(err AS ERROR) AS tea.Msg
    DIM msg AS RunFinishedMsg
    msg.Err = err
    RETURN msg
END FUNCTION

' doRun — save the active tab, then hand the terminal to
' `dbasic run <path>`. Returns the Cmd so the caller can hand it
' straight back to bubbletea.
FUNCTION doRun(m AS POINTER TO Model) AS tea.Cmd
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing to run"
        RETURN NIL
    END IF
    saveCurrent(m)
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    m.Status = "running: dbasic run " + path
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "run", path)
    RETURN tea.ExecProcess(cmd, runFinishedHandler)
END FUNCTION

' truncateOutput — cap compiler output at ~12 lines so the modal
' stays readable. Appends a "...+N more lines" footer when the
' source is longer.
FUNCTION truncateOutput(s AS STRING, maxLines AS INTEGER) AS STRING
    DIM lines AS []STRING = strings.Split(s, "\n")
    IF LEN(lines) <= maxLines THEN RETURN s
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO maxLines - 1
        out = APPEND(out, lines[i])
    NEXT i
    out = APPEND(out, fmt.Sprintf("... +%d more lines", LEN(lines) - maxLines))
    RETURN strings.Join(out, "\n")
END FUNCTION

' doCheck — save + sync `dbasic check`. Output (success or failure)
' is appended to the bottom output pane, which auto-shows. Status
' bar gets a one-line summary so the user knows whether to look.
SUB doCheck(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing to check"
        RETURN
    END IF
    saveCurrent(m)
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    m.Status = "checking " + path + "..."
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "check", path)
    DIM outBytes AS BYTES
    DIM err AS ERROR
    outBytes, err = cmd.CombinedOutput()
    DIM out AS STRING = strings.TrimSpace(string(outBytes))
    IF err = NIL THEN
        appendBottomOutput(m, "Output", "[check OK] " + path)
        m.Status = "check ok: " + path
        RETURN
    END IF
    IF out = "" THEN out = err.Error()
    appendBottomOutput(m, "Output", "[check FAIL] " + path + "\n" + out)
    m.Status = "check failed — see Output pane (F12)"
END SUB

' anyDirtyTab — TRUE if any open tab has unsaved changes. Drives the
' quit-confirm prompt so closing the whole app doesn't silently throw
' away buffers in inactive tabs.
FUNCTION anyDirtyTab(m AS Model) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[i].Dirty THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' dirtyTabSummary — short list of dirty filenames for the modal body.
' "foo.dbas, bar.dbas" — comma-joined basenames.
FUNCTION dirtyTabSummary(m AS Model) AS STRING
    DIM names AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[i].Dirty THEN names = APPEND(names, baseName(m.Tabs[i].Path))
    NEXT i
    RETURN strings.Join(names, ", ")
END FUNCTION

' tryQuit — single chokepoint for every "user wants to leave" path.
' Returns TRUE if it's safe to quit now (no unsaved edits); returns
' FALSE after popping a Discard/Cancel modal so the caller knows to
' stay alive and wait for the user's pick.
FUNCTION tryQuit(m AS POINTER TO Model) AS BOOLEAN
    IF NOT anyDirtyTab(^m) THEN RETURN TRUE
    DIM msg AS STRING = dirtyTabSummary(^m) + " — unsaved changes will be lost. Discard?"
    showModal(m, "Quit", msg, "Discard,Cancel", "quit")
    RETURN FALSE
END FUNCTION

' tryCloseTab — close-tab chokepoint, mirroring tryQuit. If the tab
' is dirty we pop a Discard/Cancel modal tagged "closetab:<idx>" so
' the modal-close handler knows which tab to drop on Discard.
FUNCTION tryCloseTab(m AS POINTER TO Model, idx AS INTEGER) AS BOOLEAN
    IF idx < 0 OR idx >= LEN(m.Tabs) THEN RETURN FALSE
    IF NOT m.Tabs[idx].Dirty THEN
        closeTab(m, idx)
        RETURN TRUE
    END IF
    DIM msg AS STRING = baseName(m.Tabs[idx].Path) + " has unsaved changes. Discard?"
    showModal(m, "Close Tab", msg, "Discard,Cancel", "closetab:" + fmt.Sprintf("%d", idx))
    RETURN FALSE
END FUNCTION

' dispatchAction — resolve the user's menu pick to the underlying
' action handler. Centralised here so other paths (keyboard shortcuts
' or buttons later) can invoke the same code.
SUB dispatchAction(m AS POINTER TO Model, action AS STRING)
    IF action = "file.new" THEN
        showInputModal(m, "New File", "Name for the new buffer:", "untitled.dbas", "new")
        RETURN
    END IF
    IF action = "file.open" THEN
        DIM cwd AS STRING
        DIM cwdErr AS ERROR
        cwd, cwdErr = os.Getwd()
        IF cwdErr <> NIL THEN cwd = "."
        showInputModal(m, "Open File", "Path:", cwd + "/", "open")
        RETURN
    END IF
    IF action = "file.saveas" THEN
        IF NOT hasActiveTab(^m) THEN
            m.Status = "nothing to save"
            RETURN
        END IF
        showInputModal(m, "Save As", "Path:", m.Tabs[m.TabIdx].Path, "saveas")
        RETURN
    END IF
    IF action = "file.close" THEN
        IF hasActiveTab(^m) THEN _ = tryCloseTab(m, m.TabIdx)
        RETURN
    END IF
    IF action = "file.save" THEN
        ' Saving a brand-new (no-path) buffer falls through to
        ' Save As so the user is prompted for a destination.
        IF hasActiveTab(^m) AND m.Tabs[m.TabIdx].Path = "" THEN
            showInputModal(m, "Save As", "Path:", "untitled.dbas", "saveas")
            RETURN
        END IF
        saveCurrent(m)
        RETURN
    END IF
    IF action = "file.quit" THEN
        m.Status = "quitting..."
        RETURN
    END IF
    IF action = "view.form" THEN
        m.ViewMode = "form"
        setFocus(m, "tree")
        m.Status = "form designer"
        RETURN
    END IF
    IF action = "view.code" THEN
        m.ViewMode = "code"
        IF hasActiveTab(^m) THEN
            setFocus(m, "editor")
            m.Status = "code editor — " + m.Tabs[m.TabIdx].Path
        ELSE
            m.Status = "code editor (no files open — pick one from the tree)"
        END IF
        RETURN
    END IF
    IF action = "run.run" THEN
        ' Side note: dispatchAction is a SUB so it can't return a Cmd;
        ' run.run is special-cased in the menubar Enter / mouse-click
        ' / hotkey paths to invoke doRun() directly.
        m.Status = "press F5 (or use Run menu) to run"
        RETURN
    END IF
    IF action = "run.check" THEN
        doCheck(m)
        RETURN
    END IF
    IF action = "help.about" THEN
        showHelpModal(m)
        RETURN
    END IF
    IF action = "help.keys" THEN
        showHelpModal(m)
        RETURN
    END IF
    m.Status = "action: " + action
END SUB

' -------------------------------------------------------------------------
' Async file loading.
'
' os.ReadFile + textarea.SetValue on a sizable .dbas file can take
' long enough to look like the IDE is frozen. We move the work to
' a bubbletea Cmd so the main loop keeps drawing while the bytes
' are read in a goroutine; the result comes back as a
' LoadFinishedMsg that the Update handler turns into a tab.
'
' DBasic doesn't have closures, so the load goroutine grabs its
' arguments from a package-level "pending" slot. Only one load
' can be in flight at a time, but in this single-user IDE the
' worst case is a second load winning the race — acceptable.
' -------------------------------------------------------------------------

TYPE LoadFinishedMsg
    DIM Path AS STRING
    DIM Data AS BYTES
    DIM Err  AS ERROR
END TYPE

DIM pendingLoadPath AS STRING

' loadFileWorker — runs in a bubbletea-spawned goroutine; reads the
' bytes for `pendingLoadPath` and packages them as a LoadFinishedMsg
' for the main Update loop.
FUNCTION loadFileWorker() AS tea.Msg
    DIM p AS STRING = pendingLoadPath
    DIM data AS BYTES
    DIM err AS ERROR
    data, err = os.ReadFile(p)
    DIM lf AS LoadFinishedMsg
    lf.Path = p
    lf.Data = data
    lf.Err  = err
    RETURN lf
END FUNCTION

' completeFileLoad — main-thread handler for LoadFinishedMsg. Builds
' the new tab, attaches its editor, and clears the loading state.
SUB completeFileLoad(m AS POINTER TO Model, path AS STRING, data AS BYTES, err AS ERROR)
    m.Loading = ""
    IF err <> NIL THEN
        m.Status = "open " + path + ": " + err.Error()
        RETURN
    END IF
    ' Race protection: skip the tab build if the user already opened
    ' the same file by some other path while we were loading.
    IF findTabIdx(^m, path) >= 0 THEN
        m.Status = "already open: " + path
        RETURN
    END IF
    DIM t AS Tab
    t.Path = path
    t.Editor = newTextarea()
    t.Editor.SetValue(string(data))
    ' SetValue lands the cursor at the END. MoveToBegin is the
    ' single-call way back to the top — walking up line by line
    ' via CursorUp() was O(lines) and made loading large files
    ' feel hung.
    t.Editor.MoveToBegin()
    t.Dirty = FALSE
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    m.Tabs = APPEND(m.Tabs, t)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "code"
    setFocus(m, "editor")
    invalidateEditorCache(m)
    m.Status = "opened " + path
END SUB

' openFile — kick off an async load of `path`. Returns NIL when the
' file is already open (instant path) or when path is empty.
' Otherwise returns the worker Cmd; the actual tab is built when
' the LoadFinishedMsg comes back.
FUNCTION openFile(m AS POINTER TO Model, path AS STRING) AS tea.Cmd
    IF path = "" THEN RETURN NIL
    ' Already open? Just activate it — no async work needed.
    DIM existing AS INTEGER = findTabIdx(^m, path)
    IF existing >= 0 THEN
        m.ViewMode = "code"
        switchToTab(m, existing)
        setFocus(m, "editor")
        m.Status = "switched to " + path
        RETURN NIL
    END IF
    ' Show a visible "loading" indicator immediately so the user
    ' knows the click registered, then hand the slow part off.
    m.Loading = path
    m.Status = "loading " + path + "..."
    pendingLoadPath = path
    RETURN loadFileWorker
END FUNCTION

' newModel — initial state on program start.
FUNCTION newModel() AS Model
    DIM m AS Model
    m.Width = 0
    m.Height = 0
    m.Status = "DBtui — F10:Menu  F5:Run  F7:Code  F12:Console  |  q:Quit"
    ' Project tree rooted at the current working directory.
    DIM cwd AS STRING
    DIM err AS ERROR
    cwd, err = os.Getwd()
    IF err <> NIL THEN cwd = "."
    m.TreeRoot = cwd
    ' Pre-expand the root so the first-level entries show on startup.
    m.TreeExpanded = APPEND(m.TreeExpanded, cwd)
    buildTreeNodes(@m)
    ' Start with the cursor on the first child of the root (or on the
    ' root row itself when the project is empty). This way the user's
    ' first Enter does something visible — opening or expanding —
    ' instead of being a no-op on the bare root row.
    m.TreeSelected = 0
    IF LEN(m.TreeNodes) > 1 THEN m.TreeSelected = 1
    m.TreeOffset = 0
    ' No tabs open at startup. The middle pane shows the form
    ' designer until the user opens a file from the tree (which
    ' creates the first tab) or presses F7.
    m.ViewMode = "form"
    m.TabIdx = 0 - 1
    ' Tree starts focused — the tree is always available and the
    ' editor doesn't exist yet.
    m.FocusedPane = "tree"
    ' No hover known until the first MouseMotionMsg arrives.
    m.HoverX = 0 - 1
    m.HoverY = 0 - 1
    ' Default splitter widths mirror the original DBtui's defaults.
    m.LeftW  = 28
    m.RightW = 32
    ' Menubar definitions + closed-state.
    m.Menus = buildMenus()
    m.MenuActive = 0 - 1
    m.MenuItemIdx = 0
    RETURN m
END FUNCTION

' -------------------------------------------------------------------------
' bubbletea lifecycle.
' -------------------------------------------------------------------------

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)

    ' Window resize — track the new dimensions.
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        ' Re-clamp splitters in case the window shrank below their
        ' combined minimum, and invalidate the editor cache since
        ' its sized-for-old-width content is now wrong.
        clampSplitters(@m)
        invalidateEditorCache(@m)
        RETURN m, NIL
    END IF

    ' --- Async file load finished --------------------------------
    ' Background goroutine started by openFile() posts a
    ' LoadFinishedMsg when its os.ReadFile returns. Build the new
    ' tab from the freshly read bytes and clear the loading state.
    DIM lfMsg AS LoadFinishedMsg
    DIM lfOk  AS BOOLEAN
    lfMsg, lfOk = msg.(LoadFinishedMsg)
    IF lfOk THEN
        completeFileLoad(@m, lfMsg.Path, lfMsg.Data, lfMsg.Err)
        invalidateEditorCache(@m)
        RETURN m, NIL
    END IF

    ' --- Run-finished message -------------------------------------
    ' tea.ExecProcess calls runFinishedHandler when the child exits
    ' and posts a RunFinishedMsg into our message loop. Status bar
    ' is the simplest place to surface it; a bottom output pane can
    ' do something fancier later.
    DIM rfMsg AS RunFinishedMsg
    DIM rfOk  AS BOOLEAN
    rfMsg, rfOk = msg.(RunFinishedMsg)
    IF rfOk THEN
        IF rfMsg.Err = NIL THEN
            appendBottomOutput(@m, "Output", "[run finished]")
            m.Status = "run finished"
        ELSE
            appendBottomOutput(@m, "Output", "[run failed] " + rfMsg.Err.Error())
            m.Status = "run failed — see Output pane (F12)"
        END IF
        RETURN m, NIL
    END IF

    ' --- Mouse motion (hover) -------------------------------------
    ' When a menu is open, sliding the cursor sideways across the
    ' menubar swings the active menu to whichever cell sits under
    ' the pointer (classic Windows menubar behaviour).
    DIM mmMsg AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mmMsg, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        ' Splitter drag in progress — translate cursor position to
        ' new pane width and reclamp. Doesn't go through the hover
        ' update path because the cursor is "owned" by the drag.
        IF m.DragMode = "splitL" THEN
            m.LeftW = mmMsg.X + 1
            clampSplitters(@m)
            RETURN m, NIL
        END IF
        IF m.DragMode = "splitR" THEN
            m.RightW = m.Width - mmMsg.X
            clampSplitters(@m)
            RETURN m, NIL
        END IF
        ' Drop identical-cell events early. bubbletea v2 in
        ' MouseModeAllMotion floods us with events as the pointer
        ' moves; deduping makes hover feel snappy.
        IF mmMsg.X = m.HoverX AND mmMsg.Y = m.HoverY THEN RETURN m, NIL
        ' Populate the editor view cache on the FIRST motion after a
        ' state change. This is the chokepoint that prevents the
        ' textarea.View() cost from re-running on every subsequent
        ' motion event (which is what made hover feel sluggish).
        IF m.EditorCacheDirty THEN
            DIM emidW AS INTEGER = m.Width - 28 - 32
            IF emidW < 20 THEN emidW = 20
            DIM ebodyH AS INTEGER = m.Height - 2
            IF ebodyH < 4 THEN ebodyH = 4
            refreshEditorCache(@m, emidW, ebodyH - 1)
        END IF
        ' Record the live hover position so renderers can restyle the
        ' cell under the pointer on this frame.
        m.HoverX = mmMsg.X
        m.HoverY = mmMsg.Y
        IF m.MenuActive >= 0 AND mmMsg.Y = 0 THEN
            DIM newMi AS INTEGER = menuCellAt(m, mmMsg.X)
            IF newMi >= 0 AND newMi <> m.MenuActive THEN
                m.MenuActive = newMi
                m.MenuItemIdx = 0
            END IF
            RETURN m, NIL
        END IF
        ' Hovering an item inside an open dropdown moves the cursor
        ' to that row, so click-through feels responsive.
        IF m.MenuActive >= 0 THEN
            DIM hoverItem AS INTEGER = dropdownItemAt(m, mmMsg.X, mmMsg.Y)
            IF hoverItem >= 0 THEN m.MenuItemIdx = hoverItem
        END IF
        RETURN m, NIL
    END IF

    ' --- Mouse wheel ----------------------------------------------
    ' Wheel inside the left pane scrolls the tree (independent of
    ' the selection cursor). Wheel elsewhere falls through — the
    ' textarea handles its own wheel in editor-routing later.
    DIM mwMsg AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mwMsg, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk AND mwMsg.X < m.LeftW THEN
        DIM step AS INTEGER = 3
        IF mwMsg.Button = tea.MouseWheelUp THEN
            m.TreeOffset = m.TreeOffset - step
        ELSE
            m.TreeOffset = m.TreeOffset + step
        END IF
        clampTreeOffset(@m)
        RETURN m, NIL
    END IF

    ' --- Mouse release --------------------------------------------
    ' End an in-progress splitter drag.
    DIM mrMsg AS tea.MouseReleaseMsg
    DIM mrOk  AS BOOLEAN
    mrMsg, mrOk = msg.(tea.MouseReleaseMsg)
    IF mrOk AND m.DragMode <> "" THEN
        m.DragMode = ""
        _ = mrMsg
        RETURN m, NIL
    END IF

    ' --- Mouse click ----------------------------------------------
    ' Left-click hit-tests in priority order:
    '   1. dropdown items (when a menu is open)
    '   2. top-row menu cells
    '   3. tabs caption row (close button vs label) when in code mode
    ' Clicks elsewhere close any open menu.
    DIM mcMsg AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mcMsg, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mcMsg.Button = tea.MouseLeft THEN
        ' (0) Splitter click — start a drag. The drag-handle is the
        '     column right at the left pane's right border (and the
        '     mirror column for the right pane). 2-cell tolerance so
        '     the user doesn't have to land on the exact pixel.
        IF mcMsg.Y >= 2 AND mcMsg.Y < m.Height - 1 THEN
            IF mcMsg.X = m.LeftW - 1 OR mcMsg.X = m.LeftW THEN
                m.DragMode = "splitL"
                RETURN m, NIL
            END IF
            DIM rsX AS INTEGER = m.Width - m.RightW
            IF mcMsg.X = rsX OR mcMsg.X = rsX - 1 THEN
                m.DragMode = "splitR"
                RETURN m, NIL
            END IF
        END IF
        ' (1) Dropdown-item click.
        IF m.MenuActive >= 0 THEN
            DIM ddIt AS INTEGER = dropdownItemAt(m, mcMsg.X, mcMsg.Y)
            IF ddIt >= 0 THEN
                DIM ddItems AS []MenuItem = m.Menus[m.MenuActive].Items
                DIM ddAct AS STRING = ddItems[ddIt].Action
                m.MenuActive = 0 - 1
                IF ddAct = "file.quit" THEN
                    IF tryQuit(@m) THEN RETURN m, tea.Quit
                    RETURN m, NIL
                END IF
                IF ddAct = "run.run" THEN
                    DIM ddRunCmd AS tea.Cmd = doRun(@m)
                    RETURN m, ddRunCmd
                END IF
                dispatchAction(@m, ddAct)
                RETURN m, NIL
            END IF
        END IF
        ' (2) Top-row menu cell click — open / toggle / switch.
        IF mcMsg.Y = 0 THEN
            DIM mci AS INTEGER = menuCellAt(m, mcMsg.X)
            IF mci >= 0 THEN
                IF m.MenuActive = mci THEN
                    ' Clicking the already-open menu closes it.
                    m.MenuActive = 0 - 1
                ELSE
                    m.MenuActive = mci
                    m.MenuItemIdx = 0
                END IF
                RETURN m, NIL
            END IF
            ' Click in the menubar's empty filler — close any open menu.
            m.MenuActive = 0 - 1
            RETURN m, NIL
        END IF
        ' Click anywhere else closes an open menu without firing it.
        IF m.MenuActive >= 0 THEN
            m.MenuActive = 0 - 1
            RETURN m, NIL
        END IF
        ' (3) Tabs caption row (y = 1) in code mode with open tabs.
        '     Clicking a tab also focuses the editor pane.
        IF mcMsg.Y = 1 AND m.ViewMode = "code" AND LEN(m.Tabs) > 0 THEN
            DIM tabHit AS INTEGER = tabAtX(m, mcMsg.X)
            IF tabHit >= 0 THEN
                IF closeXOnTab(m, tabHit, mcMsg.X) THEN
                    _ = tryCloseTab(@m, tabHit)
                ELSE
                    switchToTab(@m, tabHit)
                    setFocus(@m, "editor")
                END IF
                RETURN m, NIL
            END IF
        END IF
        ' (4) Project-tree click — same layout math View() uses for
        ' the left pane (leftW = 28, bodyH = h - 2). Clicking the tree
        ' focuses it; a click on the already-selected row opens the
        ' file (or toggles the folder).
        DIM treeBodyH AS INTEGER = m.Height - 2
        IF treeBodyH < 4 THEN treeBodyH = 4
        DIM treeHit AS INTEGER = treeNodeAt(m, mcMsg.X, mcMsg.Y, m.LeftW, treeBodyH)
        IF treeHit >= 0 THEN
            DIM alreadyOn AS BOOLEAN = (m.TreeSelected = treeHit)
            m.TreeSelected = treeHit
            setFocus(@m, "tree")
            ' First click selects; second click on the same row commits.
            ' Feels natural for both navigation and double-clickers.
            IF alreadyOn THEN
                DIM clickNode AS TreeNode = m.TreeNodes[treeHit]
                IF clickNode.IsDir AND clickNode.Depth > 0 THEN
                    setExpanded(@m, clickNode.Path, NOT isExpanded(m, clickNode.Path))
                    buildTreeNodes(@m)
                    IF m.TreeSelected >= LEN(m.TreeNodes) THEN
                        m.TreeSelected = LEN(m.TreeNodes) - 1
                    END IF
                    ensureSelectedVisible(@m)
                ELSEIF NOT clickNode.IsDir THEN
                    DIM mcOpenCmd AS tea.Cmd = openFile(@m, clickNode.Path)
                    RETURN m, mcOpenCmd
                END IF
            END IF
            RETURN m, NIL
        END IF
        ' (5) Click landed in the middle pane (between left and right
        '     panes, below the tabs row) while code mode is active —
        '     focus the editor so the next keystroke lands there.
        IF mcMsg.Y >= 2 AND mcMsg.Y < m.Height - 1 AND mcMsg.X >= m.LeftW AND mcMsg.X < m.Width - m.RightW AND m.ViewMode = "code" AND hasActiveTab(m) THEN
            setFocus(@m, "editor")
            RETURN m, NIL
        END IF
    END IF

    ' Key press dispatch.
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()

        ' --- Modal dialog takes priority over everything else ---------
        IF m.ModalActive THEN
            IF key = "esc" THEN
                m.ModalActive = FALSE
                m.ModalIsInput = FALSE
                m.Status = "cancelled"
                RETURN m, NIL
            END IF
            ' Input-mode: Enter commits the typed text; anything else
            ' goes into the textinput.
            IF m.ModalIsInput THEN
                IF key = "enter" THEN
                    DIM typed AS STRING = m.ModalInput.Value()
                    m.ModalActive = FALSE
                    m.ModalIsInput = FALSE
                    DIM quit AS BOOLEAN
                    DIM mcCmd AS tea.Cmd
                    quit, mcCmd = dispatchModalClose(@m, "", typed)
                    IF quit THEN RETURN m, tea.Quit
                    RETURN m, mcCmd
                END IF
                DIM newTi AS textinput.Model
                DIM tiCmd AS tea.Cmd
                newTi, tiCmd = m.ModalInput.Update(msg)
                m.ModalInput = newTi
                RETURN m, tiCmd
            END IF
            ' Button-mode: arrows / Tab to cycle, Enter / Space commits.
            IF key = "left" OR key = "up" OR key = "shift+tab" THEN
                m.ModalIdx = m.ModalIdx - 1
                IF m.ModalIdx < 0 THEN m.ModalIdx = LEN(m.ModalButtons) - 1
                RETURN m, NIL
            END IF
            IF key = "right" OR key = "down" OR key = "tab" THEN
                m.ModalIdx = m.ModalIdx + 1
                IF m.ModalIdx >= LEN(m.ModalButtons) THEN m.ModalIdx = 0
                RETURN m, NIL
            END IF
            IF key = "enter" OR key = "space" THEN
                DIM pick AS STRING = ""
                IF m.ModalIdx >= 0 AND m.ModalIdx < LEN(m.ModalButtons) THEN
                    pick = m.ModalButtons[m.ModalIdx]
                END IF
                m.ModalActive = FALSE
                DIM bQuit AS BOOLEAN
                DIM bCmd AS tea.Cmd
                bQuit, bCmd = dispatchModalClose(@m, pick, "")
                IF bQuit THEN RETURN m, tea.Quit
                RETURN m, bCmd
            END IF
            ' Swallow other keys while the modal is up.
            RETURN m, NIL
        END IF

        ' Global shortcuts first — apply regardless of which pane is
        ' "logically focused".
        IF key = "ctrl+c" THEN
            IF tryQuit(@m) THEN RETURN m, tea.Quit
            RETURN m, NIL
        END IF
        IF key = "ctrl+s" THEN
            ' Save-As fallback when the buffer has no on-disk path yet.
            IF hasActiveTab(m) AND m.Tabs[m.TabIdx].Path = "" THEN
                showInputModal(@m, "Save As", "Path:", "untitled.dbas", "saveas")
            ELSE
                saveCurrent(@m)
            END IF
            RETURN m, NIL
        END IF
        IF key = "ctrl+n" THEN
            showInputModal(@m, "New File", "Name for the new buffer:", "untitled.dbas", "new")
            RETURN m, NIL
        END IF
        IF key = "ctrl+o" THEN
            DIM cwdOp AS STRING
            DIM cwdErrOp AS ERROR
            cwdOp, cwdErrOp = os.Getwd()
            IF cwdErrOp <> NIL THEN cwdOp = "."
            showInputModal(@m, "Open File", "Path:", cwdOp + "/", "open")
            RETURN m, NIL
        END IF
        ' Find / Goto live alongside the file shortcuts so they work
        ' from either pane (the editor never sees them).
        IF key = "ctrl+f" THEN
            showInputModal(@m, "Find", "Find:", m.FindQuery, "find")
            RETURN m, NIL
        END IF
        IF key = "f3" THEN
            findNextInActive(@m, cursorOffset(@m) + 1)
            RETURN m, NIL
        END IF
        IF key = "ctrl+g" THEN
            showInputModal(@m, "Go To Line", "Line number:", "", "goto")
            RETURN m, NIL
        END IF
        ' Splitter resize via keyboard. Alt+←/→ grow / shrink the
        ' LEFT pane; Alt+Shift+←/→ do the same to the right pane.
        IF key = "alt+left" THEN
            m.LeftW = m.LeftW - 2
            clampSplitters(@m)
            RETURN m, NIL
        END IF
        IF key = "alt+right" THEN
            m.LeftW = m.LeftW + 2
            clampSplitters(@m)
            RETURN m, NIL
        END IF
        IF key = "alt+shift+left" THEN
            m.RightW = m.RightW + 2
            clampSplitters(@m)
            RETURN m, NIL
        END IF
        IF key = "alt+shift+right" THEN
            m.RightW = m.RightW - 2
            clampSplitters(@m)
            RETURN m, NIL
        END IF

        ' --- Menubar handling -----------------------------------------
        ' Menubar takes priority when active: arrows navigate, Enter
        ' picks an item, Esc closes, letter triggers the item hotkey.
        IF m.MenuActive >= 0 THEN
            IF key = "esc" THEN
                m.MenuActive = 0 - 1
                RETURN m, NIL
            END IF
            IF key = "left" THEN
                m.MenuActive = m.MenuActive - 1
                IF m.MenuActive < 0 THEN m.MenuActive = LEN(m.Menus) - 1
                m.MenuItemIdx = 0
                RETURN m, NIL
            END IF
            IF key = "right" THEN
                m.MenuActive = m.MenuActive + 1
                IF m.MenuActive >= LEN(m.Menus) THEN m.MenuActive = 0
                m.MenuItemIdx = 0
                RETURN m, NIL
            END IF
            IF key = "up" THEN
                IF m.MenuItemIdx > 0 THEN m.MenuItemIdx = m.MenuItemIdx - 1
                RETURN m, NIL
            END IF
            IF key = "down" THEN
                DIM ic AS INTEGER = LEN(m.Menus[m.MenuActive].Items)
                IF m.MenuItemIdx < ic - 1 THEN m.MenuItemIdx = m.MenuItemIdx + 1
                RETURN m, NIL
            END IF
            IF key = "enter" OR key = "space" THEN
                DIM items AS []MenuItem = m.Menus[m.MenuActive].Items
                IF m.MenuItemIdx >= 0 AND m.MenuItemIdx < LEN(items) AND NOT items[m.MenuItemIdx].IsSep THEN
                    DIM act AS STRING = items[m.MenuItemIdx].Action
                    m.MenuActive = 0 - 1
                    IF act = "file.quit" THEN
                        IF tryQuit(@m) THEN RETURN m, tea.Quit
                        RETURN m, NIL
                    END IF
                    IF act = "run.run" THEN
                        DIM enRunCmd AS tea.Cmd = doRun(@m)
                        RETURN m, enRunCmd
                    END IF
                    dispatchAction(@m, act)
                END IF
                RETURN m, NIL
            END IF
            ' Single letter — look up item by its hotkey.
            IF LEN(key) = 1 THEN
                DIM itemsK AS []MenuItem = m.Menus[m.MenuActive].Items
                DIM ii AS INTEGER
                FOR ii = 0 TO LEN(itemsK) - 1
                    IF NOT itemsK[ii].IsSep AND menuHotkey(itemsK[ii].Label) = strings.ToLower(key) THEN
                        DIM act2 AS STRING = itemsK[ii].Action
                        m.MenuActive = 0 - 1
                        IF act2 = "file.quit" THEN
                            IF tryQuit(@m) THEN RETURN m, tea.Quit
                            RETURN m, NIL
                        END IF
                        IF act2 = "run.run" THEN
                            DIM hkRunCmd AS tea.Cmd = doRun(@m)
                            RETURN m, hkRunCmd
                        END IF
                        dispatchAction(@m, act2)
                        RETURN m, NIL
                    END IF
                NEXT ii
            END IF
            ' Alt+letter — switch active top-level menu.
            IF LEN(key) = 5 AND Mid(key, 1, 4) = "alt+" THEN
                DIM ml AS STRING = strings.ToLower(Mid(key, 5, 1))
                DIM mi AS INTEGER
                FOR mi = 0 TO LEN(m.Menus) - 1
                    IF menuHotkey(m.Menus[mi].Label) = ml THEN
                        m.MenuActive = mi
                        m.MenuItemIdx = 0
                        RETURN m, NIL
                    END IF
                NEXT mi
            END IF
            ' Swallow other keys while menu is up.
            RETURN m, NIL
        END IF

        ' F10 opens the menubar at the first menu.
        IF key = "f10" THEN
            m.MenuActive = 0
            m.MenuItemIdx = 0
            RETURN m, NIL
        END IF
        ' Alt+letter — open the matching menu directly (works even when
        ' the code editor is focused, since we check it here ahead of
        ' the editor-routes-everything block below).
        IF LEN(key) = 5 AND Mid(key, 1, 4) = "alt+" THEN
            DIM altL AS STRING = strings.ToLower(Mid(key, 5, 1))
            DIM altMi AS INTEGER
            FOR altMi = 0 TO LEN(m.Menus) - 1
                IF menuHotkey(m.Menus[altMi].Label) = altL THEN
                    m.MenuActive = altMi
                    m.MenuItemIdx = 0
                    RETURN m, NIL
                END IF
            NEXT altMi
        END IF

        ' F1 = Help cheat-sheet. Available from anywhere (even
        ' inside the editor) since it's a global lookup.
        IF key = "f1" THEN
            showHelpModal(@m)
            RETURN m, NIL
        END IF

        ' F5 = Run (saves + tea.ExecProcess). F8 = Check (saves +
        ' sync exec; pops a modal on failure). Both routes pre-empt
        ' the editor-routing block below so they work regardless of
        ' which pane is focused.
        IF key = "f5" THEN
            DIM runCmd AS tea.Cmd = doRun(@m)
            RETURN m, runCmd
        END IF
        IF key = "f8" THEN
            doCheck(@m)
            RETURN m, NIL
        END IF
        IF key = "f12" THEN
            toggleBottomPane(@m)
            RETURN m, NIL
        END IF

        IF key = "f7" THEN
            ' Toggle between form-design view and code editor view.
            ' Focus follows the view: form → tree, code → editor (if
            ' a file is open) or tree (otherwise).
            IF m.ViewMode = "code" THEN
                m.ViewMode = "form"
                setFocus(@m, "tree")
            ELSE
                m.ViewMode = "code"
                IF hasActiveTab(m) THEN
                    setFocus(@m, "editor")
                ELSE
                    setFocus(@m, "tree")
                END IF
            END IF
            invalidateEditorCache(@m)
            RETURN m, NIL
        END IF

        ' --- Focus cycle ----------------------------------------------
        ' Ctrl+Tab / Ctrl+Shift+Tab toggle focus between tree and
        ' editor without changing ViewMode — so you can browse files
        ' while the editor still shows your current buffer. Plain
        ' Tab is reserved for the editor (indent). F6 is also bound
        ' as a no-modifier alternative.
        IF (key = "ctrl+tab" OR key = "ctrl+shift+tab" OR key = "f6") AND hasActiveTab(m) AND m.ViewMode = "code" THEN
            IF m.FocusedPane = "tree" THEN
                setFocus(@m, "editor")
            ELSE
                setFocus(@m, "tree")
            END IF
            RETURN m, NIL
        END IF

        ' --- Tab shortcuts (work in code mode only) -------------------
        IF m.ViewMode = "code" AND hasActiveTab(m) THEN
            ' Ctrl+W closes the active tab (with dirty-confirm).
            IF key = "ctrl+w" THEN
                DIM stayCmd AS tea.Cmd = NIL
                _ = tryCloseTab(@m, m.TabIdx)
                RETURN m, stayCmd
            END IF
            ' Ctrl+PageDown / Ctrl+PageUp cycle tabs forward / back.
            ' (Ctrl+Tab is reserved for focus cycling, not tab cycling.)
            IF key = "ctrl+pgdown" THEN
                switchToTab(@m, (m.TabIdx + 1) MOD LEN(m.Tabs))
                RETURN m, NIL
            END IF
            IF key = "ctrl+pgup" THEN
                DIM prev AS INTEGER = m.TabIdx - 1
                IF prev < 0 THEN prev = LEN(m.Tabs) - 1
                switchToTab(@m, prev)
                RETURN m, NIL
            END IF
        END IF

        ' --- Editor routing -------------------------------------------
        ' When the editor pane is focused (regardless of ViewMode
        ' guard, which the focus helper already respects), route
        ' keystrokes into the active tab's editor. Esc moves focus
        ' back to the tree but leaves the editor visible — F7
        ' (or "Form Designer" from the View menu) is how you switch
        ' away from code mode entirely.
        IF m.FocusedPane = "editor" AND hasActiveTab(m) AND m.ViewMode = "code" THEN
            IF key = "esc" THEN
                setFocus(@m, "tree")
                RETURN m, NIL
            END IF
            ' Cheap mutating-key check instead of comparing the whole
            ' buffer before/after Update. Editor.Value() is O(buffer
            ' size); doing it twice per keystroke made typing in big
            ' files feel laggy. This catches the common edit keys —
            ' single chars, structural keys, paste/cut/undo/redo.
            DIM mutates AS BOOLEAN = isMutatingKey(key)
            DIM newEd AS textarea.Model
            DIM eCmd  AS tea.Cmd
            newEd, eCmd = m.Tabs[m.TabIdx].Editor.Update(msg)
            m.Tabs[m.TabIdx].Editor = newEd
            IF mutates THEN m.Tabs[m.TabIdx].Dirty = TRUE
            ' Any editor.Update may have moved the cursor or content,
            ' so the cached View() output is now stale.
            invalidateEditorCache(@m)
            RETURN m, eCmd
        END IF

        ' --- Tree navigation (runs when the tree pane is focused) -----
        IF m.FocusedPane <> "tree" THEN RETURN m, NIL
        IF key = "q" THEN
            IF tryQuit(@m) THEN RETURN m, tea.Quit
            RETURN m, NIL
        END IF
        IF key = "up" THEN
            IF m.TreeSelected > 0 THEN m.TreeSelected = m.TreeSelected - 1
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        IF key = "down" THEN
            IF m.TreeSelected < LEN(m.TreeNodes) - 1 THEN m.TreeSelected = m.TreeSelected + 1
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        ' Home / End / PageUp / PageDown — useful in long trees.
        IF key = "home" THEN
            m.TreeSelected = 0
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        IF key = "end" THEN
            m.TreeSelected = LEN(m.TreeNodes) - 1
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        IF key = "pgup" THEN
            m.TreeSelected = m.TreeSelected - treeInnerH(m)
            IF m.TreeSelected < 0 THEN m.TreeSelected = 0
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        IF key = "pgdown" THEN
            m.TreeSelected = m.TreeSelected + treeInnerH(m)
            IF m.TreeSelected >= LEN(m.TreeNodes) THEN m.TreeSelected = LEN(m.TreeNodes) - 1
            ensureSelectedVisible(@m)
            RETURN m, NIL
        END IF
        ' Enter on a folder toggles expansion; on a file opens it in
        ' the code editor and flips ViewMode to "code".
        IF key = "enter" OR key = "space" THEN
            IF m.TreeSelected >= 0 AND m.TreeSelected < LEN(m.TreeNodes) THEN
                DIM node AS TreeNode = m.TreeNodes[m.TreeSelected]
                IF node.IsDir AND node.Depth > 0 THEN
                    setExpanded(@m, node.Path, NOT isExpanded(m, node.Path))
                    buildTreeNodes(@m)
                    IF m.TreeSelected >= LEN(m.TreeNodes) THEN
                        m.TreeSelected = LEN(m.TreeNodes) - 1
                    END IF
                    ensureSelectedVisible(@m)
                ELSEIF NOT node.IsDir THEN
                    DIM kbOpenCmd AS tea.Cmd = openFile(@m, node.Path)
                    RETURN m, kbOpenCmd
                END IF
            END IF
            RETURN m, NIL
        END IF
    END IF

    RETURN m, NIL
END FUNCTION

' -------------------------------------------------------------------------
' Render helpers — each returns a styled string. View() composes them.
' -------------------------------------------------------------------------

' padRight — right-pad s with `fill` characters so its visible width is
' `width` cells. Uses lipgloss.Width so multi-byte glyphs count as 1.
FUNCTION padRight(s AS STRING, width AS INTEGER, fill AS STRING) AS STRING
    DIM cur AS INTEGER = lipgloss.Width(s)
    IF cur >= width THEN RETURN s
    RETURN s + strings.Repeat(fill, width - cur)
END FUNCTION

' renderMenuLabel — render one "(X)label" menu/item label with the
' hotkey letter restyled. `base` styles non-hotkey chars; `hot`
' styles the bracketed letter (typically peach + bold + underline).
FUNCTION renderMenuLabel(label AS STRING, bs AS lipgloss.Style, hot AS lipgloss.Style) AS STRING
    DIM i AS INTEGER = strings.Index(label, "(")
    IF i < 0 OR i + 2 >= LEN(label) OR Mid(label, i + 3, 1) <> ")" THEN
        RETURN bs.Render(label)
    END IF
    DIM pre AS STRING = ""
    IF i > 0 THEN pre = Mid(label, 1, i)
    DIM letter AS STRING = Mid(label, i + 2, 1)
    DIM post AS STRING = ""
    IF i + 3 < LEN(label) THEN post = Mid(label, i + 4, LEN(label) - i - 3)
    RETURN bs.Render(pre) + hot.Render(letter) + bs.Render(post)
END FUNCTION

' renderMenuBar — top row. Walks Menus, renders each cell with " label "
' padding. Three states per cell, in priority order:
'   active  → inverted accent (the menu's dropdown is open)
'   hover   → softer accent tint (mouse is on this cell)
'   default → menubar bg
' Hotkey letter inside each label is always coloured peach.
FUNCTION renderMenuBar(m AS Model, width AS INTEGER) AS STRING
    DIM defBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg)).Bold(TRUE)
    DIM defHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM hovBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#3b3d5e")).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM hovHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#3b3d5e")).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM selHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    ' Resolve the hovered cell ONCE per render so the math doesn't
    ' have to re-walk for every menu item.
    DIM hoverCell AS INTEGER = 0 - 1
    IF m.HoverY = 0 THEN hoverCell = menuCellAt(m, m.HoverX)
    DIM out AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Menus) - 1
        DIM bs AS lipgloss.Style = defBase
        DIM hot  AS lipgloss.Style = defHot
        IF i = m.MenuActive THEN
            bs = selBase
            hot  = selHot
        ELSEIF i = hoverCell THEN
            bs = hovBase
            hot  = hovHot
        END IF
        DIM lab AS STRING = m.Menus[i].Label
        out = out + bs.Render(" ") + renderMenuLabel(lab, bs, hot) + bs.Render(" ")
    NEXT i
    ' Fill the rest of the row so the bar bg extends to the right edge.
    DIM consumed AS INTEGER = lipgloss.Width(out)
    IF consumed < width THEN
        out = out + defBase.Render(strings.Repeat(" ", width - consumed))
    END IF
    RETURN out
END FUNCTION

' menuCellWidth — visible width (in cells) of one top-menu cell.
' renderMenuBar pads each cell as " label " — so visible width is
' LEN(stripped label) + 2 (one leading + one trailing space).
FUNCTION menuCellWidth(m AS Model, idx AS INTEGER) AS INTEGER
    IF idx < 0 OR idx >= LEN(m.Menus) THEN RETURN 0
    RETURN LEN(menuStrip(m.Menus[idx].Label)) + 2
END FUNCTION

' menuOffsetX — leading X (in cells) of the dropdown for menu `idx`.
' Sum of preceding menu cell widths so the dropdown opens directly
' below its parent label.
FUNCTION menuOffsetX(m AS Model, idx AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO idx - 1
        off = off + menuCellWidth(m, i)
    NEXT i
    RETURN off
END FUNCTION

' menuCellAt — return the menu index whose top-row cell contains the
' screen X column `mx`. Returns -1 when `mx` lands outside any cell
' (e.g. past the last menu in the filler area).
FUNCTION menuCellAt(m AS Model, mx AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Menus) - 1
        DIM w AS INTEGER = menuCellWidth(m, i)
        IF mx >= off AND mx < off + w THEN RETURN i
        off = off + w
    NEXT i
    RETURN 0 - 1
END FUNCTION

' dropdownItemAt — translate a screen (mx,my) inside an open dropdown
' to an item index, or -1 if outside. The dropdown's framed top
' border sits at y = 1 (menubar row is y = 0) so item 0 occupies
' y = 2, item 1 occupies y = 3, etc. The horizontal bounds are
' [menuOffsetX, menuOffsetX + width).
FUNCTION dropdownItemAt(m AS Model, mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF m.MenuActive < 0 OR m.MenuActive >= LEN(m.Menus) THEN RETURN 0 - 1
    DIM items AS []MenuItem = m.Menus[m.MenuActive].Items
    ' Recompute the dropdown's drawn width — same formula as the
    ' renderer: max stripped label length + 2 inner padding, then
    ' plus 2 for the border.
    DIM maxW AS INTEGER = 0
    DIM ix AS INTEGER
    FOR ix = 0 TO LEN(items) - 1
        IF NOT items[ix].IsSep THEN
            DIM w AS INTEGER = LEN(menuStrip(items[ix].Label))
            IF w > maxW THEN maxW = w
        END IF
    NEXT ix
    IF maxW < 12 THEN maxW = 12
    DIM outerW AS INTEGER = maxW + 2 + 2
    DIM x0 AS INTEGER = menuOffsetX(m, m.MenuActive)
    IF mx < x0 OR mx >= x0 + outerW THEN RETURN 0 - 1
    ' Item rows start at y=2 (after menubar + dropdown top border).
    DIM row AS INTEGER = my - 2
    IF row < 0 OR row >= LEN(items) THEN RETURN 0 - 1
    IF items[row].IsSep THEN RETURN 0 - 1
    RETURN row
END FUNCTION

' tabAtX — translate a screen column on the tabs caption row to a
' tab index. Returns -1 if `mx` lands on filler dashes or the leading
' dash. Together with closeXOnTab() below, gives full tab hit-test.
FUNCTION tabAtX(m AS Model, mx AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        DIM x0 AS INTEGER = tabCellX(m, i)
        DIM x1 AS INTEGER = x0 + tabCellWidth(m, i)
        IF mx >= x0 AND mx < x1 THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' closeXOnTab — TRUE when the screen column `mx` lands exactly on
' the "✕" glyph for tab `i` (the second-to-last cell of its [...] box).
FUNCTION closeXOnTab(m AS Model, i AS INTEGER, mx AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= LEN(m.Tabs) THEN RETURN FALSE
    DIM x0 AS INTEGER = tabCellX(m, i)
    DIM xClose AS INTEGER = x0 + tabCellWidth(m, i) - 3
    IF mx = xClose THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' treeNodeAt — return the TreeNodes index the user clicked on, or -1
' if the click landed outside the tree's content area.
'
' Coordinate layout: View() composes menubar (y=0), body (y=1..h-2),
' statusbar (y=h-1). Left pane is `titledBox` at body x=0 — top row
' at y=1, body content rows start at y=2 and span `bodyH-2` lines
' (the bodyBox has BorderTop=FALSE so its first row IS the first
' tree row). Left border is at x=0, right border at x=leftW-1.
FUNCTION treeNodeAt(m AS Model, mx AS INTEGER, my AS INTEGER, leftW AS INTEGER, bodyH AS INTEGER) AS INTEGER
    IF mx < 1 OR mx >= leftW - 1 THEN RETURN 0 - 1
    DIM row AS INTEGER = my - 2
    IF row < 0 THEN RETURN 0 - 1
    DIM idx AS INTEGER = m.TreeOffset + row
    IF idx < 0 OR idx >= LEN(m.TreeNodes) THEN RETURN 0 - 1
    ' Visible-rows cap so clicks below the last drawn row don't
    ' resolve to a phantom node.
    IF row >= bodyH - 2 THEN RETURN 0 - 1
    RETURN idx
END FUNCTION

' renderDropdown — produce the framed dropdown for the active menu.
' Items get hotkey emphasis; the cursor row inverts colors. Separators
' render as a horizontal line spanning the dropdown's inner width.
FUNCTION renderDropdown(m AS Model) AS STRING
    IF m.MenuActive < 0 OR m.MenuActive >= LEN(m.Menus) THEN RETURN ""
    DIM items AS []MenuItem = m.Menus[m.MenuActive].Items
    ' Compute width = max item label length + padding.
    DIM maxW AS INTEGER = 0
    DIM ix AS INTEGER
    FOR ix = 0 TO LEN(items) - 1
        IF NOT items[ix].IsSep THEN
            DIM w AS INTEGER = LEN(menuStrip(items[ix].Label))
            IF w > maxW THEN maxW = w
        END IF
    NEXT ix
    IF maxW < 12 THEN maxW = 12
    DIM inner AS INTEGER = maxW + 2

    DIM rowBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM rowHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM selHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM sepStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cBorder))

    DIM lines AS []STRING
    DIM j AS INTEGER
    FOR j = 0 TO LEN(items) - 1
        IF items[j].IsSep THEN
            lines = APPEND(lines, sepStyle.Render(strings.Repeat("─", inner)))
        ELSE
            DIM bs AS lipgloss.Style = rowBase
            DIM hot  AS lipgloss.Style = rowHot
            IF j = m.MenuItemIdx THEN
                bs = selBase
                hot  = selHot
            END IF
            DIM rendered AS STRING = renderMenuLabel(items[j].Label, bs, hot)
            DIM cur AS INTEGER = lipgloss.Width(rendered)
            ' Left-pad 1, right-pad to width.
            DIM padR AS INTEGER = inner - 1 - cur
            IF padR < 0 THEN padR = 0
            lines = APPEND(lines, bs.Render(" ") + rendered + bs.Render(strings.Repeat(" ", padR)))
        END IF
    NEXT j
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg))
    RETURN frame.Render(body)
END FUNCTION

' hintCell — render one " KEY=label" cell with the key in the hotkey
' colour and the label in dim menubar text. Used by renderStatusBar
' to build the right-aligned VBDOS-style strip.
FUNCTION hintCell(key AS STRING, label AS STRING) AS STRING
    DIM keyStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE)
    DIM lblStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    RETURN keyStyle.Render(key) + lblStyle.Render(" " + label)
END FUNCTION

' renderStatusBar — bottom row. Layout: status message on the left,
' optional cursor-position chip in the middle, key-hint strip on
' the right. The status text truncates with an ellipsis when it
' would overflow into the position/hints segments so those remain
' readable at any width.
FUNCTION renderStatusBar(width AS INTEGER, text AS STRING, pos AS STRING) AS STRING
    DIM barBg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg))
    DIM msgStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cStatusFg)).Italic(TRUE)
    DIM posStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)

    ' Build the hint strip. Each cell is two spaces apart.
    DIM hints AS STRING = ""
    hints = hints + hintCell("F5", "Run")    + barBg.Render("  ")
    hints = hints + hintCell("F8", "Check")  + barBg.Render("  ")
    hints = hints + hintCell("F10", "Menu")  + barBg.Render("  ")
    hints = hints + hintCell("F12", "Out")   + barBg.Render("  ")
    hints = hints + hintCell("^S", "Save")   + barBg.Render("  ")
    hints = hints + hintCell("^F", "Find")   + barBg.Render("  ")
    hints = hints + hintCell("^O", "Open")   + barBg.Render("  ")
    hints = hints + hintCell("^W", "Close")
    DIM hintsW AS INTEGER = lipgloss.Width(hints)

    ' Position chip — rendered when caller passes a non-empty `pos`.
    DIM posCell AS STRING = ""
    IF pos <> "" THEN
        posCell = posStyle.Render(" " + pos + " ") + barBg.Render("  ")
    END IF
    DIM posW AS INTEGER = lipgloss.Width(posCell)

    ' Status message, truncated to the remaining width.
    DIM msgRaw AS STRING = " " + text + " "
    DIM avail AS INTEGER = width - hintsW - posW - 1
    IF avail < 4 THEN avail = 4
    IF lipgloss.Width(msgRaw) > avail THEN
        msgRaw = Mid(msgRaw, 1, avail - 1) + "…"
    END IF
    DIM msgPadded AS STRING = msgStyle.Render(msgRaw) + barBg.Render(strings.Repeat(" ", avail - lipgloss.Width(msgRaw)))

    ' If the terminal is too narrow for any hints, just show the
    ' status message stretched the full width.
    IF width < hintsW + posW + 6 THEN
        RETURN msgStyle.Width(width).Render(" " + text)
    END IF
    RETURN msgPadded + posCell + hints
END FUNCTION

' titledBox — render `body` inside a bordered panel with `title`
' embedded in the top border. Mirrors the original DBtui's panel
' style. `focused` selects the border style: TRUE → square corners
' (the focused panel), FALSE → rounded corners (unfocused panel).
FUNCTION titledBox(title AS STRING, body AS STRING, width AS INTEGER, height AS INTEGER, focused AS BOOLEAN) AS STRING
    DIM tl AS STRING = "╭"
    DIM tr AS STRING = "╮"
    DIM borderObj AS lipgloss.Border = lipgloss.RoundedBorder()
    IF focused THEN
        tl = "┌"
        tr = "┐"
        borderObj = lipgloss.NormalBorder()
    END IF
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Italic(TRUE)
    ' Top row: "{tl}─ title ──...──{tr}" (width chars total)
    DIM titleLen AS INTEGER = lipgloss.Width(" " + title + " ")
    DIM dashLen  AS INTEGER = width - 2 - 1 - titleLen
    IF dashLen < 0 THEN dashLen = 0
    DIM top AS STRING = borderStyle.Render(tl + "─") + titleStyle.Render(" " + title + " ") + borderStyle.Render(strings.Repeat("─", dashLen) + tr)
    ' Body box. Width(width) → total visible width includes borders.
    DIM bodyBox AS lipgloss.Style = lipgloss.NewStyle().Border(borderObj).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).Width(width).Height(height - 1)
    RETURN top + "\n" + bodyBox.Render(body)
END FUNCTION

' nodeGlyph — the leading symbol for a tree row. "▾" = expanded folder,
' "▸" = collapsed folder, "◇" = leaf file. Matches the original DBtui.
FUNCTION nodeGlyph(m AS Model, n AS TreeNode) AS STRING
    IF n.IsDir THEN
        IF isExpanded(m, n.Path) THEN RETURN "▾"
        RETURN "▸"
    END IF
    RETURN "◇"
END FUNCTION

' renderTreeBody — produce the multi-line, indented + glyphed body for
' the tree. Row priority:
'   selected → solid accent bar
'   hovered  → subtle border-bg tint
'   default  → fg on background
FUNCTION renderTreeBody(m AS Model, innerW AS INTEGER, innerH AS INTEGER) AS STRING
    IF innerW < 1 THEN innerW = 1
    DIM cursorStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#2d4f67")).Foreground(lipgloss.Color(cFg)).Bold(TRUE).Width(innerW)
    DIM hoverStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cFg)).Width(innerW)
    DIM defStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(innerW)
    ' Resolve the hovered row ONCE. treeNodeAt expects the left-pane
    ' width and bodyH = innerH + 2 (it strips the title row + bottom
    ' border).
    DIM hoverRow AS INTEGER = treeNodeAt(m, m.HoverX, m.HoverY, m.LeftW, innerH + 2)
    DIM lines AS []STRING
    DIM total AS INTEGER = LEN(m.TreeNodes)
    DIM startI AS INTEGER = m.TreeOffset
    IF startI < 0 THEN startI = 0
    DIM endI AS INTEGER = startI + innerH
    IF endI > total THEN endI = total
    DIM i AS INTEGER
    FOR i = startI TO endI - 1
        DIM n AS TreeNode = m.TreeNodes[i]
        DIM indent AS STRING = strings.Repeat("  ", n.Depth)
        DIM line   AS STRING = indent + nodeGlyph(m, n) + " " + n.Name
        IF i = m.TreeSelected THEN
            lines = APPEND(lines, cursorStyle.Render(line))
        ELSEIF i = hoverRow THEN
            lines = APPEND(lines, hoverStyle.Render(line))
        ELSE
            lines = APPEND(lines, defStyle.Render(line))
        END IF
    NEXT i
    ' Pad with empty rows so the box always renders innerH lines.
    DO WHILE LEN(lines) < innerH
        lines = APPEND(lines, defStyle.Render(""))
    LOOP
    RETURN strings.Join(lines, "\n")
END FUNCTION

' renderLeftPane — Project tree column. The border style follows
' keyboard focus: square-corner = focused, rounded = unfocused.
FUNCTION renderLeftPane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    ' titledBox renders a top row + 3-sided body box. The body box's
    ' inner area is (width-2) chars wide × (height-2) rows tall.
    DIM body AS STRING = renderTreeBody(m, width - 2, height - 2)
    DIM treeFocused AS BOOLEAN = (m.FocusedPane = "tree")
    RETURN titledBox("Project", body, width, height, treeFocused)
END FUNCTION

' tabLabel — display label for tab `i`: basename, dirty-prefixed with
' "*" when unsaved. Centralised so render + hit-test math agree on
' visible-cell width.
FUNCTION tabLabel(m AS Model, i AS INTEGER) AS STRING
    IF i < 0 OR i >= LEN(m.Tabs) THEN RETURN ""
    DIM marker AS STRING = ""
    IF m.Tabs[i].Dirty THEN marker = "*"
    RETURN marker + baseName(m.Tabs[i].Path)
END FUNCTION

' tabCellWidth — total visible cells one tab occupies on the caption
' row. Format is "[ LABEL ✕ ]" so it's lipgloss.Width(label) + 6 (one
' bracket, space, label, space, glyph, space, bracket = 6 fixed).
FUNCTION tabCellWidth(m AS Model, i AS INTEGER) AS INTEGER
    RETURN lipgloss.Width(tabLabel(m, i)) + 6
END FUNCTION

' tabCellX — leading X offset (in cells) where tab `i`'s "[" sits.
' Caption begins with one "─" so the first tab starts at column 1.
FUNCTION tabCellX(m AS Model, i AS INTEGER) AS INTEGER
    DIM x AS INTEGER = 1
    DIM j AS INTEGER
    FOR j = 0 TO i - 1
        x = x + tabCellWidth(m, j)
    NEXT j
    RETURN x
END FUNCTION

' renderTabsCaption — caption row when in code mode with at least one
' tab: leading dash, "[ name ✕ ]" per tab (active one accented), then
' filler dashes to width. Replaces the plain captionin code mode so
' the tabs and the right pane's [Widgets][Tools] strip share a row.
FUNCTION renderTabsCaption(m AS Model, width AS INTEGER) AS STRING
    DIM dashStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM defBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM actBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM closeStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cHotkey))

    DIM out AS STRING = dashStyle.Render("─")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        DIM bs AS lipgloss.Style = defBase
        IF i = m.TabIdx THEN bs = actBase
        out = out + dashStyle.Render("[") + bs.Render(" " + tabLabel(m, i) + " ") + closeStyle.Render("✕") + dashStyle.Render(" ]")
    NEXT i
    RETURN padRight(out, width, dashStyle.Render("─"))
END FUNCTION

' renderMiddlePane — editor area. No outer panel frame in the original
' DBtui; just a caption line + the editor surface beneath. In form
' mode the caption is a single "Form Designer" title; in code mode
' the caption becomes the tab strip (rendered by renderTabsCaption).
FUNCTION renderMiddlePane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    DIM dashStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)

    ' --- Caption -----------------------------------------------------
    DIM caption AS STRING
    IF m.ViewMode = "code" AND LEN(m.Tabs) > 0 THEN
        caption = renderTabsCaption(m, width)
    ELSEIF m.ViewMode = "code" THEN
        caption = padRight(dashStyle.Render("─[ ") + titleStyle.Render("Code Editor") + dashStyle.Render(" ]"), width, dashStyle.Render("─"))
    ELSE
        caption = padRight(dashStyle.Render("─[ ") + titleStyle.Render("Form Designer — frmStart") + dashStyle.Render(" ]"), width, dashStyle.Render("─"))
    END IF

    ' --- Body --------------------------------------------------------
    DIM bodyH AS INTEGER = height - 1
    IF bodyH < 1 THEN bodyH = 1
    DIM bodyStr AS STRING
    IF m.ViewMode = "code" AND hasActiveTab(m) THEN
        ' Prefer the cached textarea View() — refreshEditorCache
        ' is the only place that calls the (expensive) live View().
        ' Fall back to live render when the cache is stale or empty
        ' so correctness is never sacrificed for the perf win.
        IF m.EditorCacheView <> "" AND NOT m.EditorCacheDirty AND m.EditorCacheW = width AND m.EditorCacheH = bodyH THEN
            bodyStr = m.EditorCacheView
        ELSE
            m.Tabs[m.TabIdx].Editor.SetWidth(width)
            m.Tabs[m.TabIdx].Editor.SetHeight(bodyH)
            bodyStr = m.Tabs[m.TabIdx].Editor.View()
        END IF
    ELSEIF m.ViewMode = "code" THEN
        DIM emptyStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(bodyH).Align(lipgloss.Center, lipgloss.Center)
        bodyStr = emptyStyle.Render("(no files open — pick one from the tree)")
    ELSE
        DIM placeholder AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(bodyH).Align(lipgloss.Center, lipgloss.Center)
        bodyStr = placeholder.Render("(form designer — coming soon; press F7 or Enter on a tree file to code)")
    END IF
    RETURN caption + "\n" + bodyStr
END FUNCTION

' rightPaneWidgets / rightPaneTools — the two label strings, kept as
' module-level constants so the render and hit-test code share one
' source of truth on their visible widths.
CONST rpLeftPad AS STRING  = "[ "
CONST rpTabSep  AS STRING  = " ] [ "
CONST rpRightPad AS STRING = " ]"

' rightTabsBounds — return the [start,end) screen-cell ranges for the
' [Widgets] and [Tools] tab labels on the right-pane caption row.
' `xOrigin` is the absolute X where the right pane starts. The tab
' strip is right-aligned so the labels sit flush against
' `xOrigin + width`. Order returned: wStart, wEnd, tStart, tEnd.
FUNCTION rightTabsBounds(xOrigin AS INTEGER, width AS INTEGER, widgetsLabel AS STRING, toolsLabel AS STRING) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM full AS STRING = rpLeftPad + widgetsLabel + rpTabSep + toolsLabel + rpRightPad
    DIM totalW AS INTEGER = lipgloss.Width(full)
    DIM stripX AS INTEGER = xOrigin + width - totalW
    DIM wX0 AS INTEGER = stripX + lipgloss.Width(rpLeftPad)
    DIM wX1 AS INTEGER = wX0 + lipgloss.Width(widgetsLabel)
    DIM tX0 AS INTEGER = wX1 + lipgloss.Width(rpTabSep)
    DIM tX1 AS INTEGER = tX0 + lipgloss.Width(toolsLabel)
    RETURN wX0, wX1, tX0, tX1
END FUNCTION

' renderRightPane — Widgets/Tools tabs strip + Widgets list, stacked
' over a Properties box. Both panels unfocused → rounded corners.
' The tabs row is right-aligned so "[ Widgets ] [ Tools ]" sits flush
' against the trailing dashes of the middle pane's caption (matching
' the original DBtui).
'
' `xOrigin` is the absolute screen-X where this pane starts; we need
' it to translate the per-region hover position back to local rows.
FUNCTION renderRightPane(m AS Model, width AS INTEGER, height AS INTEGER, xOrigin AS INTEGER) AS STRING
    DIM dashStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM tabStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM hovTabStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Underline(TRUE)
    DIM bracket  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))

    ' --- Tab strip ---------------------------------------------------
    DIM widgetsLbl AS STRING = "Widgets"
    DIM toolsLbl   AS STRING = "Tools"
    DIM wS AS INTEGER
    DIM wE AS INTEGER
    DIM tS AS INTEGER
    DIM tE AS INTEGER
    wS, wE, tS, tE = rightTabsBounds(xOrigin, width, widgetsLbl, toolsLbl)
    ' Pick per-label style based on hover.
    DIM widgetsStyled AS lipgloss.Style = tabStyle
    DIM toolsStyled   AS lipgloss.Style = tabStyle
    IF m.HoverY = 1 AND m.HoverX >= wS AND m.HoverX < wE THEN widgetsStyled = hovTabStyle
    IF m.HoverY = 1 AND m.HoverX >= tS AND m.HoverX < tE THEN toolsStyled   = hovTabStyle
    DIM tabLabels AS STRING = bracket.Render(rpLeftPad) + widgetsStyled.Render(widgetsLbl) + bracket.Render(rpTabSep) + toolsStyled.Render(toolsLbl) + bracket.Render(rpRightPad)
    DIM dashW AS INTEGER = width - lipgloss.Width(tabLabels)
    IF dashW < 0 THEN dashW = 0
    DIM tabs AS STRING = dashStyle.Render(strings.Repeat("─", dashW)) + tabLabels

    ' --- Pane geometry -----------------------------------------------
    DIM remain  AS INTEGER = height - 1
    DIM listH   AS INTEGER = remain / 2
    DIM propsH  AS INTEGER = remain - listH

    ' --- Widgets list (placeholder rows; hover restyles per row) -----
    ' The listBox has a rounded border so the inner area is (width-2)
    ' chars wide × (listH-2) rows tall. Its top border sits at body
    ' y = 2 (menubar y=0, tabs y=1), so list rows occupy y = 3..3+listH-3.
    DIM widgetNames AS []STRING
    widgetNames = APPEND(widgetNames, "Button")
    widgetNames = APPEND(widgetNames, "Checkbox")
    widgetNames = APPEND(widgetNames, "CodeEditor")
    widgetNames = APPEND(widgetNames, "ComboBox")
    widgetNames = APPEND(widgetNames, "FormCanvas")
    DIM listInnerW AS INTEGER = width - 2
    DIM listFirstY AS INTEGER = 3
    DIM listVisible AS INTEGER = listH - 2
    DIM listRowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(listInnerW)
    DIM listHoverStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Width(listInnerW)
    DIM listLines AS []STRING
    DIM li AS INTEGER
    FOR li = 0 TO listVisible - 1
        DIM txt AS STRING = ""
        IF li < LEN(widgetNames) THEN txt = " " + widgetNames[li]
        DIM rowY AS INTEGER = listFirstY + li
        IF m.HoverY = rowY AND m.HoverX > xOrigin AND m.HoverX < xOrigin + width - 1 AND li < LEN(widgetNames) THEN
            listLines = APPEND(listLines, listHoverStyle.Render(txt))
        ELSE
            listLines = APPEND(listLines, listRowStyle.Render(txt))
        END IF
    NEXT li
    DIM listBody AS STRING = strings.Join(listLines, "\n")
    DIM listBox  AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cBorder)).Width(width).Height(listH)

    ' --- Properties panel (placeholder rows; hover restyle per row) --
    ' titledBox draws title at the top of the panel, so property rows
    ' start one cell below that. The panel begins at y = 2 + listH;
    ' first row sits at y = 2 + listH + 1.
    DIM propRows AS []STRING
    propRows = APPEND(propRows, "Name      lblTitle")
    propRows = APPEND(propRows, "Visible   [x] true")
    propRows = APPEND(propRows, "Text      Label")
    DIM propsInnerW AS INTEGER = width - 2
    DIM propsFirstY AS INTEGER = 2 + listH + 1
    DIM propsVisible AS INTEGER = propsH - 2
    DIM propRowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(propsInnerW)
    DIM propHoverStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Width(propsInnerW)
    DIM propLines AS []STRING
    DIM pi AS INTEGER
    FOR pi = 0 TO propsVisible - 1
        DIM ptxt AS STRING = ""
        IF pi < LEN(propRows) THEN ptxt = " " + propRows[pi]
        DIM propY AS INTEGER = propsFirstY + pi
        IF m.HoverY = propY AND m.HoverX > xOrigin AND m.HoverX < xOrigin + width - 1 AND pi < LEN(propRows) THEN
            propLines = APPEND(propLines, propHoverStyle.Render(ptxt))
        ELSE
            propLines = APPEND(propLines, propRowStyle.Render(ptxt))
        END IF
    NEXT pi
    DIM propsBody   AS STRING = strings.Join(propLines, "\n")
    DIM propsTitled AS STRING = titledBox("Properties", propsBody, width, propsH, FALSE)

    RETURN lipgloss.JoinVertical(lipgloss.Left, tabs, listBox.Render(listBody), propsTitled)
END FUNCTION

' -------------------------------------------------------------------------
' renderModal — build the centered confirmation dialog string.
'
' Returns "" when no modal is currently active. Otherwise returns a
' rounded-border box containing the title (highlighted), one or more
' message lines (word-wrapped to a reasonable width), and a row of
' buttons with the currently-selected button inverted.
'
' The composition is done with lipgloss styles only — placement
' (centering) is handled in View() via the lipgloss.Compositor, so
' this helper only needs to worry about the *contents* of the box.
' -------------------------------------------------------------------------
FUNCTION renderModal(m AS Model) AS STRING
    IF NOT m.ModalActive THEN RETURN ""

    ' --- Dimensions -----------------------------------------------
    ' A simple readable width that fits typical confirm-dialog text
    ' without spanning the whole screen.
    DIM innerW AS INTEGER = 48

    ' --- Title row ------------------------------------------------
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Bold(TRUE).Foreground(lipgloss.Color(cHotkey)).Width(innerW).Align(lipgloss.Center)
    DIM titleLine AS STRING = titleStyle.Render(m.ModalTitle)

    ' --- Message body --------------------------------------------
    ' Two-pass layout: explicit \n line breaks are preserved (so
    ' multi-line compiler output renders verbatim); any single line
    ' wider than innerW gets soft-wrapped on spaces.
    DIM msgLines AS []STRING
    DIM rawLines AS []STRING = strings.Split(m.ModalMessage, "\n")
    DIM rl AS INTEGER
    FOR rl = 0 TO LEN(rawLines) - 1
        DIM rawLine AS STRING = rawLines[rl]
        IF rawLine = "" THEN
            msgLines = APPEND(msgLines, "")
        ELSEIF lipgloss.Width(rawLine) <= innerW THEN
            msgLines = APPEND(msgLines, rawLine)
        ELSE
            DIM words AS []STRING = strings.Fields(rawLine)
            DIM cur AS STRING = ""
            DIM wi AS INTEGER
            FOR wi = 0 TO LEN(words) - 1
                DIM word AS STRING = words[wi]
                IF cur = "" THEN
                    cur = word
                ELSEIF LEN(cur) + 1 + LEN(word) <= innerW THEN
                    cur = cur + " " + word
                ELSE
                    msgLines = APPEND(msgLines, cur)
                    cur = word
                END IF
            NEXT wi
            IF cur <> "" THEN msgLines = APPEND(msgLines, cur)
        END IF
    NEXT rl

    DIM bodyStyle AS lipgloss.Style = lipgloss.NewStyle().Width(innerW)
    DIM bodyText AS STRING = strings.Join(msgLines, "\n")
    DIM bodyBlock AS STRING = bodyStyle.Render(bodyText)

    ' --- Button row ----------------------------------------------
    ' Each button is rendered as " label "; the active one (matching
    ' ModalIdx) is reverse-video so it reads as the default action.
    DIM btnNormal AS lipgloss.Style = lipgloss.NewStyle().Padding(0, 1).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cBorder))
    DIM btnActive AS lipgloss.Style = lipgloss.NewStyle().Padding(0, 1).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cHotkey)).Foreground(lipgloss.Color(cBg)).Background(lipgloss.Color(cHotkey)).Bold(TRUE)

    ' --- Footer: either an input field (input mode) or button row -
    DIM footer AS STRING = ""
    IF m.ModalIsInput THEN
        m.ModalInput.SetWidth(innerW)
        DIM inputBox AS lipgloss.Style = lipgloss.NewStyle().Width(innerW).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent))
        footer = inputBox.Render(m.ModalInput.View())
    ELSE
        DIM rendered AS []STRING
        DIM bi AS INTEGER
        FOR bi = 0 TO LEN(m.ModalButtons) - 1
            DIM lbl AS STRING = m.ModalButtons[bi]
            IF bi = m.ModalIdx THEN
                rendered = APPEND(rendered, btnActive.Render(lbl))
            ELSE
                rendered = APPEND(rendered, btnNormal.Render(lbl))
            END IF
        NEXT bi
        ' DBasic doesn't support variadic spread (xs...), so dispatch
        ' by button count. Real dialogs only ever have 1–3 buttons.
        DIM btnRow AS STRING = ""
        IF LEN(rendered) = 1 THEN
            btnRow = rendered[0]
        ELSEIF LEN(rendered) = 2 THEN
            btnRow = lipgloss.JoinHorizontal(lipgloss.Top, rendered[0], "  ", rendered[1])
        ELSEIF LEN(rendered) >= 3 THEN
            btnRow = lipgloss.JoinHorizontal(lipgloss.Top, rendered[0], "  ", rendered[1], "  ", rendered[2])
        END IF
        footer = lipgloss.NewStyle().Width(innerW).Align(lipgloss.Center).Render(btnRow)
    END IF

    ' --- Stack title / body / spacer / footer --------------------
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, titleLine, "", bodyBlock, "", footer)

    ' --- Outer frame ---------------------------------------------
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cHotkey)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    RETURN frame.Render(stacked)
END FUNCTION

' -------------------------------------------------------------------------
' renderBottomPane — bordered pane showing the tail of BottomBody.
' Always shows the most recent lines that fit; long output scrolls
' the old lines off the top. Title (e.g. "Output") sits in the
' top border like other titledBoxes.
' -------------------------------------------------------------------------
FUNCTION renderBottomPane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    DIM title AS STRING = m.BottomTitle
    IF title = "" THEN title = "Output"
    DIM rawLines AS []STRING = strings.Split(m.BottomBody, "\n")
    ' Inner area height inside titledBox: height - 2 (top title row +
    ' bottom border). Show the last N lines that fit.
    DIM visible AS INTEGER = height - 2
    IF visible < 1 THEN visible = 1
    DIM startI AS INTEGER = 0
    IF LEN(rawLines) > visible THEN startI = LEN(rawLines) - visible
    DIM showLines AS []STRING
    DIM i AS INTEGER
    FOR i = startI TO LEN(rawLines) - 1
        showLines = APPEND(showLines, rawLines[i])
    NEXT i
    DIM body AS STRING = strings.Join(showLines, "\n")
    RETURN titledBox(title, body, width, height, FALSE)
END FUNCTION

' -------------------------------------------------------------------------
' View — compose the full screen each frame.
' -------------------------------------------------------------------------

FUNCTION (m AS Model) View() AS tea.View
    ' Fallback defaults on first tick (before WindowSizeMsg).
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24

    ' Column widths come from Model — splitter drag and Alt+arrows
    ' adjust LeftW / RightW; clampSplitters keeps them sane.
    DIM leftW  AS INTEGER = m.LeftW
    DIM rightW AS INTEGER = m.RightW
    DIM midW   AS INTEGER = w - leftW - rightW
    IF midW < 20 THEN midW = 20

    ' Reserve a fixed slice of the screen for the bottom output
    ' pane when it's visible. The main body shrinks to compensate.
    DIM bottomH AS INTEGER = 0
    IF m.BottomVisible THEN
        bottomH = 10
        IF bottomH > h - 6 THEN bottomH = h - 6
        IF bottomH < 3 THEN bottomH = 3
    END IF
    ' Body height = total minus menu (1), statusbar (1), bottom pane.
    DIM bodyH AS INTEGER = h - 2 - bottomH
    IF bodyH < 4 THEN bodyH = 4

    ' Cursor position chip — shown only when actively editing code.
    DIM posStr AS STRING = ""
    IF m.ViewMode = "code" AND hasActiveTab(m) THEN
        DIM curLine AS INTEGER = m.Tabs[m.TabIdx].Editor.Line() + 1
        DIM curCol  AS INTEGER = m.Tabs[m.TabIdx].Editor.Column() + 1
        posStr = fmt.Sprintf("Ln %d Col %d", curLine, curCol)
    END IF
    DIM menu  AS STRING = renderMenuBar(m, w)
    DIM stat  AS STRING = renderStatusBar(w, m.Status, posStr)
    DIM left  AS STRING = renderLeftPane(m, leftW, bodyH)
    DIM mid   AS STRING = renderMiddlePane(m, midW, bodyH)
    DIM right AS STRING = renderRightPane(m, rightW, bodyH, leftW + midW)
    DIM body  AS STRING = lipgloss.JoinHorizontal(lipgloss.Top, left, mid, right)
    DIM full  AS STRING
    IF bottomH > 0 THEN
        DIM bottomPane AS STRING = renderBottomPane(m, w, bottomH)
        full = lipgloss.JoinVertical(lipgloss.Left, menu, body, bottomPane, stat)
    ELSE
        full = lipgloss.JoinVertical(lipgloss.Left, menu, body, stat)
    END IF

    ' Active menu — overlay the dropdown on top of `full` at the right
    ' X offset under the menu cell. Uses lipgloss.Compositor so the
    ' base composition is unchanged.
    IF m.MenuActive >= 0 THEN
        DIM dd AS STRING = renderDropdown(m)
        IF dd <> "" THEN
            DIM bgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(full)
            DIM ddLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dd).X(menuOffsetX(m, m.MenuActive)).Y(1).Z(1)
            DIM comp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgLayer, ddLayer)
            full = comp.Render()
        END IF
    END IF

    ' --- Loading overlay (Z=3, above modal and dropdown) ----------
    ' Shown while an async openFile is in flight. Small framed box
    ' centered on the screen so the user knows their click landed
    ' even when the file is too large to load instantly.
    IF m.Loading <> "" THEN
        DIM ldText AS STRING = "Loading " + m.Loading + "..."
        DIM ldBox AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Padding(0, 3)
        DIM ldOut AS STRING = ldBox.Render(ldText)
        DIM ldW AS INTEGER = lipgloss.Width(ldOut)
        DIM ldH AS INTEGER = lipgloss.Height(ldOut)
        DIM ldX AS INTEGER = (w - ldW) / 2
        DIM ldY AS INTEGER = (h - ldH) / 2
        IF ldX < 0 THEN ldX = 0
        IF ldY < 0 THEN ldY = 0
        DIM bgL AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(full)
        DIM ldL AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(ldOut).X(ldX).Y(ldY).Z(3)
        DIM ldComp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgL, ldL)
        full = ldComp.Render()
    END IF

    ' --- Modal overlay (Z=2 so it floats above an open dropdown) ---
    ' Centered on the visible screen using lipgloss.Width / Height
    ' for visible-cell math (the box uses multi-byte border chars).
    IF m.ModalActive THEN
        DIM md AS STRING = renderModal(m)
        IF md <> "" THEN
            DIM mdW AS INTEGER = lipgloss.Width(md)
            DIM mdH AS INTEGER = lipgloss.Height(md)
            DIM xOff AS INTEGER = (w - mdW) / 2
            DIM yOff AS INTEGER = (h - mdH) / 2
            IF xOff < 0 THEN xOff = 0
            IF yOff < 0 THEN yOff = 0
            DIM bgLayer2 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(full)
            DIM mdLayer  AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(md).X(xOff).Y(yOff).Z(2)
            DIM comp2 AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgLayer2, mdLayer)
            full = comp2.Render()
        END IF
    END IF

    DIM v AS tea.View = tea.NewView(full)
    v.AltScreen = TRUE
    v.MouseMode = tea.MouseModeAllMotion
    RETURN v
END FUNCTION

' -------------------------------------------------------------------------
' Main — wire up bubbletea and run.
' -------------------------------------------------------------------------

SUB Main()
    DIM model AS Model = newModel()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(model, tea.WithoutSignalHandler())
    DIM final AS tea.Model
    DIM err AS ERROR
    final, err = prog.Run()
    IF err <> NIL THEN
        fmt.Fprintln(os.Stderr, "DBtui error:", err)
        os.Exit(1)
    END IF
    _ = final
END SUB
