
' -------------------------------------------------------------------------
' Run / Check — shell out to the `dbasic` CLI on the active tab.
'
' "Run" uses tea.ExecProcess so the child program gets the full terminal
' (interactive output, colour, raw keys). bubbletea suspends, the child
' runs to completion, then bubbletea resumes and dispatches
' RunFinishedMsg with the exit error (or NIL on success).
'
' "Check" runs synchronously — `dbasic check` is quick (~100ms) and we
' want the result inline in the IDE rather than taking over the screen.
' On failure the (truncated) compiler output goes into a popup modal.
' -------------------------------------------------------------------------

' -------------------------------------------------------------------------
' Bottom output pane helpers.
'
' The pane stores its accumulated text in m.BottomBody and a short
' caption in m.BottomTitle. appendBottomOutput is the chokepoint for
' anything that wants to write into the pane — it joins on newlines,
' updates the title, and auto-shows the pane so the user sees the
' new content immediately.
' -------------------------------------------------------------------------

SUB appendBottomOutput(m AS POINTER TO Model, title AS STRING, content AS STRING)
    m.BottomTitle = title
    IF m.BottomBody = "" THEN
        m.BottomBody = content
    ELSE
        m.BottomBody = m.BottomBody + "\n" + content
    END IF
    m.BottomVisible = TRUE
    ' Editor area shrinks/grows when the bottom pane toggles, so the
    ' cached textarea view (which is sized for the *previous* height)
    ' is now stale.
    invalidateEditorCache(m)
END SUB

SUB toggleBottomPane(m AS POINTER TO Model)
    m.BottomVisible = NOT m.BottomVisible
    invalidateEditorCache(m)
END SUB

' clearBottomOutput — reset the pane to empty. Currently unused but
' kept on hand for a future "Clear" menu item.
SUB clearBottomOutput(m AS POINTER TO Model)
    m.BottomBody = ""
END SUB

' setBottomOutput — like appendBottomOutput but REPLACES the body
' instead of appending. Used by Find in Files where each run is a
' fresh result set, not an accumulating log.
SUB setBottomOutput(m AS POINTER TO Model, title AS STRING, content AS STRING)
    m.BottomTitle   = title
    m.BottomBody    = content
    m.BottomVisible = TRUE
    invalidateEditorCache(m)
END SUB

' parseFileLineRef — extract (path, lineNum) from a "path:line: ..."
' string. Returns (path, lineNum, TRUE) on success or ("", 0, FALSE).
FUNCTION parseFileLineRef(line AS STRING) AS (STRING, INTEGER, BOOLEAN)
    DIM c1 AS INTEGER = strings.Index(line, ":")
    IF c1 < 0 THEN RETURN "", 0, FALSE
    DIM after AS STRING = ""
    IF c1 + 1 < LEN(line) THEN after = Mid(line, c1 + 2, LEN(line) - c1 - 1)
    DIM c2 AS INTEGER = strings.Index(after, ":")
    IF c2 < 0 THEN RETURN "", 0, FALSE
    DIM pathPart AS STRING = ""
    IF c1 > 0 THEN pathPart = Mid(line, 1, c1)
    DIM numStr AS STRING = ""
    IF c2 > 0 THEN numStr = Mid(after, 1, c2)
    DIM n AS INTEGER
    DIM err AS ERROR
    n, err = strconv.Atoi(numStr)
    IF err <> NIL THEN RETURN "", 0, FALSE
    RETURN pathPart, n, TRUE
END FUNCTION

' doFindInFiles — case-insensitive substring search across every
' .dbas / .dbproj file under the project root. Writes the results
' (one "path:line: snippet" per match) to the bottom output pane.
SUB doFindInFiles(m AS POINTER TO Model, query AS STRING)
    DIM q AS STRING = strings.TrimSpace(query)
    IF q = "" THEN
        m.Status = "empty find query"
        RETURN
    END IF
    DIM files AS []STRING
    scanProjectFiles(m.TreeRoot, @files)
    DIM lo AS STRING = strings.ToLower(q)
    DIM out AS []STRING
    DIM count AS INTEGER = 0
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(files) - 1
        DIM path AS STRING = files[fi]
        DIM data AS BYTES
        DIM rerr AS ERROR
        data, rerr = os.ReadFile(path)
        IF rerr = NIL THEN
            DIM rel AS STRING = quickRelPath(m.TreeRoot, path)
            DIM lines AS []STRING = strings.Split(string(data), "\n")
            DIM li AS INTEGER
            FOR li = 0 TO LEN(lines) - 1
                IF strings.Contains(strings.ToLower(lines[li]), lo) THEN
                    out = APPEND(out, fmt.Sprintf("%s:%d: %s", rel, li + 1, strings.TrimSpace(lines[li])))
                    count = count + 1
                END IF
            NEXT li
        END IF
    NEXT fi
    DIM header AS STRING = fmt.Sprintf("[find] '%s' — %d hit(s) in %d files (click a result to jump)", q, count, LEN(files))
    DIM body AS STRING = header
    IF count > 0 THEN body = body + "\n" + strings.Join(out, "\n")
    setBottomOutput(m, "Find Results", body)
    m.Status = header
END SUB

TYPE RunFinishedMsg
    DIM Err AS ERROR
END TYPE

' runFinishedHandler — tea.ExecProcess callback. Wraps the child's
' exit error in a RunFinishedMsg so Update can react in the regular
' message-dispatch flow (status bar, future result panes, etc.).
FUNCTION runFinishedHandler(err AS ERROR) AS tea.Msg
    DIM msg AS RunFinishedMsg
    msg.Err = err
    RETURN msg
END FUNCTION

' runActiveNow — actually launch `dbasic run <path>` on the active
' tab. Pulled out of doRun so the "run-confirm" modal handler can
' invoke the same logic after the user picks Save & Run / Run As Is.
FUNCTION runActiveNow(m AS POINTER TO Model) AS tea.Cmd
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing to run"
        RETURN NIL
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    IF path = "" THEN
        m.Status = "save the buffer first (no on-disk path)"
        RETURN NIL
    END IF
    m.Status = "running: dbasic run " + path
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "run", path)
    RETURN tea.ExecProcess(cmd, runFinishedHandler)
END FUNCTION

' doRun — F5 entry point. In form mode, regenerates + runs the
' partner .dbas via doFormRun. In code mode, auto-prompts when
' the active tab is dirty so the user picks between "save and
' run", "run the on-disk version", or cancel.
FUNCTION doRun(m AS POINTER TO Model) AS tea.Cmd
    IF m.ViewMode = "form" THEN
        RETURN doFormRun(m)
    END IF
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing to run"
        RETURN NIL
    END IF
    IF m.Tabs[m.TabIdx].Dirty THEN
        DIM dn AS STRING = baseName(m.Tabs[m.TabIdx].Path)
        IF dn = "" THEN dn = "(untitled)"
        showModal(m, "Run", dn + " has unsaved changes.", "Save & Run,Run As Is,Cancel", "run-confirm")
        RETURN NIL
    END IF
    RETURN runActiveNow(m)
END FUNCTION

' truncateOutput — cap compiler output at ~12 lines so the modal
' stays readable. Appends a "...+N more lines" footer when the
' source is longer.
FUNCTION truncateOutput(s AS STRING, maxLines AS INTEGER) AS STRING
    DIM lines AS []STRING = strings.Split(s, "\n")
    IF LEN(lines) <= maxLines THEN RETURN s
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO maxLines - 1
        out = APPEND(out, lines[i])
    NEXT i
    out = APPEND(out, fmt.Sprintf("... +%d more lines", LEN(lines) - maxLines))
    RETURN strings.Join(out, "\n")
END FUNCTION

' doCheck — save + sync `dbasic check`. Output (success or failure)
' is appended to the bottom output pane, which auto-shows. Status
' bar gets a one-line summary so the user knows whether to look.
SUB doCheck(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN
        m.Status = "nothing to check"
        RETURN
    END IF
    saveCurrent(m)
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    m.Status = "checking " + path + "..."
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "check", path)
    DIM outBytes AS BYTES
    DIM err AS ERROR
    outBytes, err = cmd.CombinedOutput()
    DIM out AS STRING = strings.TrimSpace(string(outBytes))
    IF err = NIL THEN
        appendBottomOutput(m, "Output", "[check OK] " + path)
        m.Status = "check ok: " + path
        RETURN
    END IF
    IF out = "" THEN out = err.Error()
    appendBottomOutput(m, "Output", "[check FAIL] " + path + "\n" + out)
    m.Status = "check failed — see Output pane (F12)"
END SUB
