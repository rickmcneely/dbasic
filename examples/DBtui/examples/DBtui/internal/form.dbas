' =========================================================================
' Form designer — visual canvas + palette + hit-test + drag.
'
' v1 scope:
'   - Single in-memory Form on Model.
'   - Four widget kinds: Button / Label / TextInput / Checkbox.
'   - Click palette item → append widget at canvas (2, 1).
'   - Click widget on canvas → select.
'   - Drag selected widget → move (DragMode = "formMove").
'   - Selected widget highlighted; properties shown in right pane.
'
' Persistence + codegen come in a follow-up.
' =========================================================================

CONST formPaletteKinds AS INTEGER = 9   ' Button, Label, TextInput, Checkbox,
                                        ' RadioButton, ComboBox, ListBox,
                                        ' ProgressBar, ScrollBar

' formKindByIdx — fixed list of widget kinds in palette display order.
' The order is the order entries appear in the right-pane Widgets
' panel; index 0 = top of the palette.
FUNCTION formKindByIdx(i AS INTEGER) AS STRING
    IF i = 0 THEN RETURN "Button"
    IF i = 1 THEN RETURN "Label"
    IF i = 2 THEN RETURN "TextInput"
    IF i = 3 THEN RETURN "Checkbox"
    IF i = 4 THEN RETURN "RadioButton"
    IF i = 5 THEN RETURN "ComboBox"
    IF i = 6 THEN RETURN "ListBox"
    IF i = 7 THEN RETURN "ProgressBar"
    IF i = 8 THEN RETURN "ScrollBar"
    RETURN ""
END FUNCTION

' defaultWidget — produce a widget of the given kind with sensible
' default text / size / state; caller picks Name + (X, Y).
FUNCTION defaultWidget(kind AS STRING) AS DesignWidget
    DIM w AS DesignWidget
    w.Kind = kind
    w.W = 12
    w.H = 1
    IF kind = "Button" THEN
        w.Text = "Button"
    ELSEIF kind = "Label" THEN
        w.Text = "Label"
        w.W = 10
    ELSEIF kind = "TextInput" THEN
        w.Text = ""
        w.W = 16
    ELSEIF kind = "Checkbox" THEN
        w.Text = "option"
        w.W = 14
    ELSEIF kind = "RadioButton" THEN
        w.Text  = "option"
        w.W     = 14
        w.Group = "group1"
    ELSEIF kind = "ComboBox" THEN
        w.Text = "ComboBox"
        w.W = 16
        w.Items    = APPEND(w.Items, "red")
        w.Items    = APPEND(w.Items, "green")
        w.Items    = APPEND(w.Items, "blue")
        w.Selected = 0
    ELSEIF kind = "ListBox" THEN
        w.Text = "ListBox"
        w.W = 18
        w.H = 5
        w.Items    = APPEND(w.Items, "item one")
        w.Items    = APPEND(w.Items, "item two")
        w.Items    = APPEND(w.Items, "item three")
        w.Selected = 0
    ELSEIF kind = "ProgressBar" THEN
        w.Text = ""
        w.W    = 20
        w.Min  = 0
        w.Max  = 100
        w.Value = 40
    ELSEIF kind = "ScrollBar" THEN
        w.Text   = ""
        w.W      = 1
        w.H      = 8
        w.Min    = 0
        w.Max    = 100
        w.Value  = 0
        w.Orient = "v"
    END IF
    RETURN w
END FUNCTION

' formAddWidget — append a new widget of `kind` to the form, auto-name
' it, position at (2, 1). Selects the new widget.
SUB formAddWidget(m AS POINTER TO Model, kind AS STRING)
    DIM w AS DesignWidget = defaultWidget(kind)
    ' Auto-name: lower-case kind + index. E.g. "button1".
    DIM prefix AS STRING = strings.ToLower(kind)
    DIM n AS INTEGER = 1
    DO WHILE TRUE
        DIM cand AS STRING = prefix + strconv.Itoa(n)
        DIM clash AS BOOLEAN = FALSE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
            IF m.Tabs[m.TabIdx].Form.Widgets[i].Name = cand THEN clash = TRUE
        NEXT i
        IF NOT clash THEN
            w.Name = cand
            EXIT DO
        END IF
        n = n + 1
    LOOP
    w.X = 2
    w.Y = 1 + LEN(m.Tabs[m.TabIdx].Form.Widgets)
    IF w.Y < 1 THEN w.Y = 1
    m.Tabs[m.TabIdx].Form.Widgets = APPEND(m.Tabs[m.TabIdx].Form.Widgets, w)
    m.Tabs[m.TabIdx].SelWidget = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
    m.Status = "added " + w.Name
END SUB

' formDeleteSelected — drop the currently-selected widget.
SUB formDeleteSelected(m AS POINTER TO Model)
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM kept AS []DesignWidget
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        IF i <> m.Tabs[m.TabIdx].SelWidget THEN kept = APPEND(kept, m.Tabs[m.TabIdx].Form.Widgets[i])
    NEXT i
    m.Tabs[m.TabIdx].Form.Widgets = kept
    m.Tabs[m.TabIdx].SelWidget = 0 - 1
    m.Status = "widget deleted"
END SUB

' widgetVisibleText — single-line preview for a widget. Used by the
' generated code and by widgetVisibleLines for simple kinds.
FUNCTION widgetVisibleText(w AS DesignWidget) AS STRING
    IF w.Kind = "Button"    THEN RETURN "[ " + w.Text + " ]"
    IF w.Kind = "Label"     THEN RETURN w.Text
    IF w.Kind = "TextInput" THEN
        DIM inner AS STRING = w.Text
        IF LEN(inner) < w.W - 2 THEN inner = inner + strings.Repeat(" ", w.W - 2 - LEN(inner))
        RETURN "[" + inner + "]"
    END IF
    IF w.Kind = "Checkbox"    THEN RETURN "[ ] " + w.Text
    IF w.Kind = "RadioButton" THEN
        DIM rmark AS STRING = "( )"
        IF w.Checked THEN rmark = "(o)"
        RETURN rmark + " " + w.Text
    END IF
    IF w.Kind = "ComboBox" THEN
        DIM cur AS STRING = ""
        IF w.Selected >= 0 AND w.Selected < LEN(w.Items) THEN cur = w.Items[w.Selected]
        DIM cwid AS INTEGER = w.W - 4
        IF cwid < 1 THEN cwid = 1
        IF LEN(cur) > cwid THEN cur = Mid(cur, 1, cwid)
        IF LEN(cur) < cwid THEN cur = cur + strings.Repeat(" ", cwid - LEN(cur))
        RETURN "[" + cur + " v]"
    END IF
    IF w.Kind = "ProgressBar" THEN
        DIM pwid AS INTEGER = w.W - 2
        IF pwid < 1 THEN pwid = 1
        DIM rng AS INTEGER = w.Max - w.Min
        IF rng < 1 THEN rng = 1
        DIM filled AS INTEGER = (w.Value - w.Min) * pwid / rng
        IF filled < 0 THEN filled = 0
        IF filled > pwid THEN filled = pwid
        RETURN "[" + strings.Repeat("█", filled) + strings.Repeat("░", pwid - filled) + "]"
    END IF
    IF w.Kind = "ScrollBar" THEN
        ' Render a 1-cell-wide vertical scrollbar caret on the first
        ' line. widgetVisibleLines fills the rest of the height.
        RETURN "▲"
    END IF
    RETURN w.Text
END FUNCTION

' widgetVisibleLines — multi-row design-time render. ListBox spans
' H rows; ScrollBar spans H rows; everything else delegates to
' widgetVisibleText for one line. The canvas painter walks the
' returned slice and writes each row to the grid at (X, Y + i).
FUNCTION widgetVisibleLines(w AS DesignWidget) AS []STRING
    DIM lines AS []STRING
    IF w.Kind = "ListBox" THEN
        DIM h AS INTEGER = w.H
        IF h < 1 THEN h = 1
        DIM iwid AS INTEGER = w.W - 2
        IF iwid < 1 THEN iwid = 1
        DIM ri AS INTEGER
        FOR ri = 0 TO h - 1
            DIM item AS STRING = ""
            IF ri < LEN(w.Items) THEN item = w.Items[ri]
            IF LEN(item) > iwid THEN item = Mid(item, 1, iwid)
            IF LEN(item) < iwid THEN item = item + strings.Repeat(" ", iwid - LEN(item))
            DIM mark AS STRING = "  "
            IF ri = w.Selected THEN mark = "▶ "
            lines = APPEND(lines, mark + Mid(item, 1, iwid - 2))
        NEXT ri
    ELSEIF w.Kind = "ScrollBar" AND strings.ToLower(w.Orient) = "v" THEN
        DIM sh AS INTEGER = w.H
        IF sh < 3 THEN sh = 3
        DIM thumbPos AS INTEGER = 1
        DIM rng2 AS INTEGER = w.Max - w.Min
        IF rng2 > 0 THEN
            thumbPos = 1 + ((w.Value - w.Min) * (sh - 3)) / rng2
        END IF
        IF thumbPos < 1 THEN thumbPos = 1
        IF thumbPos > sh - 2 THEN thumbPos = sh - 2
        lines = APPEND(lines, "▲")
        DIM sj AS INTEGER
        FOR sj = 1 TO sh - 2
            IF sj = thumbPos THEN
                lines = APPEND(lines, "█")
            ELSE
                lines = APPEND(lines, "│")
            END IF
        NEXT sj
        lines = APPEND(lines, "▼")
    ELSE
        lines = APPEND(lines, widgetVisibleText(w))
    END IF
    RETURN lines
END FUNCTION

' widgetBox — bounding box of widget in canvas coordinates:
' (x0, y0, x1, y1) with x1/y1 exclusive.
FUNCTION widgetBox(w AS DesignWidget) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM txt AS STRING = widgetVisibleText(w)
    DIM ww AS INTEGER = lipgloss.Width(txt)
    IF w.W > ww THEN ww = w.W
    DIM hh AS INTEGER = w.H
    IF hh < 1 THEN hh = 1
    RETURN w.X, w.Y, w.X + ww, w.Y + hh
END FUNCTION

' formWidgetAt — index of the topmost widget whose box contains
' canvas coords (cx, cy), or -1 if none. Walks back-to-front so
' later (drawn-on-top) widgets win.
FUNCTION formWidgetAt(m AS Model, cx AS INTEGER, cy AS INTEGER) AS INTEGER
    IF NOT hasActiveTab(m) THEN RETURN 0 - 1
    DIM i AS INTEGER
    FOR i = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1 TO 0 STEP 0 - 1
        DIM x0 AS INTEGER
        DIM y0 AS INTEGER
        DIM x1 AS INTEGER
        DIM y1 AS INTEGER
        x0, y0, x1, y1 = widgetBox(m.Tabs[m.TabIdx].Form.Widgets[i])
        IF cx >= x0 AND cx < x1 AND cy >= y0 AND cy < y1 THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' formScreenToCanvas — translate screen coords to canvas coords
' assuming the canvas starts at (LeftW, 2) and we keep a 1-cell
' top margin for the title row.
FUNCTION formScreenToCanvas(m AS Model, sx AS INTEGER, sy AS INTEGER) AS (INTEGER, INTEGER)
    DIM cx AS INTEGER = sx - m.LeftW
    DIM cy AS INTEGER = sy - 2 - 1   ' minus caption (1) + title row (1)
    RETURN cx, cy
END FUNCTION

' renderFormCanvas — middle-pane body when ViewMode = "form".
' Renders the title row then paints each widget at its (X, Y).
FUNCTION renderFormCanvas(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    ' No active tab → return a blank canvas instead of crashing.
    IF NOT hasActiveTab(m) THEN
        DIM bg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(height).Align(lipgloss.Center, lipgloss.Center)
        RETURN bg.Render("(no form open — open a .dbproj from the tree)")
    END IF
    DIM cellBg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Width(width)
    DIM widStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    ' Build a grid of plain bg cells then overlay widgets char-by-char.
    DIM gridH AS INTEGER = height - 1   ' minus title row
    IF gridH < 1 THEN gridH = 1
    ' Loop vars hoisted — DBasic codegen drops re-DIM inside nested
    ' ELSEIF/FOR scopes, so we declare every loop iterator once.
    DIM r AS INTEGER
    DIM c AS INTEGER
    DIM grid AS [][]STRING
    FOR r = 0 TO gridH - 1
        DIM row AS []STRING
        FOR c = 0 TO width - 1
            row = APPEND(row, " ")
        NEXT c
        grid = APPEND(grid, row)
    NEXT r
    ' Per-cell selection flag (mirrors grid shape).
    DIM selGrid AS [][]BOOLEAN
    FOR r = 0 TO gridH - 1
        DIM srow AS []BOOLEAN
        FOR c = 0 TO width - 1
            srow = APPEND(srow, FALSE)
        NEXT c
        selGrid = APPEND(selGrid, srow)
    NEXT r
    ' Paint widgets. Multi-row widgets (ListBox, vertical ScrollBar)
    ' return one string per row via widgetVisibleLines.
    '
    ' Important: walk each row UTF-8 codepoint by codepoint, not byte
    ' by byte. The new widgets use multi-byte glyphs (▶ ▲ ▼ │ █ ░);
    ' splitting on bytes would store half-glyphs in adjacent grid
    ' slots and visually shorten the rendered row, letting the
    ' terminal-default bg leak through at the right edge.
    DIM wi AS INTEGER
    FOR wi = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[wi]
        DIM rows AS []STRING = widgetVisibleLines(w)
        DIM isSel AS BOOLEAN = (wi = m.Tabs[m.TabIdx].SelWidget)
        DIM rj AS INTEGER
        FOR rj = 0 TO LEN(rows) - 1
            DIM line AS STRING = rows[rj]
            DIM bx AS INTEGER = 0    ' current byte offset into line
            DIM cellCol AS INTEGER = 0  ' current visible cell offset
            DO WHILE bx < LEN(line)
                ' Decode the next UTF-8 codepoint's byte length from
                ' the leading byte: 110xxxxx = 2, 1110xxxx = 3,
                ' 11110xxx = 4, anything else = 1.
                DIM lead AS INTEGER = Asc(Mid(line, bx + 1, 1))
                DIM nb AS INTEGER = 1
                IF lead >= 240 THEN
                    nb = 4
                ELSEIF lead >= 224 THEN
                    nb = 3
                ELSEIF lead >= 192 THEN
                    nb = 2
                END IF
                IF bx + nb > LEN(line) THEN nb = LEN(line) - bx
                DIM cell AS STRING = Mid(line, bx + 1, nb)
                DIM pCol AS INTEGER = w.X + cellCol
                DIM pRow AS INTEGER = w.Y + rj
                IF pRow >= 0 AND pRow < gridH AND pCol >= 0 AND pCol < width THEN
                    grid[pRow][pCol] = cell
                    IF isSel THEN selGrid[pRow][pCol] = TRUE
                END IF
                bx = bx + nb
                cellCol = cellCol + 1
            LOOP
        NEXT rj
    NEXT wi
    ' Render rows.
    DIM lines AS []STRING
    DIM titleLine AS STRING = titleStyle.Render(" " + m.Tabs[m.TabIdx].Form.Title)
    lines = APPEND(lines, titleLine)
    FOR r = 0 TO gridH - 1
        DIM out AS STRING = ""
        DIM runBuf AS STRING = ""
        DIM runIsSel AS BOOLEAN = FALSE
        FOR c = 0 TO width - 1
            DIM ch AS STRING = grid[r][c]
            DIM cellSel AS BOOLEAN = selGrid[r][c]
            IF cellSel <> runIsSel AND runBuf <> "" THEN
                IF runIsSel THEN
                    out = out + selStyle.Render(runBuf)
                ELSE
                    out = out + widStyle.Render(runBuf)
                END IF
                runBuf = ""
            END IF
            runIsSel = cellSel
            runBuf = runBuf + ch
        NEXT c
        IF runBuf <> "" THEN
            IF runIsSel THEN
                out = out + selStyle.Render(runBuf)
            ELSE
                out = out + widStyle.Render(runBuf)
            END IF
        END IF
        _ = cellBg
        lines = APPEND(lines, out)
    NEXT r
    RETURN strings.Join(lines, "\n")
END FUNCTION

' -------------------------------------------------------------------------
' Persistence — .dbproj is a JSON blob of DesignForm.
' -------------------------------------------------------------------------

' newUntitledForm — open a fresh, in-memory form tab so the user has
' a real canvas to drop palette widgets onto. The tab has no on-disk
' path; the first Ctrl+S will pop the Save As modal ("saveform"
' context). Called by the View → Form Designer action so picking
' that menu item from a session full of code tabs Just Works instead
' of silently appending widgets to a code tab's invisible Form field.
SUB newUntitledForm(m AS POINTER TO Model)
    ' Reuse the active tab if it's already a form — no point stacking
    ' a duplicate blank form on top of one the user is working on.
    IF hasActiveTab(^m) THEN
        IF m.Tabs[m.TabIdx].Kind = "form" THEN
            m.ViewMode = "form"
            m.Status = "form designer — " + m.Tabs[m.TabIdx].Path
            RETURN
        END IF
        ' Blur the previous tab's editor so only one cursor blinks.
        m.Tabs[m.TabIdx].Editor.Blur()
    END IF
    DIM nf AS DesignForm
    nf.Title = "frmStart"
    DIM nt AS Tab
    nt.Path      = ""
    nt.Kind      = "form"
    nt.Form      = nf
    nt.SelWidget = 0 - 1
    m.Tabs   = APPEND(m.Tabs, nt)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    m.Status = "new form — click a palette item to add widgets"
END SUB

' loadFormFromDisk — parse `path` as a .dbproj JSON file into m.Form.
' On any error the status bar gets the diagnostic and the in-memory
' form is left alone. On success, ViewMode flips to "form".
SUB loadFormFromDisk(m AS POINTER TO Model, path AS STRING)
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN
        m.Status = "open " + path + ": " + rerr.Error()
        RETURN
    END IF
    DIM f AS DesignForm
    DIM jerr AS ERROR = encjson.Unmarshal(data, @f)
    IF jerr <> NIL THEN
        m.Status = "bad .dbproj: " + jerr.Error()
        RETURN
    END IF
    ' Build a new Form tab. Blur whatever editor was active.
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    DIM t AS Tab
    t.Path = path
    t.Kind = "form"
    t.Form = f
    t.SelWidget = 0 - 1
    m.Tabs = APPEND(m.Tabs, t)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    m.Status = "loaded form " + path
END SUB

' saveForm — JSON-marshal the active tab's Form to its Path. Empty
' path pops a Save As prompt (modal context "saveform").
SUB saveForm(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN RETURN
    IF m.Tabs[m.TabIdx].Path = "" THEN
        showInputModal(m, "Save Form", "Path:", "form.dbproj", "saveform")
        RETURN
    END IF
    DIM data AS BYTES
    DIM merr AS ERROR
    data, merr = encjson.MarshalIndent(m.Tabs[m.TabIdx].Form, "", "  ")
    IF merr <> NIL THEN
        m.Status = "marshal failed: " + merr.Error()
        RETURN
    END IF
    DIM werr AS ERROR = os.WriteFile(m.Tabs[m.TabIdx].Path, data, 0644)
    IF werr <> NIL THEN
        m.Status = "save failed: " + werr.Error()
        RETURN
    END IF
    m.Status = fmt.Sprintf("saved form %s (%d bytes)", m.Tabs[m.TabIdx].Path, LEN(data))
END SUB

' -------------------------------------------------------------------------
' Widget property editing — clicking a row in the right-pane
' Properties section pops an input modal pre-filled with the current
' value. dispatchModalClose for "wprop:*" applies the edit.
' -------------------------------------------------------------------------

' propRowEditContext — returns (title, prompt, default, modalContext)
' for the input modal that edits Properties row `rowIdx` on widget
' `w`. Returns empty strings when the row index isn't editable
' (row 0 = Kind, read-only) or doesn't exist for this kind.
'
' Row order MUST match the renderer in renderRightPane. Standard
' rows 0-4 are the same for every kind; rows 5+ are kind-specific
' and walked by a cursor so each kind gets a tight, dense layout.
FUNCTION propRowEditContext(w AS DesignWidget, rowIdx AS INTEGER) AS (STRING, STRING, STRING, STRING)
    IF rowIdx = 1 THEN RETURN "Edit Name", "Name:", w.Name, "wprop:name"
    IF rowIdx = 2 THEN RETURN "Edit Text", "Text:", w.Text, "wprop:text"
    IF rowIdx = 3 THEN RETURN "Edit Position", "X, Y:", fmt.Sprintf("%d, %d", w.X, w.Y), "wprop:pos"
    IF rowIdx = 4 THEN RETURN "Edit Size", "W, H:", fmt.Sprintf("%d, %d", w.W, w.H), "wprop:size"
    DIM cursor AS INTEGER = 5
    IF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN
            DIM ckDef AS STRING = "false"
            IF w.Checked THEN ckDef = "true"
            RETURN "Edit Checked", "true/false:", ckDef, "wprop:checked"
        END IF
        cursor = cursor + 1
    END IF
    IF w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN RETURN "Edit Group", "Group:", w.Group, "wprop:group"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ComboBox" OR w.Kind = "ListBox" THEN
        IF rowIdx = cursor THEN RETURN "Edit Items", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Selected", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ProgressBar" OR w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Min", "Min:", strconv.Itoa(w.Min), "wprop:min"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Max", "Max:", strconv.Itoa(w.Max), "wprop:max"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Value", "Value:", strconv.Itoa(w.Value), "wprop:value"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Orient", "h or v:", w.Orient, "wprop:orient"
    END IF
    RETURN "", "", "", ""
END FUNCTION

' formClickPropAt — dispatch a click on Properties row `rowIdx`
' (0-based) into the right input modal. Row 0 (Kind) is read-only;
' any rowIdx that propRowEditContext returns "" for is also a no-op.
SUB formClickPropAt(m AS POINTER TO Model, rowIdx AS INTEGER)
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
    DIM ctxTitle AS STRING
    DIM ctxPrompt AS STRING
    DIM ctxDef AS STRING
    DIM ctxKey AS STRING
    ctxTitle, ctxPrompt, ctxDef, ctxKey = propRowEditContext(w, rowIdx)
    IF ctxKey = "" THEN RETURN
    showInputModal(m, ctxTitle, ctxPrompt, ctxDef, ctxKey)
END SUB

' parseTwoInts — helper for Pos / Size edits. "X, Y" → (X, Y, ok).
FUNCTION parseTwoInts(s AS STRING) AS (INTEGER, INTEGER, BOOLEAN)
    DIM parts AS []STRING = strings.Split(s, ",")
    IF LEN(parts) <> 2 THEN RETURN 0, 0, FALSE
    DIM a AS INTEGER
    DIM b AS INTEGER
    DIM ae AS ERROR
    DIM be AS ERROR
    a, ae = strconv.Atoi(strings.TrimSpace(parts[0]))
    b, be = strconv.Atoi(strings.TrimSpace(parts[1]))
    IF ae <> NIL OR be <> NIL THEN RETURN 0, 0, FALSE
    RETURN a, b, TRUE
END FUNCTION

' -------------------------------------------------------------------------
' Form codegen — emit a runnable .dbas program from a DesignForm.
' v1 generates a static bubbletea Model that paints each widget at
' its (X, Y); q/Esc/Ctrl+C exits. Future versions will add input
' handlers per widget kind, named identifiers in the Model, etc.
' -------------------------------------------------------------------------

' escapeForDBString — backslash-escape backslashes and quotes so the
' string is safe to drop inside a DBasic string literal.
FUNCTION escapeForDBString(s AS STRING) AS STRING
    DIM bsl AS STRING = Chr(92)
    DIM qt  AS STRING = Chr(34)
    DIM out AS STRING = strings.ReplaceAll(s, bsl, bsl + bsl)
    out = strings.ReplaceAll(out, qt, bsl + qt)
    RETURN out
END FUNCTION

' -------------------------------------------------------------------------
' Codegen — partner .dbas split across a regen-only prelude and a
' preserved user section.
'
' Sentinel marker that splits the partner .dbas into two halves:
'   [ prelude ]   ' regenerated on every F5 — model, view, update,
'                 ' main, dispatchClick, anything DBtui knows how
'                 ' to write itself.
'   [ marker  ]   ' a fixed comment line — do not edit / delete /
'                 ' duplicate; DBtui scans for it byte-for-byte.
'   [ user    ]   ' button handler bodies + anything else the
'                 ' programmer wrote. Preserved across regens.
'
' The marker chosen is verbose on purpose so an accidental match in
' someone else's code is essentially impossible.
' -------------------------------------------------------------------------
CONST formUserMarker AS STRING = "' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE ====="

' generateFormPrelude — emit ONLY the generated half of the partner
' .dbas (Model + Init + Update + View + Main + dispatchClick). The
' user-edited handler bodies live below the formUserMarker line and
' are preserved by mergeFormDbas across every F5 regeneration.
FUNCTION generateFormPrelude(f AS DesignForm) AS STRING
    DIM qt AS STRING = Chr(34)
    DIM s  AS STRING = ""
    DIM n  AS INTEGER = LEN(f.Widgets)
    DIM nStr AS STRING = strconv.Itoa(n)
    s = s + "' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===\n"
    s = s + "\n"
    s = s + "IMPORT " + qt + "charm.land/bubbletea/v2" + qt + " AS tea\n"
    s = s + "IMPORT " + qt + "os" + qt + "\n"
    s = s + "IMPORT " + qt + "strings" + qt + "\n"
    s = s + "\n"
    ' --- Model: width/height/focus + one field per stateful widget --
    s = s + "TYPE Model\n"
    s = s + "    DIM Width  AS INTEGER\n"
    s = s + "    DIM Height AS INTEGER\n"
    s = s + "    DIM Focus  AS INTEGER\n"
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM w AS DesignWidget = f.Widgets[i]
        IF w.Kind = "TextInput" THEN
            s = s + "    DIM " + w.Name + "_Val AS STRING\n"
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
            s = s + "    DIM " + w.Name + "_Val AS BOOLEAN\n"
        ELSEIF w.Kind = "ComboBox" OR w.Kind = "ListBox" OR w.Kind = "ScrollBar" OR w.Kind = "ProgressBar" THEN
            s = s + "    DIM " + w.Name + "_Val AS INTEGER\n"
        END IF
    NEXT i
    s = s + "END TYPE\n"
    s = s + "\n"
    s = s + "FUNCTION (m AS Model) Init() AS tea.Cmd\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- Update: resize, quit (Esc/Ctrl+C), Tab cycle, per-widget ---
    s = s + "FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)\n"
    s = s + "    DIM sz AS tea.WindowSizeMsg\n"
    s = s + "    DIM szOk AS BOOLEAN\n"
    s = s + "    sz, szOk = msg.(tea.WindowSizeMsg)\n"
    s = s + "    IF szOk THEN\n"
    s = s + "        m.Width = sz.Width\n"
    s = s + "        m.Height = sz.Height\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    s = s + "    DIM k AS tea.KeyPressMsg\n"
    s = s + "    DIM kOk AS BOOLEAN\n"
    s = s + "    k, kOk = msg.(tea.KeyPressMsg)\n"
    s = s + "    IF kOk THEN\n"
    s = s + "        DIM key AS STRING = k.String()\n"
    s = s + "        IF key = " + qt + "ctrl+c" + qt + " OR key = " + qt + "esc" + qt + " THEN RETURN m, tea.Quit\n"
    IF n > 0 THEN
        s = s + "        IF key = " + qt + "tab" + qt + " THEN\n"
        s = s + "            m.Focus = (m.Focus + 1) MOD " + nStr + "\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        s = s + "        IF key = " + qt + "shift+tab" + qt + " THEN\n"
        s = s + "            m.Focus = m.Focus - 1\n"
        s = s + "            IF m.Focus < 0 THEN m.Focus = " + strconv.Itoa(n - 1) + "\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        ' Per-widget key handling.
        FOR i = 0 TO n - 1
            DIM ww AS DesignWidget = f.Widgets[i]
            DIM iStr AS STRING = strconv.Itoa(i)
            s = s + "        IF m.Focus = " + iStr + " THEN\n"
            IF ww.Kind = "TextInput" THEN
                s = s + "            IF LEN(key) = 1 THEN m." + ww.Name + "_Val = m." + ww.Name + "_Val + key\n"
                s = s + "            IF key = " + qt + "space" + qt + " THEN m." + ww.Name + "_Val = m." + ww.Name + "_Val + " + qt + " " + qt + "\n"
                s = s + "            IF key = " + qt + "backspace" + qt + " AND LEN(m." + ww.Name + "_Val) > 0 THEN\n"
                s = s + "                m." + ww.Name + "_Val = Mid(m." + ww.Name + "_Val, 1, LEN(m." + ww.Name + "_Val) - 1)\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "Checkbox" THEN
                ' Space / Enter toggles; fires _Change so the user
                ' can react to value changes from their handler.
                s = s + "            IF key = " + qt + "space" + qt + " OR key = " + qt + "enter" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Val = NOT m." + ww.Name + "_Val\n"
                s = s + "                dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "RadioButton" THEN
                ' Space / Enter selects this radio AND clears every
                ' sibling (same Group). Then fires _Change for the
                ' newly-selected radio.
                s = s + "            IF key = " + qt + "space" + qt + " OR key = " + qt + "enter" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Val = TRUE\n"
                ' Walk widgets again to emit sibling clears at codegen time.
                DIM si AS INTEGER
                FOR si = 0 TO n - 1
                    DIM sw AS DesignWidget = f.Widgets[si]
                    IF si <> i AND sw.Kind = "RadioButton" AND sw.Group = ww.Group THEN
                        s = s + "                m." + sw.Name + "_Val = FALSE\n"
                    END IF
                NEXT si
                s = s + "                dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "ComboBox" OR ww.Kind = "ListBox" THEN
                DIM nItems AS STRING = strconv.Itoa(LEN(ww.Items))
                s = s + "            IF key = " + qt + "up" + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val > 0 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val - 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "down" + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val < " + nItems + " - 1 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val + 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "ScrollBar" THEN
                DIM minStr AS STRING = strconv.Itoa(ww.Min)
                DIM maxStr AS STRING = strconv.Itoa(ww.Max)
                DIM decKey AS STRING = "up"
                DIM incKey AS STRING = "down"
                IF strings.ToLower(ww.Orient) = "h" THEN
                    decKey = "left"
                    incKey = "right"
                END IF
                s = s + "            IF key = " + qt + decKey + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val > " + minStr + " THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val - 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + incKey + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val < " + maxStr + " THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val + 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "Button" THEN
                ' Enter / Space on a focused Button fires its
                ' _Click handler via dispatchClick. The user's body
                ' lives in the preserved section below the marker.
                s = s + "            IF key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN dispatchClick(" + qt + ww.Name + qt + ")\n"
            ELSE
                ' Label / ProgressBar / others: no state changes.
                s = s + "            _ = key\n"
            END IF
            s = s + "            RETURN m, NIL\n"
            s = s + "        END IF\n"
        NEXT i
    END IF
    s = s + "    END IF\n"
    s = s + "    RETURN m, NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- View: paint canvas + widgets at their (X,Y); focused gets > -
    s = s + "FUNCTION (m AS Model) View() AS tea.View\n"
    s = s + "    DIM w AS INTEGER = m.Width\n"
    s = s + "    DIM h AS INTEGER = m.Height\n"
    s = s + "    IF w < 60 THEN w = 80\n"
    s = s + "    IF h < 20 THEN h = 24\n"
    s = s + "    DIM rows AS []STRING\n"
    s = s + "    DIM r AS INTEGER\n"
    s = s + "    FOR r = 0 TO h - 2\n"
    s = s + "        rows = APPEND(rows, strings.Repeat(" + qt + " " + qt + ", w))\n"
    s = s + "    NEXT r\n"
    FOR i = 0 TO n - 1
        DIM wv  AS DesignWidget = f.Widgets[i]
        DIM xs  AS STRING = strconv.Itoa(wv.X)
        DIM ys  AS STRING = strconv.Itoa(wv.Y)
        DIM sfx AS STRING = strconv.Itoa(i)

        DIM isMulti AS BOOLEAN = (wv.Kind = "ListBox") OR (wv.Kind = "ScrollBar" AND strings.ToLower(wv.Orient) = "v")

        ' --- Multi-row kinds: emit a per-row paint loop and skip the
        '     single-row body+overlay path below.
        IF wv.Kind = "ListBox" THEN
            DIM lbH AS STRING = strconv.Itoa(wv.H)
            ' Emit the runtime Items slice for this ListBox so the
            ' loop can index into it.
            s = s + "    DIM items" + sfx + " AS []STRING\n"
            DIM ii AS INTEGER
            FOR ii = 0 TO LEN(wv.Items) - 1
                s = s + "    items" + sfx + " = APPEND(items" + sfx + ", " + qt + escapeForDBString(wv.Items[ii]) + qt + ")\n"
            NEXT ii
            DIM iwidStr AS STRING = strconv.Itoa(wv.W - 2)
            IF wv.W - 2 < 1 THEN iwidStr = "1"
            s = s + "    DIM lbi" + sfx + " AS INTEGER\n"
            s = s + "    FOR lbi" + sfx + " = 0 TO " + lbH + " - 1\n"
            s = s + "        DIM lbItem" + sfx + " AS STRING = " + qt + qt + "\n"
            s = s + "        IF lbi" + sfx + " < LEN(items" + sfx + ") THEN lbItem" + sfx + " = items" + sfx + "[lbi" + sfx + "]\n"
            s = s + "        IF LEN(lbItem" + sfx + ") > " + iwidStr + " THEN lbItem" + sfx + " = Mid(lbItem" + sfx + ", 1, " + iwidStr + ")\n"
            s = s + "        IF LEN(lbItem" + sfx + ") < " + iwidStr + " THEN lbItem" + sfx + " = lbItem" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + iwidStr + " - LEN(lbItem" + sfx + "))\n"
            s = s + "        DIM lbMark" + sfx + " AS STRING = " + qt + "  " + qt + "\n"
            s = s + "        IF lbi" + sfx + " = m." + wv.Name + "_Val THEN lbMark" + sfx + " = " + qt + "▶ " + qt + "\n"
            s = s + "        DIM lbRow" + sfx + " AS STRING = lbMark" + sfx + " + lbItem" + sfx + "\n"
            s = s + "        IF lbi" + sfx + " = 0 THEN\n"
            s = s + "            IF m.Focus = " + sfx + " THEN\n"
            s = s + "                lbRow" + sfx + " = " + qt + ">" + qt + " + lbRow" + sfx + "\n"
            s = s + "            ELSE\n"
            s = s + "                lbRow" + sfx + " = " + qt + " " + qt + " + lbRow" + sfx + "\n"
            s = s + "            END IF\n"
            s = s + "        ELSE\n"
            s = s + "            lbRow" + sfx + " = " + qt + " " + qt + " + lbRow" + sfx + "\n"
            s = s + "        END IF\n"
            s = s + "        DIM yPos" + sfx + " AS INTEGER = " + ys + " + lbi" + sfx + "\n"
            s = s + "        IF yPos" + sfx + " >= 0 AND yPos" + sfx + " < LEN(rows) THEN rows[yPos" + sfx + "] = overlayRow(rows[yPos" + sfx + "], " + xs + ", lbRow" + sfx + ")\n"
            s = s + "    NEXT lbi" + sfx + "\n"
        ELSEIF wv.Kind = "ScrollBar" AND strings.ToLower(wv.Orient) = "v" THEN
            DIM svH AS STRING = strconv.Itoa(wv.H)
            DIM svMin AS STRING = strconv.Itoa(wv.Min)
            DIM svRng AS STRING = strconv.Itoa(wv.Max - wv.Min)
            IF wv.Max - wv.Min <= 0 THEN svRng = "1"
            s = s + "    DIM svi" + sfx + " AS INTEGER\n"
            s = s + "    DIM svThumb" + sfx + " AS INTEGER = 1 + ((m." + wv.Name + "_Val - " + svMin + ") * (" + svH + " - 3)) / " + svRng + "\n"
            s = s + "    IF svThumb" + sfx + " < 1 THEN svThumb" + sfx + " = 1\n"
            s = s + "    IF svThumb" + sfx + " > " + svH + " - 2 THEN svThumb" + sfx + " = " + svH + " - 2\n"
            s = s + "    FOR svi" + sfx + " = 0 TO " + svH + " - 1\n"
            s = s + "        DIM svGlyph" + sfx + " AS STRING = " + qt + "│" + qt + "\n"
            s = s + "        IF svi" + sfx + " = 0 THEN svGlyph" + sfx + " = " + qt + "▲" + qt + "\n"
            s = s + "        IF svi" + sfx + " = " + svH + " - 1 THEN svGlyph" + sfx + " = " + qt + "▼" + qt + "\n"
            s = s + "        IF svi" + sfx + " = svThumb" + sfx + " THEN svGlyph" + sfx + " = " + qt + "█" + qt + "\n"
            s = s + "        IF svi" + sfx + " = 0 THEN\n"
            s = s + "            IF m.Focus = " + sfx + " THEN\n"
            s = s + "                svGlyph" + sfx + " = " + qt + ">" + qt + " + svGlyph" + sfx + "\n"
            s = s + "            ELSE\n"
            s = s + "                svGlyph" + sfx + " = " + qt + " " + qt + " + svGlyph" + sfx + "\n"
            s = s + "            END IF\n"
            s = s + "        ELSE\n"
            s = s + "            svGlyph" + sfx + " = " + qt + " " + qt + " + svGlyph" + sfx + "\n"
            s = s + "        END IF\n"
            s = s + "        DIM svY" + sfx + " AS INTEGER = " + ys + " + svi" + sfx + "\n"
            s = s + "        IF svY" + sfx + " >= 0 AND svY" + sfx + " < LEN(rows) THEN rows[svY" + sfx + "] = overlayRow(rows[svY" + sfx + "], " + xs + ", svGlyph" + sfx + ")\n"
            s = s + "    NEXT svi" + sfx + "\n"
        ELSE
        ' --- Single-row kinds: build body string, prefix focus
        '     marker, overlay onto the target row in `rows`.
        s = s + "    DIM body" + sfx + " AS STRING\n"
        IF wv.Kind = "TextInput" THEN
            DIM widStr AS STRING = strconv.Itoa(wv.W)
            s = s + "    body" + sfx + " = " + qt + "[" + qt + " + m." + wv.Name + "_Val + strings.Repeat(" + qt + " " + qt + ", " + widStr + " - 2 - LEN(m." + wv.Name + "_Val)) + " + qt + "]" + qt + "\n"
        ELSEIF wv.Kind = "Checkbox" THEN
            DIM lbl AS STRING = escapeForDBString(wv.Text)
            s = s + "    IF m." + wv.Name + "_Val THEN\n"
            s = s + "        body" + sfx + " = " + qt + "[x] " + lbl + qt + "\n"
            s = s + "    ELSE\n"
            s = s + "        body" + sfx + " = " + qt + "[ ] " + lbl + qt + "\n"
            s = s + "    END IF\n"
        ELSEIF wv.Kind = "RadioButton" THEN
            DIM rlbl AS STRING = escapeForDBString(wv.Text)
            s = s + "    IF m." + wv.Name + "_Val THEN\n"
            s = s + "        body" + sfx + " = " + qt + "(o) " + rlbl + qt + "\n"
            s = s + "    ELSE\n"
            s = s + "        body" + sfx + " = " + qt + "( ) " + rlbl + qt + "\n"
            s = s + "    END IF\n"
        ELSEIF wv.Kind = "ComboBox" THEN
            DIM cwidStr AS STRING = strconv.Itoa(wv.W - 4)
            IF wv.W - 4 < 1 THEN cwidStr = "1"
            s = s + "    DIM cbItems" + sfx + " AS []STRING\n"
            DIM cbI AS INTEGER
            FOR cbI = 0 TO LEN(wv.Items) - 1
                s = s + "    cbItems" + sfx + " = APPEND(cbItems" + sfx + ", " + qt + escapeForDBString(wv.Items[cbI]) + qt + ")\n"
            NEXT cbI
            s = s + "    DIM cbCur" + sfx + " AS STRING = " + qt + qt + "\n"
            s = s + "    IF m." + wv.Name + "_Val >= 0 AND m." + wv.Name + "_Val < LEN(cbItems" + sfx + ") THEN cbCur" + sfx + " = cbItems" + sfx + "[m." + wv.Name + "_Val]\n"
            s = s + "    IF LEN(cbCur" + sfx + ") > " + cwidStr + " THEN cbCur" + sfx + " = Mid(cbCur" + sfx + ", 1, " + cwidStr + ")\n"
            s = s + "    IF LEN(cbCur" + sfx + ") < " + cwidStr + " THEN cbCur" + sfx + " = cbCur" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + cwidStr + " - LEN(cbCur" + sfx + "))\n"
            s = s + "    body" + sfx + " = " + qt + "[" + qt + " + cbCur" + sfx + " + " + qt + " v]" + qt + "\n"
        ELSEIF wv.Kind = "ProgressBar" THEN
            DIM pwStr AS STRING = strconv.Itoa(wv.W - 2)
            IF wv.W - 2 < 1 THEN pwStr = "1"
            DIM pMinStr AS STRING = strconv.Itoa(wv.Min)
            DIM pRngStr AS STRING = strconv.Itoa(wv.Max - wv.Min)
            IF wv.Max - wv.Min <= 0 THEN pRngStr = "1"
            s = s + "    DIM pbFilled" + sfx + " AS INTEGER = (m." + wv.Name + "_Val - " + pMinStr + ") * " + pwStr + " / " + pRngStr + "\n"
            s = s + "    IF pbFilled" + sfx + " < 0 THEN pbFilled" + sfx + " = 0\n"
            s = s + "    IF pbFilled" + sfx + " > " + pwStr + " THEN pbFilled" + sfx + " = " + pwStr + "\n"
            s = s + "    body" + sfx + " = " + qt + "[" + qt + " + strings.Repeat(" + qt + "█" + qt + ", pbFilled" + sfx + ") + strings.Repeat(" + qt + "░" + qt + ", " + pwStr + " - pbFilled" + sfx + ") + " + qt + "]" + qt + "\n"
        ELSEIF wv.Kind = "ScrollBar" THEN
            ' Horizontal scrollbar — single row "◄──█──►".
            DIM hwStr AS STRING = strconv.Itoa(wv.W - 2)
            IF wv.W - 2 < 1 THEN hwStr = "1"
            DIM hMinStr AS STRING = strconv.Itoa(wv.Min)
            DIM hRngStr AS STRING = strconv.Itoa(wv.Max - wv.Min)
            IF wv.Max - wv.Min <= 0 THEN hRngStr = "1"
            s = s + "    DIM hThumb" + sfx + " AS INTEGER = (m." + wv.Name + "_Val - " + hMinStr + ") * (" + hwStr + " - 1) / " + hRngStr + "\n"
            s = s + "    IF hThumb" + sfx + " < 0 THEN hThumb" + sfx + " = 0\n"
            s = s + "    IF hThumb" + sfx + " > " + hwStr + " - 1 THEN hThumb" + sfx + " = " + hwStr + " - 1\n"
            s = s + "    body" + sfx + " = " + qt + "◄" + qt + " + strings.Repeat(" + qt + "─" + qt + ", hThumb" + sfx + ") + " + qt + "█" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + hwStr + " - 1 - hThumb" + sfx + ") + " + qt + "►" + qt + "\n"
        ELSE
            ' Button / Label / others: static text via widgetVisibleText.
            DIM txt AS STRING = widgetVisibleText(wv)
            s = s + "    body" + sfx + " = " + qt + escapeForDBString(txt) + qt + "\n"
        END IF
        s = s + "    IF m.Focus = " + sfx + " THEN\n"
        s = s + "        body" + sfx + " = " + qt + ">" + qt + " + body" + sfx + "\n"
        s = s + "    ELSE\n"
        s = s + "        body" + sfx + " = " + qt + " " + qt + " + body" + sfx + "\n"
        s = s + "    END IF\n"
        s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", body" + sfx + ")\n"
        END IF
        _ = isMulti
    NEXT i
    s = s + "    rows = APPEND(rows, " + qt + " — Tab to cycle focus, Esc to quit" + qt + ")\n"
    s = s + "    RETURN tea.NewView(strings.Join(rows, " + qt + "\\n" + qt + "))\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    s = s + "SUB Main()\n"
    s = s + "    DIM m AS Model\n"
    ' Seed per-widget initial state from the design — bubbletea
    ' takes the Model by value at NewProgram time, so anything set
    ' here is what the user sees on the first frame.
    DIM mi AS INTEGER
    FOR mi = 0 TO n - 1
        DIM mw AS DesignWidget = f.Widgets[mi]
        IF mw.Kind = "RadioButton" AND mw.Checked THEN
            s = s + "    m." + mw.Name + "_Val = TRUE\n"
        ELSEIF mw.Kind = "ComboBox" OR mw.Kind = "ListBox" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Selected) + "\n"
        ELSEIF mw.Kind = "ScrollBar" OR mw.Kind = "ProgressBar" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Value) + "\n"
        END IF
    NEXT mi
    s = s + "    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)\n"
    s = s + "    DIM final AS tea.Model\n"
    s = s + "    DIM rerr AS ERROR\n"
    s = s + "    final, rerr = prog.Run()\n"
    s = s + "    IF rerr <> NIL THEN os.Exit(1)\n"
    s = s + "    _ = final\n"
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- overlayRow — shared helper for painting a body string onto
    '     a target row at column X, preserving cells either side.
    '     Returns the new row contents. Used by every per-widget
    '     paint site in View, single-row or multi-row.
    s = s + "FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING\n"
    s = s + "    DIM lf AS STRING = " + qt + qt + "\n"
    s = s + "    IF col > 0 AND col <= LEN(row) THEN lf = Mid(row, 1, col)\n"
    s = s + "    DIM rt AS STRING = " + qt + qt + "\n"
    s = s + "    IF col + LEN(txt) < LEN(row) THEN rt = Mid(row, col + LEN(txt) + 1, LEN(row) - col - LEN(txt))\n"
    s = s + "    RETURN lf + txt + rt\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- dispatchClick — generated jump-table from widget Id to
    '     the user-defined SUB. Must live in the prelude so the
    '     generated Update can call it; the SUB bodies live below
    '     the marker so they survive regen.
    s = s + "' Generated dispatcher — routes a Button click to its user handler.\n"
    s = s + "SUB dispatchClick(id AS STRING)\n"
    DIM hadClick AS BOOLEAN = FALSE
    DIM di AS INTEGER
    FOR di = 0 TO n - 1
        DIM dw AS DesignWidget = f.Widgets[di]
        IF dw.Kind = "Button" THEN
            s = s + "    IF id = " + qt + dw.Name + qt + " THEN " + dw.Name + "_Click()\n"
            hadClick = TRUE
        END IF
    NEXT di
    IF NOT hadClick THEN
        ' Empty body — avoid an "unused parameter" Go warning.
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- dispatchChange — like dispatchClick but for value-change
    '     events on Checkbox / RadioButton / ComboBox / ListBox /
    '     ScrollBar. User handlers live below the marker.
    s = s + "' Generated dispatcher — routes a value change to its _Change handler.\n"
    s = s + "SUB dispatchChange(id AS STRING)\n"
    DIM hadChange AS BOOLEAN = FALSE
    DIM dchI AS INTEGER
    FOR dchI = 0 TO n - 1
        DIM dchW AS DesignWidget = f.Widgets[dchI]
        IF dchW.Kind = "Checkbox" OR dchW.Kind = "RadioButton" OR dchW.Kind = "ComboBox" OR dchW.Kind = "ListBox" OR dchW.Kind = "ScrollBar" THEN
            s = s + "    IF id = " + qt + dchW.Name + qt + " THEN " + dchW.Name + "_Change()\n"
            hadChange = TRUE
        END IF
    NEXT dchI
    IF NOT hadChange THEN
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"
    RETURN s
END FUNCTION

' subDefined — TRUE when `userCode` already declares a SUB named
' `name` (case-sensitive). Used so generateUserStubs doesn't
' duplicate handlers the user has already written.
FUNCTION subDefined(userCode AS STRING, name AS STRING) AS BOOLEAN
    DIM needle AS STRING = "SUB " + name + "("
    RETURN strings.Contains(userCode, needle)
END FUNCTION

' generateUserStubs — produce the user section. On a fresh form
' (existingUser empty) seed it with a friendly preamble + an empty
' SUB <name>_Click() for every Button. On subsequent regens, keep
' the existing content verbatim and append stubs for any handler
' the user hasn't already written (e.g. a Button added since last
' run). Never rewrites or deletes existing content.
FUNCTION generateUserStubs(f AS DesignForm, existingUser AS STRING) AS STRING
    DIM out AS STRING = existingUser
    IF out = "" THEN
        ' Fresh user section: a one-line guide + a blank line.
        out = "' Your code below — DBtui preserves everything here on F5.\n\n"
    END IF
    DIM trailing AS BOOLEAN = strings.HasSuffix(out, "\n")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(f.Widgets) - 1
        DIM w AS DesignWidget = f.Widgets[i]
        DIM stubName AS STRING = ""
        DIM stubLabel AS STRING = ""
        IF w.Kind = "Button" THEN
            stubName = w.Name + "_Click"
            stubLabel = "Click"
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" OR w.Kind = "ComboBox" OR w.Kind = "ListBox" OR w.Kind = "ScrollBar" THEN
            stubName = w.Name + "_Change"
            stubLabel = "Change"
        END IF
        IF stubName <> "" AND NOT subDefined(out, stubName) THEN
            IF NOT trailing THEN out = out + "\n"
            IF NOT strings.HasSuffix(out, "\n\n") THEN out = out + "\n"
            out = out + "' " + stubLabel + " handler for " + w.Name + " — edit freely.\n"
            out = out + "SUB " + stubName + "()\n"
            out = out + "    ' TODO: your code here.\n"
            out = out + "END SUB\n"
            trailing = TRUE
        END IF
    NEXT i
    RETURN out
END FUNCTION

' extractUserSection — read `path` (if it exists) and return the
' content after the user marker. If the file is missing or the
' marker is absent (fresh form, or user nuked the marker), return
' the empty string — caller will seed a fresh user section.
FUNCTION extractUserSection(path AS STRING) AS STRING
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN RETURN ""
    DIM src AS STRING = string(data)
    DIM idx AS INTEGER = strings.Index(src, formUserMarker)
    IF idx < 0 THEN RETURN ""
    ' Skip the marker line itself plus its trailing newline so the
    ' returned section starts at the first user-owned byte.
    DIM after AS INTEGER = idx + LEN(formUserMarker)
    IF after < LEN(src) AND Mid(src, after + 1, 1) = "\n" THEN after = after + 1
    IF after >= LEN(src) THEN RETURN ""
    RETURN Mid(src, after + 1, LEN(src) - after)
END FUNCTION

' mergeFormDbas — build the final .dbas content by composing a
' fresh prelude (from the design), the user marker line, and the
' preserved/augmented user section (handlers). Idempotent: running
' it twice on the same form against its own output is a no-op.
FUNCTION mergeFormDbas(f AS DesignForm, existingPath AS STRING) AS STRING
    DIM prelude    AS STRING = generateFormPrelude(f)
    DIM existing   AS STRING = extractUserSection(existingPath)
    DIM userSection AS STRING = generateUserStubs(f, existing)
    DIM out AS STRING = prelude
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    ' One blank line before the marker line, exactly one newline
    ' after it. extractUserSection consumes that single newline so
    ' the round-trip is idempotent (running mergeFormDbas on its
    ' own output produces byte-identical bytes).
    out = out + "\n" + formUserMarker + "\n"
    out = out + userSection
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    RETURN out
END FUNCTION

' doFormRun — F5 in form mode. Saves the .dbproj if a path is set,
' regenerates the partner .dbas, hands the terminal to dbasic run.
FUNCTION doFormRun(m AS POINTER TO Model) AS tea.Cmd
    IF m.Tabs[m.TabIdx].Path = "" THEN
        m.Status = "save the form first (Ctrl+S)"
        RETURN NIL
    END IF
    saveForm(m)
    DIM stem AS STRING = strings.TrimSuffix(m.Tabs[m.TabIdx].Path, ".dbproj")
    DIM outPath AS STRING = stem + ".dbas"
    ' Merge: regenerate the prelude (Model/Update/View/Main/dispatch),
    ' then graft on whatever user code already lives below the marker
    ' in `outPath`. First run on a brand-new form seeds empty stubs.
    DIM code AS STRING = mergeFormDbas(m.Tabs[m.TabIdx].Form, outPath)
    DIM werr AS ERROR = os.WriteFile(outPath, Encode(code), 0644)
    IF werr <> NIL THEN
        m.Status = "write " + outPath + ": " + werr.Error()
        RETURN NIL
    END IF
    m.Status = "running dbasic run " + outPath
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "run", outPath)
    RETURN tea.ExecProcess(cmd, runFinishedHandler)
END FUNCTION
