{
  "Name": "DBtui",
  "Version": "0.1.0",
  "StartForm": "frmMain",
  "Forms": [
    {
      "Name": "frmMain",
      "File": "forms/frmMain.dbf",
      "Code": "forms/frmMain.dbas",
      "Width": 110,
      "Height": 30,
      "Title": "DBtui — self-hosted skeleton",
      "ResizableX": true,
      "ResizableY": true,
      "Visible": true,
      "BgColor": "#1a1b2e",
      "FgColor": "#e0def4",
      "Widgets": [
        {
          "Id": "mainmenu",
          "Kind": "MenuBar",
          "X": 1, "Y": 1, "Width": 106, "Height": 1,
          "Visible": true,
          "Anchor": "TopLeft",
          "Style": {"BgColor":"#24273a","FgColor":"#cad3f5","Border":"none","Corner":"square"},
          "Properties": {
            "Menus": "File|Save:file.save,Save All:file.saveall,-,Quit:file.quit;Edit|Cut:edit.cut,Copy:edit.copy,Paste:edit.paste;Run|Run:run.run,Check:run.check,-,Build:run.build;Help|About:help.about,Keys:help.keys"
          }
        },
        {
          "Id": "split1",
          "Kind": "SplitPanel",
          "X": 1, "Y": 2, "Width": 106, "Height": 23,
          "Visible": true,
          "Anchor": "Fill",
          "Style": {"BgColor":"#1a1b2e","FgColor":"#7dcfff","Border":"none","Corner":"square"},
          "Properties": {"Orientation": "vertical", "Position": 22, "Slot1": "tree", "Slot2": "split2"}
        },
        {
          "Id": "split2",
          "Kind": "SplitPanel",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#7dcfff","Border":"none","Corner":"square"},
          "Properties": {"Orientation": "vertical", "Position": 72, "Slot1": "split3", "Slot2": "props"}
        },
        {
          "Id": "split3",
          "Kind": "SplitPanel",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#7dcfff","Border":"none","Corner":"square"},
          "Properties": {"Orientation": "horizontal", "Position": 55, "Slot1": "canvas", "Slot2": "split4"}
        },
        {
          "Id": "split4",
          "Kind": "SplitPanel",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#7dcfff","Border":"none","Corner":"square"},
          "Properties": {"Orientation": "horizontal", "Position": 10, "Slot1": "tabs", "Slot2": "code"}
        },
        {
          "Id": "tabs",
          "Kind": "TabStrip",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true, "TabStop": true,
          "Style": {"BgColor":"#24273a","FgColor":"#cad3f5","Border":"none","Corner":"square"},
          "Properties": {"Tabs": "(no files)", "Active": "0"}
        },
        {
          "Id": "tree",
          "Kind": "TreeView",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true, "TabStop": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#e0def4","Border":"normal","Corner":"round"},
          "Properties": {
            "Title": "project",
            "Nodes": "0|+|project/;1|*|loading...",
            "Selected": "0", "Offset": "0"
          }
        },
        {
          "Id": "canvas",
          "Kind": "FormCanvas",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true, "TabStop": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#3b3d5e","Border":"normal","Corner":"round"},
          "Properties": {"ShowGrid": true, "GridDot": "·"}
        },
        {
          "Id": "code",
          "Kind": "CodeEditor",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true, "TabStop": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#e0def4","Border":"normal","Corner":"round"},
          "Properties": {
            "Value": "' Click a tree node to open it here.\n\nSUB Main()\n    PRINT \"hello from self-hosted DBtui\"\nEND SUB\n",
            "Placeholder": "",
            "Language": "dbasic"
          }
        },
        {
          "Id": "props",
          "Kind": "PropertyGrid",
          "X": 0, "Y": 0, "Width": 1, "Height": 1,
          "Visible": true, "TabStop": true,
          "Style": {"BgColor":"#1a1b2e","FgColor":"#e0def4","Border":"normal","Corner":"round"},
          "Properties": {
            "Title": "Properties",
            "Rows": "(none)||||",
            "Selected": "0",
            "Offset": "0"
          }
        },
        {
          "Id": "checkBtn",
          "Kind": "Button",
          "X": 2, "Y": 26, "Width": 12, "Height": 3,
          "Visible": true, "TabStop": true,
          "Anchor": "BottomLeft",
          "Style": {"BgColor":"#3d4570","FgColor":"#e0def4","Border":"normal","Corner":"round"},
          "Properties": {"Text": "Check (F6)"}
        },
        {
          "Id": "runBtn",
          "Kind": "Button",
          "X": 18, "Y": 26, "Width": 12, "Height": 3,
          "Visible": true, "TabStop": true,
          "Anchor": "BottomLeft",
          "Style": {"BgColor":"#3d4570","FgColor":"#e0def4","Border":"normal","Corner":"round"},
          "Properties": {"Text": "Run (F5)"}
        },
        {
          "Id": "status",
          "Kind": "Label",
          "X": 30, "Y": 27, "Width": 80, "Height": 1,
          "Visible": true,
          "Anchor": "BottomLeft",
          "Style": {"BgColor":"","FgColor":"#8087a2","Border":"none","Corner":"square"},
          "Properties": {"Text": "Tree click opens · Ctrl+S saves · F5 runs · F6 checks"}
        }
      ],
      "Tools": [
        {
          "Id": "dbBuild",
          "Kind": "Process",
          "Properties": {"Command": "dbasic", "Args": "build", "Cwd": ""}
        },
        {
          "Id": "dbCheck",
          "Kind": "Process",
          "Properties": {"Command": "dbasic", "Args": "check", "Cwd": ""}
        }
      ]
    }
  ],
  "Modules": [
    {"Name": "util", "File": "modules/util.dbas"}
  ]
}
