' DBtui — self-hosted skeleton, frmMain event handlers.

IMPORT "fmt"
IMPORT "os"
IMPORT "strconv"
IMPORT "strings"

' Open-file state. openFiles holds paths; openBufs[i] mirrors the
' editor content for tab i so switching tabs preserves unsaved edits;
' openDirty[i] tracks whether the buffer differs from disk for the
' modified indicator. curIdx is the active tab; curFile mirrors
' openFiles[curIdx].
DIM openFiles  AS []STRING
DIM openBufs   AS []STRING
DIM openDirty  AS []BOOLEAN
DIM curIdx     AS INTEGER
DIM curFile    AS STRING

' Last widget reflected into the Properties panel — used by
' props_Change to route an edit commit back to the right widget.
DIM curSelWidget AS STRING

' Tab index pending close-confirm via gMsgBox.
DIM pendingCloseIdx AS INTEGER

SUB FormLoad()
    curIdx = 0 - 1
    pendingCloseIdx = 0 - 1
    tvSetNodes("tree", buildTreeNodes("."))
    gSetItems("props", propsFor(""))
    refreshTabs()
    gSetText("status", "Self-hosted DBtui — tree click opens, Ctrl+S saves.")
END SUB

SUB FormResize(w AS INTEGER, h AS INTEGER)
    gSetText("status", fmt.Sprintf("resized: %dx%d", w, h))
END SUB

SUB gOnSelect(id AS STRING)
    IF id = "props" OR id = "" THEN RETURN
    curSelWidget = id
    gSetItems("props", propsFor(id))
END SUB

' refreshTabs — rebuild the TabStrip Items from openFiles. Tabs whose
' buffer differs from disk get a "*" prefix as a modified indicator.
SUB refreshTabs()
    IF LEN(openFiles) = 0 THEN
        gSetItems("tabs", "(no files)")
        gSetSelected("tabs", 0)
        RETURN
    END IF
    DIM labels AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(openFiles) - 1
        DIM lbl AS STRING = baseName(openFiles[i])
        IF i < LEN(openDirty) AND openDirty[i] THEN lbl = "*" + lbl
        labels = APPEND(labels, lbl)
    NEXT i
    gSetItems("tabs", strings.Join(labels, ";"))
    IF curIdx < 0 THEN curIdx = 0
    IF curIdx >= LEN(openFiles) THEN curIdx = LEN(openFiles) - 1
    gSetSelected("tabs", curIdx)
END SUB

' stashCurrentBuffer — snapshot the editor's current text into
' openBufs[curIdx] so a tab switch doesn't drop unsaved edits.
SUB stashCurrentBuffer()
    IF curIdx < 0 OR curIdx >= LEN(openFiles) THEN RETURN
    DIM buf AS STRING = gGetText("code")
    DO WHILE LEN(openBufs) <= curIdx
        openBufs = APPEND(openBufs, "")
    LOOP
    openBufs[curIdx] = buf
END SUB

' switchToTab — load openBufs[idx] (or disk if no buffer cached) into
' the editor + update curFile.
SUB switchToTab(idx AS INTEGER)
    IF idx < 0 OR idx >= LEN(openFiles) THEN RETURN
    stashCurrentBuffer()
    curIdx = idx
    curFile = openFiles[idx]
    DIM body AS STRING = ""
    IF idx < LEN(openBufs) AND openBufs[idx] <> "" THEN
        body = openBufs[idx]
    ELSE
        DIM data AS BYTES
        DIM err AS ERROR
        data, err = os.ReadFile(curFile)
        IF err <> NIL THEN
            gSetText("status", "open " + curFile + ": " + err.Error())
            RETURN
        END IF
        body = string(data)
        DO WHILE LEN(openBufs) <= idx
            openBufs = APPEND(openBufs, "")
        LOOP
        openBufs[idx] = body
    END IF
    gSetText("code", body)
    gSetText("status", "opened " + shorten(curFile, 60))
END SUB

' openFile — open a file in the editor. If it's already open, switch
' to its existing tab; otherwise append a new tab and switch.
SUB openFile(path AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(openFiles) - 1
        IF openFiles[i] = path THEN
            curIdx = i
            refreshTabs()
            switchToTab(i)
            RETURN
        END IF
    NEXT i
    openFiles = APPEND(openFiles, path)
    openDirty = APPEND(openDirty, FALSE)
    curIdx = LEN(openFiles) - 1
    refreshTabs()
    switchToTab(curIdx)
END SUB

' Tree click — open .dbas / .dbproj files via the tab system.
SUB tree_NodeSelected(label AS STRING)
    DIM trimmed AS STRING = strings.TrimSpace(label)
    IF NOT strings.HasSuffix(trimmed, ".dbas") AND NOT strings.HasSuffix(trimmed, ".dbproj") THEN
        gSetText("status", "selected: " + trimmed)
        RETURN
    END IF
    DIM path AS STRING = nodePathForLabel(trimmed)
    IF path = "" THEN
        gSetText("status", "no on-disk file for " + trimmed)
        RETURN
    END IF
    openFile(path)
END SUB

SUB tree_NodeRightClicked(label AS STRING)
    gMsgBox("Tree", "Node: " + label, "OK", "tree-node")
END SUB

' Tab click / arrow nav fires the standard Change event for the TabStrip.
SUB tabs_Change()
    DIM idx AS INTEGER = gGetSelected("tabs")
    IF idx >= 0 AND idx < LEN(openFiles) AND idx <> curIdx THEN switchToTab(idx)
END SUB

' Right-click on a tab fires TabClosed. If the tab is dirty, confirm
' via gMsgBox before discarding; otherwise close immediately.
SUB tabs_TabClosed(label AS STRING, idx AS INTEGER)
    _ = label
    IF idx < 0 OR idx >= LEN(openFiles) THEN RETURN
    ' If the editor's CURRENT buffer for the active tab is dirty and
    ' we're closing that same tab, the snapshot in openDirty hasn't
    ' caught up to the latest keystroke yet. Sync it.
    IF idx = curIdx THEN
        DIM live AS STRING = gGetText("code")
        DIM snap AS STRING = ""
        IF idx < LEN(openBufs) THEN snap = openBufs[idx]
        IF live <> snap THEN
            DO WHILE LEN(openDirty) <= idx
                openDirty = APPEND(openDirty, FALSE)
            LOOP
            openDirty[idx] = TRUE
        END IF
    END IF
    DIM dirty AS BOOLEAN = FALSE
    IF idx < LEN(openDirty) THEN dirty = openDirty[idx]
    IF dirty THEN
        pendingCloseIdx = idx
        gMsgBox("Close tab", baseName(openFiles[idx]) + " has unsaved changes. Discard?", "Discard,Cancel", "close-tab")
        RETURN
    END IF
    doCloseTab(idx)
END SUB

' doCloseTab — actually drop tab idx from openFiles/openBufs/openDirty
' and switch to a neighbor. Called by tabs_TabClosed (clean tab) and
' by the gMsgBox "Discard" branch (dirty tab confirmed).
SUB doCloseTab(idx AS INTEGER)
    IF idx < 0 OR idx >= LEN(openFiles) THEN RETURN
    DIM newFiles AS []STRING
    DIM newBufs  AS []STRING
    DIM newDirty AS []BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(openFiles) - 1
        IF i <> idx THEN
            newFiles = APPEND(newFiles, openFiles[i])
            DIM b AS STRING = ""
            IF i < LEN(openBufs) THEN b = openBufs[i]
            newBufs = APPEND(newBufs, b)
            DIM d AS BOOLEAN = FALSE
            IF i < LEN(openDirty) THEN d = openDirty[i]
            newDirty = APPEND(newDirty, d)
        END IF
    NEXT i
    openFiles = newFiles
    openBufs = newBufs
    openDirty = newDirty
    IF LEN(openFiles) = 0 THEN
        curIdx = 0 - 1
        curFile = ""
        gSetText("code", "")
        refreshTabs()
        gSetText("status", "closed last tab")
        RETURN
    END IF
    DIM newCur AS INTEGER = idx
    IF newCur >= LEN(openFiles) THEN newCur = LEN(openFiles) - 1
    curIdx = 0 - 1
    refreshTabs()
    switchToTab(newCur)
END SUB

' saveCurrent — write the active tab's editor buffer to disk +
' clear its dirty flag. Returns TRUE on success.
FUNCTION saveCurrent() AS BOOLEAN
    IF curFile = "" THEN RETURN FALSE
    DIM body AS STRING = gGetText("code")
    DIM err AS ERROR = os.WriteFile(curFile, Encode(body), 0644)
    IF err <> NIL THEN
        gSetText("status", "save failed: " + err.Error())
        RETURN FALSE
    END IF
    IF curIdx >= 0 AND curIdx < LEN(openFiles) THEN
        DO WHILE LEN(openBufs) <= curIdx
            openBufs = APPEND(openBufs, "")
        LOOP
        openBufs[curIdx] = body
        DO WHILE LEN(openDirty) <= curIdx
            openDirty = APPEND(openDirty, FALSE)
        LOOP
        IF openDirty[curIdx] THEN
            openDirty[curIdx] = FALSE
            refreshTabs()
        END IF
    END IF
    RETURN TRUE
END FUNCTION

' CodeEditor Change — fires on every keystroke. Update the dirty
' flag for the current tab (buffer differs from openBufs snapshot).
' Cheap-but-not-free; OK for the skeleton.
SUB code_Change()
    IF curIdx < 0 OR curIdx >= LEN(openFiles) THEN RETURN
    DIM body AS STRING = gGetText("code")
    DIM diskSnap AS STRING = ""
    IF curIdx < LEN(openBufs) THEN diskSnap = openBufs[curIdx]
    DIM dirty AS BOOLEAN = (body <> diskSnap)
    DO WHILE LEN(openDirty) <= curIdx
        openDirty = APPEND(openDirty, FALSE)
    LOOP
    IF dirty <> openDirty[curIdx] THEN
        openDirty[curIdx] = dirty
        refreshTabs()
    END IF
END SUB

' Canvas placeholders.
SUB canvas_ChildAdded(childId AS STRING)
    _ = childId
END SUB
SUB canvas_ChildSelected(childId AS STRING)
    gSetText("status", "canvas: " + childId)
END SUB
SUB canvas_ChildMoved(childId AS STRING)
    _ = childId
END SUB

' Property edit commit — read each row out of the grid and apply
' relevant fields back to curSelWidget. Only X/Y/Width/Height/Text/
' Visible are wired (and X/Y/W/H get clobbered each frame for slot
' widgets owned by a SplitPanel, so editing non-slot widgets works
' best). Status reflects what changed.
SUB props_Change()
    IF curSelWidget = "" OR curSelWidget = "props" THEN RETURN
    DIM target AS STRING = curSelWidget
    DIM applied AS []STRING
    DIM xs AS STRING = pgValueFor("props", "X")
    IF xs <> "" THEN
        DIM xv AS INTEGER
        DIM xerr AS ERROR
        xv, xerr = strconv.Atoi(strings.TrimSpace(xs))
        IF xerr = NIL AND xv <> gGetX(target) THEN
            gSetX(target, xv)
            applied = APPEND(applied, fmt.Sprintf("X=%d", xv))
        END IF
    END IF
    DIM ys AS STRING = pgValueFor("props", "Y")
    IF ys <> "" THEN
        DIM yv AS INTEGER
        DIM yerr AS ERROR
        yv, yerr = strconv.Atoi(strings.TrimSpace(ys))
        IF yerr = NIL AND yv <> gGetY(target) THEN
            gSetY(target, yv)
            applied = APPEND(applied, fmt.Sprintf("Y=%d", yv))
        END IF
    END IF
    DIM ws AS STRING = pgValueFor("props", "Width")
    IF ws <> "" THEN
        DIM wv AS INTEGER
        DIM werr AS ERROR
        wv, werr = strconv.Atoi(strings.TrimSpace(ws))
        IF werr = NIL AND wv <> gGetW(target) THEN
            gSetW(target, wv)
            applied = APPEND(applied, fmt.Sprintf("W=%d", wv))
        END IF
    END IF
    DIM hs AS STRING = pgValueFor("props", "Height")
    IF hs <> "" THEN
        DIM hv AS INTEGER
        DIM herr AS ERROR
        hv, herr = strconv.Atoi(strings.TrimSpace(hs))
        IF herr = NIL AND hv <> gGetH(target) THEN
            gSetH(target, hv)
            applied = APPEND(applied, fmt.Sprintf("H=%d", hv))
        END IF
    END IF
    DIM textVal AS STRING = pgValueFor("props", "Text")
    IF textVal <> gGetText(target) THEN
        gSetText(target, textVal)
        applied = APPEND(applied, "Text")
    END IF
    DIM visStr AS STRING = pgValueFor("props", "Visible")
    DIM visNew AS BOOLEAN = (strings.ToLower(strings.TrimSpace(visStr)) = "true")
    IF visNew <> gGetVisible(target) THEN
        gSetVisible(target, visNew)
        applied = APPEND(applied, fmt.Sprintf("Visible=%v", visNew))
    END IF
    IF LEN(applied) > 0 THEN
        gSetText("status", target + ": " + strings.Join(applied, ", "))
        ' Re-render the panel from the now-mutated widget so the user
        ' sees their change reflected (and stale int parsing doesn't
        ' re-apply on subsequent commits).
        gSetItems("props", propsFor(target))
    END IF
END SUB

' Top menu — dispatched as "section.action". Reuses the button /
' hotkey handlers so the menu is just another way to drive them.
SUB mainmenu_Action(action AS STRING)
    IF action = "file.save" THEN
        IF curFile = "" THEN
            gSetText("status", "nothing to save")
            RETURN
        END IF
        IF saveCurrent() THEN gSetText("status", "saved " + shorten(curFile, 60))
        RETURN
    END IF
    IF action = "file.saveall" THEN
        DIM saved AS INTEGER = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(openFiles) - 1
            IF i < LEN(openDirty) AND openDirty[i] THEN
                DIM body AS STRING = ""
                IF i = curIdx THEN
                    body = gGetText("code")
                ELSEIF i < LEN(openBufs) THEN
                    body = openBufs[i]
                END IF
                DIM err AS ERROR = os.WriteFile(openFiles[i], Encode(body), 0644)
                IF err = NIL THEN
                    openDirty[i] = FALSE
                    IF i < LEN(openBufs) THEN openBufs[i] = body
                    saved = saved + 1
                END IF
            END IF
        NEXT i
        refreshTabs()
        gSetText("status", fmt.Sprintf("saved %d file(s)", saved))
        RETURN
    END IF
    IF action = "file.quit" THEN
        gQuit()
        RETURN
    END IF
    IF action = "run.run" OR action = "run.build" THEN
        runBtn_Click()
        RETURN
    END IF
    IF action = "run.check" THEN
        checkBtn_Click()
        RETURN
    END IF
    IF action = "help.about" THEN
        gMsgBox("About DBtui", "Self-hosted DBtui skeleton — built in DBasic on the extracted widget set.", "OK", "about")
        RETURN
    END IF
    IF action = "help.keys" THEN
        gMsgBox("Keys", "F5 Run · F6 Check · Ctrl+S Save · Click tree · Right-click tab to close", "OK", "keys")
        RETURN
    END IF
    gSetText("status", "menu: " + action)
END SUB

' Check button.
SUB checkBtn_Click()
    IF curFile = "" THEN
        gMsgBox("Check", "Open a file first.", "OK", "")
        RETURN
    END IF
    gMsgBox("Check", "Run `dbasic check` on " + shorten(curFile, 50) + "?", "Yes,No", "check")
END SUB

' Run button — save the current tab if dirty, build curFile, gExec
' the result. Save-before-run ensures the build sees the live buffer.
SUB runBtn_Click()
    IF curFile = "" THEN
        gMsgBox("Run", "Open a .dbas file first.", "OK", "")
        RETURN
    END IF
    DIM isDirty AS BOOLEAN = FALSE
    IF curIdx >= 0 AND curIdx < LEN(openDirty) THEN isDirty = openDirty[curIdx]
    IF NOT isDirty THEN
        ' Even when openDirty says clean, the editor buffer might be
        ' a hair ahead of openBufs. Compare and save if different.
        DIM live AS STRING = gGetText("code")
        DIM snap AS STRING = ""
        IF curIdx >= 0 AND curIdx < LEN(openBufs) THEN snap = openBufs[curIdx]
        IF live <> snap THEN isDirty = TRUE
    END IF
    IF isDirty THEN
        IF NOT saveCurrent() THEN RETURN
    END IF
    DIM outBin AS STRING = "/tmp/dbtui_run"
    gSetText("status", "building " + shorten(curFile, 50) + "...")
    DIM code AS INTEGER = dbBuild_RunWith(curFile + ",-o," + outBin)
    IF code <> 0 THEN
        DIM err AS STRING = strings.TrimSpace(dbBuild_Stderr())
        IF err = "" THEN err = strings.TrimSpace(dbBuild_Stdout())
        gMsgBox("Build failed", shorten(err, 60), "OK", "build-fail")
        RETURN
    END IF
    gSetText("status", "built " + outBin + ", launching...")
    gExec(outBin, "")
END SUB

SUB gMsgBoxClosed(button AS STRING, context AS STRING)
    IF context = "close-tab" THEN
        IF button = "Discard" THEN
            doCloseTab(pendingCloseIdx)
        ELSE
            gSetText("status", "close cancelled")
        END IF
        pendingCloseIdx = 0 - 1
        RETURN
    END IF
    IF context = "check" AND button = "Yes" THEN
        DIM code AS INTEGER = dbCheck_RunWith(curFile)
        IF code = 0 THEN
            DIM ok AS STRING = strings.TrimSpace(dbCheck_Stdout())
            IF ok = "" THEN ok = "OK"
            gSetText("status", "check: " + ok)
        ELSE
            DIM err AS STRING = strings.TrimSpace(dbCheck_Stderr())
            IF err = "" THEN err = strings.TrimSpace(dbCheck_Stdout())
            gMsgBox("Check failed", shorten(err, 60), "OK", "check-fail")
        END IF
    END IF
END SUB

' Global hotkeys:
'   Ctrl+S — save editor buffer to curFile
'   F5     — run (build + launch via gExec)
'   F6     — check (dbasic check curFile)
SUB FormKey(key AS STRING)
    IF key = "ctrl+s" THEN
        IF curFile = "" THEN
            gSetText("status", "Ctrl+S: nothing to save")
            RETURN
        END IF
        IF saveCurrent() THEN
            DIM size AS INTEGER = LEN(gGetText("code"))
            gSetText("status", "saved " + shorten(curFile, 60) + " (" + fmt.Sprintf("%d", size) + " bytes)")
        END IF
        RETURN
    END IF
    IF key = "f5" THEN
        runBtn_Click()
        RETURN
    END IF
    IF key = "f6" THEN
        IF curFile = "" THEN
            gSetText("status", "F6: open a file first")
            RETURN
        END IF
        DIM code AS INTEGER = dbCheck_RunWith(curFile)
        IF code = 0 THEN
            DIM ok AS STRING = strings.TrimSpace(dbCheck_Stdout())
            IF ok = "" THEN ok = "OK"
            gSetText("status", "check: " + ok)
        ELSE
            DIM err2 AS STRING = strings.TrimSpace(dbCheck_Stderr())
            IF err2 = "" THEN err2 = strings.TrimSpace(dbCheck_Stdout())
            gMsgBox("Check failed", shorten(err2, 60), "OK", "check-fail")
        END IF
        RETURN
    END IF
END SUB
