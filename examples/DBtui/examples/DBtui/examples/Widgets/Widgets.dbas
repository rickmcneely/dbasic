IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM textinput1_Val AS STRING
    DIM checkbox1_Val AS BOOLEAN
    DIM radiobutton1_Val AS BOOLEAN
    DIM combobox1_Val AS INTEGER
    DIM listbox1_Val AS INTEGER
    DIM progressbar1_Val AS INTEGER
    DIM scrollbar1_Val AS INTEGER
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        RETURN m, NIL
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF mc.X >= 2 AND mc.X < 2 + 1 AND mc.Y >= 9 AND mc.Y < 9 + 8 THEN
            m.Focus = 8
            DIM mcRelY8 AS INTEGER = mc.Y - 9
            IF mcRelY8 = 0 THEN
                IF m.scrollbar1_Val > 0 THEN m.scrollbar1_Val = m.scrollbar1_Val - 1
                dispatchChange("scrollbar1")
            ELSEIF mcRelY8 = 8 - 1 THEN
                IF m.scrollbar1_Val < 100 THEN m.scrollbar1_Val = m.scrollbar1_Val + 1
                dispatchChange("scrollbar1")
            END IF
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 20 AND mc.Y >= 17 AND mc.Y < 17 + 1 THEN
            m.Focus = 7
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 18 AND mc.Y >= 7 AND mc.Y < 7 + 5 THEN
            m.Focus = 6
            DIM mcRelRow6 AS INTEGER = mc.Y - 7
            IF mcRelRow6 >= 0 AND mcRelRow6 < 3 THEN
                m.listbox1_Val = mcRelRow6
                dispatchChange("listbox1")
            END IF
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 16 AND mc.Y >= 6 AND mc.Y < 6 + 1 THEN
            m.Focus = 5
            m.combobox1_Val = (m.combobox1_Val + 1) MOD 3
            dispatchChange("combobox1")
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 14 AND mc.Y >= 5 AND mc.Y < 5 + 1 THEN
            m.Focus = 4
            m.radiobutton1_Val = TRUE
            dispatchChange("radiobutton1")
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 14 AND mc.Y >= 4 AND mc.Y < 4 + 1 THEN
            m.Focus = 3
            m.checkbox1_Val = NOT m.checkbox1_Val
            dispatchChange("checkbox1")
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 16 AND mc.Y >= 3 AND mc.Y < 3 + 1 THEN
            m.Focus = 2
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 10 AND mc.Y >= 2 AND mc.Y < 2 + 1 THEN
            m.Focus = 1
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 12 AND mc.Y >= 1 AND mc.Y < 1 + 1 THEN
            m.Focus = 0
            dispatchClick("button1")
            RETURN m, NIL
        END IF
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        IF key = "ctrl+c" OR key = "esc" THEN RETURN m, tea.Quit
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 9
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 8
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            IF key = "enter" OR key = "space" THEN dispatchClick("button1")
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            _ = key
            RETURN m, NIL
        END IF
        IF m.Focus = 2 THEN
            IF LEN(key) = 1 THEN m.textinput1_Val = m.textinput1_Val + key
            IF key = "space" THEN m.textinput1_Val = m.textinput1_Val + " "
            IF key = "backspace" AND LEN(m.textinput1_Val) > 0 THEN
                m.textinput1_Val = Mid(m.textinput1_Val, 1, LEN(m.textinput1_Val) - 1)
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 3 THEN
            IF key = "space" OR key = "enter" THEN
                m.checkbox1_Val = NOT m.checkbox1_Val
                dispatchChange("checkbox1")
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 4 THEN
            IF key = "space" OR key = "enter" THEN
                m.radiobutton1_Val = TRUE
                dispatchChange("radiobutton1")
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 5 THEN
            IF key = "up" THEN
                IF m.combobox1_Val > 0 THEN
                    m.combobox1_Val = m.combobox1_Val - 1
                    dispatchChange("combobox1")
                END IF
            END IF
            IF key = "down" THEN
                IF m.combobox1_Val < 3 - 1 THEN
                    m.combobox1_Val = m.combobox1_Val + 1
                    dispatchChange("combobox1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 6 THEN
            IF key = "up" THEN
                IF m.listbox1_Val > 0 THEN
                    m.listbox1_Val = m.listbox1_Val - 1
                    dispatchChange("listbox1")
                END IF
            END IF
            IF key = "down" THEN
                IF m.listbox1_Val < 3 - 1 THEN
                    m.listbox1_Val = m.listbox1_Val + 1
                    dispatchChange("listbox1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 7 THEN
            _ = key
            RETURN m, NIL
        END IF
        IF m.Focus = 8 THEN
            IF key = "up" THEN
                IF m.scrollbar1_Val > 0 THEN
                    m.scrollbar1_Val = m.scrollbar1_Val - 1
                    dispatchChange("scrollbar1")
                END IF
            END IF
            IF key = "down" THEN
                IF m.scrollbar1_Val < 100 THEN
                    m.scrollbar1_Val = m.scrollbar1_Val + 1
                    dispatchChange("scrollbar1")
                END IF
            END IF
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM rows AS []STRING
    DIM r AS INTEGER
    FOR r = 0 TO h - 2
        rows = APPEND(rows, strings.Repeat(" ", w))
    NEXT r
    DIM body0 AS STRING
    body0 = "[ Button ]"
    IF m.Focus = 0 THEN
        body0 = ">" + body0
    ELSE
        body0 = " " + body0
    END IF
    IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 2, body0)
    DIM body1 AS STRING
    body1 = "Label"
    IF m.Focus = 1 THEN
        body1 = ">" + body1
    ELSE
        body1 = " " + body1
    END IF
    IF 2 >= 0 AND 2 < LEN(rows) THEN rows[2] = overlayRow(rows[2], 2, body1)
    DIM body2 AS STRING
    body2 = "[" + m.textinput1_Val + strings.Repeat(" ", 16 - 2 - LEN(m.textinput1_Val)) + "]"
    IF m.Focus = 2 THEN
        body2 = ">" + body2
    ELSE
        body2 = " " + body2
    END IF
    IF 3 >= 0 AND 3 < LEN(rows) THEN rows[3] = overlayRow(rows[3], 2, body2)
    DIM body3 AS STRING
    IF m.checkbox1_Val THEN
        body3 = "[x] option"
    ELSE
        body3 = "[ ] option"
    END IF
    IF m.Focus = 3 THEN
        body3 = ">" + body3
    ELSE
        body3 = " " + body3
    END IF
    IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 2, body3)
    DIM body4 AS STRING
    IF m.radiobutton1_Val THEN
        body4 = "(o) option"
    ELSE
        body4 = "( ) option"
    END IF
    IF m.Focus = 4 THEN
        body4 = ">" + body4
    ELSE
        body4 = " " + body4
    END IF
    IF 5 >= 0 AND 5 < LEN(rows) THEN rows[5] = overlayRow(rows[5], 2, body4)
    DIM body5 AS STRING
    DIM cbItems5 AS []STRING
    cbItems5 = APPEND(cbItems5, "red")
    cbItems5 = APPEND(cbItems5, "green")
    cbItems5 = APPEND(cbItems5, "blue")
    DIM cbCur5 AS STRING = ""
    IF m.combobox1_Val >= 0 AND m.combobox1_Val < LEN(cbItems5) THEN cbCur5 = cbItems5[m.combobox1_Val]
    IF LEN(cbCur5) > 12 THEN cbCur5 = Mid(cbCur5, 1, 12)
    IF LEN(cbCur5) < 12 THEN cbCur5 = cbCur5 + strings.Repeat(" ", 12 - LEN(cbCur5))
    body5 = "[" + cbCur5 + " v]"
    IF m.Focus = 5 THEN
        body5 = ">" + body5
    ELSE
        body5 = " " + body5
    END IF
    IF 6 >= 0 AND 6 < LEN(rows) THEN rows[6] = overlayRow(rows[6], 2, body5)
    DIM items6 AS []STRING
    items6 = APPEND(items6, "item one")
    items6 = APPEND(items6, "item two")
    items6 = APPEND(items6, "item three")
    DIM lbi6 AS INTEGER
    FOR lbi6 = 0 TO 5 - 1
        DIM lbItem6 AS STRING = ""
        IF lbi6 < LEN(items6) THEN lbItem6 = items6[lbi6]
        IF LEN(lbItem6) > 16 THEN lbItem6 = Mid(lbItem6, 1, 16)
        IF LEN(lbItem6) < 16 THEN lbItem6 = lbItem6 + strings.Repeat(" ", 16 - LEN(lbItem6))
        DIM lbMark6 AS STRING = "  "
        IF lbi6 = m.listbox1_Val THEN lbMark6 = "▶ "
        DIM lbRow6 AS STRING = lbMark6 + lbItem6
        IF lbi6 = 0 THEN
            IF m.Focus = 6 THEN
                lbRow6 = ">" + lbRow6
            ELSE
                lbRow6 = " " + lbRow6
            END IF
        ELSE
            lbRow6 = " " + lbRow6
        END IF
        DIM yPos6 AS INTEGER = 7 + lbi6
        IF yPos6 >= 0 AND yPos6 < LEN(rows) THEN rows[yPos6] = overlayRow(rows[yPos6], 2, lbRow6)
    NEXT lbi6
    DIM body7 AS STRING
    DIM pbFilled7 AS INTEGER = (m.progressbar1_Val - 0) * 18 / 100
    IF pbFilled7 < 0 THEN pbFilled7 = 0
    IF pbFilled7 > 18 THEN pbFilled7 = 18
    body7 = "[" + strings.Repeat("█", pbFilled7) + strings.Repeat("░", 18 - pbFilled7) + "]"
    IF m.Focus = 7 THEN
        body7 = ">" + body7
    ELSE
        body7 = " " + body7
    END IF
    IF 17 >= 0 AND 17 < LEN(rows) THEN rows[17] = overlayRow(rows[17], 2, body7)
    DIM svi8 AS INTEGER
    DIM svThumb8 AS INTEGER = 1 + ((m.scrollbar1_Val - 0) * (8 - 3)) / 100
    IF svThumb8 < 1 THEN svThumb8 = 1
    IF svThumb8 > 8 - 2 THEN svThumb8 = 8 - 2
    FOR svi8 = 0 TO 8 - 1
        DIM svGlyph8 AS STRING = "│"
        IF svi8 = 0 THEN svGlyph8 = "▲"
        IF svi8 = 8 - 1 THEN svGlyph8 = "▼"
        IF svi8 = svThumb8 THEN svGlyph8 = "█"
        IF svi8 = 0 THEN
            IF m.Focus = 8 THEN
                svGlyph8 = ">" + svGlyph8
            ELSE
                svGlyph8 = " " + svGlyph8
            END IF
        ELSE
            svGlyph8 = " " + svGlyph8
        END IF
        DIM svY8 AS INTEGER = 9 + svi8
        IF svY8 >= 0 AND svY8 < LEN(rows) THEN rows[svY8] = overlayRow(rows[svY8], 2, svGlyph8)
    NEXT svi8
    rows = APPEND(rows, " — Tab to cycle focus, Esc to quit")
    DIM fullView AS STRING = strings.Join(rows, "\n")
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeCellMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    m.combobox1_Val = 0
    m.listbox1_Val = 0
    m.progressbar1_Val = 40
    m.scrollbar1_Val = 0
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM lf AS STRING = ""
    IF col > 0 AND col <= LEN(row) THEN lf = Mid(row, 1, col)
    DIM rt AS STRING = ""
    IF col + LEN(txt) < LEN(row) THEN rt = Mid(row, col + LEN(txt) + 1, LEN(row) - col - LEN(txt))
    RETURN lf + txt + rt
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    IF id = "button1" THEN button1_Click()
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    IF id = "checkbox1" THEN checkbox1_Change()
    IF id = "radiobutton1" THEN radiobutton1_Change()
    IF id = "combobox1" THEN combobox1_Change()
    IF id = "listbox1" THEN listbox1_Change()
    IF id = "scrollbar1" THEN scrollbar1_Change()
END SUB

