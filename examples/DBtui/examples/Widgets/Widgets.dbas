                    m.listbox1_Val = m.listbox1_Val - 1
                    dispatchChange("listbox1")
                END IF
            END IF
            IF key = "down" THEN
                IF m.listbox1_Val < 3 - 1 THEN
                    m.listbox1_Val = m.listbox1_Val + 1
                    dispatchChange("listbox1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 7 THEN
            _ = key
            RETURN m, NIL
        END IF
        IF m.Focus = 8 THEN
            IF key = "up" THEN
                IF m.scrollbar1_Val > 0 THEN
                    m.scrollbar1_Val = m.scrollbar1_Val - 1
                    dispatchChange("scrollbar1")
