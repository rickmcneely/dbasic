                IF m.scrollpanel1_Scroll > 7 THEN m.scrollpanel1_Scroll = 7
            END IF
            IF key = "home" THEN m.scrollpanel1_Scroll = 0
            IF key = "end" THEN m.scrollpanel1_Scroll = 7
            RETURN m, NIL
