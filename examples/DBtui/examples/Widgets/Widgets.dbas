    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM rows AS []STRING
    DIM r AS INTEGER
    FOR r = 0 TO h - 2
        rows = APPEND(rows, strings.Repeat(" ", w))
    NEXT r
    DIM body0 AS STRING
    body0 = "[ Button ]"
    IF m.Focus = 0 THEN
        body0 = ">" + body0
    ELSE
        body0 = " " + body0
    END IF
    IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 2, body0)
    DIM body1 AS STRING
    body1 = "Label"
    IF m.Focus = 1 THEN
        body1 = ">" + body1
    ELSE
        body1 = " " + body1
    END IF
    IF 2 >= 0 AND 2 < LEN(rows) THEN rows[2] = overlayRow(rows[2], 2, body1)
    DIM body2 AS STRING
    body2 = "[" + m.textinput1_Val + strings.Repeat(" ", 16 - 2 - LEN(m.textinput1_Val)) + "]"
    IF m.Focus = 2 THEN
        body2 = ">" + body2
    ELSE
        body2 = " " + body2
    END IF
    IF 3 >= 0 AND 3 < LEN(rows) THEN rows[3] = overlayRow(rows[3], 2, body2)
    DIM body3 AS STRING
    IF m.checkbox1_Val THEN
        body3 = "[x] option"
    ELSE
        body3 = "[ ] option"
    END IF
    IF m.Focus = 3 THEN
        body3 = ">" + body3
    ELSE
        body3 = " " + body3
    END IF
    IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 2, body3)
    DIM body4 AS STRING
    IF m.radiobutton1_Val THEN
        body4 = "(o) option"
    ELSE
        body4 = "( ) option"
    END IF
    IF m.Focus = 4 THEN
        body4 = ">" + body4
    ELSE
        body4 = " " + body4
    END IF
    IF 5 >= 0 AND 5 < LEN(rows) THEN rows[5] = overlayRow(rows[5], 2, body4)
    DIM body5 AS STRING
    DIM cbItems5 AS []STRING
    cbItems5 = APPEND(cbItems5, "red")
    cbItems5 = APPEND(cbItems5, "green")
    cbItems5 = APPEND(cbItems5, "blue")
    DIM cbCur5 AS STRING = ""
    IF m.combobox1_Val >= 0 AND m.combobox1_Val < LEN(cbItems5) THEN cbCur5 = cbItems5[m.combobox1_Val]
    IF LEN(cbCur5) > 12 THEN cbCur5 = Mid(cbCur5, 1, 12)
    IF LEN(cbCur5) < 12 THEN cbCur5 = cbCur5 + strings.Repeat(" ", 12 - LEN(cbCur5))
    body5 = "[" + cbCur5 + " v]"
    IF m.Focus = 5 THEN
        body5 = ">" + body5
    ELSE
        body5 = " " + body5
    END IF
    IF 6 >= 0 AND 6 < LEN(rows) THEN rows[6] = overlayRow(rows[6], 2, body5)
    DIM items6 AS []STRING
    items6 = APPEND(items6, "item one")
    items6 = APPEND(items6, "item two")
    items6 = APPEND(items6, "item three")
    DIM lbi6 AS INTEGER
    FOR lbi6 = 0 TO 5 - 1
        DIM lbItem6 AS STRING = ""
        IF lbi6 < LEN(items6) THEN lbItem6 = items6[lbi6]
        IF LEN(lbItem6) > 16 THEN lbItem6 = Mid(lbItem6, 1, 16)
        IF LEN(lbItem6) < 16 THEN lbItem6 = lbItem6 + strings.Repeat(" ", 16 - LEN(lbItem6))
        DIM lbMark6 AS STRING = "  "
        IF lbi6 = m.listbox1_Val THEN lbMark6 = "▶ "
        DIM lbRow6 AS STRING = lbMark6 + lbItem6
        IF lbi6 = 0 THEN
            IF m.Focus = 6 THEN
                lbRow6 = ">" + lbRow6
            ELSE
                lbRow6 = " " + lbRow6
            END IF
        ELSE
            lbRow6 = " " + lbRow6
        END IF
        DIM yPos6 AS INTEGER = 7 + lbi6
        IF yPos6 >= 0 AND yPos6 < LEN(rows) THEN rows[yPos6] = overlayRow(rows[yPos6], 2, lbRow6)
    NEXT lbi6
    DIM body7 AS STRING
    DIM pbFilled7 AS INTEGER = (m.progressbar1_Val - 0) * 18 / 100
    IF pbFilled7 < 0 THEN pbFilled7 = 0
    IF pbFilled7 > 18 THEN pbFilled7 = 18
    body7 = "[" + strings.Repeat("█", pbFilled7) + strings.Repeat("░", 18 - pbFilled7) + "]"
    IF m.Focus = 7 THEN
        body7 = ">" + body7
    ELSE
        body7 = " " + body7
    END IF
    IF 17 >= 0 AND 17 < LEN(rows) THEN rows[17] = overlayRow(rows[17], 2, body7)
    DIM svi8 AS INTEGER
    DIM svThumb8 AS INTEGER = 1 + ((m.scrollbar1_Val - 0) * (8 - 3)) / 100
    IF svThumb8 < 1 THEN svThumb8 = 1
    IF svThumb8 > 8 - 2 THEN svThumb8 = 8 - 2
    FOR svi8 = 0 TO 8 - 1
        DIM svGlyph8 AS STRING = "│"
        IF svi8 = 0 THEN svGlyph8 = "▲"
        IF svi8 = 8 - 1 THEN svGlyph8 = "▼"
        IF svi8 = svThumb8 THEN svGlyph8 = "█"
        IF svi8 = 0 THEN
            IF m.Focus = 8 THEN
                svGlyph8 = ">" + svGlyph8
            ELSE
                svGlyph8 = " " + svGlyph8
            END IF
        ELSE
            svGlyph8 = " " + svGlyph8
        END IF
        DIM svY8 AS INTEGER = 9 + svi8
        IF svY8 >= 0 AND svY8 < LEN(rows) THEN rows[svY8] = overlayRow(rows[svY8], 2, svGlyph8)
    NEXT svi8
    DIM tsItems9 AS []STRING
    tsItems9 = APPEND(tsItems9, "General")
    tsItems9 = APPEND(tsItems9, "Advanced")
    tsItems9 = APPEND(tsItems9, "About")
    DIM tsBar9 AS STRING = ""
    DIM tsk9 AS INTEGER
    FOR tsk9 = 0 TO LEN(tsItems9) - 1
        IF tsk9 > 0 THEN tsBar9 = tsBar9 + "│"
        IF tsk9 = m.tabstrip1_Val THEN
            tsBar9 = tsBar9 + "[" + tsItems9[tsk9] + "]"
        ELSE
            tsBar9 = tsBar9 + " " + tsItems9[tsk9] + " "
        END IF
    NEXT tsk9
    IF m.Focus = 9 THEN
        tsBar9 = ">" + tsBar9
    ELSE
        tsBar9 = " " + tsBar9
    END IF
    IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 30, tsBar9)
    DIM tsRule9 AS STRING = " " + strings.Repeat("─", 28)
    DIM tsRuleY9 AS INTEGER = 1 + 1
    IF tsRuleY9 >= 0 AND tsRuleY9 < LEN(rows) THEN rows[tsRuleY9] = overlayRow(rows[tsRuleY9], 30, tsRule9)
    DIM tsAct9 AS STRING = ""
    IF m.tabstrip1_Val >= 0 AND m.tabstrip1_Val < LEN(tsItems9) THEN tsAct9 = tsItems9[m.tabstrip1_Val]
    DIM tsContent9 AS STRING = " " + tsAct9 + " tab"
    DIM tsContentY9 AS INTEGER = 1 + 2
    IF tsContentY9 >= 0 AND tsContentY9 < LEN(rows) THEN rows[tsContentY9] = overlayRow(rows[tsContentY9], 30, tsContent9)
    DIM tnVis10 AS []INTEGER = treeVisibleRows(tree1_depths(), m.tree1_Collapsed)
    DIM tnDep10 AS []INTEGER = tree1_depths()
    DIM tnLab10 AS []STRING = tree1_labels()
    DIM tnR10 AS INTEGER
    FOR tnR10 = 0 TO 6 - 1
        IF tnR10 < LEN(tnVis10) THEN
            DIM tnIdx10 AS INTEGER = tnVis10[tnR10]
            DIM tnD10 AS INTEGER = tnDep10[tnIdx10]
            DIM tnG10 AS STRING = "•"
            IF tree1_isParent(tnIdx10) THEN
                tnG10 = "▾"
                IF tnIdx10 < LEN(m.tree1_Collapsed) AND m.tree1_Collapsed[tnIdx10] THEN tnG10 = "▸"
            END IF
            DIM tnLine10 AS STRING = strings.Repeat("  ", tnD10) + tnG10 + " " + tnLab10[tnIdx10]
            IF tnIdx10 = m.tree1_Val THEN
                tnLine10 = ">" + tnLine10
            ELSE
                tnLine10 = " " + tnLine10
            END IF
            DIM tnY10 AS INTEGER = 7 + tnR10
            IF tnY10 >= 0 AND tnY10 < LEN(rows) THEN rows[tnY10] = overlayRow(rows[tnY10], 30, tnLine10)
        END IF
    NEXT tnR10
    DIM taTop11 AS STRING = "┌" + strings.Repeat("─", 20) + "┐"
    IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 56, taTop11)
    DIM taLines11 AS []STRING = strings.Split(m.textarea1_Val, "\n")
    DIM taCRow11 AS INTEGER
    DIM taCCol11 AS INTEGER
    taCRow11, taCCol11 = taRowCol(m.textarea1_Val, m.textarea1_Cur)
    DIM taStart11 AS INTEGER = 0
    IF taCRow11 >= 3 THEN taStart11 = taCRow11 - 3 + 1
    DIM taRow11 AS INTEGER
    FOR taRow11 = 0 TO 3 - 1
        DIM taSrc11 AS INTEGER = taStart11 + taRow11
        DIM taLn11 AS STRING = ""
        IF taSrc11 < LEN(taLines11) THEN taLn11 = taLines11[taSrc11]
        IF m.Focus = 11 AND taSrc11 = taCRow11 THEN
            DIM taCp11 AS INTEGER = taCCol11
            IF taCp11 >= LEN(taLn11) THEN
                taLn11 = taLn11 + "█"
            ELSE
                taLn11 = Mid(taLn11, 1, taCp11) + "█" + Mid(taLn11, taCp11 + 2, LEN(taLn11) - taCp11 - 1)
            END IF
        END IF
        IF lipgloss.Width(taLn11) > 20 THEN taLn11 = Mid(taLn11, 1, 20)
        IF lipgloss.Width(taLn11) < 20 THEN taLn11 = taLn11 + strings.Repeat(" ", 20 - lipgloss.Width(taLn11))
        DIM taLine11 AS STRING = "│" + taLn11 + "│"
        DIM taY11 AS INTEGER = 1 + 1 + taRow11
        IF taY11 >= 0 AND taY11 < LEN(rows) THEN rows[taY11] = overlayRow(rows[taY11], 56, taLine11)
    NEXT taRow11
    DIM taBot11 AS STRING = "└" + strings.Repeat("─", 20) + "┘"
    DIM taBotY11 AS INTEGER = 1 + 5 - 1
    IF taBotY11 >= 0 AND taBotY11 < LEN(rows) THEN rows[taBotY11] = overlayRow(rows[taBotY11], 56, taBot11)
    DIM gKeys12 AS []STRING
    DIM gVals12 AS []STRING
    gKeys12 = APPEND(gKeys12, "Name")
    gVals12 = APPEND(gVals12, "Widget1")
    gKeys12 = APPEND(gKeys12, "Width")
    gVals12 = APPEND(gVals12, "100")
    gKeys12 = APPEND(gKeys12, "Height")
    gVals12 = APPEND(gVals12, "40")
    gKeys12 = APPEND(gKeys12, "Visible")
    gVals12 = APPEND(gVals12, "true")
    DIM gRow12 AS INTEGER
    FOR gRow12 = 0 TO 5 - 1
        IF gRow12 < LEN(gKeys12) THEN
            DIM gk12 AS STRING = gKeys12[gRow12]
            DIM gv12 AS STRING = gVals12[gRow12]
            IF lipgloss.Width(gk12) > 10 THEN gk12 = Mid(gk12, 1, 10)
            IF lipgloss.Width(gk12) < 10 THEN gk12 = gk12 + strings.Repeat(" ", 10 - lipgloss.Width(gk12))
            DIM gmk12 AS STRING = "  "
            IF gRow12 = m.propgrid1_Val THEN gmk12 = "▶ "
            DIM gLine12 AS STRING = gmk12 + gk12 + "│ " + gv12
            DIM gY12 AS INTEGER = 7 + gRow12
            IF gY12 >= 0 AND gY12 < LEN(rows) THEN rows[gY12] = overlayRow(rows[gY12], 56, gLine12)
        END IF
    NEXT gRow12
    DIM spItems13 AS []STRING
    spItems13 = APPEND(spItems13, "Content line 1")
    spItems13 = APPEND(spItems13, "Content line 2")
    spItems13 = APPEND(spItems13, "Content line 3")
    spItems13 = APPEND(spItems13, "Content line 4")
    spItems13 = APPEND(spItems13, "Content line 5")
    spItems13 = APPEND(spItems13, "Content line 6")
    spItems13 = APPEND(spItems13, "Content line 7")
    spItems13 = APPEND(spItems13, "Content line 8")
    spItems13 = APPEND(spItems13, "Content line 9")
    spItems13 = APPEND(spItems13, "Content line 10")
    spItems13 = APPEND(spItems13, "Content line 11")
    spItems13 = APPEND(spItems13, "Content line 12")
    DIM spTop13 AS STRING = "┌" + strings.Repeat("─", 24) + "┐"
    IF 14 >= 0 AND 14 < LEN(rows) THEN rows[14] = overlayRow(rows[14], 30, spTop13)
    DIM spThumb13 AS INTEGER = 0 - 1
    IF 7 > 0 AND 3 > 0 THEN
        spThumb13 = (m.scrollpanel1_Scroll * (3 - 1)) / 7
        IF spThumb13 < 0 THEN spThumb13 = 0
        IF spThumb13 > 3 - 1 THEN spThumb13 = 3 - 1
    END IF
    DIM spRow13 AS INTEGER
    FOR spRow13 = 0 TO 5 - 1
        DIM spSrc13 AS INTEGER = m.scrollpanel1_Scroll + spRow13
        DIM spcl13 AS STRING = ""
        IF spSrc13 < LEN(spItems13) THEN spcl13 = spItems13[spSrc13]
        IF lipgloss.Width(spcl13) > 23 THEN spcl13 = Mid(spcl13, 1, 23)
        IF lipgloss.Width(spcl13) < 23 THEN spcl13 = spcl13 + strings.Repeat(" ", 23 - lipgloss.Width(spcl13))
        DIM spsb13 AS STRING = "░"
        IF spRow13 = 0 THEN spsb13 = "▲"
        IF spRow13 = 5 - 1 THEN spsb13 = "▼"
        IF spRow13 >= 1 AND spRow13 <= 5 - 2 AND (spRow13 - 1) = spThumb13 THEN spsb13 = "█"
        DIM spLine13 AS STRING = "│" + spcl13 + spsb13 + "│"
        DIM spY13 AS INTEGER = 14 + 1 + spRow13
        IF spY13 >= 0 AND spY13 < LEN(rows) THEN rows[spY13] = overlayRow(rows[spY13], 30, spLine13)
    NEXT spRow13
    DIM spBot13 AS STRING = "└" + strings.Repeat("─", 24) + "┘"
    DIM spBotY13 AS INTEGER = 14 + 6
    IF spBotY13 >= 0 AND spBotY13 < LEN(rows) THEN rows[spBotY13] = overlayRow(rows[spBotY13], 30, spBot13)
    rows = APPEND(rows, " — Tab to cycle focus, Esc to quit")
    DIM fullView AS STRING = strings.Join(rows, "\n")
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeCellMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    m.combobox1_Val = 0
    m.listbox1_Val = 0
    m.progressbar1_Val = 40
    m.scrollbar1_Val = 0
    m.tabstrip1_Val = 0
    m.tree1_Val = 0
    DIM seedCtree1 AS INTEGER
    FOR seedCtree1 = 0 TO 5
        m.tree1_Collapsed = APPEND(m.tree1_Collapsed, FALSE)
    NEXT seedCtree1
    m.textarea1_Val = "Edit me..."
    m.textarea1_Cur = LEN(m.textarea1_Val)
    m.propgrid1_Val = 0
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

FUNCTION cellByteIdx(sIn AS STRING, cell AS INTEGER) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DO WHILE b < LEN(sIn) AND c < cell
        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))
        DIM nb AS INTEGER = 1
        IF lead >= 240 THEN
            nb = 4
        ELSEIF lead >= 224 THEN
            nb = 3
        ELSEIF lead >= 192 THEN
            nb = 2
        END IF
        b = b + nb
        c = c + 1
    LOOP
    RETURN b
END FUNCTION

FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM txtCells AS INTEGER = 0
    DIM tb AS INTEGER = 0
    DO WHILE tb < LEN(txt)
        DIM tl AS INTEGER = Asc(Mid(txt, tb + 1, 1))
        DIM tn AS INTEGER = 1
        IF tl >= 240 THEN
            tn = 4
        ELSEIF tl >= 224 THEN
            tn = 3
        ELSEIF tl >= 192 THEN
            tn = 2
        END IF
        tb = tb + tn
        txtCells = txtCells + 1
    LOOP
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + txtCells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    RETURN lf + txt + rt
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    IF id = "button1" THEN button1_Click()
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    IF id = "checkbox1" THEN checkbox1_Change()
    IF id = "radiobutton1" THEN radiobutton1_Change()
    IF id = "combobox1" THEN combobox1_Change()
    IF id = "listbox1" THEN listbox1_Change()
    IF id = "scrollbar1" THEN scrollbar1_Change()
    IF id = "tabstrip1" THEN tabstrip1_Change()
    IF id = "tree1" THEN tree1_Change()
    IF id = "propgrid1" THEN propgrid1_Change()
END SUB

FUNCTION treeVisibleRows(depths AS []INTEGER, collapsed AS []BOOLEAN) AS []INTEGER
    DIM out AS []INTEGER
    DIM i AS INTEGER = 0
    DO WHILE i < LEN(depths)
        out = APPEND(out, i)
        IF i < LEN(collapsed) AND collapsed[i] THEN
            DIM d AS INTEGER = depths[i]
            DIM j AS INTEGER = i + 1
            DO WHILE j < LEN(depths) AND depths[j] > d
                j = j + 1
            LOOP
            i = j
        ELSE
            i = i + 1
        END IF
    LOOP
    RETURN out
END FUNCTION

FUNCTION tree1_depths() AS []INTEGER
    DIM d AS []INTEGER
    d = APPEND(d, 0)
    d = APPEND(d, 1)
    d = APPEND(d, 2)
    d = APPEND(d, 2)
    d = APPEND(d, 1)
    d = APPEND(d, 2)
    RETURN d
END FUNCTION

FUNCTION tree1_labels() AS []STRING
    DIM l AS []STRING
    l = APPEND(l, "Project")
    l = APPEND(l, "src")
    l = APPEND(l, "main.dbas")
    l = APPEND(l, "util.dbas")
    l = APPEND(l, "docs")
    l = APPEND(l, "README.md")
    RETURN l
END FUNCTION

FUNCTION tree1_isParent(i AS INTEGER) AS BOOLEAN
    DIM d AS []INTEGER = tree1_depths()
    IF i < 0 OR i + 1 >= LEN(d) THEN RETURN FALSE
    RETURN d[i + 1] > d[i]
END FUNCTION

FUNCTION taLineHome(text AS STRING, cur AS INTEGER) AS INTEGER
    DIM h AS INTEGER = cur
    DO WHILE h > 0 AND Mid(text, h, 1) <> "\n"
        h = h - 1
    LOOP
    RETURN h
END FUNCTION

FUNCTION taLineEnd(text AS STRING, cur AS INTEGER) AS INTEGER
    DIM e AS INTEGER = cur
    DO WHILE e < LEN(text) AND Mid(text, e + 1, 1) <> "\n"
        e = e + 1
    LOOP
    RETURN e
END FUNCTION

FUNCTION taMoveVert(text AS STRING, cur AS INTEGER, dir AS INTEGER) AS INTEGER
    DIM home AS INTEGER = taLineHome(text, cur)
    DIM col AS INTEGER = cur - home
    IF dir < 0 THEN
        IF home = 0 THEN RETURN cur
        DIM prevHome AS INTEGER = taLineHome(text, home - 1)
        DIM prevLen AS INTEGER = (home - 1) - prevHome
        DIM ncol AS INTEGER = col
        IF ncol > prevLen THEN ncol = prevLen
        RETURN prevHome + ncol
    END IF
    DIM le AS INTEGER = taLineEnd(text, cur)
    IF le >= LEN(text) THEN RETURN cur
    DIM nextHome AS INTEGER = le + 1
    DIM nextEnd AS INTEGER = taLineEnd(text, nextHome)
    DIM nextLen AS INTEGER = nextEnd - nextHome
    DIM ncol2 AS INTEGER = col
    IF ncol2 > nextLen THEN ncol2 = nextLen
    RETURN nextHome + ncol2
END FUNCTION

FUNCTION taRowCol(text AS STRING, cur AS INTEGER) AS (INTEGER, INTEGER)
    DIM row AS INTEGER = 0
    DIM col AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO cur - 1
        IF i < LEN(text) AND Mid(text, i + 1, 1) = "\n" THEN
            row = row + 1
            col = 0
        ELSE
            col = col + 1
        END IF
    NEXT i
    RETURN row, col
END FUNCTION

