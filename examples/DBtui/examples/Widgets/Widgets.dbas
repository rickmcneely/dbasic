            IF key = "home" THEN m.textarea1_Cur = taLineHome(m.textarea1_Val, m.textarea1_Cur)
            IF key = "end" THEN m.textarea1_Cur = taLineEnd(m.textarea1_Val, m.textarea1_Cur)
            IF key = "up" THEN m.textarea1_Cur = taMoveVert(m.textarea1_Val, m.textarea1_Cur, 0 - 1)
            IF key = "down" THEN m.textarea1_Cur = taMoveVert(m.textarea1_Val, m.textarea1_Cur, 1)
