END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM body0 AS STRING
    body0 = "[ Button ]"
    DIM vw0 AS STRING = compFocusView(body0, m.Focus = 0, m.Hover = 0)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw0).X(2).Y(1).Z(10)
    DIM body1 AS STRING
    body1 = "Label"
    DIM vw1 AS STRING = compFocusView(body1, m.Focus = 1, m.Hover = 1)
    DIM ly1 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw1).X(2).Y(2).Z(11)
    DIM vw2 AS STRING = m.textinput1_ti.View()
    DIM ly2 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw2).X(2).Y(3).Z(12)
    DIM body3 AS STRING
    IF m.checkbox1_Val THEN
        body3 = "[x] option"
    ELSE
        body3 = "[ ] option"
    END IF
    DIM vw3 AS STRING = compFocusView(body3, m.Focus = 3, m.Hover = 3)
    DIM ly3 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw3).X(2).Y(4).Z(13)
    DIM body4 AS STRING
    IF m.radiobutton1_Val THEN
        body4 = "(o) option"
    ELSE
        body4 = "( ) option"
    END IF
    DIM vw4 AS STRING = compFocusView(body4, m.Focus = 4, m.Hover = 4)
    DIM ly4 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw4).X(2).Y(5).Z(14)
    DIM vw5 AS STRING = m.combobox1_cb.View()
    DIM ly5 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw5).X(2).Y(6).Z(15)
    DIM vw6 AS STRING = m.listbox1_lb.View()
    DIM ly6 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw6).X(2).Y(7).Z(16)
    DIM vw7 AS STRING = m.progressbar1_pb.ViewAs(0.400)
    DIM ly7 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw7).X(2).Y(18).Z(17)
    DIM svThumb8 AS INTEGER = 1 + ((m.scrollbar1_Val - 0) * (8 - 3)) / 100
    IF svThumb8 < 1 THEN svThumb8 = 1
    IF svThumb8 > 8 - 2 THEN svThumb8 = 8 - 2
    DIM svraw8 AS STRING = ""
    DIM svi8 AS INTEGER
    FOR svi8 = 0 TO 8 - 1
        DIM svGlyph8 AS STRING = "│"
        IF svi8 = 0 THEN svGlyph8 = "▲"
        IF svi8 = 8 - 1 THEN svGlyph8 = "▼"
        IF svi8 = svThumb8 THEN svGlyph8 = "█"
        IF svi8 > 0 THEN svraw8 = svraw8 + "\n"
        svraw8 = svraw8 + svGlyph8
    NEXT svi8
    DIM vw8 AS STRING = compFocusView(svraw8, m.Focus = 8, m.Hover = 8)
    DIM ly8 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw8).X(2).Y(10).Z(18)
    DIM tsItems9 AS []STRING
    tsItems9 = APPEND(tsItems9, "General")
    tsItems9 = APPEND(tsItems9, "Advanced")
    tsItems9 = APPEND(tsItems9, "About")
    DIM tsBar9 AS STRING = ""
    DIM tsk9 AS INTEGER
    FOR tsk9 = 0 TO LEN(tsItems9) - 1
        IF tsk9 > 0 THEN tsBar9 = tsBar9 + "│"
        DIM tsSeg9 AS STRING
        IF tsk9 = m.tabstrip1_Val THEN
            tsSeg9 = "[" + tsItems9[tsk9] + "]"
        ELSE
            tsSeg9 = " " + tsItems9[tsk9] + " "
        END IF
        IF m.Hover = 9 AND m.HoverTab = tsk9 AND m.Focus <> 9 THEN tsSeg9 = hoverStyle.Render(tsSeg9)
        tsBar9 = tsBar9 + tsSeg9
    NEXT tsk9
    DIM tsRule9 AS STRING = strings.Repeat("─", 28)
    DIM tsAct9 AS STRING = ""
    IF m.tabstrip1_Val >= 0 AND m.tabstrip1_Val < LEN(tsItems9) THEN tsAct9 = tsItems9[m.tabstrip1_Val]
    DIM tsContent9 AS STRING = " " + tsAct9 + " tab"
    DIM vwraw9 AS STRING = tsBar9 + "\n" + tsRule9 + "\n" + tsContent9
    DIM vw9 AS STRING = compFocusView(vwraw9, m.Focus = 9, FALSE)
    DIM ly9 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw9).X(30).Y(1).Z(19)
    DIM tnVis10 AS []INTEGER = treeVisibleRows(tree1_depths(), m.tree1_Collapsed)
    DIM tnDep10 AS []INTEGER = tree1_depths()
    DIM tnLab10 AS []STRING = tree1_labels()
    DIM vwraw10 AS STRING = ""
    DIM tnR10 AS INTEGER
    FOR tnR10 = 0 TO 6 - 1
        DIM tnLine10 AS STRING = ""
        IF tnR10 < LEN(tnVis10) THEN
            DIM tnIdx10 AS INTEGER = tnVis10[tnR10]
            DIM tnD10 AS INTEGER = tnDep10[tnIdx10]
            DIM tnG10 AS STRING = "•"
            IF tree1_isParent(tnIdx10) THEN
                tnG10 = "▾"
                IF tnIdx10 < LEN(m.tree1_Collapsed) AND m.tree1_Collapsed[tnIdx10] THEN tnG10 = "▸"
            END IF
            tnLine10 = strings.Repeat("  ", tnD10) + tnG10 + " " + tnLab10[tnIdx10]
            IF tnIdx10 = m.tree1_Val THEN tnLine10 = focusStyle.Render(tnLine10)
        END IF
        IF tnR10 > 0 THEN vwraw10 = vwraw10 + "\n"
        vwraw10 = vwraw10 + tnLine10
    NEXT tnR10
    DIM vw10 AS STRING = vwraw10
    IF m.Hover = 10 AND m.Focus <> 10 THEN vw10 = hoverStyle.Render(vwraw10)
    DIM ly10 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw10).X(30).Y(7).Z(20)
    DIM vw11 AS STRING = m.textarea1_ta.View()
    DIM ly11 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw11).X(56).Y(1).Z(21)
    DIM vw12 AS STRING = m.propgrid1_tbl.View()
    DIM ly12 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw12).X(56).Y(7).Z(22)
    DIM vw13 AS STRING = m.scrollpanel1_vp.View()
    DIM ly13 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw13).X(30).Y(14).Z(23)
    DIM body15 AS STRING
    body15 = "01234567890123456789012345678901234567890123456789012345678901234567890123456789"
    DIM vw15 AS STRING = compFocusView(body15, m.Focus = 15, m.Hover = 15)
    DIM ly15 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw15).X(0).Y(0).Z(25)
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, ly0, ly1, ly2, ly3, ly4, ly5, ly6, ly7, ly8, ly9, ly10, ly11, ly12, ly13, ly15)
    fullView = cmpLy.Render()
    DIM dlgStr AS STRING = ""
    IF dlgStr = "" AND m.dialog1_Active THEN
        DIM btnsdialog1 AS []STRING
        btnsdialog1 = APPEND(btnsdialog1, "OK")
        btnsdialog1 = APPEND(btnsdialog1, "Cancel")
        dlgStr = fdRenderConfirm("Confirm", "Are you sure?", btnsdialog1, m.dialog1_Idx)
    END IF
    IF dlgStr <> "" THEN
        DIM dwW AS INTEGER = lipgloss.Width(dlgStr)
        DIM dwH AS INTEGER = lipgloss.Height(dlgStr)
        DIM dwX AS INTEGER = (w - dwW) / 2
        DIM dwY AS INTEGER = (h - dwH) / 2
        IF dwX < 0 THEN dwX = 0
        IF dwY < 0 THEN dwY = 0
        _dlgX = dwX
        _dlgY = dwY
        _dlgW = dwW
        _dlgH = dwH
        DIM dBg AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
        DIM dLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dlgStr).X(dwX).Y(dwY).Z(100)
        DIM dCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(dBg, dLy)
        fullView = dCmp.Render()
    ELSE
        _dlgW = 0
        _dlgH = 0
    END IF
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    m.textinput1_ti = textinput.New()
    m.textinput1_ti.Prompt = ""
    m.textinput1_ti.SetWidth(15)
    DIM itemscombobox1 AS []list.Item
    DIM itcombobox10 AS _LItem
    itcombobox10.cap = "red"
    itemscombobox1 = APPEND(itemscombobox1, itcombobox10)
    DIM itcombobox11 AS _LItem
    itcombobox11.cap = "green"
    itemscombobox1 = APPEND(itemscombobox1, itcombobox11)
    DIM itcombobox12 AS _LItem
    itcombobox12.cap = "blue"
    itemscombobox1 = APPEND(itemscombobox1, itcombobox12)
    m.combobox1_cb = list.New(itemscombobox1, _newMenuDelegate(), 16, 6)
    m.combobox1_cb.SetShowHelp(FALSE)
    m.combobox1_cb.SetShowStatusBar(FALSE)
    m.combobox1_cb.SetShowTitle(FALSE)
    m.combobox1_cb.SetFilteringEnabled(FALSE)
    DIM itemslistbox1 AS []list.Item
    DIM itlistbox10 AS _LItem
    itlistbox10.cap = "item one"
    itemslistbox1 = APPEND(itemslistbox1, itlistbox10)
    DIM itlistbox11 AS _LItem
    itlistbox11.cap = "item two"
    itemslistbox1 = APPEND(itemslistbox1, itlistbox11)
    DIM itlistbox12 AS _LItem
    itlistbox12.cap = "item three"
    itemslistbox1 = APPEND(itemslistbox1, itlistbox12)
    m.listbox1_lb = list.New(itemslistbox1, _newMenuDelegate(), 18, 5)
    m.listbox1_lb.SetShowHelp(FALSE)
    m.listbox1_lb.SetShowStatusBar(FALSE)
    m.listbox1_lb.SetShowTitle(FALSE)
    m.listbox1_lb.SetFilteringEnabled(FALSE)
    m.progressbar1_pb = progress.New()
    m.progressbar1_pb.SetWidth(20)
    m.scrollbar1_Val = 0
    m.tabstrip1_Val = 0
    m.tree1_Val = 0
    DIM seedCtree1 AS INTEGER
    FOR seedCtree1 = 0 TO 5
        m.tree1_Collapsed = APPEND(m.tree1_Collapsed, FALSE)
    NEXT seedCtree1
    m.textarea1_ta = textarea.New()
    m.textarea1_ta.SetWidth(22)
    m.textarea1_ta.SetHeight(5)
    m.textarea1_ta.SetValue("Edit me...")
    DIM colspropgrid1 AS []table.Column
    DIM ckpropgrid1 AS table.Column
    ckpropgrid1.Title = "Key"
    ckpropgrid1.Width = 11
    DIM cvpropgrid1 AS table.Column
    cvpropgrid1.Title = "Value"
    cvpropgrid1.Width = 11
    colspropgrid1 = APPEND(colspropgrid1, ckpropgrid1)
    colspropgrid1 = APPEND(colspropgrid1, cvpropgrid1)
    DIM rwspropgrid1 AS []table.Row
    DIM rwpropgrid10 AS table.Row
    rwpropgrid10 = APPEND(rwpropgrid10, "Name")
    rwpropgrid10 = APPEND(rwpropgrid10, "Widget1")
    rwspropgrid1 = APPEND(rwspropgrid1, rwpropgrid10)
    DIM rwpropgrid11 AS table.Row
    rwpropgrid11 = APPEND(rwpropgrid11, "Width")
    rwpropgrid11 = APPEND(rwpropgrid11, "100")
    rwspropgrid1 = APPEND(rwspropgrid1, rwpropgrid11)
    DIM rwpropgrid12 AS table.Row
    rwpropgrid12 = APPEND(rwpropgrid12, "Height")
    rwpropgrid12 = APPEND(rwpropgrid12, "40")
    rwspropgrid1 = APPEND(rwspropgrid1, rwpropgrid12)
    DIM rwpropgrid13 AS table.Row
    rwpropgrid13 = APPEND(rwpropgrid13, "Visible")
    rwpropgrid13 = APPEND(rwpropgrid13, "true")
    rwspropgrid1 = APPEND(rwspropgrid1, rwpropgrid13)
    m.propgrid1_tbl = table.New(table.WithColumns(colspropgrid1), table.WithRows(rwspropgrid1), table.WithHeight(5))
    m.scrollpanel1_vp = viewport.New()
    m.scrollpanel1_vp.SetWidth(26)
    m.scrollpanel1_vp.SetHeight(7)
    m.scrollpanel1_vp.SetContent("" + "Content line 1" + "\n" + "Content line 2" + "\n" + "Content line 3" + "\n" + "Content line 4" + "\n" + "Content line 5" + "\n" + "Content line 6" + "\n" + "Content line 7" + "\n" + "Content line 8" + "\n" + "Content line 9" + "\n" + "Content line 10" + "\n" + "Content line 11" + "\n" + "Content line 12")
    syncFocusComp(@m)
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

SUB syncFocusComp(m AS POINTER TO Model)
    m.textinput1_ti.Blur()
    m.textarea1_ta.Blur()
    m.propgrid1_tbl.Blur()
    IF m.Focus = 2 THEN
        DIM fcc2 AS tea.Cmd = m.textinput1_ti.Focus()
        _ = fcc2
    END IF
    IF m.Focus = 11 THEN
        DIM fcc11 AS tea.Cmd = m.textarea1_ta.Focus()
        _ = fcc11
    END IF
    IF m.Focus = 12 THEN
        m.propgrid1_tbl.Focus()
    END IF
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    IF id = "button1" THEN
        Showdialog1()
        button1_Click()
    END IF
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    IF id = "checkbox1" THEN checkbox1_Change()
    IF id = "radiobutton1" THEN radiobutton1_Change()
    IF id = "combobox1" THEN combobox1_Change()
    IF id = "listbox1" THEN listbox1_Change()
    IF id = "scrollbar1" THEN scrollbar1_Change()
    IF id = "tabstrip1" THEN tabstrip1_Change()
    IF id = "tree1" THEN tree1_Change()
    IF id = "propgrid1" THEN propgrid1_Change()
END SUB

FUNCTION treeVisibleRows(depths AS []INTEGER, collapsed AS []BOOLEAN) AS []INTEGER
    DIM out AS []INTEGER
    DIM i AS INTEGER = 0
    DO WHILE i < LEN(depths)
        out = APPEND(out, i)
        IF i < LEN(collapsed) AND collapsed[i] THEN
            DIM d AS INTEGER = depths[i]
            DIM j AS INTEGER = i + 1
            DO WHILE j < LEN(depths) AND depths[j] > d
                j = j + 1
            LOOP
            i = j
        ELSE
            i = i + 1
        END IF
    LOOP
    RETURN out
END FUNCTION

FUNCTION tree1_depths() AS []INTEGER
    DIM d AS []INTEGER
    d = APPEND(d, 0)
    d = APPEND(d, 1)
    d = APPEND(d, 2)
    d = APPEND(d, 2)
    d = APPEND(d, 1)
    d = APPEND(d, 2)
    RETURN d
END FUNCTION

FUNCTION tree1_labels() AS []STRING
    DIM l AS []STRING
    l = APPEND(l, "Project")
    l = APPEND(l, "src")
    l = APPEND(l, "main.dbas")
    l = APPEND(l, "util.dbas")
    l = APPEND(l, "docs")
    l = APPEND(l, "README.md")
    RETURN l
END FUNCTION

FUNCTION tree1_isParent(i AS INTEGER) AS BOOLEAN
    DIM d AS []INTEGER = tree1_depths()
    IF i < 0 OR i + 1 >= LEN(d) THEN RETURN FALSE
    RETURN d[i + 1] > d[i]
END FUNCTION

FUNCTION taLineHome(text AS STRING, cur AS INTEGER) AS INTEGER
    DIM h AS INTEGER = cur
    DO WHILE h > 0 AND Mid(text, h, 1) <> "\n"
        h = h - 1
    LOOP
    RETURN h
END FUNCTION

FUNCTION taLineEnd(text AS STRING, cur AS INTEGER) AS INTEGER
    DIM e AS INTEGER = cur
    DO WHILE e < LEN(text) AND Mid(text, e + 1, 1) <> "\n"
        e = e + 1
    LOOP
    RETURN e
END FUNCTION

FUNCTION taMoveVert(text AS STRING, cur AS INTEGER, dir AS INTEGER) AS INTEGER
    DIM home AS INTEGER = taLineHome(text, cur)
    DIM col AS INTEGER = cur - home
    IF dir < 0 THEN
        IF home = 0 THEN RETURN cur
        DIM prevHome AS INTEGER = taLineHome(text, home - 1)
        DIM prevLen AS INTEGER = (home - 1) - prevHome
        DIM ncol AS INTEGER = col
        IF ncol > prevLen THEN ncol = prevLen
        RETURN prevHome + ncol
    END IF
    DIM le AS INTEGER = taLineEnd(text, cur)
    IF le >= LEN(text) THEN RETURN cur
    DIM nextHome AS INTEGER = le + 1
    DIM nextEnd AS INTEGER = taLineEnd(text, nextHome)
    DIM nextLen AS INTEGER = nextEnd - nextHome
    DIM ncol2 AS INTEGER = col
    IF ncol2 > nextLen THEN ncol2 = nextLen
    RETURN nextHome + ncol2
END FUNCTION

FUNCTION taRowCol(text AS STRING, cur AS INTEGER) AS (INTEGER, INTEGER)
    DIM row AS INTEGER = 0
    DIM col AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO cur - 1
        IF i < LEN(text) AND Mid(text, i + 1, 1) = "\n" THEN
            row = row + 1
            col = 0
        ELSE
            col = col + 1
        END IF
    NEXT i
    RETURN row, col
END FUNCTION

' Showdialog1 — pop the dialog1 dialog.
' Call from inside a _Click / _Change handler. On commit/
' cancel dialog1_Close(button STRING) fires (defined
' below the marker — user fills in the body).
SUB Showdialog1()
    IF _currentModel = NIL THEN RETURN
    _currentModel.dialog1_Active = TRUE
    _currentModel.dialog1_Idx    = 0
END SUB

FUNCTION fdRenderConfirm(title AS STRING, msg AS STRING, buttons AS []STRING, activeIdx AS INTEGER) AS STRING
    DIM innerW AS INTEGER = 48
    DIM cBg     AS STRING = "#1a1b2e"
    DIM cFg     AS STRING = "#e0def4"
    DIM cAccent AS STRING = "#7dcfff"
    DIM cBorder AS STRING = "#3b3d5e"
    DIM cHl     AS STRING = "#2d4f67"
    DIM cClose  AS STRING = "#f9e2af"
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)
    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)
    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))
    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)
    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))
    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)
    DIM body AS STRING = bodyStyle.Render(msg)
    DIM totalW AS INTEGER = 0
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(buttons) - 1
        totalW = totalW + lipgloss.Width("[ " + buttons[bi] + " ]")
        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT bi
    DIM padBtn AS INTEGER = innerW - totalW
    IF padBtn < 0 THEN padBtn = 0
    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" ", padBtn))
    FOR bi = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[bi] + " ]"
        IF bi = activeIdx THEN
            btnRow = btnRow + btnActive.Render(lbl)
        ELSE
            btnRow = btnRow + btnStyle.Render(lbl)
        END IF
        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render("  ")
    NEXT bi
    DIM spacer AS STRING = bodyStyle.Render(" ")
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, body, spacer, btnRow)
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    DIM bodyStr AS STRING = frame.Render(stacked)
    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)
    DIM titleTxt AS STRING = " " + title + " "
    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)
    DIM dashLen AS INTEGER = totalDW - titleLen - 6
    IF dashLen < 0 THEN dashLen = 0
    DIM topBorder AS STRING = borderStyle.Render("╭─") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat("─", dashLen) + " ") + closeStyle.Render("✕") + borderStyle.Render(" ╮")
    RETURN topBorder + "\n" + bodyStr
END FUNCTION

FUNCTION fdRenderInput(title AS STRING, prompt AS STRING, txt AS STRING, onField AS BOOLEAN, activeIdx AS INTEGER) AS STRING
    DIM innerW AS INTEGER = 48
    DIM cBg     AS STRING = "#1a1b2e"
    DIM cFg     AS STRING = "#e0def4"
    DIM cAccent AS STRING = "#7dcfff"
    DIM cBorder AS STRING = "#3b3d5e"
    DIM cHl     AS STRING = "#2d4f67"
    DIM cClose  AS STRING = "#f9e2af"
    DIM cField  AS STRING = "#11121f"
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)
    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)
    DIM fieldStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cField)).Width(innerW)
    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))
    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)
    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))
    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)
    DIM promptRow AS STRING = bodyStyle.Render(prompt)
    DIM fieldTxt AS STRING = " " + txt
    IF onField THEN fieldTxt = fieldTxt + "█"
    DIM fieldRow AS STRING = fieldStyle.Render(fieldTxt)
    DIM buttons AS []STRING
    buttons = APPEND(buttons, "OK")
    buttons = APPEND(buttons, "Cancel")
    DIM totalW AS INTEGER = 0
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(buttons) - 1
        totalW = totalW + lipgloss.Width("[ " + buttons[bi] + " ]")
        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT bi
    DIM padBtn AS INTEGER = innerW - totalW
    IF padBtn < 0 THEN padBtn = 0
    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" ", padBtn))
    FOR bi = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[bi] + " ]"
        IF bi = activeIdx THEN
            btnRow = btnRow + btnActive.Render(lbl)
        ELSE
            btnRow = btnRow + btnStyle.Render(lbl)
        END IF
        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render("  ")
    NEXT bi
    DIM spacer AS STRING = bodyStyle.Render(" ")
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, promptRow, spacer, fieldRow, spacer, btnRow)
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    DIM bodyStr AS STRING = frame.Render(stacked)
    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)
    DIM titleTxt AS STRING = " " + title + " "
    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)
    DIM dashLen AS INTEGER = totalDW - titleLen - 6
    IF dashLen < 0 THEN dashLen = 0
    DIM topBorder AS STRING = borderStyle.Render("╭─") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat("─", dashLen) + " ") + closeStyle.Render("✕") + borderStyle.Render(" ╮")
    RETURN topBorder + "\n" + bodyStr
END FUNCTION

