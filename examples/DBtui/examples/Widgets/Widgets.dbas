                    m.scrollbar1_Val = m.scrollbar1_Val + 1
                    dispatchChange("scrollbar1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 9 THEN
            IF key = "left" THEN
                IF m.tabstrip1_Val > 0 THEN
                    m.tabstrip1_Val = m.tabstrip1_Val - 1
                    dispatchChange("tabstrip1")
                END IF
            END IF
            IF key = "right" THEN
                IF m.tabstrip1_Val < 3 - 1 THEN
                    m.tabstrip1_Val = m.tabstrip1_Val + 1
                    dispatchChange("tabstrip1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 10 THEN
            DIM tkVistree1 AS []INTEGER = treeVisibleRows(tree1_depths(), m.tree1_Collapsed)
            DIM tkPostree1 AS INTEGER = 0
            DIM tkItree1 AS INTEGER
            FOR tkItree1 = 0 TO LEN(tkVistree1) - 1
                IF tkVistree1[tkItree1] = m.tree1_Val THEN tkPostree1 = tkItree1
            NEXT tkItree1
            IF key = "up" THEN
                IF tkPostree1 > 0 THEN
                    m.tree1_Val = tkVistree1[tkPostree1 - 1]
                    dispatchChange("tree1")
                END IF
            END IF
            IF key = "down" THEN
                IF tkPostree1 < LEN(tkVistree1) - 1 THEN
                    m.tree1_Val = tkVistree1[tkPostree1 + 1]
                    dispatchChange("tree1")
                END IF
            END IF
            IF key = "enter" OR key = "space" THEN
                IF tree1_isParent(m.tree1_Val) THEN
                    IF m.tree1_Val < LEN(m.tree1_Collapsed) THEN m.tree1_Collapsed[m.tree1_Val] = NOT m.tree1_Collapsed[m.tree1_Val]
                ELSE
                    dispatchChange("tree1")
                END IF
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 11 THEN
            IF LEN(key) = 1 THEN
                m.textarea1_Val = Mid(m.textarea1_Val, 1, m.textarea1_Cur) + key + Mid(m.textarea1_Val, m.textarea1_Cur + 1, LEN(m.textarea1_Val) - m.textarea1_Cur)
                m.textarea1_Cur = m.textarea1_Cur + 1
            END IF
            IF key = "space" THEN
                m.textarea1_Val = Mid(m.textarea1_Val, 1, m.textarea1_Cur) + " " + Mid(m.textarea1_Val, m.textarea1_Cur + 1, LEN(m.textarea1_Val) - m.textarea1_Cur)
                m.textarea1_Cur = m.textarea1_Cur + 1
            END IF
            IF key = "enter" THEN
                m.textarea1_Val = Mid(m.textarea1_Val, 1, m.textarea1_Cur) + "\n" + Mid(m.textarea1_Val, m.textarea1_Cur + 1, LEN(m.textarea1_Val) - m.textarea1_Cur)
                m.textarea1_Cur = m.textarea1_Cur + 1
            END IF
            IF key = "backspace" AND m.textarea1_Cur > 0 THEN
                m.textarea1_Val = Mid(m.textarea1_Val, 1, m.textarea1_Cur - 1) + Mid(m.textarea1_Val, m.textarea1_Cur + 1, LEN(m.textarea1_Val) - m.textarea1_Cur)
                m.textarea1_Cur = m.textarea1_Cur - 1
            END IF
