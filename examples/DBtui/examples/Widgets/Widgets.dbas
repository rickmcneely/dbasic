            IF mcRelY8 = 0 THEN
                IF m.scrollbar1_Val > 0 THEN m.scrollbar1_Val = m.scrollbar1_Val - 1
                dispatchChange("scrollbar1")
            ELSEIF mcRelY8 = 8 - 1 THEN
                IF m.scrollbar1_Val < 100 THEN m.scrollbar1_Val = m.scrollbar1_Val + 1
                dispatchChange("scrollbar1")
            END IF
            RETURN m, NIL
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 20 AND mc.Y >= 17 AND mc.Y < 17 + 1 THEN
            m.Focus = 7
