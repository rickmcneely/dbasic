IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM menubar1_Active AS INTEGER
    DIM menubar1_Open   AS BOOLEAN
    DIM menubar1_Path   AS []INTEGER
    DIM panel1_Scroll AS INTEGER
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentModel AS POINTER TO Model
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    _currentModel = @m
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        Form_Resize(m.Width, m.Height)
        RETURN m, NIL
    END IF
    DIM kpd AS tea.KeyPressMsg
    DIM kpdOk AS BOOLEAN
    kpd, kpdOk = msg.(tea.KeyPressMsg)
    IF kpdOk THEN
        DIM kpdK AS STRING = kpd.String()
        IF m.menubar1_Open THEN
            DIM mnAmenubar1 AS INTEGER
            DIM mnOmenubar1 AS BOOLEAN
            DIM mnPmenubar1 AS []INTEGER
            DIM mnCmenubar1 AS STRING
            mnAmenubar1, mnOmenubar1, mnPmenubar1, mnCmenubar1 = _mnKey(_mnNodes_menubar1(), kpdK, m.menubar1_Active, m.menubar1_Open, m.menubar1_Path)
            m.menubar1_Active = mnAmenubar1
            m.menubar1_Open = mnOmenubar1
            m.menubar1_Path = mnPmenubar1
            IF mnCmenubar1 <> "" THEN
                IF mnCmenubar1 = "mnuNew" THEN mnuNew_Click()
                IF mnCmenubar1 = "mnuOpen" THEN mnuOpen_Click()
                IF mnCmenubar1 = "mnuQuit" THEN mnuQuit_Click()
                IF mnCmenubar1 = "mnuCut" THEN mnuCut_Click()
                IF mnCmenubar1 = "mnuCopy" THEN mnuCopy_Click()
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF m.menubar1_Open THEN
            DIM mcAmenubar1 AS INTEGER
            DIM mcOmenubar1 AS BOOLEAN
            DIM mcPmenubar1 AS []INTEGER
            DIM mcCmenubar1 AS STRING
            DIM mcHmenubar1 AS BOOLEAN
            mcAmenubar1, mcOmenubar1, mcPmenubar1, mcCmenubar1, mcHmenubar1 = _mnClickHit(_mnNodes_menubar1(), mc.X, mc.Y, m.menubar1_Active, m.menubar1_Open, m.menubar1_Path)
            IF mcHmenubar1 THEN
                m.menubar1_Active = mcAmenubar1
                m.menubar1_Open = mcOmenubar1
                m.menubar1_Path = mcPmenubar1
                IF mcCmenubar1 <> "" THEN
                    IF mcCmenubar1 = "mnuNew" THEN mnuNew_Click()
                    IF mcCmenubar1 = "mnuOpen" THEN mnuOpen_Click()
                    IF mcCmenubar1 = "mnuQuit" THEN mnuQuit_Click()
                    IF mcCmenubar1 = "mnuCut" THEN mnuCut_Click()
                    IF mcCmenubar1 = "mnuCopy" THEN mnuCopy_Click()
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 30 AND mc.Y >= 2 AND mc.Y < 2 + 8 THEN
            m.Focus = 1
            DIM pnRel1 AS INTEGER = mc.Y - 2
            IF pnRel1 = 1 AND m.panel1_Scroll > 0 THEN m.panel1_Scroll = m.panel1_Scroll - 1
            IF pnRel1 = 6 AND m.panel1_Scroll < 0 THEN m.panel1_Scroll = m.panel1_Scroll + 1
            RETURN m, NIL
        END IF
        IF mc.X >= 0 AND mc.X < 0 + 44 AND mc.Y >= 0 AND mc.Y < 0 + 1 THEN
            m.Focus = 0
            DIM mbTX0 AS INTEGER = mc.X - 0
            IF mbTX0 >= 0 AND mbTX0 < 6 THEN
                IF m.menubar1_Open AND m.menubar1_Active = 0 THEN
                    m.menubar1_Open = FALSE
                ELSE
                    m.menubar1_Active = 0
                    m.menubar1_Open = TRUE
                    m.menubar1_Path = _mnOpenPath(_mnNodes_menubar1(), 0)
                END IF
            END IF
            IF mbTX0 >= 6 AND mbTX0 < 12 THEN
                IF m.menubar1_Open AND m.menubar1_Active = 1 THEN
                    m.menubar1_Open = FALSE
                ELSE
                    m.menubar1_Active = 1
                    m.menubar1_Open = TRUE
                    m.menubar1_Path = _mnOpenPath(_mnNodes_menubar1(), 1)
                END IF
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 2 AND mm.X < 2 + 30 AND mm.Y >= 2 AND mm.Y < 2 + 8 THEN mmHit = 1
        IF mmHit < 0 AND mm.X >= 0 AND mm.X < 0 + 44 AND mm.Y >= 0 AND mm.Y < 0 + 1 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        IF mmHit = 0 THEN
            DIM mhCol0 AS INTEGER = mm.X - 0
            IF mhCol0 >= 0 AND mhCol0 < 6 THEN m.HoverTab = 0
            IF mhCol0 >= 6 AND mhCol0 < 12 THEN m.HoverTab = 1
        END IF
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        IF key = "ctrl+c" OR key = "esc" THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 3
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 2
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            IF key = "left" AND m.menubar1_Active > 0 THEN m.menubar1_Active = m.menubar1_Active - 1
            IF key = "right" AND m.menubar1_Active < 1 THEN m.menubar1_Active = m.menubar1_Active + 1
            IF key = "down" OR key = "enter" OR key = "space" THEN
                m.menubar1_Open = TRUE
                m.menubar1_Path = _mnOpenPath(_mnNodes_menubar1(), m.menubar1_Active)
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            IF key = "up" AND m.panel1_Scroll > 0 THEN m.panel1_Scroll = m.panel1_Scroll - 1
            IF key = "down" AND m.panel1_Scroll < 0 THEN m.panel1_Scroll = m.panel1_Scroll + 1
            IF key = "pgup" THEN
                m.panel1_Scroll = m.panel1_Scroll - 6
                IF m.panel1_Scroll < 0 THEN m.panel1_Scroll = 0
            END IF
            IF key = "pgdown" THEN
                m.panel1_Scroll = m.panel1_Scroll + 6
                IF m.panel1_Scroll > 0 THEN m.panel1_Scroll = 0
            END IF
            IF key = "home" THEN m.panel1_Scroll = 0
            IF key = "end" THEN m.panel1_Scroll = 0
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM vw0 AS STRING = _mnBarView(_mnNodes_menubar1(), m.menubar1_Active, m.menubar1_Open, m.Focus = 0, m.Hover = 0, m.HoverTab)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw0).X(0).Y(0).Z(10)
    DIM pnInner1 AS STRING = _blankCanvas(28, 6)
    DIM pnBaseL1 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(pnInner1)
    DIM pnCv1c2 AS STRING = "" + "child-in-panel"
    DIM pnCL1c2 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(pnCv1c2).X(1).Y(0 - m.panel1_Scroll).Z(1)
    DIM pnComp1 AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(pnBaseL1, pnCL1c2)
    DIM pnIn21 AS STRING = pnComp1.Render()
    DIM pnBox1 AS STRING = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).Render(pnIn21)
    DIM vw1 AS STRING = compFocusView(pnBox1, FALSE, m.Hover = 1 AND m.Focus <> 1)
    DIM ly1 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw1).X(2).Y(2).Z(11)
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, ly0, ly1)
    fullView = cmpLy.Render()
    IF m.menubar1_Open THEN fullView = _mnComposeBoxes(fullView, _mnNodes_menubar1(), 0, 0, m.menubar1_Active, m.menubar1_Path)
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

TYPE _MNode
    DIM Cap AS STRING
    DIM Nm  AS STRING
    DIM Dp  AS INTEGER
    DIM Sc  AS STRING
    DIM Ck  AS BOOLEAN
    DIM Ds  AS BOOLEAN
    DIM Sp  AS BOOLEAN
END TYPE

FUNCTION _mkMN(cap AS STRING, nm AS STRING, dp AS INTEGER, sc AS STRING, ck AS BOOLEAN, ds AS BOOLEAN, sp AS BOOLEAN) AS _MNode
    DIM n AS _MNode
    n.Cap = cap
    n.Nm = nm
    n.Dp = dp
    n.Sc = sc
    n.Ck = ck
    n.Ds = ds
    n.Sp = sp
    RETURN n
END FUNCTION

DIM _mnBX AS []INTEGER
DIM _mnBY AS []INTEGER
DIM _mnBW AS []INTEGER
DIM _mnBP AS []INTEGER
DIM _mnDim AS lipgloss.Style = lipgloss.NewStyle().Faint(TRUE)

FUNCTION _mnKids(nodes AS []_MNode, parentIdx AS INTEGER) AS []INTEGER
    DIM out AS []INTEGER
    IF parentIdx < 0 THEN
        DIM t AS INTEGER
        FOR t = 0 TO LEN(nodes) - 1
            IF nodes[t].Dp = 0 THEN out = APPEND(out, t)
        NEXT t
        RETURN out
    END IF
    IF parentIdx >= LEN(nodes) THEN RETURN out
    DIM pd AS INTEGER = nodes[parentIdx].Dp
    DIM i AS INTEGER
    FOR i = parentIdx + 1 TO LEN(nodes) - 1
        IF nodes[i].Dp <= pd THEN RETURN out
        IF nodes[i].Dp = pd + 1 THEN out = APPEND(out, i)
    NEXT i
    RETURN out
END FUNCTION

FUNCTION _mnIsSub(nodes AS []_MNode, idx AS INTEGER) AS BOOLEAN
    IF idx < 0 OR idx + 1 >= LEN(nodes) THEN RETURN FALSE
    RETURN nodes[idx + 1].Dp > nodes[idx].Dp
END FUNCTION

FUNCTION _mnTopCount(nodes AS []_MNode) AS INTEGER
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 THEN c = c + 1
    NEXT i
    RETURN c
END FUNCTION

FUNCTION _mnColAt(nodes AS []_MNode, k AS INTEGER) AS INTEGER
    DIM col AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN
            IF c = k THEN RETURN col
            col = col + lipgloss.Width(nodes[i].Cap) + 2
            c = c + 1
        END IF
    NEXT i
    RETURN col
END FUNCTION

FUNCTION _mnNodeAt(nodes AS []_MNode, active AS INTEGER, path AS []INTEGER, depth AS INTEGER) AS INTEGER
    DIM tops AS []INTEGER = _mnKids(nodes, 0 - 1)
    IF active < 0 OR active >= LEN(tops) THEN RETURN 0 - 1
    DIM cur AS INTEGER = tops[active]
    DIM l AS INTEGER
    FOR l = 0 TO depth - 1
        DIM kids AS []INTEGER = _mnKids(nodes, cur)
        IF l >= LEN(path) OR path[l] < 0 OR path[l] >= LEN(kids) THEN RETURN cur
        cur = kids[path[l]]
    NEXT l
    RETURN cur
END FUNCTION

FUNCTION _mnFirst(nodes AS []_MNode, kids AS []INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(kids) - 1
        IF NOT nodes[kids[i]].Sp THEN RETURN i
    NEXT i
    RETURN 0
END FUNCTION

FUNCTION _mnStep(nodes AS []_MNode, kids AS []INTEGER, cur AS INTEGER, dir AS INTEGER) AS INTEGER
    DIM i AS INTEGER = cur + dir
    DO WHILE i >= 0 AND i < LEN(kids)
        IF NOT nodes[kids[i]].Sp THEN RETURN i
        i = i + dir
    LOOP
    RETURN cur
END FUNCTION

FUNCTION _mnOpenPath(nodes AS []_MNode, active AS INTEGER) AS []INTEGER
    DIM p AS []INTEGER
    DIM top AS INTEGER = _mnNodeAt(nodes, active, p, 0)
    p = APPEND(p, _mnFirst(nodes, _mnKids(nodes, top)))
    RETURN p
END FUNCTION

FUNCTION _mnKey(nodes AS []_MNode, key AS STRING, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING)
    DIM chosen AS STRING = ""
    IF NOT open THEN RETURN active, open, path, chosen
    DIM topc AS INTEGER = _mnTopCount(nodes)
    DIM L AS INTEGER = LEN(path)
    IF L = 0 THEN
        path = APPEND(path, 0)
        L = 1
    END IF
    DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, L - 1)
    DIM kids AS []INTEGER = _mnKids(nodes, parent)
    IF LEN(kids) = 0 THEN RETURN active, open, path, chosen
    DIM cur AS INTEGER = path[L - 1]
    IF cur < 0 THEN cur = 0
    IF cur >= LEN(kids) THEN cur = LEN(kids) - 1
    IF key = "esc" THEN RETURN active, FALSE, NIL, chosen
    IF key = "down" THEN
        path[L - 1] = _mnStep(nodes, kids, cur, 1)
        RETURN active, open, path, chosen
    END IF
    IF key = "up" THEN
        path[L - 1] = _mnStep(nodes, kids, cur, 0 - 1)
        RETURN active, open, path, chosen
    END IF
    IF key = "left" THEN
        IF L > 1 THEN
            DIM np AS []INTEGER
            DIM a AS INTEGER
            FOR a = 0 TO L - 2
                np = APPEND(np, path[a])
            NEXT a
            RETURN active, open, np, chosen
        END IF
        IF active > 0 THEN active = active - 1
        RETURN active, open, _mnOpenPath(nodes, active), chosen
    END IF
    IF key = "right" THEN
        DIM rnode AS INTEGER = kids[cur]
        IF _mnIsSub(nodes, rnode) THEN
            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, rnode)))
            RETURN active, open, path, chosen
        END IF
        IF L = 1 AND active < topc - 1 THEN
            active = active + 1
            RETURN active, open, _mnOpenPath(nodes, active), chosen
        END IF
        RETURN active, open, path, chosen
    END IF
    IF key = "enter" OR key = "space" THEN
        DIM enode AS INTEGER = kids[cur]
        IF nodes[enode].Ds THEN RETURN active, open, path, chosen
        IF _mnIsSub(nodes, enode) THEN
            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, enode)))
            RETURN active, open, path, chosen
        END IF
        RETURN active, FALSE, NIL, nodes[enode].Nm
    END IF
    RETURN active, open, path, chosen
END FUNCTION

FUNCTION _mnBarView(nodes AS []_MNode, active AS INTEGER, open AS BOOLEAN, focused AS BOOLEAN, hovActive AS BOOLEAN, hoverIdx AS INTEGER) AS STRING
    DIM bar AS STRING = ""
    DIM k AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN
            IF (focused OR open) AND active = k THEN
                bar = bar + "[" + nodes[i].Cap + "]"
            ELSEIF hovActive AND hoverIdx = k THEN
                bar = bar + hoverStyle.Render(" " + nodes[i].Cap + " ")
            ELSE
                bar = bar + " " + nodes[i].Cap + " "
            END IF
            k = k + 1
        END IF
    NEXT i
    RETURN bar
END FUNCTION

FUNCTION _mnComposeBoxes(full AS STRING, nodes AS []_MNode, baseX AS INTEGER, baseY AS INTEGER, active AS INTEGER, path AS []INTEGER) AS STRING
    _mnBX = NIL
    _mnBY = NIL
    _mnBW = NIL
    _mnBP = NIL
    IF LEN(path) = 0 THEN RETURN full
    DIM prevX AS INTEGER = 0
    DIM prevW AS INTEGER = 0
    DIM prevTopY AS INTEGER = 0
    DIM lev AS INTEGER
    FOR lev = 0 TO LEN(path) - 1
        DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, lev)
        DIM kids AS []INTEGER = _mnKids(nodes, parent)
        IF LEN(kids) = 0 THEN RETURN full
        DIM boxX AS INTEGER = 0
        DIM topY AS INTEGER = 0
        IF lev = 0 THEN
            boxX = baseX + _mnColAt(nodes, active)
            topY = baseY + 1
        ELSE
            boxX = prevX + prevW
            topY = prevTopY + path[lev - 1]
        END IF
        DIM innerW AS INTEGER = 1
        DIM j AS INTEGER
        FOR j = 0 TO LEN(kids) - 1
            DIM cw AS INTEGER = 4 + lipgloss.Width(nodes[kids[j]].Cap)
            IF nodes[kids[j]].Sc <> "" THEN cw = cw + 2 + lipgloss.Width(nodes[kids[j]].Sc)
            IF _mnIsSub(nodes, kids[j]) THEN cw = cw + 2
            IF cw > innerW THEN innerW = cw
        NEXT j
        DIM box AS STRING = "┌" + strings.Repeat("─", innerW) + "┐"
        DIM sel AS INTEGER = path[lev]
        FOR j = 0 TO LEN(kids) - 1
            DIM ndx AS INTEGER = kids[j]
            IF nodes[ndx].Sp THEN
                box = box + "\n" + "├" + strings.Repeat("─", innerW) + "┤"
            ELSE
                DIM chk AS STRING = "  "
                IF nodes[ndx].Ck THEN chk = "✓ "
                DIM rgt AS STRING = nodes[ndx].Sc
                IF _mnIsSub(nodes, ndx) THEN
                    IF rgt <> "" THEN
                        rgt = rgt + " ▸"
                    ELSE
                        rgt = "▸"
                    END IF
                END IF
                DIM inner AS STRING = " " + chk + nodes[ndx].Cap
                DIM pad AS INTEGER = innerW - lipgloss.Width(inner) - lipgloss.Width(rgt) - 1
                IF pad < 0 THEN pad = 0
                inner = inner + strings.Repeat(" ", pad) + rgt + " "
                DO WHILE lipgloss.Width(inner) > innerW
                    inner = Mid(inner, 1, LEN(inner) - 1)
                LOOP
                DO WHILE lipgloss.Width(inner) < innerW
                    inner = inner + " "
                LOOP
                DIM cell AS STRING = inner
                IF j = sel THEN
                    cell = focusStyle.Render(inner)
                ELSEIF nodes[ndx].Ds THEN
                    cell = _mnDim.Render(inner)
                END IF
                box = box + "\n" + "│" + cell + "│"
            END IF
        NEXT j
        box = box + "\n" + "└" + strings.Repeat("─", innerW) + "┘"
        DIM bBg AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(full)
        DIM bLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(box).X(boxX).Y(topY).Z(50 + lev)
        DIM bCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bBg, bLy)
        full = bCmp.Render()
        _mnBX = APPEND(_mnBX, boxX)
        _mnBY = APPEND(_mnBY, topY + 1)
        _mnBW = APPEND(_mnBW, innerW + 2)
        _mnBP = APPEND(_mnBP, parent)
        prevX = boxX
        prevW = innerW + 2
        prevTopY = topY
    NEXT lev
    RETURN full
END FUNCTION

FUNCTION _mnClickHit(nodes AS []_MNode, mx AS INTEGER, my AS INTEGER, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING, BOOLEAN)
    DIM chosen AS STRING = ""
    IF NOT open THEN RETURN active, open, path, chosen, FALSE
    DIM b AS INTEGER
    FOR b = LEN(_mnBX) - 1 TO 0 STEP 0 - 1
        DIM parent AS INTEGER = _mnBP[b]
        DIM kids AS []INTEGER = _mnKids(nodes, parent)
        IF mx >= _mnBX[b] AND mx < _mnBX[b] + _mnBW[b] AND my >= _mnBY[b] AND my < _mnBY[b] + LEN(kids) THEN
            DIM row AS INTEGER = my - _mnBY[b]
            DIM ndx AS INTEGER = kids[row]
            DIM np AS []INTEGER
            DIM a AS INTEGER
            FOR a = 0 TO b - 1
                np = APPEND(np, path[a])
            NEXT a
            np = APPEND(np, row)
            IF nodes[ndx].Sp THEN RETURN active, open, path, chosen, TRUE
            IF nodes[ndx].Ds THEN RETURN active, open, np, chosen, TRUE
            IF _mnIsSub(nodes, ndx) THEN
                np = APPEND(np, _mnFirst(nodes, _mnKids(nodes, ndx)))
                RETURN active, open, np, chosen, TRUE
            END IF
            RETURN active, FALSE, NIL, nodes[ndx].Nm, TRUE
        END IF
    NEXT b
    RETURN active, open, path, chosen, FALSE
END FUNCTION

FUNCTION _mnNodes_menubar1() AS []_MNode
    DIM ns AS []_MNode
    ns = APPEND(ns, _mkMN("File", "mnuFile", 0, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("New", "mnuNew", 1, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Open", "mnuOpen", 1, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Quit", "mnuQuit", 1, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Edit", "mnuEdit", 0, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Cut", "mnuCut", 1, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Copy", "mnuCopy", 1, "", FALSE, FALSE, FALSE))
    RETURN ns
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

