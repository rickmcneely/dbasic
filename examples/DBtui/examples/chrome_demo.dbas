' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM menubar1_Active AS INTEGER
    DIM menubar1_Open   AS BOOLEAN
    DIM menubar1_Item   AS INTEGER
    DIM panel1_Scroll AS INTEGER
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentModel AS POINTER TO Model
DIM _mbX AS INTEGER
DIM _mbItemY AS INTEGER
DIM _mbW AS INTEGER
DIM _mbN AS INTEGER

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    _currentModel = @m
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        RETURN m, NIL
    END IF
    DIM kpd AS tea.KeyPressMsg
    DIM kpdOk AS BOOLEAN
    kpd, kpdOk = msg.(tea.KeyPressMsg)
    IF kpdOk THEN
        DIM kpdK AS STRING = kpd.String()
        IF m.menubar1_Open THEN
            IF kpdK = "esc" THEN
                m.menubar1_Open = FALSE
                RETURN m, NIL
            END IF
            IF kpdK = "up" THEN
                IF m.menubar1_Item > 0 THEN m.menubar1_Item = m.menubar1_Item - 1
                RETURN m, NIL
            END IF
            IF kpdK = "down" THEN
                DIM mbMxmenubar1 AS INTEGER = 0
                IF m.menubar1_Active = 0 THEN mbMxmenubar1 = 2
                IF m.menubar1_Active = 1 THEN mbMxmenubar1 = 1
                IF m.menubar1_Item < mbMxmenubar1 THEN m.menubar1_Item = m.menubar1_Item + 1
                RETURN m, NIL
            END IF
            IF kpdK = "left" THEN
                IF m.menubar1_Active > 0 THEN
                    m.menubar1_Active = m.menubar1_Active - 1
                    m.menubar1_Item = 0
                END IF
                RETURN m, NIL
            END IF
            IF kpdK = "right" THEN
                IF m.menubar1_Active < 1 THEN
                    m.menubar1_Active = m.menubar1_Active + 1
                    m.menubar1_Item = 0
                END IF
                RETURN m, NIL
            END IF
            IF kpdK = "enter" OR kpdK = "space" THEN
                DIM mbPickmenubar1 AS STRING = ""
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 0 THEN mbPickmenubar1 = "New"
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 1 THEN mbPickmenubar1 = "Open"
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 2 THEN mbPickmenubar1 = "Quit"
                IF m.menubar1_Active = 1 AND m.menubar1_Item = 0 THEN mbPickmenubar1 = "Cut"
                IF m.menubar1_Active = 1 AND m.menubar1_Item = 1 THEN mbPickmenubar1 = "Copy"
                m.menubar1_Open = FALSE
                menubar1_Select(mbPickmenubar1)
                RETURN m, NIL
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF m.menubar1_Open AND _mbN > 0 THEN
            DIM mbCYmenubar1 AS INTEGER = mc.Y - _mbItemY
            IF mc.X >= _mbX AND mc.X < _mbX + _mbW AND mbCYmenubar1 >= 0 AND mbCYmenubar1 < _mbN THEN
                m.menubar1_Item = mbCYmenubar1
                DIM mbCPickmenubar1 AS STRING = ""
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 0 THEN mbCPickmenubar1 = "New"
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 1 THEN mbCPickmenubar1 = "Open"
                IF m.menubar1_Active = 0 AND m.menubar1_Item = 2 THEN mbCPickmenubar1 = "Quit"
                IF m.menubar1_Active = 1 AND m.menubar1_Item = 0 THEN mbCPickmenubar1 = "Cut"
                IF m.menubar1_Active = 1 AND m.menubar1_Item = 1 THEN mbCPickmenubar1 = "Copy"
                m.menubar1_Open = FALSE
                menubar1_Select(mbCPickmenubar1)
                RETURN m, NIL
            END IF
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 30 AND mc.Y >= 2 AND mc.Y < 2 + 8 THEN
            m.Focus = 1
            DIM pnRel1 AS INTEGER = mc.Y - 2
            IF pnRel1 = 1 AND m.panel1_Scroll > 0 THEN m.panel1_Scroll = m.panel1_Scroll - 1
            IF pnRel1 = 6 AND m.panel1_Scroll < 0 THEN m.panel1_Scroll = m.panel1_Scroll + 1
            RETURN m, NIL
        END IF
        IF mc.X >= 0 AND mc.X < 0 + 44 AND mc.Y >= 0 AND mc.Y < 0 + 1 THEN
            m.Focus = 0
            DIM mbTX0 AS INTEGER = mc.X - 0
            IF mbTX0 >= 0 AND mbTX0 < 6 THEN
                IF m.menubar1_Open AND m.menubar1_Active = 0 THEN
                    m.menubar1_Open = FALSE
                ELSE
                    m.menubar1_Active = 0
                    m.menubar1_Open = TRUE
                    m.menubar1_Item = 0
                END IF
            END IF
            IF mbTX0 >= 6 AND mbTX0 < 12 THEN
                IF m.menubar1_Open AND m.menubar1_Active = 1 THEN
                    m.menubar1_Open = FALSE
                ELSE
                    m.menubar1_Active = 1
                    m.menubar1_Open = TRUE
                    m.menubar1_Item = 0
                END IF
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 2 AND mm.X < 2 + 30 AND mm.Y >= 2 AND mm.Y < 2 + 8 THEN mmHit = 1
        IF mmHit < 0 AND mm.X >= 0 AND mm.X < 0 + 44 AND mm.Y >= 0 AND mm.Y < 0 + 1 THEN mmHit = 0
        _ = mm
        m.Focus = mmHit
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        IF key = "ctrl+c" OR key = "esc" THEN RETURN m, tea.Quit
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 3
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 2
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            IF key = "left" AND m.menubar1_Active > 0 THEN m.menubar1_Active = m.menubar1_Active - 1
            IF key = "right" AND m.menubar1_Active < 1 THEN m.menubar1_Active = m.menubar1_Active + 1
            IF key = "down" OR key = "enter" OR key = "space" THEN
                m.menubar1_Open = TRUE
                m.menubar1_Item = 0
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            IF key = "up" AND m.panel1_Scroll > 0 THEN m.panel1_Scroll = m.panel1_Scroll - 1
            IF key = "down" AND m.panel1_Scroll < 0 THEN m.panel1_Scroll = m.panel1_Scroll + 1
            IF key = "pgup" THEN
                m.panel1_Scroll = m.panel1_Scroll - 6
                IF m.panel1_Scroll < 0 THEN m.panel1_Scroll = 0
            END IF
            IF key = "pgdown" THEN
                m.panel1_Scroll = m.panel1_Scroll + 6
                IF m.panel1_Scroll > 0 THEN m.panel1_Scroll = 0
            END IF
            IF key = "home" THEN m.panel1_Scroll = 0
            IF key = "end" THEN m.panel1_Scroll = 0
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM rows AS []STRING
    DIM r AS INTEGER
    FOR r = 0 TO h - 2
        rows = APPEND(rows, strings.Repeat(" ", w))
    NEXT r
    DIM mbFoc0 AS BOOLEAN = (m.Focus = 0) OR m.menubar1_Open
    DIM mbBar0 AS STRING = ""
    IF mbFoc0 AND m.menubar1_Active = 0 THEN
        mbBar0 = mbBar0 + "[" + "File" + "]"
    ELSE
        mbBar0 = mbBar0 + " " + "File" + " "
    END IF
    IF mbFoc0 AND m.menubar1_Active = 1 THEN
        mbBar0 = mbBar0 + "[" + "Edit" + "]"
    ELSE
        mbBar0 = mbBar0 + " " + "Edit" + " "
    END IF
    IF 0 >= 0 AND 0 < LEN(rows) THEN rows[0] = overlayRow(rows[0], 0, mbBar0)
    DIM pnTop1 AS STRING = "┌" + strings.Repeat("─", 28) + "┐"
    IF 2 >= 0 AND 2 < LEN(rows) THEN rows[2] = overlayRow(rows[2], 2, pnTop1)
    DIM pnThumb1 AS INTEGER = 0 - 1
    IF 0 > 0 AND 4 > 0 THEN
        pnThumb1 = (m.panel1_Scroll * (4 - 1)) / 1
        IF pnThumb1 < 0 THEN pnThumb1 = 0
        IF pnThumb1 > 4 - 1 THEN pnThumb1 = 4 - 1
    END IF
    DIM pnRw1 AS INTEGER
    FOR pnRw1 = 0 TO 6 - 1
        DIM pnSb1 AS STRING = "░"
        IF pnRw1 = 0 THEN pnSb1 = "▲"
        IF pnRw1 = 6 - 1 THEN pnSb1 = "▼"
        IF pnRw1 >= 1 AND pnRw1 <= 6 - 2 AND (pnRw1 - 1) = pnThumb1 THEN pnSb1 = "█"
        DIM pnLn1 AS STRING = "│" + strings.Repeat(" ", 27) + pnSb1 + "│"
        DIM pnLy1 AS INTEGER = 2 + 1 + pnRw1
        IF pnLy1 >= 0 AND pnLy1 < LEN(rows) THEN rows[pnLy1] = overlayRow(rows[pnLy1], 2, pnLn1)
    NEXT pnRw1
    DIM pnBot1 AS STRING = "└" + strings.Repeat("─", 28) + "┘"
    DIM pnBy1 AS INTEGER = 2 + 7
    IF pnBy1 >= 0 AND pnBy1 < LEN(rows) THEN rows[pnBy1] = overlayRow(rows[pnBy1], 2, pnBot1)
    DIM pcY1c2r0 AS INTEGER = 3 - m.panel1_Scroll
    IF pcY1c2r0 >= 3 AND pcY1c2r0 <= 8 AND pcY1c2r0 >= 0 AND pcY1c2r0 < LEN(rows) THEN rows[pcY1c2r0] = overlayCells(rows[pcY1c2r0], 4, "child-in-panel")
    IF m.menubar1_Open THEN
        IF m.menubar1_Active = 0 THEN
            DIM mbT0x0 AS STRING = "┌" + strings.Repeat("─", 6) + "┐"
            IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 0, mbT0x0)
            DIM mbMk0x0y0 AS STRING = " "
            IF m.menubar1_Item = 0 THEN mbMk0x0y0 = ">"
            DIM mbR0x0y0 AS STRING = "│" + mbMk0x0y0 + " New │"
            IF 2 >= 0 AND 2 < LEN(rows) THEN rows[2] = overlayRow(rows[2], 0, mbR0x0y0)
            DIM mbMk0x0y1 AS STRING = " "
            IF m.menubar1_Item = 1 THEN mbMk0x0y1 = ">"
            DIM mbR0x0y1 AS STRING = "│" + mbMk0x0y1 + " Open│"
            IF 3 >= 0 AND 3 < LEN(rows) THEN rows[3] = overlayRow(rows[3], 0, mbR0x0y1)
            DIM mbMk0x0y2 AS STRING = " "
            IF m.menubar1_Item = 2 THEN mbMk0x0y2 = ">"
            DIM mbR0x0y2 AS STRING = "│" + mbMk0x0y2 + " Quit│"
            IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 0, mbR0x0y2)
            DIM mbB0x0 AS STRING = "└" + strings.Repeat("─", 6) + "┘"
            IF 5 >= 0 AND 5 < LEN(rows) THEN rows[5] = overlayRow(rows[5], 0, mbB0x0)
            _mbX = 0
            _mbItemY = 2
            _mbW = 8
            _mbN = 3
        END IF
        IF m.menubar1_Active = 1 THEN
            DIM mbT0x1 AS STRING = "┌" + strings.Repeat("─", 6) + "┐"
            IF 1 >= 0 AND 1 < LEN(rows) THEN rows[1] = overlayRow(rows[1], 6, mbT0x1)
            DIM mbMk0x1y0 AS STRING = " "
            IF m.menubar1_Item = 0 THEN mbMk0x1y0 = ">"
            DIM mbR0x1y0 AS STRING = "│" + mbMk0x1y0 + " Cut │"
            IF 2 >= 0 AND 2 < LEN(rows) THEN rows[2] = overlayRow(rows[2], 6, mbR0x1y0)
            DIM mbMk0x1y1 AS STRING = " "
            IF m.menubar1_Item = 1 THEN mbMk0x1y1 = ">"
            DIM mbR0x1y1 AS STRING = "│" + mbMk0x1y1 + " Copy│"
            IF 3 >= 0 AND 3 < LEN(rows) THEN rows[3] = overlayRow(rows[3], 6, mbR0x1y1)
            DIM mbB0x1 AS STRING = "└" + strings.Repeat("─", 6) + "┘"
            IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 6, mbB0x1)
            _mbX = 6
            _mbItemY = 2
            _mbW = 8
            _mbN = 2
        END IF
    END IF
    rows = APPEND(rows, " — Tab to cycle focus, Esc to quit")
    DIM fullView AS STRING = strings.Join(rows, "\n")
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

FUNCTION cellByteIdx(sIn AS STRING, cell AS INTEGER) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM lead AS INTEGER = 0
    DIM nb AS INTEGER = 0
    DIM fb AS INTEGER = 0
    DO WHILE b < LEN(sIn) AND c < cell
        lead = Asc(Mid(sIn, b + 1, 1))
        IF lead = 27 THEN
            b = b + 1
            IF b < LEN(sIn) AND Asc(Mid(sIn, b + 1, 1)) = 91 THEN b = b + 1
            DO WHILE b < LEN(sIn)
                fb = Asc(Mid(sIn, b + 1, 1))
                b = b + 1
                IF fb >= 64 AND fb <= 126 THEN EXIT DO
            LOOP
        ELSE
            nb = 1
            IF lead >= 240 THEN
                nb = 4
            ELSEIF lead >= 224 THEN
                nb = 3
            ELSEIF lead >= 192 THEN
                nb = 2
            END IF
            b = b + nb
            c = c + 1
        END IF
    LOOP
    RETURN b
END FUNCTION

FUNCTION cellLen(sIn AS STRING) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DO WHILE b < LEN(sIn)
        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))
        DIM nb AS INTEGER = 1
        IF lead >= 240 THEN
            nb = 4
        ELSEIF lead >= 224 THEN
            nb = 3
        ELSEIF lead >= 192 THEN
            nb = 2
        END IF
        b = b + nb
        c = c + 1
    LOOP
    RETURN c
END FUNCTION

FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM txtCells AS INTEGER = 0
    DIM tb AS INTEGER = 0
    DO WHILE tb < LEN(txt)
        DIM tl AS INTEGER = Asc(Mid(txt, tb + 1, 1))
        DIM tn AS INTEGER = 1
        IF tl >= 240 THEN
            tn = 4
        ELSEIF tl >= 224 THEN
            tn = 3
        ELSEIF tl >= 192 THEN
            tn = 2
        END IF
        tb = tb + tn
        txtCells = txtCells + 1
    LOOP
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + txtCells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    DIM pre AS STRING = ""
    IF strings.Contains(lf, Chr(27)) THEN pre = Chr(27) + "[0m"
    RETURN lf + pre + txt + rt
END FUNCTION

FUNCTION overlayCells(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    RETURN overlayRow(row, col, txt)
END FUNCTION

FUNCTION overlayRowAt(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM cells AS INTEGER = lipgloss.Width(txt)
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + cells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    RETURN lf + txt + rt
END FUNCTION

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION overlayFocus(row AS STRING, col AS INTEGER, txt AS STRING, focused AS BOOLEAN) AS STRING
    IF focused THEN RETURN overlayRowAt(row, col, focusStyle.Render(txt))
    RETURN overlayRow(row, col, txt)
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

