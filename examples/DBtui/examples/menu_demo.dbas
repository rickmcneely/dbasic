' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM mb_Active AS INTEGER
    DIM mb_Open   AS BOOLEAN
    DIM mb_Path   AS []INTEGER
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentModel AS POINTER TO Model
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    _currentModel = @m
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        RETURN m, NIL
    END IF
    DIM kpd AS tea.KeyPressMsg
    DIM kpdOk AS BOOLEAN
    kpd, kpdOk = msg.(tea.KeyPressMsg)
    IF kpdOk THEN
        DIM kpdK AS STRING = kpd.String()
        IF m.mb_Open THEN
            DIM mnAmb AS INTEGER
            DIM mnOmb AS BOOLEAN
            DIM mnPmb AS []INTEGER
            DIM mnCmb AS STRING
            mnAmb, mnOmb, mnPmb, mnCmb = _mnKey(_mnNodes_mb(), kpdK, m.mb_Active, m.mb_Open, m.mb_Path)
            m.mb_Active = mnAmb
            m.mb_Open = mnOmb
            m.mb_Path = mnPmb
            IF mnCmb <> "" THEN
                IF mnCmb = "mnuNew" THEN mnuNew_Click()
                IF mnCmb = "mnuAlpha" THEN mnuAlpha_Click()
                IF mnCmb = "mnuBeta" THEN mnuBeta_Click()
                IF mnCmb = "mnuSave" THEN mnuSave_Click()
                IF mnCmb = "mnuExit" THEN mnuExit_Click()
                IF mnCmb = "mnuAbout" THEN mnuAbout_Click()
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF m.mb_Open THEN
            DIM mcAmb AS INTEGER
            DIM mcOmb AS BOOLEAN
            DIM mcPmb AS []INTEGER
            DIM mcCmb AS STRING
            DIM mcHmb AS BOOLEAN
            mcAmb, mcOmb, mcPmb, mcCmb, mcHmb = _mnClickHit(_mnNodes_mb(), mc.X, mc.Y, m.mb_Active, m.mb_Open, m.mb_Path)
            IF mcHmb THEN
                m.mb_Active = mcAmb
                m.mb_Open = mcOmb
                m.mb_Path = mcPmb
                IF mcCmb <> "" THEN
                    IF mcCmb = "mnuNew" THEN mnuNew_Click()
                    IF mcCmb = "mnuAlpha" THEN mnuAlpha_Click()
                    IF mcCmb = "mnuBeta" THEN mnuBeta_Click()
                    IF mcCmb = "mnuSave" THEN mnuSave_Click()
                    IF mcCmb = "mnuExit" THEN mnuExit_Click()
                    IF mcCmb = "mnuAbout" THEN mnuAbout_Click()
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF mc.X >= 2 AND mc.X < 2 + 20 AND mc.Y >= 12 AND mc.Y < 12 + 1 THEN
            m.Focus = 1
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 0 AND mc.X < 0 + 40 AND mc.Y >= 0 AND mc.Y < 0 + 1 THEN
            m.Focus = 0
            DIM mbTX0 AS INTEGER = mc.X - 0
            IF mbTX0 >= 0 AND mbTX0 < 6 THEN
                IF m.mb_Open AND m.mb_Active = 0 THEN
                    m.mb_Open = FALSE
                ELSE
                    m.mb_Active = 0
                    m.mb_Open = TRUE
                    m.mb_Path = _mnOpenPath(_mnNodes_mb(), 0)
                END IF
            END IF
            IF mbTX0 >= 6 AND mbTX0 < 12 THEN
                IF m.mb_Open AND m.mb_Active = 1 THEN
                    m.mb_Open = FALSE
                ELSE
                    m.mb_Active = 1
                    m.mb_Open = TRUE
                    m.mb_Path = _mnOpenPath(_mnNodes_mb(), 1)
                END IF
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 2 AND mm.X < 2 + 20 AND mm.Y >= 12 AND mm.Y < 12 + 1 THEN mmHit = 1
        IF mmHit < 0 AND mm.X >= 0 AND mm.X < 0 + 40 AND mm.Y >= 0 AND mm.Y < 0 + 1 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        IF key = "ctrl+c" OR key = "esc" THEN RETURN m, tea.Quit
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 2
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 1
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            IF key = "left" AND m.mb_Active > 0 THEN m.mb_Active = m.mb_Active - 1
            IF key = "right" AND m.mb_Active < 1 THEN m.mb_Active = m.mb_Active + 1
            IF key = "down" OR key = "enter" OR key = "space" THEN
                m.mb_Open = TRUE
                m.mb_Path = _mnOpenPath(_mnNodes_mb(), m.mb_Active)
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM rows AS []STRING
    DIM r AS INTEGER
    FOR r = 0 TO h - 2
        rows = APPEND(rows, strings.Repeat(" ", w))
    NEXT r
    _mnPaintBar(rows, _mnNodes_mb(), 0, 0, m.mb_Active, m.mb_Open, m.Focus = 0)
    DIM body1 AS STRING
    body1 = "menu demo"
    IF 12 >= 0 AND 12 < LEN(rows) THEN rows[12] = overlayFocus(rows[12], 2, body1, m.Focus = 1, m.Hover = 1)
    IF m.mb_Open THEN
        _mnPaintBoxes(rows, _mnNodes_mb(), 0, 0, m.mb_Active, m.mb_Path)
    END IF
    rows = APPEND(rows, " — Tab to cycle focus, Esc to quit")
    DIM fullView AS STRING = strings.Join(rows, "\n")
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

FUNCTION cellByteIdx(sIn AS STRING, cell AS INTEGER) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM lead AS INTEGER = 0
    DIM nb AS INTEGER = 0
    DIM fb AS INTEGER = 0
    DO WHILE b < LEN(sIn) AND c < cell
        lead = Asc(Mid(sIn, b + 1, 1))
        IF lead = 27 THEN
            b = b + 1
            IF b < LEN(sIn) AND Asc(Mid(sIn, b + 1, 1)) = 91 THEN b = b + 1
            DO WHILE b < LEN(sIn)
                fb = Asc(Mid(sIn, b + 1, 1))
                b = b + 1
                IF fb >= 64 AND fb <= 126 THEN EXIT DO
            LOOP
        ELSE
            nb = 1
            IF lead >= 240 THEN
                nb = 4
            ELSEIF lead >= 224 THEN
                nb = 3
            ELSEIF lead >= 192 THEN
                nb = 2
            END IF
            b = b + nb
            c = c + 1
        END IF
    LOOP
    RETURN b
END FUNCTION

FUNCTION cellLen(sIn AS STRING) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DO WHILE b < LEN(sIn)
        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))
        DIM nb AS INTEGER = 1
        IF lead >= 240 THEN
            nb = 4
        ELSEIF lead >= 224 THEN
            nb = 3
        ELSEIF lead >= 192 THEN
            nb = 2
        END IF
        b = b + nb
        c = c + 1
    LOOP
    RETURN c
END FUNCTION

FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM txtCells AS INTEGER = 0
    DIM tb AS INTEGER = 0
    DO WHILE tb < LEN(txt)
        DIM tl AS INTEGER = Asc(Mid(txt, tb + 1, 1))
        DIM tn AS INTEGER = 1
        IF tl >= 240 THEN
            tn = 4
        ELSEIF tl >= 224 THEN
            tn = 3
        ELSEIF tl >= 192 THEN
            tn = 2
        END IF
        tb = tb + tn
        txtCells = txtCells + 1
    LOOP
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + txtCells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    DIM pre AS STRING = ""
    IF strings.Contains(lf, Chr(27)) THEN pre = Chr(27) + "[0m"
    RETURN lf + pre + txt + rt
END FUNCTION

FUNCTION overlayRowAt(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM cells AS INTEGER = lipgloss.Width(txt)
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + cells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    RETURN lf + txt + rt
END FUNCTION

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION overlayFocus(row AS STRING, col AS INTEGER, txt AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN overlayRowAt(row, col, focusStyle.Render(txt))
    IF hovered THEN RETURN overlayRowAt(row, col, hoverStyle.Render(txt))
    RETURN overlayRow(row, col, txt)
END FUNCTION

TYPE _MNode
    DIM Cap AS STRING
    DIM Nm  AS STRING
    DIM Dp  AS INTEGER
    DIM Sc  AS STRING
    DIM Ck  AS BOOLEAN
    DIM Ds  AS BOOLEAN
    DIM Sp  AS BOOLEAN
END TYPE

FUNCTION _mkMN(cap AS STRING, nm AS STRING, dp AS INTEGER, sc AS STRING, ck AS BOOLEAN, ds AS BOOLEAN, sp AS BOOLEAN) AS _MNode
    DIM n AS _MNode
    n.Cap = cap
    n.Nm = nm
    n.Dp = dp
    n.Sc = sc
    n.Ck = ck
    n.Ds = ds
    n.Sp = sp
    RETURN n
END FUNCTION

DIM _mnBX AS []INTEGER
DIM _mnBY AS []INTEGER
DIM _mnBW AS []INTEGER
DIM _mnBP AS []INTEGER
DIM _mnDim AS lipgloss.Style = lipgloss.NewStyle().Faint(TRUE)

FUNCTION _mnKids(nodes AS []_MNode, parentIdx AS INTEGER) AS []INTEGER
    DIM out AS []INTEGER
    IF parentIdx < 0 THEN
        DIM t AS INTEGER
        FOR t = 0 TO LEN(nodes) - 1
            IF nodes[t].Dp = 0 THEN out = APPEND(out, t)
        NEXT t
        RETURN out
    END IF
    IF parentIdx >= LEN(nodes) THEN RETURN out
    DIM pd AS INTEGER = nodes[parentIdx].Dp
    DIM i AS INTEGER
    FOR i = parentIdx + 1 TO LEN(nodes) - 1
        IF nodes[i].Dp <= pd THEN RETURN out
        IF nodes[i].Dp = pd + 1 THEN out = APPEND(out, i)
    NEXT i
    RETURN out
END FUNCTION

FUNCTION _mnIsSub(nodes AS []_MNode, idx AS INTEGER) AS BOOLEAN
    IF idx < 0 OR idx + 1 >= LEN(nodes) THEN RETURN FALSE
    RETURN nodes[idx + 1].Dp > nodes[idx].Dp
END FUNCTION

FUNCTION _mnTopCount(nodes AS []_MNode) AS INTEGER
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 THEN c = c + 1
    NEXT i
    RETURN c
END FUNCTION

FUNCTION _mnColAt(nodes AS []_MNode, k AS INTEGER) AS INTEGER
    DIM col AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN
            IF c = k THEN RETURN col
            col = col + lipgloss.Width(nodes[i].Cap) + 2
            c = c + 1
        END IF
    NEXT i
    RETURN col
END FUNCTION

FUNCTION _mnNodeAt(nodes AS []_MNode, active AS INTEGER, path AS []INTEGER, depth AS INTEGER) AS INTEGER
    DIM tops AS []INTEGER = _mnKids(nodes, 0 - 1)
    IF active < 0 OR active >= LEN(tops) THEN RETURN 0 - 1
    DIM cur AS INTEGER = tops[active]
    DIM l AS INTEGER
    FOR l = 0 TO depth - 1
        DIM kids AS []INTEGER = _mnKids(nodes, cur)
        IF l >= LEN(path) OR path[l] < 0 OR path[l] >= LEN(kids) THEN RETURN cur
        cur = kids[path[l]]
    NEXT l
    RETURN cur
END FUNCTION

FUNCTION _mnFirst(nodes AS []_MNode, kids AS []INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(kids) - 1
        IF NOT nodes[kids[i]].Sp THEN RETURN i
    NEXT i
    RETURN 0
END FUNCTION

FUNCTION _mnStep(nodes AS []_MNode, kids AS []INTEGER, cur AS INTEGER, dir AS INTEGER) AS INTEGER
    DIM i AS INTEGER = cur + dir
    DO WHILE i >= 0 AND i < LEN(kids)
        IF NOT nodes[kids[i]].Sp THEN RETURN i
        i = i + dir
    LOOP
    RETURN cur
END FUNCTION

FUNCTION _mnOpenPath(nodes AS []_MNode, active AS INTEGER) AS []INTEGER
    DIM p AS []INTEGER
    DIM top AS INTEGER = _mnNodeAt(nodes, active, p, 0)
    p = APPEND(p, _mnFirst(nodes, _mnKids(nodes, top)))
    RETURN p
END FUNCTION

FUNCTION _mnKey(nodes AS []_MNode, key AS STRING, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING)
    DIM chosen AS STRING = ""
    IF NOT open THEN RETURN active, open, path, chosen
    DIM topc AS INTEGER = _mnTopCount(nodes)
    DIM L AS INTEGER = LEN(path)
    IF L = 0 THEN
        path = APPEND(path, 0)
        L = 1
    END IF
    DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, L - 1)
    DIM kids AS []INTEGER = _mnKids(nodes, parent)
    IF LEN(kids) = 0 THEN RETURN active, open, path, chosen
    DIM cur AS INTEGER = path[L - 1]
    IF cur < 0 THEN cur = 0
    IF cur >= LEN(kids) THEN cur = LEN(kids) - 1
    IF key = "esc" THEN RETURN active, FALSE, NIL, chosen
    IF key = "down" THEN
        path[L - 1] = _mnStep(nodes, kids, cur, 1)
        RETURN active, open, path, chosen
    END IF
    IF key = "up" THEN
        path[L - 1] = _mnStep(nodes, kids, cur, 0 - 1)
        RETURN active, open, path, chosen
    END IF
    IF key = "left" THEN
        IF L > 1 THEN
            DIM np AS []INTEGER
            DIM a AS INTEGER
            FOR a = 0 TO L - 2
                np = APPEND(np, path[a])
            NEXT a
            RETURN active, open, np, chosen
        END IF
        IF active > 0 THEN active = active - 1
        RETURN active, open, _mnOpenPath(nodes, active), chosen
    END IF
    IF key = "right" THEN
        DIM rnode AS INTEGER = kids[cur]
        IF _mnIsSub(nodes, rnode) THEN
            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, rnode)))
            RETURN active, open, path, chosen
        END IF
        IF L = 1 AND active < topc - 1 THEN
            active = active + 1
            RETURN active, open, _mnOpenPath(nodes, active), chosen
        END IF
        RETURN active, open, path, chosen
    END IF
    IF key = "enter" OR key = "space" THEN
        DIM enode AS INTEGER = kids[cur]
        IF nodes[enode].Ds THEN RETURN active, open, path, chosen
        IF _mnIsSub(nodes, enode) THEN
            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, enode)))
            RETURN active, open, path, chosen
        END IF
        RETURN active, FALSE, NIL, nodes[enode].Nm
    END IF
    RETURN active, open, path, chosen
END FUNCTION

SUB _mnPaintBar(rows AS []STRING, nodes AS []_MNode, baseX AS INTEGER, baseY AS INTEGER, active AS INTEGER, open AS BOOLEAN, focused AS BOOLEAN)
    DIM bar AS STRING = ""
    DIM k AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN
            IF (focused OR open) AND active = k THEN
                bar = bar + "[" + nodes[i].Cap + "]"
            ELSE
                bar = bar + " " + nodes[i].Cap + " "
            END IF
            k = k + 1
        END IF
    NEXT i
    IF baseY >= 0 AND baseY < LEN(rows) THEN rows[baseY] = overlayRow(rows[baseY], baseX, bar)
END SUB

SUB _mnPaintBoxes(rows AS []STRING, nodes AS []_MNode, baseX AS INTEGER, baseY AS INTEGER, active AS INTEGER, path AS []INTEGER)
    _mnBX = NIL
    _mnBY = NIL
    _mnBW = NIL
    _mnBP = NIL
    IF LEN(path) = 0 THEN RETURN
    DIM prevX AS INTEGER = 0
    DIM prevW AS INTEGER = 0
    DIM prevTopY AS INTEGER = 0
    DIM lev AS INTEGER
    FOR lev = 0 TO LEN(path) - 1
        DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, lev)
        DIM kids AS []INTEGER = _mnKids(nodes, parent)
        IF LEN(kids) = 0 THEN RETURN
        DIM boxX AS INTEGER = 0
        DIM topY AS INTEGER = 0
        IF lev = 0 THEN
            boxX = baseX + _mnColAt(nodes, active)
            topY = baseY + 1
        ELSE
            boxX = prevX + prevW
            topY = prevTopY + path[lev - 1]
        END IF
        DIM innerW AS INTEGER = 1
        DIM j AS INTEGER
        FOR j = 0 TO LEN(kids) - 1
            DIM cw AS INTEGER = 4 + lipgloss.Width(nodes[kids[j]].Cap)
            IF nodes[kids[j]].Sc <> "" THEN cw = cw + 2 + lipgloss.Width(nodes[kids[j]].Sc)
            IF _mnIsSub(nodes, kids[j]) THEN cw = cw + 2
            IF cw > innerW THEN innerW = cw
        NEXT j
        DIM topB AS STRING = "┌" + strings.Repeat("─", innerW) + "┐"
        IF topY >= 0 AND topY < LEN(rows) THEN rows[topY] = overlayRow(rows[topY], boxX, topB)
        DIM sel AS INTEGER = path[lev]
        FOR j = 0 TO LEN(kids) - 1
            DIM ndx AS INTEGER = kids[j]
            DIM itemY AS INTEGER = topY + 1 + j
            IF nodes[ndx].Sp THEN
                DIM sepln AS STRING = "├" + strings.Repeat("─", innerW) + "┤"
                IF itemY >= 0 AND itemY < LEN(rows) THEN rows[itemY] = overlayRow(rows[itemY], boxX, sepln)
            ELSE
                DIM chk AS STRING = "  "
                IF nodes[ndx].Ck THEN chk = "✓ "
                DIM rgt AS STRING = nodes[ndx].Sc
                IF _mnIsSub(nodes, ndx) THEN
                    IF rgt <> "" THEN
                        rgt = rgt + " ▸"
                    ELSE
                        rgt = "▸"
                    END IF
                END IF
                DIM inner AS STRING = " " + chk + nodes[ndx].Cap
                DIM pad AS INTEGER = innerW - lipgloss.Width(inner) - lipgloss.Width(rgt) - 1
                IF pad < 0 THEN pad = 0
                inner = inner + strings.Repeat(" ", pad) + rgt + " "
                DO WHILE lipgloss.Width(inner) > innerW
                    inner = Mid(inner, 1, LEN(inner) - 1)
                LOOP
                DO WHILE lipgloss.Width(inner) < innerW
                    inner = inner + " "
                LOOP
                IF itemY >= 0 AND itemY < LEN(rows) THEN
                    IF j = sel THEN
                        rows[itemY] = overlayRow(rows[itemY], boxX, "│")
                        rows[itemY] = overlayRowAt(rows[itemY], boxX + 1, focusStyle.Render(inner))
                        rows[itemY] = overlayRow(rows[itemY], boxX + 1 + innerW, "│")
                    ELSEIF nodes[ndx].Ds THEN
                        rows[itemY] = overlayRow(rows[itemY], boxX, "│")
                        rows[itemY] = overlayRowAt(rows[itemY], boxX + 1, _mnDim.Render(inner))
                        rows[itemY] = overlayRow(rows[itemY], boxX + 1 + innerW, "│")
                    ELSE
                        rows[itemY] = overlayRow(rows[itemY], boxX, "│" + inner + "│")
                    END IF
                END IF
            END IF
        NEXT j
        DIM botY AS INTEGER = topY + 1 + LEN(kids)
        DIM botB AS STRING = "└" + strings.Repeat("─", innerW) + "┘"
        IF botY >= 0 AND botY < LEN(rows) THEN rows[botY] = overlayRow(rows[botY], boxX, botB)
        _mnBX = APPEND(_mnBX, boxX)
        _mnBY = APPEND(_mnBY, topY + 1)
        _mnBW = APPEND(_mnBW, innerW + 2)
        _mnBP = APPEND(_mnBP, parent)
        prevX = boxX
        prevW = innerW + 2
        prevTopY = topY
    NEXT lev
END SUB

FUNCTION _mnClickHit(nodes AS []_MNode, mx AS INTEGER, my AS INTEGER, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING, BOOLEAN)
    DIM chosen AS STRING = ""
    IF NOT open THEN RETURN active, open, path, chosen, FALSE
    DIM b AS INTEGER
    FOR b = LEN(_mnBX) - 1 TO 0 STEP 0 - 1
        DIM parent AS INTEGER = _mnBP[b]
        DIM kids AS []INTEGER = _mnKids(nodes, parent)
        IF mx >= _mnBX[b] AND mx < _mnBX[b] + _mnBW[b] AND my >= _mnBY[b] AND my < _mnBY[b] + LEN(kids) THEN
            DIM row AS INTEGER = my - _mnBY[b]
            DIM ndx AS INTEGER = kids[row]
            DIM np AS []INTEGER
            DIM a AS INTEGER
            FOR a = 0 TO b - 1
                np = APPEND(np, path[a])
            NEXT a
            np = APPEND(np, row)
            IF nodes[ndx].Sp THEN RETURN active, open, path, chosen, TRUE
            IF nodes[ndx].Ds THEN RETURN active, open, np, chosen, TRUE
            IF _mnIsSub(nodes, ndx) THEN
                np = APPEND(np, _mnFirst(nodes, _mnKids(nodes, ndx)))
                RETURN active, open, np, chosen, TRUE
            END IF
            RETURN active, FALSE, NIL, nodes[ndx].Nm, TRUE
        END IF
    NEXT b
    RETURN active, open, path, chosen, FALSE
END FUNCTION

FUNCTION _mnNodes_mb() AS []_MNode
    DIM ns AS []_MNode
    ns = APPEND(ns, _mkMN("File", "mnuFile", 0, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("New", "mnuNew", 1, "Ctrl+N", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Recent", "mnuRecent", 1, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Alpha", "mnuAlpha", 2, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Beta", "mnuBeta", 2, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("", "", 1, "", FALSE, FALSE, TRUE))
    ns = APPEND(ns, _mkMN("Save", "mnuSave", 1, "", TRUE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("Exit", "mnuExit", 1, "", FALSE, TRUE, FALSE))
    ns = APPEND(ns, _mkMN("Help", "mnuHelp", 0, "", FALSE, FALSE, FALSE))
    ns = APPEND(ns, _mkMN("About", "mnuAbout", 1, "", FALSE, FALSE, FALSE))
    RETURN ns
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

