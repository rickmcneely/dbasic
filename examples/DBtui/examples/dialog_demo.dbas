' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM dlgConfirm_Active AS BOOLEAN
    DIM dlgConfirm_Idx    AS INTEGER
    DIM dlgAskName_Active AS BOOLEAN
    DIM dlgAskName_Idx    AS INTEGER
    DIM dlgAskName_Text    AS STRING
    DIM dlgAskName_OnField AS BOOLEAN
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentModel AS POINTER TO Model
DIM _dlgX AS INTEGER
DIM _dlgY AS INTEGER
DIM _dlgW AS INTEGER
DIM _dlgH AS INTEGER

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    _currentModel = @m
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        RETURN m, NIL
    END IF
    DIM kpd AS tea.KeyPressMsg
    DIM kpdOk AS BOOLEAN
    kpd, kpdOk = msg.(tea.KeyPressMsg)
    IF kpdOk THEN
        DIM kpdK AS STRING = kpd.String()
        IF m.dlgConfirm_Active THEN
            IF kpdK = "esc" THEN
                m.dlgConfirm_Active = FALSE
                dlgConfirm_Close("")
                RETURN m, NIL
            END IF
            IF kpdK = "left" OR kpdK = "shift+tab" THEN
                m.dlgConfirm_Idx = m.dlgConfirm_Idx - 1
                IF m.dlgConfirm_Idx < 0 THEN m.dlgConfirm_Idx = 1
                RETURN m, NIL
            END IF
            IF kpdK = "right" OR kpdK = "tab" THEN
                m.dlgConfirm_Idx = (m.dlgConfirm_Idx + 1) MOD 2
                RETURN m, NIL
            END IF
            IF kpdK = "enter" OR kpdK = "space" THEN
                DIM pickeddlgConfirm AS STRING = ""
                IF m.dlgConfirm_Idx = 0 THEN pickeddlgConfirm = "OK"
                IF m.dlgConfirm_Idx = 1 THEN pickeddlgConfirm = "Cancel"
                m.dlgConfirm_Active = FALSE
                dlgConfirm_Close(pickeddlgConfirm)
                RETURN m, NIL
            END IF
            RETURN m, NIL
        END IF
        IF m.dlgAskName_Active THEN
            IF kpdK = "esc" THEN
                m.dlgAskName_Active = FALSE
                dlgAskName_Close("", m.dlgAskName_Text)
                RETURN m, NIL
            END IF
            IF m.dlgAskName_OnField THEN
                IF kpdK = "enter" THEN
                    m.dlgAskName_Active = FALSE
                    dlgAskName_Close("OK", m.dlgAskName_Text)
                    RETURN m, NIL
                END IF
                IF kpdK = "tab" OR kpdK = "down" THEN
                    m.dlgAskName_OnField = FALSE
                    m.dlgAskName_Idx = 0
                    RETURN m, NIL
                END IF
                IF kpdK = "backspace" AND LEN(m.dlgAskName_Text) > 0 THEN
                    m.dlgAskName_Text = Mid(m.dlgAskName_Text, 1, LEN(m.dlgAskName_Text) - 1)
                    RETURN m, NIL
                END IF
                IF kpdK = "space" THEN
                    m.dlgAskName_Text = m.dlgAskName_Text + " "
                    RETURN m, NIL
                END IF
                IF LEN(kpdK) = 1 THEN
                    m.dlgAskName_Text = m.dlgAskName_Text + kpdK
                    RETURN m, NIL
                END IF
                RETURN m, NIL
            END IF
            IF kpdK = "shift+tab" OR kpdK = "up" THEN
                IF m.dlgAskName_Idx = 0 THEN
                    m.dlgAskName_OnField = TRUE
                ELSE
                    m.dlgAskName_Idx = m.dlgAskName_Idx - 1
                END IF
                RETURN m, NIL
            END IF
            IF kpdK = "left" THEN
                IF m.dlgAskName_Idx > 0 THEN m.dlgAskName_Idx = m.dlgAskName_Idx - 1
                RETURN m, NIL
            END IF
            IF kpdK = "right" OR kpdK = "tab" THEN
                IF m.dlgAskName_Idx < 1 THEN
                    m.dlgAskName_Idx = m.dlgAskName_Idx + 1
                ELSE
                    m.dlgAskName_OnField = TRUE
                    m.dlgAskName_Idx = 0
                END IF
                RETURN m, NIL
            END IF
            IF kpdK = "enter" OR kpdK = "space" THEN
                DIM pickeddlgAskName AS STRING = "OK"
                IF m.dlgAskName_Idx = 1 THEN pickeddlgAskName = "Cancel"
                m.dlgAskName_Active = FALSE
                dlgAskName_Close(pickeddlgAskName, m.dlgAskName_Text)
                RETURN m, NIL
            END IF
            RETURN m, NIL
        END IF
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF m.dlgConfirm_Active AND _dlgW > 0 THEN
            DIM lxdlgConfirm AS INTEGER = mc.X - _dlgX
            DIM lydlgConfirm AS INTEGER = mc.Y - _dlgY
            IF lxdlgConfirm >= 0 AND lydlgConfirm >= 0 AND lxdlgConfirm < _dlgW AND lydlgConfirm < _dlgH THEN
                IF lydlgConfirm = 0 AND (lxdlgConfirm = _dlgW - 3 OR lxdlgConfirm = _dlgW - 4) THEN
                    m.dlgConfirm_Active = FALSE
                    dlgConfirm_Close("")
                    RETURN m, NIL
                END IF
                IF lydlgConfirm = 4 THEN
                    DIM btnWdlgConfirm AS []INTEGER
                    DIM btnTdlgConfirm AS INTEGER = 0
                    btnWdlgConfirm = APPEND(btnWdlgConfirm, 6)
                    btnTdlgConfirm = btnTdlgConfirm + 6
                    btnTdlgConfirm = btnTdlgConfirm + 2
                    btnWdlgConfirm = APPEND(btnWdlgConfirm, 10)
                    btnTdlgConfirm = btnTdlgConfirm + 10
                    DIM innerDWdlgConfirm AS INTEGER = _dlgW - 6
                    DIM padDdlgConfirm AS INTEGER = innerDWdlgConfirm - btnTdlgConfirm
                    IF padDdlgConfirm < 0 THEN padDdlgConfirm = 0
                    DIM bxDdlgConfirm AS INTEGER = 3 + padDdlgConfirm
                    DIM bkDdlgConfirm AS INTEGER
                    FOR bkDdlgConfirm = 0 TO LEN(btnWdlgConfirm) - 1
                        IF lxdlgConfirm >= bxDdlgConfirm AND lxdlgConfirm < bxDdlgConfirm + btnWdlgConfirm[bkDdlgConfirm] THEN
                            DIM clickedLbldlgConfirm AS STRING = ""
                            IF bkDdlgConfirm = 0 THEN clickedLbldlgConfirm = "OK"
                            IF bkDdlgConfirm = 1 THEN clickedLbldlgConfirm = "Cancel"
                            m.dlgConfirm_Active = FALSE
                            dlgConfirm_Close(clickedLbldlgConfirm)
                            RETURN m, NIL
                        END IF
                        bxDdlgConfirm = bxDdlgConfirm + btnWdlgConfirm[bkDdlgConfirm] + 2
                    NEXT bkDdlgConfirm
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF m.dlgAskName_Active AND _dlgW > 0 THEN
            DIM lxdlgAskName AS INTEGER = mc.X - _dlgX
            DIM lydlgAskName AS INTEGER = mc.Y - _dlgY
            IF lxdlgAskName >= 0 AND lydlgAskName >= 0 AND lxdlgAskName < _dlgW AND lydlgAskName < _dlgH THEN
                IF lydlgAskName = 0 AND (lxdlgAskName = _dlgW - 3 OR lxdlgAskName = _dlgW - 4) THEN
                    m.dlgAskName_Active = FALSE
                    dlgAskName_Close("", m.dlgAskName_Text)
                    RETURN m, NIL
                END IF
                IF lydlgAskName = 6 THEN
                    DIM btnWdlgAskName AS []INTEGER
                    DIM btnTdlgAskName AS INTEGER = 0
                    btnWdlgAskName = APPEND(btnWdlgAskName, 6)
                    btnTdlgAskName = btnTdlgAskName + 6
                    btnTdlgAskName = btnTdlgAskName + 2
                    btnWdlgAskName = APPEND(btnWdlgAskName, 10)
                    btnTdlgAskName = btnTdlgAskName + 10
                    DIM innerDWdlgAskName AS INTEGER = _dlgW - 6
                    DIM padDdlgAskName AS INTEGER = innerDWdlgAskName - btnTdlgAskName
                    IF padDdlgAskName < 0 THEN padDdlgAskName = 0
                    DIM bxDdlgAskName AS INTEGER = 3 + padDdlgAskName
                    DIM bkDdlgAskName AS INTEGER
                    FOR bkDdlgAskName = 0 TO LEN(btnWdlgAskName) - 1
                        IF lxdlgAskName >= bxDdlgAskName AND lxdlgAskName < bxDdlgAskName + btnWdlgAskName[bkDdlgAskName] THEN
                            DIM clickedLbldlgAskName AS STRING = ""
                            IF bkDdlgAskName = 0 THEN clickedLbldlgAskName = "OK"
                            IF bkDdlgAskName = 1 THEN clickedLbldlgAskName = "Cancel"
                            m.dlgAskName_Active = FALSE
                            dlgAskName_Close(clickedLbldlgAskName, m.dlgAskName_Text)
                            RETURN m, NIL
                        END IF
                        bxDdlgAskName = bxDdlgAskName + btnWdlgAskName[bkDdlgAskName] + 2
                    NEXT bkDdlgAskName
                END IF
                IF lydlgAskName = 4 THEN m.dlgAskName_OnField = TRUE
                RETURN m, NIL
            END IF
        END IF
        IF mc.X >= 30 AND mc.X < 30 + 12 AND mc.Y >= 10 AND mc.Y < 10 + 5 THEN
            m.Focus = 4
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 30 AND mc.X < 30 + 12 AND mc.Y >= 4 AND mc.Y < 4 + 5 THEN
            m.Focus = 3
            _ = mc
            RETURN m, NIL
        END IF
        IF mc.X >= 4 AND mc.X < 4 + 12 AND mc.Y >= 8 AND mc.Y < 8 + 1 THEN
            m.Focus = 2
            dispatchClick("btnPlain")
            RETURN m, NIL
        END IF
        IF mc.X >= 4 AND mc.X < 4 + 12 AND mc.Y >= 6 AND mc.Y < 6 + 1 THEN
            m.Focus = 1
            dispatchClick("btnAsk")
            RETURN m, NIL
        END IF
        IF mc.X >= 4 AND mc.X < 4 + 16 AND mc.Y >= 4 AND mc.Y < 4 + 1 THEN
            m.Focus = 0
            dispatchClick("btnOpen")
            RETURN m, NIL
        END IF
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        IF key = "ctrl+c" OR key = "esc" THEN RETURN m, tea.Quit
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 5
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 4
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            IF key = "enter" OR key = "space" THEN dispatchClick("btnOpen")
            RETURN m, NIL
        END IF
        IF m.Focus = 1 THEN
            IF key = "enter" OR key = "space" THEN dispatchClick("btnAsk")
            RETURN m, NIL
        END IF
        IF m.Focus = 2 THEN
            IF key = "enter" OR key = "space" THEN dispatchClick("btnPlain")
            RETURN m, NIL
        END IF
        IF m.Focus = 3 THEN
            _ = key
            RETURN m, NIL
        END IF
        IF m.Focus = 4 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM rows AS []STRING
    DIM r AS INTEGER
    FOR r = 0 TO h - 2
        rows = APPEND(rows, strings.Repeat(" ", w))
    NEXT r
    DIM body0 AS STRING
    body0 = "[ Open Confirm ]"
    IF m.Focus = 0 THEN
        body0 = ">" + body0
    ELSE
        body0 = " " + body0
    END IF
    IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 4, body0)
    DIM body1 AS STRING
    body1 = "[ Ask Name ]"
    IF m.Focus = 1 THEN
        body1 = ">" + body1
    ELSE
        body1 = " " + body1
    END IF
    IF 6 >= 0 AND 6 < LEN(rows) THEN rows[6] = overlayRow(rows[6], 4, body1)
    DIM body2 AS STRING
    body2 = "[ Plain ]"
    IF m.Focus = 2 THEN
        body2 = ">" + body2
    ELSE
        body2 = " " + body2
    END IF
    IF 8 >= 0 AND 8 < LEN(rows) THEN rows[8] = overlayRow(rows[8], 4, body2)
    DIM body3 AS STRING
    body3 = "◇ Dialog(confirm): Confirm"
    IF m.Focus = 3 THEN
        body3 = ">" + body3
    ELSE
        body3 = " " + body3
    END IF
    IF 4 >= 0 AND 4 < LEN(rows) THEN rows[4] = overlayRow(rows[4], 30, body3)
    DIM body4 AS STRING
    body4 = "◇ Dialog(input): Your Name"
    IF m.Focus = 4 THEN
        body4 = ">" + body4
    ELSE
        body4 = " " + body4
    END IF
    IF 10 >= 0 AND 10 < LEN(rows) THEN rows[10] = overlayRow(rows[10], 30, body4)
    rows = APPEND(rows, " — Tab to cycle focus, Esc to quit")
    DIM fullView AS STRING = strings.Join(rows, "\n")
    DIM dlgStr AS STRING = ""
    IF dlgStr = "" AND m.dlgConfirm_Active THEN
        DIM btnsdlgConfirm AS []STRING
        btnsdlgConfirm = APPEND(btnsdlgConfirm, "OK")
        btnsdlgConfirm = APPEND(btnsdlgConfirm, "Cancel")
        dlgStr = fdRenderConfirm("Confirm", "Are you sure?", btnsdlgConfirm, m.dlgConfirm_Idx)
    END IF
    IF dlgStr = "" AND m.dlgAskName_Active THEN
        DIM actIdxdlgAskName AS INTEGER = m.dlgAskName_Idx
        IF m.dlgAskName_OnField THEN actIdxdlgAskName = 0 - 1
        dlgStr = fdRenderInput("Your Name", "What is your name?", m.dlgAskName_Text, m.dlgAskName_OnField, actIdxdlgAskName)
    END IF
    IF dlgStr <> "" THEN
        DIM dwW AS INTEGER = lipgloss.Width(dlgStr)
        DIM dwH AS INTEGER = lipgloss.Height(dlgStr)
        DIM dwX AS INTEGER = (w - dwW) / 2
        DIM dwY AS INTEGER = (h - dwH) / 2
        IF dwX < 0 THEN dwX = 0
        IF dwY < 0 THEN dwY = 0
        _dlgX = dwX
        _dlgY = dwY
        _dlgW = dwW
        _dlgH = dwH
        DIM dlgLines AS []STRING = strings.Split(dlgStr, "\n")
        DIM dlgRi AS INTEGER
        FOR dlgRi = 0 TO LEN(dlgLines) - 1
            DIM tgtY AS INTEGER = dwY + dlgRi
            IF tgtY >= 0 AND tgtY < LEN(rows) THEN
                rows[tgtY] = overlayRowAt(rows[tgtY], dwX, dlgLines[dlgRi])
            END IF
        NEXT dlgRi
        fullView = strings.Join(rows, "\n")
    ELSE
        _dlgW = 0
        _dlgH = 0
    END IF
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeCellMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

SUB Main()
    DIM m AS Model
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

FUNCTION cellByteIdx(sIn AS STRING, cell AS INTEGER) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DO WHILE b < LEN(sIn) AND c < cell
        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))
        DIM nb AS INTEGER = 1
        IF lead >= 240 THEN
            nb = 4
        ELSEIF lead >= 224 THEN
            nb = 3
        ELSEIF lead >= 192 THEN
            nb = 2
        END IF
        b = b + nb
        c = c + 1
    LOOP
    RETURN b
END FUNCTION

FUNCTION cellLen(sIn AS STRING) AS INTEGER
    DIM b AS INTEGER = 0
    DIM c AS INTEGER = 0
    DO WHILE b < LEN(sIn)
        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))
        DIM nb AS INTEGER = 1
        IF lead >= 240 THEN
            nb = 4
        ELSEIF lead >= 224 THEN
            nb = 3
        ELSEIF lead >= 192 THEN
            nb = 2
        END IF
        b = b + nb
        c = c + 1
    LOOP
    RETURN c
END FUNCTION

FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM txtCells AS INTEGER = 0
    DIM tb AS INTEGER = 0
    DO WHILE tb < LEN(txt)
        DIM tl AS INTEGER = Asc(Mid(txt, tb + 1, 1))
        DIM tn AS INTEGER = 1
        IF tl >= 240 THEN
            tn = 4
        ELSEIF tl >= 224 THEN
            tn = 3
        ELSEIF tl >= 192 THEN
            tn = 2
        END IF
        tb = tb + tn
        txtCells = txtCells + 1
    LOOP
    DIM startB AS INTEGER = cellByteIdx(row, col)
    DIM endB AS INTEGER = cellByteIdx(row, col + txtCells)
    DIM lf AS STRING = ""
    IF startB > 0 THEN lf = Mid(row, 1, startB)
    DIM rt AS STRING = ""
    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)
    RETURN lf + txt + rt
END FUNCTION

FUNCTION overlayRowAt(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING
    DIM lf AS STRING = ""
    IF col > 0 AND col <= LEN(row) THEN lf = Mid(row, 1, col)
    DIM cells AS INTEGER = lipgloss.Width(txt)
    DIM rt AS STRING = ""
    IF col + cells < LEN(row) THEN rt = Mid(row, col + cells + 1, LEN(row) - col - cells)
    RETURN lf + txt + rt
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    IF id = "btnOpen" THEN
        ShowdlgConfirm()
        btnOpen_Click()
    END IF
    IF id = "btnAsk" THEN
        ShowdlgAskName()
        btnAsk_Click()
    END IF
    IF id = "btnPlain" THEN btnPlain_Click()
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

' ShowdlgConfirm — pop the dlgConfirm dialog.
' Call from inside a _Click / _Change handler. On commit/
' cancel dlgConfirm_Close(button STRING) fires (defined
' below the marker — user fills in the body).
SUB ShowdlgConfirm()
    IF _currentModel = NIL THEN RETURN
    _currentModel.dlgConfirm_Active = TRUE
    _currentModel.dlgConfirm_Idx    = 0
END SUB

' ShowdlgAskName — pop the dlgAskName dialog.
' Call from inside a _Click / _Change handler. On commit/
' cancel dlgAskName_Close(button STRING, text STRING) fires (defined
' below the marker — user fills in the body).
SUB ShowdlgAskName()
    IF _currentModel = NIL THEN RETURN
    _currentModel.dlgAskName_Active = TRUE
    _currentModel.dlgAskName_Idx    = 0
    _currentModel.dlgAskName_Text    = "anonymous"
    _currentModel.dlgAskName_OnField = TRUE
END SUB

FUNCTION fdRenderConfirm(title AS STRING, msg AS STRING, buttons AS []STRING, activeIdx AS INTEGER) AS STRING
    DIM innerW AS INTEGER = 48
    DIM cBg     AS STRING = "#1a1b2e"
    DIM cFg     AS STRING = "#e0def4"
    DIM cAccent AS STRING = "#7dcfff"
    DIM cBorder AS STRING = "#3b3d5e"
    DIM cHl     AS STRING = "#2d4f67"
    DIM cClose  AS STRING = "#f9e2af"
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)
    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)
    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))
    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)
    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))
    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)
    DIM body AS STRING = bodyStyle.Render(msg)
    DIM totalW AS INTEGER = 0
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(buttons) - 1
        totalW = totalW + lipgloss.Width("[ " + buttons[bi] + " ]")
        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT bi
    DIM padBtn AS INTEGER = innerW - totalW
    IF padBtn < 0 THEN padBtn = 0
    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" ", padBtn))
    FOR bi = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[bi] + " ]"
        IF bi = activeIdx THEN
            btnRow = btnRow + btnActive.Render(lbl)
        ELSE
            btnRow = btnRow + btnStyle.Render(lbl)
        END IF
        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render("  ")
    NEXT bi
    DIM spacer AS STRING = bodyStyle.Render(" ")
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, body, spacer, btnRow)
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    DIM bodyStr AS STRING = frame.Render(stacked)
    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)
    DIM titleTxt AS STRING = " " + title + " "
    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)
    DIM dashLen AS INTEGER = totalDW - titleLen - 6
    IF dashLen < 0 THEN dashLen = 0
    DIM topBorder AS STRING = borderStyle.Render("╭─") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat("─", dashLen) + " ") + closeStyle.Render("✕") + borderStyle.Render(" ╮")
    RETURN topBorder + "\n" + bodyStr
END FUNCTION

FUNCTION fdRenderInput(title AS STRING, prompt AS STRING, txt AS STRING, onField AS BOOLEAN, activeIdx AS INTEGER) AS STRING
    DIM innerW AS INTEGER = 48
    DIM cBg     AS STRING = "#1a1b2e"
    DIM cFg     AS STRING = "#e0def4"
    DIM cAccent AS STRING = "#7dcfff"
    DIM cBorder AS STRING = "#3b3d5e"
    DIM cHl     AS STRING = "#2d4f67"
    DIM cClose  AS STRING = "#f9e2af"
    DIM cField  AS STRING = "#11121f"
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)
    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)
    DIM fieldStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cField)).Width(innerW)
    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))
    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)
    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))
    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)
    DIM promptRow AS STRING = bodyStyle.Render(prompt)
    DIM fieldTxt AS STRING = " " + txt
    IF onField THEN fieldTxt = fieldTxt + "█"
    DIM fieldRow AS STRING = fieldStyle.Render(fieldTxt)
    DIM buttons AS []STRING
    buttons = APPEND(buttons, "OK")
    buttons = APPEND(buttons, "Cancel")
    DIM totalW AS INTEGER = 0
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(buttons) - 1
        totalW = totalW + lipgloss.Width("[ " + buttons[bi] + " ]")
        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT bi
    DIM padBtn AS INTEGER = innerW - totalW
    IF padBtn < 0 THEN padBtn = 0
    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" ", padBtn))
    FOR bi = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[bi] + " ]"
        IF bi = activeIdx THEN
            btnRow = btnRow + btnActive.Render(lbl)
        ELSE
            btnRow = btnRow + btnStyle.Render(lbl)
        END IF
        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render("  ")
    NEXT bi
    DIM spacer AS STRING = bodyStyle.Render(" ")
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, promptRow, spacer, fieldRow, spacer, btnRow)
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    DIM bodyStr AS STRING = frame.Render(stacked)
    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)
    DIM titleTxt AS STRING = " " + title + " "
    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)
    DIM dashLen AS INTEGER = totalDW - titleLen - 6
    IF dashLen < 0 THEN dashLen = 0
    DIM topBorder AS STRING = borderStyle.Render("╭─") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat("─", dashLen) + " ") + closeStyle.Render("✕") + borderStyle.Render(" ╮")
    RETURN topBorder + "\n" + bodyStr
END FUNCTION

