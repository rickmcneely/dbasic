' DBtui shell mock — interactive handlers.
'
' Generated from dbtui_shell.dbproj. Demonstrates the widget set
' behaving like a tiny IDE:
'
'   - Selecting a kind in the Widgets palette places a new instance
'     of that kind on the canvas at an incrementing position.
'   - Clicking a placed widget (id "w0", "w1", …) repopulates the
'     PropertyGrid with that widget's actual current state.
'   - Edit > Cut removes the most-recently-placed widget.
'
' Inter-widget mutation flows through the gGet*/gSet*/gAddWidget/
' gRemoveWidget accessors that codegen emits at package level.

IMPORT "fmt"
IMPORT "os"
IMPORT "strconv"
IMPORT "strings"

DIM gPlacedCount AS INTEGER = 0
DIM gPlaceX AS INTEGER = 30
DIM gPlaceY AS INTEGER = 3
' Id of the placed widget currently being inspected — set by gOnSelect,
' read by props_Change to know which widget to push edits back to.
DIM gSelectedWidgetId AS STRING = ""

FUNCTION defaultSizeFor(kind AS STRING) AS (INTEGER, INTEGER)
    IF kind = "Button" THEN RETURN 12, 3
    IF kind = "Label" THEN RETURN 16, 1
    IF kind = "TextInput" THEN RETURN 20, 3
    IF kind = "TextArea" THEN RETURN 24, 5
    IF kind = "Checkbox" THEN RETURN 16, 1
    IF kind = "RadioButton" THEN RETURN 16, 1
    IF kind = "ComboBox" THEN RETURN 20, 3
    IF kind = "ListBox" THEN RETURN 20, 6
    IF kind = "ProgressBar" THEN RETURN 24, 3
    IF kind = "ScrollBar" THEN RETURN 3, 8
    IF kind = "TreeView" THEN RETURN 24, 10
    IF kind = "GroupBox" THEN RETURN 24, 6
    IF kind = "TabStrip" THEN RETURN 24, 1
    IF kind = "ScrollPane" THEN RETURN 24, 8
    IF kind = "PropertyGrid" THEN RETURN 30, 10
    IF kind = "MenuBar" THEN RETURN 30, 1
    IF kind = "StatusBar" THEN RETURN 30, 1
    IF kind = "SplitPanel" THEN RETURN 1, 8
    RETURN 16, 3
END FUNCTION

FUNCTION kindAtIdx(idx AS INTEGER) AS STRING
    DIM items AS []STRING = strings.Split(gGetItems("lbWidgets"), ";")
    IF idx < 0 OR idx >= LEN(items) THEN RETURN ""
    RETURN items[idx]
END FUNCTION

' rowsForPlacedWidget builds a PropertyGrid Rows string showing the
' actual current state of the widget with the given id. Falls back to
' a kind-agnostic skeleton when the kind has no special properties.
FUNCTION rowsForPlacedWidget(id AS STRING) AS STRING
    DIM idx AS INTEGER = gWidgetIdx(id)
    IF idx < 0 THEN RETURN ""
    DIM kind AS STRING = gWidgetKindAt(idx)
    DIM s AS STRING = kind + "||||"
    s = s + ";|Id|" + id + "|"
    s = s + ";|Visible|true|bool"
    DIM tx AS STRING = gGetText(id)
    IF tx <> "" THEN s = s + ";|Text|" + tx + "|"
    DIM val AS STRING = gGetValue(id)
    IF val <> "" THEN s = s + ";|Value|" + val + "|"
    DIM it AS STRING = gGetItems(id)
    IF it <> "" THEN
        DIM safe AS STRING = strings.ReplaceAll(it, ";", ",")
        s = s + ";|Items|" + safe + "|"
    END IF
    DIM sel AS INTEGER = gGetSelected(id)
    IF sel >= 0 THEN s = s + ";|Selected|" + fmt.Sprintf("%d", sel) + "|int"
    DIM ttl AS STRING = gGetTitle(id)
    IF ttl <> "" THEN s = s + ";|Title|" + ttl + "|"
    RETURN s
END FUNCTION

SUB mb_Action(action AS STRING)
    IF action = "file.exit" THEN os.Exit(0)
    IF action = "edit.cut" THEN
        IF gPlacedCount > 0 THEN
            DIM lastId AS STRING = fmt.Sprintf("w%d", gPlacedCount - 1)
            DIM ok AS BOOLEAN = gRemoveWidget(lastId)
            IF ok THEN gPlacedCount = gPlacedCount - 1
            gSetItems("status", fmt.Sprintf("Placed:%d;Removed:%s", gPlacedCount, lastId))
        END IF
        RETURN
    END IF
    fmt.Fprintln(os.Stderr, "menu:", action)
END SUB

SUB tree_Change()
    fmt.Fprintln(os.Stderr, "tree row changed")
END SUB

SUB tabs_Change()
    fmt.Fprintln(os.Stderr, "tab changed")
END SUB

' lbWidgets_Change — palette selection changed; drop a new widget.
SUB lbWidgets_Change()
    DIM idx AS INTEGER = gGetSelected("lbWidgets")
    DIM kind AS STRING = kindAtIdx(idx)
    IF kind = "" THEN RETURN
    DIM newId AS STRING = fmt.Sprintf("w%d", gPlacedCount)
    DIM w AS INTEGER
    DIM h AS INTEGER
    w, h = defaultSizeFor(kind)
    DIM nIdx AS INTEGER = gAddWidget(kind, newId, gPlaceX, gPlaceY, w, h)
    IF nIdx < 0 THEN RETURN
    gPlacedCount = gPlacedCount + 1
    gPlaceX = gPlaceX + 2
    gPlaceY = gPlaceY + h + 1
    IF gPlaceY > 22 THEN
        gPlaceY = 3
        gPlaceX = gPlaceX + 10
    END IF
    IF gPlaceX > 60 THEN
        gPlaceX = 30
    END IF
    gSetItems("status", fmt.Sprintf("Placed:%d;Last:%s;Kind:%s", gPlacedCount, newId, kind))
END SUB

' props_Change — fires after a PropertyGrid edit/toggle/cycle. Reads
' the currently-selected row out of the props Items string and pushes
' the value back to the inspected widget via the matching accessor.
SUB props_Change()
    IF gSelectedWidgetId = "" THEN RETURN
    DIM rows AS []STRING = strings.Split(gGetItems("props"), ";")
    DIM cur AS INTEGER = gGetSelected("props")
    IF cur < 0 OR cur >= LEN(rows) THEN RETURN
    DIM parts AS []STRING = strings.SplitN(rows[cur], "|", 4)
    DO WHILE LEN(parts) < 4
        parts = APPEND(parts, "")
    LOOP
    ' Skip category headers (Category column non-empty).
    IF parts[0] <> "" THEN RETURN
    DIM name AS STRING = parts[1]
    DIM val AS STRING = parts[2]
    IF name = "Text" THEN
        gSetText(gSelectedWidgetId, val)
    ELSEIF name = "Value" THEN
        gSetValue(gSelectedWidgetId, val)
    ELSEIF name = "Title" THEN
        gSetTitle(gSelectedWidgetId, val)
    ELSEIF name = "Visible" THEN
        gSetVisible(gSelectedWidgetId, val = "true")
    ELSEIF name = "Selected" THEN
        DIM iv AS INTEGER = 0
        DIM ierr AS ERROR
        iv, ierr = strconv.Atoi(val)
        _ = ierr
        gSetSelected(gSelectedWidgetId, iv)
    ELSEIF name = "Items" THEN
        ' Demo encoding swaps ; for , when serializing into the grid;
        ' swap back before pushing to the widget.
        gSetItems(gSelectedWidgetId, strings.ReplaceAll(val, ",", ";"))
    END IF
    ' Refresh status so the user sees the writeback happened.
    gSetItems("status", fmt.Sprintf("Placed:%d;Edited:%s.%s=%s", gPlacedCount, gSelectedWidgetId, name, val))
END SUB

' gOnSelect — called for every focus change AND every successful
' click hit (codegen-supplied hook). Only acts on placed widgets
' (id prefix "w"); leaves gSelectedWidgetId untouched otherwise so
' the user can Tab off the placed widget into the props grid without
' losing the selection target.
SUB gOnSelect(id AS STRING)
    IF NOT strings.HasPrefix(id, "w") THEN RETURN
    gSelectedWidgetId = id
    DIM rows AS STRING = rowsForPlacedWidget(id)
    IF rows = "" THEN RETURN
    gSetItems("props", rows)
    gSetSelected("props", 0)
    gSetItems("status", fmt.Sprintf("Placed:%d;Selected:%s", gPlacedCount, id))
END SUB
