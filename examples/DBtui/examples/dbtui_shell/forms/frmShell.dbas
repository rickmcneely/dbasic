' DBtui shell mock — interactive handlers.
'
' Generated from dbtui_shell.dbproj. Demonstrates the widget set
' behaving like a tiny IDE:
'
'   - Selecting a kind in the Widgets palette places a new instance
'     of that kind on the canvas at an incrementing position.
'   - Each new widget gets a unique id and sensible defaults via
'     the codegen-emitted gAddWidget() helper.
'   - The status bar reflects the running widget count.
'
' Inter-widget mutation flows through the gGet*/gSet*/gAddWidget
' accessors that codegen emits at package level.

IMPORT "fmt"
IMPORT "os"

' Package-level placement state — incremented each time we drop a
' widget so they don't all stack at the same point.
DIM gPlacedCount AS INTEGER = 0
DIM gPlaceX AS INTEGER = 30
DIM gPlaceY AS INTEGER = 3

' defaultSizeFor — pick a width/height that fits the kind.
FUNCTION defaultSizeFor(kind AS STRING) AS (INTEGER, INTEGER)
    IF kind = "Button" THEN RETURN 12, 3
    IF kind = "Label" THEN RETURN 16, 1
    IF kind = "TextInput" THEN RETURN 20, 3
    IF kind = "TextArea" THEN RETURN 24, 5
    IF kind = "Checkbox" THEN RETURN 16, 1
    IF kind = "RadioButton" THEN RETURN 16, 1
    IF kind = "ComboBox" THEN RETURN 20, 3
    IF kind = "ListBox" THEN RETURN 20, 6
    IF kind = "ProgressBar" THEN RETURN 24, 3
    IF kind = "ScrollBar" THEN RETURN 3, 8
    IF kind = "TreeView" THEN RETURN 24, 10
    IF kind = "GroupBox" THEN RETURN 24, 6
    IF kind = "TabStrip" THEN RETURN 24, 1
    IF kind = "ScrollPane" THEN RETURN 24, 8
    IF kind = "PropertyGrid" THEN RETURN 30, 10
    IF kind = "MenuBar" THEN RETURN 30, 1
    IF kind = "StatusBar" THEN RETURN 30, 1
    IF kind = "SplitPanel" THEN RETURN 1, 8
    RETURN 16, 3
END FUNCTION

' kindAtIdx — the palette's nth kind label.
FUNCTION kindAtIdx(idx AS INTEGER) AS STRING
    DIM items AS []STRING = strings.Split(gGetItems("lbWidgets"), ";")
    IF idx < 0 OR idx >= LEN(items) THEN RETURN ""
    RETURN items[idx]
END FUNCTION

SUB mb_Action(action AS STRING)
    IF action = "file.exit" THEN os.Exit(0)
    IF action = "edit.cut" THEN
        ' Demo: remove the most-recently-placed widget by id.
        IF gPlacedCount > 0 THEN
            DIM lastId AS STRING = fmt.Sprintf("w%d", gPlacedCount - 1)
            DIM ok AS BOOLEAN = gRemoveWidget(lastId)
            IF ok THEN gPlacedCount = gPlacedCount - 1
            gSetItems("status", fmt.Sprintf("Placed:%d;Last action:%s;Removed:%s", gPlacedCount, action, lastId))
        END IF
        RETURN
    END IF
    fmt.Fprintln(os.Stderr, "menu:", action)
END SUB

SUB tree_Change()
    fmt.Fprintln(os.Stderr, "tree row changed")
END SUB

SUB tabs_Change()
    fmt.Fprintln(os.Stderr, "tab changed")
END SUB

' lbWidgets_Change — palette row changed. Place a new widget of that
' kind on the canvas, with an auto-generated id and an incrementing
' position so widgets don't overlap.
SUB lbWidgets_Change()
    DIM idx AS INTEGER = gGetSelected("lbWidgets")
    DIM kind AS STRING = kindAtIdx(idx)
    IF kind = "" THEN RETURN
    DIM newId AS STRING = fmt.Sprintf("w%d", gPlacedCount)
    DIM w AS INTEGER
    DIM h AS INTEGER
    w, h = defaultSizeFor(kind)
    DIM nIdx AS INTEGER = gAddWidget(kind, newId, gPlaceX, gPlaceY, w, h)
    IF nIdx < 0 THEN RETURN
    gPlacedCount = gPlacedCount + 1
    ' Step the placement cursor diagonally so each new widget is
    ' visible. Wrap back when we'd run off the canvas.
    gPlaceX = gPlaceX + 2
    gPlaceY = gPlaceY + h + 1
    IF gPlaceY > 22 THEN
        gPlaceY = 3
        gPlaceX = gPlaceX + 10
    END IF
    IF gPlaceX > 60 THEN
        gPlaceX = 30
    END IF
    gSetItems("status", fmt.Sprintf("Placed:%d;Last:%s;Kind:%s", gPlacedCount, newId, kind))
END SUB

SUB props_Change()
    fmt.Fprintln(os.Stderr, "property changed")
END SUB
