' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "fmt"
IMPORT "os"
IMPORT "strings"
IMPORT "runtime"
IMPORT "os/exec" AS exec
IMPORT "charm.land/lipgloss/v2" AS lipgloss

SUB _dbtuiKeepFmtAlive()
    _ = fmt.Sprintf("")
END SUB

TYPE Model
    DIM Width  AS INTEGER
    DIM Height AS INTEGER
    DIM Focus  AS INTEGER
    DIM Hover  AS INTEGER
    DIM HoverTab AS INTEGER
    DIM _formW AS INTEGER
    DIM _formH AS INTEGER
    DIM _maximized AS BOOLEAN
    DIM _minimized AS BOOLEAN
END TYPE

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

DIM _currentProgram AS POINTER TO tea.Program
TYPE _dbtuiWakeMsg
    DIM n AS INTEGER
END TYPE
SUB _dbtuiWake()
    IF _currentProgram <> NIL THEN
        DIM _wm AS _dbtuiWakeMsg
        _currentProgram.Send(_wm)
    END IF
END SUB
FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM _wkMsg AS _dbtuiWakeMsg
    DIM _wkOk AS BOOLEAN
    _wkMsg, _wkOk = msg.(_dbtuiWakeMsg)
    IF _wkOk THEN
        _ = _wkMsg
        Form_Wake()
        RETURN m, NIL
    END IF
    DIM sz AS tea.WindowSizeMsg
    DIM szOk AS BOOLEAN
    sz, szOk = msg.(tea.WindowSizeMsg)
    IF szOk THEN
        m.Width = sz.Width
        m.Height = sz.Height
        _formSize(@m)
        Terminal_Resize(m.Width, m.Height)
        RETURN m, NIL
    END IF
    DIM mc AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mc, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk THEN
        DIM _fmb AS STRING = "left"
        IF mc.Button = tea.MouseRight THEN _fmb = "right"
        Form_Mouse("click", _fmb, mc.X, mc.Y)
    END IF
    IF mcOk AND mc.Button = tea.MouseLeft THEN
        IF mc.Y = 0 THEN
            DIM gstart AS INTEGER = m._formW - 1 - 2
            DIM ggi AS INTEGER = (mc.X - gstart) / 2
            IF mc.X >= gstart AND ggi = 0 THEN
                Form_Close()
                RETURN m, tea.Quit
            END IF
        END IF
        IF mc.X >= 1 AND mc.X < 1 + 78 AND mc.Y >= 1 AND mc.Y < 1 + 22 THEN
            m.Focus = 0
            cv_Click(mc.X - 1, mc.Y - 1)
            RETURN m, NIL
        END IF
    END IF
    DIM mm AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mm, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        Form_Mouse("motion", "", mm.X, mm.Y)
        DIM mmHit AS INTEGER = 0 - 1
        IF mmHit < 0 AND mm.X >= 1 AND mm.X < 1 + 78 AND mm.Y >= 1 AND mm.Y < 1 + 22 THEN mmHit = 0
        _ = mm
        m.Hover = mmHit
        m.HoverTab = 0 - 1
        RETURN m, NIL
    END IF
    DIM mw AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mw, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        DIM _fmw AS STRING = "up"
        IF mw.Button = tea.MouseWheelDown THEN _fmw = "down"
        Form_Mouse("wheel", _fmw, mw.X, mw.Y)
        _ = mw
        RETURN m, NIL
    END IF
    DIM k AS tea.KeyPressMsg
    DIM kOk AS BOOLEAN
    k, kOk = msg.(tea.KeyPressMsg)
    IF kOk THEN
        DIM key AS STRING = k.String()
        Form_Key(key)
        IF key = "ctrl+c" OR key = "esc" THEN
            Form_Close()
            RETURN m, tea.Quit
        END IF
        IF key = "tab" THEN
            m.Focus = (m.Focus + 1) MOD 1
            RETURN m, NIL
        END IF
        IF key = "shift+tab" THEN
            m.Focus = m.Focus - 1
            IF m.Focus < 0 THEN m.Focus = 0
            RETURN m, NIL
        END IF
        IF m.Focus = 0 THEN
            _ = key
            RETURN m, NIL
        END IF
    END IF
    RETURN m, NIL
END FUNCTION

FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING
    DIM cr AS []STRING
    DIM ci AS INTEGER
    FOR ci = 0 TO h - 1
        cr = APPEND(cr, strings.Repeat(" ", w))
    NEXT ci
    RETURN strings.Join(cr, "\n")
END FUNCTION

SUB _formSize(m AS POINTER TO Model)
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    IF m._maximized THEN
        m._formW = w
        m._formH = h
    ELSE
        m._formW = (w)
        m._formH = (h)
    END IF
    IF m._formW < 3 THEN m._formW = 3
    IF m._formW > w THEN m._formW = w
    IF m._formH < 2 THEN m._formH = 2
    IF m._formH > h THEN m._formH = h
    IF m._minimized THEN m._formH = 1
END SUB

FUNCTION _formBox(fw AS INTEGER, fh AS INTEGER, gh AS STRING, gv AS STRING, tl AS STRING, tr AS STRING, bl AS STRING, br AS STRING, caption AS STRING, glyphs AS STRING) AS STRING
    DIM innerW AS INTEGER = fw - 2
    IF innerW < 0 THEN innerW = 0
    DIM cap AS STRING = ""
    IF caption <> "" THEN cap = " " + caption + " "
    DIM used AS INTEGER = lipgloss.Width(cap) + lipgloss.Width(glyphs)
    DIM fill AS INTEGER = innerW - used
    IF fill < 0 THEN fill = 0
    DIM out AS STRING = tl + cap + strings.Repeat(gh, fill) + glyphs + tr
    IF fh <= 1 THEN RETURN out
    DIM r AS INTEGER
    FOR r = 0 TO fh - 3
        out = out + "\n" + gv + strings.Repeat(" ", innerW) + gv
    NEXT r
    out = out + "\n" + bl + strings.Repeat(gh, innerW) + br
    RETURN out
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM w AS INTEGER = m.Width
    DIM h AS INTEGER = m.Height
    IF w < 60 THEN w = 80
    IF h < 20 THEN h = 24
    DIM fullView AS STRING = _blankCanvas(w, h)
    DIM cv0 AS STRING = cv_Render(78 + (m._formW - 80), 22 + (m._formH - 24))
    cv0 = lipgloss.NewStyle().Width(78 + (m._formW - 80)).Height(22 + (m._formH - 24)).Render(cv0)
    DIM ly0 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(cv0).X(1).Y(1).Z(10)
    DIM formBoxStr AS STRING = _formBox(m._formW, m._formH, "─", "│", "╭", "╮", "╰", "╯", "Split Pane Demo", "✕ ")
    DIM formLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(formBoxStr).X(0).Y(0).Z(1)
    IF m._minimized THEN
        DIM mBase AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
        DIM mCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(mBase, formLy)
        DIM mvw AS tea.View = tea.NewView(mCmp.Render())
        mvw.MouseMode = tea.MouseModeAllMotion
        mvw.AltScreen = TRUE
        RETURN mvw
    END IF
    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)
    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy, formLy, ly0)
    fullView = cmpLy.Render()
    DIM vw AS tea.View = tea.NewView(fullView)
    vw.MouseMode = tea.MouseModeAllMotion
    vw.AltScreen = TRUE
    RETURN vw
END FUNCTION

' _dbtuiRelaunchInTerminal — on Windows, relaunch this program inside
' Windows Terminal (wt.exe) at the form size, then exit. No-op when
' already inside Terminal, when wt.exe is missing, or off Windows.
SUB _dbtuiRelaunchInTerminal()
    IF runtime.GOOS <> "windows" THEN RETURN
    IF os.Getenv("WT_SESSION") <> "" THEN RETURN
    IF os.Getenv("DBTUI_IN_TERMINAL") <> "" THEN RETURN
    DIM _wt AS STRING
    DIM _e AS ERROR
    _wt, _e = exec.LookPath("wt.exe")
    IF _e <> NIL THEN RETURN
    DIM _self AS STRING
    _self, _e = os.Executable()
    IF _e <> NIL THEN RETURN
    DIM _c AS POINTER TO exec.Cmd = exec.Command(_wt, "--size", "80,24", "--title", "Split Pane Demo", _self)
    _c.Env = APPEND(os.Environ(), "DBTUI_IN_TERMINAL=1")
    _e = _c.Start()
    IF _e <> NIL THEN RETURN
    os.Exit(0)
END SUB

' _dbtuiApplyRequestedSize — honor a "--size cols,rows" argument by
' resizing the terminal (CSI 8;rows;cols t) before the UI starts.
SUB _dbtuiApplyRequestedSize()
    DIM _args AS []STRING = os.Args
    DIM _i AS INTEGER
    FOR _i = 1 TO LEN(_args) - 1
        IF _args[_i] = "--size" AND _i + 1 <= LEN(_args) - 1 THEN
            DIM _p AS []STRING = strings.Split(_args[_i + 1], ",")
            IF LEN(_p) = 2 THEN fmt.Print(Chr(27) + "[8;" + strings.TrimSpace(_p[1]) + ";" + strings.TrimSpace(_p[0]) + "t")
        END IF
    NEXT _i
END SUB

SUB Main()
    _dbtuiRelaunchInTerminal()
    _dbtuiApplyRequestedSize()
    DIM m AS Model
    m.Hover = 0 - 1
    m.HoverTab = 0 - 1
    _formSize(@m)
    Form_Load()
    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)
    _currentProgram = prog
    DIM final AS tea.Model
    DIM rerr AS ERROR
    final, rerr = prog.Run()
    IF rerr <> NIL THEN os.Exit(1)
    _ = final
END SUB

DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)
DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)

FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING
    IF focused THEN RETURN focusStyle.Render(v)
    IF hovered THEN RETURN hoverStyle.Render(v)
    RETURN v
END FUNCTION

' Generated dispatcher — routes a Button click to its user handler.
' When a Button has OnClickDialog set, the dialog's Show<Name>()
' fires first so the user doesn't have to wire it from code.
SUB dispatchClick(id AS STRING)
    _ = id
END SUB

' Generated dispatcher — routes a value change to its _Change handler.
SUB dispatchChange(id AS STRING)
    _ = id
END SUB

' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE =====
' Your code below — DBtui preserves everything here on F5.

' === splitpane_demo ========================================================
' A resizable split-pane layout — the shell of an IDE — drawn entirely on ONE
' full-form Canvas, with the splitter bars dragged via the raw Form_Mouse hook.
' This is exactly how DBtui's own window splitters work, so it proves the IDE
' shell is reproducible in generated DBasic.
'
' Layout: a VERTICAL splitter at canvas column gVx divides a left sidebar from
' a right region; a HORIZONTAL splitter at canvas row gHy divides that right
' region into an editor (top) and an output pane (bottom):
'
'     EXPLORER │ main.dbas
'              │----------- gHy
'              │ OUTPUT
'              ^gVx
'
' Dragging: the raw input hooks give us click + motion but NO release event,
' so we use a "grab / move / drop" model — click a bar to GRAB it, then either
' MOVE the mouse to slide it live and click to drop, or just click the new
' spot to jump the bar there and drop in one go. gGrab holds "" | "v" | "h".
'
' Canvas origin: the canvas sits at terminal cell (1,1) (just inside the form
' border) and the mouse hooks report 0-based terminal cells, so the canvas-
' local coordinate is (terminal - 1) on both axes.
DIM gVx AS INTEGER = 24      ' vertical splitter column   (canvas-local)
DIM gHy AS INTEGER = 11      ' horizontal splitter row    (canvas-local)
DIM gGrab AS STRING = ""     ' "" idle | "v" dragging vbar | "h" dragging hbar
DIM gW AS INTEGER = 78       ' last-rendered canvas size, for clamping
DIM gH AS INTEGER = 22

' --- content shown in each pane (static, just for show) -------------------

' NOTE: pane content is ASCII-only on purpose. Each row is space-padded to an
' exact COLUMN width with LEN(), which counts bytes — a multibyte glyph (▾, —)
' would undercount its display width and shove the splitter bar out of line.
FUNCTION sidebarLines() AS []STRING
    DIM xs AS []STRING
    xs = APPEND(xs, "v project")
    xs = APPEND(xs, "  v src")
    xs = APPEND(xs, "      main.dbas")
    xs = APPEND(xs, "      forms.dbas")
    xs = APPEND(xs, "      util.dbas")
    xs = APPEND(xs, "  README.md")
    xs = APPEND(xs, "  go.mod")
    RETURN xs
END FUNCTION

FUNCTION editorLines() AS []STRING
    DIM xs AS []STRING
    xs = APPEND(xs, "SUB Main()")
    xs = APPEND(xs, "    DIM name AS STRING = \"world\"")
    xs = APPEND(xs, "    PRINT \"Hello, \" + name + \"!\"")
    xs = APPEND(xs, "END SUB")
    RETURN xs
END FUNCTION

FUNCTION outputLines() AS []STRING
    DIM xs AS []STRING
    xs = APPEND(xs, "> dbasic build main.dbas")
    xs = APPEND(xs, "  build ok - 0 errors")
    xs = APPEND(xs, "")
    xs = APPEND(xs, "drag a bar: click=grab, move, click=drop")
    RETURN xs
END FUNCTION

' --- rendering helpers ----------------------------------------------------

' fitText — clip (by character count, not display width) or space-pad s to
' exactly width cells, so a background style paints a clean rectangle.
FUNCTION fitText(s AS STRING, width AS INTEGER) AS STRING
    IF width <= 0 THEN RETURN ""
    IF LEN(s) >= width THEN RETURN Left(s, width)
    RETURN s + strings.Repeat(" ", width - LEN(s))
END FUNCTION

' paneRow — render one row of a pane: row 0 is the (reverse-video) header
' showing title; later rows show body[row-1]. Everything fit to width.
FUNCTION paneRow(title AS STRING, body AS []STRING, row AS INTEGER, width AS INTEGER, hdr AS lipgloss.Style, fill AS lipgloss.Style) AS STRING
    IF row = 0 THEN
        RETURN hdr.Render(fitText(" " + title, width))
    END IF
    DIM bi AS INTEGER = row - 1
    DIM txt AS STRING = ""
    IF bi >= 0 AND bi < LEN(body) THEN txt = " " + body[bi]
    RETURN fill.Render(fitText(txt, width))
END FUNCTION

' Render for canvas cv — paint the four regions and the two splitter bars,
' clamping the bar positions to the current size first.
FUNCTION cv_Render(w AS INTEGER, h AS INTEGER) AS STRING
    gW = w
    gH = h

    ' Keep both bars on-screen with a minimum pane size on every side.
    gVx = clampVx(gVx)
    gHy = clampHy(gHy)

    ' Palette (tokyo-night-ish): each region gets its own background so the
    ' split is unmistakable; a grabbed bar lights up.
    DIM sideHdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#1a1b26")).Background(lipgloss.Color("#7aa2f7")).Bold(TRUE)
    DIM sideFill AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#c0caf5")).Background(lipgloss.Color("#1f2335"))
    DIM edHdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#1a1b26")).Background(lipgloss.Color("#9ece6a")).Bold(TRUE)
    DIM edFill AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#c0caf5")).Background(lipgloss.Color("#24283b"))
    DIM outHdr AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#1a1b26")).Background(lipgloss.Color("#e0af68")).Bold(TRUE)
    DIM outFill AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#a9b1d6")).Background(lipgloss.Color("#1a1b26")).Italic(TRUE)
    DIM barIdle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#565f89")).Background(lipgloss.Color("#16161e"))
    DIM barHot AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("#1a1b26")).Background(lipgloss.Color("#f7768e")).Bold(TRUE)

    DIM vStyle AS lipgloss.Style = barIdle
    IF gGrab = "v" THEN vStyle = barHot
    DIM hStyle AS lipgloss.Style = barIdle
    IF gGrab = "h" THEN hStyle = barHot

    DIM side AS []STRING = sidebarLines()
    DIM ed AS []STRING = editorLines()
    DIM outp AS []STRING = outputLines()

    DIM rightW AS INTEGER = w - gVx - 1
    IF rightW < 1 THEN rightW = 1

    DIM rows AS []STRING
    DIM y AS INTEGER
    FOR y = 0 TO h - 1
        ' Left sidebar spans the full height.
        DIM line AS STRING = paneRow("EXPLORER", side, y, gVx, sideHdr, sideFill)

        ' Vertical bar; a T-junction where the horizontal bar meets it.
        IF y = gHy THEN
            line = line + hStyle.Render("├")
        ELSE
            line = line + vStyle.Render("│")
        END IF

        ' Right region: editor above the horizontal bar, output below it.
        IF y < gHy THEN
            line = line + paneRow("main.dbas", ed, y, rightW, edHdr, edFill)
        ELSEIF y = gHy THEN
            line = line + hStyle.Render(strings.Repeat("─", rightW))
        ELSE
            line = line + paneRow("OUTPUT", outp, y - gHy - 1, rightW, outHdr, outFill)
        END IF

        rows = APPEND(rows, line)
    NEXT y
    RETURN strings.Join(rows, Chr(10))
END FUNCTION

' --- drag handling --------------------------------------------------------

' Left-click inside canvas cv — handled in Form_Mouse instead (it also sees
' motion events, which we need for dragging). Left intentionally empty.
SUB cv_Click(x AS INTEGER, y AS INTEGER)
    _ = x
    _ = y
END SUB

' Fired once at startup. Edit freely.
SUB Form_Load()
    ' Defaults are set on the globals above; nothing to do.
END SUB

' Fired whenever the TERMINAL size changes. cv_Render re-clamps the bars
' against the new size, so there is nothing to do here.
SUB Terminal_Resize(w AS INTEGER, h AS INTEGER)
    _ = w
    _ = h
END SUB

' Fired just before the program quits. Edit freely.
SUB Form_Close()
    ' TODO: your code here.
END SUB

' Fired on the UI thread after a background goroutine calls _dbtuiWake().
SUB Form_Wake()
    ' TODO: your code here.
END SUB

' Fired for every key press. The editor demo handles keys; here we only need
' the mouse, so keys fall through to the built-in chrome (tab/esc/ctrl+c).
SUB Form_Key(key AS STRING)
    _ = key
END SUB

' Fired for every mouse event. We implement splitter dragging with a
' grab/move/drop model (no release event is delivered):
'   click on a bar -> grab it;  move -> slide the grabbed bar;  click -> drop.
SUB Form_Mouse(kind AS STRING, button AS STRING, x AS INTEGER, y AS INTEGER)
    _ = button
    ' Convert terminal cells to canvas-local (canvas origin is at (1,1)).
    DIM lx AS INTEGER = x - 1
    DIM ly AS INTEGER = y - 1

    IF kind = "click" THEN
        IF gGrab = "v" THEN
            ' Already holding the vertical bar — jump it here and drop.
            gVx = clampVx(lx)
            gGrab = ""
        ELSEIF gGrab = "h" THEN
            gHy = clampHy(ly)
            gGrab = ""
        ELSEIF lx = gVx THEN
            ' Clicked the vertical bar — grab it.
            gGrab = "v"
        ELSEIF ly = gHy AND lx > gVx THEN
            ' Clicked the horizontal bar (right region only) — grab it.
            gGrab = "h"
        END IF
        RETURN
    END IF

    IF kind = "motion" THEN
        IF gGrab = "v" THEN
            gVx = clampVx(lx)
        ELSEIF gGrab = "h" THEN
            gHy = clampHy(ly)
        END IF
        RETURN
    END IF
END SUB

' clampVx / clampHy — keep a splitter on-screen with a minimum pane on each
' side. Shared by cv_Render and the drag handler so the limits never diverge.
FUNCTION clampVx(v AS INTEGER) AS INTEGER
    IF v < 10 THEN v = 10
    IF v > gW - 14 THEN v = gW - 14
    RETURN v
END FUNCTION

FUNCTION clampHy(v AS INTEGER) AS INTEGER
    IF v < 2 THEN v = 2
    IF v > gH - 3 THEN v = gH - 3
    RETURN v
END FUNCTION
