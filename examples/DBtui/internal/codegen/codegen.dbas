' DBtui — internal/codegen/codegen.dbas
'
' Codegen — turns a Project into a runnable DBasic source file. The
' generated program imports bubbletea + lipgloss and renders each
' widget as a styled box layered at its (X, Y) position via lipgloss
' Compositor. Tab cycles focus among TabStop widgets; q / Ctrl+C
' quits.
'
' Event-handler bodies are stubbed out (status-line echoes) — real
' user code lands when the code editor is wired. The output file
' compiles cleanly with `dbasic build <out>.dbas`.

IMPORT "fmt"
IMPORT "os"
IMPORT "strings"

' dbasBool returns the DBasic-source form of a Boolean.
FUNCTION dbasBool(b AS BOOLEAN) AS STRING
    IF b THEN RETURN "TRUE"
    RETURN "FALSE"
END FUNCTION

' dbasStr returns a DBasic-syntax quoted string literal — escapes the
' contents so a string like a"b\nc emits "a\"b\\nc". Implemented by
' hand because fmt.Sprintf("%q", …) emits Go-style which is *almost*
' the same but uses backtick raw strings sometimes.
FUNCTION dbasStr(s AS STRING) AS STRING
    DIM out AS STRING = "\""
    DIM i AS INTEGER
    FOR i = 1 TO LEN(s)
        DIM c AS STRING = Mid(s, i, 1)
        IF c = "\"" THEN
            out = out + "\\\""
        ELSEIF c = "\\" THEN
            out = out + "\\\\"
        ELSEIF c = "\n" THEN
            out = out + "\\n"
        ELSEIF c = "\r" THEN
            out = out + "\\r"
        ELSEIF c = "\t" THEN
            out = out + "\\t"
        ELSE
            out = out + c
        END IF
    NEXT i
    RETURN out + "\""
END FUNCTION

' readUserCode loads form.Code from disk. Returns "" if the path is
' empty or the file doesn't exist — codegen still produces a runnable
' program in that case (just with no user handlers).
FUNCTION readUserCode(codePath AS STRING) AS STRING
    IF codePath = "" THEN RETURN ""
    DIM data AS BYTES
    DIM err AS ERROR
    data, err = os.ReadFile(codePath)
    IF err <> NIL THEN RETURN ""
    RETURN string(data)
END FUNCTION

' findDefinedSubs scans the user's code and returns the names of all
' top-level SUB / FUNCTION definitions. Used so we don't emit a stub
' that collides with a sub the user has already written.
'
' Match rule: a line whose trimmed prefix is `SUB ` or `FUNCTION `
' followed by a bare identifier (no leading "(") and a "(" within
' a few tokens. Skips method declarations like `SUB (m AS Model) X()`.
FUNCTION findDefinedSubs(code AS STRING) AS []STRING
    DIM out AS []STRING
    DIM lines AS []STRING = strings.Split(code, "\n")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        DIM line AS STRING = strings.TrimSpace(lines[i])
        DIM upper AS STRING = strings.ToUpper(line)
        DIM nameStart AS INTEGER = -1
        IF strings.HasPrefix(upper, "SUB ") THEN nameStart = 4
        IF strings.HasPrefix(upper, "FUNCTION ") THEN nameStart = 9
        IF nameStart < 0 THEN
            ' not a sub/function line — skip
        ELSE
            DIM rest AS STRING = strings.TrimSpace(Mid(line, nameStart + 1, LEN(line) - nameStart))
            IF strings.HasPrefix(rest, "(") THEN
                ' method receiver — skip
            ELSE
                DIM parenPos AS INTEGER = strings.Index(rest, "(")
                DIM spacePos AS INTEGER = strings.Index(rest, " ")
                DIM cut AS INTEGER = parenPos
                IF spacePos >= 0 AND (cut < 0 OR spacePos < cut) THEN cut = spacePos
                IF cut >= 0 THEN rest = Mid(rest, 1, cut)
                DIM nm AS STRING = strings.TrimSpace(rest)
                IF nm <> "" THEN out = APPEND(out, nm)
            END IF
        END IF
    NEXT i
    RETURN out
END FUNCTION

FUNCTION subDefined(name AS STRING, defined AS []STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(defined) - 1
        IF strings.EqualFold(defined[i], name) THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' emitDispatchClick writes the SUB that routes a button's Id to its
' user handler. Generated as one big IF cascade (DBasic doesn't have
' map literals so a switch on strings is the cheapest path).
FUNCTION emitDispatchClick(form AS Form) AS STRING
    DIM s AS STRING = "SUB dispatchClick(id AS STRING)\n"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        IF w.Kind = WidgetKindButton THEN
            s = s + fmt.Sprintf("    IF id = %s THEN %s_Click()\n", dbasStr(w.Id), w.Id)
        END IF
    NEXT i
    s = s + "END SUB\n\n"
    RETURN s
END FUNCTION

' kindHasChange returns TRUE for widget kinds that emit a `_Change`
' event when their state mutates at runtime (toggle / cycle / slide).
FUNCTION kindHasChange(kind AS STRING) AS BOOLEAN
    IF kind = WidgetKindTextInput   THEN RETURN TRUE
    IF kind = WidgetKindCheckbox    THEN RETURN TRUE
    IF kind = WidgetKindRadioButton THEN RETURN TRUE
    IF kind = WidgetKindComboBox    THEN RETURN TRUE
    IF kind = WidgetKindListBox     THEN RETURN TRUE
    IF kind = WidgetKindScrollBar   THEN RETURN TRUE
    IF kind = WidgetKindTabStrip    THEN RETURN TRUE
    IF kind = WidgetKindScrollPane  THEN RETURN TRUE
    IF kind = WidgetKindTreeView    THEN RETURN TRUE
    IF kind = WidgetKindTextArea    THEN RETURN TRUE
    IF kind = WidgetKindPropertyGrid THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' emitDispatchChange writes a SUB that routes a widget's Id to its
' user-defined `<id>_Change()` handler. Mirrors emitDispatchClick.
FUNCTION emitDispatchChange(form AS Form) AS STRING
    DIM s AS STRING = "SUB dispatchChange(id AS STRING)\n"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        IF kindHasChange(w.Kind) THEN
            s = s + fmt.Sprintf("    IF id = %s THEN %s_Change()\n", dbasStr(w.Id), w.Id)
        END IF
    NEXT i
    s = s + "END SUB\n\n"
    RETURN s
END FUNCTION

' emitSetFocus writes the helper that transitions focus, handling
' Blur/Focus on TextInput widgets so the cursor follows.
FUNCTION emitSetFocus() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION focusableIdxAt(m AS Model, focusIdx AS INTEGER) AS INTEGER\n"
    s = s + "    DIM fc AS INTEGER = 0\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[i].TStop AND m.Widgets[i].Visi THEN\n"
    s = s + "            IF fc = focusIdx THEN RETURN i\n"
    s = s + "            fc = fc + 1\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN -1\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION setFocus(m AS POINTER TO Model, newFocus AS INTEGER) AS tea.Cmd\n"
    s = s + "    DIM oldIdx AS INTEGER = focusableIdxAt(^m, m.Focus)\n"
    s = s + "    IF oldIdx >= 0 AND m.Widgets[oldIdx].Kind = \"TextInput\" THEN\n"
    s = s + "        m.Widgets[oldIdx].TiModel.Blur()\n"
    s = s + "    END IF\n"
    s = s + "    IF oldIdx >= 0 AND m.Widgets[oldIdx].Kind = \"TextArea\" THEN\n"
    s = s + "        m.Widgets[oldIdx].TaModel.Blur()\n"
    s = s + "    END IF\n"
    s = s + "    m.Focus = newFocus\n"
    s = s + "    DIM newIdx AS INTEGER = focusableIdxAt(^m, m.Focus)\n"
    ' Generic per-selection hook — fires whenever focus lands on a
    ' widget (via Tab, click, or programmatic focus). Lets user code
    ' react to clicks on widgets added at runtime via gAddWidget
    ' (which have no codegen-time _Click handler).
    s = s + "    IF newIdx >= 0 THEN gOnSelect(m.Widgets[newIdx].Id)\n"
    s = s + "    IF newIdx >= 0 AND m.Widgets[newIdx].Kind = \"TextInput\" THEN\n"
    s = s + "        RETURN m.Widgets[newIdx].TiModel.Focus()\n"
    s = s + "    END IF\n"
    s = s + "    IF newIdx >= 0 AND m.Widgets[newIdx].Kind = \"TextArea\" THEN\n"
    s = s + "        RETURN m.Widgets[newIdx].TaModel.Focus()\n"
    s = s + "    END IF\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitSelectRadio writes the helper that handles radio-group exclusivity.
' Called when a RadioButton is toggled — sets the target Checked=TRUE
' and clears all other RadioButtons sharing its Group.
FUNCTION emitSelectRadio() AS STRING
    DIM s AS STRING = ""
    s = s + "SUB selectRadio(m AS POINTER TO Model, idx AS INTEGER)\n"
    s = s + "    IF idx < 0 OR idx >= LEN(m.Widgets) THEN RETURN\n"
    s = s + "    IF m.Widgets[idx].Kind <> \"RadioButton\" THEN RETURN\n"
    s = s + "    DIM g AS STRING = m.Widgets[idx].Group\n"
    s = s + "    DIM j AS INTEGER\n"
    s = s + "    FOR j = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[j].Kind = \"RadioButton\" AND m.Widgets[j].Group = g THEN\n"
    s = s + "            m.Widgets[j].Checked = (j = idx)\n"
    s = s + "        END IF\n"
    s = s + "    NEXT j\n"
    s = s + "END SUB\n\n"
    RETURN s
END FUNCTION

' emitTreeHelper writes the helper that flattens a TreeView's stored
' "depth|state|label" entries into a *visible* row list — children of a
' "-" (collapsed) node are skipped. Returns parallel arrays: the
' visible entries and their absolute indices into the source list.
' Used by both renderOneWidget and the Update key/click handlers.
FUNCTION emitTreeHelper() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION treeVisible(items AS STRING) AS ([]STRING, []INTEGER)\n"
    s = s + "    DIM all AS []STRING = strings.Split(items, \";\")\n"
    s = s + "    DIM vis AS []STRING\n"
    s = s + "    DIM idx AS []INTEGER\n"
    s = s + "    DIM skipDepth AS INTEGER = -1\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(all) - 1\n"
    s = s + "        DIM ent AS STRING = all[i]\n"
    s = s + "        IF ent <> \"\" THEN\n"
    s = s + "            DIM parts AS []STRING = strings.SplitN(ent, \"|\", 3)\n"
    s = s + "            IF LEN(parts) >= 3 THEN\n"
    s = s + "                DIM d AS INTEGER = 0\n"
    s = s + "                DIM derr AS ERROR\n"
    s = s + "                d, derr = strconv.Atoi(parts[0])\n"
    s = s + "                _ = derr\n"
    s = s + "                DIM keepRow AS BOOLEAN = TRUE\n"
    s = s + "                IF skipDepth >= 0 THEN\n"
    s = s + "                    IF d > skipDepth THEN\n"
    s = s + "                        keepRow = FALSE\n"
    s = s + "                    ELSE\n"
    s = s + "                        skipDepth = -1\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "                IF keepRow THEN\n"
    s = s + "                    vis = APPEND(vis, ent)\n"
    s = s + "                    idx = APPEND(idx, i)\n"
    s = s + "                    IF parts[1] = \"-\" THEN skipDepth = d\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN vis, idx\n"
    s = s + "END FUNCTION\n\n"
    ' treeToggle flips the state of the entry at absolute index `abs`.
    ' "+" → "-" and vice versa. Leaf "*" entries are left unchanged.
    ' Mutates items in place and returns the new string.
    s = s + "FUNCTION treeToggle(items AS STRING, abs AS INTEGER) AS STRING\n"
    s = s + "    DIM all AS []STRING = strings.Split(items, \";\")\n"
    s = s + "    IF abs < 0 OR abs >= LEN(all) THEN RETURN items\n"
    s = s + "    DIM parts AS []STRING = strings.SplitN(all[abs], \"|\", 3)\n"
    s = s + "    IF LEN(parts) < 3 THEN RETURN items\n"
    s = s + "    DIM oldState AS STRING = parts[1]\n"
    s = s + "    IF oldState = \"+\" THEN parts[1] = \"-\"\n"
    s = s + "    IF oldState = \"-\" THEN parts[1] = \"+\"\n"
    s = s + "    all[abs] = parts[0] + \"|\" + parts[1] + \"|\" + parts[2]\n"
    s = s + "    RETURN strings.Join(all, \";\")\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitPropertyGridHelpers writes runtime helpers for PropertyGrid:
'   pgSetRowValue — update the Value field of the row at the given
'                   absolute index; re-encodes the row list.
'   pgEnumCycle   — given a "enum:a:b:c" type and current value,
'                   return the next (or prev when dir<0) option.
FUNCTION emitPropertyGridHelpers() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION pgSetRowValue(items AS STRING, absIdx AS INTEGER, newVal AS STRING) AS STRING\n"
    s = s + "    DIM all AS []STRING = strings.Split(items, \";\")\n"
    s = s + "    IF absIdx < 0 OR absIdx >= LEN(all) THEN RETURN items\n"
    s = s + "    DIM parts AS []STRING = strings.SplitN(all[absIdx], \"|\", 4)\n"
    s = s + "    DO WHILE LEN(parts) < 4\n"
    s = s + "        parts = APPEND(parts, \"\")\n"
    s = s + "    LOOP\n"
    s = s + "    parts[2] = newVal\n"
    s = s + "    all[absIdx] = parts[0] + \"|\" + parts[1] + \"|\" + parts[2] + \"|\" + parts[3]\n"
    s = s + "    RETURN strings.Join(all, \";\")\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION pgEnumCycle(typeStr AS STRING, cur AS STRING, dir AS INTEGER) AS STRING\n"
    s = s + "    IF NOT strings.HasPrefix(typeStr, \"enum:\") THEN RETURN cur\n"
    s = s + "    DIM rest AS STRING = strings.TrimPrefix(typeStr, \"enum:\")\n"
    s = s + "    DIM opts AS []STRING = strings.Split(rest, \":\")\n"
    s = s + "    IF LEN(opts) = 0 THEN RETURN cur\n"
    s = s + "    DIM idx AS INTEGER = -1\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(opts) - 1\n"
    s = s + "        IF opts[i] = cur THEN idx = i\n"
    s = s + "    NEXT i\n"
    s = s + "    IF idx < 0 THEN RETURN opts[0]\n"
    s = s + "    DIM nxt AS INTEGER = idx + dir\n"
    s = s + "    IF nxt < 0 THEN nxt = LEN(opts) - 1\n"
    s = s + "    IF nxt >= LEN(opts) THEN nxt = 0\n"
    s = s + "    RETURN opts[nxt]\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitMenuHelpers writes the helpers for the MenuBar widget. menuParse
' returns parallel arrays of menu labels + their item-segments (each
' item-segment is the unparsed ",-joined item list for that menu).
' menuItems splits one menu's items into label+action arrays.
FUNCTION emitMenuHelpers() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION menuParse(items AS STRING) AS ([]STRING, []STRING)\n"
    s = s + "    DIM menus AS []STRING = strings.Split(items, \";\")\n"
    s = s + "    DIM labels AS []STRING\n"
    s = s + "    DIM raw AS []STRING\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(menus) - 1\n"
    s = s + "        IF menus[i] <> \"\" THEN\n"
    s = s + "            DIM parts AS []STRING = strings.SplitN(menus[i], \"|\", 2)\n"
    s = s + "            labels = APPEND(labels, parts[0])\n"
    s = s + "            DIM rawItems AS STRING = \"\"\n"
    s = s + "            IF LEN(parts) > 1 THEN rawItems = parts[1]\n"
    s = s + "            raw = APPEND(raw, rawItems)\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN labels, raw\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION menuItems(raw AS STRING) AS ([]STRING, []STRING)\n"
    s = s + "    DIM lst AS []STRING = strings.Split(raw, \",\")\n"
    s = s + "    DIM labs AS []STRING\n"
    s = s + "    DIM acts AS []STRING\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(lst) - 1\n"
    s = s + "        DIM e AS STRING = lst[i]\n"
    s = s + "        IF e = \"-\" THEN\n"
    s = s + "            labs = APPEND(labs, \"-\")\n"
    s = s + "            acts = APPEND(acts, \"\")\n"
    s = s + "        ELSEIF e <> \"\" THEN\n"
    s = s + "            DIM p AS []STRING = strings.SplitN(e, \":\", 2)\n"
    s = s + "            labs = APPEND(labs, p[0])\n"
    s = s + "            DIM a AS STRING = \"\"\n"
    s = s + "            IF LEN(p) > 1 THEN a = p[1]\n"
    s = s + "            acts = APPEND(acts, a)\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN labs, acts\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitDispatchMenuAction writes the SUB that routes (menubarId, action)
' to the user's <menubarId>_Action(action) handler.
FUNCTION emitDispatchMenuAction(form AS Form) AS STRING
    DIM s AS STRING = "SUB dispatchMenuAction(id AS STRING, action AS STRING)\n"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        IF w.Kind = WidgetKindMenuBar OR w.Kind = WidgetKindToolbar THEN
            s = s + "    IF id = " + dbasStr(w.Id) + " THEN " + w.Id + "_Action(action)\n"
        END IF
    NEXT i
    s = s + "    _ = action\n"
    s = s + "END SUB\n\n"
    ' openPendingDialog observes the package-level gPendingDialog that
    ' user SUBs set when calling <toolId>_Show(). Returns TRUE if a
    ' dialog was opened so the caller can stop further processing.
    s = s + "FUNCTION openPendingDialog(m AS POINTER TO Model) AS BOOLEAN\n"
    s = s + "    IF gPendingDialog = \"\" THEN RETURN FALSE\n"
    s = s + "    DIM j AS INTEGER\n"
    s = s + "    FOR j = 0 TO LEN(m.Tools) - 1\n"
    s = s + "        IF m.Tools[j].Id = gPendingDialog THEN\n"
    s = s + "            m.DialogToolId = gPendingDialog\n"
    s = s + "            m.Dialog.Open(m.Tools[j].Title, m.Tools[j].Mode, m.Tools[j].Mask, \"\", m.Width, m.Height)\n"
    s = s + "            gPendingDialog = \"\"\n"
    s = s + "            RETURN TRUE\n"
    s = s + "        END IF\n"
    s = s + "    NEXT j\n"
    s = s + "    gPendingDialog = \"\"\n"
    s = s + "    RETURN FALSE\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitStubs writes empty SUB stubs for any expected event handler the
' user hasn't defined yet. Keeps the generated program compilable even
' when the form has handlers wired but the .dbas code hasn't caught up.
FUNCTION emitStubs(form AS Form, defined AS []STRING) AS STRING
    DIM s AS STRING = ""
    DIM emitted AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        IF w.Kind = WidgetKindButton THEN
            DIM nm AS STRING = w.Id + "_Click"
            IF NOT subDefined(nm, defined) THEN
                IF NOT emitted THEN
                    s = s + "' Auto-stubs for handlers not yet defined in the form's code file.\n"
                    s = s + "' Open the form in DBtui (F7 = Code Editor) to fill them in.\n"
                    emitted = TRUE
                END IF
                s = s + "SUB " + nm + "()\n"
                s = s + "END SUB\n\n"
            END IF
        END IF
        IF kindHasChange(w.Kind) THEN
            DIM cnm AS STRING = w.Id + "_Change"
            IF NOT subDefined(cnm, defined) THEN
                IF NOT emitted THEN
                    s = s + "' Auto-stubs for handlers not yet defined in the form's code file.\n"
                    s = s + "' Open the form in DBtui (F7 = Code Editor) to fill them in.\n"
                    emitted = TRUE
                END IF
                s = s + "SUB " + cnm + "()\n"
                s = s + "END SUB\n\n"
            END IF
        END IF
        IF w.Kind = WidgetKindMenuBar OR w.Kind = WidgetKindToolbar THEN
            DIM mnm AS STRING = w.Id + "_Action"
            IF NOT subDefined(mnm, defined) THEN
                IF NOT emitted THEN
                    s = s + "' Auto-stubs for handlers not yet defined in the form's code file.\n"
                    s = s + "' Open the form in DBtui (F7 = Code Editor) to fill them in.\n"
                    emitted = TRUE
                END IF
                s = s + "SUB " + mnm + "(action AS STRING)\n"
                s = s + "    _ = action\n"
                s = s + "END SUB\n\n"
            END IF
        END IF
    NEXT i
    ' Generic per-click hook — auto-stubbed empty if the user code
    ' doesn't define it. Called from the mouse hit-test for every
    ' successful click, regardless of widget kind. Useful for
    ' reacting to clicks on widgets added at runtime via gAddWidget.
    IF NOT subDefined("gOnSelect", defined) THEN
        s = s + "SUB gOnSelect(id AS STRING)\n"
        s = s + "    _ = id\n"
        s = s + "END SUB\n\n"
    END IF
    RETURN s
END FUNCTION

' getIntProp pulls an INTEGER value out of a WidgetEntry.Properties map.
' Falls back to DOUBLE → INTEGER coercion because encoding/json parses
' all JSON numbers into interface{} as float64.
FUNCTION getIntProp(t AS WidgetEntry, key AS STRING) AS (INTEGER, BOOLEAN)
    DIM v AS ANY = t.Properties[key]
    IF v = NIL THEN RETURN 0, FALSE
    DIM iv AS INTEGER
    DIM iOk AS BOOLEAN
    iv, iOk = v.(INTEGER)
    IF iOk THEN RETURN iv, TRUE
    DIM dv AS DOUBLE
    DIM dOk AS BOOLEAN
    dv, dOk = v.(DOUBLE)
    IF dOk THEN RETURN Int(dv), TRUE
    RETURN 0, FALSE
END FUNCTION

' getBoolProp pulls a BOOLEAN from the Properties map.
FUNCTION getBoolProp(t AS WidgetEntry, key AS STRING) AS (BOOLEAN, BOOLEAN)
    DIM v AS ANY = t.Properties[key]
    IF v = NIL THEN RETURN FALSE, FALSE
    DIM bv AS BOOLEAN
    DIM bOk AS BOOLEAN
    bv, bOk = v.(BOOLEAN)
    IF bOk THEN RETURN bv, TRUE
    RETURN FALSE, FALSE
END FUNCTION

' getStrProp pulls a STRING value out of a WidgetEntry.Properties map.
' Returns the empty string if the key isn't present or isn't a STRING.
FUNCTION getStrProp(e AS WidgetEntry, key AS STRING) AS STRING
    DIM v AS ANY = e.Properties[key]
    IF v = NIL THEN RETURN ""
    DIM s AS STRING
    DIM ok AS BOOLEAN
    s, ok = v.(STRING)
    IF NOT ok THEN RETURN ""
    RETURN s
END FUNCTION

' emitHeader writes the file banner + imports + WState/Model TYPEs.
FUNCTION emitHeader(p AS Project) AS STRING
    DIM s AS STRING = ""
    s = s + "' Generated by DBtui from " + p.Name + ".dbproj — do not edit by hand.\n"
    s = s + "' Re-run `DBtui gen " + p.Name + ".dbproj` to regenerate.\n\n"
    s = s + "IMPORT \"charm.land/bubbletea/v2\" AS tea\n"
    s = s + "IMPORT \"charm.land/lipgloss/v2\" AS lipgloss\n"
    s = s + "IMPORT \"charm.land/bubbles/v2/textinput\" AS textinput\n"
    s = s + "IMPORT \"charm.land/bubbles/v2/textarea\" AS textarea\n"
    s = s + "IMPORT \"encoding/json\" AS encjson\n"
    s = s + "IMPORT \"fmt\"\n"
    s = s + "IMPORT \"os\"\n"
    s = s + "IMPORT \"path/filepath\"\n"
    s = s + "IMPORT \"sort\"\n"
    s = s + "IMPORT \"strconv\"\n"
    s = s + "IMPORT \"strings\"\n\n"
    s = s + "TYPE WState\n"
    s = s + "    DIM Id       AS STRING\n"
    s = s + "    DIM Kind     AS STRING\n"
    s = s + "    DIM X        AS INTEGER\n"
    s = s + "    DIM Y        AS INTEGER\n"
    s = s + "    DIM W        AS INTEGER\n"
    s = s + "    DIM H        AS INTEGER\n"
    s = s + "    DIM Text     AS STRING\n"
    s = s + "    DIM Val      AS STRING\n"
    s = s + "    DIM Holdr    AS STRING\n"
    s = s + "    DIM Visi     AS BOOLEAN\n"
    s = s + "    DIM TStop    AS BOOLEAN\n"
    s = s + "    DIM TIdx     AS INTEGER\n"
    s = s + "    DIM BgColor  AS STRING\n"
    s = s + "    DIM FgColor  AS STRING\n"
    s = s + "    DIM Checked  AS BOOLEAN\n"
    s = s + "    DIM Items    AS STRING\n"
    s = s + "    DIM Selected AS INTEGER\n"
    s = s + "    DIM Group    AS STRING\n"
    s = s + "    DIM RngMin   AS INTEGER\n"
    s = s + "    DIM RngMax   AS INTEGER\n"
    s = s + "    DIM RngValue AS INTEGER\n"
    s = s + "    DIM Horizontal AS BOOLEAN\n"
    s = s + "    DIM Title    AS STRING\n"
    s = s + "    DIM Offset   AS INTEGER\n"
    s = s + "    DIM TiModel  AS textinput.Model\n"
    s = s + "    DIM TaModel  AS textarea.Model\n"
    ' When TRUE, clicks on this widget start a move-drag — the runtime
    ' tracks the cursor delta and updates X/Y until release.
    s = s + "    DIM Draggable AS BOOLEAN\n"
    s = s + "END TYPE\n\n"
    s = s + "TYPE ToolCfg\n"
    s = s + "    DIM Id    AS STRING\n"
    s = s + "    DIM Kind  AS STRING\n"
    s = s + "    DIM Mode  AS STRING\n"
    s = s + "    DIM Mask  AS STRING\n"
    s = s + "    DIM Title AS STRING\n"
    s = s + "END TYPE\n\n"
    s = s + "TYPE Model\n"
    s = s + "    DIM Width        AS INTEGER\n"
    s = s + "    DIM Height       AS INTEGER\n"
    s = s + "    DIM Focus        AS INTEGER\n"
    s = s + "    DIM Widgets      AS []WState\n"
    s = s + "    DIM Tools        AS []ToolCfg\n"
    s = s + "    DIM DialogToolId AS STRING\n"
    s = s + "    DIM Dialog       AS FileDialog\n"
    ' ScrollBar drag state — set on mouse-down on a thumb, cleared on
    ' release; while active, MouseMotionMsg updates the bar's RngValue.
    s = s + "    DIM DragScroll   AS BOOLEAN\n"
    s = s + "    DIM DragIdx      AS INTEGER\n"
    ' ComboBox dropdown state — set when a ComboBox is clicked; while
    ' active, the dropdown overlay renders and intercepts arrow/Enter/Esc.
    s = s + "    DIM DropActive   AS BOOLEAN\n"
    s = s + "    DIM DropIdx      AS INTEGER\n"
    s = s + "    DIM DropCursor   AS INTEGER\n"
    ' PropertyGrid edit-mode state — when PgEdit is TRUE the keystroke
    ' handler routes printable keys into PgEditBuf instead of normal nav.
    s = s + "    DIM PgEdit       AS BOOLEAN\n"
    s = s + "    DIM PgEditIdx    AS INTEGER\n"
    s = s + "    DIM PgEditRow    AS INTEGER\n"
    s = s + "    DIM PgEditBuf    AS STRING\n"
    s = s + "    DIM PgEditPos    AS INTEGER\n"
    ' Move-drag state — set on click of a Draggable widget; while
    ' active, MouseMotion shifts the widget's X/Y by the cursor delta.
    s = s + "    DIM DragMove     AS BOOLEAN\n"
    s = s + "    DIM DragMoveIdx  AS INTEGER\n"
    s = s + "    DIM DragMoveSMX  AS INTEGER\n"
    s = s + "    DIM DragMoveSMY  AS INTEGER\n"
    s = s + "    DIM DragMoveOX   AS INTEGER\n"
    s = s + "    DIM DragMoveOY   AS INTEGER\n"
    s = s + "END TYPE\n\n"
    ' Package-level pending request — user SUBs set this when they
    ' call <id>_Show(); the next Update tick observes it and switches
    ' to dialog mode.
    s = s + "DIM gPendingDialog AS STRING\n\n"
    ' Package-level Model pointer — Update sets gM = @m on every tick.
    ' Accessor helpers (gGetText, gSetItems, etc.) read/mutate widget
    ' state through this pointer so user SUBs can affect other widgets.
    s = s + "DIM gM AS POINTER TO Model\n\n"
    RETURN s
END FUNCTION

' emitWidgetAccessors writes the package-level helpers that user code
' uses to query / mutate widget state from inside _Change / _Click /
' _Action handlers. All helpers no-op if gM is NIL (called outside
' the Update tick) or the id doesn't match a widget.
FUNCTION emitWidgetAccessors() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION gWidgetIdx(id AS STRING) AS INTEGER\n"
    s = s + "    IF gM = NIL THEN RETURN -1\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(gM.Widgets) - 1\n"
    s = s + "        IF gM.Widgets[i].Id = id THEN RETURN i\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN -1\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION gGetText(id AS STRING) AS STRING\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[i].Text\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetText(id AS STRING, text AS STRING)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Text = text\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gGetItems(id AS STRING) AS STRING\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[i].Items\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetItems(id AS STRING, items AS STRING)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Items = items\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gGetSelected(id AS STRING) AS INTEGER\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN -1\n"
    s = s + "    RETURN gM.Widgets[i].Selected\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetSelected(id AS STRING, sel AS INTEGER)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Selected = sel\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gGetTitle(id AS STRING) AS STRING\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[i].Title\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetTitle(id AS STRING, title AS STRING)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Title = title\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gGetVisible(id AS STRING) AS BOOLEAN\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN FALSE\n"
    s = s + "    RETURN gM.Widgets[i].Visi\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetVisible(id AS STRING, vis AS BOOLEAN)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Visi = vis\n"
    s = s + "END SUB\n\n"
    s = s + "SUB gSetDraggable(id AS STRING, drag AS BOOLEAN)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Draggable = drag\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gGetValue(id AS STRING) AS STRING\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[i].Val\n"
    s = s + "END FUNCTION\n\n"
    s = s + "SUB gSetValue(id AS STRING, val AS STRING)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].Val = val\n"
    s = s + "END SUB\n\n"
    s = s + "SUB gSetXY(id AS STRING, x AS INTEGER, y AS INTEGER)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].X = x\n"
    s = s + "    gM.Widgets[i].Y = y\n"
    s = s + "END SUB\n\n"
    s = s + "SUB gSetSize(id AS STRING, w AS INTEGER, h AS INTEGER)\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN\n"
    s = s + "    gM.Widgets[i].W = w\n"
    s = s + "    gM.Widgets[i].H = h\n"
    s = s + "END SUB\n\n"
    s = s + "FUNCTION gWidgetCount() AS INTEGER\n"
    s = s + "    IF gM = NIL THEN RETURN 0\n"
    s = s + "    RETURN LEN(gM.Widgets)\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION gWidgetIdAt(idx AS INTEGER) AS STRING\n"
    s = s + "    IF gM = NIL THEN RETURN \"\"\n"
    s = s + "    IF idx < 0 OR idx >= LEN(gM.Widgets) THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[idx].Id\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION gWidgetKindAt(idx AS INTEGER) AS STRING\n"
    s = s + "    IF gM = NIL THEN RETURN \"\"\n"
    s = s + "    IF idx < 0 OR idx >= LEN(gM.Widgets) THEN RETURN \"\"\n"
    s = s + "    RETURN gM.Widgets[idx].Kind\n"
    s = s + "END FUNCTION\n\n"
    ' gAddWidget appends a new widget with kind-appropriate defaults.
    ' Returns the index in m.Widgets, or -1 if id is already taken or
    ' the kind is unknown.
    s = s + "FUNCTION gAddWidget(kind AS STRING, id AS STRING, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER) AS INTEGER\n"
    s = s + "    IF gM = NIL THEN RETURN -1\n"
    s = s + "    IF gWidgetIdx(id) >= 0 THEN RETURN -1\n"
    s = s + "    DIM ws AS WState\n"
    s = s + "    ws.Id = id\n"
    s = s + "    ws.Kind = kind\n"
    s = s + "    ws.X = x\n"
    s = s + "    ws.Y = y\n"
    s = s + "    ws.W = w\n"
    s = s + "    ws.H = h\n"
    s = s + "    ws.Visi = TRUE\n"
    s = s + "    ws.BgColor = \"#1a1b2e\"\n"
    s = s + "    ws.FgColor = \"#e0def4\"\n"
    s = s + "    ws.Selected = -1\n"
    ' Sensible per-kind defaults: TStop, Text, Items, ranges, etc.
    s = s + "    IF kind = \"Button\" OR kind = \"Label\" OR kind = \"Checkbox\" OR kind = \"RadioButton\" THEN\n"
    s = s + "        ws.Text = kind\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"Button\" OR kind = \"TextInput\" OR kind = \"TextArea\" OR kind = \"Checkbox\" OR kind = \"RadioButton\" OR kind = \"ComboBox\" OR kind = \"ListBox\" OR kind = \"ScrollBar\" OR kind = \"TabStrip\" OR kind = \"ScrollPane\" OR kind = \"TreeView\" OR kind = \"PropertyGrid\" OR kind = \"MenuBar\" THEN\n"
    s = s + "        ws.TStop = TRUE\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"ComboBox\" OR kind = \"ListBox\" THEN\n"
    s = s + "        ws.Items = \"Option 1;Option 2;Option 3\"\n"
    s = s + "        ws.Selected = 0\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"TabStrip\" THEN\n"
    s = s + "        ws.Items = \"Tab 1;Tab 2\"\n"
    s = s + "        ws.Selected = 0\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"ScrollPane\" THEN\n"
    s = s + "        ws.Title = \"Pane\"\n"
    s = s + "        ws.Items = \"Item 1;Item 2;Item 3\"\n"
    s = s + "        ws.Selected = 0\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"TreeView\" THEN\n"
    s = s + "        ws.Title = \"Tree\"\n"
    s = s + "        ws.Items = \"0|*|root\"\n"
    s = s + "        ws.Selected = 0\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"GroupBox\" THEN\n"
    s = s + "        ws.Title = \"Group\"\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"PropertyGrid\" THEN\n"
    s = s + "        ws.Title = \"Properties\"\n"
    s = s + "        ws.Items = \"|Name|new|\"\n"
    s = s + "        ws.Selected = 0\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"MenuBar\" THEN\n"
    s = s + "        ws.Items = \"File|New:file.new,Exit:file.exit;Help|About:help.about\"\n"
    s = s + "        ws.Selected = -1\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"StatusBar\" THEN\n"
    s = s + "        ws.Items = \"Status:Ready\"\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"SplitPanel\" THEN\n"
    s = s + "        ws.Items = \"vertical\"\n"
    s = s + "        ws.Selected = 50\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"ProgressBar\" OR kind = \"ScrollBar\" THEN\n"
    s = s + "        ws.RngMin = 0\n"
    s = s + "        ws.RngMax = 100\n"
    s = s + "        ws.RngValue = 50\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"TextInput\" THEN\n"
    s = s + "        ws.TiModel = textinput.New()\n"
    s = s + "        ws.TiModel.Prompt = \"\"\n"
    s = s + "        IF w > 2 THEN ws.TiModel.SetWidth(w - 2)\n"
    s = s + "    END IF\n"
    s = s + "    IF kind = \"TextArea\" THEN\n"
    s = s + "        ws.TaModel = textarea.New()\n"
    s = s + "        IF w > 2 THEN ws.TaModel.SetWidth(w - 2)\n"
    s = s + "        IF h > 2 THEN ws.TaModel.SetHeight(h - 2)\n"
    s = s + "    END IF\n"
    s = s + "    gM.Widgets = APPEND(gM.Widgets, ws)\n"
    s = s + "    RETURN LEN(gM.Widgets) - 1\n"
    s = s + "END FUNCTION\n\n"
    ' gSaveProject writes a .dbproj file containing the current widget
    ' set, filtered to widgets whose Id starts with `idPrefix`. For
    ' generated demos: the user picks a prefix (e.g. "w") so only the
    ' dynamically-placed widgets get serialized, not the framework UI.
    ' Properties is a small subset (Text/Value/Items/Selected/Title)
    ' adequate for round-tripping the demo's widgets.
    s = s + "FUNCTION jsonEscape(s AS STRING) AS STRING\n"
    s = s + "    DIM b AS BYTES\n"
    s = s + "    DIM merr AS ERROR\n"
    s = s + "    b, merr = encjson.Marshal(s)\n"
    s = s + "    IF merr <> NIL THEN RETURN \"\\\"\\\"\"\n"
    s = s + "    RETURN string(b)\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION gSaveProject(path AS STRING, projectName AS STRING, formName AS STRING, formW AS INTEGER, formH AS INTEGER, formTitle AS STRING, idPrefix AS STRING) AS ERROR\n"
    s = s + "    IF gM = NIL THEN RETURN NewError(\"gM is NIL\")\n"
    s = s + "    DIM out AS STRING = \"{\\n\"\n"
    s = s + "    out = out + \"  \\\"Name\\\": \" + jsonEscape(projectName) + \",\\n\"\n"
    s = s + "    out = out + \"  \\\"Version\\\": \\\"0.1.0\\\",\\n\"\n"
    s = s + "    out = out + \"  \\\"StartForm\\\": \" + jsonEscape(formName) + \",\\n\"\n"
    s = s + "    out = out + \"  \\\"Forms\\\": [\\n\"\n"
    s = s + "    out = out + \"    {\\n\"\n"
    s = s + "    out = out + \"      \\\"Name\\\": \" + jsonEscape(formName) + \",\\n\"\n"
    s = s + "    out = out + \"      \\\"Code\\\": \\\"forms/\" + formName + \".dbas\\\",\\n\"\n"
    s = s + "    out = out + \"      \\\"Width\\\": \" + fmt.Sprintf(\"%d\", formW) + \",\\n\"\n"
    s = s + "    out = out + \"      \\\"Height\\\": \" + fmt.Sprintf(\"%d\", formH) + \",\\n\"\n"
    s = s + "    out = out + \"      \\\"Title\\\": \" + jsonEscape(formTitle) + \",\\n\"\n"
    s = s + "    out = out + \"      \\\"BgColor\\\": \\\"#1a1b2e\\\",\\n\"\n"
    s = s + "    out = out + \"      \\\"FgColor\\\": \\\"#e0def4\\\",\\n\"\n"
    s = s + "    out = out + \"      \\\"Widgets\\\": [\\n\"\n"
    s = s + "    DIM first AS BOOLEAN = TRUE\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(gM.Widgets) - 1\n"
    s = s + "        IF strings.HasPrefix(gM.Widgets[i].Id, idPrefix) THEN\n"
    s = s + "            IF NOT first THEN out = out + \",\\n\"\n"
    s = s + "            first = FALSE\n"
    s = s + "            DIM ws AS WState = gM.Widgets[i]\n"
    s = s + "            out = out + \"        {\\n\"\n"
    s = s + "            out = out + \"          \\\"Id\\\": \" + jsonEscape(ws.Id) + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"Kind\\\": \" + jsonEscape(ws.Kind) + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"X\\\": \" + fmt.Sprintf(\"%d\", ws.X) + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"Y\\\": \" + fmt.Sprintf(\"%d\", ws.Y) + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"Width\\\": \" + fmt.Sprintf(\"%d\", ws.W) + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"Height\\\": \" + fmt.Sprintf(\"%d\", ws.H) + \",\\n\"\n"
    s = s + "            DIM visStr AS STRING = \"false\"\n"
    s = s + "            IF ws.Visi THEN visStr = \"true\"\n"
    s = s + "            out = out + \"          \\\"Visible\\\": \" + visStr + \",\\n\"\n"
    s = s + "            DIM tabStopStr AS STRING = \"false\"\n"
    s = s + "            IF ws.TStop THEN tabStopStr = \"true\"\n"
    s = s + "            out = out + \"          \\\"TabStop\\\": \" + tabStopStr + \",\\n\"\n"
    s = s + "            out = out + \"          \\\"Properties\\\": {\"\n"
    s = s + "            DIM pFirst AS BOOLEAN = TRUE\n"
    s = s + "            IF ws.Text <> \"\" THEN\n"
    s = s + "                IF NOT pFirst THEN out = out + \",\"\n"
    s = s + "                pFirst = FALSE\n"
    s = s + "                out = out + \"\\\"Text\\\": \" + jsonEscape(ws.Text)\n"
    s = s + "            END IF\n"
    s = s + "            IF ws.Val <> \"\" THEN\n"
    s = s + "                IF NOT pFirst THEN out = out + \",\"\n"
    s = s + "                pFirst = FALSE\n"
    s = s + "                out = out + \"\\\"Value\\\": \" + jsonEscape(ws.Val)\n"
    s = s + "            END IF\n"
    s = s + "            IF ws.Items <> \"\" THEN\n"
    s = s + "                IF NOT pFirst THEN out = out + \",\"\n"
    s = s + "                pFirst = FALSE\n"
    s = s + "                out = out + \"\\\"Items\\\": \" + jsonEscape(ws.Items)\n"
    s = s + "            END IF\n"
    s = s + "            IF ws.Title <> \"\" THEN\n"
    s = s + "                IF NOT pFirst THEN out = out + \",\"\n"
    s = s + "                pFirst = FALSE\n"
    s = s + "                out = out + \"\\\"Title\\\": \" + jsonEscape(ws.Title)\n"
    s = s + "            END IF\n"
    s = s + "            IF ws.Selected >= 0 THEN\n"
    s = s + "                IF NOT pFirst THEN out = out + \",\"\n"
    s = s + "                pFirst = FALSE\n"
    s = s + "                out = out + \"\\\"Selected\\\": \" + fmt.Sprintf(\"%d\", ws.Selected)\n"
    s = s + "            END IF\n"
    s = s + "            out = out + \"}\\n\"\n"
    s = s + "            out = out + \"        }\"\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    out = out + \"\\n      ]\\n\"\n"
    s = s + "    out = out + \"    }\\n\"\n"
    s = s + "    out = out + \"  ]\\n\"\n"
    s = s + "    out = out + \"}\\n\"\n"
    s = s + "    WriteFile(path, out)\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n\n"
    ' gLoadProject is the inverse of gSaveProject — reads a .dbproj
    ' file, iterates Forms[0].Widgets, and instantiates each widget
    ' via gAddWidget + per-kind gSet* property accessors. Existing
    ' widgets are left alone; new widgets are appended.
    s = s + "FUNCTION jsonStrField(m AS MAP OF STRING TO ANY, key AS STRING) AS STRING\n"
    s = s + "    DIM v AS ANY = m[key]\n"
    s = s + "    IF v = NIL THEN RETURN \"\"\n"
    s = s + "    DIM s AS STRING\n"
    s = s + "    DIM ok AS BOOLEAN\n"
    s = s + "    s, ok = v.(STRING)\n"
    s = s + "    IF ok THEN RETURN s\n"
    s = s + "    RETURN \"\"\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION jsonIntField(m AS MAP OF STRING TO ANY, key AS STRING) AS INTEGER\n"
    s = s + "    DIM v AS ANY = m[key]\n"
    s = s + "    IF v = NIL THEN RETURN 0\n"
    s = s + "    DIM iv AS INTEGER\n"
    s = s + "    DIM iOk AS BOOLEAN\n"
    s = s + "    iv, iOk = v.(INTEGER)\n"
    s = s + "    IF iOk THEN RETURN iv\n"
    ' JSON numbers parse as float64 — fall back via DOUBLE → INT().
    s = s + "    DIM dv AS DOUBLE\n"
    s = s + "    DIM dOk AS BOOLEAN\n"
    s = s + "    dv, dOk = v.(DOUBLE)\n"
    s = s + "    IF dOk THEN RETURN Int(dv)\n"
    s = s + "    RETURN 0\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION jsonBoolField(m AS MAP OF STRING TO ANY, key AS STRING) AS BOOLEAN\n"
    s = s + "    DIM v AS ANY = m[key]\n"
    s = s + "    IF v = NIL THEN RETURN FALSE\n"
    s = s + "    DIM b AS BOOLEAN\n"
    s = s + "    DIM bOk AS BOOLEAN\n"
    s = s + "    b, bOk = v.(BOOLEAN)\n"
    s = s + "    IF bOk THEN RETURN b\n"
    s = s + "    RETURN FALSE\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION gLoadProject(path AS STRING, idPrefix AS STRING) AS ERROR\n"
    s = s + "    IF gM = NIL THEN RETURN NewError(\"gM is NIL\")\n"
    s = s + "    DIM data AS BYTES\n"
    s = s + "    DIM err AS ERROR\n"
    s = s + "    data, err = os.ReadFile(path)\n"
    s = s + "    IF err <> NIL THEN RETURN err\n"
    s = s + "    DIM proj AS MAP OF STRING TO ANY\n"
    s = s + "    err = encjson.Unmarshal(data, @proj)\n"
    s = s + "    IF err <> NIL THEN RETURN err\n"
    s = s + "    DIM formsAny AS ANY = proj[\"Forms\"]\n"
    s = s + "    IF formsAny = NIL THEN RETURN NewError(\"no Forms in project\")\n"
    s = s + "    DIM forms AS []ANY\n"
    s = s + "    DIM fok AS BOOLEAN\n"
    s = s + "    forms, fok = formsAny.([]ANY)\n"
    s = s + "    IF NOT fok OR LEN(forms) = 0 THEN RETURN NewError(\"Forms is empty or wrong shape\")\n"
    s = s + "    DIM form AS MAP OF STRING TO ANY\n"
    s = s + "    form, fok = forms[0].(MAP OF STRING TO ANY)\n"
    s = s + "    IF NOT fok THEN RETURN NewError(\"Forms[0] is not an object\")\n"
    s = s + "    DIM widgetsAny AS ANY = form[\"Widgets\"]\n"
    s = s + "    IF widgetsAny = NIL THEN RETURN NIL\n"
    s = s + "    DIM widgets AS []ANY\n"
    s = s + "    widgets, fok = widgetsAny.([]ANY)\n"
    s = s + "    IF NOT fok THEN RETURN NIL\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(widgets) - 1\n"
    s = s + "        DIM wmap AS MAP OF STRING TO ANY\n"
    s = s + "        wmap, fok = widgets[i].(MAP OF STRING TO ANY)\n"
    s = s + "        IF fok THEN\n"
    s = s + "            DIM wid AS STRING = jsonStrField(wmap, \"Id\")\n"
    s = s + "            DIM kind AS STRING = jsonStrField(wmap, \"Kind\")\n"
    s = s + "            DIM keepIt AS BOOLEAN = TRUE\n"
    s = s + "            IF idPrefix <> \"\" AND NOT strings.HasPrefix(wid, idPrefix) THEN keepIt = FALSE\n"
    s = s + "            IF keepIt AND kind <> \"\" AND gWidgetIdx(wid) < 0 THEN\n"
    s = s + "                DIM wx AS INTEGER = jsonIntField(wmap, \"X\")\n"
    s = s + "                DIM wy AS INTEGER = jsonIntField(wmap, \"Y\")\n"
    s = s + "                DIM ww AS INTEGER = jsonIntField(wmap, \"Width\")\n"
    s = s + "                DIM wh AS INTEGER = jsonIntField(wmap, \"Height\")\n"
    s = s + "                DIM nIdx AS INTEGER = gAddWidget(kind, wid, wx, wy, ww, wh)\n"
    s = s + "                IF nIdx >= 0 THEN\n"
    s = s + "                    DIM propsAny AS ANY = wmap[\"Properties\"]\n"
    s = s + "                    DIM props AS MAP OF STRING TO ANY\n"
    s = s + "                    DIM pOk AS BOOLEAN\n"
    s = s + "                    props, pOk = propsAny.(MAP OF STRING TO ANY)\n"
    s = s + "                    IF pOk THEN\n"
    s = s + "                        DIM txV AS STRING = jsonStrField(props, \"Text\")\n"
    s = s + "                        IF txV <> \"\" THEN gSetText(wid, txV)\n"
    s = s + "                        DIM vlV AS STRING = jsonStrField(props, \"Value\")\n"
    s = s + "                        IF vlV <> \"\" THEN gSetValue(wid, vlV)\n"
    s = s + "                        DIM itV AS STRING = jsonStrField(props, \"Items\")\n"
    s = s + "                        IF itV <> \"\" THEN gSetItems(wid, itV)\n"
    s = s + "                        DIM ttV AS STRING = jsonStrField(props, \"Title\")\n"
    s = s + "                        IF ttV <> \"\" THEN gSetTitle(wid, ttV)\n"
    s = s + "                        DIM seAny AS ANY = props[\"Selected\"]\n"
    s = s + "                        IF seAny <> NIL THEN gSetSelected(wid, jsonIntField(props, \"Selected\"))\n"
    s = s + "                    END IF\n"
    s = s + "                    DIM tsAny AS ANY = wmap[\"TabStop\"]\n"
    s = s + "                    IF tsAny <> NIL THEN gM.Widgets[nIdx].TStop = jsonBoolField(wmap, \"TabStop\")\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n\n"
    ' gRemoveWidget removes the widget with the given id. Returns TRUE
    ' on success. Clamps focus so it stays in range.
    s = s + "FUNCTION gRemoveWidget(id AS STRING) AS BOOLEAN\n"
    s = s + "    IF gM = NIL THEN RETURN FALSE\n"
    s = s + "    DIM i AS INTEGER = gWidgetIdx(id)\n"
    s = s + "    IF i < 0 THEN RETURN FALSE\n"
    s = s + "    DIM ws AS []WState\n"
    s = s + "    DIM j AS INTEGER\n"
    s = s + "    FOR j = 0 TO LEN(gM.Widgets) - 1\n"
    s = s + "        IF j <> i THEN ws = APPEND(ws, gM.Widgets[j])\n"
    s = s + "    NEXT j\n"
    s = s + "    gM.Widgets = ws\n"
    ' Re-count focusable widgets and clamp m.Focus into range.
    s = s + "    DIM fcount AS INTEGER = 0\n"
    s = s + "    DIM k AS INTEGER\n"
    s = s + "    FOR k = 0 TO LEN(gM.Widgets) - 1\n"
    s = s + "        IF gM.Widgets[k].TStop AND gM.Widgets[k].Visi THEN fcount = fcount + 1\n"
    s = s + "    NEXT k\n"
    s = s + "    IF fcount = 0 THEN\n"
    s = s + "        gM.Focus = 0\n"
    s = s + "    ELSE\n"
    s = s + "        IF gM.Focus >= fcount THEN gM.Focus = fcount - 1\n"
    s = s + "        IF gM.Focus < 0 THEN gM.Focus = 0\n"
    s = s + "    END IF\n"
    s = s + "    RETURN TRUE\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitNewModel writes the NewModel() function that initializes every
' widget on the start form.
FUNCTION emitNewModel(form AS Form) AS STRING
    DIM s AS STRING = "FUNCTION NewModel() AS Model\n"
    s = s + "    DIM m AS Model\n"
    s = s + "    m.Focus = 0\n"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        DIM v AS STRING = fmt.Sprintf("    DIM w%d AS WState\n", i)
        s = s + v
        s = s + fmt.Sprintf("    w%d.Id = %s\n",      i, dbasStr(w.Id))
        s = s + fmt.Sprintf("    w%d.Kind = %s\n",    i, dbasStr(w.Kind))
        s = s + fmt.Sprintf("    w%d.X = %d\n",       i, w.X)
        s = s + fmt.Sprintf("    w%d.Y = %d\n",       i, w.Y)
        s = s + fmt.Sprintf("    w%d.W = %d\n",       i, w.Width)
        s = s + fmt.Sprintf("    w%d.H = %d\n",       i, w.Height)
        s = s + fmt.Sprintf("    w%d.Visi = %s\n",    i, dbasBool(w.Visible))
        s = s + fmt.Sprintf("    w%d.TStop = %s\n",   i, dbasBool(w.TabStop))
        s = s + fmt.Sprintf("    w%d.TIdx = %d\n",    i, w.TabIndex)
        s = s + fmt.Sprintf("    w%d.Text = %s\n",    i, dbasStr(getStrProp(w, "Text")))
        s = s + fmt.Sprintf("    w%d.Val = %s\n",     i, dbasStr(getStrProp(w, "Value")))
        s = s + fmt.Sprintf("    w%d.Holdr = %s\n",   i, dbasStr(getStrProp(w, "Placeholder")))
        s = s + fmt.Sprintf("    w%d.BgColor = %s\n", i, dbasStr(getStrProp(w, "BgColor")))
        s = s + fmt.Sprintf("    w%d.FgColor = %s\n", i, dbasStr(getStrProp(w, "FgColor")))
        ' Checkbox state.
        DIM chkVal AS ANY = w.Properties["Checked"]
        IF chkVal <> NIL THEN
            DIM cb AS BOOLEAN
            DIM cbOk AS BOOLEAN
            cb, cbOk = chkVal.(BOOLEAN)
            IF cbOk THEN s = s + fmt.Sprintf("    w%d.Checked = %s\n", i, dbasBool(cb))
        END IF
        ' Combo/List items + selected index.
        s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(getStrProp(w, "Items")))
        DIM selV AS INTEGER
        DIM selOk AS BOOLEAN
        selV, selOk = getIntProp(w, "Selected")
        IF selOk THEN s = s + fmt.Sprintf("    w%d.Selected = %d\n", i, selV)
        ' RadioButton group + range fields (ProgressBar / ScrollBar).
        s = s + fmt.Sprintf("    w%d.Group = %s\n", i, dbasStr(getStrProp(w, "Group")))
        DIM mnV AS INTEGER
        DIM mnOk AS BOOLEAN
        mnV, mnOk = getIntProp(w, "Min")
        IF mnOk THEN s = s + fmt.Sprintf("    w%d.RngMin = %d\n", i, mnV)
        DIM mxV AS INTEGER
        DIM mxOk AS BOOLEAN
        mxV, mxOk = getIntProp(w, "Max")
        IF mxOk THEN s = s + fmt.Sprintf("    w%d.RngMax = %d\n", i, mxV)
        DIM vlV AS INTEGER
        DIM vlOk AS BOOLEAN
        vlV, vlOk = getIntProp(w, "Value")
        IF vlOk THEN s = s + fmt.Sprintf("    w%d.RngValue = %d\n", i, vlV)
        DIM hzV AS BOOLEAN
        DIM hzOk AS BOOLEAN
        hzV, hzOk = getBoolProp(w, "Horizontal")
        IF hzOk THEN s = s + fmt.Sprintf("    w%d.Horizontal = %s\n", i, dbasBool(hzV))
        ' Structural widgets share Title + Offset; also accept "Tabs" as
        ' an alias for Items (TabStrip) and "Active" for Selected.
        s = s + fmt.Sprintf("    w%d.Title = %s\n", i, dbasStr(getStrProp(w, "Title")))
        DIM offV AS INTEGER
        DIM offOk AS BOOLEAN
        offV, offOk = getIntProp(w, "Offset")
        IF offOk THEN s = s + fmt.Sprintf("    w%d.Offset = %d\n", i, offV)
        IF w.Kind = WidgetKindTabStrip THEN
            DIM tabs AS STRING = getStrProp(w, "Tabs")
            IF tabs <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(tabs))
            DIM actV AS INTEGER
            DIM actOk AS BOOLEAN
            actV, actOk = getIntProp(w, "Active")
            IF actOk THEN s = s + fmt.Sprintf("    w%d.Selected = %d\n", i, actV)
        END IF
        IF w.Kind = WidgetKindTreeView THEN
            DIM nodes AS STRING = getStrProp(w, "Nodes")
            IF nodes <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(nodes))
        END IF
        IF w.Kind = WidgetKindMenuBar THEN
            DIM menus AS STRING = getStrProp(w, "Menus")
            IF menus <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(menus))
            DIM mAct AS INTEGER
            DIM mActOk AS BOOLEAN
            mAct, mActOk = getIntProp(w, "Active")
            IF mActOk THEN s = s + fmt.Sprintf("    w%d.Selected = %d\n", i, mAct)
            ' MenuBar defaults to closed; Active=-1 if not specified.
            IF NOT mActOk THEN s = s + fmt.Sprintf("    w%d.Selected = -1\n", i)
        END IF
        IF w.Kind = WidgetKindStatusBar THEN
            DIM segs AS STRING = getStrProp(w, "Segments")
            IF segs <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(segs))
        END IF
        IF w.Kind = WidgetKindSplitPanel THEN
            DIM ori AS STRING = getStrProp(w, "Orientation")
            IF ori <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(ori))
            DIM posV AS INTEGER
            DIM posOk AS BOOLEAN
            posV, posOk = getIntProp(w, "Position")
            IF posOk THEN s = s + fmt.Sprintf("    w%d.Selected = %d\n", i, posV)
        END IF
        IF w.Kind = WidgetKindPropertyGrid THEN
            DIM rows AS STRING = getStrProp(w, "Rows")
            IF rows <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(rows))
        END IF
        IF w.Kind = WidgetKindToolbar THEN
            DIM btns AS STRING = getStrProp(w, "Buttons")
            IF btns <> "" THEN s = s + fmt.Sprintf("    w%d.Items = %s\n", i, dbasStr(btns))
            DIM tbAct AS INTEGER
            DIM tbActOk AS BOOLEAN
            tbAct, tbActOk = getIntProp(w, "Active")
            IF tbActOk THEN s = s + fmt.Sprintf("    w%d.Selected = %d\n", i, tbAct)
        END IF
        ' Initialize textinput for TextInput widgets so they accept typing.
        IF w.Kind = WidgetKindTextInput THEN
            s = s + fmt.Sprintf("    w%d.TiModel = textinput.New()\n", i)
            s = s + fmt.Sprintf("    w%d.TiModel.Prompt = \"\"\n", i)
            s = s + fmt.Sprintf("    w%d.TiModel.Placeholder = %s\n", i, dbasStr(getStrProp(w, "Placeholder")))
            DIM initVal AS STRING = getStrProp(w, "Value")
            IF initVal <> "" THEN
                s = s + fmt.Sprintf("    w%d.TiModel.SetValue(%s)\n", i, dbasStr(initVal))
            END IF
            s = s + fmt.Sprintf("    w%d.TiModel.SetWidth(%d)\n", i, w.Width - 2)
        END IF
        ' Initialize textarea for TextArea widgets so they accept multi-line typing.
        IF w.Kind = WidgetKindTextArea THEN
            s = s + fmt.Sprintf("    w%d.TaModel = textarea.New()\n", i)
            s = s + fmt.Sprintf("    w%d.TaModel.Placeholder = %s\n", i, dbasStr(getStrProp(w, "Placeholder")))
            DIM taInitVal AS STRING = getStrProp(w, "Value")
            IF taInitVal <> "" THEN
                s = s + fmt.Sprintf("    w%d.TaModel.SetValue(%s)\n", i, dbasStr(taInitVal))
            END IF
            s = s + fmt.Sprintf("    w%d.TaModel.SetWidth(%d)\n", i, w.Width - 2)
            s = s + fmt.Sprintf("    w%d.TaModel.SetHeight(%d)\n", i, w.Height - 2)
        END IF
        s = s + fmt.Sprintf("    m.Widgets = APPEND(m.Widgets, w%d)\n", i)
    NEXT i
    ' If the first focusable widget is a TextInput, focus its Input so
    ' the cursor shows + keystrokes route to it from the start.
    s = s + "    DIM initIdx AS INTEGER = -1\n"
    s = s + "    DIM initI AS INTEGER\n"
    s = s + "    FOR initI = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[initI].TStop AND m.Widgets[initI].Visi AND initIdx = -1 THEN\n"
    s = s + "            initIdx = initI\n"
    s = s + "        END IF\n"
    s = s + "    NEXT initI\n"
    s = s + "    IF initIdx >= 0 AND m.Widgets[initIdx].Kind = \"TextInput\" THEN\n"
    s = s + "        DIM initFC AS tea.Cmd = m.Widgets[initIdx].TiModel.Focus()\n"
    s = s + "        _ = initFC\n"
    s = s + "    END IF\n"
    ' Initialize tool configs from form.Tools.
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(form.Tools) - 1
        DIM t AS ToolEntry = form.Tools[ti]
        s = s + fmt.Sprintf("    DIM tc%d AS ToolCfg\n", ti)
        s = s + fmt.Sprintf("    tc%d.Id = %s\n",    ti, dbasStr(t.Id))
        s = s + fmt.Sprintf("    tc%d.Kind = %s\n",  ti, dbasStr(t.Kind))
        s = s + fmt.Sprintf("    tc%d.Mode = %s\n",  ti, dbasStr(getToolStr(t, "Mode")))
        s = s + fmt.Sprintf("    tc%d.Mask = %s\n",  ti, dbasStr(getToolStr(t, "Mask")))
        s = s + fmt.Sprintf("    tc%d.Title = %s\n", ti, dbasStr(getToolStr(t, "Title")))
        s = s + fmt.Sprintf("    m.Tools = APPEND(m.Tools, tc%d)\n", ti)
    NEXT ti
    s = s + "    RETURN m\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' getToolStr — local helper for emitNewModel.
FUNCTION getToolStr(t AS ToolEntry, key AS STRING) AS STRING
    DIM v AS ANY = t.Properties[key]
    IF v = NIL THEN RETURN ""
    DIM s AS STRING
    DIM ok AS BOOLEAN
    s, ok = v.(STRING)
    IF NOT ok THEN RETURN ""
    RETURN s
END FUNCTION

' emitLifecycle writes Init + Update + the focusableCount helper.
FUNCTION emitLifecycle() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION (m AS Model) Init() AS tea.Cmd\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION focusableCount(m AS Model) AS INTEGER\n"
    s = s + "    DIM n AS INTEGER = 0\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[i].TStop AND m.Widgets[i].Visi THEN n = n + 1\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN n\n"
    s = s + "END FUNCTION\n\n"
    s = s + "FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)\n"
    ' Keep the package-level pointer fresh so user SUBs can reach the
    ' current widget state through gGet*/gSet* accessors.
    s = s + "    gM = @m\n"
    s = s + "    DIM sizeMsg AS tea.WindowSizeMsg\n"
    s = s + "    DIM sizeOk AS BOOLEAN\n"
    s = s + "    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)\n"
    s = s + "    IF sizeOk THEN\n"
    s = s + "        m.Width = sizeMsg.Width\n"
    s = s + "        m.Height = sizeMsg.Height\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    ' ---- Mouse click dispatch (focus + button click + dialog routing). ----
    s = s + "    DIM mcMsg AS tea.MouseClickMsg\n"
    s = s + "    DIM mcOk AS BOOLEAN\n"
    s = s + "    mcMsg, mcOk = msg.(tea.MouseClickMsg)\n"
    s = s + "    IF mcOk THEN\n"
    ' MenuBar-open: click on a dropdown row fires its action, click on
    ' the menubar bar itself switches the open menu, click elsewhere
    ' closes. This runs *before* the standard hit-test so the dropdown
    ' overlay always intercepts.
    s = s + "        DIM mbOpen AS INTEGER = -1\n"
    s = s + "        DIM mbOI AS INTEGER\n"
    s = s + "        FOR mbOI = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "            IF m.Widgets[mbOI].Kind = \"MenuBar\" AND m.Widgets[mbOI].Checked THEN mbOpen = mbOI\n"
    s = s + "        NEXT mbOI\n"
    s = s + "        IF mbOpen >= 0 THEN\n"
    s = s + "            DIM mob AS WState = m.Widgets[mbOpen]\n"
    s = s + "            DIM mobLabs AS []STRING\n"
    s = s + "            DIM mobRaw AS []STRING\n"
    s = s + "            mobLabs, mobRaw = menuParse(mob.Items)\n"
    s = s + "            DIM mobAct AS INTEGER = mob.Selected\n"
    s = s + "            IF mobAct < 0 OR mobAct >= LEN(mobLabs) THEN mobAct = 0\n"
    s = s + "            DIM mobIL AS []STRING\n"
    s = s + "            DIM mobIA AS []STRING\n"
    s = s + "            mobIL, mobIA = menuItems(mobRaw[mobAct])\n"
    ' Compute dropdown X offset (sum of label cell widths before active).
    s = s + "            DIM mobDX AS INTEGER = 0\n"
    s = s + "            DIM mobK AS INTEGER\n"
    s = s + "            FOR mobK = 0 TO mobAct - 1\n"
    s = s + "                mobDX = mobDX + LEN(mobLabs[mobK]) + 2\n"
    s = s + "            NEXT mobK\n"
    s = s + "            DIM mobDropX AS INTEGER = mob.X + mobDX\n"
    s = s + "            DIM mobDropY AS INTEGER = mob.Y + mob.H\n"
    s = s + "            DIM mobDropW AS INTEGER = 0\n"
    s = s + "            DIM mobK2 AS INTEGER\n"
    s = s + "            FOR mobK2 = 0 TO LEN(mobIL) - 1\n"
    s = s + "                IF LEN(mobIL[mobK2]) + 2 > mobDropW THEN mobDropW = LEN(mobIL[mobK2]) + 2\n"
    s = s + "            NEXT mobK2\n"
    s = s + "            IF mobDropW < LEN(mobLabs[mobAct]) + 2 THEN mobDropW = LEN(mobLabs[mobAct]) + 2\n"
    s = s + "            DIM mobDropH AS INTEGER = LEN(mobIL) + 2\n"
    s = s + "            DIM mcCX AS INTEGER = mcMsg.X - 1\n"
    s = s + "            DIM mcCY AS INTEGER = mcMsg.Y - 1\n"
    ' First: click on the bar — switch active menu.
    s = s + "            IF mcCY = mob.Y AND mcCX >= mob.X AND mcCX < mob.X + mob.W THEN\n"
    s = s + "                DIM mobBarX AS INTEGER = mcCX - mob.X\n"
    s = s + "                DIM mobPos AS INTEGER = 0\n"
    s = s + "                DIM mobHit AS INTEGER = -1\n"
    s = s + "                DIM mobI AS INTEGER\n"
    s = s + "                FOR mobI = 0 TO LEN(mobLabs) - 1\n"
    s = s + "                    DIM mobCW AS INTEGER = LEN(mobLabs[mobI]) + 2\n"
    s = s + "                    IF mobBarX >= mobPos AND mobBarX < mobPos + mobCW THEN mobHit = mobI\n"
    s = s + "                    mobPos = mobPos + mobCW\n"
    s = s + "                NEXT mobI\n"
    s = s + "                IF mobHit >= 0 THEN\n"
    s = s + "                    m.Widgets[mbOpen].Selected = mobHit\n"
    s = s + "                    m.Widgets[mbOpen].Offset = 0\n"
    s = s + "                ELSE\n"
    s = s + "                    m.Widgets[mbOpen].Checked = FALSE\n"
    s = s + "                    m.Widgets[mbOpen].Selected = -1\n"
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    ' Click inside dropdown bounds → fire that item.
    s = s + "            IF mcCX >= mobDropX AND mcCX < mobDropX + mobDropW AND mcCY >= mobDropY AND mcCY < mobDropY + mobDropH THEN\n"
    s = s + "                DIM mobRowIdx AS INTEGER = mcCY - mobDropY - 1\n"
    s = s + "                IF mobRowIdx >= 0 AND mobRowIdx < LEN(mobIL) THEN\n"
    s = s + "                    IF mobIL[mobRowIdx] <> \"-\" THEN\n"
    s = s + "                        DIM mobActStr AS STRING = mobIA[mobRowIdx]\n"
    s = s + "                        m.Widgets[mbOpen].Checked = FALSE\n"
    s = s + "                        m.Widgets[mbOpen].Selected = -1\n"
    s = s + "                        dispatchMenuAction(mob.Id, mobActStr)\n"
    s = s + "                        IF openPendingDialog(@m) THEN RETURN m, NIL\n"
    s = s + "                        RETURN m, NIL\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    ' Click anywhere else closes the menu.
    s = s + "            m.Widgets[mbOpen].Checked = FALSE\n"
    s = s + "            m.Widgets[mbOpen].Selected = -1\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    ' Dropdown-active: click on a row commits, click outside closes.
    s = s + "        IF m.DropActive AND m.DropIdx >= 0 AND m.DropIdx < LEN(m.Widgets) THEN\n"
    s = s + "            DIM cbW AS WState = m.Widgets[m.DropIdx]\n"
    s = s + "            DIM cbItm AS []STRING = strings.Split(cbW.Items, \";\")\n"
    s = s + "            DIM ddH AS INTEGER = LEN(cbItm) + 2\n"
    s = s + "            IF ddH > 12 THEN ddH = 12\n"
    s = s + "            DIM ddX AS INTEGER = cbW.X + 1\n"
    s = s + "            DIM ddY AS INTEGER = cbW.Y + cbW.H + 1\n"
    s = s + "            IF (mcMsg.X - 1) >= ddX AND (mcMsg.X - 1) < ddX + cbW.W AND (mcMsg.Y - 1) >= ddY AND (mcMsg.Y - 1) < ddY + ddH THEN\n"
    s = s + "                DIM ddRowIdx AS INTEGER = (mcMsg.Y - 1) - ddY - 1\n"
    s = s + "                IF ddRowIdx >= 0 AND ddRowIdx < LEN(cbItm) THEN\n"
    s = s + "                    IF ddRowIdx <> cbW.Selected THEN\n"
    s = s + "                        m.Widgets[m.DropIdx].Selected = ddRowIdx\n"
    s = s + "                        dispatchChange(m.Widgets[m.DropIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "            m.DropActive = FALSE\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "        IF m.Dialog.Active THEN\n"
    s = s + "            DIM dCommitted AS BOOLEAN\n"
    s = s + "            DIM dPath AS STRING\n"
    s = s + "            DIM dCancelled AS BOOLEAN\n"
    s = s + "            dCommitted, dPath, dCancelled = m.Dialog.HandleClick(mcMsg.X, mcMsg.Y)\n"
    s = s + "            IF dCommitted THEN\n"
    s = s + "                DIM tidM AS STRING = m.DialogToolId\n"
    s = s + "                m.Dialog.Close()\n"
    s = s + "                m.DialogToolId = \"\"\n"
    s = s + "                dispatchFileSelected(tidM, dPath)\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF dCancelled THEN\n"
    s = s + "                m.Dialog.Close()\n"
    s = s + "                m.DialogToolId = \"\"\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "        ' Hit-test widgets on form coords (X+1, Y+1 maps to form-local).\n"
    s = s + "        DIM hitIdx AS INTEGER = -1\n"
    s = s + "        DIM hh AS INTEGER\n"
    s = s + "        FOR hh = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "            DIM ww AS WState = m.Widgets[hh]\n"
    s = s + "            IF ww.Visi AND (mcMsg.X - 1) >= ww.X AND (mcMsg.X - 1) < ww.X + ww.W AND (mcMsg.Y - 1) >= ww.Y AND (mcMsg.Y - 1) < ww.Y + ww.H THEN\n"
    s = s + "                hitIdx = hh\n"
    s = s + "            END IF\n"
    s = s + "        NEXT hh\n"
    s = s + "        IF hitIdx >= 0 THEN\n"
    s = s + "            ' Re-set Focus to the focusable index of the hit widget.\n"
    s = s + "            DIM fc AS INTEGER = 0\n"
    s = s + "            DIM newF AS INTEGER = m.Focus\n"
    s = s + "            DIM kk AS INTEGER\n"
    s = s + "            FOR kk = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "                IF m.Widgets[kk].TStop AND m.Widgets[kk].Visi THEN\n"
    s = s + "                    IF kk = hitIdx THEN newF = fc\n"
    s = s + "                    fc = fc + 1\n"
    s = s + "                END IF\n"
    s = s + "            NEXT kk\n"
    s = s + "            DIM hfc AS tea.Cmd = setFocus(@m, newF)\n"
    s = s + "            _ = hfc\n"
    s = s + "            gOnSelect(m.Widgets[hitIdx].Id)\n"
    ' Draggable widget — click starts a move drag. We record both the
    ' starting mouse position and the widget's starting X/Y so the
    ' motion handler can compute exact deltas (avoids drift).
    s = s + "            IF m.Widgets[hitIdx].Draggable THEN\n"
    s = s + "                m.DragMove = TRUE\n"
    s = s + "                m.DragMoveIdx = hitIdx\n"
    s = s + "                m.DragMoveSMX = mcMsg.X\n"
    s = s + "                m.DragMoveSMY = mcMsg.Y\n"
    s = s + "                m.DragMoveOX = m.Widgets[hitIdx].X\n"
    s = s + "                m.DragMoveOY = m.Widgets[hitIdx].Y\n"
    s = s + "            END IF\n"
    s = s + "            DIM mk AS STRING = m.Widgets[hitIdx].Kind\n"
    s = s + "            IF mk = \"Button\" THEN\n"
    s = s + "                dispatchClick(m.Widgets[hitIdx].Id)\n"
    s = s + "                IF openPendingDialog(@m) THEN RETURN m, NIL\n"
    s = s + "            ELSEIF mk = \"Checkbox\" THEN\n"
    s = s + "                m.Widgets[hitIdx].Checked = NOT m.Widgets[hitIdx].Checked\n"
    s = s + "                dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "            ELSEIF mk = \"RadioButton\" THEN\n"
    s = s + "                selectRadio(@m, hitIdx)\n"
    s = s + "                dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "            ELSEIF mk = \"ListBox\" THEN\n"
    s = s + "                ' Map click Y within widget to item row, plus Offset for scroll.\n"
    s = s + "                DIM lbItems AS []STRING = strings.Split(m.Widgets[hitIdx].Items, \";\")\n"
    s = s + "                DIM rowIdx AS INTEGER = (mcMsg.Y - 1) - m.Widgets[hitIdx].Y - 1 + m.Widgets[hitIdx].Offset\n"
    s = s + "                IF rowIdx >= 0 AND rowIdx < LEN(lbItems) THEN\n"
    s = s + "                    IF rowIdx <> m.Widgets[hitIdx].Selected THEN\n"
    s = s + "                        m.Widgets[hitIdx].Selected = rowIdx\n"
    s = s + "                        dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"ComboBox\" THEN\n"
    s = s + "                ' Open the dropdown overlay.\n"
    s = s + "                m.DropActive = TRUE\n"
    s = s + "                m.DropIdx = hitIdx\n"
    s = s + "                m.DropCursor = m.Widgets[hitIdx].Selected\n"
    s = s + "                IF m.DropCursor < 0 THEN m.DropCursor = 0\n"
    s = s + "            ELSEIF mk = \"TabStrip\" THEN\n"
    s = s + "                ' Compute clicked tab from x: walk labels.\n"
    s = s + "                DIM tcItems AS []STRING = strings.Split(m.Widgets[hitIdx].Items, \";\")\n"
    s = s + "                DIM tcLocalX AS INTEGER = (mcMsg.X - 1) - m.Widgets[hitIdx].X\n"
    s = s + "                DIM tcPos AS INTEGER = 0\n"
    s = s + "                DIM tcHit AS INTEGER = -1\n"
    s = s + "                DIM tcI AS INTEGER\n"
    s = s + "                FOR tcI = 0 TO LEN(tcItems) - 1\n"
    s = s + "                    DIM tcLen AS INTEGER = LEN(tcItems[tcI]) + 4\n"
    s = s + "                    IF tcI > 0 THEN tcLen = tcLen + 1\n"
    s = s + "                    IF tcLocalX >= tcPos AND tcLocalX < tcPos + tcLen THEN tcHit = tcI\n"
    s = s + "                    tcPos = tcPos + tcLen\n"
    s = s + "                NEXT tcI\n"
    s = s + "                IF tcHit >= 0 AND tcHit <> m.Widgets[hitIdx].Selected THEN\n"
    s = s + "                    m.Widgets[hitIdx].Selected = tcHit\n"
    s = s + "                    dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"ScrollPane\" THEN\n"
    s = s + "                DIM spClickY AS INTEGER = (mcMsg.Y - 1) - m.Widgets[hitIdx].Y - 1\n"
    s = s + "                DIM spClickedIdx AS INTEGER = m.Widgets[hitIdx].Offset + spClickY\n"
    s = s + "                DIM spAllItems AS []STRING = strings.Split(m.Widgets[hitIdx].Items, \";\")\n"
    s = s + "                IF spClickedIdx >= 0 AND spClickedIdx < LEN(spAllItems) AND spClickedIdx <> m.Widgets[hitIdx].Selected THEN\n"
    s = s + "                    m.Widgets[hitIdx].Selected = spClickedIdx\n"
    s = s + "                    dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"PropertyGrid\" THEN\n"
    s = s + "                DIM pgClickY AS INTEGER = (mcMsg.Y - 1) - m.Widgets[hitIdx].Y - 1\n"
    s = s + "                DIM pgClickedIdx AS INTEGER = m.Widgets[hitIdx].Offset + pgClickY\n"
    s = s + "                DIM pgAllRows AS []STRING = strings.Split(m.Widgets[hitIdx].Items, \";\")\n"
    s = s + "                IF pgClickedIdx >= 0 AND pgClickedIdx < LEN(pgAllRows) AND pgClickedIdx <> m.Widgets[hitIdx].Selected THEN\n"
    s = s + "                    m.Widgets[hitIdx].Selected = pgClickedIdx\n"
    s = s + "                    dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"TreeView\" THEN\n"
    s = s + "                DIM tcVis AS []STRING\n"
    s = s + "                DIM tcAbs AS []INTEGER\n"
    s = s + "                tcVis, tcAbs = treeVisible(m.Widgets[hitIdx].Items)\n"
    s = s + "                DIM tcClickY AS INTEGER = (mcMsg.Y - 1) - m.Widgets[hitIdx].Y - 1\n"
    s = s + "                DIM tcVisIdx AS INTEGER = m.Widgets[hitIdx].Offset + tcClickY\n"
    s = s + "                IF tcVisIdx >= 0 AND tcVisIdx < LEN(tcVis) THEN\n"
    s = s + "                    IF tcVisIdx <> m.Widgets[hitIdx].Selected THEN\n"
    s = s + "                        m.Widgets[hitIdx].Selected = tcVisIdx\n"
    s = s + "                        dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                    ELSE\n"
    ' Second click on the already-selected row toggles its open/close state.
    s = s + "                        DIM tcAbsIdx AS INTEGER = tcAbs[tcVisIdx]\n"
    s = s + "                        m.Widgets[hitIdx].Items = treeToggle(m.Widgets[hitIdx].Items, tcAbsIdx)\n"
    s = s + "                        dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"MenuBar\" THEN\n"
    ' Click on a menu label opens it. Compute the clicked label by
    ' walking the bar (each cell is " label " = 2 + LEN(label) wide).
    s = s + "                DIM mcLabs AS []STRING\n"
    s = s + "                DIM mcRaw AS []STRING\n"
    s = s + "                mcLabs, mcRaw = menuParse(m.Widgets[hitIdx].Items)\n"
    s = s + "                _ = mcRaw\n"
    s = s + "                DIM mcLocalX AS INTEGER = (mcMsg.X - 1) - m.Widgets[hitIdx].X\n"
    s = s + "                DIM mcPos AS INTEGER = 0\n"
    s = s + "                DIM mcHit AS INTEGER = -1\n"
    s = s + "                DIM mcI AS INTEGER\n"
    s = s + "                FOR mcI = 0 TO LEN(mcLabs) - 1\n"
    s = s + "                    DIM mcCellW AS INTEGER = LEN(mcLabs[mcI]) + 2\n"
    s = s + "                    IF mcLocalX >= mcPos AND mcLocalX < mcPos + mcCellW THEN mcHit = mcI\n"
    s = s + "                    mcPos = mcPos + mcCellW\n"
    s = s + "                NEXT mcI\n"
    s = s + "                IF mcHit >= 0 THEN\n"
    s = s + "                    m.Widgets[hitIdx].Selected = mcHit\n"
    s = s + "                    m.Widgets[hitIdx].Checked = TRUE\n"
    s = s + "                    m.Widgets[hitIdx].Offset = 0\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"Toolbar\" THEN\n"
    ' Click on a Toolbar button — compute which button by walking the
    ' rendered widths. Cell width: "[ label ]" = LEN(label) + 4.
    ' Separators are " │ " = 3 wide; regular gap between buttons = 1.
    s = s + "                DIM tbcAll AS []STRING = strings.Split(m.Widgets[hitIdx].Items, \",\")\n"
    s = s + "                DIM tbcLX AS INTEGER = (mcMsg.X - 1) - m.Widgets[hitIdx].X\n"
    s = s + "                DIM tbcPos AS INTEGER = 0\n"
    s = s + "                DIM tbcHit AS INTEGER = -1\n"
    s = s + "                DIM tbcI AS INTEGER\n"
    s = s + "                FOR tbcI = 0 TO LEN(tbcAll) - 1\n"
    s = s + "                    DIM tbcE AS STRING = tbcAll[tbcI]\n"
    s = s + "                    DIM tbcCW AS INTEGER = 0\n"
    s = s + "                    IF tbcE = \"-\" THEN\n"
    s = s + "                        tbcCW = 3\n"
    s = s + "                    ELSEIF tbcE <> \"\" THEN\n"
    s = s + "                        DIM tbcPp AS []STRING = strings.SplitN(tbcE, \":\", 2)\n"
    s = s + "                        tbcCW = LEN(tbcPp[0]) + 4\n"
    s = s + "                        IF tbcI > 0 THEN tbcCW = tbcCW + 1\n"
    s = s + "                    END IF\n"
    s = s + "                    IF tbcE <> \"-\" AND tbcE <> \"\" AND tbcLX >= tbcPos AND tbcLX < tbcPos + tbcCW THEN tbcHit = tbcI\n"
    s = s + "                    tbcPos = tbcPos + tbcCW\n"
    s = s + "                NEXT tbcI\n"
    s = s + "                IF tbcHit >= 0 THEN\n"
    s = s + "                    m.Widgets[hitIdx].Selected = tbcHit\n"
    s = s + "                    DIM tbcPp2 AS []STRING = strings.SplitN(tbcAll[tbcHit], \":\", 2)\n"
    s = s + "                    DIM tbcActStr AS STRING = \"\"\n"
    s = s + "                    IF LEN(tbcPp2) > 1 THEN tbcActStr = tbcPp2[1]\n"
    s = s + "                    dispatchMenuAction(m.Widgets[hitIdx].Id, tbcActStr)\n"
    s = s + "                    IF openPendingDialog(@m) THEN RETURN m, NIL\n"
    s = s + "                END IF\n"
    s = s + "            ELSEIF mk = \"SplitPanel\" THEN\n"
    ' Click anywhere on the divider starts a drag — reuse the
    ' DragScroll/DragIdx slots (the motion handler treats the widget
    ' kind appropriately).
    s = s + "                m.DragScroll = TRUE\n"
    s = s + "                m.DragIdx = hitIdx\n"
    s = s + "            ELSEIF mk = \"ScrollBar\" THEN\n"
    s = s + "                ' Click above the thumb decrements, below increments.\n"
    s = s + "                DIM sbRng AS INTEGER = m.Widgets[hitIdx].RngMax - m.Widgets[hitIdx].RngMin\n"
    s = s + "                DIM sbInner AS INTEGER = m.Widgets[hitIdx].H - 2\n"
    s = s + "                IF m.Widgets[hitIdx].Horizontal THEN sbInner = m.Widgets[hitIdx].W - 4\n"
    s = s + "                DIM sbThumb AS INTEGER = 0\n"
    s = s + "                IF sbRng > 0 AND sbInner > 0 THEN sbThumb = ((m.Widgets[hitIdx].RngValue - m.Widgets[hitIdx].RngMin) * (sbInner - 1)) / sbRng\n"
    s = s + "                DIM clickPos AS INTEGER\n"
    s = s + "                IF m.Widgets[hitIdx].Horizontal THEN\n"
    s = s + "                    clickPos = (mcMsg.X - 1) - m.Widgets[hitIdx].X - 2\n"
    s = s + "                ELSE\n"
    s = s + "                    clickPos = (mcMsg.Y - 1) - m.Widgets[hitIdx].Y - 1\n"
    s = s + "                END IF\n"
    ' Click ON the thumb cell starts a drag — motion events will scrub
    ' the value until release. Click above/below increments/decrements.
    s = s + "                IF clickPos = sbThumb THEN\n"
    s = s + "                    m.DragScroll = TRUE\n"
    s = s + "                    m.DragIdx = hitIdx\n"
    s = s + "                ELSE\n"
    s = s + "                    DIM sbDelta AS INTEGER = 0\n"
    s = s + "                    IF clickPos < sbThumb THEN sbDelta = 0 - 1\n"
    s = s + "                    IF clickPos > sbThumb THEN sbDelta = 1\n"
    s = s + "                    IF sbDelta <> 0 THEN\n"
    s = s + "                        DIM sbNew AS INTEGER = m.Widgets[hitIdx].RngValue + sbDelta\n"
    s = s + "                        IF sbNew < m.Widgets[hitIdx].RngMin THEN sbNew = m.Widgets[hitIdx].RngMin\n"
    s = s + "                        IF sbNew > m.Widgets[hitIdx].RngMax THEN sbNew = m.Widgets[hitIdx].RngMax\n"
    s = s + "                        m.Widgets[hitIdx].RngValue = sbNew\n"
    s = s + "                        dispatchChange(m.Widgets[hitIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    ' ---- Mouse motion: drives ScrollBar thumb drag. ----
    s = s + "    DIM mmMsg AS tea.MouseMotionMsg\n"
    s = s + "    DIM mmOk AS BOOLEAN\n"
    s = s + "    mmMsg, mmOk = msg.(tea.MouseMotionMsg)\n"
    ' Move-drag takes priority — shift the dragged widget's X/Y by the
    ' delta from the click position.
    s = s + "    IF mmOk AND m.DragMove AND m.DragMoveIdx >= 0 AND m.DragMoveIdx < LEN(m.Widgets) THEN\n"
    s = s + "        DIM mdx AS INTEGER = mmMsg.X - m.DragMoveSMX\n"
    s = s + "        DIM mdy AS INTEGER = mmMsg.Y - m.DragMoveSMY\n"
    s = s + "        DIM nx AS INTEGER = m.DragMoveOX + mdx\n"
    s = s + "        DIM ny AS INTEGER = m.DragMoveOY + mdy\n"
    s = s + "        IF nx < 0 THEN nx = 0\n"
    s = s + "        IF ny < 0 THEN ny = 0\n"
    s = s + "        m.Widgets[m.DragMoveIdx].X = nx\n"
    s = s + "        m.Widgets[m.DragMoveIdx].Y = ny\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    s = s + "    IF mmOk AND m.DragScroll AND m.DragIdx >= 0 AND m.DragIdx < LEN(m.Widgets) THEN\n"
    s = s + "        DIM dw AS WState = m.Widgets[m.DragIdx]\n"
    ' SplitPanel drag: update Position (Selected) from mouse position
    ' along the divider's draggable axis, then move the divider too.
    s = s + "        IF dw.Kind = \"SplitPanel\" THEN\n"
    s = s + "            IF dw.Items = \"horizontal\" THEN\n"
    ' Horizontal divider — drag up/down. Use the parent form bounds
    ' (the divider's Y can move from 0 to formH-1; here we treat the
    ' "span" as the form Height so Position is a percent of it).
    s = s + "                DIM hpct AS INTEGER = ((mmMsg.Y - 1) * 100) / m.Height\n"
    s = s + "                IF hpct < 0 THEN hpct = 0\n"
    s = s + "                IF hpct > 100 THEN hpct = 100\n"
    s = s + "                IF hpct <> m.Widgets[m.DragIdx].Selected THEN\n"
    s = s + "                    m.Widgets[m.DragIdx].Selected = hpct\n"
    s = s + "                    m.Widgets[m.DragIdx].Y = (m.Height * hpct) / 100\n"
    s = s + "                    dispatchChange(m.Widgets[m.DragIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "            ELSE\n"
    s = s + "                DIM vpct AS INTEGER = ((mmMsg.X - 1) * 100) / m.Width\n"
    s = s + "                IF vpct < 0 THEN vpct = 0\n"
    s = s + "                IF vpct > 100 THEN vpct = 100\n"
    s = s + "                IF vpct <> m.Widgets[m.DragIdx].Selected THEN\n"
    s = s + "                    m.Widgets[m.DragIdx].Selected = vpct\n"
    s = s + "                    m.Widgets[m.DragIdx].X = (m.Width * vpct) / 100\n"
    s = s + "                    dispatchChange(m.Widgets[m.DragIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "        DIM drng AS INTEGER = dw.RngMax - dw.RngMin\n"
    s = s + "        DIM dInner AS INTEGER = dw.H - 2\n"
    s = s + "        DIM dLocal AS INTEGER = (mmMsg.Y - 1) - dw.Y - 1\n"
    s = s + "        IF dw.Horizontal THEN\n"
    s = s + "            dInner = dw.W - 4\n"
    s = s + "            dLocal = (mmMsg.X - 1) - dw.X - 2\n"
    s = s + "        END IF\n"
    s = s + "        IF dInner < 1 THEN dInner = 1\n"
    s = s + "        IF dLocal < 0 THEN dLocal = 0\n"
    s = s + "        IF dLocal >= dInner THEN dLocal = dInner - 1\n"
    s = s + "        DIM dNew AS INTEGER = dw.RngMin\n"
    s = s + "        IF dInner > 1 AND drng > 0 THEN dNew = dw.RngMin + (dLocal * drng) / (dInner - 1)\n"
    s = s + "        IF dNew < dw.RngMin THEN dNew = dw.RngMin\n"
    s = s + "        IF dNew > dw.RngMax THEN dNew = dw.RngMax\n"
    s = s + "        IF dNew <> m.Widgets[m.DragIdx].RngValue THEN\n"
    s = s + "            m.Widgets[m.DragIdx].RngValue = dNew\n"
    s = s + "            dispatchChange(m.Widgets[m.DragIdx].Id)\n"
    s = s + "        END IF\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    ' ---- Mouse release: ends any active ScrollBar drag. ----
    s = s + "    DIM rrMsg AS tea.MouseReleaseMsg\n"
    s = s + "    DIM rrOk AS BOOLEAN\n"
    s = s + "    rrMsg, rrOk = msg.(tea.MouseReleaseMsg)\n"
    s = s + "    IF rrOk THEN\n"
    s = s + "        _ = rrMsg\n"
    s = s + "        IF m.DragMove THEN\n"
    s = s + "            m.DragMove = FALSE\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "        IF m.DragScroll THEN\n"
    s = s + "            m.DragScroll = FALSE\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    ' ---- Dialog-active branch: route keys through FileDialog. ----
    s = s + "    IF m.Dialog.Active THEN\n"
    s = s + "        DIM dKey AS tea.KeyPressMsg\n"
    s = s + "        DIM dKeyOk AS BOOLEAN\n"
    s = s + "        dKey, dKeyOk = msg.(tea.KeyPressMsg)\n"
    s = s + "        IF dKeyOk THEN\n"
    s = s + "            DIM committed AS BOOLEAN\n"
    s = s + "            DIM selPath AS STRING\n"
    s = s + "            DIM cancelled AS BOOLEAN\n"
    s = s + "            committed, selPath, cancelled = m.Dialog.HandleKey(dKey.String())\n"
    s = s + "            IF committed THEN\n"
    s = s + "                DIM tidC AS STRING = m.DialogToolId\n"
    s = s + "                m.Dialog.Close()\n"
    s = s + "                m.DialogToolId = \"\"\n"
    s = s + "                dispatchFileSelected(tidC, selPath)\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF cancelled THEN\n"
    s = s + "                m.Dialog.Close()\n"
    s = s + "                m.DialogToolId = \"\"\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    ' ---- Dropdown-active branch: route keys for ComboBox overlay. ----
    s = s + "    IF m.DropActive AND m.DropIdx >= 0 AND m.DropIdx < LEN(m.Widgets) THEN\n"
    s = s + "        DIM dkMsg AS tea.KeyPressMsg\n"
    s = s + "        DIM dkOk AS BOOLEAN\n"
    s = s + "        dkMsg, dkOk = msg.(tea.KeyPressMsg)\n"
    s = s + "        IF dkOk THEN\n"
    s = s + "            DIM dkS AS STRING = dkMsg.String()\n"
    s = s + "            DIM dcbW AS WState = m.Widgets[m.DropIdx]\n"
    s = s + "            DIM dcbI AS []STRING = strings.Split(dcbW.Items, \";\")\n"
    s = s + "            IF dkS = \"up\" THEN\n"
    s = s + "                IF m.DropCursor > 0 THEN m.DropCursor = m.DropCursor - 1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF dkS = \"down\" THEN\n"
    s = s + "                IF m.DropCursor < LEN(dcbI) - 1 THEN m.DropCursor = m.DropCursor + 1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF dkS = \"enter\" THEN\n"
    s = s + "                IF m.DropCursor <> dcbW.Selected THEN\n"
    s = s + "                    m.Widgets[m.DropIdx].Selected = m.DropCursor\n"
    s = s + "                    dispatchChange(m.Widgets[m.DropIdx].Id)\n"
    s = s + "                END IF\n"
    s = s + "                m.DropActive = FALSE\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF dkS = \"esc\" OR dkS = \"escape\" THEN\n"
    s = s + "                m.DropActive = FALSE\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    ' ---- MenuBar-open branch: route keys for navigation + selection. ----
    s = s + "    DIM mbKO AS INTEGER = -1\n"
    s = s + "    DIM mbKI AS INTEGER\n"
    s = s + "    FOR mbKI = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[mbKI].Kind = \"MenuBar\" AND m.Widgets[mbKI].Checked THEN mbKO = mbKI\n"
    s = s + "    NEXT mbKI\n"
    s = s + "    IF mbKO >= 0 THEN\n"
    s = s + "        DIM mbKey AS tea.KeyPressMsg\n"
    s = s + "        DIM mbKOk AS BOOLEAN\n"
    s = s + "        mbKey, mbKOk = msg.(tea.KeyPressMsg)\n"
    s = s + "        IF mbKOk THEN\n"
    s = s + "            DIM mbKs AS STRING = mbKey.String()\n"
    s = s + "            DIM mbW AS WState = m.Widgets[mbKO]\n"
    s = s + "            DIM mbLabs AS []STRING\n"
    s = s + "            DIM mbRaw AS []STRING\n"
    s = s + "            mbLabs, mbRaw = menuParse(mbW.Items)\n"
    s = s + "            DIM mbAct AS INTEGER = mbW.Selected\n"
    s = s + "            IF mbAct < 0 OR mbAct >= LEN(mbLabs) THEN mbAct = 0\n"
    s = s + "            DIM mbIL AS []STRING\n"
    s = s + "            DIM mbIA AS []STRING\n"
    s = s + "            mbIL, mbIA = menuItems(mbRaw[mbAct])\n"
    s = s + "            _ = mbIA\n"
    s = s + "            IF mbKs = \"left\" THEN\n"
    s = s + "                DIM mbnA AS INTEGER = mbAct - 1\n"
    s = s + "                IF mbnA < 0 THEN mbnA = LEN(mbLabs) - 1\n"
    s = s + "                m.Widgets[mbKO].Selected = mbnA\n"
    s = s + "                m.Widgets[mbKO].Offset = 0\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF mbKs = \"right\" THEN\n"
    s = s + "                DIM mbnA2 AS INTEGER = mbAct + 1\n"
    s = s + "                IF mbnA2 >= LEN(mbLabs) THEN mbnA2 = 0\n"
    s = s + "                m.Widgets[mbKO].Selected = mbnA2\n"
    s = s + "                m.Widgets[mbKO].Offset = 0\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF mbKs = \"up\" THEN\n"
    s = s + "                DIM mbnO AS INTEGER = m.Widgets[mbKO].Offset - 1\n"
    s = s + "                DIM mbGuard AS INTEGER = 0\n"
    s = s + "                DO WHILE mbGuard < LEN(mbIL)\n"
    s = s + "                    IF mbnO < 0 THEN mbnO = LEN(mbIL) - 1\n"
    s = s + "                    IF mbIL[mbnO] <> \"-\" THEN EXIT DO\n"
    s = s + "                    mbnO = mbnO - 1\n"
    s = s + "                    mbGuard = mbGuard + 1\n"
    s = s + "                LOOP\n"
    s = s + "                IF mbnO < 0 OR mbnO >= LEN(mbIL) THEN mbnO = 0\n"
    s = s + "                m.Widgets[mbKO].Offset = mbnO\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF mbKs = \"down\" THEN\n"
    s = s + "                DIM mbnO2 AS INTEGER = m.Widgets[mbKO].Offset + 1\n"
    s = s + "                DIM mbGuard2 AS INTEGER = 0\n"
    s = s + "                DO WHILE mbGuard2 < LEN(mbIL)\n"
    s = s + "                    IF mbnO2 >= LEN(mbIL) THEN mbnO2 = 0\n"
    s = s + "                    IF mbIL[mbnO2] <> \"-\" THEN EXIT DO\n"
    s = s + "                    mbnO2 = mbnO2 + 1\n"
    s = s + "                    mbGuard2 = mbGuard2 + 1\n"
    s = s + "                LOOP\n"
    s = s + "                IF mbnO2 < 0 OR mbnO2 >= LEN(mbIL) THEN mbnO2 = 0\n"
    s = s + "                m.Widgets[mbKO].Offset = mbnO2\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF mbKs = \"enter\" OR mbKs = \"space\" THEN\n"
    s = s + "                DIM mbCur AS INTEGER = m.Widgets[mbKO].Offset\n"
    s = s + "                IF mbCur >= 0 AND mbCur < LEN(mbIL) AND mbIL[mbCur] <> \"-\" THEN\n"
    s = s + "                    DIM mbActStr AS STRING = mbIA[mbCur]\n"
    s = s + "                    m.Widgets[mbKO].Checked = FALSE\n"
    s = s + "                    m.Widgets[mbKO].Selected = -1\n"
    s = s + "                    dispatchMenuAction(mbW.Id, mbActStr)\n"
    s = s + "                    IF openPendingDialog(@m) THEN RETURN m, NIL\n"
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF mbKs = \"esc\" OR mbKs = \"escape\" THEN\n"
    s = s + "                m.Widgets[mbKO].Checked = FALSE\n"
    s = s + "                m.Widgets[mbKO].Selected = -1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    ' ---- PropertyGrid edit-mode branch: route keys to the buffer. ----
    s = s + "    IF m.PgEdit AND m.PgEditIdx >= 0 AND m.PgEditIdx < LEN(m.Widgets) THEN\n"
    s = s + "        DIM peKey AS tea.KeyPressMsg\n"
    s = s + "        DIM peOk AS BOOLEAN\n"
    s = s + "        peKey, peOk = msg.(tea.KeyPressMsg)\n"
    s = s + "        IF peOk THEN\n"
    s = s + "            DIM peK AS STRING = peKey.String()\n"
    s = s + "            IF peK = \"enter\" THEN\n"
    s = s + "                m.Widgets[m.PgEditIdx].Items = pgSetRowValue(m.Widgets[m.PgEditIdx].Items, m.PgEditRow, m.PgEditBuf)\n"
    s = s + "                dispatchChange(m.Widgets[m.PgEditIdx].Id)\n"
    s = s + "                m.PgEdit = FALSE\n"
    s = s + "                m.PgEditBuf = \"\"\n"
    s = s + "                m.PgEditPos = 0\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"esc\" OR peK = \"escape\" THEN\n"
    s = s + "                m.PgEdit = FALSE\n"
    s = s + "                m.PgEditBuf = \"\"\n"
    s = s + "                m.PgEditPos = 0\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"backspace\" THEN\n"
    s = s + "                IF m.PgEditPos > 0 THEN\n"
    s = s + "                    DIM peLft AS STRING = Mid(m.PgEditBuf, 1, m.PgEditPos - 1)\n"
    s = s + "                    DIM peRgt AS STRING = \"\"\n"
    s = s + "                    IF m.PgEditPos < LEN(m.PgEditBuf) THEN peRgt = Mid(m.PgEditBuf, m.PgEditPos + 1, LEN(m.PgEditBuf) - m.PgEditPos)\n"
    s = s + "                    m.PgEditBuf = peLft + peRgt\n"
    s = s + "                    m.PgEditPos = m.PgEditPos - 1\n"
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"delete\" THEN\n"
    s = s + "                IF m.PgEditPos < LEN(m.PgEditBuf) THEN\n"
    s = s + "                    DIM peDL AS STRING = Mid(m.PgEditBuf, 1, m.PgEditPos)\n"
    s = s + "                    DIM peDR AS STRING = \"\"\n"
    s = s + "                    IF m.PgEditPos + 1 < LEN(m.PgEditBuf) THEN peDR = Mid(m.PgEditBuf, m.PgEditPos + 2, LEN(m.PgEditBuf) - m.PgEditPos - 1)\n"
    s = s + "                    m.PgEditBuf = peDL + peDR\n"
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"left\" THEN\n"
    s = s + "                IF m.PgEditPos > 0 THEN m.PgEditPos = m.PgEditPos - 1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"right\" THEN\n"
    s = s + "                IF m.PgEditPos < LEN(m.PgEditBuf) THEN m.PgEditPos = m.PgEditPos + 1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"home\" THEN\n"
    s = s + "                m.PgEditPos = 0\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "            IF peK = \"end\" THEN\n"
    s = s + "                m.PgEditPos = LEN(m.PgEditBuf)\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    ' Printable char insertion — accept single-rune keys.
    s = s + "            IF LEN(peK) = 1 THEN\n"
    s = s + "                DIM peLft2 AS STRING = \"\"\n"
    s = s + "                DIM peRgt2 AS STRING = \"\"\n"
    s = s + "                IF m.PgEditPos > 0 THEN peLft2 = Mid(m.PgEditBuf, 1, m.PgEditPos)\n"
    s = s + "                IF m.PgEditPos < LEN(m.PgEditBuf) THEN peRgt2 = Mid(m.PgEditBuf, m.PgEditPos + 1, LEN(m.PgEditBuf) - m.PgEditPos)\n"
    s = s + "                m.PgEditBuf = peLft2 + peK + peRgt2\n"
    s = s + "                m.PgEditPos = m.PgEditPos + 1\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    s = s + "    DIM keyMsg AS tea.KeyPressMsg\n"
    s = s + "    DIM keyOk AS BOOLEAN\n"
    s = s + "    keyMsg, keyOk = msg.(tea.KeyPressMsg)\n"
    s = s + "    IF keyOk THEN\n"
    s = s + "        DIM k AS STRING = keyMsg.String()\n"
    s = s + "        IF k = \"ctrl+c\" THEN RETURN m, tea.Quit\n"
    s = s + "        IF k = \"tab\" THEN\n"
    s = s + "            DIM total AS INTEGER = focusableCount(m)\n"
    s = s + "            IF total > 0 THEN\n"
    s = s + "                DIM nf AS INTEGER = (m.Focus + 1) MOD total\n"
    s = s + "                DIM tfc AS tea.Cmd = setFocus(@m, nf)\n"
    s = s + "                RETURN m, tfc\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    ' ---- If a TextInput has focus, route keystrokes to its Input. ----
    s = s + "        DIM tiIdx AS INTEGER = focusableIdxAt(m, m.Focus)\n"
    s = s + "        IF tiIdx >= 0 AND m.Widgets[tiIdx].Kind = \"TextInput\" THEN\n"
    s = s + "            DIM prevVal AS STRING = m.Widgets[tiIdx].TiModel.Value()\n"
    s = s + "            DIM newInput AS textinput.Model\n"
    s = s + "            DIM iCmd AS tea.Cmd\n"
    s = s + "            newInput, iCmd = m.Widgets[tiIdx].TiModel.Update(msg)\n"
    s = s + "            m.Widgets[tiIdx].TiModel = newInput\n"
    s = s + "            DIM newVal AS STRING = newInput.Value()\n"
    s = s + "            IF newVal <> prevVal THEN\n"
    s = s + "                m.Widgets[tiIdx].Val = newVal\n"
    s = s + "                dispatchChange(m.Widgets[tiIdx].Id)\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, iCmd\n"
    s = s + "        END IF\n"
    ' ---- If a TextArea has focus, route keystrokes to its TaModel. ----
    s = s + "        IF tiIdx >= 0 AND m.Widgets[tiIdx].Kind = \"TextArea\" THEN\n"
    s = s + "            DIM taPrev AS STRING = m.Widgets[tiIdx].TaModel.Value()\n"
    s = s + "            DIM newTa AS textarea.Model\n"
    s = s + "            DIM taCmd AS tea.Cmd\n"
    s = s + "            newTa, taCmd = m.Widgets[tiIdx].TaModel.Update(msg)\n"
    s = s + "            m.Widgets[tiIdx].TaModel = newTa\n"
    s = s + "            DIM taNew AS STRING = newTa.Value()\n"
    s = s + "            IF taNew <> taPrev THEN\n"
    s = s + "                m.Widgets[tiIdx].Val = taNew\n"
    s = s + "                dispatchChange(m.Widgets[tiIdx].Id)\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, taCmd\n"
    s = s + "        END IF\n"
    s = s + "        IF k = \"q\" THEN RETURN m, tea.Quit\n"
    s = s + "        IF k = \"enter\" OR k = \"space\" THEN\n"
    s = s + "            DIM focusedIdx AS INTEGER = -1\n"
    s = s + "            DIM fcount AS INTEGER = 0\n"
    s = s + "            DIM ii AS INTEGER\n"
    s = s + "            FOR ii = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "                IF m.Widgets[ii].TStop AND m.Widgets[ii].Visi THEN\n"
    s = s + "                    IF fcount = m.Focus THEN focusedIdx = ii\n"
    s = s + "                    fcount = fcount + 1\n"
    s = s + "                END IF\n"
    s = s + "            NEXT ii\n"
    s = s + "            IF focusedIdx >= 0 THEN\n"
    s = s + "                DIM fk AS STRING = m.Widgets[focusedIdx].Kind\n"
    s = s + "                IF fk = \"Button\" THEN\n"
    s = s + "                    dispatchClick(m.Widgets[focusedIdx].Id)\n"
    s = s + "                ELSEIF fk = \"Checkbox\" THEN\n"
    s = s + "                    m.Widgets[focusedIdx].Checked = NOT m.Widgets[focusedIdx].Checked\n"
    s = s + "                    dispatchChange(m.Widgets[focusedIdx].Id)\n"
    s = s + "                ELSEIF fk = \"RadioButton\" THEN\n"
    s = s + "                    selectRadio(@m, focusedIdx)\n"
    s = s + "                    dispatchChange(m.Widgets[focusedIdx].Id)\n"
    s = s + "                ELSEIF fk = \"ComboBox\" THEN\n"
    s = s + "                    m.DropActive = TRUE\n"
    s = s + "                    m.DropIdx = focusedIdx\n"
    s = s + "                    m.DropCursor = m.Widgets[focusedIdx].Selected\n"
    s = s + "                    IF m.DropCursor < 0 THEN m.DropCursor = 0\n"
    s = s + "                ELSEIF fk = \"TreeView\" THEN\n"
    s = s + "                    DIM ftVis AS []STRING\n"
    s = s + "                    DIM ftAbs AS []INTEGER\n"
    s = s + "                    ftVis, ftAbs = treeVisible(m.Widgets[focusedIdx].Items)\n"
    s = s + "                    _ = ftVis\n"
    s = s + "                    DIM ftSel AS INTEGER = m.Widgets[focusedIdx].Selected\n"
    s = s + "                    IF ftSel >= 0 AND ftSel < LEN(ftAbs) THEN\n"
    s = s + "                        m.Widgets[focusedIdx].Items = treeToggle(m.Widgets[focusedIdx].Items, ftAbs[ftSel])\n"
    s = s + "                        dispatchChange(m.Widgets[focusedIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                ELSEIF fk = \"Toolbar\" THEN\n"
    ' Fire the currently-selected button's action.
    s = s + "                    DIM tbA AS []STRING = strings.Split(m.Widgets[focusedIdx].Items, \",\")\n"
    s = s + "                    DIM tbS AS INTEGER = m.Widgets[focusedIdx].Selected\n"
    s = s + "                    IF tbS >= 0 AND tbS < LEN(tbA) AND tbA[tbS] <> \"-\" AND tbA[tbS] <> \"\" THEN\n"
    s = s + "                        DIM tbPp AS []STRING = strings.SplitN(tbA[tbS], \":\", 2)\n"
    s = s + "                        DIM tbAct AS STRING = \"\"\n"
    s = s + "                        IF LEN(tbPp) > 1 THEN tbAct = tbPp[1]\n"
    s = s + "                        dispatchMenuAction(m.Widgets[focusedIdx].Id, tbAct)\n"
    s = s + "                    END IF\n"
    s = s + "                ELSEIF fk = \"MenuBar\" THEN\n"
    s = s + "                    m.Widgets[focusedIdx].Checked = TRUE\n"
    s = s + "                    IF m.Widgets[focusedIdx].Selected < 0 THEN m.Widgets[focusedIdx].Selected = 0\n"
    s = s + "                    m.Widgets[focusedIdx].Offset = 0\n"
    s = s + "                ELSEIF fk = \"PropertyGrid\" THEN\n"
    ' Space/Enter on a PropertyGrid row: bool toggles in place, enum
    ' cycles to next option, anything else opens an in-place editor.
    s = s + "                    DIM pgRs AS []STRING = strings.Split(m.Widgets[focusedIdx].Items, \";\")\n"
    s = s + "                    DIM pgSI AS INTEGER = m.Widgets[focusedIdx].Selected\n"
    s = s + "                    IF pgSI >= 0 AND pgSI < LEN(pgRs) THEN\n"
    s = s + "                        DIM pgPp AS []STRING = strings.SplitN(pgRs[pgSI], \"|\", 4)\n"
    s = s + "                        DO WHILE LEN(pgPp) < 4\n"
    s = s + "                            pgPp = APPEND(pgPp, \"\")\n"
    s = s + "                        LOOP\n"
    s = s + "                        IF pgPp[0] = \"\" THEN\n"
    s = s + "                            DIM pgTp AS STRING = pgPp[3]\n"
    s = s + "                            IF pgTp = \"bool\" THEN\n"
    s = s + "                                DIM pgNV AS STRING = \"false\"\n"
    s = s + "                                IF pgPp[2] <> \"true\" THEN pgNV = \"true\"\n"
    s = s + "                                m.Widgets[focusedIdx].Items = pgSetRowValue(m.Widgets[focusedIdx].Items, pgSI, pgNV)\n"
    s = s + "                                dispatchChange(m.Widgets[focusedIdx].Id)\n"
    s = s + "                            ELSEIF strings.HasPrefix(pgTp, \"enum:\") THEN\n"
    s = s + "                                DIM pgNE AS STRING = pgEnumCycle(pgTp, pgPp[2], 1)\n"
    s = s + "                                m.Widgets[focusedIdx].Items = pgSetRowValue(m.Widgets[focusedIdx].Items, pgSI, pgNE)\n"
    s = s + "                                dispatchChange(m.Widgets[focusedIdx].Id)\n"
    s = s + "                            ELSE\n"
    ' Open in-place editor — load buffer with current value.
    s = s + "                                m.PgEdit = TRUE\n"
    s = s + "                                m.PgEditIdx = focusedIdx\n"
    s = s + "                                m.PgEditRow = pgSI\n"
    s = s + "                                m.PgEditBuf = pgPp[2]\n"
    s = s + "                                m.PgEditPos = LEN(pgPp[2])\n"
    s = s + "                            END IF\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    ' ---- After dispatching, check whether the handler asked for a dialog. ----
    s = s + "            IF openPendingDialog(@m) THEN RETURN m, NIL\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    ' ---- Arrow keys: cycle ComboBox/ListBox selection, slide ScrollBar value.
    s = s + "        IF k = \"up\" OR k = \"down\" OR k = \"left\" OR k = \"right\" THEN\n"
    s = s + "            DIM afIdx AS INTEGER = -1\n"
    s = s + "            DIM afc AS INTEGER = 0\n"
    s = s + "            DIM ai AS INTEGER\n"
    s = s + "            FOR ai = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "                IF m.Widgets[ai].TStop AND m.Widgets[ai].Visi THEN\n"
    s = s + "                    IF afc = m.Focus THEN afIdx = ai\n"
    s = s + "                    afc = afc + 1\n"
    s = s + "                END IF\n"
    s = s + "            NEXT ai\n"
    s = s + "            IF afIdx >= 0 THEN\n"
    s = s + "                DIM ak AS STRING = m.Widgets[afIdx].Kind\n"
    s = s + "                IF ak = \"ComboBox\" OR ak = \"ListBox\" OR ak = \"ScrollPane\" OR ak = \"PropertyGrid\" THEN\n"
    s = s + "                    DIM aItems AS []STRING = strings.Split(m.Widgets[afIdx].Items, \";\")\n"
    s = s + "                    DIM aDelta AS INTEGER = 0\n"
    s = s + "                    IF k = \"up\" THEN aDelta = -1\n"
    s = s + "                    IF k = \"down\" THEN aDelta = 1\n"
    s = s + "                    IF aDelta <> 0 AND LEN(aItems) > 0 THEN\n"
    s = s + "                        DIM aNew AS INTEGER = m.Widgets[afIdx].Selected + aDelta\n"
    s = s + "                        IF aNew < 0 THEN aNew = 0\n"
    s = s + "                        IF aNew >= LEN(aItems) THEN aNew = LEN(aItems) - 1\n"
    s = s + "                        IF aNew <> m.Widgets[afIdx].Selected THEN\n"
    s = s + "                            m.Widgets[afIdx].Selected = aNew\n"
    ' For ScrollPane / ListBox / PropertyGrid, auto-scroll Offset so cursor stays visible.
    s = s + "                            IF ak = \"ScrollPane\" OR ak = \"ListBox\" OR ak = \"PropertyGrid\" THEN\n"
    s = s + "                                DIM spInH AS INTEGER = m.Widgets[afIdx].H - 2\n"
    s = s + "                                IF aNew < m.Widgets[afIdx].Offset THEN m.Widgets[afIdx].Offset = aNew\n"
    s = s + "                                IF aNew >= m.Widgets[afIdx].Offset + spInH THEN m.Widgets[afIdx].Offset = aNew - spInH + 1\n"
    s = s + "                            END IF\n"
    s = s + "                            dispatchChange(m.Widgets[afIdx].Id)\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    s = s + "                ELSEIF ak = \"TabStrip\" THEN\n"
    s = s + "                    DIM tsAll AS []STRING = strings.Split(m.Widgets[afIdx].Items, \";\")\n"
    s = s + "                    DIM tsD AS INTEGER = 0\n"
    s = s + "                    IF k = \"left\"  THEN tsD = -1\n"
    s = s + "                    IF k = \"right\" THEN tsD = 1\n"
    s = s + "                    IF tsD <> 0 AND LEN(tsAll) > 0 THEN\n"
    s = s + "                        DIM tsNew AS INTEGER = m.Widgets[afIdx].Selected + tsD\n"
    s = s + "                        IF tsNew < 0 THEN tsNew = LEN(tsAll) - 1\n"
    s = s + "                        IF tsNew >= LEN(tsAll) THEN tsNew = 0\n"
    s = s + "                        m.Widgets[afIdx].Selected = tsNew\n"
    s = s + "                        dispatchChange(m.Widgets[afIdx].Id)\n"
    s = s + "                    END IF\n"
    s = s + "                ELSEIF ak = \"Toolbar\" THEN\n"
    ' Toolbar arrow nav — ←/→ moves to the next/prev non-separator
    ' button, wrapping at the ends.
    s = s + "                    DIM tbAll AS []STRING = strings.Split(m.Widgets[afIdx].Items, \",\")\n"
    s = s + "                    DIM tbD AS INTEGER = 0\n"
    s = s + "                    IF k = \"left\"  THEN tbD = -1\n"
    s = s + "                    IF k = \"right\" THEN tbD = 1\n"
    s = s + "                    IF tbD <> 0 AND LEN(tbAll) > 0 THEN\n"
    s = s + "                        DIM tbNew AS INTEGER = m.Widgets[afIdx].Selected + tbD\n"
    s = s + "                        DIM tbGuard AS INTEGER = 0\n"
    s = s + "                        DO WHILE tbGuard < LEN(tbAll)\n"
    s = s + "                            IF tbNew < 0 THEN tbNew = LEN(tbAll) - 1\n"
    s = s + "                            IF tbNew >= LEN(tbAll) THEN tbNew = 0\n"
    s = s + "                            IF tbAll[tbNew] <> \"-\" AND tbAll[tbNew] <> \"\" THEN EXIT DO\n"
    s = s + "                            tbNew = tbNew + tbD\n"
    s = s + "                            tbGuard = tbGuard + 1\n"
    s = s + "                        LOOP\n"
    s = s + "                        IF tbNew >= 0 AND tbNew < LEN(tbAll) THEN\n"
    s = s + "                            m.Widgets[afIdx].Selected = tbNew\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    s = s + "                ELSEIF ak = \"ScrollBar\" THEN\n"
    s = s + "                    DIM sDelta AS INTEGER = 0\n"
    s = s + "                    IF m.Widgets[afIdx].Horizontal THEN\n"
    s = s + "                        IF k = \"left\"  THEN sDelta = -1\n"
    s = s + "                        IF k = \"right\" THEN sDelta = 1\n"
    s = s + "                    ELSE\n"
    s = s + "                        IF k = \"up\"   THEN sDelta = -1\n"
    s = s + "                        IF k = \"down\" THEN sDelta = 1\n"
    s = s + "                    END IF\n"
    s = s + "                    IF sDelta <> 0 THEN\n"
    s = s + "                        DIM sNew AS INTEGER = m.Widgets[afIdx].RngValue + sDelta\n"
    s = s + "                        IF sNew < m.Widgets[afIdx].RngMin THEN sNew = m.Widgets[afIdx].RngMin\n"
    s = s + "                        IF sNew > m.Widgets[afIdx].RngMax THEN sNew = m.Widgets[afIdx].RngMax\n"
    s = s + "                        IF sNew <> m.Widgets[afIdx].RngValue THEN\n"
    s = s + "                            m.Widgets[afIdx].RngValue = sNew\n"
    s = s + "                            dispatchChange(m.Widgets[afIdx].Id)\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    ' ---- TreeView: up/down moves through *visible* rows; Enter toggles
    '      expandable nodes (and re-emits a Change for navigation).
    s = s + "                ELSEIF ak = \"TreeView\" THEN\n"
    s = s + "                    DIM tkVis AS []STRING\n"
    s = s + "                    DIM tkAbs AS []INTEGER\n"
    s = s + "                    tkVis, tkAbs = treeVisible(m.Widgets[afIdx].Items)\n"
    s = s + "                    _ = tkAbs\n"
    s = s + "                    DIM tkDelta AS INTEGER = 0\n"
    s = s + "                    IF k = \"up\"   THEN tkDelta = -1\n"
    s = s + "                    IF k = \"down\" THEN tkDelta = 1\n"
    s = s + "                    IF tkDelta <> 0 AND LEN(tkVis) > 0 THEN\n"
    s = s + "                        DIM tkNew AS INTEGER = m.Widgets[afIdx].Selected + tkDelta\n"
    s = s + "                        IF tkNew < 0 THEN tkNew = 0\n"
    s = s + "                        IF tkNew >= LEN(tkVis) THEN tkNew = LEN(tkVis) - 1\n"
    s = s + "                        IF tkNew <> m.Widgets[afIdx].Selected THEN\n"
    s = s + "                            m.Widgets[afIdx].Selected = tkNew\n"
    s = s + "                            DIM tkInH AS INTEGER = m.Widgets[afIdx].H - 2\n"
    s = s + "                            IF tkNew < m.Widgets[afIdx].Offset THEN m.Widgets[afIdx].Offset = tkNew\n"
    s = s + "                            IF tkNew >= m.Widgets[afIdx].Offset + tkInH THEN m.Widgets[afIdx].Offset = tkNew - tkInH + 1\n"
    s = s + "                            dispatchChange(m.Widgets[afIdx].Id)\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    ' ---- PropertyGrid: ←/→ on an enum row cycles the value.
    s = s + "                IF ak = \"PropertyGrid\" AND (k = \"left\" OR k = \"right\") THEN\n"
    s = s + "                    DIM pgRs2 AS []STRING = strings.Split(m.Widgets[afIdx].Items, \";\")\n"
    s = s + "                    DIM pgSI2 AS INTEGER = m.Widgets[afIdx].Selected\n"
    s = s + "                    IF pgSI2 >= 0 AND pgSI2 < LEN(pgRs2) THEN\n"
    s = s + "                        DIM pgPp2 AS []STRING = strings.SplitN(pgRs2[pgSI2], \"|\", 4)\n"
    s = s + "                        DO WHILE LEN(pgPp2) < 4\n"
    s = s + "                            pgPp2 = APPEND(pgPp2, \"\")\n"
    s = s + "                        LOOP\n"
    s = s + "                        IF pgPp2[0] = \"\" AND strings.HasPrefix(pgPp2[3], \"enum:\") THEN\n"
    s = s + "                            DIM pgDir AS INTEGER = 1\n"
    s = s + "                            IF k = \"left\" THEN pgDir = 0 - 1\n"
    s = s + "                            DIM pgNV2 AS STRING = pgEnumCycle(pgPp2[3], pgPp2[2], pgDir)\n"
    s = s + "                            m.Widgets[afIdx].Items = pgSetRowValue(m.Widgets[afIdx].Items, pgSI2, pgNV2)\n"
    s = s + "                            dispatchChange(m.Widgets[afIdx].Id)\n"
    s = s + "                        END IF\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    s = s + "    RETURN m, NIL\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitRenderWidget writes the helper that turns one WState into a
' styled string box.
FUNCTION emitRenderWidget() AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION renderOneWidget(w AS WState, focused AS BOOLEAN, editing AS BOOLEAN, editRow AS INTEGER, editBuf AS STRING, editPos AS INTEGER) AS STRING\n"
    s = s + "    DIM bg AS STRING = w.BgColor\n"
    s = s + "    DIM fg AS STRING = w.FgColor\n"
    s = s + "    IF bg = \"\" THEN bg = \"#1a1b2e\"\n"
    s = s + "    IF fg = \"\" THEN fg = \"#e0def4\"\n"
    s = s + "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(bg)).Foreground(lipgloss.Color(fg))\n"
    s = s + "    DIM borderless AS BOOLEAN = (w.Kind = \"Label\" OR w.Kind = \"Checkbox\" OR w.Kind = \"RadioButton\" OR w.Kind = \"ScrollBar\" OR w.Kind = \"TabStrip\" OR w.Kind = \"MenuBar\" OR w.Kind = \"StatusBar\" OR w.Kind = \"SplitPanel\" OR w.Kind = \"Toolbar\")\n"
    s = s + "    IF w.W >= 3 AND w.H >= 3 AND NOT borderless THEN\n"
    ' lipgloss v2's Width counts the *content* width, but border + width
    ' together render at total = Width + 0 cells (border eats into the
    ' visible width). Tested empirically: Width(N) + border renders an
    ' N-cell box. So pass w.W (not w.W - 2) and let lipgloss carve out
    ' the border. Inner content for ProgressBar etc. uses (w.W - 2).
    s = s + "        style = style.Border(lipgloss.NormalBorder()).Width(w.W).Height(w.H)\n"
    s = s + "        IF focused THEN style = style.BorderForeground(lipgloss.Color(\"#7dcfff\"))\n"
    s = s + "    ELSE\n"
    s = s + "        style = style.Width(w.W).Height(w.H)\n"
    s = s + "    END IF\n"
    s = s + "    DIM body AS STRING\n"
    s = s + "    IF w.Kind = \"Label\" THEN\n"
    s = s + "        body = w.Text\n"
    s = s + "    ELSEIF w.Kind = \"Button\" THEN\n"
    s = s + "        body = w.Text\n"
    s = s + "    ELSEIF w.Kind = \"TextInput\" THEN\n"
    s = s + "        body = w.TiModel.View()\n"
    s = s + "    ELSEIF w.Kind = \"FileDialog\" THEN\n"
    s = s + "        DIM label AS STRING = w.Val\n"
    s = s + "        IF label = \"\" THEN label = w.Holdr\n"
    s = s + "        body = label + \"  [...]\"\n"
    s = s + "    ELSEIF w.Kind = \"Checkbox\" THEN\n"
    s = s + "        DIM mark AS STRING = \"[ ] \"\n"
    s = s + "        IF w.Checked THEN mark = \"[x] \"\n"
    s = s + "        body = mark + w.Text\n"
    s = s + "    ELSEIF w.Kind = \"ComboBox\" THEN\n"
    s = s + "        DIM cbItems AS []STRING = strings.Split(w.Items, \";\")\n"
    s = s + "        DIM cbCur AS STRING = \"\"\n"
    s = s + "        IF w.Selected >= 0 AND w.Selected < LEN(cbItems) THEN cbCur = cbItems[w.Selected]\n"
    s = s + "        body = cbCur + \"  ▾\"\n"
    s = s + "    ELSEIF w.Kind = \"ListBox\" THEN\n"
    s = s + "        DIM lbItems AS []STRING = strings.Split(w.Items, \";\")\n"
    s = s + "        DIM lbInnerH AS INTEGER = w.H - 2\n"
    s = s + "        IF lbInnerH < 1 THEN lbInnerH = 1\n"
    s = s + "        DIM lbInnerW AS INTEGER = w.W - 2\n"
    s = s + "        IF lbInnerW < 1 THEN lbInnerW = 1\n"
    s = s + "        DIM lbCanScroll AS BOOLEAN = (LEN(lbItems) > lbInnerH)\n"
    s = s + "        DIM lbThumb AS INTEGER = -1\n"
    s = s + "        IF lbCanScroll AND lbInnerH > 0 THEN\n"
    s = s + "            DIM lbMaxOff AS INTEGER = LEN(lbItems) - lbInnerH\n"
    s = s + "            IF lbMaxOff > 0 THEN lbThumb = w.Offset * (lbInnerH - 1) / lbMaxOff\n"
    s = s + "        END IF\n"
    s = s + "        DIM lbRowW AS INTEGER = lbInnerW\n"
    s = s + "        IF lbCanScroll THEN lbRowW = lbInnerW - 1\n"
    s = s + "        DIM lbLines AS []STRING\n"
    s = s + "        DIM li AS INTEGER\n"
    s = s + "        FOR li = 0 TO lbInnerH - 1\n"
    s = s + "            DIM lbIdx AS INTEGER = w.Offset + li\n"
    s = s + "            DIM lbRow AS STRING = \"\"\n"
    s = s + "            IF lbIdx >= 0 AND lbIdx < LEN(lbItems) THEN\n"
    s = s + "                DIM prefix AS STRING = \"  \"\n"
    s = s + "                IF lbIdx = w.Selected THEN prefix = \"▶ \"\n"
    s = s + "                lbRow = prefix + lbItems[lbIdx]\n"
    s = s + "                IF lipgloss.Width(lbRow) > lbRowW THEN lbRow = Mid(lbRow, 1, lbRowW)\n"
    s = s + "            END IF\n"
    s = s + "            DIM lbPad AS INTEGER = lbRowW - lipgloss.Width(lbRow)\n"
    s = s + "            IF lbPad < 0 THEN lbPad = 0\n"
    s = s + "            DIM lbBar AS STRING = \"\"\n"
    s = s + "            IF lbCanScroll THEN\n"
    s = s + "                IF li = lbThumb THEN lbBar = \"┃\"\n"
    s = s + "                IF li <> lbThumb THEN lbBar = \"╎\"\n"
    s = s + "            END IF\n"
    s = s + "            lbLines = APPEND(lbLines, lbRow + strings.Repeat(\" \", lbPad) + lbBar)\n"
    s = s + "        NEXT li\n"
    s = s + "        body = strings.Join(lbLines, \"\\n\")\n"
    s = s + "    ELSEIF w.Kind = \"RadioButton\" THEN\n"
    s = s + "        DIM rbMark AS STRING = \"( ) \"\n"
    s = s + "        IF w.Checked THEN rbMark = \"(•) \"\n"
    s = s + "        body = rbMark + w.Text\n"
    s = s + "    ELSEIF w.Kind = \"ProgressBar\" THEN\n"
    s = s + "        DIM inner AS INTEGER = w.W - 2\n"
    s = s + "        IF inner < 1 THEN inner = 1\n"
    s = s + "        DIM rng AS INTEGER = w.RngMax - w.RngMin\n"
    s = s + "        DIM pct AS INTEGER = 0\n"
    s = s + "        IF rng > 0 THEN pct = ((w.RngValue - w.RngMin) * 100) / rng\n"
    s = s + "        IF pct < 0 THEN pct = 0\n"
    s = s + "        IF pct > 100 THEN pct = 100\n"
    s = s + "        DIM fill AS INTEGER = (inner * pct) / 100\n"
    s = s + "        body = strings.Repeat(\"█\", fill) + strings.Repeat(\"░\", inner - fill)\n"
    s = s + "    ELSEIF w.Kind = \"ScrollBar\" THEN\n"
    s = s + "        IF w.Horizontal THEN\n"
    s = s + "            DIM hInner AS INTEGER = w.W - 4\n"
    s = s + "            IF hInner < 1 THEN hInner = 1\n"
    s = s + "            DIM hRng AS INTEGER = w.RngMax - w.RngMin\n"
    s = s + "            DIM hThumbPos AS INTEGER = 0\n"
    s = s + "            IF hRng > 0 THEN hThumbPos = ((w.RngValue - w.RngMin) * (hInner - 1)) / hRng\n"
    s = s + "            IF hThumbPos < 0 THEN hThumbPos = 0\n"
    s = s + "            IF hThumbPos >= hInner THEN hThumbPos = hInner - 1\n"
    s = s + "            body = \"◄ \" + strings.Repeat(\"─\", hThumbPos) + \"█\" + strings.Repeat(\"─\", hInner - hThumbPos - 1) + \" ►\"\n"
    s = s + "        ELSE\n"
    s = s + "            DIM vInner AS INTEGER = w.H - 2\n"
    s = s + "            IF vInner < 1 THEN vInner = 1\n"
    s = s + "            DIM vRng AS INTEGER = w.RngMax - w.RngMin\n"
    s = s + "            DIM vThumbPos AS INTEGER = 0\n"
    s = s + "            IF vRng > 0 THEN vThumbPos = ((w.RngValue - w.RngMin) * (vInner - 1)) / vRng\n"
    s = s + "            IF vThumbPos < 0 THEN vThumbPos = 0\n"
    s = s + "            IF vThumbPos >= vInner THEN vThumbPos = vInner - 1\n"
    s = s + "            DIM vLines AS []STRING\n"
    s = s + "            vLines = APPEND(vLines, \"▲\")\n"
    s = s + "            DIM vi AS INTEGER\n"
    s = s + "            FOR vi = 0 TO vInner - 1\n"
    s = s + "                IF vi = vThumbPos THEN\n"
    s = s + "                    vLines = APPEND(vLines, \"█\")\n"
    s = s + "                ELSE\n"
    s = s + "                    vLines = APPEND(vLines, \"│\")\n"
    s = s + "                END IF\n"
    s = s + "            NEXT vi\n"
    s = s + "            vLines = APPEND(vLines, \"▼\")\n"
    s = s + "            body = strings.Join(vLines, \"\\n\")\n"
    s = s + "        END IF\n"
    s = s + "    ELSEIF w.Kind = \"TabStrip\" THEN\n"
    s = s + "        DIM tsItems AS []STRING = strings.Split(w.Items, \";\")\n"
    s = s + "        DIM tsOut AS STRING = \"\"\n"
    s = s + "        DIM tsI AS INTEGER\n"
    s = s + "        FOR tsI = 0 TO LEN(tsItems) - 1\n"
    s = s + "            DIM tsSep AS STRING = \" \"\n"
    s = s + "            IF tsI = 0 THEN tsSep = \"\"\n"
    s = s + "            IF tsI = w.Selected THEN\n"
    s = s + "                tsOut = tsOut + tsSep + \"[ \" + tsItems[tsI] + \" ]\"\n"
    s = s + "            ELSE\n"
    s = s + "                tsOut = tsOut + tsSep + \"  \" + tsItems[tsI] + \"  \"\n"
    s = s + "            END IF\n"
    s = s + "        NEXT tsI\n"
    s = s + "        body = tsOut\n"
    s = s + "    ELSEIF w.Kind = \"ScrollPane\" THEN\n"
    s = s + "        DIM spItems AS []STRING = strings.Split(w.Items, \";\")\n"
    s = s + "        DIM spInnerH AS INTEGER = w.H - 2\n"
    s = s + "        IF spInnerH < 1 THEN spInnerH = 1\n"
    s = s + "        DIM spLines AS []STRING\n"
    s = s + "        DIM spI AS INTEGER\n"
    s = s + "        FOR spI = 0 TO spInnerH - 1\n"
    s = s + "            DIM spIdx AS INTEGER = w.Offset + spI\n"
    s = s + "            IF spIdx < 0 OR spIdx >= LEN(spItems) THEN\n"
    s = s + "                spLines = APPEND(spLines, \"\")\n"
    s = s + "            ELSE\n"
    s = s + "                DIM spPrefix AS STRING = \"  \"\n"
    s = s + "                IF spIdx = w.Selected THEN spPrefix = \"▶ \"\n"
    s = s + "                spLines = APPEND(spLines, spPrefix + spItems[spIdx])\n"
    s = s + "            END IF\n"
    s = s + "        NEXT spI\n"
    s = s + "        body = strings.Join(spLines, \"\\n\")\n"
    s = s + "    ELSEIF w.Kind = \"TreeView\" THEN\n"
    s = s + "        DIM tvVisible AS []STRING\n"
    s = s + "        DIM tvAbsIdx AS []INTEGER\n"
    s = s + "        tvVisible, tvAbsIdx = treeVisible(w.Items)\n"
    s = s + "        _ = tvAbsIdx\n"
    s = s + "        DIM tvInnerH AS INTEGER = w.H - 2\n"
    s = s + "        IF tvInnerH < 1 THEN tvInnerH = 1\n"
    s = s + "        DIM tvInnerW AS INTEGER = w.W - 2\n"
    s = s + "        IF tvInnerW < 1 THEN tvInnerW = 1\n"
    s = s + "        DIM tvCanScroll AS BOOLEAN = (LEN(tvVisible) > tvInnerH)\n"
    s = s + "        DIM tvThumb AS INTEGER = -1\n"
    s = s + "        IF tvCanScroll AND tvInnerH > 0 THEN\n"
    s = s + "            DIM tvMaxOff AS INTEGER = LEN(tvVisible) - tvInnerH\n"
    s = s + "            IF tvMaxOff > 0 THEN tvThumb = w.Offset * (tvInnerH - 1) / tvMaxOff\n"
    s = s + "        END IF\n"
    s = s + "        DIM tvRowW AS INTEGER = tvInnerW\n"
    s = s + "        IF tvCanScroll THEN tvRowW = tvInnerW - 1\n"
    s = s + "        DIM tvLines AS []STRING\n"
    s = s + "        DIM tvR AS INTEGER\n"
    s = s + "        FOR tvR = 0 TO tvInnerH - 1\n"
    s = s + "            DIM tvIdx AS INTEGER = w.Offset + tvR\n"
    s = s + "            DIM tvRow AS STRING = \"\"\n"
    s = s + "            IF tvIdx >= 0 AND tvIdx < LEN(tvVisible) THEN\n"
    s = s + "                DIM tvP AS []STRING = strings.SplitN(tvVisible[tvIdx], \"|\", 3)\n"
    s = s + "                DIM tvRD AS INTEGER = 0\n"
    s = s + "                DIM tvRDerr AS ERROR\n"
    s = s + "                tvRD, tvRDerr = strconv.Atoi(tvP[0])\n"
    s = s + "                _ = tvRDerr\n"
    s = s + "                DIM tvMark AS STRING = \"◇ \"\n"
    s = s + "                IF tvP[1] = \"+\" THEN tvMark = \"▾ \"\n"
    s = s + "                IF tvP[1] = \"-\" THEN tvMark = \"▸ \"\n"
    s = s + "                DIM tvCur AS STRING = \"  \"\n"
    s = s + "                IF tvIdx = w.Selected THEN tvCur = \"▶ \"\n"
    s = s + "                tvRow = strings.Repeat(\"  \", tvRD) + tvCur + tvMark + tvP[2]\n"
    s = s + "                IF lipgloss.Width(tvRow) > tvRowW THEN tvRow = Mid(tvRow, 1, tvRowW)\n"
    s = s + "            END IF\n"
    s = s + "            DIM tvPad AS INTEGER = tvRowW - lipgloss.Width(tvRow)\n"
    s = s + "            IF tvPad < 0 THEN tvPad = 0\n"
    s = s + "            DIM tvBar AS STRING = \"\"\n"
    s = s + "            IF tvCanScroll THEN\n"
    s = s + "                IF tvR = tvThumb THEN tvBar = \"┃\"\n"
    s = s + "                IF tvR <> tvThumb THEN tvBar = \"╎\"\n"
    s = s + "            END IF\n"
    s = s + "            tvLines = APPEND(tvLines, tvRow + strings.Repeat(\" \", tvPad) + tvBar)\n"
    s = s + "        NEXT tvR\n"
    s = s + "        body = strings.Join(tvLines, \"\\n\")\n"
    s = s + "    ELSEIF w.Kind = \"GroupBox\" THEN\n"
    ' GroupBox renders empty body; the border + title is the whole point.
    s = s + "        body = \"\"\n"
    s = s + "    ELSEIF w.Kind = \"MenuBar\" THEN\n"
    ' Render the closed bar — menu labels with the active one highlighted.
    s = s + "        DIM mbLabs AS []STRING\n"
    s = s + "        DIM mbRaw AS []STRING\n"
    s = s + "        mbLabs, mbRaw = menuParse(w.Items)\n"
    s = s + "        _ = mbRaw\n"
    s = s + "        DIM mbHi AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#7dcfff\")).Foreground(lipgloss.Color(\"#1a1b2e\"))\n"
    s = s + "        DIM mbOut AS STRING = \"\"\n"
    s = s + "        DIM mbI AS INTEGER\n"
    s = s + "        FOR mbI = 0 TO LEN(mbLabs) - 1\n"
    s = s + "            DIM mbCell AS STRING = \" \" + mbLabs[mbI] + \" \"\n"
    s = s + "            IF mbI = w.Selected THEN mbCell = mbHi.Render(mbCell)\n"
    s = s + "            mbOut = mbOut + mbCell\n"
    s = s + "        NEXT mbI\n"
    s = s + "        body = mbOut\n"
    s = s + "    ELSEIF w.Kind = \"Toolbar\" THEN\n"
    ' Render buttons inline as " [ Label ] " separated by a single
    ' space. A "-" item renders as a dim vertical separator.
    s = s + "        DIM tbList AS []STRING = strings.Split(w.Items, \",\")\n"
    s = s + "        DIM tbHi AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#7dcfff\")).Foreground(lipgloss.Color(\"#1a1b2e\"))\n"
    s = s + "        DIM tbSep AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3b3d5e\"))\n"
    s = s + "        DIM tbOut AS STRING = \"\"\n"
    s = s + "        DIM tbI AS INTEGER\n"
    s = s + "        FOR tbI = 0 TO LEN(tbList) - 1\n"
    s = s + "            DIM tbE AS STRING = tbList[tbI]\n"
    s = s + "            IF tbE = \"-\" THEN\n"
    s = s + "                tbOut = tbOut + tbSep.Render(\" │ \")\n"
    s = s + "            ELSEIF tbE <> \"\" THEN\n"
    s = s + "                DIM tbP AS []STRING = strings.SplitN(tbE, \":\", 2)\n"
    s = s + "                DIM tbLbl AS STRING = tbP[0]\n"
    s = s + "                DIM tbCell AS STRING = \"[ \" + tbLbl + \" ]\"\n"
    s = s + "                IF tbI = w.Selected THEN tbCell = tbHi.Render(tbCell)\n"
    s = s + "                IF tbI > 0 THEN tbOut = tbOut + \" \"\n"
    s = s + "                tbOut = tbOut + tbCell\n"
    s = s + "            END IF\n"
    s = s + "        NEXT tbI\n"
    s = s + "        body = tbOut\n"
    s = s + "    ELSEIF w.Kind = \"StatusBar\" THEN\n"
    ' Render segments as " Label: Value │ Label: Value │ ... "
    s = s + "        DIM sbSegs AS []STRING = strings.Split(w.Items, \";\")\n"
    s = s + "        DIM sbSep AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3b3d5e\"))\n"
    s = s + "        DIM sbOut AS STRING = \"\"\n"
    s = s + "        DIM sbI AS INTEGER\n"
    s = s + "        FOR sbI = 0 TO LEN(sbSegs) - 1\n"
    s = s + "            IF sbSegs[sbI] <> \"\" THEN\n"
    s = s + "                IF sbOut <> \"\" THEN sbOut = sbOut + sbSep.Render(\" │ \")\n"
    s = s + "                DIM sbP AS []STRING = strings.SplitN(sbSegs[sbI], \":\", 2)\n"
    s = s + "                IF LEN(sbP) = 2 THEN\n"
    s = s + "                    sbOut = sbOut + sbP[0] + \": \" + sbP[1]\n"
    s = s + "                ELSE\n"
    s = s + "                    sbOut = sbOut + sbSegs[sbI]\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "        NEXT sbI\n"
    s = s + "        body = \" \" + sbOut\n"
    s = s + "    ELSEIF w.Kind = \"TextArea\" THEN\n"
    s = s + "        body = w.TaModel.View()\n"
    s = s + "    ELSEIF w.Kind = \"SplitPanel\" THEN\n"
    ' Render the divider line (vertical orientation = a ╎ column,
    ' horizontal orientation = a ╌ row).
    s = s + "        IF w.Items = \"horizontal\" THEN\n"
    s = s + "            body = strings.Repeat(\"╌\", w.W)\n"
    s = s + "        ELSE\n"
    s = s + "            DIM splLines AS []STRING\n"
    s = s + "            DIM splI AS INTEGER\n"
    s = s + "            FOR splI = 0 TO w.H - 1\n"
    s = s + "                splLines = APPEND(splLines, \"╎\")\n"
    s = s + "            NEXT splI\n"
    s = s + "            body = strings.Join(splLines, \"\\n\")\n"
    s = s + "        END IF\n"
    s = s + "    ELSEIF w.Kind = \"PropertyGrid\" THEN\n"
    s = s + "        DIM pgInnerW AS INTEGER = w.W - 2\n"
    s = s + "        DIM pgInnerH AS INTEGER = w.H - 2\n"
    s = s + "        body = renderPropertyGridBody(w.Items, w.Selected, w.Offset, pgInnerW, pgInnerH, editing, editRow, editBuf, editPos, \"\")\n"
    s = s + "    ELSE\n"
    s = s + "        body = w.Kind\n"
    s = s + "    END IF\n"
    s = s + "    RETURN style.Render(body)\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitView writes the View function that composes the form + widgets.
FUNCTION emitView(form AS Form) AS STRING
    DIM bgCol AS STRING = form.BgColor
    DIM fgCol AS STRING = form.FgColor
    IF bgCol = "" THEN bgCol = "#1a1b2e"
    IF fgCol = "" THEN fgCol = "#e0def4"
    DIM title AS STRING = form.Title
    IF title = "" THEN title = form.Name

    DIM s AS STRING = ""
    s = s + "FUNCTION (m AS Model) View() AS tea.View\n"
    s = s + fmt.Sprintf("    DIM formW AS INTEGER = %d\n", form.Width)
    s = s + fmt.Sprintf("    DIM formH AS INTEGER = %d\n", form.Height)
    s = s + fmt.Sprintf("    DIM bgCol AS STRING = %s\n", dbasStr(bgCol))
    s = s + fmt.Sprintf("    DIM fgCol AS STRING = %s\n", dbasStr(fgCol))
    s = s + fmt.Sprintf("    DIM title AS STRING = %s\n", dbasStr(title))
    s = s + "    DIM formStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(bgCol)).Foreground(lipgloss.Color(fgCol)).Width(formW - 2).Height(formH - 2).Border(lipgloss.DoubleBorder()).BorderForeground(lipgloss.Color(fgCol))\n"
    s = s + "    DIM bg AS STRING = formStyle.Render(\"\")\n"
    s = s + "    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(bgCol)).Foreground(lipgloss.Color(\"#7dcfff\")).Bold(TRUE)\n"
    s = s + "    DIM titleStr AS STRING = titleStyle.Render(\" \" + title + \" \")\n"
    s = s + "    DIM bgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(bg)\n"
    s = s + "    DIM titleLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(titleStr).X(2).Y(0).Z(1)\n"
    s = s + "    DIM comp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgLayer, titleLayer)\n"
    s = s + "    DIM focusedIdx AS INTEGER = -1\n"
    s = s + "    DIM fcount AS INTEGER = 0\n"
    s = s + "    DIM ii AS INTEGER\n"
    s = s + "    FOR ii = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[ii].TStop AND m.Widgets[ii].Visi THEN\n"
    s = s + "            IF fcount = m.Focus THEN focusedIdx = ii\n"
    s = s + "            fcount = fcount + 1\n"
    s = s + "        END IF\n"
    s = s + "    NEXT ii\n"
    s = s + "    DIM j AS INTEGER\n"
    s = s + "    FOR j = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        DIM w AS WState = m.Widgets[j]\n"
    s = s + "        IF w.Visi THEN\n"
    s = s + "            DIM wEditing AS BOOLEAN = (m.PgEdit AND m.PgEditIdx = j)\n"
    s = s + "            DIM ws AS STRING = renderOneWidget(w, j = focusedIdx, wEditing, m.PgEditRow, m.PgEditBuf, m.PgEditPos)\n"
    s = s + "            comp.AddLayers(lipgloss.NewLayer(ws).X(w.X + 1).Y(w.Y + 1).Z(j + 2))\n"
    ' GroupBox + TreeView/ScrollPane: paint Title as a Z-overlay on the
    ' top border so it reads as an embedded label.
    s = s + "            IF w.Title <> \"\" AND (w.Kind = \"GroupBox\" OR w.Kind = \"TreeView\" OR w.Kind = \"ScrollPane\" OR w.Kind = \"PropertyGrid\") THEN\n"
    s = s + "                DIM gtStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(bgCol)).Foreground(lipgloss.Color(\"#7dcfff\")).Bold(TRUE)\n"
    s = s + "                DIM gtStr AS STRING = gtStyle.Render(\" \" + w.Title + \" \")\n"
    s = s + "                comp.AddLayers(lipgloss.NewLayer(gtStr).X(w.X + 3).Y(w.Y + 1).Z(j + 100))\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    NEXT j\n"
    s = s + "    DIM formStr AS STRING = comp.Render()\n"
    ' Wrap the form in a full-terminal background so cells outside the
    ' form bounds get painted every frame — otherwise modal overlays
    ' that extend past the form leave stale pixels when they close.
    s = s + "    DIM termBgStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(bgCol)).Width(m.Width).Height(m.Height)\n"
    s = s + "    DIM termBgStr AS STRING = termBgStyle.Render(\"\")\n"
    s = s + "    DIM termBgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(termBgStr)\n"
    s = s + "    DIM formLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(formStr).X(0).Y(0).Z(1)\n"
    s = s + "    DIM screenComp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(termBgLayer, formLayer)\n"
    s = s + "    DIM frameStr AS STRING = screenComp.Render()\n"
    s = s + "    IF m.Dialog.Active THEN\n"
    s = s + "        DIM dlgStr AS STRING\n"
    s = s + "        DIM dlgX AS INTEGER\n"
    s = s + "        DIM dlgY AS INTEGER\n"
    s = s + "        dlgStr, dlgX, dlgY = m.Dialog.Render()\n"
    s = s + "        IF dlgStr <> \"\" THEN\n"
    s = s + "            DIM bgL AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(frameStr)\n"
    s = s + "            DIM dlgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dlgStr).X(dlgX).Y(dlgY).Z(20)\n"
    s = s + "            DIM dlgComp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgL, dlgLayer)\n"
    s = s + "            frameStr = dlgComp.Render()\n"
    s = s + "        END IF\n"
    s = s + "    END IF\n"
    ' ComboBox dropdown overlay.
    s = s + "    IF m.DropActive AND m.DropIdx >= 0 AND m.DropIdx < LEN(m.Widgets) THEN\n"
    s = s + "        DIM ddCb AS WState = m.Widgets[m.DropIdx]\n"
    s = s + "        DIM ddIts AS []STRING = strings.Split(ddCb.Items, \";\")\n"
    s = s + "        DIM ddRows AS INTEGER = LEN(ddIts)\n"
    s = s + "        IF ddRows > 8 THEN ddRows = 8\n"
    s = s + "        IF ddRows < 1 THEN ddRows = 1\n"
    s = s + "        DIM ddWInner AS INTEGER = ddCb.W - 2\n"
    s = s + "        IF ddWInner < 1 THEN ddWInner = 1\n"
    s = s + "        DIM ddBox AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#16161e\")).Foreground(lipgloss.Color(\"#a9b1d6\")).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(\"#7dcfff\")).Width(ddWInner)\n"
    s = s + "        DIM ddSel AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#7dcfff\")).Foreground(lipgloss.Color(\"#1a1b2e\"))\n"
    s = s + "        DIM ddLines AS []STRING\n"
    s = s + "        DIM ddOff AS INTEGER = 0\n"
    s = s + "        IF m.DropCursor >= ddRows THEN ddOff = m.DropCursor - ddRows + 1\n"
    s = s + "        DIM ddJ AS INTEGER\n"
    s = s + "        FOR ddJ = 0 TO ddRows - 1\n"
    s = s + "            DIM ddIdx AS INTEGER = ddOff + ddJ\n"
    s = s + "            DIM ddLine AS STRING = \"\"\n"
    s = s + "            IF ddIdx >= 0 AND ddIdx < LEN(ddIts) THEN ddLine = ddIts[ddIdx]\n"
    s = s + "            IF LEN(ddLine) > ddWInner THEN ddLine = Mid(ddLine, 1, ddWInner)\n"
    s = s + "            DIM ddPad AS INTEGER = ddWInner - LEN(ddLine)\n"
    s = s + "            IF ddPad < 0 THEN ddPad = 0\n"
    s = s + "            DIM ddFull AS STRING = ddLine + strings.Repeat(\" \", ddPad)\n"
    s = s + "            IF ddIdx = m.DropCursor THEN ddFull = ddSel.Render(ddFull)\n"
    s = s + "            ddLines = APPEND(ddLines, ddFull)\n"
    s = s + "        NEXT ddJ\n"
    s = s + "        DIM ddStr AS STRING = ddBox.Render(strings.Join(ddLines, \"\\n\"))\n"
    s = s + "        DIM ddBgL AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(frameStr)\n"
    s = s + "        DIM ddLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(ddStr).X(ddCb.X + 1).Y(ddCb.Y + ddCb.H + 1).Z(25)\n"
    s = s + "        DIM ddComp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(ddBgL, ddLayer)\n"
    s = s + "        frameStr = ddComp.Render()\n"
    s = s + "    END IF\n"
    ' MenuBar dropdown overlay — walk widgets, render any MenuBar with
    ' Checked=TRUE as a dropdown below its active menu label.
    s = s + "    DIM mvI AS INTEGER\n"
    s = s + "    FOR mvI = 0 TO LEN(m.Widgets) - 1\n"
    s = s + "        IF m.Widgets[mvI].Kind = \"MenuBar\" AND m.Widgets[mvI].Checked THEN\n"
    s = s + "            DIM mvW AS WState = m.Widgets[mvI]\n"
    s = s + "            DIM mvLabs AS []STRING\n"
    s = s + "            DIM mvRaw AS []STRING\n"
    s = s + "            mvLabs, mvRaw = menuParse(mvW.Items)\n"
    s = s + "            DIM mvAct AS INTEGER = mvW.Selected\n"
    s = s + "            IF mvAct >= 0 AND mvAct < LEN(mvLabs) THEN\n"
    s = s + "                DIM mvIL AS []STRING\n"
    s = s + "                DIM mvIA AS []STRING\n"
    s = s + "                mvIL, mvIA = menuItems(mvRaw[mvAct])\n"
    s = s + "                _ = mvIA\n"
    s = s + "                DIM mvDX AS INTEGER = 0\n"
    s = s + "                DIM mvP AS INTEGER\n"
    s = s + "                FOR mvP = 0 TO mvAct - 1\n"
    s = s + "                    mvDX = mvDX + LEN(mvLabs[mvP]) + 2\n"
    s = s + "                NEXT mvP\n"
    s = s + "                DIM mvWdth AS INTEGER = 0\n"
    s = s + "                DIM mvQ AS INTEGER\n"
    s = s + "                FOR mvQ = 0 TO LEN(mvIL) - 1\n"
    s = s + "                    IF LEN(mvIL[mvQ]) > mvWdth THEN mvWdth = LEN(mvIL[mvQ])\n"
    s = s + "                NEXT mvQ\n"
    s = s + "                IF mvWdth < 10 THEN mvWdth = 10\n"
    s = s + "                DIM mvBox AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#16161e\")).Foreground(lipgloss.Color(\"#a9b1d6\")).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(\"#7dcfff\")).Width(mvWdth + 2)\n"
    s = s + "                DIM mvCur AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(\"#7dcfff\")).Foreground(lipgloss.Color(\"#1a1b2e\"))\n"
    s = s + "                DIM mvSep AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(\"#3b3d5e\"))\n"
    s = s + "                DIM mvLines AS []STRING\n"
    s = s + "                DIM mvR AS INTEGER\n"
    s = s + "                FOR mvR = 0 TO LEN(mvIL) - 1\n"
    s = s + "                    DIM mvText AS STRING\n"
    s = s + "                    IF mvIL[mvR] = \"-\" THEN\n"
    s = s + "                        mvText = mvSep.Render(strings.Repeat(\"─\", mvWdth))\n"
    s = s + "                    ELSE\n"
    s = s + "                        DIM mvLine AS STRING = mvIL[mvR]\n"
    s = s + "                        IF LEN(mvLine) > mvWdth THEN mvLine = Mid(mvLine, 1, mvWdth)\n"
    s = s + "                        DIM mvPad AS INTEGER = mvWdth - LEN(mvLine)\n"
    s = s + "                        IF mvPad < 0 THEN mvPad = 0\n"
    s = s + "                        mvText = mvLine + strings.Repeat(\" \", mvPad)\n"
    s = s + "                        IF mvR = mvW.Offset THEN mvText = mvCur.Render(mvText)\n"
    s = s + "                    END IF\n"
    s = s + "                    mvLines = APPEND(mvLines, mvText)\n"
    s = s + "                NEXT mvR\n"
    s = s + "                DIM mvStr AS STRING = mvBox.Render(strings.Join(mvLines, \"\\n\"))\n"
    s = s + "                DIM mvBgL AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(frameStr)\n"
    s = s + "                DIM mvLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(mvStr).X(mvW.X + mvDX + 1).Y(mvW.Y + mvW.H + 1).Z(30)\n"
    s = s + "                DIM mvComp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(mvBgL, mvLayer)\n"
    s = s + "                frameStr = mvComp.Render()\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    s = s + "    NEXT mvI\n"
    s = s + "    DIM v AS tea.View = tea.NewView(frameStr)\n"
    s = s + "    v.AltScreen = TRUE\n"
    s = s + "    v.MouseMode = tea.MouseModeCellMotion\n"
    s = s + "    RETURN v\n"
    s = s + "END FUNCTION\n\n"
    RETURN s
END FUNCTION

' emitMain writes the program entry point.
FUNCTION emitMain() AS STRING
    DIM s AS STRING = ""
    s = s + "SUB Main()\n"
    s = s + "    DIM model AS Model = NewModel()\n"
    s = s + "    DIM prog AS POINTER TO tea.Program = tea.NewProgram(model, tea.WithoutSignalHandler())\n"
    s = s + "    DIM finalModel AS tea.Model\n"
    s = s + "    DIM err AS ERROR\n"
    s = s + "    finalModel, err = prog.Run()\n"
    s = s + "    IF err <> NIL THEN\n"
    s = s + "        fmt.Fprintf(os.Stderr, \"error: %v\\n\", err)\n"
    s = s + "        os.Exit(1)\n"
    s = s + "    END IF\n"
    s = s + "    _ = finalModel\n"
    s = s + "END SUB\n"
    RETURN s
END FUNCTION

' emitTools writes per-tool runtime glue:
'   - SUB <id>_Show() — sets gPendingDialog so the next Update tick
'     transitions the model into dialog mode.
'   - SUB dispatchFileSelected(toolId, path) — routes a selection back
'     to <toolId>_FileSelected(path) if the user defined it (otherwise
'     emitFileSelectedStubs supplies an empty stub).
FUNCTION emitTools(form AS Form) AS STRING
    DIM s AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Tools) - 1
        DIM t AS ToolEntry = form.Tools[i]
        IF t.Kind = "FileDialog" THEN
            s = s + "SUB " + t.Id + "_Show()\n"
            s = s + "    gPendingDialog = " + dbasStr(t.Id) + "\n"
            s = s + "END SUB\n\n"
        END IF
    NEXT i
    s = s + "SUB dispatchFileSelected(toolId AS STRING, path AS STRING)\n"
    FOR i = 0 TO LEN(form.Tools) - 1
        DIM tt AS ToolEntry = form.Tools[i]
        IF tt.Kind = "FileDialog" THEN
            s = s + "    IF toolId = " + dbasStr(tt.Id) + " THEN " + tt.Id + "_FileSelected(path)\n"
        END IF
    NEXT i
    s = s + "END SUB\n\n"
    RETURN s
END FUNCTION

' emitToolStubs emits empty <id>_FileSelected stubs for any FileDialog
' tool whose handler the user hasn't defined.
FUNCTION emitToolStubs(form AS Form, defined AS []STRING) AS STRING
    DIM s AS STRING = ""
    DIM emitted AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Tools) - 1
        DIM t AS ToolEntry = form.Tools[i]
        IF t.Kind = "FileDialog" THEN
            DIM nm AS STRING = t.Id + "_FileSelected"
            IF NOT subDefined(nm, defined) THEN
                IF NOT emitted THEN
                    s = s + "' Auto-stubs for FileDialog _FileSelected handlers not yet defined.\n"
                    emitted = TRUE
                END IF
                s = s + "SUB " + nm + "(path AS STRING)\n"
                s = s + "END SUB\n\n"
            END IF
        END IF
    NEXT i
    RETURN s
END FUNCTION

' emitFileDialogRuntime reads internal/runtime/filedialog.dbas and
' inlines its contents into the generated program. Searched in three
' places: $DBTUI_RUNTIME_DIR, alongside the DBtui binary, and the
' development-tree default. Falls back to a stub if none found.
FUNCTION emitFileDialogRuntime() AS STRING
    DIM candidates AS []STRING
    DIM envDir AS STRING = os.Getenv("DBTUI_RUNTIME_DIR")
    IF envDir <> "" THEN candidates = APPEND(candidates, filepath.Join(envDir, "filedialog.dbas"))
    DIM exe AS STRING
    DIM exeErr AS ERROR
    exe, exeErr = os.Executable()
    IF exeErr = NIL THEN
        DIM exeDir AS STRING = filepath.Dir(exe)
        candidates = APPEND(candidates, filepath.Join(exeDir, "internal", "runtime", "filedialog.dbas"))
    END IF
    candidates = APPEND(candidates, "/home/zditech/DBasic/examples/DBtui/internal/runtime/filedialog.dbas")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(candidates) - 1
        DIM data AS BYTES
        DIM err AS ERROR
        data, err = os.ReadFile(candidates[i])
        IF err = NIL THEN
            RETURN "' ---- FileDialog runtime (inlined from " + candidates[i] + ") ----\n" + string(data) + "\n"
        END IF
    NEXT i
    RETURN "' ---- FileDialog runtime: not found, dialog calls will fail ----\n"
END FUNCTION

' emitPropertyGridRender reads internal/widgets/propertygrid_render.dbas
' (the shared value-cell renderer used by both DBtui and generated
' programs) and inlines its contents — minus the IMPORT lines, which
' are already present at the top of the generated program.
FUNCTION emitPropertyGridRender() AS STRING
    DIM candidates AS []STRING
    DIM envDir AS STRING = os.Getenv("DBTUI_RUNTIME_DIR")
    IF envDir <> "" THEN candidates = APPEND(candidates, filepath.Join(envDir, "propertygrid_render.dbas"))
    DIM exe AS STRING
    DIM exeErr AS ERROR
    exe, exeErr = os.Executable()
    IF exeErr = NIL THEN
        DIM exeDir AS STRING = filepath.Dir(exe)
        candidates = APPEND(candidates, filepath.Join(exeDir, "internal", "widgets", "propertygrid_render.dbas"))
    END IF
    candidates = APPEND(candidates, "/home/zditech/DBasic/examples/DBtui/internal/widgets/propertygrid_render.dbas")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(candidates) - 1
        DIM data AS BYTES
        DIM err AS ERROR
        data, err = os.ReadFile(candidates[i])
        IF err = NIL THEN
            ' Strip leading IMPORT lines — they'll collide with the
            ' imports already at the top of the generated program.
            DIM src AS STRING = string(data)
            DIM lines AS []STRING = strings.Split(src, "\n")
            DIM out AS []STRING
            DIM j AS INTEGER
            FOR j = 0 TO LEN(lines) - 1
                IF NOT strings.HasPrefix(strings.TrimSpace(lines[j]), "IMPORT ") THEN
                    out = APPEND(out, lines[j])
                END IF
            NEXT j
            RETURN "' ---- PropertyGrid render helper (inlined from " + candidates[i] + ") ----\n" + strings.Join(out, "\n") + "\n"
        END IF
    NEXT i
    RETURN "' ---- PropertyGrid render helper: not found ----\n"
END FUNCTION

' GenerateProgram is the public entry point. Returns the .dbas source.
FUNCTION GenerateProgram(p AS Project) AS STRING
    ' Find the start form (or the first form if none is named).
    DIM startIdx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(p.Forms) - 1
        IF p.Forms[i].Name = p.StartForm THEN startIdx = i
    NEXT i
    IF startIdx < 0 AND LEN(p.Forms) > 0 THEN startIdx = 0
    DIM form AS Form
    IF startIdx >= 0 THEN form = p.Forms[startIdx]

    DIM userCode AS STRING = readUserCode(form.Code)
    DIM defined AS []STRING = findDefinedSubs(userCode)

    DIM s AS STRING = ""
    s = s + emitHeader(p)
    s = s + emitFileDialogRuntime()
    s = s + emitPropertyGridRender()
    s = s + emitNewModel(form)
    s = s + emitDispatchClick(form)
    s = s + emitDispatchChange(form)
    s = s + emitSelectRadio()
    s = s + emitTreeHelper()
    s = s + emitMenuHelpers()
    s = s + emitDispatchMenuAction(form)
    s = s + emitPropertyGridHelpers()
    s = s + emitWidgetAccessors()
    s = s + emitSetFocus()
    s = s + emitLifecycle()
    s = s + emitRenderWidget()
    s = s + emitView(form)
    s = s + emitTools(form)
    IF userCode <> "" THEN
        s = s + "' ---- User code from " + form.Code + " ----\n"
        s = s + userCode
        IF NOT strings.HasSuffix(userCode, "\n") THEN s = s + "\n"
        s = s + "\n"
    END IF
    s = s + emitStubs(form, defined)
    s = s + emitToolStubs(form, defined)
    s = s + emitMain()
    RETURN s
END FUNCTION
