' -------------------------------------------------------------------------
' Render helpers — each returns a styled string. View() composes them.
' -------------------------------------------------------------------------

' -------------------------------------------------------------------------
' Modal hit-rects — package-level, written by renderModal each frame so
' the mouse handler in Update() can dispatch button clicks. View() is a
' value receiver (the bubbletea Model contract), so it can't mutate m;
' a small package-level scratchpad is the cleanest workaround.
'
' Coordinates are stored RELATIVE to the rendered modal's top-left;
' View() also stashes the screen-origin where it placed the modal, so
' the click handler converts (screen X, Y) → (modal X, Y) → button idx.
' -------------------------------------------------------------------------
TYPE ModalBtnHit
    DIM X   AS INTEGER  ' column inside the modal (0-based, includes frame)
    DIM Y   AS INTEGER  ' row    inside the modal
    DIM W   AS INTEGER  ' visible width of the rendered button
    DIM H   AS INTEGER  ' visible height (always 3 for the rounded border)
    DIM Idx AS INTEGER  ' which ModalButtons[] entry this rect represents
END TYPE

DIM modalBtnRects   AS []ModalBtnHit
DIM modalLastOrigX  AS INTEGER
DIM modalLastOrigY  AS INTEGER
DIM modalLastW      AS INTEGER  ' rendered width of last modal (incl. border)
DIM modalLastH      AS INTEGER  ' rendered height of last modal (incl. border)

' Color-picker origin — written by View() each frame it composites the
' picker, so the click handler can map a screen click onto a swatch.
DIM cpLastOrigX AS INTEGER
DIM cpLastOrigY AS INTEGER

' Enum-dropdown origin + size — written by View() each frame it composites
' the multiselect list, so the click handler can map a click to an option.
DIM epLastOrigX AS INTEGER
DIM epLastOrigY AS INTEGER
DIM epLastW     AS INTEGER
DIM epLastN     AS INTEGER

' Widgets palette — number of kind rows visible this frame, stashed by
' renderRightPane so the wheel handler clamps PaletteScroll to exactly what
' the render shows (no geometry guessing).
DIM palLastVisible AS INTEGER

' Menu Editor hit zones — a table of clickable regions written by
' renderMenuEditor each frame (content-relative: one cell in from the
' rounded border at the stashed origin). Every interactive element (fields,
' flag checkboxes, toolbar ops, node rows, OK/Cancel) registers a zone with
' an action string; menuEdAction maps a screen click to that action so the
' whole editor is mouse-drivable. meAddZone appends; menuEdAction scans.
DIM meLastOrigX AS INTEGER
DIM meLastOrigY AS INTEGER
DIM meZRow AS []INTEGER
DIM meZX0  AS []INTEGER
DIM meZX1  AS []INTEGER
DIM meZAct AS []STRING

SUB meZonesReset()
    meZRow = NIL
    meZX0  = NIL
    meZX1  = NIL
    meZAct = NIL
END SUB

SUB meAddZone(row AS INTEGER, x0 AS INTEGER, x1 AS INTEGER, act AS STRING)
    meZRow = APPEND(meZRow, row)
    meZX0  = APPEND(meZX0, x0)
    meZX1  = APPEND(meZX1, x1)
    meZAct = APPEND(meZAct, act)
END SUB

' menuEdAction — screen (mx,my) → the action string of the zone it lands in,
' or "" if none. First match wins.
FUNCTION menuEdAction(mx AS INTEGER, my AS INTEGER) AS STRING
    DIM cy AS INTEGER = my - (meLastOrigY + 1)
    DIM cx AS INTEGER = mx - (meLastOrigX + 1)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(meZRow) - 1
        IF meZRow[i] = cy AND cx >= meZX0[i] AND cx <= meZX1[i] THEN RETURN meZAct[i]
    NEXT i
    RETURN ""
END FUNCTION

' enumOptionAt — map a screen (mx,my) onto an option index inside the open
' enum dropdown, or -1 if outside. Geometry: rounded border (1) on each
' side; option j sits on the row at origin+1+j, columns origin+1..+W-2.
FUNCTION enumOptionAt(mx AS INTEGER, my AS INTEGER) AS INTEGER
    DIM rel AS INTEGER = my - (epLastOrigY + 1)
    IF rel < 0 OR rel >= epLastN THEN RETURN 0 - 1
    IF mx <= epLastOrigX OR mx >= epLastOrigX + epLastW - 1 THEN RETURN 0 - 1
    RETURN rel
END FUNCTION

' colorSwatchAt — map a screen (mx,my) onto a 0..255 palette index inside
' the open color picker, or -1 if the click is outside the 16x16 grid.
' Geometry: frame border (1) + horizontal padding (1) on the left, and
' border (1) + header row (1) on top, so the grid's top-left content cell
' is at (origin+2, origin+2). Each swatch is 2 cells wide, 1 tall.
FUNCTION colorSwatchAt(mx AS INTEGER, my AS INTEGER) AS INTEGER
    DIM gx AS INTEGER = cpLastOrigX + 2
    DIM gy AS INTEGER = cpLastOrigY + 2
    DIM rel AS INTEGER = my - gy
    IF rel < 0 OR rel > 15 THEN RETURN 0 - 1
    DIM col AS INTEGER = (mx - gx) / 2
    IF mx - gx < 0 OR col < 0 OR col > 15 THEN RETURN 0 - 1
    RETURN rel * 16 + col
END FUNCTION

' makeBgSpacer — build a `w`x`h` rectangle of spaces, every row
' painted with `style`'s background. Used to fill the gaps between
' modal buttons (and the left/right strips of the button row) with
' the modal's own bg, so no untreated terminal-default cells leak
' through the multi-row layout.
FUNCTION makeBgSpacer(style AS lipgloss.Style, w AS INTEGER, h AS INTEGER) AS STRING
    IF w <= 0 OR h <= 0 THEN RETURN ""
    DIM row AS STRING = style.Render(strings.Repeat(" ", w))
    DIM lines AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO h - 1
        lines = APPEND(lines, row)
    NEXT i
    RETURN strings.Join(lines, "\n")
END FUNCTION

' renderModalButtonRow — flat right-justified [ Label ] [ Label ] row
' matching the FileDialog button style. Single row, focused button
' gets the #2d4f67 highlight.
FUNCTION renderModalButtonRow(buttons AS []STRING, activeIdx AS INTEGER, innerW AS INTEGER) AS STRING
    DIM btnStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM btnFocused AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#2d4f67")).Foreground(lipgloss.Color(cFg)).Bold(TRUE)
    DIM bgStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))

    DIM totalW AS INTEGER = 0
    DIM labels AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[i] + " ]"
        labels = APPEND(labels, lbl)
        totalW = totalW + lipgloss.Width(lbl)
        IF i < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT i
    DIM pad AS INTEGER = innerW - totalW
    IF pad < 0 THEN pad = 0

    DIM out AS STRING = bgStyle.Render(strings.Repeat(" ", pad))
    FOR i = 0 TO LEN(labels) - 1
        IF i = activeIdx THEN
            out = out + btnFocused.Render(labels[i])
        ELSE
            out = out + btnStyle.Render(labels[i])
        END IF
        IF i < LEN(labels) - 1 THEN out = out + bgStyle.Render("  ")
    NEXT i
    RETURN out
END FUNCTION

' recordFlatModalBtnRects — compute each button's rect for the flat
' right-justified row. Modal-local coords; View() shifts by the modal
' origin. The button row's Y comes from the caller (depends on whether
' the modal has an input field above it).
SUB recordFlatModalBtnRects(buttons AS []STRING, innerW AS INTEGER, rowY AS INTEGER)
    DIM hits AS []ModalBtnHit
    DIM totalW AS INTEGER = 0
    DIM widths AS []INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(buttons) - 1
        DIM lbl AS STRING = "[ " + buttons[i] + " ]"
        DIM bw AS INTEGER = lipgloss.Width(lbl)
        widths = APPEND(widths, bw)
        totalW = totalW + bw
        IF i < LEN(buttons) - 1 THEN totalW = totalW + 2
    NEXT i
    DIM pad AS INTEGER = innerW - totalW
    IF pad < 0 THEN pad = 0
    ' First button's X = frame border (1) + left padding (2) + right-
    ' justification pad. Each subsequent button shifts by its width + 2.
    DIM x AS INTEGER = 3 + pad
    FOR i = 0 TO LEN(widths) - 1
        DIM hit AS ModalBtnHit
        hit.X = x
        hit.Y = rowY
        hit.W = widths[i]
        hit.H = 1
        hit.Idx = i
        hits = APPEND(hits, hit)
        x = x + widths[i] + 2
    NEXT i
    modalBtnRects = hits
END SUB

' padRight — right-pad s with `fill` characters so its visible width is
' `width` cells. Uses lipgloss.Width so multi-byte glyphs count as 1.
FUNCTION padRight(s AS STRING, width AS INTEGER, fill AS STRING) AS STRING
    DIM cur AS INTEGER = lipgloss.Width(s)
    IF cur >= width THEN RETURN s
    RETURN s + strings.Repeat(fill, width - cur)
END FUNCTION

' renderMenuLabel — render one "(X)label" menu/item label with the
' hotkey letter restyled. `base` styles non-hotkey chars; `hot`
' styles the bracketed letter (typically peach + bold + underline).
FUNCTION renderMenuLabel(label AS STRING, bs AS lipgloss.Style, hot AS lipgloss.Style) AS STRING
    DIM i AS INTEGER = strings.Index(label, "(")
    IF i < 0 OR i + 2 >= LEN(label) OR Mid(label, i + 3, 1) <> ")" THEN
        RETURN bs.Render(label)
    END IF
    DIM pre AS STRING = ""
    IF i > 0 THEN pre = Mid(label, 1, i)
    DIM letter AS STRING = Mid(label, i + 2, 1)
    DIM post AS STRING = ""
    IF i + 3 < LEN(label) THEN post = Mid(label, i + 4, LEN(label) - i - 3)
    RETURN bs.Render(pre) + hot.Render(letter) + bs.Render(post)
END FUNCTION

' renderMenuBar — top row. Walks Menus, renders each cell with " label "
' padding. Three states per cell, in priority order:
'   active  → inverted accent (the menu's dropdown is open)
'   hover   → softer accent tint (mouse is on this cell)
'   default → menubar bg
' Hotkey letter inside each label is always coloured peach.
FUNCTION renderMenuBar(m AS Model, width AS INTEGER) AS STRING
    DIM defBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg)).Bold(TRUE)
    DIM defHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM hovBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#3b3d5e")).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM hovHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#3b3d5e")).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM selHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    ' Resolve the hovered cell ONCE per render so the math doesn't
    ' have to re-walk for every menu item.
    DIM hoverCell AS INTEGER = 0 - 1
    IF m.HoverY = 0 THEN hoverCell = menuCellAt(m, m.HoverX)
    DIM out AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Menus) - 1
        DIM bs AS lipgloss.Style = defBase
        DIM hot  AS lipgloss.Style = defHot
        IF i = m.MenuActive THEN
            bs = selBase
            hot  = selHot
        ELSEIF i = hoverCell THEN
            bs = hovBase
            hot  = hovHot
        END IF
        DIM lab AS STRING = m.Menus[i].Label
        out = out + bs.Render(" ") + renderMenuLabel(lab, bs, hot) + bs.Render(" ")
    NEXT i
    ' Fill the rest of the row so the bar bg extends to the right edge.
    DIM consumed AS INTEGER = lipgloss.Width(out)
    IF consumed < width THEN
        out = out + defBase.Render(strings.Repeat(" ", width - consumed))
    END IF
    RETURN out
END FUNCTION

' menuCellWidth — visible width (in cells) of one top-menu cell.
' renderMenuBar pads each cell as " label " — so visible width is
' LEN(stripped label) + 2 (one leading + one trailing space).
FUNCTION menuCellWidth(m AS Model, idx AS INTEGER) AS INTEGER
    IF idx < 0 OR idx >= LEN(m.Menus) THEN RETURN 0
    RETURN LEN(menuStrip(m.Menus[idx].Label)) + 2
END FUNCTION

' menuOffsetX — leading X (in cells) of the dropdown for menu `idx`.
' Sum of preceding menu cell widths so the dropdown opens directly
' below its parent label.
FUNCTION menuOffsetX(m AS Model, idx AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO idx - 1
        off = off + menuCellWidth(m, i)
    NEXT i
    RETURN off
END FUNCTION

' menuCellAt — return the menu index whose top-row cell contains the
' screen X column `mx`. Returns -1 when `mx` lands outside any cell
' (e.g. past the last menu in the filler area).
FUNCTION menuCellAt(m AS Model, mx AS INTEGER) AS INTEGER
    DIM off AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Menus) - 1
        DIM w AS INTEGER = menuCellWidth(m, i)
        IF mx >= off AND mx < off + w THEN RETURN i
        off = off + w
    NEXT i
    RETURN 0 - 1
END FUNCTION

' dropdownItemAt — translate a screen (mx,my) inside an open dropdown
' to an item index, or -1 if outside. The dropdown's framed top
' border sits at y = 1 (menubar row is y = 0) so item 0 occupies
' y = 2, item 1 occupies y = 3, etc. The horizontal bounds are
' [menuOffsetX, menuOffsetX + width).
FUNCTION dropdownItemAt(m AS Model, mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF m.MenuActive < 0 OR m.MenuActive >= LEN(m.Menus) THEN RETURN 0 - 1
    DIM items AS []MenuItem = m.Menus[m.MenuActive].Items
    ' Recompute the dropdown's drawn width — same formula as the
    ' renderer: max stripped label length + 2 inner padding, then
    ' plus 2 for the border.
    DIM maxW AS INTEGER = 0
    DIM ix AS INTEGER
    FOR ix = 0 TO LEN(items) - 1
        IF NOT items[ix].IsSep THEN
            DIM w AS INTEGER = LEN(menuStrip(items[ix].Label))
            IF w > maxW THEN maxW = w
        END IF
    NEXT ix
    IF maxW < 12 THEN maxW = 12
    DIM outerW AS INTEGER = maxW + 2 + 2
    DIM x0 AS INTEGER = menuOffsetX(m, m.MenuActive)
    IF mx < x0 OR mx >= x0 + outerW THEN RETURN 0 - 1
    ' Item rows start at y=2 (after menubar + dropdown top border).
    DIM row AS INTEGER = my - 2
    IF row < 0 OR row >= LEN(items) THEN RETURN 0 - 1
    IF items[row].IsSep THEN RETURN 0 - 1
    RETURN row
END FUNCTION

' tabAtX — translate a screen column on the tabs caption row to a
' tab index. Returns -1 if `mx` lands on filler dashes or the leading
' dash. Together with closeXOnTab() below, gives full tab hit-test.
FUNCTION tabAtX(m AS Model, mx AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        DIM x0 AS INTEGER = tabCellX(m, i)
        DIM x1 AS INTEGER = x0 + tabCellWidth(m, i)
        IF mx >= x0 AND mx < x1 THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' closeXOnTab — TRUE when the screen column `mx` lands exactly on
' the "✕" glyph for tab `i` (the second-to-last cell of its [...] box).
FUNCTION closeXOnTab(m AS Model, i AS INTEGER, mx AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= LEN(m.Tabs) THEN RETURN FALSE
    DIM x0 AS INTEGER = tabCellX(m, i)
    DIM xClose AS INTEGER = x0 + tabCellWidth(m, i) - 3
    IF mx = xClose THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' treeNodeAt — return the TreeNodes index the user clicked on, or -1
' if the click landed outside the tree's content area.
'
' Coordinate layout: View() composes menubar (y=0), body (y=1..h-2),
' statusbar (y=h-1). Left pane is `titledBox` at body x=0 — top row
' at y=1, body content rows start at y=2 and span `bodyH-2` lines
' (the bodyBox has BorderTop=FALSE so its first row IS the first
' tree row). Left border is at x=0, right border at x=leftW-1.
FUNCTION treeNodeAt(m AS Model, mx AS INTEGER, my AS INTEGER, leftW AS INTEGER, bodyH AS INTEGER) AS INTEGER
    IF mx < 1 OR mx >= leftW - 1 THEN RETURN 0 - 1
    DIM row AS INTEGER = my - 2
    IF row < 0 THEN RETURN 0 - 1
    DIM idx AS INTEGER = m.TreeOffset + row
    IF idx < 0 OR idx >= LEN(m.TreeNodes) THEN RETURN 0 - 1
    ' Visible-rows cap so clicks below the last drawn row don't
    ' resolve to a phantom node.
    IF row >= bodyH - 2 THEN RETURN 0 - 1
    RETURN idx
END FUNCTION

' renderDropdown — produce the framed dropdown for the active menu.
' Items get hotkey emphasis; the cursor row inverts colors. Separators
' render as a horizontal line spanning the dropdown's inner width.
FUNCTION renderDropdown(m AS Model) AS STRING
    IF m.MenuActive < 0 OR m.MenuActive >= LEN(m.Menus) THEN RETURN ""
    DIM items AS []MenuItem = m.Menus[m.MenuActive].Items
    ' Compute width = max item label length + padding.
    DIM maxW AS INTEGER = 0
    DIM ix AS INTEGER
    FOR ix = 0 TO LEN(items) - 1
        IF NOT items[ix].IsSep THEN
            DIM w AS INTEGER = LEN(menuStrip(items[ix].Label))
            IF w > maxW THEN maxW = w
        END IF
    NEXT ix
    IF maxW < 12 THEN maxW = 12
    DIM inner AS INTEGER = maxW + 2

    DIM rowBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM rowHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM selHot  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE).Underline(TRUE)
    DIM sepStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cBorder))

    DIM lines AS []STRING
    DIM j AS INTEGER
    FOR j = 0 TO LEN(items) - 1
        IF items[j].IsSep THEN
            lines = APPEND(lines, sepStyle.Render(strings.Repeat("─", inner)))
        ELSE
            DIM bs AS lipgloss.Style = rowBase
            DIM hot  AS lipgloss.Style = rowHot
            IF j = m.MenuItemIdx THEN
                bs = selBase
                hot  = selHot
            END IF
            DIM rendered AS STRING = renderMenuLabel(items[j].Label, bs, hot)
            DIM cur AS INTEGER = lipgloss.Width(rendered)
            ' Left-pad 1, right-pad to width.
            DIM padR AS INTEGER = inner - 1 - cur
            IF padR < 0 THEN padR = 0
            lines = APPEND(lines, bs.Render(" ") + rendered + bs.Render(strings.Repeat(" ", padR)))
        END IF
    NEXT j
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg))
    RETURN frame.Render(body)
END FUNCTION

' ctxEventMaxW — shared width basis for the widget event popup so the
' renderer and the hit-tester agree on geometry. Returns the longest
' event-name length for the popup's widget, floored at 10.
FUNCTION ctxEventMaxW(m AS Model) AS INTEGER
    IF m.CtxWidget < 0 THEN RETURN 10
    IF NOT hasActiveTab(m) THEN RETURN 10
    IF m.CtxWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN 10
    DIM kind AS STRING = m.Tabs[m.TabIdx].Form.Widgets[m.CtxWidget].Kind
    DIM evs AS []STRING = widgetEvents(kind)
    DIM maxW AS INTEGER = 0
    DIM ix AS INTEGER
    FOR ix = 0 TO LEN(evs) - 1
        IF LEN(evs[ix]) > maxW THEN maxW = LEN(evs[ix])
    NEXT ix
    IF maxW < 10 THEN maxW = 10
    RETURN maxW
END FUNCTION

' renderContextMenu — the right-click widget "events" popup: a framed
' list of the selected widget's event names, highlighting CtxItem.
' Mirrors renderDropdown's styling; empty string when closed.
FUNCTION renderContextMenu(m AS Model) AS STRING
    IF m.CtxWidget < 0 THEN RETURN ""
    IF NOT hasActiveTab(m) THEN RETURN ""
    IF m.CtxWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN ""
    DIM kind AS STRING = m.Tabs[m.TabIdx].Form.Widgets[m.CtxWidget].Kind
    DIM evs AS []STRING = widgetEvents(kind)
    DIM inner AS INTEGER = ctxEventMaxW(m) + 2

    DIM rowBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)

    DIM lines AS []STRING
    DIM j AS INTEGER
    FOR j = 0 TO LEN(evs) - 1
        DIM bs AS lipgloss.Style = rowBase
        IF j = m.CtxItem THEN bs = selBase
        DIM lbl AS STRING = evs[j]
        DIM padR AS INTEGER = inner - 1 - LEN(lbl)
        IF padR < 0 THEN padR = 0
        lines = APPEND(lines, bs.Render(" " + lbl + strings.Repeat(" ", padR)))
    NEXT j
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg))
    RETURN frame.Render(body)
END FUNCTION

' renderColorPicker — the 256-color swatch grid modal. A 16x16 grid of
' 2-cell background-painted swatches (ANSI index = row*16 + col). The
' cursor cell shows "[]" brackets in the IDE background color; the header
' names the target (form/widget, fg/bg), the numeric index, and a wide
' preview swatch. Returns "" when the picker is closed. Composited into
' the View at a high Z-layer, like the other modals.
FUNCTION renderColorPicker(m AS Model) AS STRING
    IF NOT m.CPActive THEN RETURN ""
    DIM tgt AS STRING = "Fg"
    IF strings.HasSuffix(m.CPTarget, "bg") THEN tgt = "Bg"
    DIM scope AS STRING = "Widget"
    IF strings.HasPrefix(m.CPTarget, "form") THEN scope = "Form"
    DIM idxStr AS STRING = strconv.Itoa(m.CPIdx)
    DIM preview AS STRING = lipgloss.NewStyle().Background(lipgloss.Color(idxStr)).Render("        ")
    DIM head AS STRING = scope + " " + tgt + "  index " + idxStr + "  " + preview
    DIM gridLines AS []STRING
    DIM gr AS INTEGER
    FOR gr = 0 TO 15
        DIM rowS AS STRING = ""
        DIM gc AS INTEGER
        FOR gc = 0 TO 15
            DIM ci AS INTEGER = gr * 16 + gc
            DIM cstr AS STRING = strconv.Itoa(ci)
            IF ci = m.CPIdx THEN
                rowS = rowS + lipgloss.NewStyle().Background(lipgloss.Color(cstr)).Foreground(lipgloss.Color(cBg)).Render("[]")
            ELSE
                rowS = rowS + lipgloss.NewStyle().Background(lipgloss.Color(cstr)).Render("  ")
            END IF
        NEXT gc
        gridLines = APPEND(gridLines, rowS)
    NEXT gr
    DIM grid AS STRING = strings.Join(gridLines, "\n")
    DIM hint AS STRING = "↑↓←→ move · Enter pick · x clear · Esc cancel"
    DIM body AS STRING = head + "\n" + grid + "\n" + hint
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg)).Padding(0, 1)
    RETURN frame.Render(body)
END FUNCTION

' renderEnumPicker — the multiselect dropdown: a bordered vertical list of
' options with the current one highlighted. Mirrors renderContextMenu.
' Returns "" when closed. Composited at (EnumX, EnumY) by View().
FUNCTION renderEnumPicker(m AS Model) AS STRING
    IF NOT m.EnumActive THEN RETURN ""
    DIM inner AS INTEGER = 0
    DIM j AS INTEGER
    FOR j = 0 TO LEN(m.EnumOpts) - 1
        IF LEN(m.EnumOpts[j]) > inner THEN inner = LEN(m.EnumOpts[j])
    NEXT j
    inner = inner + 2
    DIM rowBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM selBase AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM lines AS []STRING
    DIM k AS INTEGER
    FOR k = 0 TO LEN(m.EnumOpts) - 1
        DIM bs AS lipgloss.Style = rowBase
        IF k = m.EnumIdx THEN bs = selBase
        DIM lbl AS STRING = m.EnumOpts[k]
        DIM padR AS INTEGER = inner - 1 - LEN(lbl)
        IF padR < 0 THEN padR = 0
        lines = APPEND(lines, bs.Render(" " + lbl + strings.Repeat(" ", padR)))
    NEXT k
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg))
    RETURN frame.Render(body)
END FUNCTION

' -------------------------------------------------------------------------
' Menu Editor renderer + small layout helpers.
' -------------------------------------------------------------------------

' mePad — right-pad s with spaces to w display cells (no truncation).
FUNCTION mePad(s AS STRING, w AS INTEGER) AS STRING
    DIM cur AS INTEGER = lipgloss.Width(s)
    IF cur >= w THEN RETURN s
    RETURN s + strings.Repeat(" ", w - cur)
END FUNCTION

' meChk — a [x] / [ ] checkbox glyph.
FUNCTION meChk(b AS BOOLEAN) AS STRING
    IF b THEN RETURN "[x]"
    RETURN "[ ]"
END FUNCTION

' meField — one labelled field row; shows the live input value plus a "_"
' cursor when that field is the active one (MenuEdField).
FUNCTION meField(m AS Model, label AS STRING, fieldIdx AS INTEGER, w AS INTEGER) AS STRING
    DIM val AS STRING = ""
    IF fieldIdx = 0 THEN val = m.MenuEdCapIn.Value()
    IF fieldIdx = 1 THEN val = m.MenuEdNameIn.Value()
    IF fieldIdx = 2 THEN val = m.MenuEdScIn.Value()
    DIM cur AS STRING = ""
    IF m.MenuEdField = fieldIdx THEN cur = "_"
    RETURN mePad(" " + label + " " + val + cur, w)
END FUNCTION

' meNodeLine — one menu-tree row: depth indent, caption, submenu arrow, and
' right-aligned tags (✓ checked, (off) disabled, shortcut). Separators show
' a rule. Always exactly w cells wide so the row background fills.
FUNCTION meNodeLine(nodes AS []MenuNode, idx AS INTEGER, w AS INTEGER) AS STRING
    DIM nd AS MenuNode = nodes[idx]
    DIM indent AS STRING = strings.Repeat("  ", nd.Depth)
    IF nd.IsSep THEN RETURN mePad(" " + indent + "──────── separator", w)
    DIM lab AS STRING = nd.Caption
    IF lab = "" THEN lab = "(unnamed)"
    DIM left AS STRING = " " + indent + lab
    IF menuIsSubmenu(nodes, idx) THEN left = left + " ▸"
    DIM tags AS STRING = ""
    IF nd.Checked THEN tags = tags + "✓ "
    IF nd.Disabled THEN tags = tags + "(off) "
    IF nd.Shortcut <> "" THEN tags = tags + nd.Shortcut
    IF tags = "" THEN RETURN mePad(left, w)
    DIM gap AS INTEGER = w - lipgloss.Width(left) - lipgloss.Width(tags) - 1
    IF gap < 1 THEN gap = 1
    RETURN left + strings.Repeat(" ", gap) + tags + " "
END FUNCTION

' renderMenuEditor — the visual Menu Editor modal. Returns "" when closed.
' Composited centered by View(), which stashes meLastOrigX/Y; this function
' stashes the content-relative list / button geometry for the hit-tests.
FUNCTION renderMenuEditor(m AS Model) AS STRING
    IF NOT m.MenuEdActive THEN RETURN ""
    DIM innerW AS INTEGER = 56
    DIM wname AS STRING = ""
    IF m.MenuEdWidget >= 0 AND m.MenuEdWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN wname = m.Tabs[m.TabIdx].Form.Widgets[m.MenuEdWidget].Name
    DIM rowBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM selBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM dimBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cBorder))
    DIM titleSt   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    meZonesReset()
    DIM lines AS []STRING
    ' Row 0: title.
    lines = APPEND(lines, titleSt.Render(mePad(" Menu Editor — " + wname, innerW)))
    ' Rows 1-3: editable fields — click the row to focus that field.
    lines = APPEND(lines, rowBase.Render(meField(m, "Caption: ", 0, innerW)))
    meAddZone(1, 0, innerW - 1, "field:0")
    lines = APPEND(lines, rowBase.Render(meField(m, "Name:    ", 1, innerW)))
    meAddZone(2, 0, innerW - 1, "field:1")
    lines = APPEND(lines, rowBase.Render(meField(m, "Shortcut:", 2, innerW)))
    meAddZone(3, 0, innerW - 1, "field:2")
    ' Row 4: flag checkboxes — click each to toggle. Track columns as built.
    DIM chkC AS BOOLEAN = FALSE
    DIM chkD AS BOOLEAN = FALSE
    DIM chkS AS BOOLEAN = FALSE
    IF m.MenuEdSel >= 0 AND m.MenuEdSel < LEN(m.MenuEdNodes) THEN
        chkC = m.MenuEdNodes[m.MenuEdSel].Checked
        chkD = m.MenuEdNodes[m.MenuEdSel].Disabled
        chkS = m.MenuEdNodes[m.MenuEdSel].IsSep
    END IF
    DIM flbl AS []STRING
    flbl = APPEND(flbl, meChk(chkC) + " Checked")
    flbl = APPEND(flbl, meChk(chkD) + " Disabled")
    flbl = APPEND(flbl, meChk(chkS) + " Separator")
    DIM fact AS []STRING
    fact = APPEND(fact, "toggle:checked")
    fact = APPEND(fact, "toggle:disabled")
    fact = APPEND(fact, "toggle:sep")
    DIM flags AS STRING = " Flags:"
    DIM fcol AS INTEGER = 7
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(flbl) - 1
        flags = flags + "  "
        fcol = fcol + 2
        meAddZone(4, fcol, fcol + LEN(flbl[fi]) - 1, fact[fi])
        flags = flags + flbl[fi]
        fcol = fcol + LEN(flbl[fi])
    NEXT fi
    lines = APPEND(lines, rowBase.Render(mePad(flags, innerW)))
    ' Row 5: operation toolbar — clickable buttons.
    DIM tlbl AS []STRING
    DIM tact AS []STRING
    tlbl = APPEND(tlbl, "Add")
    tact = APPEND(tact, "op:add")
    tlbl = APPEND(tlbl, "Del")
    tact = APPEND(tact, "op:del")
    tlbl = APPEND(tlbl, ">")
    tact = APPEND(tact, "op:indent")
    tlbl = APPEND(tlbl, "<")
    tact = APPEND(tact, "op:outdent")
    tlbl = APPEND(tlbl, "^")
    tact = APPEND(tact, "op:up")
    tlbl = APPEND(tlbl, "v")
    tact = APPEND(tact, "op:down")
    tlbl = APPEND(tlbl, "Sep")
    tact = APPEND(tact, "op:sep")
    DIM tbar AS STRING = " "
    DIM tcol AS INTEGER = 1
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(tlbl) - 1
        DIM btn AS STRING = "[" + tlbl[ti] + "]"
        meAddZone(5, tcol, tcol + LEN(btn) - 1, tact[ti])
        tbar = tbar + btn + " "
        tcol = tcol + LEN(btn) + 1
    NEXT ti
    lines = APPEND(lines, rowBase.Render(mePad(tbar, innerW)))
    ' Row 6: divider. Rows 7..: the node list (click a row to select it).
    lines = APPEND(lines, rowBase.Render(strings.Repeat("─", innerW)))
    DIM li AS INTEGER
    FOR li = 0 TO LEN(m.MenuEdNodes) - 1
        DIM ln AS STRING = meNodeLine(m.MenuEdNodes, li, innerW)
        DIM st AS lipgloss.Style = rowBase
        IF m.MenuEdNodes[li].IsSep THEN st = dimBase
        IF li = m.MenuEdSel THEN st = selBase
        lines = APPEND(lines, st.Render(ln))
        meAddZone(7 + li, 0, innerW - 1, "row:" + strconv.Itoa(li))
    NEXT li
    ' Trailing divider + OK / Cancel buttons.
    lines = APPEND(lines, rowBase.Render(strings.Repeat("─", innerW)))
    DIM btnRow AS INTEGER = 8 + LEN(m.MenuEdNodes)
    lines = APPEND(lines, rowBase.Render(mePad(" [ OK ]   [ Cancel ]", innerW)))
    meAddZone(btnRow, 1, 6, "ok")
    meAddZone(btnRow, 10, 19, "cancel")
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cMenuBg))
    RETURN frame.Render(body)
END FUNCTION

' ctxMenuItemAt — translate a screen (mx,my) inside the open event popup
' to an event index, or -1 if outside. The popup is composited at
' (CtxX, CtxY): top border at CtxY, item rows from CtxY+1; width matches
' renderContextMenu (inner = maxW+2, outer = maxW+4).
FUNCTION ctxMenuItemAt(m AS Model, mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF m.CtxWidget < 0 THEN RETURN 0 - 1
    IF NOT hasActiveTab(m) THEN RETURN 0 - 1
    IF m.CtxWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN 0 - 1
    DIM kind AS STRING = m.Tabs[m.TabIdx].Form.Widgets[m.CtxWidget].Kind
    DIM evs AS []STRING = widgetEvents(kind)
    DIM outerW AS INTEGER = ctxEventMaxW(m) + 2 + 2
    IF mx < m.CtxX OR mx >= m.CtxX + outerW THEN RETURN 0 - 1
    DIM row AS INTEGER = my - (m.CtxY + 1)
    IF row < 0 OR row >= LEN(evs) THEN RETURN 0 - 1
    RETURN row
END FUNCTION

' hintCell — render one " KEY=label" cell with the key in the hotkey
' colour and the label in dim menubar text. Used by renderStatusBar
' to build the right-aligned VBDOS-style strip.
FUNCTION hintCell(key AS STRING, label AS STRING) AS STRING
    DIM keyStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cHotkey)).Bold(TRUE)
    DIM lblStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cMenuFg))
    RETURN keyStyle.Render(key) + lblStyle.Render(" " + label)
END FUNCTION

' renderStatusBar — bottom row. Layout: status message on the left,
' optional cursor-position chip in the middle, key-hint strip on
' the right. The status text truncates with an ellipsis when it
' would overflow into the position/hints segments so those remain
' readable at any width.
FUNCTION renderStatusBar(width AS INTEGER, text AS STRING, pos AS STRING) AS STRING
    DIM barBg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg))
    DIM msgStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cStatusFg)).Italic(TRUE)
    DIM posStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cMenuBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)

    ' Build the hint strip. Each cell is two spaces apart.
    DIM hints AS STRING = ""
    hints = hints + hintCell("F5", "Run")    + barBg.Render("  ")
    hints = hints + hintCell("F8", "Check")  + barBg.Render("  ")
    hints = hints + hintCell("F10", "Menu")  + barBg.Render("  ")
    hints = hints + hintCell("F12", "Out")   + barBg.Render("  ")
    hints = hints + hintCell("^S", "Save")   + barBg.Render("  ")
    hints = hints + hintCell("^F", "Find")   + barBg.Render("  ")
    hints = hints + hintCell("^O", "Open")   + barBg.Render("  ")
    hints = hints + hintCell("^W", "Close")
    DIM hintsW AS INTEGER = lipgloss.Width(hints)

    ' Position chip — rendered when caller passes a non-empty `pos`.
    DIM posCell AS STRING = ""
    IF pos <> "" THEN
        posCell = posStyle.Render(" " + pos + " ") + barBg.Render("  ")
    END IF
    DIM posW AS INTEGER = lipgloss.Width(posCell)

    ' Status message, truncated to the remaining width.
    DIM msgRaw AS STRING = " " + text + " "
    DIM avail AS INTEGER = width - hintsW - posW - 1
    IF avail < 4 THEN avail = 4
    IF lipgloss.Width(msgRaw) > avail THEN
        msgRaw = Mid(msgRaw, 1, avail - 1) + "…"
    END IF
    DIM msgPadded AS STRING = msgStyle.Render(msgRaw) + barBg.Render(strings.Repeat(" ", avail - lipgloss.Width(msgRaw)))

    ' If the terminal is too narrow for any hints, just show the
    ' status message stretched the full width.
    IF width < hintsW + posW + 6 THEN
        RETURN msgStyle.Width(width).Render(" " + text)
    END IF
    RETURN msgPadded + posCell + hints
END FUNCTION

' titledBox — render `body` inside a bordered panel with `title`
' embedded in the top border. Mirrors the original DBtui's panel
' style. `focused` selects the border style: TRUE → square corners
' (the focused panel), FALSE → rounded corners (unfocused panel).
FUNCTION titledBox(title AS STRING, body AS STRING, width AS INTEGER, height AS INTEGER, focused AS BOOLEAN, rightHot AS BOOLEAN, leftHot AS BOOLEAN) AS STRING
    DIM tl AS STRING = "╭"
    DIM tr AS STRING = "╮"
    DIM borderObj AS lipgloss.Border = lipgloss.RoundedBorder()
    IF focused THEN
        tl = "┌"
        tr = "┐"
        borderObj = lipgloss.NormalBorder()
    END IF
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Italic(TRUE)
    ' A hovered (or dragging) splitter on the left/right edge accents
    ' that border column + corner so it reads as a grab handle.
    DIM hotStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cHotkey)).Bold(TRUE)
    DIM tlStyle AS lipgloss.Style = borderStyle
    DIM trStyle AS lipgloss.Style = borderStyle
    IF leftHot  THEN tlStyle = hotStyle
    IF rightHot THEN trStyle = hotStyle
    ' Top row: "{tl}─ title ──...──{tr}" (width chars total)
    DIM titleLen AS INTEGER = lipgloss.Width(" " + title + " ")
    DIM dashLen  AS INTEGER = width - 2 - 1 - titleLen
    IF dashLen < 0 THEN dashLen = 0
    DIM top AS STRING = tlStyle.Render(tl) + borderStyle.Render("─") + titleStyle.Render(" " + title + " ") + borderStyle.Render(strings.Repeat("─", dashLen)) + trStyle.Render(tr)
    ' Body box. Width(width) → total visible width includes borders.
    ' Border{Right,Left}Foreground tints just the splitter column.
    DIM rightCol AS STRING = cBorder
    DIM leftCol  AS STRING = cBorder
    IF rightHot THEN rightCol = cHotkey
    IF leftHot  THEN leftCol  = cHotkey
    DIM bodyBox AS lipgloss.Style = lipgloss.NewStyle().Border(borderObj).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderRightForeground(lipgloss.Color(rightCol)).BorderLeftForeground(lipgloss.Color(leftCol)).Width(width).Height(height - 1)
    RETURN top + "\n" + bodyBox.Render(body)
END FUNCTION

' nodeGlyph — the leading symbol for a tree row. "▾" = expanded folder,
' "▸" = collapsed folder, "◇" = leaf file. Matches the original DBtui.
FUNCTION nodeGlyph(m AS Model, n AS TreeNode) AS STRING
    IF n.IsDir THEN
        IF isExpanded(m, n.Path) THEN RETURN "▾"
        RETURN "▸"
    END IF
    RETURN "◇"
END FUNCTION

' renderTreeBody — produce the multi-line, indented + glyphed body for
' the tree. Row priority:
'   selected → solid accent bar
'   hovered  → subtle border-bg tint
'   default  → fg on background
FUNCTION renderTreeBody(m AS Model, innerW AS INTEGER, innerH AS INTEGER) AS STRING
    IF innerW < 1 THEN innerW = 1
    DIM cursorStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color("#2d4f67")).Foreground(lipgloss.Color(cFg)).Bold(TRUE).Width(innerW)
    DIM hoverStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cFg)).Width(innerW)
    DIM defStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(innerW)
    ' Resolve the hovered row ONCE. treeNodeAt expects the left-pane
    ' width and bodyH = innerH + 2 (it strips the title row + bottom
    ' border).
    DIM hoverRow AS INTEGER = treeNodeAt(m, m.HoverX, m.HoverY, m.LeftW, innerH + 2)
    DIM lines AS []STRING
    DIM total AS INTEGER = LEN(m.TreeNodes)
    DIM startI AS INTEGER = m.TreeOffset
    IF startI < 0 THEN startI = 0
    DIM endI AS INTEGER = startI + innerH
    IF endI > total THEN endI = total
    DIM i AS INTEGER
    FOR i = startI TO endI - 1
        DIM n AS TreeNode = m.TreeNodes[i]
        DIM indent AS STRING = strings.Repeat("  ", n.Depth)
        ' One-cell left inset so the tree text doesn't hug the border │.
        DIM line   AS STRING = " " + indent + nodeGlyph(m, n) + " " + n.Name
        IF i = m.TreeSelected THEN
            lines = APPEND(lines, cursorStyle.Render(line))
        ELSEIF i = hoverRow THEN
            lines = APPEND(lines, hoverStyle.Render(line))
        ELSE
            lines = APPEND(lines, defStyle.Render(line))
        END IF
    NEXT i
    ' Pad with empty rows so the box always renders innerH lines.
    DO WHILE LEN(lines) < innerH
        lines = APPEND(lines, defStyle.Render(""))
    LOOP
    RETURN strings.Join(lines, "\n")
END FUNCTION

' renderLeftPane — Project tree column. The border style follows
' keyboard focus: square-corner = focused, rounded = unfocused.
FUNCTION renderLeftPane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    ' titledBox renders a top row + 3-sided body box. The body box's
    ' inner area is (width-2) chars wide × (height-2) rows tall.
    DIM body AS STRING = renderTreeBody(m, width - 2, height - 2)
    DIM treeFocused AS BOOLEAN = (m.FocusedPane = "tree")
    ' The left splitter sits at the pane's right edge (screen cols
    ' width-1 / width). Highlight it when hovered or while dragging.
    DIM splitHot AS BOOLEAN = (m.HoverX = width - 1 OR m.HoverX = width) AND m.HoverY >= 2
    IF m.DragMode = "splitL" THEN splitHot = TRUE
    RETURN titledBox("Project", body, width, height, treeFocused, splitHot, FALSE)
END FUNCTION

' tabLabel — display label for tab `i`: basename, dirty-prefixed with
' "*" when unsaved. Centralised so render + hit-test math agree on
' visible-cell width.
FUNCTION tabLabel(m AS Model, i AS INTEGER) AS STRING
    IF i < 0 OR i >= LEN(m.Tabs) THEN RETURN ""
    DIM marker AS STRING = ""
    IF m.Tabs[i].Dirty THEN marker = "*"
    RETURN marker + baseName(m.Tabs[i].Path)
END FUNCTION

' tabCellWidth — total visible cells one tab occupies on the caption
' row. Format is "[ LABEL ✕ ]" so it's lipgloss.Width(label) + 6 (one
' bracket, space, label, space, glyph, space, bracket = 6 fixed).
FUNCTION tabCellWidth(m AS Model, i AS INTEGER) AS INTEGER
    RETURN lipgloss.Width(tabLabel(m, i)) + 6
END FUNCTION

' tabCellX — leading X offset (in cells) where tab `i`'s "[" sits.
' Caption begins with one "─" so the first tab starts at column 1.
FUNCTION tabCellX(m AS Model, i AS INTEGER) AS INTEGER
    DIM x AS INTEGER = 1
    DIM j AS INTEGER
    FOR j = 0 TO i - 1
        x = x + tabCellWidth(m, j)
    NEXT j
    RETURN x
END FUNCTION

' renderTabsCaption — caption row when in code mode with at least one
' tab: leading dash, "[ name ✕ ]" per tab (active one accented), then
' filler dashes to width. Replaces the plain captionin code mode so
' the tabs and the right pane's [Widgets][Tools] strip share a row.
FUNCTION renderTabsCaption(m AS Model, width AS INTEGER) AS STRING
    DIM dashStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM defBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cMenuFg))
    DIM actBase   AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM closeStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cHotkey))

    DIM out AS STRING = dashStyle.Render("─")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs) - 1
        DIM bs AS lipgloss.Style = defBase
        IF i = m.TabIdx THEN bs = actBase
        out = out + dashStyle.Render("[") + bs.Render(" " + tabLabel(m, i) + " ") + closeStyle.Render("✕") + dashStyle.Render(" ]")
    NEXT i
    RETURN padRight(out, width, dashStyle.Render("─"))
END FUNCTION

' renderMiddlePane — editor area. No outer panel frame in the original
' DBtui; just a caption line + the editor surface beneath. In form
' mode the caption is a single "Form Designer" title; in code mode
' the caption becomes the tab strip (rendered by renderTabsCaption).
FUNCTION renderMiddlePane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    DIM dashStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)

    ' --- Caption -----------------------------------------------------
    DIM caption AS STRING
    IF m.ViewMode = "code" AND LEN(m.Tabs) > 0 THEN
        caption = renderTabsCaption(m, width)
    ELSEIF m.ViewMode = "code" THEN
        caption = padRight(dashStyle.Render("─[ ") + titleStyle.Render("Code Editor") + dashStyle.Render(" ]"), width, dashStyle.Render("─"))
    ELSE
        caption = padRight(dashStyle.Render("─[ ") + titleStyle.Render("Form Designer — frmStart") + dashStyle.Render(" ]"), width, dashStyle.Render("─"))
    END IF

    ' --- Body --------------------------------------------------------
    DIM bodyH AS INTEGER = height - 1
    IF bodyH < 1 THEN bodyH = 1
    DIM bodyStr AS STRING
    IF m.ViewMode = "code" AND hasActiveTab(m) THEN
        ' Push the relevant diagnostics onto the active Pad before
        ' rendering so the gutter can show error markers.
        m.Tabs[m.TabIdx].Editor.DiagLines = m.Diagnostics[m.Tabs[m.TabIdx].Path]
        ' Prefer the cached textarea View() — refreshEditorCache
        ' is the only place that calls the (expensive) live View().
        ' Fall back to live render when the cache is stale or empty
        ' so correctness is never sacrificed for the perf win.
        IF m.EditorCacheView <> "" AND NOT m.EditorCacheDirty AND m.EditorCacheW = width AND m.EditorCacheH = bodyH THEN
            bodyStr = m.EditorCacheView
        ELSE
            m.Tabs[m.TabIdx].Editor.SetWidth(width)
            m.Tabs[m.TabIdx].Editor.SetHeight(bodyH)
            bodyStr = m.Tabs[m.TabIdx].Editor.View()
        END IF
    ELSEIF m.ViewMode = "code" THEN
        DIM emptyStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(bodyH).Align(lipgloss.Center, lipgloss.Center)
        bodyStr = emptyStyle.Render("(no files open — pick one from the tree)")
    ELSE
        bodyStr = renderFormCanvas(m, width, bodyH)
    END IF
    RETURN caption + "\n" + bodyStr
END FUNCTION

' rightPaneWidgets / rightPaneTools — the two label strings, kept as
' module-level constants so the render and hit-test code share one
' source of truth on their visible widths.
CONST rpLeftPad AS STRING  = "[ "
CONST rpTabSep  AS STRING  = " ] [ "
CONST rpRightPad AS STRING = " ]"

' rightTabsBounds — return the [start,end) screen-cell ranges for the
' [Widgets] and [Tools] tab labels on the right-pane caption row.
' `xOrigin` is the absolute X where the right pane starts. The tab
' strip is right-aligned so the labels sit flush against
' `xOrigin + width`. Order returned: wStart, wEnd, tStart, tEnd.
FUNCTION rightTabsBounds(xOrigin AS INTEGER, width AS INTEGER, widgetsLabel AS STRING, toolsLabel AS STRING) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM full AS STRING = rpLeftPad + widgetsLabel + rpTabSep + toolsLabel + rpRightPad
    DIM totalW AS INTEGER = lipgloss.Width(full)
    DIM stripX AS INTEGER = xOrigin + width - totalW
    DIM wX0 AS INTEGER = stripX + lipgloss.Width(rpLeftPad)
    DIM wX1 AS INTEGER = wX0 + lipgloss.Width(widgetsLabel)
    DIM tX0 AS INTEGER = wX1 + lipgloss.Width(rpTabSep)
    DIM tX1 AS INTEGER = tX0 + lipgloss.Width(toolsLabel)
    RETURN wX0, wX1, tX0, tX1
END FUNCTION

' renderRightPane — Widgets/Tools tabs strip + Widgets list, stacked
' over a Properties box. Both panels unfocused → rounded corners.
' The tabs row is right-aligned so "[ Widgets ] [ Tools ]" sits flush
' against the trailing dashes of the middle pane's caption (matching
' the original DBtui).
'
' `xOrigin` is the absolute screen-X where this pane starts; we need
' it to translate the per-region hover position back to local rows.
' clipPropLine — force a Properties row onto a single visual line of at most
' `w` cells. Any embedded newline is collapsed to a space (so a value can
' never spill onto extra rows), and an over-long line is cut with a trailing
' … overflow marker. Keeping every row exactly one line tall is what keeps
' the hover/click row math (one property == one row) correct.
FUNCTION clipPropLine(s AS STRING, w AS INTEGER) AS STRING
    ' Collapse every control char that could break the row across lines
    ' (newline, carriage return, tab) into a space.
    DIM oneLine AS STRING = strings.ReplaceAll(s, Chr(10), " ")
    oneLine = strings.ReplaceAll(oneLine, Chr(13), " ")
    oneLine = strings.ReplaceAll(oneLine, Chr(9), " ")
    IF w < 1 THEN RETURN ""
    ' Clip by CHARACTER count, then mark the overflow with ….  A string's
    ' display width can never exceed its character count, so a result of at
    ' most w characters is at most w display cells — guaranteeing the row
    ' style (Width = w) never wraps, even for wide glyphs. (Measuring with
    ' lipgloss.Width instead would be wrong here: it reports some wide
    ' glyphs as 1 cell while the terminal draws 2, letting them wrap.)
    IF LEN(oneLine) <= w THEN RETURN oneLine
    RETURN Mid(oneLine, 1, w - 1) + "…"
END FUNCTION

FUNCTION renderRightPane(m AS Model, width AS INTEGER, height AS INTEGER, xOrigin AS INTEGER) AS STRING
    DIM dashStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))
    DIM tabStyle  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE)
    DIM hovTabStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Underline(TRUE)
    DIM bracket  AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder))

    ' --- Tab strip ---------------------------------------------------
    DIM widgetsLbl AS STRING = "Outline"
    IF m.ViewMode = "form" THEN widgetsLbl = "Widgets"
    DIM toolsLbl   AS STRING = "Tools"
    DIM wS AS INTEGER
    DIM wE AS INTEGER
    DIM tS AS INTEGER
    DIM tE AS INTEGER
    wS, wE, tS, tE = rightTabsBounds(xOrigin, width, widgetsLbl, toolsLbl)
    ' Active sub-tab inverts colors; hover (when not active) softens
    ' the bg. Default is the accented-fg-on-modal-bg.
    DIM actTabStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    DIM widgetsStyled AS lipgloss.Style = tabStyle
    DIM toolsStyled   AS lipgloss.Style = tabStyle
    IF m.RightTab = "tools" THEN
        toolsStyled = actTabStyle
    ELSE
        widgetsStyled = actTabStyle
    END IF
    IF m.HoverY = 1 AND m.HoverX >= wS AND m.HoverX < wE AND m.RightTab <> "list" THEN widgetsStyled = hovTabStyle
    IF m.HoverY = 1 AND m.HoverX >= tS AND m.HoverX < tE AND m.RightTab <> "tools" THEN toolsStyled   = hovTabStyle
    DIM tabLabels AS STRING = bracket.Render(rpLeftPad) + widgetsStyled.Render(widgetsLbl) + bracket.Render(rpTabSep) + toolsStyled.Render(toolsLbl) + bracket.Render(rpRightPad)
    DIM dashW AS INTEGER = width - lipgloss.Width(tabLabels)
    IF dashW < 0 THEN dashW = 0
    DIM tabs AS STRING = dashStyle.Render(strings.Repeat("─", dashW)) + tabLabels

    ' --- Pane geometry -----------------------------------------------
    DIM remain  AS INTEGER = height - 1
    DIM listH   AS INTEGER = remain / 2
    DIM propsH  AS INTEGER = remain - listH

    ' --- List section: Outline (code mode) OR Palette (form mode) ----
    ' The listBox has a rounded border so the inner area is (width-2)
    ' chars wide × (listH-2) rows tall. Top border at body y = 2,
    ' so visible entries occupy y = 3..3+listH-3.
    DIM listInnerW AS INTEGER = width - 2
    DIM listFirstY AS INTEGER = 3
    DIM listVisible AS INTEGER = listH - 2
    DIM listRowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(listInnerW)
    DIM listHoverStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Width(listInnerW)
    DIM listLines AS []STRING
    DIM li AS INTEGER
    IF m.RightTab = "tools" THEN
        ' Tools panel — placeholder list of reusable design helpers.
        ' For v1 just the FileDialog drop-in lives here; the real
        ' tool palette grows once we wire codegen-side runtime tools.
        DIM toolNames AS []STRING
        toolNames = APPEND(toolNames, " ◆ FileDialog")
        toolNames = APPEND(toolNames, "")
        toolNames = APPEND(toolNames, "  (more tools coming)")
        FOR li = 0 TO listVisible - 1
            DIM toolTxt AS STRING = ""
            IF li < LEN(toolNames) THEN toolTxt = toolNames[li]
            listLines = APPEND(listLines, listRowStyle.Render(toolTxt))
        NEXT li
    ELSEIF m.ViewMode = "form" THEN
        ' Widgets palette: the alphabetical kind list, scrolled by
        ' m.PaletteScroll. listVisible rows shown starting at that offset; a
        ' leading ↑ / trailing ↓ marks more entries above / below.
        palLastVisible = listVisible
        FOR li = 0 TO listVisible - 1
            DIM pki AS INTEGER = m.PaletteScroll + li
            DIM palTxt AS STRING = ""
            IF pki >= 0 AND pki < formPaletteKinds THEN
                DIM palMark AS STRING = " + "
                IF li = 0 AND m.PaletteScroll > 0 THEN palMark = " ↑ "
                IF li = listVisible - 1 AND pki < formPaletteKinds - 1 THEN palMark = " ↓ "
                palTxt = palMark + formKindByIdx(pki)
            END IF
            DIM prowY AS INTEGER = listFirstY + li
            IF m.HoverY = prowY AND m.HoverX > xOrigin AND m.HoverX < xOrigin + width - 1 AND pki < formPaletteKinds THEN
                listLines = APPEND(listLines, listHoverStyle.Render(palTxt))
            ELSE
                listLines = APPEND(listLines, listRowStyle.Render(palTxt))
            END IF
        NEXT li
    ELSE
        ' Outline: SUB / FUNCTION / TYPE from active buffer.
        DIM outline AS []OutlineEntry
        IF hasActiveTab(m) THEN
            outline = scanOutline(m.Tabs[m.TabIdx].Editor.Lines)
        END IF
        FOR li = 0 TO listVisible - 1
            DIM txt AS STRING = ""
            IF li < LEN(outline) THEN
                DIM mark AS STRING = "?"
                IF outline[li].Kind = "SUB"      THEN mark = "S"
                IF outline[li].Kind = "FUNCTION" THEN mark = "F"
                IF outline[li].Kind = "TYPE"     THEN mark = "T"
                txt = " " + mark + "  " + outline[li].Name
            END IF
            DIM rowY AS INTEGER = listFirstY + li
            IF m.HoverY = rowY AND m.HoverX > xOrigin AND m.HoverX < xOrigin + width - 1 AND li < LEN(outline) THEN
                listLines = APPEND(listLines, listHoverStyle.Render(txt))
            ELSE
                listLines = APPEND(listLines, listRowStyle.Render(txt))
            END IF
        NEXT li
    END IF
    DIM listBody AS STRING = strings.Join(listLines, "\n")
    ' The right splitter sits at this pane's left edge (screen cols
    ' xOrigin / xOrigin-1). Highlight the list box's left border when
    ' the splitter is hovered or being dragged.
    DIM splitRHot AS BOOLEAN = (m.HoverX = xOrigin OR m.HoverX = xOrigin - 1) AND m.HoverY >= 2
    IF m.DragMode = "splitR" THEN splitRHot = TRUE
    DIM listLeftCol AS STRING = cBorder
    IF splitRHot THEN listLeftCol = cHotkey
    DIM listBox  AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cBorder)).BorderLeftForeground(lipgloss.Color(listLeftCol)).Width(width).Height(listH)

    ' --- Properties panel — live cursor context (code) OR selected
    '     widget props (form). titledBox draws title at the top of
    '     the panel, so property rows start one cell below that.
    DIM propRows AS []STRING
    IF m.ViewMode = "form" AND hasActiveTab(m) THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM sw AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
            ' Shared row order with propRowEditContext (form.dbas) so
            ' a click on row N pops the modal for the same field the
            ' user sees on that visual line.
            propRows = APPEND(propRows, "Kind   " + sw.Kind)
            propRows = APPEND(propRows, "Name   " + sw.Name)
            propRows = APPEND(propRows, "Text   " + sw.Text)
            propRows = APPEND(propRows, fmt.Sprintf("Pos    %d, %d", sw.X, sw.Y))
            propRows = APPEND(propRows, fmt.Sprintf("Size   %d x %d", sw.W, sw.H))
            ' Kind-specific property rows. Order matches the FOR loop
            ' in propRowEditContext so clicks dispatch correctly.
            IF sw.Kind = "Checkbox" OR sw.Kind = "RadioButton" THEN
                DIM ckStr AS STRING = "false"
                IF sw.Checked THEN ckStr = "true"
                propRows = APPEND(propRows, "Check  " + ckStr)
            END IF
            IF sw.Kind = "RadioButton" THEN
                propRows = APPEND(propRows, "Group  " + sw.Group)
            END IF
            IF sw.Kind = "ComboBox" OR sw.Kind = "ListBox" THEN
                propRows = APPEND(propRows, "Items  " + strings.Join(sw.Items, ", "))
                propRows = APPEND(propRows, fmt.Sprintf("Selctd %d", sw.Selected))
            END IF
            IF sw.Kind = "ProgressBar" OR sw.Kind = "ScrollBar" THEN
                propRows = APPEND(propRows, fmt.Sprintf("Min    %d", sw.Min))
                propRows = APPEND(propRows, fmt.Sprintf("Max    %d", sw.Max))
                propRows = APPEND(propRows, fmt.Sprintf("Value  %d", sw.Value))
            END IF
            IF sw.Kind = "ScrollBar" THEN
                propRows = APPEND(propRows, "Orient " + sw.Orient)
            END IF
            IF sw.Kind = "TabStrip" THEN
                propRows = APPEND(propRows, "Tabs   " + strings.Join(sw.Items, ", "))
                propRows = APPEND(propRows, fmt.Sprintf("Active %d", sw.Selected))
            END IF
            IF sw.Kind = "Tree" THEN
                propRows = APPEND(propRows, "Nodes  " + strings.Join(sw.Items, ", "))
                propRows = APPEND(propRows, fmt.Sprintf("Cursor %d", sw.Selected))
            END IF
            IF sw.Kind = "PropGrid" THEN
                propRows = APPEND(propRows, "Rows   " + strings.Join(sw.Items, ", "))
                propRows = APPEND(propRows, fmt.Sprintf("Cursor %d", sw.Selected))
            END IF
            IF sw.Kind = "ScrollPanel" THEN
                propRows = APPEND(propRows, "Lines  " + strings.Join(sw.Items, ", "))
            END IF
            IF sw.Kind = "Menubar" THEN
                ' Menus live in the structured Menu tree (not Items); show the
                ' top-level titles as a preview. Clicking opens the Menu Editor.
                propRows = APPEND(propRows, "Menus " + strings.TrimSpace(menuTopTitles(sw.Menu)))
            END IF
            IF sw.Kind = "StatusBar" THEN
                propRows = APPEND(propRows, "Segs   " + strings.Join(sw.Items, ", "))
            END IF
            IF sw.Kind = "Button" THEN
                propRows = APPEND(propRows, "OnClick " + sw.OnClickDialog)
            END IF
            IF sw.Kind = "Dialog" THEN
                DIM dlgK AS STRING = sw.DialogKind
                IF dlgK = "" THEN dlgK = "confirm"
                propRows = APPEND(propRows, "DlgKind " + dlgK)
                IF dlgK = "confirm" THEN
                    propRows = APPEND(propRows, "Message " + sw.DialogMsg)
                    propRows = APPEND(propRows, "Buttons " + strings.Join(sw.Items, ", "))
                ELSEIF dlgK = "input" THEN
                    propRows = APPEND(propRows, "Prompt  " + sw.DialogMsg)
                    propRows = APPEND(propRows, "Default " + sw.DialogDef)
                ELSEIF dlgK = "file" THEN
                    DIM fm AS STRING = sw.DialogMode
                    IF fm = "" THEN fm = "open"
                    propRows = APPEND(propRows, "Mode    " + fm)
                    propRows = APPEND(propRows, "Mask    " + sw.DialogMask)
                END IF
            END IF
            IF sw.Kind <> "Panel" THEN
                propRows = APPEND(propRows, "Parent " + sw.Parent)
            END IF
            ' Universal color rows (mirror propRowEditContext). Click opens
            ' the 256-color picker. "" shows as (inherit).
            DIM fgLbl AS STRING = "(inherit)"
            IF sw.FgColor <> "" THEN fgLbl = sw.FgColor
            propRows = APPEND(propRows, "Fg     " + fgLbl)
            DIM bgLbl AS STRING = "(inherit)"
            IF sw.BgColor <> "" THEN bgLbl = sw.BgColor
            propRows = APPEND(propRows, "Bg     " + bgLbl)
        ELSE
            ' No widget selected → form-level properties. Fg/Bg rows open
            ' the color picker (formClickPropAt maps these row indices).
            ' Row order MUST match formClickPropAt's no-widget branch.
            propRows = APPEND(propRows, "Form   " + m.Tabs[m.TabIdx].Form.Name)
            DIM ffgLbl AS STRING = "(default)"
            IF m.Tabs[m.TabIdx].Form.FgColor <> "" THEN ffgLbl = m.Tabs[m.TabIdx].Form.FgColor
            propRows = APPEND(propRows, "Fg     " + ffgLbl)
            DIM fbgLbl AS STRING = "(default)"
            IF m.Tabs[m.TabIdx].Form.BgColor <> "" THEN fbgLbl = m.Tabs[m.TabIdx].Form.BgColor
            propRows = APPEND(propRows, "Bg     " + fbgLbl)
            propRows = APPEND(propRows, "(click a widget to edit)")
        END IF
    ELSEIF hasActiveTab(m) THEN
        DIM edRow AS INTEGER = m.Tabs[m.TabIdx].Editor.Row
        DIM edCol AS INTEGER = m.Tabs[m.TabIdx].Editor.Col
        DIM edLines AS []STRING = m.Tabs[m.TabIdx].Editor.Lines
        DIM filenm AS STRING = baseName(m.Tabs[m.TabIdx].Path)
        IF filenm = "" THEN filenm = "(untitled)"
        propRows = APPEND(propRows, "File   " + filenm)
        propRows = APPEND(propRows, fmt.Sprintf("Lines  %d", LEN(edLines)))
        propRows = APPEND(propRows, fmt.Sprintf("Pos    Ln %d Col %d", edRow + 1, edCol + 1))
        ' Dirty flag chip.
        DIM dirty AS STRING = "clean"
        IF m.Tabs[m.TabIdx].Dirty THEN dirty = "modified"
        propRows = APPEND(propRows, "State  " + dirty)
        ' Enclosing SUB / FUNCTION / TYPE — walk the outline
        ' backwards for the nearest decl at or above cursor row.
        DIM outlineP AS []OutlineEntry = scanOutline(edLines)
        DIM enclosing AS STRING = "(top-level)"
        DIM oi AS INTEGER
        FOR oi = LEN(outlineP) - 1 TO 0 STEP 0 - 1
            IF outlineP[oi].Row <= edRow THEN
                enclosing = outlineP[oi].Kind + " " + outlineP[oi].Name
                EXIT FOR
            END IF
        NEXT oi
        ' Trim long names so they fit the pane.
        IF LEN(enclosing) > 22 THEN enclosing = Mid(enclosing, 1, 21) + "…"
        propRows = APPEND(propRows, "In     " + enclosing)
        ' Indent depth of current line.
        IF edRow >= 0 AND edRow < LEN(edLines) THEN
            DIM wsLead AS STRING = padLeadingWhitespace(edLines[edRow])
            propRows = APPEND(propRows, fmt.Sprintf("Indent %d", LEN(wsLead)))
        END IF
        ' Token + kind under cursor.
        IF edRow >= 0 AND edRow < LEN(edLines) THEN
            DIM curLine AS STRING = edLines[edRow]
            DIM toks AS []PadToken = tokenizeLine(curLine)
            DIM tCol AS INTEGER = 0
            DIM tokTxt AS STRING = ""
            DIM tokKind AS STRING = "—"
            DIM ti AS INTEGER
            FOR ti = 0 TO LEN(toks) - 1
                DIM tokEnd AS INTEGER = tCol + LEN(toks[ti].Text)
                IF edCol >= tCol AND edCol < tokEnd THEN
                    tokTxt = toks[ti].Text
                    IF toks[ti].Kind = tkKeyword THEN tokKind = "keyword"
                    IF toks[ti].Kind = tkString  THEN tokKind = "string"
                    IF toks[ti].Kind = tkComment THEN tokKind = "comment"
                    IF toks[ti].Kind = tkNumber  THEN tokKind = "number"
                    IF toks[ti].Kind = tkPlain   THEN tokKind = "ident"
                    EXIT FOR
                END IF
                tCol = tokEnd
            NEXT ti
            IF tokTxt = "" THEN tokTxt = "(ws/eol)"
            IF LEN(tokTxt) > 18 THEN tokTxt = Mid(tokTxt, 1, 17) + "…"
            propRows = APPEND(propRows, "Word   " + tokTxt)
            propRows = APPEND(propRows, "Kind   " + tokKind)
        END IF
    ELSE
        propRows = APPEND(propRows, "(no file open)")
    END IF
    DIM propsInnerW AS INTEGER = width - 2
    DIM propsFirstY AS INTEGER = 2 + listH + 1
    DIM propsVisible AS INTEGER = propsH - 2
    DIM propRowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Width(propsInnerW)
    DIM propHoverStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBorder)).Foreground(lipgloss.Color(cAccent)).Width(propsInnerW)
    ' Selected property row (PropSel) — the target of spacebar/double-click.
    ' Inverse accent so it reads as "active", distinct from the hover tint.
    DIM propSelStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE).Width(propsInnerW)
    DIM propSelOn AS BOOLEAN = (m.ViewMode = "form" AND hasActiveTab(m) AND m.Tabs[m.TabIdx].SelWidget >= 0)
    DIM propLines AS []STRING
    DIM pi AS INTEGER
    FOR pi = 0 TO propsVisible - 1
        DIM propY AS INTEGER = propsFirstY + pi
        IF m.PropEdit AND pi = m.PropEditRow AND pi < LEN(propRows) THEN
            ' This row is being edited in place: keep the property's label
            ' but swap the value cell for the inline textinput. The label is
            ' the row's first word (e.g. "Text", "Name") padded to a column;
            ' the field scrolls horizontally so long values stay on one line.
            DIM eLbl AS STRING = ""
            DIM eFields AS []STRING = strings.Fields(propRows[pi])
            IF LEN(eFields) > 0 THEN eLbl = eFields[0]
            IF LEN(eLbl) < 7 THEN eLbl = eLbl + strings.Repeat(" ", 7 - LEN(eLbl))
            DIM eW AS INTEGER = propsInnerW - LEN(eLbl) - 2
            IF eW < 4 THEN eW = 4
            m.PropEditInput.SetWidth(eW)
            propLines = APPEND(propLines, " " + eLbl + " " + m.PropEditInput.View())
        ELSE
            DIM ptxt AS STRING = ""
            IF pi < LEN(propRows) THEN ptxt = clipPropLine(" " + propRows[pi], propsInnerW)
            IF propSelOn AND pi = m.PropSel AND pi < LEN(propRows) THEN
                propLines = APPEND(propLines, propSelStyle.Render(ptxt))
            ELSEIF m.HoverY = propY AND m.HoverX > xOrigin AND m.HoverX < xOrigin + width - 1 AND pi < LEN(propRows) THEN
                propLines = APPEND(propLines, propHoverStyle.Render(ptxt))
            ELSE
                propLines = APPEND(propLines, propRowStyle.Render(ptxt))
            END IF
        END IF
    NEXT pi
    DIM propsBody   AS STRING = strings.Join(propLines, "\n")
    DIM propsTitled AS STRING = titledBox("Properties", propsBody, width, propsH, FALSE, FALSE, splitRHot)

    RETURN lipgloss.JoinVertical(lipgloss.Left, tabs, listBox.Render(listBody), propsTitled)
END FUNCTION

' -------------------------------------------------------------------------
' renderModal — build the centered confirmation dialog string.
'
' Returns "" when no modal is currently active. Otherwise returns a
' rounded-border box containing the title (highlighted), one or more
' message lines (word-wrapped to a reasonable width), and a row of
' buttons with the currently-selected button inverted.
'
' The composition is done with lipgloss styles only — placement
' (centering) is handled in View() via the lipgloss.Compositor, so
' this helper only needs to worry about the *contents* of the box.
' -------------------------------------------------------------------------
FUNCTION renderModal(m AS Model) AS STRING
    IF NOT m.ModalActive THEN RETURN ""

    ' --- Dimensions -----------------------------------------------
    ' A simple readable width that fits typical confirm-dialog text
    ' without spanning the whole screen.
    DIM innerW AS INTEGER = 48

    ' --- Message body --------------------------------------------
    ' Two-pass layout: explicit \n line breaks are preserved (so
    ' multi-line compiler output renders verbatim); any single line
    ' wider than innerW gets soft-wrapped on spaces.
    DIM msgLines AS []STRING
    DIM rawLines AS []STRING = strings.Split(m.ModalMessage, "\n")
    DIM rl AS INTEGER
    FOR rl = 0 TO LEN(rawLines) - 1
        DIM rawLine AS STRING = rawLines[rl]
        IF rawLine = "" THEN
            msgLines = APPEND(msgLines, "")
        ELSEIF lipgloss.Width(rawLine) <= innerW THEN
            msgLines = APPEND(msgLines, rawLine)
        ELSE
            DIM words AS []STRING = strings.Fields(rawLine)
            DIM cur AS STRING = ""
            DIM wi AS INTEGER
            FOR wi = 0 TO LEN(words) - 1
                DIM word AS STRING = words[wi]
                IF cur = "" THEN
                    cur = word
                ELSEIF LEN(cur) + 1 + LEN(word) <= innerW THEN
                    cur = cur + " " + word
                ELSE
                    msgLines = APPEND(msgLines, cur)
                    cur = word
                END IF
            NEXT wi
            IF cur <> "" THEN msgLines = APPEND(msgLines, cur)
        END IF
    NEXT rl

    DIM bodyStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg)).Width(innerW)
    DIM bodyText AS STRING = strings.Join(msgLines, "\n")
    DIM bodyBlock AS STRING = bodyStyle.Render(bodyText)

    ' --- Footer: input box (input modals only) + flat right-justified
    ' [ OK ] [ Cancel ] style button row, matching the FileDialog.
    DIM footer AS STRING = ""
    DIM inputRowCount AS INTEGER = 0
    IF m.ModalIsInput THEN
        m.ModalInput.SetWidth(innerW)
        DIM inputBox AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Width(innerW).Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(cAccent))
        DIM inputBlk AS STRING = inputBox.Render(m.ModalInput.View())
        inputRowCount = lipgloss.Height(inputBlk)
        DIM spacer1 AS STRING = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Width(innerW).Render(" ")
        DIM btnRowIn AS STRING = renderModalButtonRow(m.ModalButtons, m.ModalIdx, innerW)
        footer = lipgloss.JoinVertical(lipgloss.Left, inputBlk, spacer1, btnRowIn)
    ELSE
        footer = renderModalButtonRow(m.ModalButtons, m.ModalIdx, innerW)
    END IF
    ' Record button hit-rects in modal-local coords. The button row
    ' lives at relative Y = 2 (frame border + 1 top padding) + body
    ' rows + 1 (spacer between body and footer) — plus the input area
    ' (box + spacer) when this is an input modal.
    DIM btnRowY AS INTEGER = 2 + LEN(msgLines) + 1
    IF m.ModalIsInput THEN btnRowY = btnRowY + inputRowCount + 1
    recordFlatModalBtnRects(m.ModalButtons, innerW, btnRowY)

    ' --- Spacer rows — explicit bg-filled blank line so the empty
    '     rows between title / body / footer match the modal surface.
    DIM spacer AS STRING = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Width(innerW).Render(" ")

    ' --- Stack body / spacer / footer ----------------------------
    ' (Title row dropped — the title now lives inside the top border,
    ' matching the FileDialog's titledBox-style frame.)
    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, bodyBlock, spacer, footer)

    ' --- Outer frame ---------------------------------------------
    ' Lipgloss draws the sides and bottom; the top is built by hand
    ' so the title can be embedded in the border with a ✕ close glyph
    ' to its right (same layout as the FileDialog).
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)
    DIM body AS STRING = frame.Render(stacked)
    DIM totalW AS INTEGER = lipgloss.Width(body)

    DIM top AS STRING = renderModalTopBorder(m.ModalTitle, totalW)
    DIM full AS STRING = top + "\n" + body
    ' Stash the modal's rendered footprint so the click handler in
    ' Update() can hit-test the top-border (move / ✕ close) regions.
    modalLastW = totalW
    modalLastH = lipgloss.Height(full)
    RETURN full
END FUNCTION

' renderModalTopBorder — top edge of the modal frame with the title
' embedded (matching titledBox / fdTopBorder) and a ✕ close glyph one
' cell in from the right corner.
FUNCTION renderModalTopBorder(title AS STRING, totalW AS INTEGER) AS STRING
    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))
    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)
    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cHotkey)).Background(lipgloss.Color(cBg)).Bold(TRUE)
    DIM titleLen AS INTEGER = lipgloss.Width(" " + title + " ")
    ' Layout: ╭─ Title ─…─ ✕ ╮ — totalW cells total. Subtract
    ' "╭─" (2) + title (titleLen) + " ✕ " (3) + "╮" (1) = titleLen + 6.
    DIM dashLen AS INTEGER = totalW - titleLen - 6
    IF dashLen < 0 THEN dashLen = 0
    RETURN borderStyle.Render("╭─") + titleStyle.Render(" " + title + " ") + borderStyle.Render(strings.Repeat("─", dashLen) + " ") + closeStyle.Render("✕") + borderStyle.Render(" ╮")
END FUNCTION

' -------------------------------------------------------------------------
' renderBottomPane — bordered pane showing the tail of BottomBody.
' Always shows the most recent lines that fit; long output scrolls
' the old lines off the top. Title (e.g. "Output") sits in the
' top border like other titledBoxes.
' -------------------------------------------------------------------------
FUNCTION renderBottomPane(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    DIM title AS STRING = m.BottomTitle
    IF title = "" THEN title = "Output"
    DIM rawLines AS []STRING = strings.Split(m.BottomBody, "\n")
    ' Inner area height inside titledBox: height - 2 (top title row +
    ' bottom border). Show the last N lines that fit.
    DIM visible AS INTEGER = height - 2
    IF visible < 1 THEN visible = 1
    DIM startI AS INTEGER = 0
    IF LEN(rawLines) > visible THEN startI = LEN(rawLines) - visible
    DIM showLines AS []STRING
    DIM i AS INTEGER
    FOR i = startI TO LEN(rawLines) - 1
        showLines = APPEND(showLines, rawLines[i])
    NEXT i
    DIM body AS STRING = strings.Join(showLines, "\n")
    RETURN titledBox(title, body, width, height, FALSE, FALSE, FALSE)
END FUNCTION
