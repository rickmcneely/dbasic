' showModal — pop a button-style modal with `title`, `message`, and a
' comma-separated `buttonsCSV` (e.g. "Discard,Cancel"). `context` is
' a free-text tag forwarded to dispatchModalClose so the same handler
' can serve multiple dialog kinds. The active modal is rendered as a
' centered lipgloss-layer overlay in View().
SUB showModal(m AS POINTER TO Model, title AS STRING, message AS STRING, buttonsCSV AS STRING, context AS STRING)
    m.ModalTitle = title
    m.ModalMessage = message
    DIM buttons AS []STRING
    DIM parts AS []STRING = strings.Split(buttonsCSV, ",")
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(parts) - 1
        DIM p AS STRING = strings.TrimSpace(parts[bi])
        IF p <> "" THEN buttons = APPEND(buttons, p)
    NEXT bi
    IF LEN(buttons) = 0 THEN buttons = APPEND(buttons, "OK")
    m.ModalButtons = buttons
    m.ModalIdx = 0
    m.ModalContext = context
    m.ModalIsInput = FALSE
    m.ModalUserMoved = FALSE
    m.ModalActive = TRUE
END SUB

' showInputModal — pop an input-style modal with `title`, a one-line
' `prompt` shown above the field, and `defaultText` pre-filled in
' the textinput. Enter commits; Esc cancels. dispatchModalClose
' receives the typed text via its `input` parameter.
SUB showInputModal(m AS POINTER TO Model, title AS STRING, prompt AS STRING, defaultText AS STRING, context AS STRING)
    m.ModalTitle = title
    m.ModalMessage = prompt
    m.ModalContext = context
    m.ModalIsInput = TRUE
    m.ModalInput = textinput.New()
    m.ModalInput.Placeholder = ""
    m.ModalInput.SetValue(defaultText)
    m.ModalInput.CursorEnd()
    DIM fcmd AS tea.Cmd = m.ModalInput.Focus()
    _ = fcmd
    ' Input modals get explicit OK / Cancel buttons too so the visual
    ' affordances match the rest of the dialog family. Enter and OK
    ' both commit; Esc, ✕, and Cancel all dismiss.
    DIM ibtns AS []STRING
    ibtns = APPEND(ibtns, "OK")
    ibtns = APPEND(ibtns, "Cancel")
    m.ModalButtons = ibtns
    m.ModalIdx = 0
    m.ModalUserMoved = FALSE
    m.ModalActive = TRUE
END SUB

' showColorPicker — open the 256-color swatch picker for the selected
' widget. `target` is "fg" or "bg" — which widget color the chosen
' swatch writes to. The cursor (CPIdx) is seeded from the widget's
' current color so reopening lands on the existing swatch.
SUB showColorPicker(m AS POINTER TO Model, target AS STRING)
    ' Seed the cursor from the current color. Form targets ("formfg"/
    ' "formbg") read the form's color; widget targets ("fg"/"bg") require
    ' a selected widget.
    DIM cur AS STRING = ""
    IF target = "formfg" THEN
        cur = m.Tabs[m.TabIdx].Form.FgColor
    ELSEIF target = "formbg" THEN
        cur = m.Tabs[m.TabIdx].Form.BgColor
    ELSE
        IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
        DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
        cur = w.FgColor
        IF target = "bg" THEN cur = w.BgColor
    END IF
    DIM idx AS INTEGER = 0
    IF cur <> "" THEN
        DIM pv AS INTEGER
        DIM perr AS ERROR
        pv, perr = strconv.Atoi(cur)
        IF perr = NIL AND pv >= 0 AND pv <= 255 THEN idx = pv
    END IF
    m.CPTarget = target
    m.CPIdx = idx
    m.CPActive = TRUE
END SUB

' colorPickerCommit — write the picker's chosen swatch (or "" to clear)
' to the selected widget's Fg/Bg color, then close the picker. Passing
' clear=TRUE sets the color to inherit regardless of CPIdx.
SUB colorPickerCommit(m AS POINTER TO Model, clear AS BOOLEAN)
    DIM val AS STRING = ""
    IF NOT clear THEN val = strconv.Itoa(m.CPIdx)
    IF m.CPTarget = "formfg" THEN
        m.Tabs[m.TabIdx].Form.FgColor = val
        m.Tabs[m.TabIdx].Dirty = TRUE
    ELSEIF m.CPTarget = "formbg" THEN
        m.Tabs[m.TabIdx].Form.BgColor = val
        m.Tabs[m.TabIdx].Dirty = TRUE
    ELSEIF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
        IF m.CPTarget = "bg" THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].BgColor = val
        ELSE
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].FgColor = val
        END IF
        m.Tabs[m.TabIdx].Dirty = TRUE
    END IF
    m.CPActive = FALSE
END SUB

' showEnumPicker — open the multiselect dropdown for Properties row
' `rowIdx`, anchored near the row at (ax, ay). Seeds the highlight on the
' field's current value. Opened by right-clicking an enum row.
SUB showEnumPicker(m AS POINTER TO Model, rowIdx AS INTEGER, ax AS INTEGER, ay AS INTEGER)
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
    DIM kind AS STRING
    DIM optsCsv AS STRING
    kind, optsCsv = propRowKind(w, rowIdx)
    IF kind <> "enum" THEN RETURN
    DIM t AS STRING
    DIM p AS STRING
    DIM cur AS STRING
    DIM key AS STRING
    t, p, cur, key = propRowEditContext(w, rowIdx)
    _ = t
    _ = p
    DIM opts AS []STRING
    DIM parts AS []STRING = strings.Split(optsCsv, ",")
    DIM oi AS INTEGER
    DIM sel AS INTEGER = 0
    FOR oi = 0 TO LEN(parts) - 1
        DIM o AS STRING = strings.TrimSpace(parts[oi])
        IF o <> "" THEN
            IF o = cur THEN sel = LEN(opts)
            opts = APPEND(opts, o)
        END IF
    NEXT oi
    IF LEN(opts) = 0 THEN RETURN
    m.EnumOpts = opts
    m.EnumIdx = sel
    m.EnumRow = rowIdx
    m.EnumKey = key
    m.EnumX = ax
    m.EnumY = ay
    m.EnumActive = TRUE
END SUB

' enumPickerCommit — apply the highlighted option to the widget's enum
' field (Orient / DialogKind / DialogMode) and close the dropdown.
SUB enumPickerCommit(m AS POINTER TO Model)
    DIM sel AS INTEGER = m.Tabs[m.TabIdx].SelWidget
    IF sel >= 0 AND sel < LEN(m.Tabs[m.TabIdx].Form.Widgets) AND m.EnumIdx >= 0 AND m.EnumIdx < LEN(m.EnumOpts) THEN
        DIM val AS STRING = m.EnumOpts[m.EnumIdx]
        IF m.EnumKey = "wprop:orient" THEN
            m.Tabs[m.TabIdx].Form.Widgets[sel].Orient = val
        ELSEIF m.EnumKey = "wprop:dialogkind" THEN
            m.Tabs[m.TabIdx].Form.Widgets[sel].DialogKind = val
        ELSEIF m.EnumKey = "wprop:dialogmode" THEN
            m.Tabs[m.TabIdx].Form.Widgets[sel].DialogMode = val
        END IF
        m.Tabs[m.TabIdx].Dirty = TRUE
    END IF
    m.EnumActive = FALSE
END SUB

' startInlinePropEdit — begin editing Properties row `rowIdx` of the
' selected widget directly in the grid: a one-line textinput replaces the
' value cell, seeded with the row's current value. Only meaningful for
' text/number rows (bool/enum/color have their own affordances); the caller
' gates on kind. A no-op when the row isn't editable or no widget is selected.
SUB startInlinePropEdit(m AS POINTER TO Model, rowIdx AS INTEGER)
    DIM sel AS INTEGER = m.Tabs[m.TabIdx].SelWidget
    IF sel < 0 OR sel >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[sel]
    DIM t   AS STRING
    DIM p   AS STRING
    DIM d   AS STRING
    DIM key AS STRING
    t, p, d, key = propRowEditContext(w, rowIdx)
    _ = t
    _ = p
    IF key = "" THEN RETURN
    m.PropSel      = rowIdx
    m.PropEditRow  = rowIdx
    m.PropEditKey  = key
    m.PropEditInput = textinput.New()
    m.PropEditInput.Placeholder = ""
    m.PropEditInput.SetValue(d)
    m.PropEditInput.CursorEnd()
    DIM fcmd AS tea.Cmd = m.PropEditInput.Focus()
    _ = fcmd
    m.PropEdit = TRUE
END SUB

' commitInlinePropEdit — apply the inline editor's text to the widget via
' the shared wprop dispatch (so each field's parse/clamp rules live in one
' place), mark the tab dirty, refresh the canvas, and leave edit mode. The
' ModalContext is borrowed for the dispatch call and restored after. A no-op
' when inline edit isn't active.
SUB commitInlinePropEdit(m AS POINTER TO Model)
    IF NOT m.PropEdit THEN RETURN
    DIM savedCtx AS STRING = m.ModalContext
    m.ModalContext = m.PropEditKey
    DIM val AS STRING = m.PropEditInput.Value()
    DIM q AS BOOLEAN
    DIM c AS tea.Cmd
    q, c = dispatchModalClose(m, "", val)
    _ = q
    _ = c
    m.ModalContext = savedCtx
    m.Tabs[m.TabIdx].Dirty = TRUE
    invalidateEditorCache(m)
    m.PropEdit = FALSE
END SUB

' cancelInlinePropEdit — drop the inline edit without applying it (Esc).
SUB cancelInlinePropEdit(m AS POINTER TO Model)
    m.PropEdit = FALSE
END SUB

' dispatchModalClose — called by Update when the user commits a modal
' choice. Returns TRUE if the program should terminate immediately
' after this call (e.g. "Discard" on the quit-confirm modal).
FUNCTION dispatchModalClose(m AS POINTER TO Model, button AS STRING, text AS STRING) AS (BOOLEAN, tea.Cmd)
    IF m.ModalContext = "quit" THEN
        IF button = "Discard" THEN RETURN TRUE, NIL
        m.Status = "quit cancelled"
        RETURN FALSE, NIL
    END IF
    ' "newfolder" — typed name from the FileDialog's New Folder
    ' button. Creates the directory inside the dialog's current
    ' CurDir and re-reads so the new entry appears immediately.
    IF m.ModalContext = "newfolder" THEN
        IF m.FileDlg.Active THEN
            DIM nfName AS STRING = strings.TrimSpace(text)
            IF nfName <> "" THEN
                DIM nfFull AS STRING = filepath.Join(m.FileDlg.CurDir, nfName)
                DIM nfErr AS ERROR = os.Mkdir(nfFull, 0755)
                IF nfErr <> NIL THEN
                    m.Status = "mkdir " + nfFull + ": " + nfErr.Error()
                ELSE
                    m.Status = "created " + nfFull
                    m.FileDlg.ReadDir()
                    ' 2 = FdFocusFolders. CONST in browse.dbas isn't
                    ' visible to this module's analyzer pass (INCLUDE
                    ' order). Keep this literal in sync with browse.dbas.
                    m.FileDlg.Focus = 2
                END IF
            END IF
        END IF
        RETURN FALSE, NIL
    END IF
    ' "openproject" — committed from the browser. Routes the picked
    ' path through loadFormFromDisk so the tree re-roots to the
    ' project's directory (vs. openFile which keeps the current
    ' root). Refuses anything that doesn't end in .dbproj so the
    ' user can't accidentally treat a stray file as a project.
    IF m.ModalContext = "openproject" THEN
        DIM opPath AS STRING = strings.TrimSpace(text)
        IF opPath = "" THEN RETURN FALSE, NIL
        IF NOT strings.HasSuffix(opPath, ".dbproj") THEN
            m.Status = "not a .dbproj: " + opPath
            RETURN FALSE, NIL
        END IF
        loadFormFromDisk(m, opPath)
        RETURN FALSE, NIL
    END IF
    ' "newproject" — committed from the browser in save mode.
    ' Scaffolds a minimal Project { frmStart } at the chosen path,
    ' rebuilds the tree rooted at the new project's directory, and
    ' opens frmStart as a tab.
    IF m.ModalContext = "newproject" THEN
        DIM npPath AS STRING = strings.TrimSpace(text)
        IF npPath = "" THEN RETURN FALSE, NIL
        ' Ensure the path ends in .dbproj so the loader recognises it.
        IF NOT strings.HasSuffix(npPath, ".dbproj") THEN npPath = npPath + ".dbproj"
        ' If the file already exists we'd be stomping someone's work.
        DIM npInfo AS os.FileInfo
        DIM npStatErr AS ERROR
        npInfo, npStatErr = os.Stat(npPath)
        IF npStatErr = NIL THEN
            _ = npInfo
            m.Status = "exists, pick a different name: " + npPath
            RETURN FALSE, NIL
        END IF
        DIM npStart AS DesignForm
        npStart.Name  = "frmStart"
        npStart.Title = "frmStart"
        DIM npProj AS Project
        npProj.StartForm = "frmStart"
        npProj.Forms     = APPEND(npProj.Forms, npStart)
        DIM npStatus AS STRING = ""
        writeProjectToDisk(npPath, npProj, @npStatus)
        IF strings.HasPrefix(npStatus, "save failed") OR strings.HasPrefix(npStatus, "marshal failed") THEN
            m.Status = npStatus
            RETURN FALSE, NIL
        END IF
        ' Re-root the project tree to the new project's directory so
        ' the old project's files don't linger in the sidebar.
        m.TreeRoot     = dirName(npPath)
        m.TreeExpanded = APPEND(m.TreeExpanded, m.TreeRoot)
        buildTreeNodes(m)
        m.TreeSelected = 0
        m.TreeOffset   = 0
        ' Drop a tab open on frmStart.
        openFormTab(m, npPath, npProj, "frmStart")
        m.Status = "new project " + npPath
        RETURN FALSE, NIL
    END IF
    ' "treedel:<path>" — Delete unlinks the file (or os.Remove on an
    ' empty dir); Cancel keeps it. Refuses non-empty directories so
    ' a stray right-click can't shred a project folder. After delete
    ' we close any open tab pointing at the deleted path so the
    ' editor doesn't sit on a stale buffer.
    IF strings.HasPrefix(m.ModalContext, "treedel:") THEN
        IF button = "Delete" THEN
            DIM tdPath AS STRING = Mid(m.ModalContext, 9, LEN(m.ModalContext) - 8)
            DIM tdErr AS ERROR = os.Remove(tdPath)
            IF tdErr <> NIL THEN
                m.Status = "delete failed: " + tdErr.Error()
                RETURN FALSE, NIL
            END IF
            DIM tdTabIdx AS INTEGER = findTabIdx(^m, tdPath)
            IF tdTabIdx >= 0 THEN closeTab(m, tdTabIdx)
            buildTreeNodes(m)
            m.Status = "deleted " + tdPath
        ELSE
            m.Status = "delete cancelled"
        END IF
        RETURN FALSE, NIL
    END IF
    ' "closetab:<idx>" — Discard removes the tab; Cancel keeps it.
    IF strings.HasPrefix(m.ModalContext, "closetab:") THEN
        IF button = "Discard" THEN
            DIM idxStr AS STRING = Mid(m.ModalContext, 10, LEN(m.ModalContext) - 9)
            DIM idx AS INTEGER
            DIM err AS ERROR
            idx, err = strconv.Atoi(idxStr)
            IF err = NIL THEN closeTab(m, idx)
        ELSE
            m.Status = "close cancelled"
        END IF
        RETURN FALSE, NIL
    END IF
    ' "open" — input modal asking for a file path. Empty/whitespace
    ' aborts; otherwise hand the path off to openFile (async).
    IF m.ModalContext = "open" THEN
        DIM p AS STRING = strings.TrimSpace(text)
        DIM oCmd AS tea.Cmd = NIL
        IF p <> "" THEN oCmd = openFile(m, p)
        RETURN FALSE, oCmd
    END IF
    ' "saveas" — input modal asking where to write the active tab.
    ' Pre-flight: if the target already exists, chain a confirm
    ' modal so we don't silently clobber an unrelated file.
    IF m.ModalContext = "saveas" THEN
        DIM sp AS STRING = strings.TrimSpace(text)
        IF sp = "" OR NOT hasActiveTab(^m) THEN RETURN FALSE, NIL
        DIM sfi AS os.FileInfo
        DIM serr AS ERROR
        sfi, serr = os.Stat(sp)
        _ = sfi
        IF serr = NIL THEN
            m.PendingSaveAs = sp
            showModal(m, "Overwrite?", baseName(sp) + " already exists. Overwrite?", "Overwrite,Cancel", "saveas-overwrite")
            RETURN FALSE, NIL
        END IF
        m.Tabs[m.TabIdx].Path = sp
        saveCurrent(m)
        RETURN FALSE, NIL
    END IF
    ' "saveas-overwrite" — confirm from the chained modal.
    IF m.ModalContext = "saveas-overwrite" THEN
        IF button = "Overwrite" AND hasActiveTab(^m) THEN
            m.Tabs[m.TabIdx].Path = m.PendingSaveAs
            saveCurrent(m)
        ELSE
            m.Status = "save as cancelled"
        END IF
        m.PendingSaveAs = ""
        RETURN FALSE, NIL
    END IF
    ' "new" — input modal asking for a name for the fresh buffer.
    ' Pushes a tab with empty contents at that path (or "untitled"
    ' when the user just hits Enter).
    IF m.ModalContext = "new" THEN
        DIM np AS STRING = strings.TrimSpace(text)
        IF np = "" THEN np = "untitled"
        newEmptyTab(m, np)
        RETURN FALSE, NIL
    END IF
    ' "find" — saves the query and runs a fresh search from the top
    ' of the buffer (Ctrl+F always restarts the search; F3 continues).
    IF m.ModalContext = "find" THEN
        DIM fq AS STRING = text
        IF fq = "" THEN
            m.Status = "find cancelled"
            RETURN FALSE, NIL
        END IF
        m.FindQuery = fq
        findNextInActive(m, 0)
        RETURN FALSE, NIL
    END IF
    ' "replace-find" / "replace-with" — two-step Replace flow. The
    ' first prompt collects the pattern; on commit we chain a
    ' second input modal asking what to replace it with. The second
    ' modal's commit runs Replace All against the active buffer.
    IF m.ModalContext = "replace-find" THEN
        m.ReplaceFind = text
        IF text = "" THEN
            m.Status = "replace cancelled"
            RETURN FALSE, NIL
        END IF
        showInputModal(m, "Replace", "Replace with:", m.ReplaceText, "replace-with")
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "replace-with" THEN
        m.ReplaceText = text
        replaceAllInActive(m, m.ReplaceFind, m.ReplaceText)
        RETURN FALSE, NIL
    END IF
    ' "run-confirm" — three-button modal shown by doRun when the
    ' active buffer is dirty. Save & Run flushes first; Run As Is
    ' skips the save and runs the on-disk version; Cancel aborts.
    IF m.ModalContext = "run-confirm" THEN
        IF button = "Cancel" THEN
            m.Status = "run cancelled"
            RETURN FALSE, NIL
        END IF
        IF button = "Save & Run" THEN saveCurrent(m)
        DIM rcCmd AS tea.Cmd = runActiveNow(m)
        RETURN FALSE, rcCmd
    END IF
    ' "goto" — input modal asking for a 1-based line number.
    IF m.ModalContext = "goto" THEN
        DIM ln AS INTEGER
        DIM lnErr AS ERROR
        ln, lnErr = strconv.Atoi(strings.TrimSpace(text))
        IF lnErr <> NIL THEN
            m.Status = "not a line number: " + text
            RETURN FALSE, NIL
        END IF
        gotoLine(m, ln)
        RETURN FALSE, NIL
    END IF
    ' "findinfiles" — input modal that runs a project-wide grep
    ' and dumps the results into the bottom output pane.
    IF m.ModalContext = "findinfiles" THEN
        doFindInFiles(m, text)
        RETURN FALSE, NIL
    END IF
    ' "saveform" — input modal asking for a .dbproj path. Sets
    ' CurrentFormPath then runs saveForm.
    IF m.ModalContext = "saveform" THEN
        DIM sfPath AS STRING = strings.TrimSpace(text)
        IF sfPath = "" THEN RETURN FALSE, NIL
        m.Tabs[m.TabIdx].Path = sfPath
        saveForm(m)
        RETURN FALSE, NIL
    END IF
    ' "wprop:*" — widget property edits from clicks on the
    ' Properties panel rows in form mode.
    IF m.ModalContext = "wprop:name" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM oldNm AS STRING = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Name
            DIM newNm AS STRING = strings.TrimSpace(text)
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Name = newNm
            ' Rename every reference (handlers, model-field refs, Show<Name>())
            ' in the code editor + partner .dbas so the wiring survives regen.
            renameWidgetRefs(m, oldNm, newNm)
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:text" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Text = text
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:pos" THEN
        DIM pX AS INTEGER
        DIM pY AS INTEGER
        DIM pok AS BOOLEAN
        pX, pY, pok = parseTwoInts(text)
        IF pok AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            IF pX < 0 THEN pX = 0
            IF pY < 0 THEN pY = 0
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].X = pX
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Y = pY
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:size" THEN
        DIM sW AS INTEGER
        DIM sH AS INTEGER
        DIM sok AS BOOLEAN
        sW, sH, sok = parseTwoInts(text)
        IF sok AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            IF sW < 1 THEN sW = 1
            IF sH < 1 THEN sH = 1
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].W = sW
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].H = sH
        END IF
        RETURN FALSE, NIL
    END IF
    ' --- Kind-specific widget property edits --------------------
    ' All gated on a valid SelWidget; if the user clicked Properties
    ' for a widget then deleted it before committing the modal, the
    ' edit silently no-ops.
    IF m.ModalContext = "wprop:checked" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM ckLo AS STRING = strings.ToLower(strings.TrimSpace(text))
            DIM ckVal AS BOOLEAN = (ckLo = "true") OR (ckLo = "yes") OR (ckLo = "1") OR (ckLo = "t")
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Checked = ckVal
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:group" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Group = strings.TrimSpace(text)
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:items" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM itParts AS []STRING = strings.Split(text, ",")
            DIM itOut AS []STRING
            DIM itI AS INTEGER
            FOR itI = 0 TO LEN(itParts) - 1
                DIM itTrim AS STRING = strings.TrimSpace(itParts[itI])
                IF itTrim <> "" THEN itOut = APPEND(itOut, itTrim)
            NEXT itI
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Items = itOut
            ' Clamp Selected so it can't dangle past the new last index.
            DIM selCur AS INTEGER = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Selected
            IF selCur >= LEN(itOut) THEN
                DIM newSel AS INTEGER = LEN(itOut) - 1
                IF newSel < 0 THEN newSel = 0
                m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Selected = newSel
            END IF
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:selected" THEN
        DIM selV AS INTEGER
        DIM selErr AS ERROR
        selV, selErr = strconv.Atoi(strings.TrimSpace(text))
        IF selErr = NIL AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            IF selV < 0 THEN selV = 0
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Selected = selV
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:min" THEN
        DIM mnV AS INTEGER
        DIM mnErr AS ERROR
        mnV, mnErr = strconv.Atoi(strings.TrimSpace(text))
        IF mnErr = NIL AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Min = mnV
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:max" THEN
        DIM mxV AS INTEGER
        DIM mxErr AS ERROR
        mxV, mxErr = strconv.Atoi(strings.TrimSpace(text))
        IF mxErr = NIL AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Max = mxV
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:value" THEN
        DIM vlV AS INTEGER
        DIM vlErr AS ERROR
        vlV, vlErr = strconv.Atoi(strings.TrimSpace(text))
        IF vlErr = NIL AND m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Value = vlV
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:orient" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM orLo AS STRING = strings.ToLower(strings.TrimSpace(text))
            IF orLo = "h" OR orLo = "v" THEN
                m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Orient = orLo
            END IF
        END IF
        RETURN FALSE, NIL
    END IF
    ' "wprop:dialog*" — Dialog widget property edits. dialogkind is
    ' constrained to confirm | input | file; dialogmode to open | save.
    ' Out-of-band values are silently rejected.
    IF m.ModalContext = "wprop:dialogkind" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM dkLo AS STRING = strings.ToLower(strings.TrimSpace(text))
            IF dkLo = "confirm" OR dkLo = "input" OR dkLo = "file" THEN
                m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].DialogKind = dkLo
            END IF
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:dialogmsg" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].DialogMsg = text
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:dialogdef" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].DialogDef = text
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:dialogmode" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            DIM dmLo AS STRING = strings.ToLower(strings.TrimSpace(text))
            IF dmLo = "open" OR dmLo = "save" THEN
                m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].DialogMode = dmLo
            END IF
        END IF
        RETURN FALSE, NIL
    END IF
    IF m.ModalContext = "wprop:dialogmask" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].DialogMask = strings.TrimSpace(text)
        END IF
        RETURN FALSE, NIL
    END IF
    ' "wprop:parent" — container membership. Names the Panel this
    ' widget lives inside; blank = top-level.
    IF m.ModalContext = "wprop:parent" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].Parent = strings.TrimSpace(text)
        END IF
        RETURN FALSE, NIL
    END IF
    ' "wprop:onclickdialog" — Button.OnClickDialog field. Blank
    ' value clears the auto-wire.
    IF m.ModalContext = "wprop:onclickdialog" THEN
        IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
            m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget].OnClickDialog = strings.TrimSpace(text)
        END IF
        RETURN FALSE, NIL
    END IF
    ' "watch:reload" — file-watcher prompt. Reload reads disk;
    ' Keep silences the prompt by refreshing LoadedMtime to the
    ' current disk mtime; Cancel does nothing (next tick will
    ' re-prompt).
    IF m.ModalContext = "watch:reload" THEN
        IF button = "Reload" OR button = "Reload (lose edits)" THEN
            reloadActiveFromDisk(m)
        ELSEIF button = "Keep editor" OR button = "Keep" THEN
            refreshActiveMtime(m)
            m.Status = "kept editor version"
        END IF
        RETURN FALSE, NIL
    END IF
    m.Status = "modal " + m.ModalContext + " → " + button
    RETURN FALSE, NIL
END FUNCTION

' =========================================================================
' Visual Menu Editor — edits a Menubar widget's []MenuNode tree in a modal
' working copy. Mirrors the enum-picker pattern: module state on Model,
' open / commit / cancel + structural ops here, render + hit-test in
' render.dbas, input routing in dbtui.dbas Update, composited by View.
' The flat list is depth-ordered (pre-order); a node's subtree is itself
' plus every following deeper node.
' =========================================================================

' menuSubtreeEnd — index just past the subtree rooted at idx (idx + every
' following deeper node). For a leaf this is idx + 1.
FUNCTION menuSubtreeEnd(nodes AS []MenuNode, idx AS INTEGER) AS INTEGER
    DIM d AS INTEGER = nodes[idx].Depth
    DIM j AS INTEGER = idx + 1
    DO WHILE j < LEN(nodes) AND nodes[j].Depth > d
        j = j + 1
    LOOP
    RETURN j
END FUNCTION

' menuPrevSibling — index of idx's previous sibling (same depth, no
' shallower node between), or -1 if idx is the first child / top item.
FUNCTION menuPrevSibling(nodes AS []MenuNode, idx AS INTEGER) AS INTEGER
    DIM d AS INTEGER = nodes[idx].Depth
    DIM j AS INTEGER = idx - 1
    DO WHILE j >= 0
        IF nodes[j].Depth < d THEN RETURN 0 - 1
        IF nodes[j].Depth = d THEN RETURN j
        j = j - 1
    LOOP
    RETURN 0 - 1
END FUNCTION

' menuRangeAppend — append nodes src[a:b) onto dst (struct copies).
FUNCTION menuRangeAppend(dst AS []MenuNode, src AS []MenuNode, a AS INTEGER, b AS INTEGER) AS []MenuNode
    DIM i AS INTEGER
    FOR i = a TO b - 1
        dst = APPEND(dst, src[i])
    NEXT i
    RETURN dst
END FUNCTION

' menuEdSeedInputs — (re)create the three field editors from the selected
' node's current values, so they reflect whatever row is highlighted.
SUB menuEdSeedInputs(m AS POINTER TO Model)
    DIM cap AS STRING = ""
    DIM nm  AS STRING = ""
    DIM sc  AS STRING = ""
    IF m.MenuEdSel >= 0 AND m.MenuEdSel < LEN(m.MenuEdNodes) THEN
        cap = m.MenuEdNodes[m.MenuEdSel].Caption
        nm  = m.MenuEdNodes[m.MenuEdSel].Name
        sc  = m.MenuEdNodes[m.MenuEdSel].Shortcut
    END IF
    m.MenuEdCapIn = textinput.New()
    m.MenuEdCapIn.SetValue(cap)
    m.MenuEdCapIn.CursorEnd()
    m.MenuEdNameIn = textinput.New()
    m.MenuEdNameIn.SetValue(nm)
    m.MenuEdNameIn.CursorEnd()
    m.MenuEdScIn = textinput.New()
    m.MenuEdScIn.SetValue(sc)
    m.MenuEdScIn.CursorEnd()
END SUB

' menuEdSyncInputs — write the three field editors back into the selected
' node (called before any structural change and on commit so edits stick).
SUB menuEdSyncInputs(m AS POINTER TO Model)
    IF m.MenuEdSel < 0 OR m.MenuEdSel >= LEN(m.MenuEdNodes) THEN RETURN
    m.MenuEdNodes[m.MenuEdSel].Caption  = m.MenuEdCapIn.Value()
    m.MenuEdNodes[m.MenuEdSel].Name     = m.MenuEdNameIn.Value()
    m.MenuEdNodes[m.MenuEdSel].Shortcut = m.MenuEdScIn.Value()
END SUB

' menuEdFocus — focus the textinput for the active field (MenuEdField
' 0/1/2 = Caption/Name/Shortcut), blurring the others. No-op for list mode.
SUB menuEdFocus(m AS POINTER TO Model)
    m.MenuEdCapIn.Blur()
    m.MenuEdNameIn.Blur()
    m.MenuEdScIn.Blur()
    DIM c AS tea.Cmd
    IF m.MenuEdField = 0 THEN c = m.MenuEdCapIn.Focus()
    IF m.MenuEdField = 1 THEN c = m.MenuEdNameIn.Focus()
    IF m.MenuEdField = 2 THEN c = m.MenuEdScIn.Focus()
    _ = c
END SUB

' showMenuEditor — open the editor on a Menubar widget, copying its menu
' tree into the working set. A no-op for any other kind / bad index.
SUB showMenuEditor(m AS POINTER TO Model, widgetIdx AS INTEGER)
    IF widgetIdx < 0 OR widgetIdx >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    IF m.Tabs[m.TabIdx].Form.Widgets[widgetIdx].Kind <> "Menubar" THEN RETURN
    m.MenuEdWidget = widgetIdx
    DIM work AS []MenuNode
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets[widgetIdx].Menu) - 1
        work = APPEND(work, m.Tabs[m.TabIdx].Form.Widgets[widgetIdx].Menu[i])
    NEXT i
    m.MenuEdNodes = work
    m.MenuEdSel   = 0
    m.MenuEdField = 0 - 1
    menuEdSeedInputs(m)
    m.MenuEdActive = TRUE
END SUB

' cancelMenuEditor — close without applying.
SUB cancelMenuEditor(m AS POINTER TO Model)
    m.MenuEdActive = FALSE
    m.MenuEdField  = 0 - 1
END SUB

' menuEditorCommit — write the working tree back to the widget, mark the
' tab dirty, refresh the canvas, and close.
SUB menuEditorCommit(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    IF m.MenuEdWidget >= 0 AND m.MenuEdWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
        m.Tabs[m.TabIdx].Form.Widgets[m.MenuEdWidget].Menu = m.MenuEdNodes
        m.Tabs[m.TabIdx].Dirty = TRUE
        invalidateEditorCache(m)
    END IF
    m.MenuEdActive = FALSE
    m.MenuEdField  = 0 - 1
END SUB

' menuEdSelMove — move the list selection by dir (-1 up / +1 down), clamped.
SUB menuEdSelMove(m AS POINTER TO Model, dir AS INTEGER)
    menuEdSyncInputs(m)
    DIM n AS INTEGER = LEN(m.MenuEdNodes)
    IF n = 0 THEN RETURN
    m.MenuEdSel = m.MenuEdSel + dir
    IF m.MenuEdSel < 0 THEN m.MenuEdSel = 0
    IF m.MenuEdSel >= n THEN m.MenuEdSel = n - 1
    menuEdSeedInputs(m)
END SUB

' menuEdInsert — add a new sibling after the selected node's whole subtree
' (so it doesn't accidentally adopt the selection's children), at the same
' depth, auto-named. Empty list → a first top-level item.
SUB menuEdInsert(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    DIM nodes AS []MenuNode = m.MenuEdNodes
    DIM sel AS INTEGER = m.MenuEdSel
    DIM depth AS INTEGER = 0
    DIM insAt AS INTEGER = LEN(nodes)
    IF LEN(nodes) > 0 AND sel >= 0 AND sel < LEN(nodes) THEN
        depth = nodes[sel].Depth
        insAt = menuSubtreeEnd(nodes, sel)
    END IF
    DIM nn AS MenuNode
    nn.Depth   = depth
    nn.Caption = "Item"
    nn.Name    = menuAutoName("Item", menuNodeNames(nodes))
    DIM out AS []MenuNode
    out = menuRangeAppend(out, nodes, 0, insAt)
    out = APPEND(out, nn)
    out = menuRangeAppend(out, nodes, insAt, LEN(nodes))
    m.MenuEdNodes = out
    m.MenuEdSel   = insAt
    menuEdSeedInputs(m)
END SUB

' menuEdDelete — remove the selected node and its whole subtree.
SUB menuEdDelete(m AS POINTER TO Model)
    DIM nodes AS []MenuNode = m.MenuEdNodes
    DIM sel AS INTEGER = m.MenuEdSel
    IF sel < 0 OR sel >= LEN(nodes) THEN RETURN
    DIM endIdx AS INTEGER = menuSubtreeEnd(nodes, sel)
    DIM out AS []MenuNode
    out = menuRangeAppend(out, nodes, 0, sel)
    out = menuRangeAppend(out, nodes, endIdx, LEN(nodes))
    m.MenuEdNodes = out
    IF m.MenuEdSel >= LEN(out) THEN m.MenuEdSel = LEN(out) - 1
    IF m.MenuEdSel < 0 THEN m.MenuEdSel = 0
    menuEdSeedInputs(m)
END SUB

' menuEdIndent — deepen the selected subtree by one level, but only when
' the node above can serve as a parent (its depth >= the selection's).
SUB menuEdIndent(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    DIM sel AS INTEGER = m.MenuEdSel
    IF sel <= 0 OR sel >= LEN(m.MenuEdNodes) THEN RETURN
    IF m.MenuEdNodes[sel - 1].Depth < m.MenuEdNodes[sel].Depth THEN RETURN
    DIM endIdx AS INTEGER = menuSubtreeEnd(m.MenuEdNodes, sel)
    DIM i AS INTEGER
    FOR i = sel TO endIdx - 1
        m.MenuEdNodes[i].Depth = m.MenuEdNodes[i].Depth + 1
    NEXT i
END SUB

' menuEdOutdent — shallow the selected subtree by one level (not below 0).
SUB menuEdOutdent(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    DIM sel AS INTEGER = m.MenuEdSel
    IF sel < 0 OR sel >= LEN(m.MenuEdNodes) THEN RETURN
    IF m.MenuEdNodes[sel].Depth = 0 THEN RETURN
    DIM endIdx AS INTEGER = menuSubtreeEnd(m.MenuEdNodes, sel)
    DIM i AS INTEGER
    FOR i = sel TO endIdx - 1
        m.MenuEdNodes[i].Depth = m.MenuEdNodes[i].Depth - 1
    NEXT i
END SUB

' menuEdMoveUp — swap the selected subtree with its previous sibling's.
SUB menuEdMoveUp(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    DIM nodes AS []MenuNode = m.MenuEdNodes
    DIM sel AS INTEGER = m.MenuEdSel
    IF sel < 0 OR sel >= LEN(nodes) THEN RETURN
    DIM ps AS INTEGER = menuPrevSibling(nodes, sel)
    IF ps < 0 THEN RETURN
    DIM endIdx AS INTEGER = menuSubtreeEnd(nodes, sel)
    DIM out AS []MenuNode
    out = menuRangeAppend(out, nodes, 0, ps)
    out = menuRangeAppend(out, nodes, sel, endIdx)
    out = menuRangeAppend(out, nodes, ps, sel)
    out = menuRangeAppend(out, nodes, endIdx, LEN(nodes))
    m.MenuEdNodes = out
    m.MenuEdSel   = ps
    menuEdSeedInputs(m)
END SUB

' menuEdMoveDown — swap the selected subtree with its next sibling's.
SUB menuEdMoveDown(m AS POINTER TO Model)
    menuEdSyncInputs(m)
    DIM nodes AS []MenuNode = m.MenuEdNodes
    DIM sel AS INTEGER = m.MenuEdSel
    IF sel < 0 OR sel >= LEN(nodes) THEN RETURN
    DIM selEnd AS INTEGER = menuSubtreeEnd(nodes, sel)
    IF selEnd >= LEN(nodes) THEN RETURN
    IF nodes[selEnd].Depth <> nodes[sel].Depth THEN RETURN
    DIM nsEnd AS INTEGER = menuSubtreeEnd(nodes, selEnd)
    DIM out AS []MenuNode
    out = menuRangeAppend(out, nodes, 0, sel)
    out = menuRangeAppend(out, nodes, selEnd, nsEnd)
    out = menuRangeAppend(out, nodes, sel, selEnd)
    out = menuRangeAppend(out, nodes, nsEnd, LEN(nodes))
    m.MenuEdNodes = out
    m.MenuEdSel   = sel + (nsEnd - selEnd)
    menuEdSeedInputs(m)
END SUB

' menuEdToggleSep / Checked / Disabled — flip the selected node's flag.
SUB menuEdToggleSep(m AS POINTER TO Model)
    IF m.MenuEdSel < 0 OR m.MenuEdSel >= LEN(m.MenuEdNodes) THEN RETURN
    m.MenuEdNodes[m.MenuEdSel].IsSep = NOT m.MenuEdNodes[m.MenuEdSel].IsSep
END SUB

SUB menuEdToggleChecked(m AS POINTER TO Model)
    IF m.MenuEdSel < 0 OR m.MenuEdSel >= LEN(m.MenuEdNodes) THEN RETURN
    m.MenuEdNodes[m.MenuEdSel].Checked = NOT m.MenuEdNodes[m.MenuEdSel].Checked
END SUB

SUB menuEdToggleDisabled(m AS POINTER TO Model)
    IF m.MenuEdSel < 0 OR m.MenuEdSel >= LEN(m.MenuEdNodes) THEN RETURN
    m.MenuEdNodes[m.MenuEdSel].Disabled = NOT m.MenuEdNodes[m.MenuEdSel].Disabled
END SUB
