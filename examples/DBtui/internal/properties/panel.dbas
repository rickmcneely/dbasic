' DBtui — internal/properties/panel.dbas
'
' Properties panel — two-column property table for the currently
' selected widget (or the form, when nothing is selected). Direct
' shape-port of ~/vgtui/internal/properties/panel.go, trimmed for the
' minimal-boot phase.
'
' This commit ships a **read-only viewer** with cursor navigation and
' type-aware value rendering (`[x]/[ ]` checkboxes for bool, swatch +
' hex string for color, `◂ value ▸` for enum). Inline text editing,
' dropdown picker, and color picker land alongside the dialog system
' in a follow-on commit.

IMPORT "charm.land/lipgloss/v2" AS lipgloss
IMPORT "fmt"
IMPORT "strings"

' ----------------------------------------------------------------------
' Row data
' ----------------------------------------------------------------------

TYPE PropRow
    DIM Name     AS STRING
    DIM Value    AS STRING
    DIM Editable AS BOOLEAN
    DIM IsBool   AS BOOLEAN     ' toggleable bool
    DIM IsColor  AS BOOLEAN     ' show swatch + hex
    DIM Options  AS []STRING    ' enum dropdown
    DIM Category AS STRING      ' non-empty = section header
END TYPE

' Builders to keep rebuildRows() readable.
FUNCTION cat(label AS STRING) AS PropRow
    DIM r AS PropRow
    r.Category = label
    RETURN r
END FUNCTION

FUNCTION rowText(name AS STRING, value AS STRING) AS PropRow
    DIM r AS PropRow
    r.Name = name
    r.Value = value
    r.Editable = TRUE
    RETURN r
END FUNCTION

FUNCTION rowReadOnly(name AS STRING, value AS STRING) AS PropRow
    DIM r AS PropRow
    r.Name = name
    r.Value = value
    r.Editable = FALSE
    RETURN r
END FUNCTION

FUNCTION rowBool(name AS STRING, value AS BOOLEAN) AS PropRow
    DIM r AS PropRow
    r.Name = name
    IF value THEN
        r.Value = "true"
    ELSE
        r.Value = "false"
    END IF
    r.Editable = TRUE
    r.IsBool = TRUE
    RETURN r
END FUNCTION

FUNCTION rowEnum(name AS STRING, value AS STRING, options AS []STRING) AS PropRow
    DIM r AS PropRow
    r.Name = name
    r.Value = value
    r.Editable = TRUE
    r.Options = options
    RETURN r
END FUNCTION

FUNCTION rowColor(name AS STRING, value AS STRING) AS PropRow
    DIM r AS PropRow
    r.Name = name
    r.Value = value
    r.Editable = TRUE
    r.IsColor = TRUE
    RETURN r
END FUNCTION

' ----------------------------------------------------------------------
' Panel
' ----------------------------------------------------------------------

TYPE PropertiesPanel
    DIM Rows     AS []PropRow
    DIM Cursor   AS INTEGER
    DIM Hover    AS INTEGER          ' mouseover row (-1 for none)
    DIM Width    AS INTEGER
    DIM Height   AS INTEGER
    DIM Offset   AS INTEGER
    DIM Focused  AS BOOLEAN
    DIM ShowForm AS BOOLEAN
    DIM HasWidget AS BOOLEAN
    DIM HasTool   AS BOOLEAN
    DIM CurForm  AS Form             ' shown when ShowForm
    DIM CurWidget AS Widget          ' shown when HasWidget
    DIM CurTool   AS ToolEntry       ' shown when HasTool
    DIM EditMode   AS BOOLEAN        ' TRUE while typing into EditBuffer
    DIM EditBuffer AS STRING         ' live edit string (text/int/color)
    DIM EditPos    AS INTEGER        ' caret offset within EditBuffer [0..LEN]
    DIM EditError  AS STRING         ' last commit error; cleared on next keypress
END TYPE

FUNCTION NewPropertiesPanel() AS PropertiesPanel
    DIM p AS PropertiesPanel
    p.Cursor = -1
    p.Hover = -1
    RETURN p
END FUNCTION

SUB (p AS POINTER TO PropertiesPanel) Clear()
    DIM emptyRows AS []PropRow
    p.Rows = emptyRows
    p.Cursor = -1
    p.Offset = 0
    p.HasWidget = FALSE
    p.HasTool = FALSE
    p.ShowForm = FALSE
END SUB

SUB (p AS POINTER TO PropertiesPanel) SetWidget(w AS Widget)
    p.CurWidget = w
    p.HasWidget = TRUE
    p.HasTool = FALSE
    p.ShowForm = FALSE
    p.Cursor = 0
    p.Offset = 0
    p.rebuildRows()
    p.skipCategoriesForward()
END SUB

SUB (p AS POINTER TO PropertiesPanel) SetForm(f AS Form)
    p.CurForm = f
    p.ShowForm = TRUE
    p.HasWidget = FALSE
    p.HasTool = FALSE
    p.Cursor = 0
    p.Offset = 0
    p.rebuildRows()
    p.skipCategoriesForward()
END SUB

SUB (p AS POINTER TO PropertiesPanel) SetTool(t AS ToolEntry)
    p.CurTool = t
    p.HasTool = TRUE
    p.HasWidget = FALSE
    p.ShowForm = FALSE
    p.Cursor = 0
    p.Offset = 0
    p.rebuildRows()
    p.skipCategoriesForward()
END SUB

' rebuildRows flushes p.Rows and re-derives them from the current
' widget or form. When neither is set the panel shows a placeholder.
SUB (p AS POINTER TO PropertiesPanel) rebuildRows()
    DIM rows AS []PropRow

    IF p.ShowForm THEN
        DIM f AS Form = p.CurForm
        rows = APPEND(rows, cat("▸ Form"))
        rows = APPEND(rows, rowText("Name", f.Name))
        rows = APPEND(rows, rowText("Title", f.Title))
        rows = APPEND(rows, rowText("Width", fmt.Sprintf("%d", f.Width)))
        rows = APPEND(rows, rowText("Height", fmt.Sprintf("%d", f.Height)))
        rows = APPEND(rows, cat("▸ Behavior"))
        rows = APPEND(rows, rowBool("Modal", f.Modal))
        rows = APPEND(rows, rowBool("ResizableX", f.ResizableX))
        rows = APPEND(rows, rowBool("ResizableY", f.ResizableY))
        rows = APPEND(rows, rowBool("Visible", f.Visible))
        rows = APPEND(rows, rowBool("Taskbar", f.ShowInTaskbar))
        rows = APPEND(rows, rowBool("StatusBar", f.ShowStatusBar))
        rows = APPEND(rows, cat("▸ Appearance"))
        DIM borderOpts AS []STRING
        borderOpts = APPEND(borderOpts, "normal")
        borderOpts = APPEND(borderOpts, "thick")
        borderOpts = APPEND(borderOpts, "double")
        borderOpts = APPEND(borderOpts, "none")
        rows = APPEND(rows, rowEnum("Border", f.Border, borderOpts))
        DIM cornerOpts AS []STRING
        cornerOpts = APPEND(cornerOpts, "square")
        cornerOpts = APPEND(cornerOpts, "round")
        rows = APPEND(rows, rowEnum("Corner", f.Corner, cornerOpts))
        DIM startOpts AS []STRING
        startOpts = APPEND(startOpts, "center")
        startOpts = APPEND(startOpts, "topleft")
        startOpts = APPEND(startOpts, "manual")
        rows = APPEND(rows, rowEnum("StartPos", f.StartPos, startOpts))
        rows = APPEND(rows, rowColor("BgColor", f.BgColor))
        rows = APPEND(rows, rowColor("FgColor", f.FgColor))
        rows = APPEND(rows, cat("▸ File Info"))
        rows = APPEND(rows, rowReadOnly("File", f.File))
        rows = APPEND(rows, rowReadOnly("Code", f.Code))
        rows = APPEND(rows, rowReadOnly("Widgets", fmt.Sprintf("%d", LEN(f.Widgets))))
        p.Rows = rows
        RETURN
    END IF

    IF p.HasTool THEN
        DIM tw AS Widget = ToolToWidget(p.CurTool)
        rows = APPEND(rows, cat("▸ " + p.CurTool.Kind + " (tool)"))
        rows = APPEND(rows, rowText("Name", p.CurTool.Id))
        DIM kindProps2 AS []Property
        IF p.CurTool.Kind = WidgetKindFileDialog THEN kindProps2 = FileDialogProperties(tw)
        DIM tj AS INTEGER
        FOR tj = 0 TO LEN(kindProps2) - 1
            rows = APPEND(rows, propToRow(kindProps2[tj]))
        NEXT tj
        p.Rows = rows
        RETURN
    END IF

    IF p.HasWidget THEN
        DIM w AS Widget = p.CurWidget
        rows = APPEND(rows, cat("▸ " + w.Kind))
        rows = APPEND(rows, rowText("Name", w.Id))
        rows = APPEND(rows, rowBool("Visible", w.Visible))
        rows = APPEND(rows, rowText("ZOrder", fmt.Sprintf("%d", w.ZOrder)))
        rows = APPEND(rows, rowText("TabIndex", fmt.Sprintf("%d", w.TabIndex)))
        rows = APPEND(rows, rowBool("TabStop", w.TabStop))
        rows = APPEND(rows, rowText("Anchor", w.Anchor))

        ' Kind-specific properties (Text, Placeholder, Value, Align...).
        ' Style props are sorted into their own section below.
        DIM kindProps AS []Property
        IF w.Kind = WidgetKindButton     THEN kindProps = ButtonProperties(w)
        IF w.Kind = WidgetKindLabel      THEN kindProps = LabelProperties(w)
        IF w.Kind = WidgetKindTextInput  THEN kindProps = TextInputProperties(w)
        IF w.Kind = WidgetKindFileDialog THEN kindProps = FileDialogProperties(w)
        IF w.Kind = WidgetKindCheckbox    THEN kindProps = CheckboxProperties(w)
        IF w.Kind = WidgetKindComboBox    THEN kindProps = ComboBoxProperties(w)
        IF w.Kind = WidgetKindListBox     THEN kindProps = ListBoxProperties(w)
        IF w.Kind = WidgetKindRadioButton THEN kindProps = RadioButtonProperties(w)
        IF w.Kind = WidgetKindProgressBar THEN kindProps = ProgressBarProperties(w)
        IF w.Kind = WidgetKindScrollBar   THEN kindProps = ScrollBarProperties(w)
        IF w.Kind = WidgetKindTabStrip    THEN kindProps = TabStripProperties(w)
        IF w.Kind = WidgetKindScrollPane  THEN kindProps = ScrollPaneProperties(w)

        DIM hasStyleProps AS BOOLEAN = FALSE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kindProps) - 1
            DIM kp AS Property = kindProps[i]
            DIM isStyle AS BOOLEAN = FALSE
            IF kp.Kind = "color" THEN isStyle = TRUE
            IF kp.Kind = "enum" AND (kp.Name = "Border" OR kp.Name = "Corner") THEN isStyle = TRUE
            IF isStyle THEN
                hasStyleProps = TRUE
            ELSE
                rows = APPEND(rows, propToRow(kp))
            END IF
        NEXT i

        rows = APPEND(rows, cat("▸ Layout"))
        rows = APPEND(rows, rowText("X",      fmt.Sprintf("%d", w.X)))
        rows = APPEND(rows, rowText("Y",      fmt.Sprintf("%d", w.Y)))
        rows = APPEND(rows, rowText("Width",  fmt.Sprintf("%d", w.W)))
        rows = APPEND(rows, rowText("Height", fmt.Sprintf("%d", w.H)))

        IF hasStyleProps THEN
            rows = APPEND(rows, cat("▸ Style"))
            DIM j AS INTEGER
            FOR j = 0 TO LEN(kindProps) - 1
                DIM kpStyle AS Property = kindProps[j]
                DIM isStyleProp AS BOOLEAN = FALSE
                IF kpStyle.Kind = "color" THEN isStyleProp = TRUE
                IF kpStyle.Kind = "enum" AND (kpStyle.Name = "Border" OR kpStyle.Name = "Corner") THEN isStyleProp = TRUE
                IF isStyleProp THEN rows = APPEND(rows, propToRow(kpStyle))
            NEXT j
        END IF

        p.Rows = rows
        RETURN
    END IF

    rows = APPEND(rows, cat("  (no selection)"))
    p.Rows = rows
END SUB

' propToRow translates a widget Property into a PropRow with the right
' display flags (bool/color/enum/text).
FUNCTION propToRow(p AS Property) AS PropRow
    DIM r AS PropRow
    r.Name = p.Name
    r.Editable = TRUE
    IF p.Kind = "bool" THEN
        r.IsBool = TRUE
        DIM b AS BOOLEAN
        DIM ok AS BOOLEAN
        b, ok = p.Value.(BOOLEAN)
        IF ok AND b THEN
            r.Value = "true"
        ELSE
            r.Value = "false"
        END IF
        RETURN r
    END IF
    IF p.Kind = "color" THEN
        r.IsColor = TRUE
        DIM s AS STRING
        DIM cok AS BOOLEAN
        s, cok = p.Value.(STRING)
        IF cok THEN r.Value = s
        RETURN r
    END IF
    IF p.Kind = "enum" THEN
        r.Options = p.Options
        DIM s2 AS STRING
        DIM eok AS BOOLEAN
        s2, eok = p.Value.(STRING)
        IF eok THEN r.Value = s2
        RETURN r
    END IF
    DIM s3 AS STRING
    DIM sok AS BOOLEAN
    s3, sok = p.Value.(STRING)
    IF sok THEN r.Value = s3
    RETURN r
END FUNCTION

' ----------------------------------------------------------------------
' Geometry / cursor
' ----------------------------------------------------------------------

FUNCTION (p AS PropertiesPanel) InnerHeight() AS INTEGER
    RETURN p.Height - 2
END FUNCTION

SUB (p AS POINTER TO PropertiesPanel) SetSize(w AS INTEGER, h AS INTEGER)
    p.Width = w
    p.Height = h
END SUB

SUB (p AS POINTER TO PropertiesPanel) SetFocused(f AS BOOLEAN)
    p.Focused = f
END SUB

SUB (p AS POINTER TO PropertiesPanel) skipCategoriesForward()
    DO WHILE p.Cursor >= 0 AND p.Cursor < LEN(p.Rows) AND p.Rows[p.Cursor].Category <> ""
        p.Cursor = p.Cursor + 1
    LOOP
    IF p.Cursor >= LEN(p.Rows) THEN p.Cursor = LEN(p.Rows) - 1
END SUB

SUB (p AS POINTER TO PropertiesPanel) CursorUp()
    DO
        p.Cursor = p.Cursor - 1
        IF p.Cursor < 0 THEN
            p.Cursor = 0
            EXIT DO
        END IF
        IF p.Rows[p.Cursor].Category = "" THEN EXIT DO
    LOOP
    p.ensureVisible()
END SUB

SUB (p AS POINTER TO PropertiesPanel) CursorDown()
    DO
        p.Cursor = p.Cursor + 1
        IF p.Cursor >= LEN(p.Rows) THEN
            p.Cursor = LEN(p.Rows) - 1
            EXIT DO
        END IF
        IF p.Rows[p.Cursor].Category = "" THEN EXIT DO
    LOOP
    p.ensureVisible()
END SUB

SUB (p AS POINTER TO PropertiesPanel) ensureVisible()
    DIM innerH AS INTEGER = p.InnerHeight()
    IF innerH <= 0 THEN RETURN
    IF p.Cursor < p.Offset THEN p.Offset = p.Cursor
    IF p.Cursor >= p.Offset + innerH THEN p.Offset = p.Cursor - innerH + 1
END SUB

' ----------------------------------------------------------------------
' Edit-mode methods — called by the app's key dispatcher when the
' Properties panel is focused.
' ----------------------------------------------------------------------

' CurrentRow returns the row under the cursor and an ok flag.
FUNCTION (p AS PropertiesPanel) CurrentRow() AS (PropRow, BOOLEAN)
    DIM zero AS PropRow
    IF p.Cursor < 0 OR p.Cursor >= LEN(p.Rows) THEN RETURN zero, FALSE
    RETURN p.Rows[p.Cursor], TRUE
END FUNCTION

' ToggleBool flips a bool row. Returns (name, newValue, ok). ok=FALSE
' when the cursor row isn't an editable bool. Does NOT mutate the
' source — the caller applies the change via SetWidgetProperty /
' SetFormProperty and then calls RefreshFromWidget / RefreshFromForm.
FUNCTION (p AS POINTER TO PropertiesPanel) ToggleBool() AS (STRING, BOOLEAN, BOOLEAN)
    IF p.Cursor < 0 OR p.Cursor >= LEN(p.Rows) THEN RETURN "", FALSE, FALSE
    DIM r AS PropRow = p.Rows[p.Cursor]
    IF NOT r.IsBool OR NOT r.Editable THEN RETURN "", FALSE, FALSE
    DIM newVal AS BOOLEAN = TRUE
    IF r.Value = "true" THEN newVal = FALSE
    p.EditError = ""
    RETURN r.Name, newVal, TRUE
END FUNCTION

' CycleEnum advances an enum row by dir (+1 or -1), wrapping. Returns
' (name, newValue, ok). Same non-mutating contract as ToggleBool.
FUNCTION (p AS POINTER TO PropertiesPanel) CycleEnum(dir AS INTEGER) AS (STRING, STRING, BOOLEAN)
    IF p.Cursor < 0 OR p.Cursor >= LEN(p.Rows) THEN RETURN "", "", FALSE
    DIM r AS PropRow = p.Rows[p.Cursor]
    IF LEN(r.Options) = 0 OR NOT r.Editable THEN RETURN "", "", FALSE
    ' Find current index in Options; -1 if not found.
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(r.Options) - 1
        IF r.Options[i] = r.Value THEN idx = i
    NEXT i
    DIM n AS INTEGER = LEN(r.Options)
    IF idx < 0 THEN idx = 0
    idx = idx + dir
    DO WHILE idx < 0
        idx = idx + n
    LOOP
    DO WHILE idx >= n
        idx = idx - n
    LOOP
    p.EditError = ""
    RETURN r.Name, r.Options[idx], TRUE
END FUNCTION

' BeginEdit enters PropEdit mode on the current row. Returns FALSE when
' the row isn't a text/int/color editable row (bools and enums are
' handled by direct toggles instead). Seeds EditBuffer from the row's
' current displayed Value and places the caret at the end.
FUNCTION (p AS POINTER TO PropertiesPanel) BeginEdit() AS BOOLEAN
    IF p.Cursor < 0 OR p.Cursor >= LEN(p.Rows) THEN RETURN FALSE
    DIM r AS PropRow = p.Rows[p.Cursor]
    IF NOT r.Editable THEN RETURN FALSE
    IF r.IsBool THEN RETURN FALSE
    IF LEN(r.Options) > 0 THEN RETURN FALSE
    p.EditMode = TRUE
    p.EditBuffer = r.Value
    p.EditPos = LEN(r.Value)
    p.EditError = ""
    RETURN TRUE
END FUNCTION

' clampEditPos keeps EditPos in [0..LEN(EditBuffer)] after a buffer
' mutation.
SUB (p AS POINTER TO PropertiesPanel) clampEditPos()
    IF p.EditPos < 0 THEN p.EditPos = 0
    IF p.EditPos > LEN(p.EditBuffer) THEN p.EditPos = LEN(p.EditBuffer)
END SUB

' EditChar inserts a character at the caret and advances the caret.
SUB (p AS POINTER TO PropertiesPanel) EditChar(s AS STRING)
    IF NOT p.EditMode THEN RETURN
    DIM before AS STRING = Mid(p.EditBuffer, 1, p.EditPos)
    DIM after AS STRING = ""
    IF p.EditPos < LEN(p.EditBuffer) THEN
        after = Mid(p.EditBuffer, p.EditPos + 1, LEN(p.EditBuffer) - p.EditPos)
    END IF
    p.EditBuffer = before + s + after
    p.EditPos = p.EditPos + LEN(s)
    p.EditError = ""
END SUB

' EditBackspace deletes the character before the caret (←⌫).
SUB (p AS POINTER TO PropertiesPanel) EditBackspace()
    IF NOT p.EditMode THEN RETURN
    IF p.EditPos = 0 THEN RETURN
    DIM before AS STRING = Mid(p.EditBuffer, 1, p.EditPos - 1)
    DIM after AS STRING = ""
    IF p.EditPos < LEN(p.EditBuffer) THEN
        after = Mid(p.EditBuffer, p.EditPos + 1, LEN(p.EditBuffer) - p.EditPos)
    END IF
    p.EditBuffer = before + after
    p.EditPos = p.EditPos - 1
    p.EditError = ""
END SUB

' EditDelete deletes the character AT the caret (forward delete, Del key).
SUB (p AS POINTER TO PropertiesPanel) EditDelete()
    IF NOT p.EditMode THEN RETURN
    IF p.EditPos >= LEN(p.EditBuffer) THEN RETURN
    DIM before AS STRING = Mid(p.EditBuffer, 1, p.EditPos)
    DIM after AS STRING = ""
    IF p.EditPos + 1 < LEN(p.EditBuffer) THEN
        after = Mid(p.EditBuffer, p.EditPos + 2, LEN(p.EditBuffer) - p.EditPos - 1)
    END IF
    p.EditBuffer = before + after
    p.EditError = ""
END SUB

' EditCursorLeft / EditCursorRight move the caret one position.
SUB (p AS POINTER TO PropertiesPanel) EditCursorLeft()
    IF NOT p.EditMode THEN RETURN
    IF p.EditPos > 0 THEN p.EditPos = p.EditPos - 1
    p.EditError = ""
END SUB

SUB (p AS POINTER TO PropertiesPanel) EditCursorRight()
    IF NOT p.EditMode THEN RETURN
    IF p.EditPos < LEN(p.EditBuffer) THEN p.EditPos = p.EditPos + 1
    p.EditError = ""
END SUB

' EditCursorHome / EditCursorEnd jump the caret.
SUB (p AS POINTER TO PropertiesPanel) EditCursorHome()
    IF NOT p.EditMode THEN RETURN
    p.EditPos = 0
    p.EditError = ""
END SUB

SUB (p AS POINTER TO PropertiesPanel) EditCursorEnd()
    IF NOT p.EditMode THEN RETURN
    p.EditPos = LEN(p.EditBuffer)
    p.EditError = ""
END SUB

' editIsWordChar — alnum or underscore is "word", everything else is
' a boundary (matches the readline default).
FUNCTION editIsWordChar(c AS STRING) AS BOOLEAN
    IF LEN(c) = 0 THEN RETURN FALSE
    IF c >= "0" AND c <= "9" THEN RETURN TRUE
    IF c >= "A" AND c <= "Z" THEN RETURN TRUE
    IF c >= "a" AND c <= "z" THEN RETURN TRUE
    IF c = "_" THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' EditCursorWordLeft skips back over a run of non-word chars (if any)
' then over a run of word chars — readline / Ctrl+← behaviour.
SUB (p AS POINTER TO PropertiesPanel) EditCursorWordLeft()
    IF NOT p.EditMode THEN RETURN
    p.EditError = ""
    DO WHILE p.EditPos > 0
        DIM ch AS STRING = Mid(p.EditBuffer, p.EditPos, 1)
        IF editIsWordChar(ch) THEN EXIT DO
        p.EditPos = p.EditPos - 1
    LOOP
    DO WHILE p.EditPos > 0
        DIM ch2 AS STRING = Mid(p.EditBuffer, p.EditPos, 1)
        IF NOT editIsWordChar(ch2) THEN EXIT DO
        p.EditPos = p.EditPos - 1
    LOOP
END SUB

' EditCursorWordRight skips forward over a run of word chars then a
' run of non-word chars.
SUB (p AS POINTER TO PropertiesPanel) EditCursorWordRight()
    IF NOT p.EditMode THEN RETURN
    p.EditError = ""
    DO WHILE p.EditPos < LEN(p.EditBuffer)
        DIM ch AS STRING = Mid(p.EditBuffer, p.EditPos + 1, 1)
        IF NOT editIsWordChar(ch) THEN EXIT DO
        p.EditPos = p.EditPos + 1
    LOOP
    DO WHILE p.EditPos < LEN(p.EditBuffer)
        DIM ch2 AS STRING = Mid(p.EditBuffer, p.EditPos + 1, 1)
        IF editIsWordChar(ch2) THEN EXIT DO
        p.EditPos = p.EditPos + 1
    LOOP
END SUB

' EditKillToEnd drops everything from the caret onward (Ctrl+K).
SUB (p AS POINTER TO PropertiesPanel) EditKillToEnd()
    IF NOT p.EditMode THEN RETURN
    p.EditBuffer = Mid(p.EditBuffer, 1, p.EditPos)
    p.EditError = ""
END SUB

' EditKillToStart drops everything before the caret (Ctrl+U).
SUB (p AS POINTER TO PropertiesPanel) EditKillToStart()
    IF NOT p.EditMode THEN RETURN
    IF p.EditPos = 0 THEN RETURN
    IF p.EditPos < LEN(p.EditBuffer) THEN
        p.EditBuffer = Mid(p.EditBuffer, p.EditPos + 1, LEN(p.EditBuffer) - p.EditPos)
    ELSE
        p.EditBuffer = ""
    END IF
    p.EditPos = 0
    p.EditError = ""
END SUB

' EditKillWordLeft deletes the previous word (Ctrl+W) — mirrors
' EditCursorWordLeft but removes the skipped chars.
SUB (p AS POINTER TO PropertiesPanel) EditKillWordLeft()
    IF NOT p.EditMode THEN RETURN
    DIM startPos AS INTEGER = p.EditPos
    DO WHILE p.EditPos > 0
        DIM ch AS STRING = Mid(p.EditBuffer, p.EditPos, 1)
        IF editIsWordChar(ch) THEN EXIT DO
        p.EditPos = p.EditPos - 1
    LOOP
    DO WHILE p.EditPos > 0
        DIM ch2 AS STRING = Mid(p.EditBuffer, p.EditPos, 1)
        IF NOT editIsWordChar(ch2) THEN EXIT DO
        p.EditPos = p.EditPos - 1
    LOOP
    DIM before AS STRING = Mid(p.EditBuffer, 1, p.EditPos)
    DIM after AS STRING = ""
    IF startPos < LEN(p.EditBuffer) THEN
        after = Mid(p.EditBuffer, startPos + 1, LEN(p.EditBuffer) - startPos)
    END IF
    p.EditBuffer = before + after
    p.EditError = ""
END SUB

' CommitEdit returns (name, buffer, ok). The caller passes buffer to
' the appropriate Set*Property setter; on setter error, the caller
' assigns the error to p.EditError and leaves EditMode = TRUE. On
' success the caller calls FinishEdit() to leave edit mode.
FUNCTION (p AS POINTER TO PropertiesPanel) CommitEdit() AS (STRING, STRING, BOOLEAN)
    IF NOT p.EditMode THEN RETURN "", "", FALSE
    IF p.Cursor < 0 OR p.Cursor >= LEN(p.Rows) THEN RETURN "", "", FALSE
    DIM r AS PropRow = p.Rows[p.Cursor]
    IF NOT r.Editable THEN RETURN "", "", FALSE
    RETURN r.Name, p.EditBuffer, TRUE
END FUNCTION

' FinishEdit leaves edit mode after a successful commit.
SUB (p AS POINTER TO PropertiesPanel) FinishEdit()
    p.EditMode = FALSE
    p.EditBuffer = ""
    p.EditPos = 0
    p.EditError = ""
END SUB

' SetEditError stores a commit error for display. Does NOT leave edit
' mode — the user can fix the value and try again, or Esc to cancel.
SUB (p AS POINTER TO PropertiesPanel) SetEditError(msg AS STRING)
    p.EditError = msg
END SUB

' CancelEdit drops the edit buffer and exits edit mode unchanged.
SUB (p AS POINTER TO PropertiesPanel) CancelEdit()
    p.EditMode = FALSE
    p.EditBuffer = ""
    p.EditPos = 0
    p.EditError = ""
END SUB

' RefreshFromWidget is like SetWidget but preserves Cursor and Offset.
' Used after applying a property change so the user stays on the row
' they just edited.
SUB (p AS POINTER TO PropertiesPanel) RefreshFromWidget(w AS Widget)
    DIM savedCursor AS INTEGER = p.Cursor
    DIM savedOffset AS INTEGER = p.Offset
    p.CurWidget = w
    p.HasWidget = TRUE
    p.ShowForm = FALSE
    p.rebuildRows()
    IF savedCursor >= LEN(p.Rows) THEN savedCursor = LEN(p.Rows) - 1
    IF savedCursor < 0 THEN savedCursor = 0
    p.Cursor = savedCursor
    p.Offset = savedOffset
    p.ensureVisible()
END SUB

' ----------------------------------------------------------------------
' Mouse — ClickAt translates a panel-local (lx, ly) click into a row
' interaction. The returned ClickAction tells the caller what happened
' so it can do the cross-panel work (apply prop edit + refresh, switch
' to ModePropEdit, etc.). Pure local effect: cursor positioning and
' (in edit mode) caret positioning.
' ----------------------------------------------------------------------

' PropClickResult — values describe what the click triggered.
CONST PropClickNone     AS INTEGER = 0
CONST PropClickCursor   AS INTEGER = 1   ' just moved the cursor
CONST PropClickToggle   AS INTEGER = 2   ' bool toggle requested
CONST PropClickEnumPrev AS INTEGER = 3   ' enum ◂ requested
CONST PropClickEnumNext AS INTEGER = 4   ' enum ▸ requested
CONST PropClickBeginEdit AS INTEGER = 5  ' wants to enter edit mode
CONST PropClickReadOnly AS INTEGER = 6   ' clicked a read-only row
CONST PropClickCaret    AS INTEGER = 7   ' moved EditPos in edit mode

' ClickAt — single-click handler. Returns the action the caller should
' apply. The panel does cursor + caret positioning itself; the caller
' applies bool/enum/edit-mode transitions because those need access
' to the model's data sources.
FUNCTION (p AS POINTER TO PropertiesPanel) ClickAt(lx AS INTEGER, ly AS INTEGER) AS INTEGER
    IF ly < 1 OR ly > p.Height - 2 THEN RETURN PropClickNone
    DIM rowIdx AS INTEGER = p.Offset + (ly - 1)
    IF rowIdx < 0 OR rowIdx >= LEN(p.Rows) THEN RETURN PropClickNone
    DIM r AS PropRow = p.Rows[rowIdx]
    IF r.Category <> "" THEN RETURN PropClickNone

    ' If already editing this very row, the click positions the edit
    ' caret instead of triggering another action.
    IF p.EditMode AND rowIdx = p.Cursor THEN
        ' Value cell starts after the name column + 1-char separator.
        DIM innerW AS INTEGER = p.Width - 2
        DIM nameW AS INTEGER = innerW / 2
        IF nameW < 6 THEN nameW = 6
        DIM valStartX AS INTEGER = 1 + nameW + 1
        DIM caretPos AS INTEGER = lx - valStartX
        IF caretPos < 0 THEN caretPos = 0
        IF caretPos > LEN(p.EditBuffer) THEN caretPos = LEN(p.EditBuffer)
        p.EditPos = caretPos
        p.EditError = ""
        RETURN PropClickCaret
    END IF

    ' Otherwise: move the cursor first, then decide if the click hit a
    ' bool/enum/value region.
    p.Cursor = rowIdx
    p.ensureVisible()

    IF NOT r.Editable THEN RETURN PropClickReadOnly

    ' Cell-region heuristics. The value cell starts after nameW+1; if
    ' the click is on the name side, that's just cursor positioning.
    DIM innerW2 AS INTEGER = p.Width - 2
    DIM nameW2 AS INTEGER = innerW2 / 2
    IF nameW2 < 6 THEN nameW2 = 6
    DIM valStartX2 AS INTEGER = 1 + nameW2 + 1
    IF lx < valStartX2 THEN RETURN PropClickCursor

    IF r.IsBool THEN RETURN PropClickToggle
    IF LEN(r.Options) > 0 THEN
        ' The displayed value looks like "◂ value ▸". Anything before
        ' a few chars from valStartX = prev arrow, anything within the
        ' last ~2 chars of the value cell = next arrow, middle = cycle
        ' next (right-click would have been prev — keep simple).
        DIM valEndX AS INTEGER = p.Width - 2
        DIM dxFromEnd AS INTEGER = valEndX - lx
        IF lx <= valStartX2 + 1 THEN RETURN PropClickEnumPrev
        IF dxFromEnd <= 1 THEN RETURN PropClickEnumNext
        RETURN PropClickEnumNext
    END IF

    RETURN PropClickBeginEdit
END FUNCTION

SUB (p AS POINTER TO PropertiesPanel) WheelUp()
    IF p.Cursor > 0 THEN
        p.Cursor = p.Cursor - 1
        p.ensureVisible()
    END IF
END SUB

SUB (p AS POINTER TO PropertiesPanel) WheelDown()
    IF p.Cursor < LEN(p.Rows) - 1 THEN
        p.Cursor = p.Cursor + 1
        p.ensureVisible()
    END IF
END SUB

' RefreshFromForm — same idea for form rows.
SUB (p AS POINTER TO PropertiesPanel) RefreshFromForm(f AS Form)
    DIM savedCursor AS INTEGER = p.Cursor
    DIM savedOffset AS INTEGER = p.Offset
    p.CurForm = f
    p.ShowForm = TRUE
    p.HasWidget = FALSE
    p.HasTool = FALSE
    p.rebuildRows()
    IF savedCursor >= LEN(p.Rows) THEN savedCursor = LEN(p.Rows) - 1
    IF savedCursor < 0 THEN savedCursor = 0
    p.Cursor = savedCursor
    p.Offset = savedOffset
    p.ensureVisible()
END SUB

' RefreshFromTool — same idea for tool rows.
SUB (p AS POINTER TO PropertiesPanel) RefreshFromTool(t AS ToolEntry)
    DIM savedCursor AS INTEGER = p.Cursor
    DIM savedOffset AS INTEGER = p.Offset
    p.CurTool = t
    p.HasTool = TRUE
    p.HasWidget = FALSE
    p.ShowForm = FALSE
    p.rebuildRows()
    IF savedCursor >= LEN(p.Rows) THEN savedCursor = LEN(p.Rows) - 1
    IF savedCursor < 0 THEN savedCursor = 0
    p.Cursor = savedCursor
    p.Offset = savedOffset
    p.ensureVisible()
END SUB

' ----------------------------------------------------------------------
' Render
' ----------------------------------------------------------------------

FUNCTION (p AS PropertiesPanel) Render() AS STRING
    IF p.Width < 4 OR p.Height < 3 THEN RETURN ""

    DIM innerW AS INTEGER = p.Width - 2
    DIM innerH AS INTEGER = p.InnerHeight()

    ' Borders — single unfocused, double when focused.
    DIM bc AS borderChars = singleBorder()
    DIM borderColor AS color.Color = ColorBorder()
    IF p.Focused THEN
        bc = doubleBorder()
        borderColor = ColorFocusBorder()
    END IF
    DIM bStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(borderColor).Background(ColorBg())

    ' Scrollbar — reserve the rightmost inner column when rows overflow.
    DIM canScroll AS BOOLEAN = (LEN(p.Rows) > innerH)
    DIM thumbPos AS INTEGER = -1
    IF canScroll AND innerH > 0 THEN
        DIM maxOff AS INTEGER = LEN(p.Rows) - innerH
        IF maxOff > 0 THEN thumbPos = p.Offset * (innerH - 1) / maxOff
    END IF
    DIM contentW AS INTEGER = innerW
    IF canScroll THEN contentW = innerW - 1
    DIM scrollTrack AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorBorder()).Background(ColorBg())
    DIM scrollThumb AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorBg())

    DIM nameW AS INTEGER = contentW / 2
    IF nameW < 6 THEN nameW = 6
    DIM valW AS INTEGER = contentW - nameW - 1   ' 1 for the centre separator
    IF valW < 1 THEN valW = 1

    DIM nameStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorBg())
    DIM valStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorBg())
    DIM catStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorHotkey()).Background(ColorBg()).Bold(TRUE)
    DIM catLineStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorBorder()).Background(ColorBg())
    DIM selNameStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorSelection()).Bold(TRUE)
    DIM selValStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorSelection())
    DIM sepStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorBorder()).Background(ColorBg())

    ' Top + bottom borders. Title centred on top.
    DIM title AS STRING = "Properties"
    DIM titlePadded AS STRING = " " + title + " "
    DIM titleVisW AS INTEGER = lipgloss.Width(titlePadded)
    DIM topBar AS STRING = strings.Repeat(bc.Horizontal, innerW)
    IF titleVisW + 2 < innerW THEN
        DIM titleStr AS STRING = TitleStyle().Render(titlePadded)
        DIM fillLen AS INTEGER = innerW - titleVisW - 1
        IF fillLen < 0 THEN fillLen = 0
        topBar = bc.Horizontal + titleStr + bStyle.Render(strings.Repeat(bc.Horizontal, fillLen))
    ELSE
        topBar = bStyle.Render(topBar)
    END IF
    DIM topLine AS STRING = bStyle.Render(bc.TopLeft) + topBar + bStyle.Render(bc.TopRight)
    DIM bottomLine AS STRING = bStyle.Render(bc.BottomLeft + strings.Repeat(bc.Horizontal, innerW) + bc.BottomRight)

    ' Body rows.
    DIM rows AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO innerH - 1
        DIM rowIdx AS INTEGER = p.Offset + i
        DIM scrollChar AS STRING = ""
        IF canScroll THEN
            IF i = thumbPos THEN
                scrollChar = scrollThumb.Render("┃")
            ELSE
                scrollChar = scrollTrack.Render("╎")
            END IF
        END IF
        IF rowIdx >= LEN(p.Rows) THEN
            rows = APPEND(rows, bStyle.Render(bc.Vertical) + valStyle.Render(strings.Repeat(" ", contentW)) + scrollChar + bStyle.Render(bc.Vertical))
        ELSE
            DIM row AS PropRow = p.Rows[rowIdx]
            DIM isCursor AS BOOLEAN = (rowIdx = p.Cursor)
            DIM body AS STRING

            IF row.Category <> "" THEN
                DIM catText AS STRING = row.Category
                DIM textLen AS INTEGER = lipgloss.Width(catText)
                IF textLen > contentW THEN
                    catText = Mid(catText, 1, contentW)
                    textLen = contentW
                END IF
                DIM catFillLen AS INTEGER = contentW - textLen
                IF catFillLen < 0 THEN catFillLen = 0
                body = catStyle.Render(catText) + catLineStyle.Render(strings.Repeat("─", catFillLen))
            ELSE
                DIM nameText AS STRING = row.Name
                IF LEN(nameText) > nameW THEN nameText = Mid(nameText, 1, nameW)
                DIM namePad AS INTEGER = nameW - LEN(nameText)
                IF namePad < 0 THEN namePad = 0

                DIM editing AS BOOLEAN = isCursor AND p.EditMode AND row.Editable AND NOT row.IsBool AND LEN(row.Options) = 0
                DIM displayVal AS STRING = row.Value
                DIM swatch AS STRING = ""
                DIM displayVisW AS INTEGER
                IF editing THEN
                    ' Place the block caret AT EditPos by splitting the
                    ' buffer in two. Past the end of buffer, append it.
                    DIM caret AS STRING = "▎"
                    DIM editPre AS STRING = ""
                    DIM editPost AS STRING = ""
                    IF p.EditPos > 0 THEN editPre = Mid(p.EditBuffer, 1, p.EditPos)
                    IF p.EditPos < LEN(p.EditBuffer) THEN
                        editPost = Mid(p.EditBuffer, p.EditPos + 1, LEN(p.EditBuffer) - p.EditPos)
                    END IF
                    DIM errSuffix AS STRING = ""
                    IF p.EditError <> "" THEN errSuffix = " ⚠"
                    displayVal = editPre + caret + editPost + errSuffix
                    displayVisW = lipgloss.Width(displayVal)
                ELSEIF row.IsBool THEN
                    IF row.Value = "true" THEN
                        displayVal = "[x] true"
                    ELSE
                        displayVal = "[ ] false"
                    END IF
                    displayVisW = lipgloss.Width(displayVal)
                ELSEIF row.IsColor AND row.Value <> "" THEN
                    swatch = lipgloss.NewStyle().Background(lipgloss.Color(row.Value)).Render("  ")
                    displayVal = swatch + " " + row.Value
                    displayVisW = 3 + lipgloss.Width(row.Value)
                ELSEIF LEN(row.Options) > 0 THEN
                    displayVal = "◂ " + row.Value + " ▸"
                    displayVisW = lipgloss.Width(displayVal)
                ELSE
                    displayVisW = lipgloss.Width(displayVal)
                END IF

                IF displayVisW > valW AND NOT row.IsColor THEN
                    DO WHILE displayVisW > valW AND LEN(displayVal) > 0
                        displayVal = Mid(displayVal, 1, LEN(displayVal) - 1)
                        displayVisW = lipgloss.Width(displayVal)
                    LOOP
                END IF
                DIM valPad AS INTEGER = valW - displayVisW
                IF valPad < 0 THEN valPad = 0

                DIM sep AS STRING = sepStyle.Render("│")
                IF isCursor THEN
                    DIM nPart AS STRING = selNameStyle.Render(nameText + strings.Repeat(" ", namePad))
                    IF row.IsColor THEN
                        body = nPart + sep + displayVal + selValStyle.Render(strings.Repeat(" ", valPad))
                    ELSE
                        body = nPart + sep + selValStyle.Render(displayVal + strings.Repeat(" ", valPad))
                    END IF
                ELSE
                    DIM nPart2 AS STRING = nameStyle.Render(nameText + strings.Repeat(" ", namePad))
                    IF row.IsColor THEN
                        body = nPart2 + sep + displayVal + valStyle.Render(strings.Repeat(" ", valPad))
                    ELSE
                        body = nPart2 + sep + valStyle.Render(displayVal + strings.Repeat(" ", valPad))
                    END IF
                END IF
            END IF

            rows = APPEND(rows, bStyle.Render(bc.Vertical) + body + scrollChar + bStyle.Render(bc.Vertical))
        END IF
    NEXT i

    DIM all AS []STRING
    all = APPEND(all, topLine)
    DIM r AS INTEGER
    FOR r = 0 TO LEN(rows) - 1
        all = APPEND(all, rows[r])
    NEXT r
    all = APPEND(all, bottomLine)
    RETURN strings.Join(all, "\n")
END FUNCTION
