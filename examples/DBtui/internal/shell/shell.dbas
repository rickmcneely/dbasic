' DBtui — internal/shell/shell.dbas
'
' PTY-backed shell with proper VT100 emulation. Spawns $SHELL
' (defaulting to /bin/bash) inside a pseudo-terminal via
' github.com/creack/pty; a background goroutine reads PTY output and
' feeds it to a github.com/hinshun/vt10x Terminal instance which
' maintains a virtual cell grid. Render fetches the grid as a string.
'
' This handles cursor positioning, screen clears, scroll regions, etc.
' Programs like vim, less, htop, top should render correctly.
'
' Keystrokes while the Shell tab is focused get translated to wire
' bytes and written to the PTY master.

IMPORT "charm.land/lipgloss/v2" AS lipgloss
IMPORT "fmt"
IMPORT "os"
IMPORT "os/exec" AS osexec
IMPORT "strings"
IMPORT "github.com/creack/pty"
IMPORT "github.com/hinshun/vt10x"

' Package-level state.
DIM gShellActive AS BOOLEAN
DIM gShellPtmx   AS POINTER TO os.File
DIM gShellCmd    AS POINTER TO osexec.Cmd
DIM gShellVT     AS vt10x.Terminal     ' the virtual terminal emulator
DIM gShellCols   AS INTEGER
DIM gShellRows   AS INTEGER

' ShellIsActive — has the PTY been spawned?
FUNCTION ShellIsActive() AS BOOLEAN
    RETURN gShellActive
END FUNCTION

' PtyShellStart spawns $SHELL inside a PTY, kicks off the reader
' goroutine, and creates the vt10x emulator at the given size. Pass
' the actual panel dimensions if known so bash spawns at the right
' size from the start (avoiding the 80x24→real-size SIGWINCH hiccup).
' Pass 0,0 to use the 80x24 default.
FUNCTION PtyShellStart(cols AS INTEGER, rows AS INTEGER) AS ERROR
    IF gShellActive THEN RETURN NIL
    IF cols < 1 THEN cols = 80
    IF rows < 1 THEN rows = 24
    DIM shellPath AS STRING = os.Getenv("SHELL")
    IF shellPath = "" THEN shellPath = "/bin/bash"
    gShellCmd = osexec.Command(shellPath)
    DIM ptmx AS POINTER TO os.File
    DIM err AS ERROR
    ptmx, err = pty.Start(gShellCmd)
    IF err <> NIL THEN RETURN err
    gShellPtmx = ptmx
    gShellCols = cols
    gShellRows = rows
    gShellVT = vt10x.New(vt10x.WithSize(cols, rows))
    ' Also tell the PTY the real size up front so bash's PS1 prompt
    ' and any rc-file initialization sees the correct COLUMNS/LINES.
    DIM ws AS pty.Winsize
    ws.Rows = Uint16(rows)
    ws.Cols = Uint16(cols)
    DIM serr AS ERROR = pty.Setsize(gShellPtmx, @ws)
    _ = serr
    gShellActive = TRUE
    SPAWN shellReader()
    RETURN NIL
END FUNCTION

' shellReader runs in a goroutine, blocks on PTY Read, writes chunks
' to the vt10x parser. Exits when the PTY closes.
SUB shellReader()
    DIM buf AS BYTES = MakeBytes(4096)
    DO WHILE TRUE
        DIM n AS INTEGER
        DIM err AS ERROR
        n, err = gShellPtmx.Read(buf)
        IF err <> NIL THEN
            gShellActive = FALSE
            RETURN
        END IF
        IF n > 0 THEN
            DIM nw AS INTEGER
            DIM werr AS ERROR
            nw, werr = gShellVT.Write(buf[0:n])
            _ = nw
            _ = werr
        END IF
    LOOP
END SUB

' ShellResize resizes both the vt10x virtual terminal AND the PTY so
' child programs get a SIGWINCH and adapt their layout. Uses the new
' Uint16 cast to pack the dimensions into pty.Winsize.
SUB ShellResize(cols AS INTEGER, rows AS INTEGER)
    IF NOT gShellActive THEN RETURN
    IF cols < 1 THEN cols = 1
    IF rows < 1 THEN rows = 1
    IF cols = gShellCols AND rows = gShellRows THEN RETURN
    gShellCols = cols
    gShellRows = rows
    gShellVT.Resize(cols, rows)
    DIM ws AS pty.Winsize
    ws.Rows = Uint16(rows)
    ws.Cols = Uint16(cols)
    DIM serr AS ERROR = pty.Setsize(gShellPtmx, @ws)
    _ = serr
END SUB

' ansiColor formats a vt10x.Color as the numeric string lipgloss
' accepts ("0"..."15" for ANSI, "16"..."255" for xterm-256). Returns
' "" for the sentinel default colors (caller leaves fg/bg unset so
' the panel background shows through).
FUNCTION ansiColor(c AS vt10x.Color) AS STRING
    IF c = vt10x.DefaultFG THEN RETURN ""
    IF c = vt10x.DefaultBG THEN RETURN ""
    DIM n AS INTEGER = Int(c)
    IF n < 0 OR n > 255 THEN RETURN ""
    RETURN fmt.Sprintf("%d", n)
END FUNCTION

' styleFor returns a lipgloss.Style configured for the glyph's fg/bg.
' Default fg/bg are left unset so DBtui's panel bg shows through.
' (Bold / italic / underline are skipped for now — DBasic has no
' bitwise AND operator, so we can't mask vt10x's Mode field cleanly.
' Adding a BitAnd builtin would fix it; v1 ships colors only.)
FUNCTION styleFor(g AS vt10x.Glyph) AS lipgloss.Style
    DIM s AS lipgloss.Style = lipgloss.NewStyle()
    DIM fg AS STRING = ansiColor(g.FG)
    DIM bg AS STRING = ansiColor(g.BG)
    IF fg <> "" THEN s = s.Foreground(lipgloss.Color(fg))
    IF bg <> "" THEN s = s.Background(lipgloss.Color(bg))
    RETURN s
END FUNCTION

' glyphSameStyle returns TRUE if two glyphs share the styling
' attributes that matter for run-batching (fg, bg).
FUNCTION glyphSameStyle(a AS vt10x.Glyph, b AS vt10x.Glyph) AS BOOLEAN
    IF a.FG <> b.FG THEN RETURN FALSE
    IF a.BG <> b.BG THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' ShellRender walks the virtual terminal's cell grid, batches
' adjacent same-style cells into runs, and renders each run through
' lipgloss so the visible output preserves the shell's colors and
' bold attributes. Resizes the vt + PTY to match the visible size
' before rendering.
FUNCTION ShellRender(cols AS INTEGER, rows AS INTEGER) AS STRING
    IF NOT gShellActive THEN RETURN ""
    ShellResize(cols, rows)
    DIM linesOut AS []STRING
    DIM y AS INTEGER
    FOR y = 0 TO rows - 1
        DIM runBuf AS STRING = ""
        DIM rendered AS STRING = ""
        DIM curG AS vt10x.Glyph = gShellVT.Cell(0, y)
        DIM x AS INTEGER
        FOR x = 0 TO cols - 1
            DIM g AS vt10x.Glyph = gShellVT.Cell(x, y)
            ' Null/zero rune → render as space so empty cells don't collapse.
            DIM ch AS STRING = string(g.Char)
            IF Int(g.Char) = 0 THEN ch = " "
            IF x > 0 AND NOT glyphSameStyle(g, curG) THEN
                rendered = rendered + styleFor(curG).Render(runBuf)
                runBuf = ""
                curG = g
            END IF
            runBuf = runBuf + ch
        NEXT x
        IF runBuf <> "" THEN rendered = rendered + styleFor(curG).Render(runBuf)
        linesOut = APPEND(linesOut, rendered)
    NEXT y
    RETURN strings.Join(linesOut, "\n")
END FUNCTION

' ShellDrain is a no-op kept as a stable API — vt10x writes happen
' inside the reader goroutine directly into the virtual terminal,
' so there's no intermediate buffer to drain. We always return TRUE
' so the tea.Tick loop triggers a re-render every tick (cheap; the
' actual screen only repaints when the model changes).
FUNCTION ShellDrain() AS BOOLEAN
    RETURN gShellActive
END FUNCTION

' ShellWriteKey translates a bubbletea key string into wire bytes and
' writes them to the PTY master.
SUB ShellWriteKey(k AS STRING)
    IF NOT gShellActive THEN RETURN
    IF gShellPtmx = NIL THEN RETURN
    DIM s AS STRING = ""
    IF k = "enter" THEN
        s = Chr(13)
    ELSEIF k = "tab" THEN
        s = Chr(9)
    ELSEIF k = "esc" OR k = "escape" THEN
        s = Chr(27)
    ELSEIF k = "backspace" THEN
        s = Chr(127)
    ELSEIF k = "space" THEN
        s = " "
    ELSEIF k = "up" THEN
        s = Chr(27) + "[A"
    ELSEIF k = "down" THEN
        s = Chr(27) + "[B"
    ELSEIF k = "right" THEN
        s = Chr(27) + "[C"
    ELSEIF k = "left" THEN
        s = Chr(27) + "[D"
    ELSEIF k = "home" THEN
        s = Chr(27) + "[H"
    ELSEIF k = "end" THEN
        s = Chr(27) + "[F"
    ELSEIF k = "delete" THEN
        s = Chr(27) + "[3~"
    ELSEIF k = "pgup" THEN
        s = Chr(27) + "[5~"
    ELSEIF k = "pgdown" THEN
        s = Chr(27) + "[6~"
    ELSEIF LEN(k) = 1 THEN
        s = k
    END IF
    IF s = "" THEN RETURN
    DIM b AS BYTES = Encode(s)
    DIM nw AS INTEGER
    DIM werr AS ERROR
    nw, werr = gShellPtmx.Write(b)
    _ = nw
    _ = werr
END SUB

' ShellStop terminates the shell and releases the PTY. Idempotent.
SUB ShellStop()
    IF NOT gShellActive THEN RETURN
    gShellActive = FALSE
    IF gShellPtmx <> NIL THEN gShellPtmx.Close()
    IF gShellCmd <> NIL AND gShellCmd.Process <> NIL THEN gShellCmd.Process.Kill()
    gShellPtmx = NIL
END SUB

' Kept for API compatibility — splits the rendered screen on newlines.
FUNCTION ShellBuffer() AS []STRING
    IF NOT gShellActive THEN
        DIM empty AS []STRING
        RETURN empty
    END IF
    DIM s AS STRING = gShellVT.String()
    RETURN strings.Split(s, "\n")
END FUNCTION
