' =========================================================================
' Form designer — visual canvas + palette + hit-test + drag.
'
' v1 scope:
'   - Single in-memory Form on Model.
'   - Four widget kinds: Button / Label / TextInput / Checkbox.
'   - Click palette item → append widget at canvas (2, 1).
'   - Click widget on canvas → select.
'   - Drag selected widget → move (DragMode = "formMove").
'   - Selected widget highlighted; properties shown in right pane.
'
' Persistence + codegen come in a follow-up.
' =========================================================================

CONST formPaletteKinds AS INTEGER = 18  ' Button, Label, TextInput, Checkbox,
                                        ' RadioButton, ComboBox, ListBox,
                                        ' ProgressBar, ScrollBar, Dialog,
                                        ' TabStrip, Tree, TextArea, PropGrid,
                                        ' ScrollPanel, Menubar, StatusBar,
                                        ' Panel

' formKindByIdx — fixed list of widget kinds in palette display order.
' The order is the order entries appear in the right-pane Widgets
' panel; index 0 = top of the palette.
FUNCTION formKindByIdx(i AS INTEGER) AS STRING
    IF i = 0 THEN RETURN "Button"
    IF i = 1 THEN RETURN "Label"
    IF i = 2 THEN RETURN "TextInput"
    IF i = 3 THEN RETURN "Checkbox"
    IF i = 4 THEN RETURN "RadioButton"
    IF i = 5 THEN RETURN "ComboBox"
    IF i = 6 THEN RETURN "ListBox"
    IF i = 7 THEN RETURN "ProgressBar"
    IF i = 8 THEN RETURN "ScrollBar"
    IF i = 9 THEN RETURN "Dialog"
    IF i = 10 THEN RETURN "TabStrip"
    IF i = 11 THEN RETURN "Tree"
    IF i = 12 THEN RETURN "TextArea"
    IF i = 13 THEN RETURN "PropGrid"
    IF i = 14 THEN RETURN "ScrollPanel"
    IF i = 15 THEN RETURN "Menubar"
    IF i = 16 THEN RETURN "StatusBar"
    IF i = 17 THEN RETURN "Panel"
    RETURN ""
END FUNCTION

' defaultWidget — produce a widget of the given kind with sensible
' default text / size / state; caller picks Name + (X, Y).
FUNCTION defaultWidget(kind AS STRING) AS DesignWidget
    DIM w AS DesignWidget
    w.Kind = kind
    w.W = 12
    w.H = 1
    IF kind = "Button" THEN
        RETURN buttonDefault(w)
    ELSEIF kind = "Label" THEN
        RETURN labelDefault(w)
    ELSEIF kind = "TextInput" THEN
        RETURN textInputDefault(w)
    ELSEIF kind = "Checkbox" THEN
        RETURN checkboxDefault(w)
    ELSEIF kind = "RadioButton" THEN
        RETURN radioButtonDefault(w)
    ELSEIF kind = "ComboBox" THEN
        RETURN comboBoxDefault(w)
    ELSEIF kind = "ListBox" THEN
        RETURN listBoxDefault(w)
    ELSEIF kind = "ProgressBar" THEN
        RETURN progressBarDefault(w)
    ELSEIF kind = "ScrollBar" THEN
        w.Text   = ""
        w.W      = 1
        w.H      = 8
        w.Min    = 0
        w.Max    = 100
        w.Value  = 0
        w.Orient = "v"
    ELSEIF kind = "Dialog" THEN
        ' Non-visual at runtime — the canvas stamp is just a marker.
        ' Default is a confirm dialog with OK/Cancel buttons; user
        ' changes DialogKind, Items, etc. via the Properties panel.
        w.Text       = "Dialog Title"
        w.DialogKind = "confirm"
        w.DialogMsg  = "Are you sure?"
        DIM dbtns AS []STRING
        dbtns = APPEND(dbtns, "OK")
        dbtns = APPEND(dbtns, "Cancel")
        w.Items      = dbtns
        w.W          = 22
        w.H          = 1
    ELSEIF kind = "TabStrip" THEN
        RETURN tabStripDefault(w)
    ELSEIF kind = "Tree" THEN
        ' Hierarchical node list. Depth is encoded by leading dashes in
        ' each Items entry ("-" = one level) so it survives the comma-
        ' separated property editor's TrimSpace. Selected is the cursor;
        ' runtime adds per-node collapse state.
        w.Text = "Tree"
        w.W    = 26
        w.H    = 7
        DIM tnodes AS []STRING
        tnodes = APPEND(tnodes, "Project")
        tnodes = APPEND(tnodes, "-src")
        tnodes = APPEND(tnodes, "--main.dbas")
        tnodes = APPEND(tnodes, "--util.dbas")
        tnodes = APPEND(tnodes, "-docs")
        tnodes = APPEND(tnodes, "--README.md")
        w.Items    = tnodes
        w.Selected = 0
    ELSEIF kind = "TextArea" THEN
        ' Multi-line edit box. Text is the initial content (may contain
        ' newlines); runtime tracks the live value in <Name>_Val.
        w.Text = "Edit me..."
        w.W    = 28
        w.H    = 6
    ELSEIF kind = "PropGrid" THEN
        ' Two-column key/value grid. Each Items entry is "key=value";
        ' Selected is the cursor row. Runtime tracks the cursor in
        ' <Name>_Val.
        w.Text = "PropGrid"
        w.W    = 30
        w.H    = 5
        DIM gprops AS []STRING
        gprops = APPEND(gprops, "Name=Widget1")
        gprops = APPEND(gprops, "Width=100")
        gprops = APPEND(gprops, "Height=40")
        gprops = APPEND(gprops, "Visible=true")
        w.Items    = gprops
        w.Selected = 0
    ELSEIF kind = "ScrollPanel" THEN
        ' Scrollable content viewport with an embedded vertical
        ' scrollbar. Items are the content lines; runtime tracks the
        ' top visible line in <Name>_Scroll. Passive (no _Change).
        w.Text = "ScrollPanel"
        w.W    = 28
        w.H    = 8
        DIM splines AS []STRING
        DIM spk AS INTEGER
        FOR spk = 1 TO 12
            splines = APPEND(splines, "Content line " + strconv.Itoa(spk))
        NEXT spk
        w.Items = splines
    ELSEIF kind = "Menubar" THEN
        ' Top menu strip. Items are dash-depth encoded (like Tree): a
        ' depth-0 entry is a menu title, each following depth-1 ("-")
        ' entry is an item under it. Runtime tracks the active menu /
        ' open state / highlighted item; selecting fires <Name>_Select.
        w.Text = "Menubar"
        w.W    = 44
        w.H    = 1
        DIM mbentries AS []STRING
        mbentries = APPEND(mbentries, "File")
        mbentries = APPEND(mbentries, "-New")
        mbentries = APPEND(mbentries, "-Open")
        mbentries = APPEND(mbentries, "-Quit")
        mbentries = APPEND(mbentries, "Edit")
        mbentries = APPEND(mbentries, "-Cut")
        mbentries = APPEND(mbentries, "-Copy")
        mbentries = APPEND(mbentries, "-Paste")
        mbentries = APPEND(mbentries, "Help")
        mbentries = APPEND(mbentries, "-About")
        w.Items = mbentries
    ELSEIF kind = "StatusBar" THEN
        ' Bottom status strip. Items are segments shown across the bar
        ' (joined by │). Runtime <Name>_Text, when non-empty, overrides
        ' the segments. Passive (no events).
        w.Text = "StatusBar"
        w.W    = 44
        w.H    = 1
        DIM sbsegs AS []STRING
        sbsegs = APPEND(sbsegs, "Ready")
        sbsegs = APPEND(sbsegs, "Ln 1, Col 1")
        sbsegs = APPEND(sbsegs, "UTF-8")
        w.Items = sbsegs
    ELSEIF kind = "Panel" THEN
        ' Scrollable container. Holds child widgets (those whose Parent
        ' names this Panel); runtime scrolls them in <Name>_Scroll.
        w.Text = "Panel"
        w.W    = 30
        w.H    = 10
    END IF
    RETURN w
END FUNCTION

' formAddWidget — append a new widget of `kind` to the form, auto-name
' it, position at (2, 1). Selects the new widget.
SUB formAddWidget(m AS POINTER TO Model, kind AS STRING)
    DIM w AS DesignWidget = defaultWidget(kind)
    ' Auto-name: lower-case kind + index. E.g. "button1".
    DIM prefix AS STRING = strings.ToLower(kind)
    DIM n AS INTEGER = 1
    DO WHILE TRUE
        DIM cand AS STRING = prefix + strconv.Itoa(n)
        DIM clash AS BOOLEAN = FALSE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
            IF m.Tabs[m.TabIdx].Form.Widgets[i].Name = cand THEN clash = TRUE
        NEXT i
        IF NOT clash THEN
            w.Name = cand
            EXIT DO
        END IF
        n = n + 1
    LOOP
    w.X = 2
    w.Y = 1 + LEN(m.Tabs[m.TabIdx].Form.Widgets)
    IF w.Y < 1 THEN w.Y = 1
    m.Tabs[m.TabIdx].Form.Widgets = APPEND(m.Tabs[m.TabIdx].Form.Widgets, w)
    m.Tabs[m.TabIdx].SelWidget = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
    m.Status = "added " + w.Name
END SUB

' formDeleteSelected — drop the currently-selected widget.
SUB formDeleteSelected(m AS POINTER TO Model)
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM kept AS []DesignWidget
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        IF i <> m.Tabs[m.TabIdx].SelWidget THEN kept = APPEND(kept, m.Tabs[m.TabIdx].Form.Widgets[i])
    NEXT i
    m.Tabs[m.TabIdx].Form.Widgets = kept
    m.Tabs[m.TabIdx].SelWidget = 0 - 1
    m.Status = "widget deleted"
END SUB

' tabStripBar — render a TabStrip's tab row: each tab as " label ",
' the active one as "[label]", joined by "│" and padded out to width.
' Shared by the design-time canvas; the generated runtime builds the
' same string inline so the two views match.
FUNCTION tabStripBar(items AS []STRING, active AS INTEGER, width AS INTEGER) AS STRING
    DIM bar AS STRING = ""
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(items) - 1
        IF ti > 0 THEN bar = bar + "│"
        IF ti = active THEN
            bar = bar + "[" + items[ti] + "]"
        ELSE
            bar = bar + " " + items[ti] + " "
        END IF
    NEXT ti
    DIM bw AS INTEGER = lipgloss.Width(bar)
    IF bw < width THEN bar = bar + strings.Repeat(" ", width - bw)
    RETURN bar
END FUNCTION

' treeDepth — count leading '-' characters in a Tree node entry; each
' dash is one level of nesting. treeLabel returns the entry with that
' depth prefix stripped. Shared by the canvas + the codegen so the two
' agree on how a node string decodes.
FUNCTION treeDepth(item AS STRING) AS INTEGER
    DIM d AS INTEGER = 0
    DO WHILE d < LEN(item) AND Mid(item, d + 1, 1) = "-"
        d = d + 1
    LOOP
    RETURN d
END FUNCTION

FUNCTION treeLabel(item AS STRING) AS STRING
    DIM d AS INTEGER = treeDepth(item)
    RETURN Mid(item, d + 1, LEN(item) - d)
END FUNCTION

' statusBarText joins StatusBar segments with │ for display.
' menubarTitles renders a Menubar's depth-0 entries as a " title "
' strip (design-time, no active highlight). Both shared by the canvas.
FUNCTION statusBarText(items AS []STRING) AS STRING
    RETURN strings.Join(items, " │ ")
END FUNCTION

FUNCTION menubarTitles(items AS []STRING) AS STRING
    DIM bar AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN bar = bar + " " + treeLabel(items[i]) + " "
    NEXT i
    RETURN bar
END FUNCTION

' Menubar Items decode (codegen-side). A depth-0 entry is a menu
' title; the depth-1 entries after it are its items.
FUNCTION menubarMenuCount(items AS []STRING) AS INTEGER
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN c = c + 1
    NEXT i
    RETURN c
END FUNCTION

FUNCTION menubarTitleAt(items AS []STRING, k AS INTEGER) AS STRING
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            IF c = k THEN RETURN treeLabel(items[i])
            c = c + 1
        END IF
    NEXT i
    RETURN ""
END FUNCTION

FUNCTION menubarItemsAt(items AS []STRING, k AS INTEGER) AS []STRING
    DIM out AS []STRING
    DIM c AS INTEGER = 0 - 1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            c = c + 1
        ELSEIF c = k THEN
            out = APPEND(out, treeLabel(items[i]))
        END IF
    NEXT i
    RETURN out
END FUNCTION

' menubarColAt — column offset of the k-th title within the title bar,
' where each title occupies width(label)+2 cells.
FUNCTION menubarColAt(items AS []STRING, k AS INTEGER) AS INTEGER
    DIM col AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            IF c = k THEN RETURN col
            col = col + lipgloss.Width(treeLabel(items[i])) + 2
            c = c + 1
        END IF
    NEXT i
    RETURN col
END FUNCTION

' panelContentBottom — the lowest (Y + H) among a Panel's children, in
' absolute form rows. Used to size the scroll range.
FUNCTION panelContentBottom(widgets AS []DesignWidget, panelName AS STRING) AS INTEGER
    DIM maxB AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(widgets) - 1
        IF widgets[i].Parent = panelName THEN
            DIM b AS INTEGER = widgets[i].Y + widgets[i].H
            IF b > maxB THEN maxB = b
        END IF
    NEXT i
    RETURN maxB
END FUNCTION

' propKey / propVal split a PropGrid "key=value" Items entry on the
' first '='. A missing '=' makes the whole entry the key with an empty
' value. Shared by the canvas + codegen.
FUNCTION propKey(item AS STRING) AS STRING
    DIM idx AS INTEGER = strings.Index(item, "=")
    IF idx < 0 THEN RETURN item
    RETURN Mid(item, 1, idx)
END FUNCTION

FUNCTION propVal(item AS STRING) AS STRING
    DIM idx AS INTEGER = strings.Index(item, "=")
    IF idx < 0 THEN RETURN ""
    RETURN Mid(item, idx + 2, LEN(item) - idx - 1)
END FUNCTION

' widgetVisibleText — single-line preview for a widget. Used by the
' generated code and by widgetVisibleLines for simple kinds.
FUNCTION widgetVisibleText(w AS DesignWidget) AS STRING
    IF w.Kind = "Button"    THEN RETURN buttonVisibleText(w)
    IF w.Kind = "Label"     THEN RETURN labelVisibleText(w)
    IF w.Kind = "TextInput" THEN RETURN textInputVisibleText(w)
    IF w.Kind = "Checkbox"    THEN RETURN checkboxVisibleText(w)
    IF w.Kind = "RadioButton" THEN RETURN radioButtonVisibleText(w)
    IF w.Kind = "ComboBox" THEN RETURN comboBoxVisibleText(w)
    IF w.Kind = "ProgressBar" THEN RETURN progressBarVisibleText(w)
    IF w.Kind = "ScrollBar" THEN RETURN scrollBarVisibleText(w)
    IF w.Kind = "TabStrip" THEN RETURN tabStripVisibleText(w)
    IF w.Kind = "Tree" THEN RETURN treeVisibleText(w)
    IF w.Kind = "TextArea" THEN
        ' Width proxy; widgetVisibleLines paints the framed box.
        RETURN "┌" + strings.Repeat("─", w.W - 2) + "┐"
    END IF
    IF w.Kind = "PropGrid" THEN
        ' Width proxy — first key/value pair. widgetVisibleLines paints
        ' the full two-column grid.
        IF LEN(w.Items) > 0 THEN RETURN propKey(w.Items[0]) + " │ " + propVal(w.Items[0])
        RETURN "(empty grid)"
    END IF
    IF w.Kind = "ScrollPanel" THEN
        ' Width proxy; widgetVisibleLines paints the framed scroll box.
        RETURN "┌" + strings.Repeat("─", w.W - 2) + "┐"
    END IF
    IF w.Kind = "StatusBar" THEN RETURN statusBarText(w.Items)
    IF w.Kind = "Menubar"   THEN RETURN menubarTitles(w.Items)
    IF w.Kind = "Panel"     THEN RETURN "┌" + strings.Repeat("─", w.W - 2) + "┐"
    IF w.Kind = "Dialog" THEN
        ' Non-visual marker: shows the dialog kind so the designer can
        ' tell at a glance what will pop at runtime. Stamps render as
        ' "◇ Dialog(kind): Title" — the leading ◇ matches the tree-pane
        ' leaf glyph.
        DIM dk AS STRING = w.DialogKind
        IF dk = "" THEN dk = "confirm"
        RETURN "◇ Dialog(" + dk + "): " + w.Text
    END IF
    RETURN w.Text
END FUNCTION

' widgetVisibleLines — multi-row design-time render. ListBox spans
' H rows; ScrollBar spans H rows; everything else delegates to
' widgetVisibleText for one line. The canvas painter walks the
' returned slice and writes each row to the grid at (X, Y + i).
FUNCTION widgetVisibleLines(w AS DesignWidget) AS []STRING
    DIM lines AS []STRING
    IF w.Kind = "ListBox" THEN
        lines = listBoxVisibleLines(w)
    ELSEIF w.Kind = "ScrollBar" AND strings.ToLower(w.Orient) = "v" THEN
        lines = scrollBarVisibleLines(w)
    ELSEIF w.Kind = "TabStrip" THEN
        lines = tabStripVisibleLines(w)
    ELSEIF w.Kind = "Tree" THEN
        ' One row per node (design-time shows the tree fully expanded).
        ' Glyph: ▾ for a parent, • for a leaf. Cursor row marked ▶.
        DIM nh AS INTEGER = w.H
        IF nh < 1 THEN nh = 1
        DIM nri AS INTEGER
        FOR nri = 0 TO nh - 1
            DIM nline AS STRING = ""
            IF nri < LEN(w.Items) THEN
                DIM nd AS INTEGER = treeDepth(w.Items[nri])
                DIM nIsP AS BOOLEAN = (nri + 1 < LEN(w.Items)) AND (treeDepth(w.Items[nri + 1]) > nd)
                DIM ng AS STRING = "•"
                IF nIsP THEN ng = "▾"
                DIM nmk AS STRING = "  "
                IF nri = w.Selected THEN nmk = "▶ "
                nline = nmk + strings.Repeat("  ", nd) + ng + " " + treeLabel(w.Items[nri])
            END IF
            IF lipgloss.Width(nline) < w.W THEN nline = nline + strings.Repeat(" ", w.W - lipgloss.Width(nline))
            lines = APPEND(lines, nline)
        NEXT nri
    ELSEIF w.Kind = "TextArea" THEN
        ' Framed box: top border, H-2 content rows (initial Text split
        ' on newlines), bottom border.
        DIM aw AS INTEGER = w.W
        IF aw < 3 THEN aw = 3
        DIM ah AS INTEGER = w.H
        IF ah < 3 THEN ah = 3
        DIM inW AS INTEGER = aw - 2
        DIM clines AS []STRING = strings.Split(w.Text, "\n")
        lines = APPEND(lines, "┌" + strings.Repeat("─", inW) + "┐")
        DIM ai AS INTEGER
        FOR ai = 0 TO ah - 3
            DIM aln AS STRING = ""
            IF ai < LEN(clines) THEN aln = clines[ai]
            IF lipgloss.Width(aln) > inW THEN aln = Mid(aln, 1, inW)
            IF lipgloss.Width(aln) < inW THEN aln = aln + strings.Repeat(" ", inW - lipgloss.Width(aln))
            lines = APPEND(lines, "│" + aln + "│")
        NEXT ai
        lines = APPEND(lines, "└" + strings.Repeat("─", inW) + "┘")
    ELSEIF w.Kind = "PropGrid" THEN
        ' One row per key/value pair: ▶ cursor marker + key padded to a
        ' half-width column + │ separator + value. Capped at H.
        DIM gh AS INTEGER = w.H
        IF gh < 1 THEN gh = 1
        DIM keyW AS INTEGER = (w.W - 4) / 2
        IF keyW < 1 THEN keyW = 1
        DIM gri AS INTEGER
        FOR gri = 0 TO gh - 1
            DIM gline AS STRING = ""
            IF gri < LEN(w.Items) THEN
                DIM gk AS STRING = propKey(w.Items[gri])
                DIM gv AS STRING = propVal(w.Items[gri])
                IF lipgloss.Width(gk) > keyW THEN gk = Mid(gk, 1, keyW)
                IF lipgloss.Width(gk) < keyW THEN gk = gk + strings.Repeat(" ", keyW - lipgloss.Width(gk))
                DIM gmark AS STRING = "  "
                IF gri = w.Selected THEN gmark = "▶ "
                gline = gmark + gk + "│ " + gv
            END IF
            IF lipgloss.Width(gline) > w.W THEN gline = Mid(gline, 1, w.W)
            IF lipgloss.Width(gline) < w.W THEN gline = gline + strings.Repeat(" ", w.W - lipgloss.Width(gline))
            lines = APPEND(lines, gline)
        NEXT gri
    ELSEIF w.Kind = "Panel" THEN
        ' Empty bordered container with a right-edge scrollbar. Child
        ' widgets render over the interior (design-time shows them all;
        ' runtime clips + scrolls them).
        DIM pnH AS INTEGER = w.H
        IF pnH < 3 THEN pnH = 3
        DIM pnInner AS INTEGER = w.W - 2
        IF pnInner < 1 THEN pnInner = 1
        DIM pnVis AS INTEGER = pnH - 2
        lines = APPEND(lines, "┌" + strings.Repeat("─", pnInner) + "┐")
        DIM pni AS INTEGER
        FOR pni = 0 TO pnVis - 1
            DIM pnsb AS STRING = "░"
            IF pni = 0 THEN pnsb = "▲"
            IF pni = pnVis - 1 THEN pnsb = "▼"
            IF pni = 1 THEN pnsb = "█"
            lines = APPEND(lines, "│" + strings.Repeat(" ", pnInner - 1) + pnsb + "│")
        NEXT pni
        lines = APPEND(lines, "└" + strings.Repeat("─", pnInner) + "┘")
    ELSEIF w.Kind = "ScrollPanel" THEN
        ' Framed box: top border, H-2 content rows (each = content text
        ' + a scrollbar cell), bottom border. Design-time shows the top
        ' of the content (scroll = 0) with the thumb parked at the top.
        DIM spw AS INTEGER = w.W
        IF spw < 4 THEN spw = 4
        DIM sph AS INTEGER = w.H
        IF sph < 3 THEN sph = 3
        DIM spVisible AS INTEGER = sph - 2
        DIM spContentW AS INTEGER = spw - 3
        IF spContentW < 1 THEN spContentW = 1
        DIM spTotal AS INTEGER = LEN(w.Items)
        DIM spMaxS AS INTEGER = spTotal - spVisible
        IF spMaxS < 0 THEN spMaxS = 0
        DIM spTrack AS INTEGER = spVisible - 2
        DIM spThumb AS INTEGER = 0 - 1
        IF spMaxS > 0 AND spTrack > 0 THEN spThumb = 0
        lines = APPEND(lines, "┌" + strings.Repeat("─", spw - 2) + "┐")
        DIM spi AS INTEGER
        FOR spi = 0 TO spVisible - 1
            DIM spcl AS STRING = ""
            IF spi < spTotal THEN spcl = w.Items[spi]
            IF lipgloss.Width(spcl) > spContentW THEN spcl = Mid(spcl, 1, spContentW)
            IF lipgloss.Width(spcl) < spContentW THEN spcl = spcl + strings.Repeat(" ", spContentW - lipgloss.Width(spcl))
            DIM spsb AS STRING = "░"
            IF spi = 0 THEN spsb = "▲"
            IF spi = spVisible - 1 THEN spsb = "▼"
            IF spi >= 1 AND spi <= spVisible - 2 AND (spi - 1) = spThumb THEN spsb = "█"
            lines = APPEND(lines, "│" + spcl + spsb + "│")
        NEXT spi
        lines = APPEND(lines, "└" + strings.Repeat("─", spw - 2) + "┘")
    ELSE
        lines = APPEND(lines, widgetVisibleText(w))
    END IF
    RETURN lines
END FUNCTION

' widgetBox — bounding box of widget in canvas coordinates:
' (x0, y0, x1, y1) with x1/y1 exclusive.
FUNCTION widgetBox(w AS DesignWidget) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM txt AS STRING = widgetVisibleText(w)
    DIM ww AS INTEGER = lipgloss.Width(txt)
    IF w.W > ww THEN ww = w.W
    DIM hh AS INTEGER = w.H
    IF hh < 1 THEN hh = 1
    RETURN w.X, w.Y, w.X + ww, w.Y + hh
END FUNCTION

' formWidgetAt — index of the topmost widget whose box contains
' canvas coords (cx, cy), or -1 if none. Walks back-to-front so
' later (drawn-on-top) widgets win.
FUNCTION formWidgetAt(m AS Model, cx AS INTEGER, cy AS INTEGER) AS INTEGER
    IF NOT hasActiveTab(m) THEN RETURN 0 - 1
    DIM i AS INTEGER
    FOR i = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1 TO 0 STEP 0 - 1
        DIM x0 AS INTEGER
        DIM y0 AS INTEGER
        DIM x1 AS INTEGER
        DIM y1 AS INTEGER
        x0, y0, x1, y1 = widgetBox(m.Tabs[m.TabIdx].Form.Widgets[i])
        IF cx >= x0 AND cx < x1 AND cy >= y0 AND cy < y1 THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' formScreenToCanvas — translate screen coords to canvas coords
' assuming the canvas starts at (LeftW, 2) and we keep a 1-cell
' top margin for the title row.
FUNCTION formScreenToCanvas(m AS Model, sx AS INTEGER, sy AS INTEGER) AS (INTEGER, INTEGER)
    DIM cx AS INTEGER = sx - m.LeftW
    DIM cy AS INTEGER = sy - 2 - 1   ' minus caption (1) + title row (1)
    RETURN cx, cy
END FUNCTION

' renderFormCanvas — middle-pane body when ViewMode = "form".
' Renders the title row then paints each widget at its (X, Y).
FUNCTION renderFormCanvas(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    ' No active tab → return a blank canvas instead of crashing.
    IF NOT hasActiveTab(m) THEN
        DIM bg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(height).Align(lipgloss.Center, lipgloss.Center)
        RETURN bg.Render("(no form open — open a .dbproj from the tree)")
    END IF
    DIM cellBg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Width(width)
    DIM widStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    ' Build a grid of plain bg cells then overlay widgets char-by-char.
    DIM gridH AS INTEGER = height - 1   ' minus title row
    IF gridH < 1 THEN gridH = 1
    ' Loop vars hoisted — DBasic codegen drops re-DIM inside nested
    ' ELSEIF/FOR scopes, so we declare every loop iterator once.
    DIM r AS INTEGER
    DIM c AS INTEGER
    DIM grid AS [][]STRING
    FOR r = 0 TO gridH - 1
        DIM row AS []STRING
        FOR c = 0 TO width - 1
            row = APPEND(row, " ")
        NEXT c
        grid = APPEND(grid, row)
    NEXT r
    ' Per-cell selection flag (mirrors grid shape).
    DIM selGrid AS [][]BOOLEAN
    FOR r = 0 TO gridH - 1
        DIM srow AS []BOOLEAN
        FOR c = 0 TO width - 1
            srow = APPEND(srow, FALSE)
        NEXT c
        selGrid = APPEND(selGrid, srow)
    NEXT r
    ' Paint widgets. Multi-row widgets (ListBox, vertical ScrollBar)
    ' return one string per row via widgetVisibleLines.
    '
    ' Important: walk each row UTF-8 codepoint by codepoint, not byte
    ' by byte. The new widgets use multi-byte glyphs (▶ ▲ ▼ │ █ ░);
    ' splitting on bytes would store half-glyphs in adjacent grid
    ' slots and visually shorten the rendered row, letting the
    ' terminal-default bg leak through at the right edge.
    DIM wi AS INTEGER
    FOR wi = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[wi]
        DIM rows AS []STRING = widgetVisibleLines(w)
        DIM isSel AS BOOLEAN = (wi = m.Tabs[m.TabIdx].SelWidget)
        DIM rj AS INTEGER
        FOR rj = 0 TO LEN(rows) - 1
            DIM line AS STRING = rows[rj]
            DIM bx AS INTEGER = 0    ' current byte offset into line
            DIM cellCol AS INTEGER = 0  ' current visible cell offset
            DO WHILE bx < LEN(line)
                ' Decode the next UTF-8 codepoint's byte length from
                ' the leading byte: 110xxxxx = 2, 1110xxxx = 3,
                ' 11110xxx = 4, anything else = 1.
                DIM lead AS INTEGER = Asc(Mid(line, bx + 1, 1))
                DIM nb AS INTEGER = 1
                IF lead >= 240 THEN
                    nb = 4
                ELSEIF lead >= 224 THEN
                    nb = 3
                ELSEIF lead >= 192 THEN
                    nb = 2
                END IF
                IF bx + nb > LEN(line) THEN nb = LEN(line) - bx
                DIM cell AS STRING = Mid(line, bx + 1, nb)
                DIM pCol AS INTEGER = w.X + cellCol
                DIM pRow AS INTEGER = w.Y + rj
                IF pRow >= 0 AND pRow < gridH AND pCol >= 0 AND pCol < width THEN
                    grid[pRow][pCol] = cell
                    IF isSel THEN selGrid[pRow][pCol] = TRUE
                END IF
                bx = bx + nb
                cellCol = cellCol + 1
            LOOP
        NEXT rj
    NEXT wi
    ' Render rows.
    DIM lines AS []STRING
    DIM titleLine AS STRING = titleStyle.Render(" " + m.Tabs[m.TabIdx].Form.Title)
    lines = APPEND(lines, titleLine)
    FOR r = 0 TO gridH - 1
        DIM out AS STRING = ""
        DIM runBuf AS STRING = ""
        DIM runIsSel AS BOOLEAN = FALSE
        FOR c = 0 TO width - 1
            DIM ch AS STRING = grid[r][c]
            DIM cellSel AS BOOLEAN = selGrid[r][c]
            IF cellSel <> runIsSel AND runBuf <> "" THEN
                IF runIsSel THEN
                    out = out + selStyle.Render(runBuf)
                ELSE
                    out = out + widStyle.Render(runBuf)
                END IF
                runBuf = ""
            END IF
            runIsSel = cellSel
            runBuf = runBuf + ch
        NEXT c
        IF runBuf <> "" THEN
            IF runIsSel THEN
                out = out + selStyle.Render(runBuf)
            ELSE
                out = out + widStyle.Render(runBuf)
            END IF
        END IF
        _ = cellBg
        lines = APPEND(lines, out)
    NEXT r
    RETURN strings.Join(lines, "\n")
END FUNCTION

' -------------------------------------------------------------------------
' Persistence — .dbproj is a JSON blob of DesignForm.
' -------------------------------------------------------------------------

' newUntitledForm — open a fresh, in-memory form tab so the user has
' a real canvas to drop palette widgets onto. The tab has no on-disk
' path; the first Ctrl+S will pop the Save As modal ("saveform"
' context). Called by the View → Form Designer action so picking
' that menu item from a session full of code tabs Just Works instead
' of silently appending widgets to a code tab's invisible Form field.
SUB newUntitledForm(m AS POINTER TO Model)
    ' Reuse the active tab if it's already a form — no point stacking
    ' a duplicate blank form on top of one the user is working on.
    IF hasActiveTab(^m) THEN
        IF m.Tabs[m.TabIdx].Kind = "form" THEN
            m.ViewMode = "form"
            m.Status = "form designer — " + m.Tabs[m.TabIdx].Path
            RETURN
        END IF
        ' Blur the previous tab's editor so only one cursor blinks.
        m.Tabs[m.TabIdx].Editor.Blur()
    END IF
    DIM nf AS DesignForm
    nf.Name  = "frmStart"
    nf.Title = "frmStart"
    DIM nt AS Tab
    nt.Path      = ""
    nt.Kind      = "form"
    nt.Form      = nf
    nt.FormName  = "frmStart"
    nt.SelWidget = 0 - 1
    m.Tabs   = APPEND(m.Tabs, nt)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    m.Status = "new form — click a palette item to add widgets"
END SUB

' readProjectFromDisk — parse `path` as a .dbproj JSON file into a
' Project value. Handles both shapes: the new Project format and the
' legacy single-DesignForm format (auto-wrapped). Returns (proj, ok,
' reason). On ok=FALSE, `reason` is a short human-readable string
' the caller can show in the status bar so the user can tell whether
' the file is missing, empty, or malformed.
FUNCTION readProjectFromDisk(path AS STRING) AS (Project, BOOLEAN, STRING)
    DIM emptyProj AS Project
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN RETURN emptyProj, FALSE, "read failed: " + rerr.Error()
    IF LEN(data) = 0 THEN RETURN emptyProj, FALSE, "file is empty (0 bytes)"
    ' Try the new Project shape first.
    DIM p AS Project
    DIM jerr AS ERROR = encjson.Unmarshal(data, @p)
    IF jerr = NIL AND LEN(p.Forms) > 0 THEN
        ' Looks like a Project — every form must have a Name; the
        ' codegen and tab system key on it. Auto-name any blanks.
        DIM nameI AS INTEGER
        FOR nameI = 0 TO LEN(p.Forms) - 1
            IF p.Forms[nameI].Name = "" THEN
                p.Forms[nameI].Name = "frm" + strconv.Itoa(nameI + 1)
            END IF
        NEXT nameI
        IF p.StartForm = "" THEN p.StartForm = p.Forms[0].Name
        RETURN p, TRUE, ""
    END IF
    ' Fall back to legacy single-DesignForm and wrap in a Project.
    DIM legacy AS DesignForm
    DIM jerr2 AS ERROR = encjson.Unmarshal(data, @legacy)
    IF jerr2 <> NIL THEN
        DIM reason AS STRING = "invalid JSON: " + jerr2.Error()
        IF jerr <> NIL THEN reason = "invalid JSON: " + jerr.Error()
        RETURN emptyProj, FALSE, reason
    END IF
    IF legacy.Name = "" THEN legacy.Name = "frmStart"
    DIM wrap AS Project
    wrap.Forms     = APPEND(wrap.Forms, legacy)
    wrap.StartForm = legacy.Name
    RETURN wrap, TRUE, ""
END FUNCTION

' findFormByName — locate a form within a project by Name. Returns
' (form, idx, ok). idx is the position within proj.Forms.
FUNCTION findFormByName(proj AS Project, name AS STRING) AS (DesignForm, INTEGER, BOOLEAN)
    DIM empty AS DesignForm
    DIM i AS INTEGER
    FOR i = 0 TO LEN(proj.Forms) - 1
        IF proj.Forms[i].Name = name THEN RETURN proj.Forms[i], i, TRUE
    NEXT i
    RETURN empty, 0 - 1, FALSE
END FUNCTION

' writeProjectToDisk — JSON-marshal `proj` to `path` (pretty-printed).
' Refuses to write 0-byte payloads (defensive: a valid Project marshals
' to at least "{}", so empty output means something went wrong upstream).
SUB writeProjectToDisk(path AS STRING, proj AS Project, status AS POINTER TO STRING)
    DIM data AS BYTES
    DIM merr AS ERROR
    data, merr = encjson.MarshalIndent(proj, "", "  ")
    IF merr <> NIL THEN
        ^status = "marshal failed: " + merr.Error()
        RETURN
    END IF
    IF LEN(data) = 0 THEN
        ^status = "marshal returned 0 bytes — refusing to write empty " + path
        RETURN
    END IF
    DIM werr AS ERROR = os.WriteFile(path, data, 0644)
    IF werr <> NIL THEN
        ^status = "save failed: " + werr.Error()
        RETURN
    END IF
    ^status = fmt.Sprintf("saved project %s (%d bytes, %d forms)", path, LEN(data), LEN(proj.Forms))
END SUB

' addFormToActiveProject — append a fresh DesignForm to the project
' owned by the active tab, save the project to disk, and open the
' new form in its own tab. Auto-names the new form frmN where N is
' the next free index. When the active tab isn't a saved form,
' falls back to newUntitledForm.
SUB addFormToActiveProject(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) OR m.Tabs[m.TabIdx].Kind <> "form" OR m.Tabs[m.TabIdx].Path = "" THEN
        newUntitledForm(m)
        RETURN
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    DIM proj AS Project
    DIM pok  AS BOOLEAN
    DIM preason AS STRING
    proj, pok, preason = readProjectFromDisk(path)
    IF NOT pok THEN
        m.Status = "couldn't read " + path + " (" + preason + ") — saving the active form first might help"
        RETURN
    END IF
    ' Find a free frmN slot.
    DIM idx AS INTEGER = LEN(proj.Forms) + 1
    DIM cand AS STRING = "frm" + strconv.Itoa(idx)
    DO WHILE TRUE
        DIM exists AS BOOLEAN = FALSE
        DIM ci AS INTEGER
        FOR ci = 0 TO LEN(proj.Forms) - 1
            IF proj.Forms[ci].Name = cand THEN exists = TRUE
        NEXT ci
        IF NOT exists THEN EXIT DO
        idx = idx + 1
        cand = "frm" + strconv.Itoa(idx)
    LOOP
    DIM nf AS DesignForm
    nf.Name  = cand
    nf.Title = cand
    proj.Forms = APPEND(proj.Forms, nf)
    writeProjectToDisk(path, proj, @m.Status)
    openFormTab(m, path, proj, cand)
END SUB

' loadFormFromDisk — read the .dbproj at `path`, pick the start form
' (or first form if no StartForm), open it as a new form tab. The
' tab's FormName is set so subsequent saves merge back into the
' right slot of the on-disk project.
SUB loadFormFromDisk(m AS POINTER TO Model, path AS STRING)
    DIM proj AS Project
    DIM pok AS BOOLEAN
    DIM lreason AS STRING
    proj, pok, lreason = readProjectFromDisk(path)
    IF NOT pok THEN
        m.Status = "bad .dbproj: " + path + " (" + lreason + ")"
        RETURN
    END IF
    IF LEN(proj.Forms) = 0 THEN
        m.Status = "empty project: " + path
        RETURN
    END IF
    ' Opening a project is a project context switch — re-root the
    ' tree to the project's directory so the sidebar doesn't keep
    ' showing the previous project's files. Skip if we're already
    ' rooted there.
    DIM newRoot AS STRING = dirName(path)
    IF newRoot <> "" AND newRoot <> m.TreeRoot THEN
        m.TreeRoot     = newRoot
        m.TreeExpanded = APPEND(m.TreeExpanded, newRoot)
        buildTreeNodes(m)
        m.TreeSelected = 0
        m.TreeOffset   = 0
    END IF
    DIM startName AS STRING = proj.StartForm
    IF startName = "" THEN startName = proj.Forms[0].Name
    openFormTab(m, path, proj, startName)
END SUB

' openFormTab — shared by loadFormFromDisk and (future) tree-click /
' New Form. If a tab is already editing (path, formName), focus it
' instead of stacking a duplicate. Otherwise create a fresh tab.
SUB openFormTab(m AS POINTER TO Model, path AS STRING, proj AS Project, formName AS STRING)
    DIM picked AS DesignForm
    DIM idx AS INTEGER
    DIM found AS BOOLEAN
    picked, idx, found = findFormByName(proj, formName)
    IF NOT found THEN
        m.Status = "form '" + formName + "' not in " + path
        RETURN
    END IF
    _ = idx
    ' Reuse an existing tab if one's already on this (path, formName).
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[ti].Kind = "form" AND m.Tabs[ti].Path = path AND m.Tabs[ti].FormName = formName THEN
            switchToTab(m, ti)
            RETURN
        END IF
    NEXT ti
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    DIM t AS Tab
    t.Path      = path
    t.Kind      = "form"
    t.Form      = picked
    t.FormName  = formName
    t.SelWidget = 0 - 1
    m.Tabs   = APPEND(m.Tabs, t)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    m.Status = "loaded " + formName + " from " + path
END SUB

' saveForm — write the active form back to its .dbproj. For multi-
' form projects this re-reads disk first so other forms aren't
' clobbered; the active form replaces its slot in proj.Forms.
SUB saveForm(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN RETURN
    IF m.Tabs[m.TabIdx].Path = "" THEN
        DIM sfDir AS STRING
        DIM sfErr AS ERROR
        sfDir, sfErr = os.Getwd()
        IF sfErr <> NIL THEN sfDir = "."
        openBrowser(m, "saveform", "Save Form", "save", sfDir, "form.dbproj")
        RETURN
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    DIM proj AS Project
    DIM pok AS BOOLEAN
    DIM rreason AS STRING
    proj, pok, rreason = readProjectFromDisk(path)
    _ = rreason
    IF NOT pok THEN
        ' File doesn't exist yet (Save As) or was deleted — start a
        ' fresh project containing just this tab's form.
        proj.StartForm = m.Tabs[m.TabIdx].FormName
        IF proj.StartForm = "" THEN proj.StartForm = "frmStart"
    END IF
    ' Pick which form-slot to overwrite: by FormName if the tab has
    ' one, else by Form.Name on the tab's working copy.
    DIM key AS STRING = m.Tabs[m.TabIdx].FormName
    IF key = "" THEN key = m.Tabs[m.TabIdx].Form.Name
    IF key = "" THEN
        key = "frmStart"
        m.Tabs[m.TabIdx].Form.Name = key
    END IF
    ' Mirror the working name onto Form.Name so the on-disk slot
    ' uses the same identifier.
    m.Tabs[m.TabIdx].Form.Name = key
    m.Tabs[m.TabIdx].FormName  = key
    DIM existing AS DesignForm
    DIM eidx AS INTEGER
    DIM efound AS BOOLEAN
    existing, eidx, efound = findFormByName(proj, key)
    _ = existing
    IF efound THEN
        proj.Forms[eidx] = m.Tabs[m.TabIdx].Form
    ELSE
        proj.Forms = APPEND(proj.Forms, m.Tabs[m.TabIdx].Form)
    END IF
    IF proj.StartForm = "" THEN proj.StartForm = key
    writeProjectToDisk(path, proj, @m.Status)
END SUB

' -------------------------------------------------------------------------
' Widget property editing — clicking a row in the right-pane
' Properties section pops an input modal pre-filled with the current
' value. dispatchModalClose for "wprop:*" applies the edit.
' -------------------------------------------------------------------------

' propRowEditContext — returns (title, prompt, default, modalContext)
' for the input modal that edits Properties row `rowIdx` on widget
' `w`. Returns empty strings when the row index isn't editable
' (row 0 = Kind, read-only) or doesn't exist for this kind.
'
' Row order MUST match the renderer in renderRightPane. Standard
' rows 0-4 are the same for every kind; rows 5+ are kind-specific
' and walked by a cursor so each kind gets a tight, dense layout.
FUNCTION propRowEditContext(w AS DesignWidget, rowIdx AS INTEGER) AS (STRING, STRING, STRING, STRING)
    IF rowIdx = 1 THEN RETURN "Edit Name", "Name:", w.Name, "wprop:name"
    IF rowIdx = 2 THEN RETURN "Edit Text", "Text:", w.Text, "wprop:text"
    IF rowIdx = 3 THEN RETURN "Edit Position", "X, Y:", fmt.Sprintf("%d, %d", w.X, w.Y), "wprop:pos"
    IF rowIdx = 4 THEN RETURN "Edit Size", "W, H:", fmt.Sprintf("%d, %d", w.W, w.H), "wprop:size"
    DIM cursor AS INTEGER = 5
    IF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN
            DIM ckDef AS STRING = "false"
            IF w.Checked THEN ckDef = "true"
            RETURN "Edit Checked", "true/false:", ckDef, "wprop:checked"
        END IF
        cursor = cursor + 1
    END IF
    IF w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN RETURN "Edit Group", "Group:", w.Group, "wprop:group"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ComboBox" OR w.Kind = "ListBox" THEN
        IF rowIdx = cursor THEN RETURN "Edit Items", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Selected", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ProgressBar" OR w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Min", "Min:", strconv.Itoa(w.Min), "wprop:min"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Max", "Max:", strconv.Itoa(w.Max), "wprop:max"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Value", "Value:", strconv.Itoa(w.Value), "wprop:value"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Orient", "h or v:", w.Orient, "wprop:orient"
        cursor = cursor + 1
    END IF
    IF w.Kind = "TabStrip" THEN
        IF rowIdx = cursor THEN RETURN "Edit Tabs", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Active", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Tree" THEN
        IF rowIdx = cursor THEN RETURN "Edit Nodes", "comma list, '-' = depth:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Cursor", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "PropGrid" THEN
        IF rowIdx = cursor THEN RETURN "Edit Rows", "comma list of key=value:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Cursor", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ScrollPanel" THEN
        IF rowIdx = cursor THEN RETURN "Edit Content", "comma-separated lines:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Menubar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Menus", "comma list, '-' = item:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
    END IF
    IF w.Kind = "StatusBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Segments", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Button" THEN
        IF rowIdx = cursor THEN RETURN "OnClick Dialog", "Dialog widget name (blank = none):", w.OnClickDialog, "wprop:onclickdialog"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Dialog" THEN
        DIM dlgK AS STRING = w.DialogKind
        IF dlgK = "" THEN dlgK = "confirm"
        IF rowIdx = cursor THEN RETURN "Edit Dialog Kind", "confirm | input | file:", dlgK, "wprop:dialogkind"
        cursor = cursor + 1
        IF dlgK = "confirm" THEN
            IF rowIdx = cursor THEN RETURN "Edit Message", "Body text:", w.DialogMsg, "wprop:dialogmsg"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Buttons", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        ELSEIF dlgK = "input" THEN
            IF rowIdx = cursor THEN RETURN "Edit Prompt", "Prompt:", w.DialogMsg, "wprop:dialogmsg"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Default", "Default value:", w.DialogDef, "wprop:dialogdef"
        ELSEIF dlgK = "file" THEN
            DIM fm2 AS STRING = w.DialogMode
            IF fm2 = "" THEN fm2 = "open"
            IF rowIdx = cursor THEN RETURN "Edit Mode", "open | save:", fm2, "wprop:dialogmode"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Mask", "Glob, e.g. *.dbas:", w.DialogMask, "wprop:dialogmask"
        END IF
    END IF
    ' Universal trailing row: container membership. A Panel can't be a
    ' child (no nesting in v1).
    IF w.Kind <> "Panel" THEN
        IF rowIdx = cursor THEN RETURN "Edit Parent", "container Panel name (blank = none):", w.Parent, "wprop:parent"
        cursor = cursor + 1
    END IF
    RETURN "", "", "", ""
END FUNCTION

' formClickPropAt — dispatch a click on Properties row `rowIdx`
' (0-based) into the right input modal. Row 0 (Kind) is read-only;
' any rowIdx that propRowEditContext returns "" for is also a no-op.
SUB formClickPropAt(m AS POINTER TO Model, rowIdx AS INTEGER)
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
    DIM ctxTitle AS STRING
    DIM ctxPrompt AS STRING
    DIM ctxDef AS STRING
    DIM ctxKey AS STRING
    ctxTitle, ctxPrompt, ctxDef, ctxKey = propRowEditContext(w, rowIdx)
    IF ctxKey = "" THEN RETURN
    showInputModal(m, ctxTitle, ctxPrompt, ctxDef, ctxKey)
END SUB

' parseTwoInts — helper for Pos / Size edits. "X, Y" → (X, Y, ok).
FUNCTION parseTwoInts(s AS STRING) AS (INTEGER, INTEGER, BOOLEAN)
    DIM parts AS []STRING = strings.Split(s, ",")
    IF LEN(parts) <> 2 THEN RETURN 0, 0, FALSE
    DIM a AS INTEGER
    DIM b AS INTEGER
    DIM ae AS ERROR
    DIM be AS ERROR
    a, ae = strconv.Atoi(strings.TrimSpace(parts[0]))
    b, be = strconv.Atoi(strings.TrimSpace(parts[1]))
    IF ae <> NIL OR be <> NIL THEN RETURN 0, 0, FALSE
    RETURN a, b, TRUE
END FUNCTION

' -------------------------------------------------------------------------
' Form codegen — emit a runnable .dbas program from a DesignForm.
' v1 generates a static bubbletea Model that paints each widget at
' its (X, Y); q/Esc/Ctrl+C exits. Future versions will add input
' handlers per widget kind, named identifiers in the Model, etc.
' -------------------------------------------------------------------------

' escapeForDBString — backslash-escape backslashes and quotes so the
' string is safe to drop inside a DBasic string literal.
FUNCTION escapeForDBString(s AS STRING) AS STRING
    DIM bsl AS STRING = Chr(92)
    DIM qt  AS STRING = Chr(34)
    DIM out AS STRING = strings.ReplaceAll(s, bsl, bsl + bsl)
    out = strings.ReplaceAll(out, qt, bsl + qt)
    ' Escape control chars so the value stays a single-line DBasic
    ' literal — important for TextArea content that spans lines.
    out = strings.ReplaceAll(out, Chr(10), bsl + "n")
    out = strings.ReplaceAll(out, Chr(13), bsl + "r")
    out = strings.ReplaceAll(out, Chr(9), bsl + "t")
    RETURN out
END FUNCTION

' -------------------------------------------------------------------------
' Codegen — partner .dbas split across a regen-only prelude and a
' preserved user section.
'
' Sentinel marker that splits the partner .dbas into two halves:
'   [ prelude ]   ' regenerated on every F5 — model, view, update,
'                 ' main, dispatchClick, anything DBtui knows how
'                 ' to write itself.
'   [ marker  ]   ' a fixed comment line — do not edit / delete /
'                 ' duplicate; DBtui scans for it byte-for-byte.
'   [ user    ]   ' button handler bodies + anything else the
'                 ' programmer wrote. Preserved across regens.
'
' The marker chosen is verbose on purpose so an accidental match in
' someone else's code is essentially impossible.
' -------------------------------------------------------------------------
CONST formUserMarker AS STRING = "' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE ====="

' generateFormPrelude — emit ONLY the generated half of the partner
' .dbas (Model + Init + Update + View + Main + dispatchClick). The
' user-edited handler bodies live below the formUserMarker line and
' are preserved by mergeFormDbas across every F5 regeneration.
FUNCTION generateFormPrelude(f AS DesignForm) AS STRING
    DIM qt AS STRING = Chr(34)
    DIM s  AS STRING = ""
    DIM n  AS INTEGER = LEN(f.Widgets)
    DIM nStr AS STRING = strconv.Itoa(n)
    ' Scan once for Dialog widgets — they need extra plumbing
    ' (lipgloss import, Model fields, Show subs, View overlay).
    DIM hasDialog AS BOOLEAN = FALSE
    DIM hasTree AS BOOLEAN = FALSE
    DIM hasTextArea AS BOOLEAN = FALSE
    DIM hasPropGrid AS BOOLEAN = FALSE
    DIM hasScrollPanel AS BOOLEAN = FALSE
    DIM hasMenubar AS BOOLEAN = FALSE
    DIM hasStatusBar AS BOOLEAN = FALSE
    DIM hasPanel AS BOOLEAN = FALSE
    DIM scanI AS INTEGER
    FOR scanI = 0 TO n - 1
        IF f.Widgets[scanI].Kind = "Dialog" THEN hasDialog = TRUE
        IF f.Widgets[scanI].Kind = "Tree" THEN hasTree = TRUE
        IF f.Widgets[scanI].Kind = "TextArea" THEN hasTextArea = TRUE
        IF f.Widgets[scanI].Kind = "PropGrid" THEN hasPropGrid = TRUE
        IF f.Widgets[scanI].Kind = "ScrollPanel" THEN hasScrollPanel = TRUE
        IF f.Widgets[scanI].Kind = "Menubar" THEN hasMenubar = TRUE
        IF f.Widgets[scanI].Kind = "StatusBar" THEN hasStatusBar = TRUE
        IF f.Widgets[scanI].Kind = "Panel" THEN hasPanel = TRUE
    NEXT scanI
    s = s + "' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===\n"
    s = s + "\n"
    s = s + "IMPORT " + qt + "charm.land/bubbletea/v2" + qt + " AS tea\n"
    s = s + "IMPORT " + qt + "fmt" + qt + "\n"
    s = s + "IMPORT " + qt + "os" + qt + "\n"
    s = s + "IMPORT " + qt + "strings" + qt + "\n"
    IF hasDialog OR hasTextArea OR hasPropGrid OR hasScrollPanel OR hasMenubar OR hasStatusBar THEN
        s = s + "IMPORT " + qt + "charm.land/lipgloss/v2" + qt + " AS lipgloss\n"
    END IF
    s = s + "\n"
    ' fmt is imported pre-emptively so user handlers can call
    ' fmt.Println etc. without adding their own IMPORT line. Go
    ' rejects unused imports, so reference it from an uncalled
    ' SUB to keep the import live even when user code doesn't
    ' touch fmt at all.
    s = s + "SUB _dbtuiKeepFmtAlive()\n"
    s = s + "    _ = fmt.Sprintf(" + qt + qt + ")\n"
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- Model: width/height/focus + one field per stateful widget --
    s = s + "TYPE Model\n"
    s = s + "    DIM Width  AS INTEGER\n"
    s = s + "    DIM Height AS INTEGER\n"
    s = s + "    DIM Focus  AS INTEGER\n"
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM w AS DesignWidget = f.Widgets[i]
      IF w.Parent = "" THEN
        IF w.Kind = "TextInput" THEN
            s = s + textInputEmitModel(w)
        ELSEIF w.Kind = "TextArea" THEN
            ' _Cur is the insertion-point byte offset into _Val.
            s = s + "    DIM " + w.Name + "_Val AS STRING\n"
            s = s + "    DIM " + w.Name + "_Cur AS INTEGER\n"
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
            s = s + "    DIM " + w.Name + "_Val AS BOOLEAN\n"
        ELSEIF w.Kind = "ComboBox" OR w.Kind = "ListBox" OR w.Kind = "ScrollBar" OR w.Kind = "ProgressBar" OR w.Kind = "TabStrip" OR w.Kind = "PropGrid" THEN
            s = s + "    DIM " + w.Name + "_Val AS INTEGER\n"
        ELSEIF w.Kind = "Tree" THEN
            ' Cursor index into the node list + a per-node collapse flag.
            s = s + "    DIM " + w.Name + "_Val AS INTEGER\n"
            s = s + "    DIM " + w.Name + "_Collapsed AS []BOOLEAN\n"
        ELSEIF w.Kind = "ScrollPanel" THEN
            ' Top visible content line.
            s = s + "    DIM " + w.Name + "_Scroll AS INTEGER\n"
        ELSEIF w.Kind = "Menubar" THEN
            ' Active (highlighted) menu, open state, highlighted item.
            s = s + "    DIM " + w.Name + "_Active AS INTEGER\n"
            s = s + "    DIM " + w.Name + "_Open   AS BOOLEAN\n"
            s = s + "    DIM " + w.Name + "_Item   AS INTEGER\n"
        ELSEIF w.Kind = "StatusBar" THEN
            ' Runtime override text; empty = show the static segments.
            s = s + "    DIM " + w.Name + "_Text AS STRING\n"
        ELSEIF w.Kind = "Panel" THEN
            ' Scroll offset of the container's child viewport.
            s = s + "    DIM " + w.Name + "_Scroll AS INTEGER\n"
        ELSEIF w.Kind = "Dialog" THEN
            s = s + "    DIM " + w.Name + "_Active AS BOOLEAN\n"
            s = s + "    DIM " + w.Name + "_Idx    AS INTEGER\n"
            ' Input-kind dialogs also need the current text and a
            ' focus flag (TRUE = the text field has focus; FALSE =
            ' one of the buttons does).
            IF w.DialogKind = "input" THEN
                s = s + "    DIM " + w.Name + "_Text    AS STRING\n"
                s = s + "    DIM " + w.Name + "_OnField AS BOOLEAN\n"
            END IF
        END IF
      END IF
    NEXT i
    s = s + "END TYPE\n"
    s = s + "\n"
    s = s + "FUNCTION (m AS Model) Init() AS tea.Cmd\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- Update: resize, quit (Esc/Ctrl+C), Tab cycle, per-widget ---
    ' Package-level pointer to the current Model — set on every Update
    ' entry so user-defined event handlers (no-arg _Click, _Change,
    ' _Close) can mutate model state via the no-arg Show<Name>() and
    ' similar helpers without us having to thread `m` through every
    ' dispatch path. Only valid for the lifetime of an Update call;
    ' bubbletea copies the Model in/out so it's harmless after that.
    ' _dlg* fields are written by View when a dialog overlay renders;
    ' Update reads them to hit-test clicks against the dialog's actual
    ' on-screen rect.
    ' _currentModel lets no-arg user handlers (_Click / _Change /
    ' _Close / _Select) mutate model state; needed whenever such a
    ' handler might want to (dialogs, and Menubar _Select).
    IF hasDialog OR hasMenubar THEN
        s = s + "DIM _currentModel AS POINTER TO Model\n"
    END IF
    IF hasDialog THEN
        s = s + "DIM _dlgX AS INTEGER\n"
        s = s + "DIM _dlgY AS INTEGER\n"
        s = s + "DIM _dlgW AS INTEGER\n"
        s = s + "DIM _dlgH AS INTEGER\n"
        s = s + "\n"
    END IF
    ' _mb* rect of the currently-open Menubar dropdown — written by
    ' View, read by Update's click hit-test (mirrors _dlg* for dialogs).
    ' _mbItemY is the screen row of the first dropdown item.
    IF hasMenubar THEN
        s = s + "DIM _mbX AS INTEGER\n"
        s = s + "DIM _mbItemY AS INTEGER\n"
        s = s + "DIM _mbW AS INTEGER\n"
        s = s + "DIM _mbN AS INTEGER\n"
        s = s + "\n"
    END IF
    s = s + "FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)\n"
    IF hasDialog OR hasMenubar THEN
        s = s + "    _currentModel = @m\n"
    END IF
    s = s + "    DIM sz AS tea.WindowSizeMsg\n"
    s = s + "    DIM szOk AS BOOLEAN\n"
    s = s + "    sz, szOk = msg.(tea.WindowSizeMsg)\n"
    s = s + "    IF szOk THEN\n"
    s = s + "        m.Width = sz.Width\n"
    s = s + "        m.Height = sz.Height\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"

    ' --- Dialog / open-menu priority — when a dialog is active or a
    '     Menubar dropdown is open, route keys there first (so e.g. Esc
    '     closes the menu instead of quitting). Dialog: Esc cancels;
    '     Tab/arrows cycle; Enter/Space commits. Menu: arrows navigate;
    '     Enter selects; Esc closes.
    IF hasDialog OR hasMenubar THEN
        s = s + "    DIM kpd AS tea.KeyPressMsg\n"
        s = s + "    DIM kpdOk AS BOOLEAN\n"
        s = s + "    kpd, kpdOk = msg.(tea.KeyPressMsg)\n"
        s = s + "    IF kpdOk THEN\n"
        s = s + "        DIM kpdK AS STRING = kpd.String()\n"
        DIM dlgUI AS INTEGER
        FOR dlgUI = 0 TO n - 1
            DIM dlgUW AS DesignWidget = f.Widgets[dlgUI]
            IF dlgUW.Kind = "Dialog" THEN
                DIM dlgUK AS STRING = dlgUW.DialogKind
                IF dlgUK = "" THEN dlgUK = "confirm"
                IF dlgUK = "input" THEN
                    ' Input-kind dialog. Two focus states:
                    ' OnField = TRUE  → typing / backspace edits Text;
                    '                    Tab moves focus to first button.
                    ' OnField = FALSE → Left/Right/Tab cycle OK/Cancel;
                    '                    Enter/Space commits with the
                    '                    focused button label; Shift+Tab
                    '                    from button #0 returns to field.
                    s = s + "        IF m." + dlgUW.Name + "_Active THEN\n"
                    s = s + "            IF kpdK = " + qt + "esc" + qt + " THEN\n"
                    s = s + "                m." + dlgUW.Name + "_Active = FALSE\n"
                    s = s + "                " + dlgUW.Name + "_Close(" + qt + qt + ", m." + dlgUW.Name + "_Text)\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    ' --- field-focused branch ---
                    s = s + "            IF m." + dlgUW.Name + "_OnField THEN\n"
                    s = s + "                IF kpdK = " + qt + "enter" + qt + " THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_Active = FALSE\n"
                    s = s + "                    " + dlgUW.Name + "_Close(" + qt + "OK" + qt + ", m." + dlgUW.Name + "_Text)\n"
                    s = s + "                    RETURN m, NIL\n"
                    s = s + "                END IF\n"
                    s = s + "                IF kpdK = " + qt + "tab" + qt + " OR kpdK = " + qt + "down" + qt + " THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_OnField = FALSE\n"
                    s = s + "                    m." + dlgUW.Name + "_Idx = 0\n"
                    s = s + "                    RETURN m, NIL\n"
                    s = s + "                END IF\n"
                    s = s + "                IF kpdK = " + qt + "backspace" + qt + " AND LEN(m." + dlgUW.Name + "_Text) > 0 THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_Text = Mid(m." + dlgUW.Name + "_Text, 1, LEN(m." + dlgUW.Name + "_Text) - 1)\n"
                    s = s + "                    RETURN m, NIL\n"
                    s = s + "                END IF\n"
                    s = s + "                IF kpdK = " + qt + "space" + qt + " THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_Text = m." + dlgUW.Name + "_Text + " + qt + " " + qt + "\n"
                    s = s + "                    RETURN m, NIL\n"
                    s = s + "                END IF\n"
                    s = s + "                IF LEN(kpdK) = 1 THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_Text = m." + dlgUW.Name + "_Text + kpdK\n"
                    s = s + "                    RETURN m, NIL\n"
                    s = s + "                END IF\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    ' --- button-focused branch ---
                    s = s + "            IF kpdK = " + qt + "shift+tab" + qt + " OR kpdK = " + qt + "up" + qt + " THEN\n"
                    s = s + "                IF m." + dlgUW.Name + "_Idx = 0 THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_OnField = TRUE\n"
                    s = s + "                ELSE\n"
                    s = s + "                    m." + dlgUW.Name + "_Idx = m." + dlgUW.Name + "_Idx - 1\n"
                    s = s + "                END IF\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "left" + qt + " THEN\n"
                    s = s + "                IF m." + dlgUW.Name + "_Idx > 0 THEN m." + dlgUW.Name + "_Idx = m." + dlgUW.Name + "_Idx - 1\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "right" + qt + " OR kpdK = " + qt + "tab" + qt + " THEN\n"
                    s = s + "                IF m." + dlgUW.Name + "_Idx < 1 THEN\n"
                    s = s + "                    m." + dlgUW.Name + "_Idx = m." + dlgUW.Name + "_Idx + 1\n"
                    s = s + "                ELSE\n"
                    s = s + "                    m." + dlgUW.Name + "_OnField = TRUE\n"
                    s = s + "                    m." + dlgUW.Name + "_Idx = 0\n"
                    s = s + "                END IF\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "enter" + qt + " OR kpdK = " + qt + "space" + qt + " THEN\n"
                    s = s + "                DIM picked" + dlgUW.Name + " AS STRING = " + qt + "OK" + qt + "\n"
                    s = s + "                IF m." + dlgUW.Name + "_Idx = 1 THEN picked" + dlgUW.Name + " = " + qt + "Cancel" + qt + "\n"
                    s = s + "                m." + dlgUW.Name + "_Active = FALSE\n"
                    s = s + "                " + dlgUW.Name + "_Close(picked" + dlgUW.Name + ", m." + dlgUW.Name + "_Text)\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            RETURN m, NIL\n"
                    s = s + "        END IF\n"
                ELSE
                    ' Confirm-kind dialog (existing behavior).
                    DIM nB AS INTEGER = LEN(dlgUW.Items)
                    IF nB = 0 THEN nB = 1
                    DIM nBStr AS STRING = strconv.Itoa(nB)
                    DIM nBm1 AS STRING = strconv.Itoa(nB - 1)
                    s = s + "        IF m." + dlgUW.Name + "_Active THEN\n"
                    s = s + "            IF kpdK = " + qt + "esc" + qt + " THEN\n"
                    s = s + "                m." + dlgUW.Name + "_Active = FALSE\n"
                    s = s + "                " + dlgUW.Name + "_Close(" + qt + qt + ")\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "left" + qt + " OR kpdK = " + qt + "shift+tab" + qt + " THEN\n"
                    s = s + "                m." + dlgUW.Name + "_Idx = m." + dlgUW.Name + "_Idx - 1\n"
                    s = s + "                IF m." + dlgUW.Name + "_Idx < 0 THEN m." + dlgUW.Name + "_Idx = " + nBm1 + "\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "right" + qt + " OR kpdK = " + qt + "tab" + qt + " THEN\n"
                    s = s + "                m." + dlgUW.Name + "_Idx = (m." + dlgUW.Name + "_Idx + 1) MOD " + nBStr + "\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    s = s + "            IF kpdK = " + qt + "enter" + qt + " OR kpdK = " + qt + "space" + qt + " THEN\n"
                    s = s + "                DIM picked" + dlgUW.Name + " AS STRING = " + qt + qt + "\n"
                    DIM bIdx AS INTEGER
                    FOR bIdx = 0 TO LEN(dlgUW.Items) - 1
                        s = s + "                IF m." + dlgUW.Name + "_Idx = " + strconv.Itoa(bIdx) + " THEN picked" + dlgUW.Name + " = " + qt + escapeForDBString(dlgUW.Items[bIdx]) + qt + "\n"
                    NEXT bIdx
                    s = s + "                m." + dlgUW.Name + "_Active = FALSE\n"
                    s = s + "                " + dlgUW.Name + "_Close(picked" + dlgUW.Name + ")\n"
                    s = s + "                RETURN m, NIL\n"
                    s = s + "            END IF\n"
                    ' Swallow other keys while this dialog is up.
                    s = s + "            RETURN m, NIL\n"
                    s = s + "        END IF\n"
                END IF
            END IF
        NEXT dlgUI
        ' Open-menu key handling (modal while a dropdown is showing).
        DIM mbKI AS INTEGER
        FOR mbKI = 0 TO n - 1
            DIM mbKW AS DesignWidget = f.Widgets[mbKI]
            IF mbKW.Kind = "Menubar" THEN
                DIM mbKn AS STRING = mbKW.Name
                DIM mbKc AS INTEGER = menubarMenuCount(mbKW.Items)
                DIM mbKcm1 AS STRING = strconv.Itoa(mbKc - 1)
                s = s + "        IF m." + mbKn + "_Open THEN\n"
                s = s + "            IF kpdK = " + qt + "esc" + qt + " THEN\n"
                s = s + "                m." + mbKn + "_Open = FALSE\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "            IF kpdK = " + qt + "up" + qt + " THEN\n"
                s = s + "                IF m." + mbKn + "_Item > 0 THEN m." + mbKn + "_Item = m." + mbKn + "_Item - 1\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "            IF kpdK = " + qt + "down" + qt + " THEN\n"
                s = s + "                DIM mbMx" + mbKn + " AS INTEGER = 0\n"
                DIM mbKk AS INTEGER
                FOR mbKk = 0 TO mbKc - 1
                    DIM mbKcnt AS INTEGER = LEN(menubarItemsAt(mbKW.Items, mbKk))
                    s = s + "                IF m." + mbKn + "_Active = " + strconv.Itoa(mbKk) + " THEN mbMx" + mbKn + " = " + strconv.Itoa(mbKcnt - 1) + "\n"
                NEXT mbKk
                s = s + "                IF m." + mbKn + "_Item < mbMx" + mbKn + " THEN m." + mbKn + "_Item = m." + mbKn + "_Item + 1\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "            IF kpdK = " + qt + "left" + qt + " THEN\n"
                s = s + "                IF m." + mbKn + "_Active > 0 THEN\n"
                s = s + "                    m." + mbKn + "_Active = m." + mbKn + "_Active - 1\n"
                s = s + "                    m." + mbKn + "_Item = 0\n"
                s = s + "                END IF\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "            IF kpdK = " + qt + "right" + qt + " THEN\n"
                s = s + "                IF m." + mbKn + "_Active < " + mbKcm1 + " THEN\n"
                s = s + "                    m." + mbKn + "_Active = m." + mbKn + "_Active + 1\n"
                s = s + "                    m." + mbKn + "_Item = 0\n"
                s = s + "                END IF\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "            IF kpdK = " + qt + "enter" + qt + " OR kpdK = " + qt + "space" + qt + " THEN\n"
                s = s + "                DIM mbPick" + mbKn + " AS STRING = " + qt + qt + "\n"
                FOR mbKk = 0 TO mbKc - 1
                    DIM mbKits AS []STRING = menubarItemsAt(mbKW.Items, mbKk)
                    DIM mbKj AS INTEGER
                    FOR mbKj = 0 TO LEN(mbKits) - 1
                        s = s + "                IF m." + mbKn + "_Active = " + strconv.Itoa(mbKk) + " AND m." + mbKn + "_Item = " + strconv.Itoa(mbKj) + " THEN mbPick" + mbKn + " = " + qt + escapeForDBString(mbKits[mbKj]) + qt + "\n"
                    NEXT mbKj
                NEXT mbKk
                s = s + "                m." + mbKn + "_Open = FALSE\n"
                s = s + "                " + mbKn + "_Select(mbPick" + mbKn + ")\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                ' Swallow any other key while the menu is open.
                s = s + "            RETURN m, NIL\n"
                s = s + "        END IF\n"
            END IF
        NEXT mbKI
        s = s + "    END IF\n"
    END IF
    ' --- Mouse click hit-test — back-to-front so a later (drawn-on-
    '     top) widget wins. Each kind reacts the way its keyboard
    '     handler does, focus follows the click. Hit-test box uses
    '     the design (X, Y, W, H) which matches what the user sees
    '     and was already used for the drag/select in DBtui.
    s = s + "    DIM mc AS tea.MouseClickMsg\n"
    s = s + "    DIM mcOk AS BOOLEAN\n"
    s = s + "    mc, mcOk = msg.(tea.MouseClickMsg)\n"
    s = s + "    IF mcOk AND mc.Button = tea.MouseLeft THEN\n"
    ' Dialog priority — hit-test the active dialog's ✕ glyph + button
    ' row in modal-local coords. Other clicks inside the dialog rect
    ' are swallowed; clicks outside fall through to the widget hit-
    ' tests below (so a stray click outside doesn't get blocked).
    IF hasDialog THEN
        DIM dcI AS INTEGER
        FOR dcI = 0 TO n - 1
            DIM dcW AS DesignWidget = f.Widgets[dcI]
            IF dcW.Kind = "Dialog" THEN
                DIM dcK AS STRING = dcW.DialogKind
                IF dcK = "" THEN dcK = "confirm"
                ' Per-kind button-row layout:
                '   confirm:  body row only → buttons at ly = 4.
                '   input:    prompt + field rows → buttons at ly = 6.
                DIM dcBtnLy AS INTEGER = 4
                IF dcK = "input" THEN dcBtnLy = 6
                ' Effective button list — confirm uses w.Items, input
                ' is hard-coded to OK/Cancel.
                DIM dcItems AS []STRING = dcW.Items
                IF dcK = "input" THEN
                    DIM dcReset AS []STRING
                    dcItems = dcReset
                    dcItems = APPEND(dcItems, "OK")
                    dcItems = APPEND(dcItems, "Cancel")
                END IF
                DIM dcN AS INTEGER = LEN(dcItems)
                IF dcN = 0 THEN dcN = 1
                s = s + "        IF m." + dcW.Name + "_Active AND _dlgW > 0 THEN\n"
                s = s + "            DIM lx" + dcW.Name + " AS INTEGER = mc.X - _dlgX\n"
                s = s + "            DIM ly" + dcW.Name + " AS INTEGER = mc.Y - _dlgY\n"
                s = s + "            IF lx" + dcW.Name + " >= 0 AND ly" + dcW.Name + " >= 0 AND lx" + dcW.Name + " < _dlgW AND ly" + dcW.Name + " < _dlgH THEN\n"
                ' ✕ close glyph on the hand-rolled top border
                ' (relative Y=0). Glyph sits at col totalW-3 (one
                ' space + ✕ + space + ╮); accept a 2-cell hit zone
                ' covering the leading space + glyph itself.
                s = s + "                IF ly" + dcW.Name + " = 0 AND (lx" + dcW.Name + " = _dlgW - 3 OR lx" + dcW.Name + " = _dlgW - 4) THEN\n"
                s = s + "                    m." + dcW.Name + "_Active = FALSE\n"
                IF dcK = "input" THEN
                    s = s + "                    " + dcW.Name + "_Close(" + qt + qt + ", m." + dcW.Name + "_Text)\n"
                ELSE
                    s = s + "                    " + dcW.Name + "_Close(" + qt + qt + ")\n"
                END IF
                s = s + "                    RETURN m, NIL\n"
                s = s + "                END IF\n"
                ' Button row hit-test — row depends on dialog kind.
                ' Right-justified button X positions come from the
                ' static button labels (same math as fdRender*).
                s = s + "                IF ly" + dcW.Name + " = " + strconv.Itoa(dcBtnLy) + " THEN\n"
                s = s + "                    DIM btnW" + dcW.Name + " AS []INTEGER\n"
                s = s + "                    DIM btnT" + dcW.Name + " AS INTEGER = 0\n"
                DIM dcBi AS INTEGER
                FOR dcBi = 0 TO LEN(dcItems) - 1
                    DIM bWid AS INTEGER = lipgloss.Width("[ " + dcItems[dcBi] + " ]")
                    s = s + "                    btnW" + dcW.Name + " = APPEND(btnW" + dcW.Name + ", " + strconv.Itoa(bWid) + ")\n"
                    s = s + "                    btnT" + dcW.Name + " = btnT" + dcW.Name + " + " + strconv.Itoa(bWid) + "\n"
                    IF dcBi < LEN(dcItems) - 1 THEN
                        s = s + "                    btnT" + dcW.Name + " = btnT" + dcW.Name + " + 2\n"
                    END IF
                NEXT dcBi
                s = s + "                    DIM innerDW" + dcW.Name + " AS INTEGER = _dlgW - 6\n"
                s = s + "                    DIM padD" + dcW.Name + " AS INTEGER = innerDW" + dcW.Name + " - btnT" + dcW.Name + "\n"
                s = s + "                    IF padD" + dcW.Name + " < 0 THEN padD" + dcW.Name + " = 0\n"
                s = s + "                    DIM bxD" + dcW.Name + " AS INTEGER = 3 + padD" + dcW.Name + "\n"
                s = s + "                    DIM bkD" + dcW.Name + " AS INTEGER\n"
                s = s + "                    FOR bkD" + dcW.Name + " = 0 TO LEN(btnW" + dcW.Name + ") - 1\n"
                s = s + "                        IF lx" + dcW.Name + " >= bxD" + dcW.Name + " AND lx" + dcW.Name + " < bxD" + dcW.Name + " + btnW" + dcW.Name + "[bkD" + dcW.Name + "] THEN\n"
                s = s + "                            DIM clickedLbl" + dcW.Name + " AS STRING = " + qt + qt + "\n"
                FOR dcBi = 0 TO LEN(dcItems) - 1
                    s = s + "                            IF bkD" + dcW.Name + " = " + strconv.Itoa(dcBi) + " THEN clickedLbl" + dcW.Name + " = " + qt + escapeForDBString(dcItems[dcBi]) + qt + "\n"
                NEXT dcBi
                s = s + "                            m." + dcW.Name + "_Active = FALSE\n"
                IF dcK = "input" THEN
                    s = s + "                            " + dcW.Name + "_Close(clickedLbl" + dcW.Name + ", m." + dcW.Name + "_Text)\n"
                ELSE
                    s = s + "                            " + dcW.Name + "_Close(clickedLbl" + dcW.Name + ")\n"
                END IF
                s = s + "                            RETURN m, NIL\n"
                s = s + "                        END IF\n"
                s = s + "                        bxD" + dcW.Name + " = bxD" + dcW.Name + " + btnW" + dcW.Name + "[bkD" + dcW.Name + "] + 2\n"
                s = s + "                    NEXT bkD" + dcW.Name + "\n"
                s = s + "                END IF\n"
                ' Input-kind: click on the text-field row puts focus
                ' on the field. Field sits at ly = 4 (top border +
                ' top pad + prompt + spacer + field).
                IF dcK = "input" THEN
                    s = s + "                IF ly" + dcW.Name + " = 4 THEN m." + dcW.Name + "_OnField = TRUE\n"
                END IF
                ' Click inside dialog but not on hot spot — swallow.
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "        END IF\n"
            END IF
        NEXT dcI
    END IF
    ' Open-menu dropdown-item click priority — hit-test against the
    ' _mb* rect stashed by View (the open dropdown's on-screen box).
    IF hasMenubar THEN
        DIM mbMI AS INTEGER
        FOR mbMI = 0 TO n - 1
            DIM mbMW AS DesignWidget = f.Widgets[mbMI]
            IF mbMW.Kind = "Menubar" THEN
                DIM mbMn AS STRING = mbMW.Name
                s = s + "        IF m." + mbMn + "_Open AND _mbN > 0 THEN\n"
                s = s + "            DIM mbCY" + mbMn + " AS INTEGER = mc.Y - _mbItemY\n"
                s = s + "            IF mc.X >= _mbX AND mc.X < _mbX + _mbW AND mbCY" + mbMn + " >= 0 AND mbCY" + mbMn + " < _mbN THEN\n"
                s = s + "                m." + mbMn + "_Item = mbCY" + mbMn + "\n"
                s = s + "                DIM mbCPick" + mbMn + " AS STRING = " + qt + qt + "\n"
                DIM mbMc AS INTEGER = menubarMenuCount(mbMW.Items)
                DIM mbMk AS INTEGER
                FOR mbMk = 0 TO mbMc - 1
                    DIM mbMits AS []STRING = menubarItemsAt(mbMW.Items, mbMk)
                    DIM mbMj AS INTEGER
                    FOR mbMj = 0 TO LEN(mbMits) - 1
                        s = s + "                IF m." + mbMn + "_Active = " + strconv.Itoa(mbMk) + " AND m." + mbMn + "_Item = " + strconv.Itoa(mbMj) + " THEN mbCPick" + mbMn + " = " + qt + escapeForDBString(mbMits[mbMj]) + qt + "\n"
                    NEXT mbMj
                NEXT mbMk
                s = s + "                m." + mbMn + "_Open = FALSE\n"
                s = s + "                " + mbMn + "_Select(mbCPick" + mbMn + ")\n"
                s = s + "                RETURN m, NIL\n"
                s = s + "            END IF\n"
                s = s + "        END IF\n"
            END IF
        NEXT mbMI
    END IF
    ' DBasic identifiers are case-insensitive AND codegen hoists
    ' DIMs to function-scope, so every new local in this generator
    ' has to dodge collisions with the other loops above (mi/mw in
    ' Main-init, di/dw in dispatchClick, etc.). Prefixing with "mc"
    ' for "mouse-click" keeps everything distinct.
    DIM mci AS INTEGER
    FOR mci = n - 1 TO 0 STEP 0 - 1
        DIM mcw AS DesignWidget = f.Widgets[mci]
        DIM mcXs AS STRING = strconv.Itoa(mcw.X)
        DIM mcYs AS STRING = strconv.Itoa(mcw.Y)
        DIM mcWs AS STRING = strconv.Itoa(mcw.W)
        DIM mcHs AS STRING = strconv.Itoa(mcw.H)
        DIM mcIStr AS STRING = strconv.Itoa(mci)
      IF mcw.Parent = "" THEN
        s = s + "        IF mc.X >= " + mcXs + " AND mc.X < " + mcXs + " + " + mcWs + " AND mc.Y >= " + mcYs + " AND mc.Y < " + mcYs + " + " + mcHs + " THEN\n"
        s = s + "            m.Focus = " + mcIStr + "\n"
        IF mcw.Kind = "Button" THEN
            s = s + buttonEmitMouse(mcw, qt)
        ELSEIF mcw.Kind = "Checkbox" THEN
            s = s + checkboxEmitMouse(mcw, qt)
        ELSEIF mcw.Kind = "RadioButton" THEN
            s = s + radioButtonEmitMouse(mcw, mci, f.Widgets, n, qt)
        ELSEIF mcw.Kind = "ComboBox" THEN
            s = s + comboBoxEmitMouse(mcw, qt)
        ELSEIF mcw.Kind = "ListBox" THEN
            s = s + listBoxEmitMouse(mcw, mcIStr, mcYs, qt)
        ELSEIF mcw.Kind = "ScrollBar" THEN
            s = s + scrollBarEmitMouse(mcw, mcIStr, mcXs, mcYs, mcWs, mcHs, qt)
        ELSEIF mcw.Kind = "PropGrid" THEN
            ' Click row N selects it (if it exists), firing _Change.
            DIM mcGridN AS STRING = strconv.Itoa(LEN(mcw.Items))
            IF LEN(mcw.Items) > 0 THEN
                s = s + "            DIM mcGRow" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
                s = s + "            IF mcGRow" + mcIStr + " >= 0 AND mcGRow" + mcIStr + " < " + mcGridN + " THEN\n"
                s = s + "                m." + mcw.Name + "_Val = mcGRow" + mcIStr + "\n"
                s = s + "                dispatchChange(" + qt + mcw.Name + qt + ")\n"
                s = s + "            END IF\n"
            END IF
        ELSEIF mcw.Kind = "Menubar" THEN
            ' Title-row click: pick the menu by column. Clicking the
            ' already-open active menu closes it; otherwise open it.
            s = s + "            DIM mbTX" + mcIStr + " AS INTEGER = mc.X - " + mcXs + "\n"
            DIM mbWi AS INTEGER = menubarMenuCount(mcw.Items)
            DIM mbWcol AS INTEGER = 0
            DIM mbWk AS INTEGER
            FOR mbWk = 0 TO mbWi - 1
                DIM mbWtitle AS STRING = menubarTitleAt(mcw.Items, mbWk)
                DIM mbWw AS INTEGER = lipgloss.Width(mbWtitle) + 2
                s = s + "            IF mbTX" + mcIStr + " >= " + strconv.Itoa(mbWcol) + " AND mbTX" + mcIStr + " < " + strconv.Itoa(mbWcol + mbWw) + " THEN\n"
                s = s + "                IF m." + mcw.Name + "_Open AND m." + mcw.Name + "_Active = " + strconv.Itoa(mbWk) + " THEN\n"
                s = s + "                    m." + mcw.Name + "_Open = FALSE\n"
                s = s + "                ELSE\n"
                s = s + "                    m." + mcw.Name + "_Active = " + strconv.Itoa(mbWk) + "\n"
                s = s + "                    m." + mcw.Name + "_Open = TRUE\n"
                s = s + "                    m." + mcw.Name + "_Item = 0\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                mbWcol = mbWcol + mbWw
            NEXT mbWk
        ELSEIF mcw.Kind = "ScrollPanel" THEN
            ' Click the ▲ row (relative Y = 1) scrolls up; the ▼ row
            ' (relative Y = H-2) scrolls down.
            DIM spcVis AS INTEGER = mcw.H - 2
            IF spcVis < 1 THEN spcVis = 1
            DIM spcMax AS INTEGER = LEN(mcw.Items) - spcVis
            IF spcMax < 0 THEN spcMax = 0
            s = s + "            DIM spRel" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
            s = s + "            IF spRel" + mcIStr + " = 1 AND m." + mcw.Name + "_Scroll > 0 THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll - 1\n"
            s = s + "            IF spRel" + mcIStr + " = " + strconv.Itoa(mcw.H - 2) + " AND m." + mcw.Name + "_Scroll < " + strconv.Itoa(spcMax) + " THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll + 1\n"
        ELSEIF mcw.Kind = "Tree" THEN
            ' Click maps the relative row to a VISIBLE node. Clicking a
            ' parent toggles its collapse; clicking a leaf moves the
            ' cursor and fires _Change.
            s = s + "            DIM tmRel" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
            s = s + "            DIM tmVis" + mcIStr + " AS []INTEGER = treeVisibleRows(" + mcw.Name + "_depths(), m." + mcw.Name + "_Collapsed)\n"
            s = s + "            IF tmRel" + mcIStr + " >= 0 AND tmRel" + mcIStr + " < LEN(tmVis" + mcIStr + ") THEN\n"
            s = s + "                DIM tmIdx" + mcIStr + " AS INTEGER = tmVis" + mcIStr + "[tmRel" + mcIStr + "]\n"
            s = s + "                m." + mcw.Name + "_Val = tmIdx" + mcIStr + "\n"
            s = s + "                IF " + mcw.Name + "_isParent(tmIdx" + mcIStr + ") THEN\n"
            s = s + "                    IF tmIdx" + mcIStr + " < LEN(m." + mcw.Name + "_Collapsed) THEN m." + mcw.Name + "_Collapsed[tmIdx" + mcIStr + "] = NOT m." + mcw.Name + "_Collapsed[tmIdx" + mcIStr + "]\n"
            s = s + "                ELSE\n"
            s = s + "                    dispatchChange(" + qt + mcw.Name + qt + ")\n"
            s = s + "                END IF\n"
            s = s + "            END IF\n"
        ELSEIF mcw.Kind = "TabStrip" THEN
            s = s + tabStripEmitMouse(mcw, mcIStr, mcXs, mcYs, qt)
        ELSEIF mcw.Kind = "Panel" THEN
            ' Click the ▲ row (rel Y = 1) scrolls up; the ▼ row
            ' (rel Y = H-2) scrolls down.
            DIM pncVis AS INTEGER = mcw.H - 2
            IF pncVis < 1 THEN pncVis = 1
            DIM pncMax AS INTEGER = panelContentBottom(f.Widgets, mcw.Name) - (mcw.Y + 1) - pncVis
            IF pncMax < 0 THEN pncMax = 0
            s = s + "            DIM pnRel" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
            s = s + "            IF pnRel" + mcIStr + " = 1 AND m." + mcw.Name + "_Scroll > 0 THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll - 1\n"
            s = s + "            IF pnRel" + mcIStr + " = " + strconv.Itoa(mcw.H - 2) + " AND m." + mcw.Name + "_Scroll < " + strconv.Itoa(pncMax) + " THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll + 1\n"
        ELSE
            ' Label / TextInput / ProgressBar: focus follows the
            ' click but no state change. (TextInput Tier 2.)
            s = s + "            _ = mc\n"
        END IF
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
      END IF
    NEXT mci
    s = s + "    END IF\n"
    s = s + "    DIM k AS tea.KeyPressMsg\n"
    s = s + "    DIM kOk AS BOOLEAN\n"
    s = s + "    k, kOk = msg.(tea.KeyPressMsg)\n"
    s = s + "    IF kOk THEN\n"
    s = s + "        DIM key AS STRING = k.String()\n"
    s = s + "        IF key = " + qt + "ctrl+c" + qt + " OR key = " + qt + "esc" + qt + " THEN RETURN m, tea.Quit\n"
    IF n > 0 THEN
        s = s + "        IF key = " + qt + "tab" + qt + " THEN\n"
        s = s + "            m.Focus = (m.Focus + 1) MOD " + nStr + "\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        s = s + "        IF key = " + qt + "shift+tab" + qt + " THEN\n"
        s = s + "            m.Focus = m.Focus - 1\n"
        s = s + "            IF m.Focus < 0 THEN m.Focus = " + strconv.Itoa(n - 1) + "\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        ' Per-widget key handling.
        FOR i = 0 TO n - 1
            DIM ww AS DesignWidget = f.Widgets[i]
            DIM iStr AS STRING = strconv.Itoa(i)
          IF ww.Parent = "" THEN
            s = s + "        IF m.Focus = " + iStr + " THEN\n"
            IF ww.Kind = "TextInput" THEN
                s = s + textInputEmitKey(ww, qt)
            ELSEIF ww.Kind = "TextArea" THEN
                ' Full cursor editing. _Cur is a byte offset into _Val;
                ' inserts/deletes happen at the cursor and arrows/Home/
                ' End/Up/Down move it (helpers taLineHome/taLineEnd/
                ' taMoveVert below). Byte-based — exact for ASCII.
                DIM tan AS STRING = ww.Name
                ' Insert a printable char at the cursor.
                s = s + "            IF LEN(key) = 1 THEN\n"
                s = s + "                m." + tan + "_Val = Mid(m." + tan + "_Val, 1, m." + tan + "_Cur) + key + Mid(m." + tan + "_Val, m." + tan + "_Cur + 1, LEN(m." + tan + "_Val) - m." + tan + "_Cur)\n"
                s = s + "                m." + tan + "_Cur = m." + tan + "_Cur + 1\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "space" + qt + " THEN\n"
                s = s + "                m." + tan + "_Val = Mid(m." + tan + "_Val, 1, m." + tan + "_Cur) + " + qt + " " + qt + " + Mid(m." + tan + "_Val, m." + tan + "_Cur + 1, LEN(m." + tan + "_Val) - m." + tan + "_Cur)\n"
                s = s + "                m." + tan + "_Cur = m." + tan + "_Cur + 1\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "enter" + qt + " THEN\n"
                s = s + "                m." + tan + "_Val = Mid(m." + tan + "_Val, 1, m." + tan + "_Cur) + " + qt + "\\n" + qt + " + Mid(m." + tan + "_Val, m." + tan + "_Cur + 1, LEN(m." + tan + "_Val) - m." + tan + "_Cur)\n"
                s = s + "                m." + tan + "_Cur = m." + tan + "_Cur + 1\n"
                s = s + "            END IF\n"
                ' Backspace deletes the char before the cursor.
                s = s + "            IF key = " + qt + "backspace" + qt + " AND m." + tan + "_Cur > 0 THEN\n"
                s = s + "                m." + tan + "_Val = Mid(m." + tan + "_Val, 1, m." + tan + "_Cur - 1) + Mid(m." + tan + "_Val, m." + tan + "_Cur + 1, LEN(m." + tan + "_Val) - m." + tan + "_Cur)\n"
                s = s + "                m." + tan + "_Cur = m." + tan + "_Cur - 1\n"
                s = s + "            END IF\n"
                ' Delete removes the char under the cursor.
                s = s + "            IF key = " + qt + "delete" + qt + " AND m." + tan + "_Cur < LEN(m." + tan + "_Val) THEN\n"
                s = s + "                m." + tan + "_Val = Mid(m." + tan + "_Val, 1, m." + tan + "_Cur) + Mid(m." + tan + "_Val, m." + tan + "_Cur + 2, LEN(m." + tan + "_Val) - m." + tan + "_Cur - 1)\n"
                s = s + "            END IF\n"
                ' Movement.
                s = s + "            IF key = " + qt + "left" + qt + " AND m." + tan + "_Cur > 0 THEN m." + tan + "_Cur = m." + tan + "_Cur - 1\n"
                s = s + "            IF key = " + qt + "right" + qt + " AND m." + tan + "_Cur < LEN(m." + tan + "_Val) THEN m." + tan + "_Cur = m." + tan + "_Cur + 1\n"
                s = s + "            IF key = " + qt + "home" + qt + " THEN m." + tan + "_Cur = taLineHome(m." + tan + "_Val, m." + tan + "_Cur)\n"
                s = s + "            IF key = " + qt + "end" + qt + " THEN m." + tan + "_Cur = taLineEnd(m." + tan + "_Val, m." + tan + "_Cur)\n"
                s = s + "            IF key = " + qt + "up" + qt + " THEN m." + tan + "_Cur = taMoveVert(m." + tan + "_Val, m." + tan + "_Cur, 0 - 1)\n"
                s = s + "            IF key = " + qt + "down" + qt + " THEN m." + tan + "_Cur = taMoveVert(m." + tan + "_Val, m." + tan + "_Cur, 1)\n"
            ELSEIF ww.Kind = "Checkbox" THEN
                s = s + checkboxEmitKey(ww, qt)
            ELSEIF ww.Kind = "RadioButton" THEN
                s = s + radioButtonEmitKey(ww, i, f.Widgets, n, qt)
            ELSEIF ww.Kind = "ComboBox" OR ww.Kind = "ListBox" THEN
                s = s + comboListEmitKey(ww, qt)
            ELSEIF ww.Kind = "ScrollBar" THEN
                s = s + scrollBarEmitKey(ww, qt)
            ELSEIF ww.Kind = "TabStrip" THEN
                s = s + tabStripEmitKey(ww, qt)
            ELSEIF ww.Kind = "PropGrid" THEN
                ' Up/Down move the row cursor (firing _Change); Enter/
                ' Space activates the current row (also _Change).
                DIM nGridStr AS STRING = strconv.Itoa(LEN(ww.Items))
                s = s + "            IF key = " + qt + "up" + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val > 0 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val - 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "down" + qt + " THEN\n"
                s = s + "                IF m." + ww.Name + "_Val < " + nGridStr + " - 1 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val + 1\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN dispatchChange(" + qt + ww.Name + qt + ")\n"
            ELSEIF ww.Kind = "Menubar" THEN
                ' Closed-state keys (the open dropdown is handled in the
                ' priority block above). Left/Right move the active menu;
                ' Down / Enter / Space open it.
                DIM mbCloseCount AS INTEGER = menubarMenuCount(ww.Items)
                DIM mbCloseM1 AS STRING = strconv.Itoa(mbCloseCount - 1)
                s = s + "            IF key = " + qt + "left" + qt + " AND m." + ww.Name + "_Active > 0 THEN m." + ww.Name + "_Active = m." + ww.Name + "_Active - 1\n"
                s = s + "            IF key = " + qt + "right" + qt + " AND m." + ww.Name + "_Active < " + mbCloseM1 + " THEN m." + ww.Name + "_Active = m." + ww.Name + "_Active + 1\n"
                s = s + "            IF key = " + qt + "down" + qt + " OR key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Open = TRUE\n"
                s = s + "                m." + ww.Name + "_Item = 0\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "ScrollPanel" THEN
                ' Scroll the viewport. maxScroll is fixed at codegen time
                ' from the line count and visible height.
                DIM spVis AS INTEGER = ww.H - 2
                IF spVis < 1 THEN spVis = 1
                DIM spMax AS INTEGER = LEN(ww.Items) - spVis
                IF spMax < 0 THEN spMax = 0
                DIM spMaxStr AS STRING = strconv.Itoa(spMax)
                DIM spVisStr AS STRING = strconv.Itoa(spVis)
                s = s + "            IF key = " + qt + "up" + qt + " AND m." + ww.Name + "_Scroll > 0 THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll - 1\n"
                s = s + "            IF key = " + qt + "down" + qt + " AND m." + ww.Name + "_Scroll < " + spMaxStr + " THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll + 1\n"
                s = s + "            IF key = " + qt + "pgup" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll - " + spVisStr + "\n"
                s = s + "                IF m." + ww.Name + "_Scroll < 0 THEN m." + ww.Name + "_Scroll = 0\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "pgdown" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll + " + spVisStr + "\n"
                s = s + "                IF m." + ww.Name + "_Scroll > " + spMaxStr + " THEN m." + ww.Name + "_Scroll = " + spMaxStr + "\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "home" + qt + " THEN m." + ww.Name + "_Scroll = 0\n"
                s = s + "            IF key = " + qt + "end" + qt + " THEN m." + ww.Name + "_Scroll = " + spMaxStr + "\n"
            ELSEIF ww.Kind = "Tree" THEN
                ' Up/Down move the cursor among VISIBLE nodes (skipping
                ' anything under a collapsed parent), firing _Change.
                ' Enter/Space toggles collapse on a parent node, or fires
                ' _Change on a leaf (activate).
                s = s + "            DIM tkVis" + ww.Name + " AS []INTEGER = treeVisibleRows(" + ww.Name + "_depths(), m." + ww.Name + "_Collapsed)\n"
                s = s + "            DIM tkPos" + ww.Name + " AS INTEGER = 0\n"
                s = s + "            DIM tkI" + ww.Name + " AS INTEGER\n"
                s = s + "            FOR tkI" + ww.Name + " = 0 TO LEN(tkVis" + ww.Name + ") - 1\n"
                s = s + "                IF tkVis" + ww.Name + "[tkI" + ww.Name + "] = m." + ww.Name + "_Val THEN tkPos" + ww.Name + " = tkI" + ww.Name + "\n"
                s = s + "            NEXT tkI" + ww.Name + "\n"
                s = s + "            IF key = " + qt + "up" + qt + " THEN\n"
                s = s + "                IF tkPos" + ww.Name + " > 0 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = tkVis" + ww.Name + "[tkPos" + ww.Name + " - 1]\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "down" + qt + " THEN\n"
                s = s + "                IF tkPos" + ww.Name + " < LEN(tkVis" + ww.Name + ") - 1 THEN\n"
                s = s + "                    m." + ww.Name + "_Val = tkVis" + ww.Name + "[tkPos" + ww.Name + " + 1]\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN\n"
                s = s + "                IF " + ww.Name + "_isParent(m." + ww.Name + "_Val) THEN\n"
                s = s + "                    IF m." + ww.Name + "_Val < LEN(m." + ww.Name + "_Collapsed) THEN m." + ww.Name + "_Collapsed[m." + ww.Name + "_Val] = NOT m." + ww.Name + "_Collapsed[m." + ww.Name + "_Val]\n"
                s = s + "                ELSE\n"
                s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            ELSEIF ww.Kind = "Button" THEN
                s = s + buttonEmitKey(ww, qt)
            ELSEIF ww.Kind = "Panel" THEN
                ' Scroll the child viewport. maxScroll comes from the
                ' lowest child extent vs the visible height.
                DIM pnVisK AS INTEGER = ww.H - 2
                IF pnVisK < 1 THEN pnVisK = 1
                DIM pnMaxK AS INTEGER = panelContentBottom(f.Widgets, ww.Name) - (ww.Y + 1) - pnVisK
                IF pnMaxK < 0 THEN pnMaxK = 0
                DIM pnMaxKStr AS STRING = strconv.Itoa(pnMaxK)
                DIM pnVisKStr AS STRING = strconv.Itoa(pnVisK)
                s = s + "            IF key = " + qt + "up" + qt + " AND m." + ww.Name + "_Scroll > 0 THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll - 1\n"
                s = s + "            IF key = " + qt + "down" + qt + " AND m." + ww.Name + "_Scroll < " + pnMaxKStr + " THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll + 1\n"
                s = s + "            IF key = " + qt + "pgup" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll - " + pnVisKStr + "\n"
                s = s + "                IF m." + ww.Name + "_Scroll < 0 THEN m." + ww.Name + "_Scroll = 0\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "pgdown" + qt + " THEN\n"
                s = s + "                m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll + " + pnVisKStr + "\n"
                s = s + "                IF m." + ww.Name + "_Scroll > " + pnMaxKStr + " THEN m." + ww.Name + "_Scroll = " + pnMaxKStr + "\n"
                s = s + "            END IF\n"
                s = s + "            IF key = " + qt + "home" + qt + " THEN m." + ww.Name + "_Scroll = 0\n"
                s = s + "            IF key = " + qt + "end" + qt + " THEN m." + ww.Name + "_Scroll = " + pnMaxKStr + "\n"
            ELSE
                ' Label / ProgressBar / others: no state changes.
                s = s + "            _ = key\n"
            END IF
            s = s + "            RETURN m, NIL\n"
            s = s + "        END IF\n"
          END IF
        NEXT i
    END IF
    s = s + "    END IF\n"
    s = s + "    RETURN m, NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- View: paint canvas + widgets at their (X,Y); focused gets > -
    s = s + "FUNCTION (m AS Model) View() AS tea.View\n"
    s = s + "    DIM w AS INTEGER = m.Width\n"
    s = s + "    DIM h AS INTEGER = m.Height\n"
    s = s + "    IF w < 60 THEN w = 80\n"
    s = s + "    IF h < 20 THEN h = 24\n"
    s = s + "    DIM rows AS []STRING\n"
    s = s + "    DIM r AS INTEGER\n"
    s = s + "    FOR r = 0 TO h - 2\n"
    s = s + "        rows = APPEND(rows, strings.Repeat(" + qt + " " + qt + ", w))\n"
    s = s + "    NEXT r\n"
    FOR i = 0 TO n - 1
        DIM wv  AS DesignWidget = f.Widgets[i]
        DIM xs  AS STRING = strconv.Itoa(wv.X)
        DIM ys  AS STRING = strconv.Itoa(wv.Y)
        DIM sfx AS STRING = strconv.Itoa(i)

        DIM isMulti AS BOOLEAN = (wv.Kind = "ListBox") OR (wv.Kind = "ScrollBar" AND strings.ToLower(wv.Orient) = "v")

        ' --- Multi-row kinds: emit a per-row paint loop and skip the
        '     single-row body+overlay path below. Children (Parent set)
        '     are skipped here — their Panel renders them.
      IF wv.Parent = "" THEN
        IF wv.Kind = "ListBox" THEN
            s = s + listBoxEmitView(wv, sfx, xs, ys, qt)
        ELSEIF wv.Kind = "ScrollBar" AND strings.ToLower(wv.Orient) = "v" THEN
            s = s + scrollBarEmitViewVert(wv, sfx, xs, ys, qt)
        ELSEIF wv.Kind = "TabStrip" THEN
            s = s + tabStripEmitView(wv, sfx, xs, ys, qt)
        ELSEIF wv.Kind = "Tree" THEN
            s = s + treeEmitView(wv, sfx, xs, ys, qt)
        ELSEIF wv.Kind = "TextArea" THEN
            ' Framed multi-line box. taRowCol maps the _Cur byte offset to
            ' a (row, col); the view scrolls vertically so the cursor row
            ' stays visible and draws a █ block at the cursor cell when
            ' focused. Padding uses lipgloss.Width so the right border
            ' lines up.
            DIM taInWStr AS STRING = strconv.Itoa(wv.W - 2)
            DIM taHStr AS STRING = strconv.Itoa(wv.H)
            DIM taVisStr AS STRING = strconv.Itoa(wv.H - 2)
            s = s + "    DIM taTop" + sfx + " AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + taInWStr + ") + " + qt + "┐" + qt + "\n"
            s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", taTop" + sfx + ")\n"
            s = s + "    DIM taLines" + sfx + " AS []STRING = strings.Split(m." + wv.Name + "_Val, " + qt + "\\n" + qt + ")\n"
            s = s + "    DIM taCRow" + sfx + " AS INTEGER\n"
            s = s + "    DIM taCCol" + sfx + " AS INTEGER\n"
            s = s + "    taCRow" + sfx + ", taCCol" + sfx + " = taRowCol(m." + wv.Name + "_Val, m." + wv.Name + "_Cur)\n"
            ' Scroll so the cursor row is in view (bottom-anchored once
            ' past the visible height).
            s = s + "    DIM taStart" + sfx + " AS INTEGER = 0\n"
            s = s + "    IF taCRow" + sfx + " >= " + taVisStr + " THEN taStart" + sfx + " = taCRow" + sfx + " - " + taVisStr + " + 1\n"
            s = s + "    DIM taRow" + sfx + " AS INTEGER\n"
            s = s + "    FOR taRow" + sfx + " = 0 TO " + taVisStr + " - 1\n"
            s = s + "        DIM taSrc" + sfx + " AS INTEGER = taStart" + sfx + " + taRow" + sfx + "\n"
            s = s + "        DIM taLn" + sfx + " AS STRING = " + qt + qt + "\n"
            s = s + "        IF taSrc" + sfx + " < LEN(taLines" + sfx + ") THEN taLn" + sfx + " = taLines" + sfx + "[taSrc" + sfx + "]\n"
            ' Draw the cursor block (overwrite the cell, or append at EOL).
            s = s + "        IF m.Focus = " + sfx + " AND taSrc" + sfx + " = taCRow" + sfx + " THEN\n"
            s = s + "            DIM taCp" + sfx + " AS INTEGER = taCCol" + sfx + "\n"
            s = s + "            IF taCp" + sfx + " >= LEN(taLn" + sfx + ") THEN\n"
            s = s + "                taLn" + sfx + " = taLn" + sfx + " + " + qt + "█" + qt + "\n"
            s = s + "            ELSE\n"
            s = s + "                taLn" + sfx + " = Mid(taLn" + sfx + ", 1, taCp" + sfx + ") + " + qt + "█" + qt + " + Mid(taLn" + sfx + ", taCp" + sfx + " + 2, LEN(taLn" + sfx + ") - taCp" + sfx + " - 1)\n"
            s = s + "            END IF\n"
            s = s + "        END IF\n"
            s = s + "        IF lipgloss.Width(taLn" + sfx + ") > " + taInWStr + " THEN taLn" + sfx + " = Mid(taLn" + sfx + ", 1, " + taInWStr + ")\n"
            s = s + "        IF lipgloss.Width(taLn" + sfx + ") < " + taInWStr + " THEN taLn" + sfx + " = taLn" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + taInWStr + " - lipgloss.Width(taLn" + sfx + "))\n"
            s = s + "        DIM taLine" + sfx + " AS STRING = " + qt + "│" + qt + " + taLn" + sfx + " + " + qt + "│" + qt + "\n"
            s = s + "        DIM taY" + sfx + " AS INTEGER = " + ys + " + 1 + taRow" + sfx + "\n"
            s = s + "        IF taY" + sfx + " >= 0 AND taY" + sfx + " < LEN(rows) THEN rows[taY" + sfx + "] = overlayRow(rows[taY" + sfx + "], " + xs + ", taLine" + sfx + ")\n"
            s = s + "    NEXT taRow" + sfx + "\n"
            s = s + "    DIM taBot" + sfx + " AS STRING = " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + taInWStr + ") + " + qt + "┘" + qt + "\n"
            s = s + "    DIM taBotY" + sfx + " AS INTEGER = " + ys + " + " + taHStr + " - 1\n"
            s = s + "    IF taBotY" + sfx + " >= 0 AND taBotY" + sfx + " < LEN(rows) THEN rows[taBotY" + sfx + "] = overlayRow(rows[taBotY" + sfx + "], " + xs + ", taBot" + sfx + ")\n"
        ELSEIF wv.Kind = "PropGrid" THEN
            ' Two-column key/value rows; the cursor row (reading
            ' <name>_Val) gets a ▶ marker. Keys padded to a half-width
            ' column via lipgloss.Width so the │ separator lines up.
            DIM gKeyWStr AS STRING = strconv.Itoa((wv.W - 4) / 2)
            IF (wv.W - 4) / 2 < 1 THEN gKeyWStr = "1"
            DIM gHStr AS STRING = strconv.Itoa(wv.H)
            s = s + "    DIM gKeys" + sfx + " AS []STRING\n"
            s = s + "    DIM gVals" + sfx + " AS []STRING\n"
            DIM gvI AS INTEGER
            FOR gvI = 0 TO LEN(wv.Items) - 1
                s = s + "    gKeys" + sfx + " = APPEND(gKeys" + sfx + ", " + qt + escapeForDBString(propKey(wv.Items[gvI])) + qt + ")\n"
                s = s + "    gVals" + sfx + " = APPEND(gVals" + sfx + ", " + qt + escapeForDBString(propVal(wv.Items[gvI])) + qt + ")\n"
            NEXT gvI
            s = s + "    DIM gRow" + sfx + " AS INTEGER\n"
            s = s + "    FOR gRow" + sfx + " = 0 TO " + gHStr + " - 1\n"
            s = s + "        IF gRow" + sfx + " < LEN(gKeys" + sfx + ") THEN\n"
            s = s + "            DIM gk" + sfx + " AS STRING = gKeys" + sfx + "[gRow" + sfx + "]\n"
            s = s + "            DIM gv" + sfx + " AS STRING = gVals" + sfx + "[gRow" + sfx + "]\n"
            s = s + "            IF lipgloss.Width(gk" + sfx + ") > " + gKeyWStr + " THEN gk" + sfx + " = Mid(gk" + sfx + ", 1, " + gKeyWStr + ")\n"
            s = s + "            IF lipgloss.Width(gk" + sfx + ") < " + gKeyWStr + " THEN gk" + sfx + " = gk" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + gKeyWStr + " - lipgloss.Width(gk" + sfx + "))\n"
            s = s + "            DIM gmk" + sfx + " AS STRING = " + qt + "  " + qt + "\n"
            s = s + "            IF gRow" + sfx + " = m." + wv.Name + "_Val THEN gmk" + sfx + " = " + qt + "▶ " + qt + "\n"
            s = s + "            DIM gLine" + sfx + " AS STRING = gmk" + sfx + " + gk" + sfx + " + " + qt + "│ " + qt + " + gv" + sfx + "\n"
            s = s + "            DIM gY" + sfx + " AS INTEGER = " + ys + " + gRow" + sfx + "\n"
            s = s + "            IF gY" + sfx + " >= 0 AND gY" + sfx + " < LEN(rows) THEN rows[gY" + sfx + "] = overlayRow(rows[gY" + sfx + "], " + xs + ", gLine" + sfx + ")\n"
            s = s + "        END IF\n"
            s = s + "    NEXT gRow" + sfx + "\n"
        ELSEIF wv.Kind = "ScrollPanel" THEN
            ' Framed box: top border, H-2 content rows (each = a content
            ' line + a scrollbar cell reading <name>_Scroll), bottom
            ' border. The thumb position is derived from the scroll
            ' offset over the fixed line count.
            DIM spBordStr AS STRING = strconv.Itoa(wv.W - 2)
            DIM spVisStr2 AS STRING = strconv.Itoa(wv.H - 2)
            DIM spCWStr AS STRING = strconv.Itoa(wv.W - 3)
            IF wv.W - 3 < 1 THEN spCWStr = "1"
            DIM spTrackV AS INTEGER = (wv.H - 2) - 2
            DIM spMaxV AS INTEGER = LEN(wv.Items) - (wv.H - 2)
            IF spMaxV < 0 THEN spMaxV = 0
            DIM spMaxStr2 AS STRING = strconv.Itoa(spMaxV)
            DIM spTrackStr AS STRING = strconv.Itoa(spTrackV)
            s = s + "    DIM spItems" + sfx + " AS []STRING\n"
            DIM spvI AS INTEGER
            FOR spvI = 0 TO LEN(wv.Items) - 1
                s = s + "    spItems" + sfx + " = APPEND(spItems" + sfx + ", " + qt + escapeForDBString(wv.Items[spvI]) + qt + ")\n"
            NEXT spvI
            s = s + "    DIM spTop" + sfx + " AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + spBordStr + ") + " + qt + "┐" + qt + "\n"
            s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", spTop" + sfx + ")\n"
            s = s + "    DIM spThumb" + sfx + " AS INTEGER = 0 - 1\n"
            s = s + "    IF " + spMaxStr2 + " > 0 AND " + spTrackStr + " > 0 THEN\n"
            s = s + "        spThumb" + sfx + " = (m." + wv.Name + "_Scroll * (" + spTrackStr + " - 1)) / " + spMaxStr2 + "\n"
            s = s + "        IF spThumb" + sfx + " < 0 THEN spThumb" + sfx + " = 0\n"
            s = s + "        IF spThumb" + sfx + " > " + spTrackStr + " - 1 THEN spThumb" + sfx + " = " + spTrackStr + " - 1\n"
            s = s + "    END IF\n"
            s = s + "    DIM spRow" + sfx + " AS INTEGER\n"
            s = s + "    FOR spRow" + sfx + " = 0 TO " + spVisStr2 + " - 1\n"
            s = s + "        DIM spSrc" + sfx + " AS INTEGER = m." + wv.Name + "_Scroll + spRow" + sfx + "\n"
            s = s + "        DIM spcl" + sfx + " AS STRING = " + qt + qt + "\n"
            s = s + "        IF spSrc" + sfx + " < LEN(spItems" + sfx + ") THEN spcl" + sfx + " = spItems" + sfx + "[spSrc" + sfx + "]\n"
            s = s + "        IF lipgloss.Width(spcl" + sfx + ") > " + spCWStr + " THEN spcl" + sfx + " = Mid(spcl" + sfx + ", 1, " + spCWStr + ")\n"
            s = s + "        IF lipgloss.Width(spcl" + sfx + ") < " + spCWStr + " THEN spcl" + sfx + " = spcl" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + spCWStr + " - lipgloss.Width(spcl" + sfx + "))\n"
            s = s + "        DIM spsb" + sfx + " AS STRING = " + qt + "░" + qt + "\n"
            s = s + "        IF spRow" + sfx + " = 0 THEN spsb" + sfx + " = " + qt + "▲" + qt + "\n"
            s = s + "        IF spRow" + sfx + " = " + spVisStr2 + " - 1 THEN spsb" + sfx + " = " + qt + "▼" + qt + "\n"
            s = s + "        IF spRow" + sfx + " >= 1 AND spRow" + sfx + " <= " + spVisStr2 + " - 2 AND (spRow" + sfx + " - 1) = spThumb" + sfx + " THEN spsb" + sfx + " = " + qt + "█" + qt + "\n"
            s = s + "        DIM spLine" + sfx + " AS STRING = " + qt + "│" + qt + " + spcl" + sfx + " + spsb" + sfx + " + " + qt + "│" + qt + "\n"
            s = s + "        DIM spY" + sfx + " AS INTEGER = " + ys + " + 1 + spRow" + sfx + "\n"
            s = s + "        IF spY" + sfx + " >= 0 AND spY" + sfx + " < LEN(rows) THEN rows[spY" + sfx + "] = overlayRow(rows[spY" + sfx + "], " + xs + ", spLine" + sfx + ")\n"
            s = s + "    NEXT spRow" + sfx + "\n"
            s = s + "    DIM spBot" + sfx + " AS STRING = " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + spBordStr + ") + " + qt + "┘" + qt + "\n"
            s = s + "    DIM spBotY" + sfx + " AS INTEGER = " + ys + " + " + strconv.Itoa(wv.H - 1) + "\n"
            s = s + "    IF spBotY" + sfx + " >= 0 AND spBotY" + sfx + " < LEN(rows) THEN rows[spBotY" + sfx + "] = overlayRow(rows[spBotY" + sfx + "], " + xs + ", spBot" + sfx + ")\n"
        ELSEIF wv.Kind = "StatusBar" THEN
            ' Single row: <name>_Text if set, else the static segments,
            ' clipped to W.
            DIM sbWStr AS STRING = strconv.Itoa(wv.W)
            s = s + "    DIM sbTxt" + sfx + " AS STRING = m." + wv.Name + "_Text\n"
            s = s + "    IF sbTxt" + sfx + " = " + qt + qt + " THEN sbTxt" + sfx + " = " + qt + escapeForDBString(statusBarText(wv.Items)) + qt + "\n"
            s = s + "    IF lipgloss.Width(sbTxt" + sfx + ") > " + sbWStr + " THEN sbTxt" + sfx + " = Mid(sbTxt" + sfx + ", 1, " + sbWStr + ")\n"
            s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", sbTxt" + sfx + ")\n"
        ELSEIF wv.Kind = "Menubar" THEN
            ' Title bar; the active title is bracketed when the bar is
            ' focused or open. The dropdown (when open) is drawn in a
            ' post-pass after this loop so it overlays other widgets.
            s = s + "    DIM mbFoc" + sfx + " AS BOOLEAN = (m.Focus = " + sfx + ") OR m." + wv.Name + "_Open\n"
            s = s + "    DIM mbBar" + sfx + " AS STRING = " + qt + qt + "\n"
            DIM mbVcount AS INTEGER = menubarMenuCount(wv.Items)
            DIM mbVk AS INTEGER
            FOR mbVk = 0 TO mbVcount - 1
                DIM mbVtitle AS STRING = escapeForDBString(menubarTitleAt(wv.Items, mbVk))
                s = s + "    IF mbFoc" + sfx + " AND m." + wv.Name + "_Active = " + strconv.Itoa(mbVk) + " THEN\n"
                s = s + "        mbBar" + sfx + " = mbBar" + sfx + " + " + qt + "[" + qt + " + " + qt + mbVtitle + qt + " + " + qt + "]" + qt + "\n"
                s = s + "    ELSE\n"
                s = s + "        mbBar" + sfx + " = mbBar" + sfx + " + " + qt + " " + qt + " + " + qt + mbVtitle + qt + " + " + qt + " " + qt + "\n"
                s = s + "    END IF\n"
            NEXT mbVk
            s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", mbBar" + sfx + ")\n"
        ELSEIF wv.Kind = "Panel" THEN
            ' Container frame + scrollbar, then its children clipped to
            ' the inner viewport and shifted up by <name>_Scroll. Child
            ' appearance is the static design render (display-only v1).
            DIM pnInnerStr AS STRING = strconv.Itoa(wv.W - 2)
            DIM pnVisN AS INTEGER = wv.H - 2
            IF pnVisN < 1 THEN pnVisN = 1
            DIM pnVisStr AS STRING = strconv.Itoa(pnVisN)
            DIM pnContentW AS INTEGER = wv.W - 3
            IF pnContentW < 1 THEN pnContentW = 1
            DIM pnTrack AS INTEGER = pnVisN - 2
            DIM pnCB AS INTEGER = panelContentBottom(f.Widgets, wv.Name)
            DIM pnMaxV AS INTEGER = pnCB - (wv.Y + 1) - pnVisN
            IF pnMaxV < 0 THEN pnMaxV = 0
            DIM pnMaxStr AS STRING = strconv.Itoa(pnMaxV)
            DIM pnTrackStr AS STRING = strconv.Itoa(pnTrack)
            DIM pnContentTop AS INTEGER = wv.Y + 1
            DIM pnContentBot AS INTEGER = wv.Y + wv.H - 2
            ' Top border.
            s = s + "    DIM pnTop" + sfx + " AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + pnInnerStr + ") + " + qt + "┐" + qt + "\n"
            s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", pnTop" + sfx + ")\n"
            ' Thumb position from scroll offset.
            s = s + "    DIM pnThumb" + sfx + " AS INTEGER = 0 - 1\n"
            s = s + "    IF " + pnMaxStr + " > 0 AND " + pnTrackStr + " > 0 THEN\n"
            s = s + "        pnThumb" + sfx + " = (m." + wv.Name + "_Scroll * (" + pnTrackStr + " - 1)) / " + pnMaxStr + "\n"
            s = s + "        IF pnThumb" + sfx + " < 0 THEN pnThumb" + sfx + " = 0\n"
            s = s + "        IF pnThumb" + sfx + " > " + pnTrackStr + " - 1 THEN pnThumb" + sfx + " = " + pnTrackStr + " - 1\n"
            s = s + "    END IF\n"
            ' Side borders + scrollbar (empty interior).
            s = s + "    DIM pnRw" + sfx + " AS INTEGER\n"
            s = s + "    FOR pnRw" + sfx + " = 0 TO " + pnVisStr + " - 1\n"
            s = s + "        DIM pnSb" + sfx + " AS STRING = " + qt + "░" + qt + "\n"
            s = s + "        IF pnRw" + sfx + " = 0 THEN pnSb" + sfx + " = " + qt + "▲" + qt + "\n"
            s = s + "        IF pnRw" + sfx + " = " + pnVisStr + " - 1 THEN pnSb" + sfx + " = " + qt + "▼" + qt + "\n"
            s = s + "        IF pnRw" + sfx + " >= 1 AND pnRw" + sfx + " <= " + pnVisStr + " - 2 AND (pnRw" + sfx + " - 1) = pnThumb" + sfx + " THEN pnSb" + sfx + " = " + qt + "█" + qt + "\n"
            s = s + "        DIM pnLn" + sfx + " AS STRING = " + qt + "│" + qt + " + strings.Repeat(" + qt + " " + qt + ", " + strconv.Itoa(pnContentW) + ") + pnSb" + sfx + " + " + qt + "│" + qt + "\n"
            s = s + "        DIM pnLy" + sfx + " AS INTEGER = " + ys + " + 1 + pnRw" + sfx + "\n"
            s = s + "        IF pnLy" + sfx + " >= 0 AND pnLy" + sfx + " < LEN(rows) THEN rows[pnLy" + sfx + "] = overlayRow(rows[pnLy" + sfx + "], " + xs + ", pnLn" + sfx + ")\n"
            s = s + "    NEXT pnRw" + sfx + "\n"
            ' Bottom border.
            s = s + "    DIM pnBot" + sfx + " AS STRING = " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + pnInnerStr + ") + " + qt + "┘" + qt + "\n"
            s = s + "    DIM pnBy" + sfx + " AS INTEGER = " + ys + " + " + strconv.Itoa(wv.H - 1) + "\n"
            s = s + "    IF pnBy" + sfx + " >= 0 AND pnBy" + sfx + " < LEN(rows) THEN rows[pnBy" + sfx + "] = overlayRow(rows[pnBy" + sfx + "], " + xs + ", pnBot" + sfx + ")\n"
            ' Children — overlay their (clipped) design rows, shifted by
            ' the scroll offset, clipped to the content row band.
            DIM pnCi AS INTEGER
            FOR pnCi = 0 TO n - 1
                DIM pnChild AS DesignWidget = f.Widgets[pnCi]
                IF pnChild.Parent = wv.Name THEN
                    DIM pnAvail AS INTEGER = (wv.X + wv.W - 2) - pnChild.X
                    IF pnAvail > 0 THEN
                        DIM pnCrows AS []STRING = widgetVisibleLines(pnChild)
                        DIM pnCj AS INTEGER
                        FOR pnCj = 0 TO LEN(pnCrows) - 1
                            DIM pnCrow AS STRING = pnCrows[pnCj]
                            IF lipgloss.Width(pnCrow) > pnAvail THEN pnCrow = Mid(pnCrow, 1, pnAvail)
                            DIM pnAbsY AS INTEGER = pnChild.Y + pnCj
                            DIM pnTag AS STRING = sfx + "c" + strconv.Itoa(pnCi) + "r" + strconv.Itoa(pnCj)
                            s = s + "    DIM pcY" + pnTag + " AS INTEGER = " + strconv.Itoa(pnAbsY) + " - m." + wv.Name + "_Scroll\n"
                            s = s + "    IF pcY" + pnTag + " >= " + strconv.Itoa(pnContentTop) + " AND pcY" + pnTag + " <= " + strconv.Itoa(pnContentBot) + " AND pcY" + pnTag + " >= 0 AND pcY" + pnTag + " < LEN(rows) THEN rows[pcY" + pnTag + "] = overlayCells(rows[pcY" + pnTag + "], " + strconv.Itoa(pnChild.X) + ", " + qt + escapeForDBString(pnCrow) + qt + ")\n"
                        NEXT pnCj
                    END IF
                END IF
            NEXT pnCi
        ELSE
        ' --- Single-row kinds: build body string, prefix focus
        '     marker, overlay onto the target row in `rows`.
        s = s + "    DIM body" + sfx + " AS STRING\n"
        IF wv.Kind = "TextInput" THEN
            s = s + textInputEmitView(wv, sfx, qt)
        ELSEIF wv.Kind = "Checkbox" THEN
            s = s + checkboxEmitView(wv, sfx, qt)
        ELSEIF wv.Kind = "RadioButton" THEN
            s = s + radioButtonEmitView(wv, sfx, qt)
        ELSEIF wv.Kind = "ComboBox" THEN
            DIM cwidStr AS STRING = strconv.Itoa(wv.W - 4)
            IF wv.W - 4 < 1 THEN cwidStr = "1"
            s = s + "    DIM cbItems" + sfx + " AS []STRING\n"
            DIM cbI AS INTEGER
            FOR cbI = 0 TO LEN(wv.Items) - 1
                s = s + "    cbItems" + sfx + " = APPEND(cbItems" + sfx + ", " + qt + escapeForDBString(wv.Items[cbI]) + qt + ")\n"
            NEXT cbI
            s = s + "    DIM cbCur" + sfx + " AS STRING = " + qt + qt + "\n"
            s = s + "    IF m." + wv.Name + "_Val >= 0 AND m." + wv.Name + "_Val < LEN(cbItems" + sfx + ") THEN cbCur" + sfx + " = cbItems" + sfx + "[m." + wv.Name + "_Val]\n"
            s = s + "    IF LEN(cbCur" + sfx + ") > " + cwidStr + " THEN cbCur" + sfx + " = Mid(cbCur" + sfx + ", 1, " + cwidStr + ")\n"
            s = s + "    IF LEN(cbCur" + sfx + ") < " + cwidStr + " THEN cbCur" + sfx + " = cbCur" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + cwidStr + " - LEN(cbCur" + sfx + "))\n"
            s = s + "    body" + sfx + " = " + qt + "[" + qt + " + cbCur" + sfx + " + " + qt + " v]" + qt + "\n"
        ELSEIF wv.Kind = "ProgressBar" THEN
            s = s + progressBarEmitView(wv, sfx, qt)
        ELSEIF wv.Kind = "ScrollBar" THEN
            ' Horizontal scrollbar — single row "◄──█──►".
            DIM hwStr AS STRING = strconv.Itoa(wv.W - 2)
            IF wv.W - 2 < 1 THEN hwStr = "1"
            DIM hMinStr AS STRING = strconv.Itoa(wv.Min)
            DIM hRngStr AS STRING = strconv.Itoa(wv.Max - wv.Min)
            IF wv.Max - wv.Min <= 0 THEN hRngStr = "1"
            s = s + "    DIM hThumb" + sfx + " AS INTEGER = (m." + wv.Name + "_Val - " + hMinStr + ") * (" + hwStr + " - 1) / " + hRngStr + "\n"
            s = s + "    IF hThumb" + sfx + " < 0 THEN hThumb" + sfx + " = 0\n"
            s = s + "    IF hThumb" + sfx + " > " + hwStr + " - 1 THEN hThumb" + sfx + " = " + hwStr + " - 1\n"
            s = s + "    body" + sfx + " = " + qt + "◄" + qt + " + strings.Repeat(" + qt + "─" + qt + ", hThumb" + sfx + ") + " + qt + "█" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + hwStr + " - 1 - hThumb" + sfx + ") + " + qt + "►" + qt + "\n"
        ELSE
            ' Button / Label / others: static text via widgetVisibleText.
            DIM txt AS STRING = widgetVisibleText(wv)
            s = s + "    body" + sfx + " = " + qt + escapeForDBString(txt) + qt + "\n"
        END IF
        s = s + "    IF m.Focus = " + sfx + " THEN\n"
        s = s + "        body" + sfx + " = " + qt + ">" + qt + " + body" + sfx + "\n"
        s = s + "    ELSE\n"
        s = s + "        body" + sfx + " = " + qt + " " + qt + " + body" + sfx + "\n"
        s = s + "    END IF\n"
        s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", body" + sfx + ")\n"
        END IF
      END IF
        _ = isMulti
    NEXT i
    ' --- Menubar dropdown post-pass. Drawn after every widget so the
    '     open dropdown overlays whatever is beneath it. Also stashes the
    '     dropdown rect into _mb* for Update's click hit-test.
    IF hasMenubar THEN
        DIM mbPI AS INTEGER
        FOR mbPI = 0 TO n - 1
            DIM mbPW AS DesignWidget = f.Widgets[mbPI]
            IF mbPW.Kind = "Menubar" THEN
                DIM mbPsfx AS STRING = strconv.Itoa(mbPI)
                DIM mbPcount AS INTEGER = menubarMenuCount(mbPW.Items)
                s = s + "    IF m." + mbPW.Name + "_Open THEN\n"
                DIM mbPk AS INTEGER
                FOR mbPk = 0 TO mbPcount - 1
                    DIM mbPits AS []STRING = menubarItemsAt(mbPW.Items, mbPk)
                    DIM mbPcnt AS INTEGER = LEN(mbPits)
                    DIM mbPmaxW AS INTEGER = 1
                    DIM mbPjj AS INTEGER
                    FOR mbPjj = 0 TO mbPcnt - 1
                        DIM mbPlw AS INTEGER = lipgloss.Width(mbPits[mbPjj])
                        IF mbPlw > mbPmaxW THEN mbPmaxW = mbPlw
                    NEXT mbPjj
                    DIM mbPinner AS INTEGER = mbPmaxW + 2
                    DIM mbPboxX AS INTEGER = mbPW.X + menubarColAt(mbPW.Items, mbPk)
                    DIM mbPtopY AS INTEGER = mbPW.Y + 1
                    DIM mbPkStr AS STRING = strconv.Itoa(mbPk)
                    DIM mbPtag AS STRING = mbPsfx + "x" + mbPkStr
                    s = s + "        IF m." + mbPW.Name + "_Active = " + mbPkStr + " THEN\n"
                    s = s + "            DIM mbT" + mbPtag + " AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + strconv.Itoa(mbPinner) + ") + " + qt + "┐" + qt + "\n"
                    s = s + "            IF " + strconv.Itoa(mbPtopY) + " >= 0 AND " + strconv.Itoa(mbPtopY) + " < LEN(rows) THEN rows[" + strconv.Itoa(mbPtopY) + "] = overlayRow(rows[" + strconv.Itoa(mbPtopY) + "], " + strconv.Itoa(mbPboxX) + ", mbT" + mbPtag + ")\n"
                    DIM mbPj AS INTEGER
                    FOR mbPj = 0 TO mbPcnt - 1
                        DIM mbPlabel AS STRING = mbPits[mbPj]
                        DIM mbPpad AS INTEGER = mbPmaxW - lipgloss.Width(mbPlabel)
                        DIM mbPtail AS STRING = " " + mbPlabel + strings.Repeat(" ", mbPpad) + "│"
                        DIM mbPitemY AS INTEGER = mbPtopY + 1 + mbPj
                        DIM mbPjTag AS STRING = mbPtag + "y" + strconv.Itoa(mbPj)
                        s = s + "            DIM mbMk" + mbPjTag + " AS STRING = " + qt + " " + qt + "\n"
                        s = s + "            IF m." + mbPW.Name + "_Item = " + strconv.Itoa(mbPj) + " THEN mbMk" + mbPjTag + " = " + qt + ">" + qt + "\n"
                        s = s + "            DIM mbR" + mbPjTag + " AS STRING = " + qt + "│" + qt + " + mbMk" + mbPjTag + " + " + qt + escapeForDBString(mbPtail) + qt + "\n"
                        s = s + "            IF " + strconv.Itoa(mbPitemY) + " >= 0 AND " + strconv.Itoa(mbPitemY) + " < LEN(rows) THEN rows[" + strconv.Itoa(mbPitemY) + "] = overlayRow(rows[" + strconv.Itoa(mbPitemY) + "], " + strconv.Itoa(mbPboxX) + ", mbR" + mbPjTag + ")\n"
                    NEXT mbPj
                    DIM mbPbotY AS INTEGER = mbPtopY + 1 + mbPcnt
                    s = s + "            DIM mbB" + mbPtag + " AS STRING = " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + strconv.Itoa(mbPinner) + ") + " + qt + "┘" + qt + "\n"
                    s = s + "            IF " + strconv.Itoa(mbPbotY) + " >= 0 AND " + strconv.Itoa(mbPbotY) + " < LEN(rows) THEN rows[" + strconv.Itoa(mbPbotY) + "] = overlayRow(rows[" + strconv.Itoa(mbPbotY) + "], " + strconv.Itoa(mbPboxX) + ", mbB" + mbPtag + ")\n"
                    s = s + "            _mbX = " + strconv.Itoa(mbPboxX) + "\n"
                    s = s + "            _mbItemY = " + strconv.Itoa(mbPtopY + 1) + "\n"
                    s = s + "            _mbW = " + strconv.Itoa(mbPinner + 2) + "\n"
                    s = s + "            _mbN = " + strconv.Itoa(mbPcnt) + "\n"
                    s = s + "        END IF\n"
                NEXT mbPk
                s = s + "    END IF\n"
            END IF
        NEXT mbPI
    END IF
    s = s + "    rows = APPEND(rows, " + qt + " — Tab to cycle focus, Esc to quit" + qt + ")\n"
    ' Enable mouse capture so the Update handler above receives
    ' MouseClickMsg. MouseModeCellMotion reports clicks + release
    ' + wheel; lighter than MouseModeAllMotion and we don't need
    ' continuous motion events in v1 (no drag yet).
    s = s + "    DIM fullView AS STRING = strings.Join(rows, " + qt + "\\n" + qt + ")\n"
    ' Dialog overlay. When a dialog is active we manually overlay each
    ' of its rows onto the widget grid via overlayRowAt (which counts
    ' visible cells, not bytes), then return that. When none is active
    ' the widget grid is returned as-is. Going through the lipgloss
    ' compositor here left the dialog's top row "stuck" on the next
    ' frame in some terminals; manual overlay sidesteps that.
    IF hasDialog THEN
        s = s + "    DIM dlgStr AS STRING = " + qt + qt + "\n"
        DIM dlgVI AS INTEGER
        FOR dlgVI = 0 TO n - 1
            DIM dlgVW AS DesignWidget = f.Widgets[dlgVI]
            IF dlgVW.Kind = "Dialog" THEN
                DIM dlgVK AS STRING = dlgVW.DialogKind
                IF dlgVK = "" THEN dlgVK = "confirm"
                s = s + "    IF dlgStr = " + qt + qt + " AND m." + dlgVW.Name + "_Active THEN\n"
                IF dlgVK = "input" THEN
                    ' Input-kind: hard-coded OK/Cancel button labels;
                    ' activeIdx is -1 when the text field is focused
                    ' (renderer suppresses button highlight), else the
                    ' button index.
                    s = s + "        DIM actIdx" + dlgVW.Name + " AS INTEGER = m." + dlgVW.Name + "_Idx\n"
                    s = s + "        IF m." + dlgVW.Name + "_OnField THEN actIdx" + dlgVW.Name + " = 0 - 1\n"
                    s = s + "        dlgStr = fdRenderInput(" + qt + escapeForDBString(dlgVW.Text) + qt + ", " + qt + escapeForDBString(dlgVW.DialogMsg) + qt + ", m." + dlgVW.Name + "_Text, m." + dlgVW.Name + "_OnField, actIdx" + dlgVW.Name + ")\n"
                ELSE
                    s = s + "        DIM btns" + dlgVW.Name + " AS []STRING\n"
                    DIM bvIdx AS INTEGER
                    FOR bvIdx = 0 TO LEN(dlgVW.Items) - 1
                        s = s + "        btns" + dlgVW.Name + " = APPEND(btns" + dlgVW.Name + ", " + qt + escapeForDBString(dlgVW.Items[bvIdx]) + qt + ")\n"
                    NEXT bvIdx
                    s = s + "        dlgStr = fdRenderConfirm(" + qt + escapeForDBString(dlgVW.Text) + qt + ", " + qt + escapeForDBString(dlgVW.DialogMsg) + qt + ", btns" + dlgVW.Name + ", m." + dlgVW.Name + "_Idx)\n"
                END IF
                s = s + "    END IF\n"
            END IF
        NEXT dlgVI
        s = s + "    IF dlgStr <> " + qt + qt + " THEN\n"
        s = s + "        DIM dwW AS INTEGER = lipgloss.Width(dlgStr)\n"
        s = s + "        DIM dwH AS INTEGER = lipgloss.Height(dlgStr)\n"
        s = s + "        DIM dwX AS INTEGER = (w - dwW) / 2\n"
        s = s + "        DIM dwY AS INTEGER = (h - dwH) / 2\n"
        s = s + "        IF dwX < 0 THEN dwX = 0\n"
        s = s + "        IF dwY < 0 THEN dwY = 0\n"
        ' Stash the rect so Update's click handler can hit-test
        ' against the on-screen dialog position.
        s = s + "        _dlgX = dwX\n"
        s = s + "        _dlgY = dwY\n"
        s = s + "        _dlgW = dwW\n"
        s = s + "        _dlgH = dwH\n"
        ' Overlay each line of the dialog onto its corresponding
        ' row in the grid.
        s = s + "        DIM dlgLines AS []STRING = strings.Split(dlgStr, " + qt + "\\n" + qt + ")\n"
        s = s + "        DIM dlgRi AS INTEGER\n"
        s = s + "        FOR dlgRi = 0 TO LEN(dlgLines) - 1\n"
        s = s + "            DIM tgtY AS INTEGER = dwY + dlgRi\n"
        s = s + "            IF tgtY >= 0 AND tgtY < LEN(rows) THEN\n"
        s = s + "                rows[tgtY] = overlayRowAt(rows[tgtY], dwX, dlgLines[dlgRi])\n"
        s = s + "            END IF\n"
        s = s + "        NEXT dlgRi\n"
        s = s + "        fullView = strings.Join(rows, " + qt + "\\n" + qt + ")\n"
        s = s + "    ELSE\n"
        s = s + "        _dlgW = 0\n"
        s = s + "        _dlgH = 0\n"
        s = s + "    END IF\n"
    END IF
    s = s + "    DIM vw AS tea.View = tea.NewView(fullView)\n"
    s = s + "    vw.MouseMode = tea.MouseModeCellMotion\n"
    ' Alt-screen mode so bubbletea owns the whole terminal and clears
    ' it cleanly between frames. Without this, content that shrinks
    ' (e.g. a dialog closing) can leave residue from the previous
    ' frame in the regular terminal scrollback.
    s = s + "    vw.AltScreen = TRUE\n"
    s = s + "    RETURN vw\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    s = s + "SUB Main()\n"
    s = s + "    DIM m AS Model\n"
    ' Seed per-widget initial state from the design — bubbletea
    ' takes the Model by value at NewProgram time, so anything set
    ' here is what the user sees on the first frame.
    DIM mi AS INTEGER
    FOR mi = 0 TO n - 1
        DIM mw AS DesignWidget = f.Widgets[mi]
      IF mw.Parent = "" THEN
        IF mw.Kind = "RadioButton" AND mw.Checked THEN
            s = s + radioButtonEmitSeed(mw)
        ELSEIF mw.Kind = "ComboBox" OR mw.Kind = "ListBox" OR mw.Kind = "TabStrip" OR mw.Kind = "PropGrid" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Selected) + "\n"
        ELSEIF mw.Kind = "ScrollBar" OR mw.Kind = "ProgressBar" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Value) + "\n"
        ELSEIF mw.Kind = "TextArea" THEN
            ' Seed the buffer with the initial content; cursor at end.
            s = s + "    m." + mw.Name + "_Val = " + qt + escapeForDBString(mw.Text) + qt + "\n"
            s = s + "    m." + mw.Name + "_Cur = LEN(m." + mw.Name + "_Val)\n"
        ELSEIF mw.Kind = "Tree" THEN
            ' Cursor starts at Selected; every node starts expanded.
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Selected) + "\n"
            s = s + "    DIM seedC" + mw.Name + " AS INTEGER\n"
            s = s + "    FOR seedC" + mw.Name + " = 0 TO " + strconv.Itoa(LEN(mw.Items) - 1) + "\n"
            s = s + "        m." + mw.Name + "_Collapsed = APPEND(m." + mw.Name + "_Collapsed, FALSE)\n"
            s = s + "    NEXT seedC" + mw.Name + "\n"
        END IF
      END IF
    NEXT mi
    s = s + "    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)\n"
    s = s + "    DIM final AS tea.Model\n"
    s = s + "    DIM rerr AS ERROR\n"
    s = s + "    final, rerr = prog.Run()\n"
    s = s + "    IF rerr <> NIL THEN os.Exit(1)\n"
    s = s + "    _ = final\n"
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- overlayRow — shared helper for painting a body string onto
    '     a target row at column X, preserving cells either side.
    '     Returns the new row contents. Used by every per-widget
    '     paint site in View, single-row or multi-row.
    s = s + "FUNCTION overlayRow(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING\n"
    s = s + "    DIM lf AS STRING = " + qt + qt + "\n"
    s = s + "    IF col > 0 AND col <= LEN(row) THEN lf = Mid(row, 1, col)\n"
    s = s + "    DIM rt AS STRING = " + qt + qt + "\n"
    s = s + "    IF col + LEN(txt) < LEN(row) THEN rt = Mid(row, col + LEN(txt) + 1, LEN(row) - col - LEN(txt))\n"
    s = s + "    RETURN lf + txt + rt\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- overlayCells — like overlayRow but CELL-aware: places `txt` at
    '     visible column `col`, walking UTF-8 codepoints (each = 1 cell)
    '     so it splices cleanly into a row that already contains
    '     multi-byte box-drawing glyphs (a Panel's │ borders). Used for
    '     child overlays inside a Panel.
    IF hasPanel THEN
        s = s + "FUNCTION cellByteIdx(sIn AS STRING, cell AS INTEGER) AS INTEGER\n"
        s = s + "    DIM b AS INTEGER = 0\n"
        s = s + "    DIM c AS INTEGER = 0\n"
        s = s + "    DO WHILE b < LEN(sIn) AND c < cell\n"
        s = s + "        DIM lead AS INTEGER = Asc(Mid(sIn, b + 1, 1))\n"
        s = s + "        DIM nb AS INTEGER = 1\n"
        s = s + "        IF lead >= 240 THEN\n"
        s = s + "            nb = 4\n"
        s = s + "        ELSEIF lead >= 224 THEN\n"
        s = s + "            nb = 3\n"
        s = s + "        ELSEIF lead >= 192 THEN\n"
        s = s + "            nb = 2\n"
        s = s + "        END IF\n"
        s = s + "        b = b + nb\n"
        s = s + "        c = c + 1\n"
        s = s + "    LOOP\n"
        s = s + "    RETURN b\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
        s = s + "FUNCTION overlayCells(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING\n"
        s = s + "    DIM txtCells AS INTEGER = 0\n"
        s = s + "    DIM tb AS INTEGER = 0\n"
        s = s + "    DO WHILE tb < LEN(txt)\n"
        s = s + "        DIM tl AS INTEGER = Asc(Mid(txt, tb + 1, 1))\n"
        s = s + "        DIM tn AS INTEGER = 1\n"
        s = s + "        IF tl >= 240 THEN\n"
        s = s + "            tn = 4\n"
        s = s + "        ELSEIF tl >= 224 THEN\n"
        s = s + "            tn = 3\n"
        s = s + "        ELSEIF tl >= 192 THEN\n"
        s = s + "            tn = 2\n"
        s = s + "        END IF\n"
        s = s + "        tb = tb + tn\n"
        s = s + "        txtCells = txtCells + 1\n"
        s = s + "    LOOP\n"
        s = s + "    DIM startB AS INTEGER = cellByteIdx(row, col)\n"
        s = s + "    DIM endB AS INTEGER = cellByteIdx(row, col + txtCells)\n"
        s = s + "    DIM lf AS STRING = " + qt + qt + "\n"
        s = s + "    IF startB > 0 THEN lf = Mid(row, 1, startB)\n"
        s = s + "    DIM rt AS STRING = " + qt + qt + "\n"
        s = s + "    IF endB < LEN(row) THEN rt = Mid(row, endB + 1, LEN(row) - endB)\n"
        s = s + "    RETURN lf + txt + rt\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
    END IF
    ' overlayRowAt — splice a (possibly ANSI-styled) string into `row`
    ' at visible column `col`, replacing `lipgloss.Width(txt)` cells of
    ' the row's plain-ascii content. Used by the dialog overlay so the
    ' styled dialog cells line up correctly with the plain-space grid
    ' underneath. Only emit when hasDialog (needs lipgloss).
    IF hasDialog THEN
        s = s + "FUNCTION overlayRowAt(row AS STRING, col AS INTEGER, txt AS STRING) AS STRING\n"
        s = s + "    DIM lf AS STRING = " + qt + qt + "\n"
        s = s + "    IF col > 0 AND col <= LEN(row) THEN lf = Mid(row, 1, col)\n"
        s = s + "    DIM cells AS INTEGER = lipgloss.Width(txt)\n"
        s = s + "    DIM rt AS STRING = " + qt + qt + "\n"
        s = s + "    IF col + cells < LEN(row) THEN rt = Mid(row, col + cells + 1, LEN(row) - col - cells)\n"
        s = s + "    RETURN lf + txt + rt\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
    END IF
    ' --- dispatchClick — generated jump-table from widget Id to
    '     the user-defined SUB. Must live in the prelude so the
    '     generated Update can call it; the SUB bodies live below
    '     the marker so they survive regen.
    s = s + "' Generated dispatcher — routes a Button click to its user handler.\n"
    s = s + "' When a Button has OnClickDialog set, the dialog's Show<Name>()\n"
    s = s + "' fires first so the user doesn't have to wire it from code.\n"
    s = s + "SUB dispatchClick(id AS STRING)\n"
    DIM hadClick AS BOOLEAN = FALSE
    DIM di AS INTEGER
    FOR di = 0 TO n - 1
        DIM dw AS DesignWidget = f.Widgets[di]
        IF dw.Kind = "Button" AND dw.Parent = "" THEN
            s = s + buttonEmitClickDispatch(dw, qt)
            hadClick = TRUE
        END IF
    NEXT di
    IF NOT hadClick THEN
        ' Empty body — avoid an "unused parameter" Go warning.
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- dispatchChange — like dispatchClick but for value-change
    '     events on Checkbox / RadioButton / ComboBox / ListBox /
    '     ScrollBar. User handlers live below the marker.
    s = s + "' Generated dispatcher — routes a value change to its _Change handler.\n"
    s = s + "SUB dispatchChange(id AS STRING)\n"
    DIM hadChange AS BOOLEAN = FALSE
    DIM dchI AS INTEGER
    FOR dchI = 0 TO n - 1
        DIM dchW AS DesignWidget = f.Widgets[dchI]
        IF (dchW.Kind = "Checkbox" OR dchW.Kind = "RadioButton" OR dchW.Kind = "ComboBox" OR dchW.Kind = "ListBox" OR dchW.Kind = "ScrollBar" OR dchW.Kind = "TabStrip" OR dchW.Kind = "Tree" OR dchW.Kind = "PropGrid") AND dchW.Parent = "" THEN
            s = s + "    IF id = " + qt + dchW.Name + qt + " THEN " + dchW.Name + "_Change()\n"
            hadChange = TRUE
        END IF
    NEXT dchI
    IF NOT hadChange THEN
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"

    ' --- Tree widget plumbing. A shared treeVisibleRows() walks the
    '     node depths + per-node collapse flags to produce the list of
    '     visible node indices (descendants of a collapsed parent are
    '     skipped). Per-tree _depths()/_labels()/_isParent() helpers
    '     bake the static node structure decoded from the leading-dash
    '     depth prefixes so both Update and View can read it.
    IF hasTree THEN
        s = s + "\n"
        s = s + "FUNCTION treeVisibleRows(depths AS []INTEGER, collapsed AS []BOOLEAN) AS []INTEGER\n"
        s = s + "    DIM out AS []INTEGER\n"
        s = s + "    DIM i AS INTEGER = 0\n"
        s = s + "    DO WHILE i < LEN(depths)\n"
        s = s + "        out = APPEND(out, i)\n"
        s = s + "        IF i < LEN(collapsed) AND collapsed[i] THEN\n"
        s = s + "            DIM d AS INTEGER = depths[i]\n"
        s = s + "            DIM j AS INTEGER = i + 1\n"
        s = s + "            DO WHILE j < LEN(depths) AND depths[j] > d\n"
        s = s + "                j = j + 1\n"
        s = s + "            LOOP\n"
        s = s + "            i = j\n"
        s = s + "        ELSE\n"
        s = s + "            i = i + 1\n"
        s = s + "        END IF\n"
        s = s + "    LOOP\n"
        s = s + "    RETURN out\n"
        s = s + "END FUNCTION\n"
        DIM trI AS INTEGER
        FOR trI = 0 TO n - 1
            DIM trW AS DesignWidget = f.Widgets[trI]
            IF trW.Kind = "Tree" THEN
                ' _depths()
                s = s + "\n"
                s = s + "FUNCTION " + trW.Name + "_depths() AS []INTEGER\n"
                s = s + "    DIM d AS []INTEGER\n"
                DIM trN AS INTEGER
                FOR trN = 0 TO LEN(trW.Items) - 1
                    s = s + "    d = APPEND(d, " + strconv.Itoa(treeDepth(trW.Items[trN])) + ")\n"
                NEXT trN
                s = s + "    RETURN d\n"
                s = s + "END FUNCTION\n"
                ' _labels()
                s = s + "\n"
                s = s + "FUNCTION " + trW.Name + "_labels() AS []STRING\n"
                s = s + "    DIM l AS []STRING\n"
                FOR trN = 0 TO LEN(trW.Items) - 1
                    s = s + "    l = APPEND(l, " + qt + escapeForDBString(treeLabel(trW.Items[trN])) + qt + ")\n"
                NEXT trN
                s = s + "    RETURN l\n"
                s = s + "END FUNCTION\n"
                ' _isParent(i)
                s = s + "\n"
                s = s + "FUNCTION " + trW.Name + "_isParent(i AS INTEGER) AS BOOLEAN\n"
                s = s + "    DIM d AS []INTEGER = " + trW.Name + "_depths()\n"
                s = s + "    IF i < 0 OR i + 1 >= LEN(d) THEN RETURN FALSE\n"
                s = s + "    RETURN d[i + 1] > d[i]\n"
                s = s + "END FUNCTION\n"
            END IF
        NEXT trI
    END IF

    ' --- TextArea cursor helpers. All byte-offset based (exact for
    '     ASCII). taLineHome/taLineEnd clamp a cursor to its line's
    '     bounds; taMoveVert moves up/down keeping the column; taRowCol
    '     maps a byte offset to a (row, col) for the renderer.
    IF hasTextArea THEN
        s = s + "\n"
        s = s + "FUNCTION taLineHome(text AS STRING, cur AS INTEGER) AS INTEGER\n"
        s = s + "    DIM h AS INTEGER = cur\n"
        s = s + "    DO WHILE h > 0 AND Mid(text, h, 1) <> " + qt + "\\n" + qt + "\n"
        s = s + "        h = h - 1\n"
        s = s + "    LOOP\n"
        s = s + "    RETURN h\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
        s = s + "FUNCTION taLineEnd(text AS STRING, cur AS INTEGER) AS INTEGER\n"
        s = s + "    DIM e AS INTEGER = cur\n"
        s = s + "    DO WHILE e < LEN(text) AND Mid(text, e + 1, 1) <> " + qt + "\\n" + qt + "\n"
        s = s + "        e = e + 1\n"
        s = s + "    LOOP\n"
        s = s + "    RETURN e\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
        s = s + "FUNCTION taMoveVert(text AS STRING, cur AS INTEGER, dir AS INTEGER) AS INTEGER\n"
        s = s + "    DIM home AS INTEGER = taLineHome(text, cur)\n"
        s = s + "    DIM col AS INTEGER = cur - home\n"
        s = s + "    IF dir < 0 THEN\n"
        s = s + "        IF home = 0 THEN RETURN cur\n"
        s = s + "        DIM prevHome AS INTEGER = taLineHome(text, home - 1)\n"
        s = s + "        DIM prevLen AS INTEGER = (home - 1) - prevHome\n"
        s = s + "        DIM ncol AS INTEGER = col\n"
        s = s + "        IF ncol > prevLen THEN ncol = prevLen\n"
        s = s + "        RETURN prevHome + ncol\n"
        s = s + "    END IF\n"
        s = s + "    DIM le AS INTEGER = taLineEnd(text, cur)\n"
        s = s + "    IF le >= LEN(text) THEN RETURN cur\n"
        s = s + "    DIM nextHome AS INTEGER = le + 1\n"
        s = s + "    DIM nextEnd AS INTEGER = taLineEnd(text, nextHome)\n"
        s = s + "    DIM nextLen AS INTEGER = nextEnd - nextHome\n"
        s = s + "    DIM ncol2 AS INTEGER = col\n"
        s = s + "    IF ncol2 > nextLen THEN ncol2 = nextLen\n"
        s = s + "    RETURN nextHome + ncol2\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
        s = s + "FUNCTION taRowCol(text AS STRING, cur AS INTEGER) AS (INTEGER, INTEGER)\n"
        s = s + "    DIM row AS INTEGER = 0\n"
        s = s + "    DIM col AS INTEGER = 0\n"
        s = s + "    DIM i AS INTEGER\n"
        s = s + "    FOR i = 0 TO cur - 1\n"
        s = s + "        IF i < LEN(text) AND Mid(text, i + 1, 1) = " + qt + "\\n" + qt + " THEN\n"
        s = s + "            row = row + 1\n"
        s = s + "            col = 0\n"
        s = s + "        ELSE\n"
        s = s + "            col = col + 1\n"
        s = s + "        END IF\n"
        s = s + "    NEXT i\n"
        s = s + "    RETURN row, col\n"
        s = s + "END FUNCTION\n"
    END IF

    ' --- Dialog widget plumbing (confirm kind only — Phase 2).
    '     For each Dialog widget: a Show<Name> SUB the user calls to
    '     pop the dialog. A shared fdRenderConfirm() helper draws it
    '     using lipgloss, matching DBtui's own confirm-dialog style.
    IF hasDialog THEN
        DIM dlgI AS INTEGER
        FOR dlgI = 0 TO n - 1
            DIM dlgW AS DesignWidget = f.Widgets[dlgI]
            IF dlgW.Kind = "Dialog" THEN
                DIM dlgSK AS STRING = dlgW.DialogKind
                IF dlgSK = "" THEN dlgSK = "confirm"
                DIM closeSig AS STRING = "(button STRING)"
                IF dlgSK = "input" THEN closeSig = "(button STRING, text STRING)"
                s = s + "\n"
                s = s + "' Show" + dlgW.Name + " — pop the " + dlgW.Name + " dialog.\n"
                s = s + "' Call from inside a _Click / _Change handler. On commit/\n"
                s = s + "' cancel " + dlgW.Name + "_Close" + closeSig + " fires (defined\n"
                s = s + "' below the marker — user fills in the body).\n"
                s = s + "SUB Show" + dlgW.Name + "()\n"
                s = s + "    IF _currentModel = NIL THEN RETURN\n"
                s = s + "    _currentModel." + dlgW.Name + "_Active = TRUE\n"
                s = s + "    _currentModel." + dlgW.Name + "_Idx    = 0\n"
                IF dlgSK = "input" THEN
                    ' Input-kind: seed the field with DialogDef and put
                    ' the focus on the text field.
                    s = s + "    _currentModel." + dlgW.Name + "_Text    = " + qt + escapeForDBString(dlgW.DialogDef) + qt + "\n"
                    s = s + "    _currentModel." + dlgW.Name + "_OnField = TRUE\n"
                END IF
                s = s + "END SUB\n"
            END IF
        NEXT dlgI

        ' fdRenderConfirm — body + button row wrapped in a lipgloss
        ' frame with BorderTop(FALSE), then a hand-rolled top border
        ' carrying the title (left) + ✕ close glyph (right). Matches
        ' DBtui's own FileDialog / modal style. innerW fixed at 48.
        s = s + "\n"
        s = s + "FUNCTION fdRenderConfirm(title AS STRING, msg AS STRING, buttons AS []STRING, activeIdx AS INTEGER) AS STRING\n"
        s = s + "    DIM innerW AS INTEGER = 48\n"
        s = s + "    DIM cBg     AS STRING = " + qt + "#1a1b2e" + qt + "\n"
        s = s + "    DIM cFg     AS STRING = " + qt + "#e0def4" + qt + "\n"
        s = s + "    DIM cAccent AS STRING = " + qt + "#7dcfff" + qt + "\n"
        s = s + "    DIM cBorder AS STRING = " + qt + "#3b3d5e" + qt + "\n"
        s = s + "    DIM cHl     AS STRING = " + qt + "#2d4f67" + qt + "\n"
        s = s + "    DIM cClose  AS STRING = " + qt + "#f9e2af" + qt + "\n"
        s = s + "    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)\n"
        s = s + "    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)\n"
        s = s + "    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)\n"
        s = s + "    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)\n"
        ' Body — single line for now; Phase 4 can wrap multi-line.
        s = s + "    DIM body AS STRING = bodyStyle.Render(msg)\n"
        ' Button row.
        s = s + "    DIM totalW AS INTEGER = 0\n"
        s = s + "    DIM bi AS INTEGER\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        totalW = totalW + lipgloss.Width(" + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + ")\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2\n"
        s = s + "    NEXT bi\n"
        s = s + "    DIM padBtn AS INTEGER = innerW - totalW\n"
        s = s + "    IF padBtn < 0 THEN padBtn = 0\n"
        s = s + "    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" + qt + " " + qt + ", padBtn))\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        DIM lbl AS STRING = " + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + "\n"
        s = s + "        IF bi = activeIdx THEN\n"
        s = s + "            btnRow = btnRow + btnActive.Render(lbl)\n"
        s = s + "        ELSE\n"
        s = s + "            btnRow = btnRow + btnStyle.Render(lbl)\n"
        s = s + "        END IF\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render(" + qt + "  " + qt + ")\n"
        s = s + "    NEXT bi\n"
        ' Stack body / spacer / buttons, wrap in a frame with the top
        ' border suppressed; lipgloss draws the sides + bottom.
        s = s + "    DIM spacer AS STRING = bodyStyle.Render(" + qt + " " + qt + ")\n"
        s = s + "    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, body, spacer, btnRow)\n"
        s = s + "    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)\n"
        s = s + "    DIM bodyStr AS STRING = frame.Render(stacked)\n"
        s = s + "    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)\n"
        ' Hand-rolled top border: ╭─ Title ─…─ ✕ ╮ — title embedded
        ' left, ✕ embedded one cell in from the right corner.
        s = s + "    DIM titleTxt AS STRING = " + qt + " " + qt + " + title + " + qt + " " + qt + "\n"
        s = s + "    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)\n"
        s = s + "    DIM dashLen AS INTEGER = totalDW - titleLen - 6\n"
        s = s + "    IF dashLen < 0 THEN dashLen = 0\n"
        s = s + "    DIM topBorder AS STRING = borderStyle.Render(" + qt + "╭─" + qt + ") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat(" + qt + "─" + qt + ", dashLen) + " + qt + " " + qt + ") + closeStyle.Render(" + qt + "✕" + qt + ") + borderStyle.Render(" + qt + " ╮" + qt + ")\n"
        s = s + "    RETURN topBorder + " + qt + "\\n" + qt + " + bodyStr\n"
        s = s + "END FUNCTION\n"

        ' fdRenderInput — input-kind dialog renderer. Same outer
        ' frame as fdRenderConfirm: hand-rolled top border carrying
        ' title + ✕, BorderTop(FALSE) lipgloss frame around the
        ' stacked content. Content rows (between the inner padding):
        '   row 0: prompt
        '   row 1: spacer
        '   row 2: text field (single row, flat background)
        '   row 3: spacer
        '   row 4: OK/Cancel button row
        ' onField=TRUE shows the █ cursor in the field; activeIdx
        ' (-1 when onField=TRUE) picks the highlighted button.
        s = s + "\n"
        s = s + "FUNCTION fdRenderInput(title AS STRING, prompt AS STRING, txt AS STRING, onField AS BOOLEAN, activeIdx AS INTEGER) AS STRING\n"
        s = s + "    DIM innerW AS INTEGER = 48\n"
        s = s + "    DIM cBg     AS STRING = " + qt + "#1a1b2e" + qt + "\n"
        s = s + "    DIM cFg     AS STRING = " + qt + "#e0def4" + qt + "\n"
        s = s + "    DIM cAccent AS STRING = " + qt + "#7dcfff" + qt + "\n"
        s = s + "    DIM cBorder AS STRING = " + qt + "#3b3d5e" + qt + "\n"
        s = s + "    DIM cHl     AS STRING = " + qt + "#2d4f67" + qt + "\n"
        s = s + "    DIM cClose  AS STRING = " + qt + "#f9e2af" + qt + "\n"
        s = s + "    DIM cField  AS STRING = " + qt + "#11121f" + qt + "\n"
        s = s + "    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)\n"
        s = s + "    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)\n"
        s = s + "    DIM fieldStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cField)).Width(innerW)\n"
        s = s + "    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)\n"
        s = s + "    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)\n"
        ' Prompt row + field row (flat box, dark background; cursor
        ' shown when focused).
        s = s + "    DIM promptRow AS STRING = bodyStyle.Render(prompt)\n"
        s = s + "    DIM fieldTxt AS STRING = " + qt + " " + qt + " + txt\n"
        s = s + "    IF onField THEN fieldTxt = fieldTxt + " + qt + "█" + qt + "\n"
        s = s + "    DIM fieldRow AS STRING = fieldStyle.Render(fieldTxt)\n"
        ' Hard-coded OK/Cancel button row (right-justified).
        s = s + "    DIM buttons AS []STRING\n"
        s = s + "    buttons = APPEND(buttons, " + qt + "OK" + qt + ")\n"
        s = s + "    buttons = APPEND(buttons, " + qt + "Cancel" + qt + ")\n"
        s = s + "    DIM totalW AS INTEGER = 0\n"
        s = s + "    DIM bi AS INTEGER\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        totalW = totalW + lipgloss.Width(" + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + ")\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2\n"
        s = s + "    NEXT bi\n"
        s = s + "    DIM padBtn AS INTEGER = innerW - totalW\n"
        s = s + "    IF padBtn < 0 THEN padBtn = 0\n"
        s = s + "    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" + qt + " " + qt + ", padBtn))\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        DIM lbl AS STRING = " + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + "\n"
        s = s + "        IF bi = activeIdx THEN\n"
        s = s + "            btnRow = btnRow + btnActive.Render(lbl)\n"
        s = s + "        ELSE\n"
        s = s + "            btnRow = btnRow + btnStyle.Render(lbl)\n"
        s = s + "        END IF\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render(" + qt + "  " + qt + ")\n"
        s = s + "    NEXT bi\n"
        ' Stack prompt / spacer / field / spacer / buttons, wrap in
        ' the same BorderTop(FALSE) frame as fdRenderConfirm.
        s = s + "    DIM spacer AS STRING = bodyStyle.Render(" + qt + " " + qt + ")\n"
        s = s + "    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, promptRow, spacer, fieldRow, spacer, btnRow)\n"
        s = s + "    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)\n"
        s = s + "    DIM bodyStr AS STRING = frame.Render(stacked)\n"
        s = s + "    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)\n"
        s = s + "    DIM titleTxt AS STRING = " + qt + " " + qt + " + title + " + qt + " " + qt + "\n"
        s = s + "    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)\n"
        s = s + "    DIM dashLen AS INTEGER = totalDW - titleLen - 6\n"
        s = s + "    IF dashLen < 0 THEN dashLen = 0\n"
        s = s + "    DIM topBorder AS STRING = borderStyle.Render(" + qt + "╭─" + qt + ") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat(" + qt + "─" + qt + ", dashLen) + " + qt + " " + qt + ") + closeStyle.Render(" + qt + "✕" + qt + ") + borderStyle.Render(" + qt + " ╮" + qt + ")\n"
        s = s + "    RETURN topBorder + " + qt + "\\n" + qt + " + bodyStr\n"
        s = s + "END FUNCTION\n"
    END IF

    RETURN s
END FUNCTION

' subDefined — TRUE when `userCode` already declares a SUB named
' `name` (case-sensitive). Used so generateUserStubs doesn't
' duplicate handlers the user has already written.
FUNCTION subDefined(userCode AS STRING, name AS STRING) AS BOOLEAN
    DIM needle AS STRING = "SUB " + name + "("
    RETURN strings.Contains(userCode, needle)
END FUNCTION

' ensureSubSig — if `userCode` already declares `SUB <name>(...)`,
' rewrite ONLY that signature line so its parameter list matches
' `wantSig`, leaving the body untouched. Returns the patched code
' (unchanged if the stub is absent or already matches).
'
' This keeps a Dialog's auto-generated _Close stub in sync when the
' user flips the dialog kind in the designer: confirm uses
' `(button AS STRING)` while input uses `(button AS STRING, text AS
' STRING)`, and the generated call sites change arity to match. Go
' does not flag unused parameters, so widening a preserved stub is
' always build-safe; narrowing only breaks if the user's own body
' referenced the dropped parameter, which is their edit to own.
FUNCTION ensureSubSig(userCode AS STRING, name AS STRING, wantSig AS STRING) AS STRING
    DIM marker AS STRING = "SUB " + name + "("
    DIM at AS INTEGER = strings.Index(userCode, marker)
    IF at < 0 THEN RETURN userCode      ' stub not present — nothing to fix
    ' Length of the signature line (from the "SUB" up to, but not
    ' including, its terminating newline). strings.Index is 0-based;
    ' Mid is 1-based, so position at+1 == 0-based offset `at`.
    DIM rest AS STRING = Mid(userCode, at + 1, LEN(userCode) - at)
    DIM nl AS INTEGER = strings.Index(rest, "\n")
    IF nl < 0 THEN nl = LEN(rest)        ' signature runs to end of file
    DIM oldLine AS STRING = Mid(userCode, at + 1, nl)
    DIM newLine AS STRING = "SUB " + name + wantSig
    IF oldLine = newLine THEN RETURN userCode   ' already correct
    DIM prefix AS STRING = Mid(userCode, 1, at)
    DIM suffix AS STRING = Mid(userCode, at + nl + 1, LEN(userCode) - (at + nl))
    RETURN prefix + newLine + suffix
END FUNCTION

' generateUserStubs — produce the user section. On a fresh form
' (existingUser empty) seed it with a friendly preamble + an empty
' SUB <name>_Click() for every Button. On subsequent regens, keep
' the existing content verbatim and append stubs for any handler
' the user hasn't already written (e.g. a Button added since last
' run). Never rewrites or deletes existing content.
FUNCTION generateUserStubs(f AS DesignForm, existingUser AS STRING) AS STRING
    DIM out AS STRING = existingUser
    IF out = "" THEN
        ' Fresh user section: a one-line guide + a blank line.
        out = "' Your code below — DBtui preserves everything here on F5.\n\n"
    END IF
    DIM trailing AS BOOLEAN = strings.HasSuffix(out, "\n")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(f.Widgets) - 1
        DIM w AS DesignWidget = f.Widgets[i]
        DIM stubName AS STRING = ""
        DIM stubLabel AS STRING = ""
        DIM stubSig AS STRING = "()"
        DIM stubBody AS STRING = "    ' TODO: your code here.\n"
        IF w.Kind = "Button" THEN
            stubName = w.Name + "_Click"
            stubLabel = "Click"
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" OR w.Kind = "ComboBox" OR w.Kind = "ListBox" OR w.Kind = "ScrollBar" OR w.Kind = "TabStrip" OR w.Kind = "Tree" OR w.Kind = "PropGrid" THEN
            stubName = w.Name + "_Change"
            stubLabel = "Change"
        ELSEIF w.Kind = "Dialog" THEN
            stubName  = w.Name + "_Close"
            stubLabel = "Close"
            DIM stubK AS STRING = w.DialogKind
            IF stubK = "" THEN stubK = "confirm"
            IF stubK = "input" THEN
                stubSig   = "(button AS STRING, text AS STRING)"
                stubBody  = "    ' Called when the user dismisses " + w.Name + ".\n"
                stubBody  = stubBody + "    ' `button` is the label clicked (" + Chr(34) + "OK" + Chr(34) + "/" + Chr(34) + "Cancel" + Chr(34) + ") or " + Chr(34) + Chr(34) + "\n"
                stubBody  = stubBody + "    ' for Esc / ✕ close. `text` is the value the user typed.\n"
                stubBody  = stubBody + "    _ = button\n"
                stubBody  = stubBody + "    _ = text\n"
            ELSE
                stubSig   = "(button AS STRING)"
                stubBody  = "    ' Called when the user dismisses " + w.Name + ".\n"
                stubBody  = stubBody + "    ' `button` is the label clicked (e.g. " + Chr(34) + "OK" + Chr(34) + "), or " + Chr(34) + Chr(34) + "\n"
                stubBody  = stubBody + "    ' for Esc / ✕ close. Add your branching code here.\n"
                stubBody  = stubBody + "    _ = button\n"
            END IF
        ELSEIF w.Kind = "Menubar" THEN
            stubName  = w.Name + "_Select"
            stubLabel = "Select"
            stubSig   = "(item AS STRING)"
            stubBody  = "    ' Called when a menu item is chosen from " + w.Name + ".\n"
            stubBody  = stubBody + "    ' `item` is the selected item's label.\n"
            stubBody  = stubBody + "    _ = item\n"
        END IF
        ' A Dialog's _Close arity depends on its kind, and the kind can
        ' change between regens. If the stub already exists, repair its
        ' signature in place so it matches the current call sites.
        IF w.Kind = "Dialog" THEN
            out = ensureSubSig(out, stubName, stubSig)
        END IF
        IF stubName <> "" AND w.Parent = "" AND NOT subDefined(out, stubName) THEN
            IF NOT trailing THEN out = out + "\n"
            IF NOT strings.HasSuffix(out, "\n\n") THEN out = out + "\n"
            out = out + "' " + stubLabel + " handler for " + w.Name + " — edit freely.\n"
            out = out + "SUB " + stubName + stubSig + "\n"
            out = out + stubBody
            out = out + "END SUB\n"
            trailing = TRUE
        END IF
    NEXT i
    RETURN out
END FUNCTION

' extractUserSection — read `path` (if it exists) and return the
' content after the user marker. If the file is missing or the
' marker is absent (fresh form, or user nuked the marker), return
' the empty string — caller will seed a fresh user section.
FUNCTION extractUserSection(path AS STRING) AS STRING
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN RETURN ""
    DIM src AS STRING = string(data)
    DIM idx AS INTEGER = strings.Index(src, formUserMarker)
    IF idx < 0 THEN RETURN ""
    ' Skip the marker line itself plus its trailing newline so the
    ' returned section starts at the first user-owned byte.
    DIM after AS INTEGER = idx + LEN(formUserMarker)
    IF after < LEN(src) AND Mid(src, after + 1, 1) = "\n" THEN after = after + 1
    IF after >= LEN(src) THEN RETURN ""
    RETURN Mid(src, after + 1, LEN(src) - after)
END FUNCTION

' mergeFormDbas — build the final .dbas content by composing a
' fresh prelude (from the design), the user marker line, and the
' preserved/augmented user section (handlers). Idempotent: running
' it twice on the same form against its own output is a no-op.
FUNCTION mergeFormDbas(f AS DesignForm, existingPath AS STRING) AS STRING
    DIM prelude    AS STRING = generateFormPrelude(f)
    DIM existing   AS STRING = extractUserSection(existingPath)
    DIM userSection AS STRING = generateUserStubs(f, existing)
    DIM out AS STRING = prelude
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    ' One blank line before the marker line, exactly one newline
    ' after it. extractUserSection consumes that single newline so
    ' the round-trip is idempotent (running mergeFormDbas on its
    ' own output produces byte-identical bytes).
    out = out + "\n" + formUserMarker + "\n"
    out = out + userSection
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    RETURN out
END FUNCTION

' formOutputPath — where doFormRun / gen writes the partner .dbas
' for a form within a project. Multi-form projects get one .dbas per
' form named <stem>_<formName>.dbas to keep their handler sections
' separate; single-form projects keep the legacy <stem>.dbas path.
FUNCTION formOutputPath(projectPath AS STRING, formName AS STRING, formCount AS INTEGER) AS STRING
    DIM stem AS STRING = strings.TrimSuffix(projectPath, ".dbproj")
    IF formCount > 1 AND formName <> "" THEN
        RETURN stem + "_" + formName + ".dbas"
    END IF
    RETURN stem + ".dbas"
END FUNCTION

' doFormRun — F5 in form mode. Saves the .dbproj, regenerates the
' partner .dbas for the ACTIVE form (per-form file in multi-form
' projects), hands the terminal to dbasic run.
FUNCTION doFormRun(m AS POINTER TO Model) AS tea.Cmd
    IF m.Tabs[m.TabIdx].Path = "" THEN
        m.Status = "save the form first (Ctrl+S)"
        RETURN NIL
    END IF
    saveForm(m)
    ' Pull form count from disk so single-form projects still emit
    ' <stem>.dbas (legacy) and multi-form projects get per-form files.
    DIM proj AS Project
    DIM pok  AS BOOLEAN
    DIM ureason AS STRING
    proj, pok, ureason = readProjectFromDisk(m.Tabs[m.TabIdx].Path)
    _ = ureason
    DIM nForms AS INTEGER = 1
    IF pok THEN nForms = LEN(proj.Forms)
    DIM outPath AS STRING = formOutputPath(m.Tabs[m.TabIdx].Path, m.Tabs[m.TabIdx].FormName, nForms)
    DIM code AS STRING = mergeFormDbas(m.Tabs[m.TabIdx].Form, outPath)
    DIM werr AS ERROR = os.WriteFile(outPath, Encode(code), 0644)
    IF werr <> NIL THEN
        m.Status = "write " + outPath + ": " + werr.Error()
        RETURN NIL
    END IF
    m.Status = "running dbasic run " + outPath
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "run", outPath)
    RETURN tea.ExecProcess(cmd, runFinishedHandler)
END FUNCTION
