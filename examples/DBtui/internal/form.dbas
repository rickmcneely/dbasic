' =========================================================================
' Form designer — visual canvas + palette + hit-test + drag.
'
' v1 scope:
'   - Single in-memory Form on Model.
'   - Four widget kinds: Button / Label / TextInput / Checkbox.
'   - Click palette item → append widget at canvas (2, 1).
'   - Click widget on canvas → select.
'   - Drag selected widget → move (DragMode = "formMove").
'   - Selected widget highlighted; properties shown in right pane.
'
' Persistence + codegen come in a follow-up.
' =========================================================================

CONST formPaletteKinds AS INTEGER = 18  ' Button, Label, TextInput, Checkbox,
                                        ' RadioButton, ComboBox, ListBox,
                                        ' ProgressBar, ScrollBar, Dialog,
                                        ' TabStrip, Tree, TextArea, PropGrid,
                                        ' ScrollPanel, Menubar, StatusBar,
                                        ' Panel

' formKindByIdx — fixed list of widget kinds in palette display order.
' The order is the order entries appear in the right-pane Widgets
' panel; index 0 = top of the palette.
' Palette order is ALPHABETICAL (drives both the Widgets-pane display and
' the click-to-add mapping — they share this single source). Adding a kind:
' insert it alphabetically and bump formPaletteKinds.
FUNCTION formKindByIdx(i AS INTEGER) AS STRING
    IF i = 0 THEN RETURN "Button"
    IF i = 1 THEN RETURN "Checkbox"
    IF i = 2 THEN RETURN "ComboBox"
    IF i = 3 THEN RETURN "Dialog"
    IF i = 4 THEN RETURN "Label"
    IF i = 5 THEN RETURN "ListBox"
    IF i = 6 THEN RETURN "Menubar"
    IF i = 7 THEN RETURN "Panel"
    IF i = 8 THEN RETURN "ProgressBar"
    IF i = 9 THEN RETURN "PropGrid"
    IF i = 10 THEN RETURN "RadioButton"
    IF i = 11 THEN RETURN "ScrollBar"
    IF i = 12 THEN RETURN "ScrollPanel"
    IF i = 13 THEN RETURN "StatusBar"
    IF i = 14 THEN RETURN "TabStrip"
    IF i = 15 THEN RETURN "TextArea"
    IF i = 16 THEN RETURN "TextInput"
    IF i = 17 THEN RETURN "Tree"
    RETURN ""
END FUNCTION

' formPaletteCount — palette entry count, exposed as a function because the
' main module's analyzer can't see CONSTs from INCLUDEd files.
FUNCTION formPaletteCount() AS INTEGER
    RETURN formPaletteKinds
END FUNCTION

' defaultWidget — produce a widget of the given kind with sensible
' default text / size / state; caller picks Name + (X, Y).
FUNCTION defaultWidget(kind AS STRING) AS DesignWidget
    DIM w AS DesignWidget
    w.Kind = kind
    w.W = 12
    w.H = 1
    IF kind = "Button" THEN
        RETURN buttonDefault(w)
    ELSEIF kind = "Label" THEN
        RETURN labelDefault(w)
    ELSEIF kind = "TextInput" THEN
        RETURN textInputDefault(w)
    ELSEIF kind = "Checkbox" THEN
        RETURN checkboxDefault(w)
    ELSEIF kind = "RadioButton" THEN
        RETURN radioButtonDefault(w)
    ELSEIF kind = "ComboBox" THEN
        RETURN comboBoxDefault(w)
    ELSEIF kind = "ListBox" THEN
        RETURN listBoxDefault(w)
    ELSEIF kind = "ProgressBar" THEN
        RETURN progressBarDefault(w)
    ELSEIF kind = "ScrollBar" THEN
        w.Text   = ""
        w.W      = 1
        w.H      = 8
        w.Min    = 0
        w.Max    = 100
        w.Value  = 0
        w.Orient = "v"
    ELSEIF kind = "Dialog" THEN
        RETURN dialogDefault(w)
    ELSEIF kind = "TabStrip" THEN
        RETURN tabStripDefault(w)
    ELSEIF kind = "Tree" THEN
        RETURN treeDefault(w)
    ELSEIF kind = "TextArea" THEN
        RETURN textAreaDefault(w)
    ELSEIF kind = "PropGrid" THEN
        RETURN propGridDefault(w)
    ELSEIF kind = "ScrollPanel" THEN
        RETURN scrollPanelDefault(w)
    ELSEIF kind = "Menubar" THEN
        RETURN menubarDefault(w)
    ELSEIF kind = "StatusBar" THEN
        RETURN statusBarDefault(w)
    ELSEIF kind = "Panel" THEN
        RETURN panelDefault(w)
    END IF
    RETURN w
END FUNCTION

' formAddWidget — append a new widget of `kind` to the form, auto-name
' it, position at (2, 1). Selects the new widget.
SUB formAddWidget(m AS POINTER TO Model, kind AS STRING)
    DIM w AS DesignWidget = defaultWidget(kind)
    ' Auto-name: lower-case kind + index. E.g. "button1".
    DIM prefix AS STRING = strings.ToLower(kind)
    DIM n AS INTEGER = 1
    DO WHILE TRUE
        DIM cand AS STRING = prefix + strconv.Itoa(n)
        DIM clash AS BOOLEAN = FALSE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
            IF m.Tabs[m.TabIdx].Form.Widgets[i].Name = cand THEN clash = TRUE
        NEXT i
        IF NOT clash THEN
            w.Name = cand
            EXIT DO
        END IF
        n = n + 1
    LOOP
    w.X = 2
    w.Y = 1 + LEN(m.Tabs[m.TabIdx].Form.Widgets)
    IF w.Y < 1 THEN w.Y = 1
    m.Tabs[m.TabIdx].Form.Widgets = APPEND(m.Tabs[m.TabIdx].Form.Widgets, w)
    m.Tabs[m.TabIdx].SelWidget = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
    m.Status = "added " + w.Name
END SUB

' formDeleteSelected — drop the currently-selected widget.
' --- Selection helpers (single + multi) --------------------------------
' The selection is SelSet when non-empty (multi-select via ctrl-click),
' otherwise just SelWidget. formSelected returns the unified list.

FUNCTION formSelected(m AS POINTER TO Model) AS []INTEGER
    DIM r AS []INTEGER
    IF LEN(m.Tabs[m.TabIdx].SelSet) > 0 THEN RETURN m.Tabs[m.TabIdx].SelSet
    IF m.Tabs[m.TabIdx].SelWidget >= 0 THEN r = APPEND(r, m.Tabs[m.TabIdx].SelWidget)
    RETURN r
END FUNCTION

FUNCTION formIsSelected(m AS POINTER TO Model, idx AS INTEGER) AS BOOLEAN
    DIM sel AS []INTEGER = formSelected(m)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(sel) - 1
        IF sel[i] = idx THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' Single-select idx (or clear, idx<0). Drops any multi-selection.
SUB formSelectOne(m AS POINTER TO Model, idx AS INTEGER)
    m.Tabs[m.TabIdx].SelWidget = idx
    m.Tabs[m.TabIdx].SelSet = NIL
END SUB

' Toggle idx in the multi-selection; SelWidget stays the primary (the last
' one added, or another remaining member / -1 when the primary is removed).
SUB formSelToggle(m AS POINTER TO Model, idx AS INTEGER)
    IF idx < 0 THEN RETURN
    DIM cur AS []INTEGER = formSelected(m)
    DIM newset AS []INTEGER
    DIM present AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(cur) - 1
        IF cur[i] = idx THEN
            present = TRUE
        ELSE
            newset = APPEND(newset, cur[i])
        END IF
    NEXT i
    IF NOT present THEN
        newset = APPEND(newset, idx)
        m.Tabs[m.TabIdx].SelWidget = idx
    ELSE
        IF LEN(newset) > 0 THEN
            m.Tabs[m.TabIdx].SelWidget = newset[0]
        ELSE
            m.Tabs[m.TabIdx].SelWidget = 0 - 1
        END IF
    END IF
    m.Tabs[m.TabIdx].SelSet = newset
END SUB

' Delete every selected widget (descending order keeps indices valid).
SUB formDeleteSelected(m AS POINTER TO Model)
    DIM sel AS []INTEGER = formSelected(m)
    IF LEN(sel) = 0 THEN RETURN
    DIM kept AS []DesignWidget
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        DIM drop AS BOOLEAN = FALSE
        DIM j AS INTEGER
        FOR j = 0 TO LEN(sel) - 1
            IF sel[j] = i THEN drop = TRUE
        NEXT j
        IF NOT drop THEN kept = APPEND(kept, m.Tabs[m.TabIdx].Form.Widgets[i])
    NEXT i
    m.Tabs[m.TabIdx].Form.Widgets = kept
    m.Tabs[m.TabIdx].SelWidget = 0 - 1
    m.Tabs[m.TabIdx].SelSet = NIL
    IF LEN(sel) = 1 THEN
        m.Status = "widget deleted"
    ELSE
        m.Status = fmt.Sprintf("%d widgets deleted", LEN(sel))
    END IF
END SUB

' tabStripBar — render a TabStrip's tab row: each tab as " label ",
' the active one as "[label]", joined by "│" and padded out to width.
' Shared by the design-time canvas; the generated runtime builds the
' same string inline so the two views match.
FUNCTION tabStripBar(items AS []STRING, active AS INTEGER, width AS INTEGER) AS STRING
    DIM bar AS STRING = ""
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(items) - 1
        IF ti > 0 THEN bar = bar + "│"
        IF ti = active THEN
            bar = bar + "[" + items[ti] + "]"
        ELSE
            bar = bar + " " + items[ti] + " "
        END IF
    NEXT ti
    DIM bw AS INTEGER = lipgloss.Width(bar)
    IF bw < width THEN bar = bar + strings.Repeat(" ", width - bw)
    RETURN bar
END FUNCTION

' treeDepth — count leading '-' characters in a Tree node entry; each
' dash is one level of nesting. treeLabel returns the entry with that
' depth prefix stripped. Shared by the canvas + the codegen so the two
' agree on how a node string decodes.
FUNCTION treeDepth(item AS STRING) AS INTEGER
    DIM d AS INTEGER = 0
    DO WHILE d < LEN(item) AND Mid(item, d + 1, 1) = "-"
        d = d + 1
    LOOP
    RETURN d
END FUNCTION

FUNCTION treeLabel(item AS STRING) AS STRING
    DIM d AS INTEGER = treeDepth(item)
    RETURN Mid(item, d + 1, LEN(item) - d)
END FUNCTION

' statusBarText joins StatusBar segments with │ for display.
' menubarTitles renders a Menubar's depth-0 entries as a " title "
' strip (design-time, no active highlight). Both shared by the canvas.
FUNCTION statusBarText(items AS []STRING) AS STRING
    RETURN strings.Join(items, " │ ")
END FUNCTION

FUNCTION menubarTitles(items AS []STRING) AS STRING
    DIM bar AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN bar = bar + " " + treeLabel(items[i]) + " "
    NEXT i
    RETURN bar
END FUNCTION

' Menubar Items decode (codegen-side). A depth-0 entry is a menu
' title; the depth-1 entries after it are its items.
FUNCTION menubarMenuCount(items AS []STRING) AS INTEGER
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN c = c + 1
    NEXT i
    RETURN c
END FUNCTION

FUNCTION menubarTitleAt(items AS []STRING, k AS INTEGER) AS STRING
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            IF c = k THEN RETURN treeLabel(items[i])
            c = c + 1
        END IF
    NEXT i
    RETURN ""
END FUNCTION

FUNCTION menubarItemsAt(items AS []STRING, k AS INTEGER) AS []STRING
    DIM out AS []STRING
    DIM c AS INTEGER = 0 - 1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            c = c + 1
        ELSEIF c = k THEN
            out = APPEND(out, treeLabel(items[i]))
        END IF
    NEXT i
    RETURN out
END FUNCTION

' menubarColAt — column offset of the k-th title within the title bar,
' where each title occupies width(label)+2 cells.
FUNCTION menubarColAt(items AS []STRING, k AS INTEGER) AS INTEGER
    DIM col AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        IF treeDepth(items[i]) = 0 THEN
            IF c = k THEN RETURN col
            col = col + lipgloss.Width(treeLabel(items[i])) + 2
            c = c + 1
        END IF
    NEXT i
    RETURN col
END FUNCTION

' =========================================================================
' Structured menu-tree helpers — operate on a Menubar widget's []MenuNode
' (see TYPE MenuNode in dbtui.dbas). The tree is a flat list ordered by a
' pre-order walk; a node's children are the following nodes one level
' deeper, until a node at the same or shallower depth. Shared by the Menu
' Editor (Phase 2), the canvas preview, and the runtime codegen (Phase 3).
' =========================================================================

' menuTopCount — number of top-level (Depth = 0) titles on the bar.
FUNCTION menuTopCount(nodes AS []MenuNode) AS INTEGER
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Depth = 0 THEN c = c + 1
    NEXT i
    RETURN c
END FUNCTION

' menuTopTitles — the title strip " File  Edit  Help " for the design-time
' canvas preview (no active highlight). Separators at depth 0 are skipped.
FUNCTION menuTopTitles(nodes AS []MenuNode) AS STRING
    DIM bar AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Depth = 0 AND NOT nodes[i].IsSep THEN
            bar = bar + " " + nodes[i].Caption + " "
        END IF
    NEXT i
    RETURN bar
END FUNCTION

' menuChildIdxs — indices of the DIRECT children of the node at parentIdx.
' Pass parentIdx < 0 to get the top-level (Depth = 0) node indices. Direct
' children are nodes exactly one level deeper in the run that follows,
' stopping at the first node at parentIdx's depth or shallower.
FUNCTION menuChildIdxs(nodes AS []MenuNode, parentIdx AS INTEGER) AS []INTEGER
    DIM out AS []INTEGER
    IF parentIdx < 0 THEN
        DIM t AS INTEGER
        FOR t = 0 TO LEN(nodes) - 1
            IF nodes[t].Depth = 0 THEN out = APPEND(out, t)
        NEXT t
        RETURN out
    END IF
    IF parentIdx >= LEN(nodes) THEN RETURN out
    DIM pd AS INTEGER = nodes[parentIdx].Depth
    DIM i AS INTEGER
    FOR i = parentIdx + 1 TO LEN(nodes) - 1
        IF nodes[i].Depth <= pd THEN RETURN out
        IF nodes[i].Depth = pd + 1 THEN out = APPEND(out, i)
    NEXT i
    RETURN out
END FUNCTION

' menuIsSubmenu — TRUE if the node at idx has children (the next node is
' deeper), i.e. it opens a submenu rather than firing a handler.
FUNCTION menuIsSubmenu(nodes AS []MenuNode, idx AS INTEGER) AS BOOLEAN
    IF idx < 0 OR idx + 1 >= LEN(nodes) THEN RETURN FALSE
    RETURN nodes[idx + 1].Depth > nodes[idx].Depth
END FUNCTION

' menuColAt — column offset of the k-th top-level title within the bar,
' where each title occupies width(caption)+2 cells (matches menuTopTitles).
FUNCTION menuColAt(nodes AS []MenuNode, k AS INTEGER) AS INTEGER
    DIM col AS INTEGER = 0
    DIM c AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF nodes[i].Depth = 0 AND NOT nodes[i].IsSep THEN
            IF c = k THEN RETURN col
            col = col + lipgloss.Width(nodes[i].Caption) + 2
            c = c + 1
        END IF
    NEXT i
    RETURN col
END FUNCTION

' menuSanitizeIdent — keep only [A-Za-z0-9] from s, title-casing each word
' boundary so "Save As…" → "SaveAs". Returns "" if nothing survives.
FUNCTION menuSanitizeIdent(s AS STRING) AS STRING
    DIM alnum AS STRING = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    DIM out AS STRING = ""
    DIM upNext AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 1 TO LEN(s)
        DIM ch AS STRING = Mid(s, i, 1)
        IF strings.Contains(alnum, ch) THEN
            IF upNext THEN
                out = out + strings.ToUpper(ch)
                upNext = FALSE
            ELSE
                out = out + ch
            END IF
        ELSE
            IF out <> "" THEN upNext = TRUE
        END IF
    NEXT i
    RETURN out
END FUNCTION

' menuAutoName — a unique handler-stem identifier for a menu node, derived
' from its caption: "mnu" + sanitized caption, suffixed with a number if it
' would collide with anything in `existing`. Falls back to "mnuItem".
FUNCTION menuAutoName(caption AS STRING, existing AS []STRING) AS STRING
    DIM stem AS STRING = "mnu" + menuSanitizeIdent(caption)
    IF stem = "mnu" THEN stem = "mnuItem"
    DIM cand AS STRING = stem
    DIM n AS INTEGER = 2
    DO WHILE menuNameTaken(existing, cand)
        cand = stem + strconv.Itoa(n)
        n = n + 1
    LOOP
    RETURN cand
END FUNCTION

' menuNameTaken — case-sensitive membership test over a name list.
FUNCTION menuNameTaken(names AS []STRING, want AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(names) - 1
        IF names[i] = want THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' menuNodeNames — the current Name of every non-separator node, for
' uniqueness checks when auto-naming a new node.
FUNCTION menuNodeNames(nodes AS []MenuNode) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(nodes) - 1
        IF NOT nodes[i].IsSep AND nodes[i].Name <> "" THEN out = APPEND(out, nodes[i].Name)
    NEXT i
    RETURN out
END FUNCTION

' menuFromDashItems — migrate a legacy dash-encoded Menubar Items list
' (depth = leading-dash count, label = remainder) into structured nodes,
' auto-naming each non-separator node. A label of "-" (after dashes) or ""
' becomes a separator. Used by readProjectFromDisk for old .dbproj files.
FUNCTION menuFromDashItems(items AS []STRING) AS []MenuNode
    DIM out AS []MenuNode
    DIM names AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(items) - 1
        DIM nd AS MenuNode
        nd.Depth = treeDepth(items[i])
        DIM lbl AS STRING = treeLabel(items[i])
        IF lbl = "" OR lbl = "-" OR lbl = "─" THEN
            nd.IsSep = TRUE
        ELSE
            nd.Caption = lbl
            nd.Name = menuAutoName(lbl, names)
            names = APPEND(names, nd.Name)
        END IF
        out = APPEND(out, nd)
    NEXT i
    RETURN out
END FUNCTION

' panelContentBottom — the lowest (Y + H) among a Panel's children, in
' absolute form rows. Used to size the scroll range.
FUNCTION panelContentBottom(widgets AS []DesignWidget, panelName AS STRING) AS INTEGER
    DIM maxB AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(widgets) - 1
        IF widgets[i].Parent = panelName THEN
            DIM b AS INTEGER = widgets[i].Y + widgets[i].H
            IF b > maxB THEN maxB = b
        END IF
    NEXT i
    RETURN maxB
END FUNCTION

' propKey / propVal split a PropGrid "key=value" Items entry on the
' first '='. A missing '=' makes the whole entry the key with an empty
' value. Shared by the canvas + codegen.
FUNCTION propKey(item AS STRING) AS STRING
    DIM idx AS INTEGER = strings.Index(item, "=")
    IF idx < 0 THEN RETURN item
    RETURN Mid(item, 1, idx)
END FUNCTION

FUNCTION propVal(item AS STRING) AS STRING
    DIM idx AS INTEGER = strings.Index(item, "=")
    IF idx < 0 THEN RETURN ""
    RETURN Mid(item, idx + 2, LEN(item) - idx - 1)
END FUNCTION

' widgetVisibleText — single-line preview for a widget. Used by the
' generated code and by widgetVisibleLines for simple kinds.
FUNCTION widgetVisibleText(w AS DesignWidget) AS STRING
    IF w.Kind = "Button"    THEN RETURN buttonVisibleText(w)
    IF w.Kind = "Label"     THEN RETURN labelVisibleText(w)
    IF w.Kind = "TextInput" THEN RETURN textInputVisibleText(w)
    IF w.Kind = "Checkbox"    THEN RETURN checkboxVisibleText(w)
    IF w.Kind = "RadioButton" THEN RETURN radioButtonVisibleText(w)
    IF w.Kind = "ComboBox" THEN RETURN comboBoxVisibleText(w)
    IF w.Kind = "ProgressBar" THEN RETURN progressBarVisibleText(w)
    IF w.Kind = "ScrollBar" THEN RETURN scrollBarVisibleText(w)
    IF w.Kind = "TabStrip" THEN RETURN tabStripVisibleText(w)
    IF w.Kind = "Tree" THEN RETURN treeVisibleText(w)
    IF w.Kind = "TextArea" THEN RETURN textAreaVisibleText(w)
    IF w.Kind = "PropGrid" THEN RETURN propGridVisibleText(w)
    IF w.Kind = "ScrollPanel" THEN RETURN scrollPanelVisibleText(w)
    IF w.Kind = "StatusBar" THEN RETURN statusBarVisibleText(w)
    IF w.Kind = "Menubar"   THEN RETURN menubarVisibleText(w)
    IF w.Kind = "Panel"     THEN RETURN "┌" + strings.Repeat("─", w.W - 2) + "┐"
    IF w.Kind = "Dialog" THEN RETURN dialogVisibleText(w)
    RETURN w.Text
END FUNCTION

' widgetVisibleLines — multi-row design-time render. ListBox spans
' H rows; ScrollBar spans H rows; everything else delegates to
' widgetVisibleText for one line. The canvas painter walks the
' returned slice and writes each row to the grid at (X, Y + i).
FUNCTION widgetVisibleLines(w AS DesignWidget) AS []STRING
    DIM lines AS []STRING
    IF w.Kind = "ListBox" THEN
        lines = listBoxVisibleLines(w)
    ELSEIF w.Kind = "ScrollBar" AND strings.ToLower(w.Orient) = "v" THEN
        lines = scrollBarVisibleLines(w)
    ELSEIF w.Kind = "TabStrip" THEN
        lines = tabStripVisibleLines(w)
    ELSEIF w.Kind = "Tree" THEN
        lines = treeVisibleLines(w)
    ELSEIF w.Kind = "TextArea" THEN
        lines = textAreaVisibleLines(w)
    ELSEIF w.Kind = "PropGrid" THEN
        ' One row per key/value pair: ▶ cursor marker + key padded to a
        ' half-width column + │ separator + value. Capped at H.
        DIM gh AS INTEGER = w.H
        IF gh < 1 THEN gh = 1
        DIM keyW AS INTEGER = (w.W - 4) / 2
        IF keyW < 1 THEN keyW = 1
        DIM gri AS INTEGER
        FOR gri = 0 TO gh - 1
            DIM gline AS STRING = ""
            IF gri < LEN(w.Items) THEN
                DIM gk AS STRING = propKey(w.Items[gri])
                DIM gv AS STRING = propVal(w.Items[gri])
                IF lipgloss.Width(gk) > keyW THEN gk = Mid(gk, 1, keyW)
                IF lipgloss.Width(gk) < keyW THEN gk = gk + strings.Repeat(" ", keyW - lipgloss.Width(gk))
                DIM gmark AS STRING = "  "
                IF gri = w.Selected THEN gmark = "▶ "
                gline = gmark + gk + "│ " + gv
            END IF
            IF lipgloss.Width(gline) > w.W THEN gline = Mid(gline, 1, w.W)
            IF lipgloss.Width(gline) < w.W THEN gline = gline + strings.Repeat(" ", w.W - lipgloss.Width(gline))
            lines = APPEND(lines, gline)
        NEXT gri
    ELSEIF w.Kind = "Panel" THEN
        lines = panelVisibleLines(w)
    ELSEIF w.Kind = "ScrollPanel" THEN
        ' Framed box: top border, H-2 content rows (each = content text
        ' + a scrollbar cell), bottom border. Design-time shows the top
        ' of the content (scroll = 0) with the thumb parked at the top.
        DIM spw AS INTEGER = w.W
        IF spw < 4 THEN spw = 4
        DIM sph AS INTEGER = w.H
        IF sph < 3 THEN sph = 3
        DIM spVisible AS INTEGER = sph - 2
        DIM spContentW AS INTEGER = spw - 3
        IF spContentW < 1 THEN spContentW = 1
        DIM spTotal AS INTEGER = LEN(w.Items)
        DIM spMaxS AS INTEGER = spTotal - spVisible
        IF spMaxS < 0 THEN spMaxS = 0
        DIM spTrack AS INTEGER = spVisible - 2
        DIM spThumb AS INTEGER = 0 - 1
        IF spMaxS > 0 AND spTrack > 0 THEN spThumb = 0
        lines = APPEND(lines, "┌" + strings.Repeat("─", spw - 2) + "┐")
        DIM spi AS INTEGER
        FOR spi = 0 TO spVisible - 1
            DIM spcl AS STRING = ""
            IF spi < spTotal THEN spcl = w.Items[spi]
            IF lipgloss.Width(spcl) > spContentW THEN spcl = Mid(spcl, 1, spContentW)
            IF lipgloss.Width(spcl) < spContentW THEN spcl = spcl + strings.Repeat(" ", spContentW - lipgloss.Width(spcl))
            DIM spsb AS STRING = "░"
            IF spi = 0 THEN spsb = "▲"
            IF spi = spVisible - 1 THEN spsb = "▼"
            IF spi >= 1 AND spi <= spVisible - 2 AND (spi - 1) = spThumb THEN spsb = "█"
            lines = APPEND(lines, "│" + spcl + spsb + "│")
        NEXT spi
        lines = APPEND(lines, "└" + strings.Repeat("─", spw - 2) + "┘")
    ELSE
        lines = APPEND(lines, widgetVisibleText(w))
    END IF
    RETURN lines
END FUNCTION

' widgetBox — bounding box of widget in canvas coordinates:
' (x0, y0, x1, y1) with x1/y1 exclusive.
FUNCTION widgetBox(w AS DesignWidget) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    DIM txt AS STRING = widgetVisibleText(w)
    DIM ww AS INTEGER = lipgloss.Width(txt)
    IF w.W > ww THEN ww = w.W
    DIM hh AS INTEGER = w.H
    IF hh < 1 THEN hh = 1
    RETURN w.X, w.Y, w.X + ww, w.Y + hh
END FUNCTION

' formWidgetAt — index of the topmost widget whose box contains
' canvas coords (cx, cy), or -1 if none. Walks back-to-front so
' later (drawn-on-top) widgets win.
FUNCTION formWidgetAt(m AS Model, cx AS INTEGER, cy AS INTEGER) AS INTEGER
    IF NOT hasActiveTab(m) THEN RETURN 0 - 1
    DIM i AS INTEGER
    FOR i = LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1 TO 0 STEP 0 - 1
        DIM x0 AS INTEGER
        DIM y0 AS INTEGER
        DIM x1 AS INTEGER
        DIM y1 AS INTEGER
        x0, y0, x1, y1 = widgetBox(m.Tabs[m.TabIdx].Form.Widgets[i])
        IF cx >= x0 AND cx < x1 AND cy >= y0 AND cy < y1 THEN RETURN i
    NEXT i
    RETURN 0 - 1
END FUNCTION

' formScreenToCanvas — translate screen coords to canvas coords
' assuming the canvas starts at (LeftW, 2) and we keep a 1-cell
' top margin for the title row.
FUNCTION formScreenToCanvas(m AS Model, sx AS INTEGER, sy AS INTEGER) AS (INTEGER, INTEGER)
    DIM cx AS INTEGER = sx - m.LeftW
    DIM cy AS INTEGER = sy - 2 - 1   ' minus caption (1) + title row (1)
    RETURN cx, cy
END FUNCTION

' renderFormCanvas — middle-pane body when ViewMode = "form".
' Renders the title row then paints each widget at its (X, Y).
FUNCTION renderFormCanvas(m AS Model, width AS INTEGER, height AS INTEGER) AS STRING
    ' No active tab → return a blank canvas instead of crashing.
    IF NOT hasActiveTab(m) THEN
        DIM bg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cBorder)).Width(width).Height(height).Align(lipgloss.Center, lipgloss.Center)
        RETURN bg.Render("(no form open — open a .dbproj from the tree)")
    END IF
    DIM cellBg AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cAccent)).Bold(TRUE).Width(width)
    DIM widStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg)).Foreground(lipgloss.Color(cFg))
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cAccent)).Foreground(lipgloss.Color(cBg)).Bold(TRUE)
    ' Build a grid of plain bg cells then overlay widgets char-by-char.
    DIM gridH AS INTEGER = height - 1   ' minus title row
    IF gridH < 1 THEN gridH = 1
    ' Loop vars hoisted — DBasic codegen drops re-DIM inside nested
    ' ELSEIF/FOR scopes, so we declare every loop iterator once.
    DIM r AS INTEGER
    DIM c AS INTEGER
    DIM grid AS [][]STRING
    FOR r = 0 TO gridH - 1
        DIM row AS []STRING
        FOR c = 0 TO width - 1
            row = APPEND(row, " ")
        NEXT c
        grid = APPEND(grid, row)
    NEXT r
    ' Per-cell selection flag (mirrors grid shape).
    DIM selGrid AS [][]BOOLEAN
    FOR r = 0 TO gridH - 1
        DIM srow AS []BOOLEAN
        FOR c = 0 TO width - 1
            srow = APPEND(srow, FALSE)
        NEXT c
        selGrid = APPEND(selGrid, srow)
    NEXT r
    ' Paint widgets. Multi-row widgets (ListBox, vertical ScrollBar)
    ' return one string per row via widgetVisibleLines.
    '
    ' Important: walk each row UTF-8 codepoint by codepoint, not byte
    ' by byte. The new widgets use multi-byte glyphs (▶ ▲ ▼ │ █ ░);
    ' splitting on bytes would store half-glyphs in adjacent grid
    ' slots and visually shorten the rendered row, letting the
    ' terminal-default bg leak through at the right edge.
    DIM wi AS INTEGER
    FOR wi = 0 TO LEN(m.Tabs[m.TabIdx].Form.Widgets) - 1
        DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[wi]
        DIM rows AS []STRING = widgetVisibleLines(w)
        DIM isSel AS BOOLEAN = formIsSelected(@m, wi)
        DIM rj AS INTEGER
        FOR rj = 0 TO LEN(rows) - 1
            DIM line AS STRING = rows[rj]
            DIM bx AS INTEGER = 0    ' current byte offset into line
            DIM cellCol AS INTEGER = 0  ' current visible cell offset
            DO WHILE bx < LEN(line)
                ' Decode the next UTF-8 codepoint's byte length from
                ' the leading byte: 110xxxxx = 2, 1110xxxx = 3,
                ' 11110xxx = 4, anything else = 1.
                DIM lead AS INTEGER = Asc(Mid(line, bx + 1, 1))
                DIM nb AS INTEGER = 1
                IF lead >= 240 THEN
                    nb = 4
                ELSEIF lead >= 224 THEN
                    nb = 3
                ELSEIF lead >= 192 THEN
                    nb = 2
                END IF
                IF bx + nb > LEN(line) THEN nb = LEN(line) - bx
                DIM cell AS STRING = Mid(line, bx + 1, nb)
                DIM pCol AS INTEGER = w.X + cellCol
                DIM pRow AS INTEGER = w.Y + rj
                IF pRow >= 0 AND pRow < gridH AND pCol >= 0 AND pCol < width THEN
                    grid[pRow][pCol] = cell
                    IF isSel THEN selGrid[pRow][pCol] = TRUE
                END IF
                bx = bx + nb
                cellCol = cellCol + 1
            LOOP
        NEXT rj
    NEXT wi
    ' Resize handle — a ◢ glyph at the selected widget's bottom-right cell.
    ' Dragging it (DragMode "formResize") changes the widget's W/H.
    IF m.Tabs[m.TabIdx].SelWidget >= 0 AND m.Tabs[m.TabIdx].SelWidget < LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
        DIM hsw AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
        DIM hRow AS INTEGER = hsw.Y + hsw.H - 1
        DIM hCol AS INTEGER = hsw.X + hsw.W - 1
        IF hRow >= 0 AND hRow < gridH AND hCol >= 0 AND hCol < width THEN
            grid[hRow][hCol] = "◢"
            selGrid[hRow][hCol] = TRUE
        END IF
    END IF
    ' Render rows.
    DIM lines AS []STRING
    DIM titleLine AS STRING = titleStyle.Render(" " + m.Tabs[m.TabIdx].Form.Title)
    lines = APPEND(lines, titleLine)
    FOR r = 0 TO gridH - 1
        DIM out AS STRING = ""
        DIM runBuf AS STRING = ""
        DIM runIsSel AS BOOLEAN = FALSE
        FOR c = 0 TO width - 1
            DIM ch AS STRING = grid[r][c]
            DIM cellSel AS BOOLEAN = selGrid[r][c]
            IF cellSel <> runIsSel AND runBuf <> "" THEN
                IF runIsSel THEN
                    out = out + selStyle.Render(runBuf)
                ELSE
                    out = out + widStyle.Render(runBuf)
                END IF
                runBuf = ""
            END IF
            runIsSel = cellSel
            runBuf = runBuf + ch
        NEXT c
        IF runBuf <> "" THEN
            IF runIsSel THEN
                out = out + selStyle.Render(runBuf)
            ELSE
                out = out + widStyle.Render(runBuf)
            END IF
        END IF
        _ = cellBg
        lines = APPEND(lines, out)
    NEXT r
    RETURN strings.Join(lines, "\n")
END FUNCTION

' -------------------------------------------------------------------------
' Persistence — .dbproj is a JSON blob of DesignForm.
' -------------------------------------------------------------------------

' newUntitledForm — open a fresh, in-memory form tab so the user has
' a real canvas to drop palette widgets onto. The tab has no on-disk
' path; the first Ctrl+S will pop the Save As modal ("saveform"
' context). Called by the View → Form Designer action so picking
' that menu item from a session full of code tabs Just Works instead
' of silently appending widgets to a code tab's invisible Form field.
SUB newUntitledForm(m AS POINTER TO Model)
    ' Reuse the active tab if it's already a form — no point stacking
    ' a duplicate blank form on top of one the user is working on.
    IF hasActiveTab(^m) THEN
        IF m.Tabs[m.TabIdx].Kind = "form" THEN
            m.ViewMode = "form"
            m.Status = "form designer — " + m.Tabs[m.TabIdx].Path
            RETURN
        END IF
        ' Blur the previous tab's editor so only one cursor blinks.
        m.Tabs[m.TabIdx].Editor.Blur()
    END IF
    DIM nf AS DesignForm
    nf.Name  = "frmStart"
    nf.Title = "frmStart"
    DIM nt AS Tab
    nt.Path      = ""
    nt.Kind      = "form"
    nt.Form      = nf
    nt.FormName  = "frmStart"
    nt.SelWidget = 0 - 1
    m.Tabs   = APPEND(m.Tabs, nt)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    m.Status = "new form — click a palette item to add widgets"
END SUB

' readProjectFromDisk — parse `path` as a .dbproj JSON file into a
' Project value. Handles both shapes: the new Project format and the
' legacy single-DesignForm format (auto-wrapped). Returns (proj, ok,
' reason). On ok=FALSE, `reason` is a short human-readable string
' the caller can show in the status bar so the user can tell whether
' the file is missing, empty, or malformed.
' migrateProjectMenus — upgrade any legacy Menubar widget (dash-encoded
' Items, empty Menu) in `p` to the structured Menu tree, clearing Items so
' the old field stops being the source of truth. Idempotent: a widget that
' already has a Menu is left untouched.
SUB migrateProjectMenus(p AS POINTER TO Project)
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(p.Forms) - 1
        DIM wi AS INTEGER
        FOR wi = 0 TO LEN(p.Forms[fi].Widgets) - 1
            IF p.Forms[fi].Widgets[wi].Kind = "Menubar" THEN
                IF LEN(p.Forms[fi].Widgets[wi].Menu) = 0 AND LEN(p.Forms[fi].Widgets[wi].Items) > 0 THEN
                    p.Forms[fi].Widgets[wi].Menu = menuFromDashItems(p.Forms[fi].Widgets[wi].Items)
                    p.Forms[fi].Widgets[wi].Items = NIL
                END IF
            END IF
        NEXT wi
    NEXT fi
END SUB

FUNCTION readProjectFromDisk(path AS STRING) AS (Project, BOOLEAN, STRING)
    DIM emptyProj AS Project
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN RETURN emptyProj, FALSE, "read failed: " + rerr.Error()
    IF LEN(data) = 0 THEN RETURN emptyProj, FALSE, "file is empty (0 bytes)"
    ' Try the new Project shape first.
    DIM p AS Project
    DIM jerr AS ERROR = encjson.Unmarshal(data, @p)
    IF jerr = NIL AND LEN(p.Forms) > 0 THEN
        ' Looks like a Project — every form must have a Name; the
        ' codegen and tab system key on it. Auto-name any blanks.
        DIM nameI AS INTEGER
        FOR nameI = 0 TO LEN(p.Forms) - 1
            IF p.Forms[nameI].Name = "" THEN
                p.Forms[nameI].Name = "frm" + strconv.Itoa(nameI + 1)
            END IF
        NEXT nameI
        IF p.StartForm = "" THEN p.StartForm = p.Forms[0].Name
        migrateProjectMenus(@p)
        RETURN p, TRUE, ""
    END IF
    ' Fall back to legacy single-DesignForm and wrap in a Project.
    DIM legacy AS DesignForm
    DIM jerr2 AS ERROR = encjson.Unmarshal(data, @legacy)
    IF jerr2 <> NIL THEN
        DIM reason AS STRING = "invalid JSON: " + jerr2.Error()
        IF jerr <> NIL THEN reason = "invalid JSON: " + jerr.Error()
        RETURN emptyProj, FALSE, reason
    END IF
    IF legacy.Name = "" THEN legacy.Name = "frmStart"
    DIM wrap AS Project
    wrap.Forms     = APPEND(wrap.Forms, legacy)
    wrap.StartForm = legacy.Name
    migrateProjectMenus(@wrap)
    RETURN wrap, TRUE, ""
END FUNCTION

' findFormByName — locate a form within a project by Name. Returns
' (form, idx, ok). idx is the position within proj.Forms.
FUNCTION findFormByName(proj AS Project, name AS STRING) AS (DesignForm, INTEGER, BOOLEAN)
    DIM empty AS DesignForm
    DIM i AS INTEGER
    FOR i = 0 TO LEN(proj.Forms) - 1
        IF proj.Forms[i].Name = name THEN RETURN proj.Forms[i], i, TRUE
    NEXT i
    RETURN empty, 0 - 1, FALSE
END FUNCTION

' writeProjectToDisk — JSON-marshal `proj` to `path` (pretty-printed).
' Refuses to write 0-byte payloads (defensive: a valid Project marshals
' to at least "{}", so empty output means something went wrong upstream).
SUB writeProjectToDisk(path AS STRING, proj AS Project, status AS POINTER TO STRING)
    DIM data AS BYTES
    DIM merr AS ERROR
    data, merr = encjson.MarshalIndent(proj, "", "  ")
    IF merr <> NIL THEN
        ^status = "marshal failed: " + merr.Error()
        RETURN
    END IF
    IF LEN(data) = 0 THEN
        ^status = "marshal returned 0 bytes — refusing to write empty " + path
        RETURN
    END IF
    DIM werr AS ERROR = os.WriteFile(path, data, 0644)
    IF werr <> NIL THEN
        ^status = "save failed: " + werr.Error()
        RETURN
    END IF
    ^status = fmt.Sprintf("saved project %s (%d bytes, %d forms)", path, LEN(data), LEN(proj.Forms))
END SUB

' addFormToActiveProject — append a fresh DesignForm to the project
' owned by the active tab, save the project to disk, and open the
' new form in its own tab. Auto-names the new form frmN where N is
' the next free index. When the active tab isn't a saved form,
' falls back to newUntitledForm.
SUB addFormToActiveProject(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) OR m.Tabs[m.TabIdx].Kind <> "form" OR m.Tabs[m.TabIdx].Path = "" THEN
        newUntitledForm(m)
        RETURN
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    DIM proj AS Project
    DIM pok  AS BOOLEAN
    DIM preason AS STRING
    proj, pok, preason = readProjectFromDisk(path)
    IF NOT pok THEN
        m.Status = "couldn't read " + path + " (" + preason + ") — saving the active form first might help"
        RETURN
    END IF
    ' Find a free frmN slot.
    DIM idx AS INTEGER = LEN(proj.Forms) + 1
    DIM cand AS STRING = "frm" + strconv.Itoa(idx)
    DO WHILE TRUE
        DIM exists AS BOOLEAN = FALSE
        DIM ci AS INTEGER
        FOR ci = 0 TO LEN(proj.Forms) - 1
            IF proj.Forms[ci].Name = cand THEN exists = TRUE
        NEXT ci
        IF NOT exists THEN EXIT DO
        idx = idx + 1
        cand = "frm" + strconv.Itoa(idx)
    LOOP
    DIM nf AS DesignForm
    nf.Name  = cand
    nf.Title = cand
    proj.Forms = APPEND(proj.Forms, nf)
    writeProjectToDisk(path, proj, @m.Status)
    openFormTab(m, path, proj, cand)
END SUB

' loadFormFromDisk — read the .dbproj at `path`, pick the start form
' (or first form if no StartForm), open it as a new form tab. The
' tab's FormName is set so subsequent saves merge back into the
' right slot of the on-disk project.
SUB loadFormFromDisk(m AS POINTER TO Model, path AS STRING)
    DIM proj AS Project
    DIM pok AS BOOLEAN
    DIM lreason AS STRING
    proj, pok, lreason = readProjectFromDisk(path)
    IF NOT pok THEN
        m.Status = "bad .dbproj: " + path + " (" + lreason + ")"
        RETURN
    END IF
    IF LEN(proj.Forms) = 0 THEN
        m.Status = "empty project: " + path
        RETURN
    END IF
    ' Opening a project is a project context switch — re-root the
    ' tree to the project's directory so the sidebar doesn't keep
    ' showing the previous project's files. Skip if we're already
    ' rooted there.
    DIM newRoot AS STRING = dirName(path)
    IF newRoot <> "" AND newRoot <> m.TreeRoot THEN
        m.TreeRoot     = newRoot
        m.TreeExpanded = APPEND(m.TreeExpanded, newRoot)
        buildTreeNodes(m)
        m.TreeSelected = 0
        m.TreeOffset   = 0
    END IF
    DIM startName AS STRING = proj.StartForm
    IF startName = "" THEN startName = proj.Forms[0].Name
    openFormTab(m, path, proj, startName)
END SUB

' openFormTab — shared by loadFormFromDisk and (future) tree-click /
' New Form. If a tab is already editing (path, formName), focus it
' instead of stacking a duplicate. Otherwise create a fresh tab.
SUB openFormTab(m AS POINTER TO Model, path AS STRING, proj AS Project, formName AS STRING)
    DIM picked AS DesignForm
    DIM idx AS INTEGER
    DIM found AS BOOLEAN
    picked, idx, found = findFormByName(proj, formName)
    IF NOT found THEN
        m.Status = "form '" + formName + "' not in " + path
        RETURN
    END IF
    _ = idx
    ' Reuse an existing tab if one's already on this (path, formName).
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[ti].Kind = "form" AND m.Tabs[ti].Path = path AND m.Tabs[ti].FormName = formName THEN
            switchToTab(m, ti)
            RETURN
        END IF
    NEXT ti
    IF hasActiveTab(^m) THEN m.Tabs[m.TabIdx].Editor.Blur()
    DIM t AS Tab
    t.Path      = path
    t.Kind      = "form"
    t.Form      = picked
    t.FormName  = formName
    t.SelWidget = 0 - 1
    m.Tabs   = APPEND(m.Tabs, t)
    m.TabIdx = LEN(m.Tabs) - 1
    m.ViewMode = "form"
    setFocus(m, "tree")
    rebuildMenus(m)
    invalidateEditorCache(m)
    ' Record the .dbproj's mtime so the file-watcher doesn't think the
    ' project was "modified externally" on every tick. Form tabs took a
    ' separate load path that (unlike code tabs) never set LoadedMtime,
    ' so it stayed at the zero time and the watcher prompted forever.
    refreshActiveMtime(m)
    m.Status = "loaded " + formName + " from " + path
END SUB

' saveForm — write the active form back to its .dbproj. For multi-
' form projects this re-reads disk first so other forms aren't
' clobbered; the active form replaces its slot in proj.Forms.
SUB saveForm(m AS POINTER TO Model)
    IF NOT hasActiveTab(^m) THEN RETURN
    IF m.Tabs[m.TabIdx].Path = "" THEN
        DIM sfDir AS STRING
        DIM sfErr AS ERROR
        sfDir, sfErr = os.Getwd()
        IF sfErr <> NIL THEN sfDir = "."
        openBrowser(m, "saveform", "Save Form", "save", sfDir, "form.dbproj")
        RETURN
    END IF
    DIM path AS STRING = m.Tabs[m.TabIdx].Path
    DIM proj AS Project
    DIM pok AS BOOLEAN
    DIM rreason AS STRING
    proj, pok, rreason = readProjectFromDisk(path)
    _ = rreason
    IF NOT pok THEN
        ' File doesn't exist yet (Save As) or was deleted — start a
        ' fresh project containing just this tab's form.
        proj.StartForm = m.Tabs[m.TabIdx].FormName
        IF proj.StartForm = "" THEN proj.StartForm = "frmStart"
    END IF
    ' Pick which form-slot to overwrite: by FormName if the tab has
    ' one, else by Form.Name on the tab's working copy.
    DIM key AS STRING = m.Tabs[m.TabIdx].FormName
    IF key = "" THEN key = m.Tabs[m.TabIdx].Form.Name
    IF key = "" THEN
        key = "frmStart"
        m.Tabs[m.TabIdx].Form.Name = key
    END IF
    ' Mirror the working name onto Form.Name so the on-disk slot
    ' uses the same identifier.
    m.Tabs[m.TabIdx].Form.Name = key
    m.Tabs[m.TabIdx].FormName  = key
    DIM existing AS DesignForm
    DIM eidx AS INTEGER
    DIM efound AS BOOLEAN
    existing, eidx, efound = findFormByName(proj, key)
    _ = existing
    IF efound THEN
        proj.Forms[eidx] = m.Tabs[m.TabIdx].Form
    ELSE
        proj.Forms = APPEND(proj.Forms, m.Tabs[m.TabIdx].Form)
    END IF
    IF proj.StartForm = "" THEN proj.StartForm = key
    writeProjectToDisk(path, proj, @m.Status)
    ' We just wrote the file, so its mtime now post-dates LoadedMtime.
    ' Refresh it so the watcher doesn't flag our own save as an
    ' external edit on the next tick.
    refreshActiveMtime(m)
END SUB

' -------------------------------------------------------------------------
' Widget property editing — clicking a row in the right-pane
' Properties section pops an input modal pre-filled with the current
' value. dispatchModalClose for "wprop:*" applies the edit.
' -------------------------------------------------------------------------

' propRowEditContext — returns (title, prompt, default, modalContext)
' for the input modal that edits Properties row `rowIdx` on widget
' `w`. Returns empty strings when the row index isn't editable
' (row 0 = Kind, read-only) or doesn't exist for this kind.
'
' Row order MUST match the renderer in renderRightPane. Standard
' rows 0-4 are the same for every kind; rows 5+ are kind-specific
' and walked by a cursor so each kind gets a tight, dense layout.
' formHasColors — TRUE when the form or any of its widgets sets a color,
' so codegen knows whether to emit the overlayFocusC helper and the
' colored render path. All-empty forms keep the plain output.
FUNCTION formHasColors(f AS DesignForm) AS BOOLEAN
    IF f.FgColor <> "" OR f.BgColor <> "" THEN RETURN TRUE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(f.Widgets) - 1
        IF f.Widgets[i].FgColor <> "" OR f.Widgets[i].BgColor <> "" THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

FUNCTION propRowEditContext(w AS DesignWidget, rowIdx AS INTEGER) AS (STRING, STRING, STRING, STRING)
    IF rowIdx = 1 THEN RETURN "Edit Name", "Name:", w.Name, "wprop:name"
    IF rowIdx = 2 THEN RETURN "Edit Text", "Text:", w.Text, "wprop:text"
    IF rowIdx = 3 THEN RETURN "Edit Position", "X, Y:", fmt.Sprintf("%d, %d", w.X, w.Y), "wprop:pos"
    IF rowIdx = 4 THEN RETURN "Edit Size", "W, H:", fmt.Sprintf("%d, %d", w.W, w.H), "wprop:size"
    DIM cursor AS INTEGER = 5
    IF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN
            DIM ckDef AS STRING = "false"
            IF w.Checked THEN ckDef = "true"
            RETURN "Edit Checked", "true/false:", ckDef, "wprop:checked"
        END IF
        cursor = cursor + 1
    END IF
    IF w.Kind = "RadioButton" THEN
        IF rowIdx = cursor THEN RETURN "Edit Group", "Group:", w.Group, "wprop:group"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ComboBox" OR w.Kind = "ListBox" THEN
        IF rowIdx = cursor THEN RETURN "Edit Items", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Selected", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ProgressBar" OR w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Min", "Min:", strconv.Itoa(w.Min), "wprop:min"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Max", "Max:", strconv.Itoa(w.Max), "wprop:max"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Value", "Value:", strconv.Itoa(w.Value), "wprop:value"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ScrollBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Orient", "h or v:", w.Orient, "wprop:orient"
        cursor = cursor + 1
    END IF
    IF w.Kind = "TabStrip" THEN
        IF rowIdx = cursor THEN RETURN "Edit Tabs", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Active", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Tree" THEN
        IF rowIdx = cursor THEN RETURN "Edit Nodes", "comma list, '-' = depth:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Cursor", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "PropGrid" THEN
        IF rowIdx = cursor THEN RETURN "Edit Rows", "comma list of key=value:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
        IF rowIdx = cursor THEN RETURN "Edit Cursor", "index (0-based):", strconv.Itoa(w.Selected), "wprop:selected"
        cursor = cursor + 1
    END IF
    IF w.Kind = "ScrollPanel" THEN
        IF rowIdx = cursor THEN RETURN "Edit Content", "comma-separated lines:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Menubar" THEN
        ' Menus open the visual Menu Editor (not an inline text edit); the
        ' value cell just previews the top-level titles. Key "wprop:menus"
        ' is intercepted in formClickPropAt to launch the editor.
        IF rowIdx = cursor THEN RETURN "Edit Menus", "click to open Menu Editor", menuTopTitles(w.Menu), "wprop:menus"
        cursor = cursor + 1
    END IF
    IF w.Kind = "StatusBar" THEN
        IF rowIdx = cursor THEN RETURN "Edit Segments", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Button" THEN
        IF rowIdx = cursor THEN RETURN "OnClick Dialog", "Dialog widget name (blank = none):", w.OnClickDialog, "wprop:onclickdialog"
        cursor = cursor + 1
    END IF
    IF w.Kind = "Dialog" THEN
        DIM dlgK AS STRING = w.DialogKind
        IF dlgK = "" THEN dlgK = "confirm"
        IF rowIdx = cursor THEN RETURN "Edit Dialog Kind", "confirm | input | file:", dlgK, "wprop:dialogkind"
        cursor = cursor + 1
        IF dlgK = "confirm" THEN
            IF rowIdx = cursor THEN RETURN "Edit Message", "Body text:", w.DialogMsg, "wprop:dialogmsg"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Buttons", "comma-separated:", strings.Join(w.Items, ", "), "wprop:items"
        ELSEIF dlgK = "input" THEN
            IF rowIdx = cursor THEN RETURN "Edit Prompt", "Prompt:", w.DialogMsg, "wprop:dialogmsg"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Default", "Default value:", w.DialogDef, "wprop:dialogdef"
        ELSEIF dlgK = "file" THEN
            DIM fm2 AS STRING = w.DialogMode
            IF fm2 = "" THEN fm2 = "open"
            IF rowIdx = cursor THEN RETURN "Edit Mode", "open | save:", fm2, "wprop:dialogmode"
            cursor = cursor + 1
            IF rowIdx = cursor THEN RETURN "Edit Mask", "Glob, e.g. *.dbas:", w.DialogMask, "wprop:dialogmask"
        END IF
    END IF
    ' Universal trailing row: container membership. A Panel can't be a
    ' child (no nesting in v1).
    IF w.Kind <> "Panel" THEN
        IF rowIdx = cursor THEN RETURN "Edit Parent", "container Panel name (blank = none):", w.Parent, "wprop:parent"
        cursor = cursor + 1
    END IF
    ' Universal color rows. These don't use the input modal — formClickPropAt
    ' intercepts the "wprop:fgcolor"/"wprop:bgcolor" keys and opens the
    ' 256-color picker instead.
    IF rowIdx = cursor THEN RETURN "Foreground color", "", w.FgColor, "wprop:fgcolor"
    cursor = cursor + 1
    IF rowIdx = cursor THEN RETURN "Background color", "", w.BgColor, "wprop:bgcolor"
    cursor = cursor + 1
    RETURN "", "", "", ""
END FUNCTION

' propRowKind — classify Properties row `rowIdx` on widget `w` into an
' editor kind: "bool" | "enum" | "color" | "text" | "" (not editable).
' For "enum" the second return is a comma-separated option list. Derived
' from propRowEditContext's field key so the row layout lives in one place.
FUNCTION propRowKind(w AS DesignWidget, rowIdx AS INTEGER) AS (STRING, STRING)
    DIM t AS STRING
    DIM p AS STRING
    DIM d AS STRING
    DIM k AS STRING
    t, p, d, k = propRowEditContext(w, rowIdx)
    _ = t
    _ = p
    _ = d
    IF k = "" THEN RETURN "", ""
    IF k = "wprop:checked" THEN RETURN "bool", ""
    IF k = "wprop:orient" THEN RETURN "enum", "h,v"
    IF k = "wprop:dialogkind" THEN RETURN "enum", "confirm,input,file"
    IF k = "wprop:dialogmode" THEN RETURN "enum", "open,save"
    IF k = "wprop:fgcolor" OR k = "wprop:bgcolor" THEN RETURN "color", ""
    RETURN "text", ""
END FUNCTION

' formTogglePropBool — flip the boolean property at row `rowIdx` on the
' selected widget (only Checked is a bool today). Marks the tab dirty.
SUB formTogglePropBool(m AS POINTER TO Model, rowIdx AS INTEGER)
    DIM sel AS INTEGER = m.Tabs[m.TabIdx].SelWidget
    IF sel < 0 OR sel >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    DIM kind AS STRING
    DIM opts AS STRING
    kind, opts = propRowKind(m.Tabs[m.TabIdx].Form.Widgets[sel], rowIdx)
    _ = opts
    IF kind <> "bool" THEN RETURN
    m.Tabs[m.TabIdx].Form.Widgets[sel].Checked = NOT m.Tabs[m.TabIdx].Form.Widgets[sel].Checked
    m.Tabs[m.TabIdx].Dirty = TRUE
END SUB

' formClickPropAt — left-click on Properties row `rowIdx` (0-based). The
' row becomes the selected property (PropSel). Then by kind: text/number
' rows open the input modal, color rows open the swatch picker, a re-click
' on a bool toggles it (double-click), and enum rows only select (the
' multiselect list opens on right-click). Row 0 (Kind) is read-only.
SUB formClickPropAt(m AS POINTER TO Model, rowIdx AS INTEGER)
    ' No widget selected → the pane shows form-level properties. Rows:
    ' 0 = Form name (read-only), 1 = Fg, 2 = Bg. Fg/Bg open the picker.
    IF m.Tabs[m.TabIdx].SelWidget < 0 OR m.Tabs[m.TabIdx].SelWidget >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN
        IF rowIdx = 1 THEN showColorPicker(m, "formfg")
        IF rowIdx = 2 THEN showColorPicker(m, "formbg")
        RETURN
    END IF
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[m.Tabs[m.TabIdx].SelWidget]
    DIM ctxTitle AS STRING
    DIM ctxPrompt AS STRING
    DIM ctxDef AS STRING
    DIM ctxKey AS STRING
    ctxTitle, ctxPrompt, ctxDef, ctxKey = propRowEditContext(w, rowIdx)
    ' ctxDef (the row's current value) is unused here: the inline editor and
    ' the escalation dialog both seed from the live field / inline buffer.
    _ = ctxDef
    IF ctxKey = "" THEN RETURN
    DIM kind AS STRING
    DIM opts AS STRING
    kind, opts = propRowKind(w, rowIdx)
    _ = opts
    DIM wasSel AS BOOLEAN = (m.PropSel = rowIdx)
    m.PropSel = rowIdx
    ' Menubar menus row → open the visual Menu Editor instead of a text edit.
    IF ctxKey = "wprop:menus" THEN
        IF m.PropEdit THEN cancelInlinePropEdit(m)
        showMenuEditor(m, m.Tabs[m.TabIdx].SelWidget)
        RETURN
    END IF
    IF kind = "bool" THEN
        ' Second click on an already-selected bool toggles it (double-click).
        IF m.PropEdit THEN cancelInlinePropEdit(m)
        IF wasSel THEN formTogglePropBool(m, rowIdx)
        RETURN
    END IF
    IF kind = "enum" THEN
        ' Left-click selects only; the list opens on right-click.
        IF m.PropEdit THEN cancelInlinePropEdit(m)
        RETURN
    END IF
    ' Color rows open the swatch picker rather than a text input.
    IF ctxKey = "wprop:fgcolor" THEN
        IF m.PropEdit THEN cancelInlinePropEdit(m)
        showColorPicker(m, "fg")
        RETURN
    END IF
    IF ctxKey = "wprop:bgcolor" THEN
        IF m.PropEdit THEN cancelInlinePropEdit(m)
        showColorPicker(m, "bg")
        RETURN
    END IF
    ' Text / number rows: a single click edits the value cell in place; a
    ' second click on the row already being edited escalates to the roomy
    ' input dialog (good for long values). Switching from a different row's
    ' inline edit commits that one first.
    IF m.PropEdit AND m.PropEditRow = rowIdx THEN
        DIM cur AS STRING = m.PropEditInput.Value()
        m.PropEdit = FALSE
        showInputModal(m, ctxTitle, ctxPrompt, cur, ctxKey)
        RETURN
    END IF
    IF m.PropEdit THEN commitInlinePropEdit(m)
    startInlinePropEdit(m, rowIdx)
END SUB

' parseTwoInts — helper for Pos / Size edits. "X, Y" → (X, Y, ok).
FUNCTION parseTwoInts(s AS STRING) AS (INTEGER, INTEGER, BOOLEAN)
    DIM parts AS []STRING = strings.Split(s, ",")
    IF LEN(parts) <> 2 THEN RETURN 0, 0, FALSE
    DIM a AS INTEGER
    DIM b AS INTEGER
    DIM ae AS ERROR
    DIM be AS ERROR
    a, ae = strconv.Atoi(strings.TrimSpace(parts[0]))
    b, be = strconv.Atoi(strings.TrimSpace(parts[1]))
    IF ae <> NIL OR be <> NIL THEN RETURN 0, 0, FALSE
    RETURN a, b, TRUE
END FUNCTION

' -------------------------------------------------------------------------
' Form codegen — emit a runnable .dbas program from a DesignForm.
' v1 generates a static bubbletea Model that paints each widget at
' its (X, Y); q/Esc/Ctrl+C exits. Future versions will add input
' handlers per widget kind, named identifiers in the Model, etc.
' -------------------------------------------------------------------------

' renameIdentRefs — rename whole-identifier references to a widget in source
' text: replace `oldN` only where it starts an identifier token (preceded by
' a non-word char / start) and is followed by `_` (handler/model-field suffix
' like oldN_Click / m.oldN_ti) or a non-word boundary (bare reference). Avoids
' clobbering longer identifiers (oldNExtra). Also rewrites dialog Show<old>()
' call sites. Used by renameWidgetRefs when a widget is renamed.
FUNCTION renameIdentRefs(src AS STRING, oldN AS STRING, newN AS STRING) AS STRING
    IF oldN = "" OR newN = "" OR oldN = newN THEN RETURN src
    DIM word AS STRING = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    DIM oldLen AS INTEGER = LEN(oldN)
    DIM out AS STRING = ""
    DIM i AS INTEGER = 0
    DO WHILE i < LEN(src)
        DIM rest AS STRING = Mid(src, i + 1, LEN(src) - i)
        IF strings.HasPrefix(rest, oldN) THEN
            DIM prevOk AS BOOLEAN = TRUE
            IF i > 0 THEN
                IF strings.Contains(word, Mid(src, i, 1)) THEN prevOk = FALSE
            END IF
            DIM nextOk AS BOOLEAN = TRUE
            DIM aft AS INTEGER = i + oldLen
            IF aft < LEN(src) THEN
                DIM nc AS STRING = Mid(src, aft + 1, 1)
                IF strings.Contains(word, nc) AND nc <> "_" THEN nextOk = FALSE
            END IF
            IF prevOk AND nextOk THEN
                out = out + newN
                i = i + oldLen
            ELSE
                out = out + Mid(src, i + 1, 1)
                i = i + 1
            END IF
        ELSE
            out = out + Mid(src, i + 1, 1)
            i = i + 1
        END IF
    LOOP
    ' Dialog Show<Name>() call sites (Show + name is concatenated, so the
    ' boundary scan above won't catch the name inside ShowOld().
    out = strings.ReplaceAll(out, "Show" + oldN + "(", "Show" + newN + "(")
    RETURN out
END FUNCTION

' renameWidgetRefs — when widget `oldN` is renamed to `newN`, update every
' reference in the code: each open CODE tab's editor buffer, plus the active
' form's partner .dbas on disk (so F5/save-regen keeps the renamed handlers
' wired). The form designer keeps handler subs named <widget>_<Event> and
' model-field refs m.<widget>_*, so renaming the identifier preserves the
' wiring that regen otherwise breaks.
SUB renameWidgetRefs(m AS POINTER TO Model, oldN AS STRING, newN AS STRING)
    IF oldN = "" OR newN = "" OR oldN = newN THEN RETURN
    ' Partner .dbas path for the active form (so we can avoid double-editing
    ' it if it's also open as a tab).
    DIM partner AS STRING = ""
    IF m.Tabs[m.TabIdx].Path <> "" THEN
        DIM proj AS Project
        DIM pok AS BOOLEAN
        DIM preason AS STRING
        proj, pok, preason = readProjectFromDisk(m.Tabs[m.TabIdx].Path)
        _ = preason
        DIM nForms AS INTEGER = 1
        IF pok THEN nForms = LEN(proj.Forms)
        partner = formOutputPath(m.Tabs[m.TabIdx].Path, m.Tabs[m.TabIdx].FormName, nForms)
    END IF
    DIM partnerOpen AS BOOLEAN = FALSE
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(m.Tabs) - 1
        IF m.Tabs[ti].Kind = "code" THEN
            DIM v AS STRING = m.Tabs[ti].Editor.Value()
            DIM nv AS STRING = renameIdentRefs(v, oldN, newN)
            IF nv <> v THEN
                m.Tabs[ti].Editor.SetValue(nv)
                m.Tabs[ti].Dirty = TRUE
            END IF
            IF m.Tabs[ti].Path = partner AND partner <> "" THEN partnerOpen = TRUE
        END IF
    NEXT ti
    ' Partner .dbas not open in a tab → rewrite its user section on disk.
    IF partner <> "" AND NOT partnerOpen THEN
        DIM data AS BYTES
        DIM rerr AS ERROR
        data, rerr = os.ReadFile(partner)
        IF rerr = NIL THEN
            DIM nv2 AS STRING = renameIdentRefs(string(data), oldN, newN)
            IF nv2 <> string(data) THEN
                DIM werr AS ERROR = os.WriteFile(partner, Encode(nv2), 0644)
                _ = werr
            END IF
        END IF
    END IF
END SUB

' escapeForDBString — backslash-escape backslashes and quotes so the
' string is safe to drop inside a DBasic string literal.
FUNCTION escapeForDBString(s AS STRING) AS STRING
    DIM bsl AS STRING = Chr(92)
    DIM qt  AS STRING = Chr(34)
    DIM out AS STRING = strings.ReplaceAll(s, bsl, bsl + bsl)
    out = strings.ReplaceAll(out, qt, bsl + qt)
    ' Escape control chars so the value stays a single-line DBasic
    ' literal — important for TextArea content that spans lines.
    out = strings.ReplaceAll(out, Chr(10), bsl + "n")
    out = strings.ReplaceAll(out, Chr(13), bsl + "r")
    out = strings.ReplaceAll(out, Chr(9), bsl + "t")
    RETURN out
END FUNCTION

' -------------------------------------------------------------------------
' Codegen — partner .dbas split across a regen-only prelude and a
' preserved user section.
'
' Sentinel marker that splits the partner .dbas into two halves:
'   [ prelude ]   ' regenerated on every F5 — model, view, update,
'                 ' main, dispatchClick, anything DBtui knows how
'                 ' to write itself.
'   [ marker  ]   ' a fixed comment line — do not edit / delete /
'                 ' duplicate; DBtui scans for it byte-for-byte.
'   [ user    ]   ' button handler bodies + anything else the
'                 ' programmer wrote. Preserved across regens.
'
' The marker chosen is verbose on purpose so an accidental match in
' someone else's code is essentially impossible.
' -------------------------------------------------------------------------
CONST formUserMarker AS STRING = "' ===== DBTUI:USER ===== DO NOT EDIT OR DELETE THIS LINE ====="

' widgetPorted — TRUE for widget kinds migrated to the Charm-component +
' lipgloss-layer rendering path. A ported kind renders via a component layer
' (composited over the rows[] base) instead of overlay-painting into rows[];
' its Update forwards messages to the component. Un-ported kinds keep the
' legacy rows[] path until migrated. See [[dbtui_charm_first]].
FUNCTION widgetPorted(kind AS STRING) AS BOOLEAN
    IF widgetComponent(kind) THEN RETURN TRUE
    IF kind = "Label" THEN RETURN TRUE
    IF kind = "Button" THEN RETURN TRUE
    IF kind = "Checkbox" THEN RETURN TRUE
    IF kind = "RadioButton" THEN RETURN TRUE
    IF kind = "TabStrip" THEN RETURN TRUE
    IF kind = "Tree" THEN RETURN TRUE
    IF kind = "ScrollBar" THEN RETURN TRUE
    IF kind = "StatusBar" THEN RETURN TRUE
    IF kind = "Panel" THEN RETURN TRUE
    IF kind = "Menubar" THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' widgetComponent — TRUE for kinds backed by a real bubbles component held as
' a Model field (constructed in Main, rendered via .View(), driven by .Update).
FUNCTION widgetComponent(kind AS STRING) AS BOOLEAN
    IF kind = "TextInput" THEN RETURN TRUE
    IF kind = "TextArea" THEN RETURN TRUE
    IF kind = "ListBox" THEN RETURN TRUE
    IF kind = "ComboBox" THEN RETURN TRUE
    IF kind = "PropGrid" THEN RETURN TRUE
    IF kind = "ScrollPanel" THEN RETURN TRUE
    IF kind = "ProgressBar" THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' widgetForwards — TRUE for component kinds whose runtime input is consumed by
' the component's own Update (so generated Update FORWARDS the msg and returns
' its cmd). ProgressBar is a component but display-only (no input). Lipgloss-
' composed kinds keep their inline key/mouse state logic.
FUNCTION widgetForwards(kind AS STRING) AS BOOLEAN
    IF kind = "ProgressBar" THEN RETURN FALSE
    RETURN widgetComponent(kind)
END FUNCTION

' compSuffix / compPkg — the Model-field suffix and bubbles package alias for
' a component kind. ListBox and ComboBox share the list package.
FUNCTION compSuffix(kind AS STRING) AS STRING
    IF kind = "TextInput" THEN RETURN "_ti"
    IF kind = "TextArea" THEN RETURN "_ta"
    IF kind = "ListBox" THEN RETURN "_lb"
    IF kind = "ComboBox" THEN RETURN "_cb"
    IF kind = "PropGrid" THEN RETURN "_tbl"
    IF kind = "ScrollPanel" THEN RETURN "_vp"
    IF kind = "ProgressBar" THEN RETURN "_pb"
    RETURN "_comp"
END FUNCTION

FUNCTION compPkg(kind AS STRING) AS STRING
    IF kind = "TextInput" THEN RETURN "textinput"
    IF kind = "TextArea" THEN RETURN "textarea"
    IF kind = "ListBox" THEN RETURN "list"
    IF kind = "ComboBox" THEN RETURN "list"
    IF kind = "PropGrid" THEN RETURN "table"
    IF kind = "ScrollPanel" THEN RETURN "viewport"
    IF kind = "ProgressBar" THEN RETURN "progress"
    RETURN ""
END FUNCTION

' compHasFocus — component exposes Focus()/Blur() (so syncFocusComp toggles it).
' list/viewport/progress have no focus state; they just receive forwarded msgs.
FUNCTION compHasFocus(kind AS STRING) AS BOOLEAN
    IF kind = "TextInput" THEN RETURN TRUE
    IF kind = "TextArea" THEN RETURN TRUE
    IF kind = "PropGrid" THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' widgetEmitLayer — emit View code building widget `wv`'s Charm view string +
' a lipgloss layer at its (X,Y,Z). Component kinds render via .View();
' lipgloss-composed kinds reuse their body builder wrapped in compFocusView.
FUNCTION widgetEmitLayer(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, zStr AS STRING, f AS DesignForm, n AS INTEGER, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    IF wv.Kind = "TabStrip" THEN RETURN tabStripEmitLayer(wv, sfx, xs, ys, zStr, qt)
    IF wv.Kind = "Tree" THEN RETURN treeEmitLayer(wv, sfx, xs, ys, zStr, qt)
    IF wv.Kind = "ScrollBar" THEN RETURN scrollBarEmitLayer(wv, sfx, xs, ys, zStr, qt)
    IF wv.Kind = "StatusBar" THEN RETURN statusBarEmitLayer(wv, sfx, xs, ys, zStr, qt)
    IF wv.Kind = "Panel" THEN RETURN panelEmitLayer(wv, sfx, xs, ys, zStr, f, n, qt)
    IF wv.Kind = "Menubar" THEN RETURN menubarEmitLayer(wv, sfx, xs, ys, zStr, qt)
    IF wv.Kind = "ProgressBar" THEN
        ' Render a static fill via ViewAs(percent) (View() would animate from 0).
        DIM rng AS INTEGER = wv.Max - wv.Min
        IF rng < 1 THEN rng = 1
        s = s + "    DIM vw" + sfx + " AS STRING = m." + wv.Name + "_pb.ViewAs(" + fmtFloat(wv.Value - wv.Min, rng) + ")\n"
        s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
        RETURN s
    END IF
    IF widgetComponent(wv.Kind) THEN
        s = s + "    DIM vw" + sfx + " AS STRING = m." + wv.Name + compSuffix(wv.Kind) + ".View()\n"
        s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
        RETURN s
    END IF
    s = s + "    DIM body" + sfx + " AS STRING\n"
    IF wv.Kind = "Checkbox" THEN
        s = s + checkboxEmitView(wv, sfx, qt)
    ELSEIF wv.Kind = "RadioButton" THEN
        s = s + radioButtonEmitView(wv, sfx, qt)
    ELSE
        ' Button / Label: static bracketed/plain text.
        s = s + "    body" + sfx + " = " + qt + escapeForDBString(widgetVisibleText(wv)) + qt + "\n"
    END IF
    s = s + "    DIM vw" + sfx + " AS STRING = compFocusView(body" + sfx + ", m.Focus = " + sfx + ", m.Hover = " + sfx + ")\n"
    s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
    RETURN s
END FUNCTION

' compEmitModelField — the Model declaration for a component kind.
FUNCTION compEmitModelField(w AS DesignWidget) AS STRING
    RETURN "    DIM " + w.Name + compSuffix(w.Kind) + " AS " + compPkg(w.Kind) + ".Model\n"
END FUNCTION

' compEmitInit — construct + size + seed the component in Main.
FUNCTION compEmitInit(w AS DesignWidget, qt AS STRING) AS STRING
    DIM nm AS STRING = w.Name + compSuffix(w.Kind)
    DIM s AS STRING = ""
    IF w.Kind = "TextInput" THEN
        DIM tiw AS INTEGER = w.W - 1
        IF tiw < 1 THEN tiw = 1
        s = s + "    m." + nm + " = textinput.New()\n"
        s = s + "    m." + nm + ".Prompt = " + qt + qt + "\n"
        s = s + "    m." + nm + ".SetWidth(" + strconv.Itoa(tiw) + ")\n"
        IF w.Text <> "" THEN s = s + "    m." + nm + ".SetValue(" + qt + escapeForDBString(w.Text) + qt + ")\n"
    ELSEIF w.Kind = "TextArea" THEN
        s = s + "    m." + nm + " = textarea.New()\n"
        s = s + "    m." + nm + ".SetWidth(" + strconv.Itoa(w.W) + ")\n"
        s = s + "    m." + nm + ".SetHeight(" + strconv.Itoa(w.H) + ")\n"
        IF w.Text <> "" THEN s = s + "    m." + nm + ".SetValue(" + qt + escapeForDBString(w.Text) + qt + ")\n"
    ELSEIF w.Kind = "ListBox" OR w.Kind = "ComboBox" THEN
        s = s + "    DIM items" + w.Name + " AS []list.Item\n"
        DIM li AS INTEGER
        FOR li = 0 TO LEN(w.Items) - 1
            s = s + "    DIM it" + w.Name + strconv.Itoa(li) + " AS _LItem\n"
            s = s + "    it" + w.Name + strconv.Itoa(li) + ".cap = " + qt + escapeForDBString(w.Items[li]) + qt + "\n"
            s = s + "    items" + w.Name + " = APPEND(items" + w.Name + ", it" + w.Name + strconv.Itoa(li) + ")\n"
        NEXT li
        DIM lh AS INTEGER = w.H
        IF w.Kind = "ComboBox" THEN lh = 6
        IF lh < 1 THEN lh = 1
        s = s + "    m." + nm + " = list.New(items" + w.Name + ", _newMenuDelegate(), " + strconv.Itoa(w.W) + ", " + strconv.Itoa(lh) + ")\n"
        s = s + "    m." + nm + ".SetShowHelp(FALSE)\n"
        s = s + "    m." + nm + ".SetShowStatusBar(FALSE)\n"
        s = s + "    m." + nm + ".SetShowTitle(FALSE)\n"
        s = s + "    m." + nm + ".SetFilteringEnabled(FALSE)\n"
        IF w.Selected > 0 THEN s = s + "    m." + nm + ".Select(" + strconv.Itoa(w.Selected) + ")\n"
    ELSEIF w.Kind = "PropGrid" THEN
        DIM colW AS INTEGER = (w.W - 2) / 2
        IF colW < 4 THEN colW = 4
        s = s + "    DIM cols" + w.Name + " AS []table.Column\n"
        s = s + "    DIM ck" + w.Name + " AS table.Column\n"
        s = s + "    ck" + w.Name + ".Title = " + qt + "Key" + qt + "\n"
        s = s + "    ck" + w.Name + ".Width = " + strconv.Itoa(colW) + "\n"
        s = s + "    DIM cv" + w.Name + " AS table.Column\n"
        s = s + "    cv" + w.Name + ".Title = " + qt + "Value" + qt + "\n"
        s = s + "    cv" + w.Name + ".Width = " + strconv.Itoa(colW) + "\n"
        s = s + "    cols" + w.Name + " = APPEND(cols" + w.Name + ", ck" + w.Name + ")\n"
        s = s + "    cols" + w.Name + " = APPEND(cols" + w.Name + ", cv" + w.Name + ")\n"
        s = s + "    DIM rws" + w.Name + " AS []table.Row\n"
        DIM ri AS INTEGER
        FOR ri = 0 TO LEN(w.Items) - 1
            s = s + "    DIM rw" + w.Name + strconv.Itoa(ri) + " AS table.Row\n"
            s = s + "    rw" + w.Name + strconv.Itoa(ri) + " = APPEND(rw" + w.Name + strconv.Itoa(ri) + ", " + qt + escapeForDBString(propKey(w.Items[ri])) + qt + ")\n"
            s = s + "    rw" + w.Name + strconv.Itoa(ri) + " = APPEND(rw" + w.Name + strconv.Itoa(ri) + ", " + qt + escapeForDBString(propVal(w.Items[ri])) + qt + ")\n"
            s = s + "    rws" + w.Name + " = APPEND(rws" + w.Name + ", rw" + w.Name + strconv.Itoa(ri) + ")\n"
        NEXT ri
        s = s + "    m." + nm + " = table.New(table.WithColumns(cols" + w.Name + "), table.WithRows(rws" + w.Name + "), table.WithHeight(" + strconv.Itoa(w.H) + "))\n"
    ELSEIF w.Kind = "ScrollPanel" THEN
        s = s + "    m." + nm + " = viewport.New()\n"
        s = s + "    m." + nm + ".SetWidth(" + strconv.Itoa(w.W) + ")\n"
        s = s + "    m." + nm + ".SetHeight(" + strconv.Itoa(w.H) + ")\n"
        DIM contentExpr AS STRING = qt + qt
        DIM ci AS INTEGER
        FOR ci = 0 TO LEN(w.Items) - 1
            IF ci > 0 THEN contentExpr = contentExpr + " + " + qt + "\\n" + qt
            contentExpr = contentExpr + " + " + qt + escapeForDBString(w.Items[ci]) + qt
        NEXT ci
        s = s + "    m." + nm + ".SetContent(" + contentExpr + ")\n"
    ELSEIF w.Kind = "ProgressBar" THEN
        DIM pw AS INTEGER = w.W
        IF pw < 1 THEN pw = 1
        ' Width only; the fill is drawn statically by ViewAs in the layer.
        s = s + "    m." + nm + " = progress.New()\n"
        s = s + "    m." + nm + ".SetWidth(" + strconv.Itoa(pw) + ")\n"
    END IF
    RETURN s
END FUNCTION

' fmtFloat — emit a float64 decimal literal for num/den, clamped to [0,1]
' (for progress.SetPercent, which expects float64). Computed at codegen as
' thousandths so no runtime float conversion is needed.
FUNCTION fmtFloat(num AS INTEGER, den AS INTEGER) AS STRING
    IF den = 0 THEN RETURN "0.0"
    DIM milli AS INTEGER = (num * 1000) / den
    IF milli < 0 THEN milli = 0
    IF milli > 1000 THEN milli = 1000
    DIM ip AS INTEGER = milli / 1000
    DIM fp AS INTEGER = milli MOD 1000
    DIM fps AS STRING = strconv.Itoa(fp)
    DO WHILE LEN(fps) < 3
        fps = "0" + fps
    LOOP
    RETURN strconv.Itoa(ip) + "." + fps
END FUNCTION

' compEmitForward — Update key/msg forward for a forwarding component kind.
' Fires <Name>_Change when a selection-bearing component's index changes.
FUNCTION compEmitForward(w AS DesignWidget, sfx AS STRING, qt AS STRING) AS STRING
    DIM nm AS STRING = w.Name + compSuffix(w.Kind)
    DIM s AS STRING = ""
    s = s + "            DIM cCmd" + sfx + " AS tea.Cmd\n"
    IF w.Kind = "ListBox" OR w.Kind = "ComboBox" THEN
        s = s + "            DIM prevI" + sfx + " AS INTEGER = m." + nm + ".Index()\n"
        s = s + "            m." + nm + ", cCmd" + sfx + " = m." + nm + ".Update(msg)\n"
        s = s + "            IF m." + nm + ".Index() <> prevI" + sfx + " THEN dispatchChange(" + qt + w.Name + qt + ")\n"
    ELSEIF w.Kind = "PropGrid" THEN
        s = s + "            DIM prevC" + sfx + " AS INTEGER = m." + nm + ".Cursor()\n"
        s = s + "            m." + nm + ", cCmd" + sfx + " = m." + nm + ".Update(msg)\n"
        s = s + "            IF m." + nm + ".Cursor() <> prevC" + sfx + " THEN dispatchChange(" + qt + w.Name + qt + ")\n"
    ELSE
        s = s + "            m." + nm + ", cCmd" + sfx + " = m." + nm + ".Update(msg)\n"
    END IF
    s = s + "            RETURN m, cCmd" + sfx + "\n"
    RETURN s
END FUNCTION

' generateFormPrelude — emit ONLY the generated half of the partner
' .dbas (Model + Init + Update + View + Main + dispatchClick). The
' user-edited handler bodies live below the formUserMarker line and
' are preserved by mergeFormDbas across every F5 regeneration.
FUNCTION generateFormPrelude(f AS DesignForm) AS STRING
    DIM qt AS STRING = Chr(34)
    DIM s  AS STRING = ""
    DIM n  AS INTEGER = LEN(f.Widgets)
    DIM nStr AS STRING = strconv.Itoa(n)
    ' Scan once for Dialog widgets — they need extra plumbing
    ' (lipgloss import, Model fields, Show subs, View overlay).
    DIM hasDialog AS BOOLEAN = FALSE
    DIM hasTree AS BOOLEAN = FALSE
    DIM hasTextArea AS BOOLEAN = FALSE
    DIM hasMenubar AS BOOLEAN = FALSE
    ' Charm-component-backed kinds (migration off hand-rolled overlay painting
    ' onto bubbles components composed as lipgloss layers). Each "ported" kind
    ' pulls in its bubbles package and renders via a component layer instead of
    ' the rows[] buffer; un-ported kinds still paint into rows[] and are layered
    ' under the component layers. See [[dbtui_charm_first]].
    DIM hasTextInput AS BOOLEAN = FALSE
    DIM hasListW AS BOOLEAN = FALSE
    DIM hasTable AS BOOLEAN = FALSE
    DIM hasViewport AS BOOLEAN = FALSE
    DIM hasProgress AS BOOLEAN = FALSE
    DIM scanI AS INTEGER
    FOR scanI = 0 TO n - 1
        IF f.Widgets[scanI].Kind = "Dialog" THEN hasDialog = TRUE
        IF f.Widgets[scanI].Kind = "Tree" THEN hasTree = TRUE
        IF f.Widgets[scanI].Kind = "TextArea" THEN hasTextArea = TRUE
        IF f.Widgets[scanI].Kind = "Menubar" THEN hasMenubar = TRUE
        IF f.Widgets[scanI].Kind = "TextInput" THEN hasTextInput = TRUE
        IF f.Widgets[scanI].Kind = "ListBox" OR f.Widgets[scanI].Kind = "ComboBox" THEN hasListW = TRUE
        IF f.Widgets[scanI].Kind = "PropGrid" THEN hasTable = TRUE
        IF f.Widgets[scanI].Kind = "ScrollPanel" THEN hasViewport = TRUE
        IF f.Widgets[scanI].Kind = "ProgressBar" THEN hasProgress = TRUE
    NEXT scanI
    s = s + "' === GENERATED BY DBtui — rewritten on every F5 (do not edit above the marker) ===\n"
    s = s + "\n"
    s = s + "IMPORT " + qt + "charm.land/bubbletea/v2" + qt + " AS tea\n"
    s = s + "IMPORT " + qt + "fmt" + qt + "\n"
    s = s + "IMPORT " + qt + "os" + qt + "\n"
    s = s + "IMPORT " + qt + "strings" + qt + "\n"
    ' lipgloss is now always imported: the focus highlight (focusStyle,
    ' emitted unconditionally below) styles the focused widget's cells, so
    ' every generated form references lipgloss. (Previously gated on the
    ' kinds that called lipgloss.* at run time.)
    s = s + "IMPORT " + qt + "charm.land/lipgloss/v2" + qt + " AS lipgloss\n"
    ' Charm component packages, pulled in per ported widget kind present.
    IF hasTextInput THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/textinput" + qt + " AS textinput\n"
    IF hasTextArea THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/textarea" + qt + " AS textarea\n"
    IF hasListW THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/list" + qt + " AS list\n"
    IF hasTable THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/table" + qt + " AS table\n"
    IF hasViewport THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/viewport" + qt + " AS viewport\n"
    IF hasProgress THEN s = s + "IMPORT " + qt + "charm.land/bubbles/v2/progress" + qt + " AS progress\n"
    s = s + "\n"
    ' List item type + compact (single-line) delegate, shared by every
    ' ListBox / ComboBox on the form.
    IF hasListW THEN
        s = s + "TYPE _LItem\n"
        s = s + "    DIM cap AS STRING\n"
        s = s + "END TYPE\n"
        s = s + "FUNCTION (i AS _LItem) Title() AS STRING\n"
        s = s + "    RETURN i.cap\n"
        s = s + "END FUNCTION\n"
        s = s + "FUNCTION (i AS _LItem) Description() AS STRING\n"
        s = s + "    RETURN " + qt + qt + "\n"
        s = s + "END FUNCTION\n"
        s = s + "FUNCTION (i AS _LItem) FilterValue() AS STRING\n"
        s = s + "    RETURN i.cap\n"
        s = s + "END FUNCTION\n"
        s = s + "FUNCTION _newMenuDelegate() AS list.DefaultDelegate\n"
        s = s + "    DIM d AS list.DefaultDelegate = list.NewDefaultDelegate()\n"
        s = s + "    d.ShowDescription = FALSE\n"
        s = s + "    d.SetSpacing(0)\n"
        s = s + "    d.SetHeight(1)\n"
        s = s + "    RETURN d\n"
        s = s + "END FUNCTION\n"
        s = s + "\n"
    END IF
    ' fmt is imported pre-emptively so user handlers can call
    ' fmt.Println etc. without adding their own IMPORT line. Go
    ' rejects unused imports, so reference it from an uncalled
    ' SUB to keep the import live even when user code doesn't
    ' touch fmt at all.
    s = s + "SUB _dbtuiKeepFmtAlive()\n"
    s = s + "    _ = fmt.Sprintf(" + qt + qt + ")\n"
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- Model: width/height/focus + one field per stateful widget --
    s = s + "TYPE Model\n"
    s = s + "    DIM Width  AS INTEGER\n"
    s = s + "    DIM Height AS INTEGER\n"
    s = s + "    DIM Focus  AS INTEGER\n"
    ' Hover = the widget index under the mouse cursor (-1 = none). Distinct
    ' from Focus: hovering only highlights (hoverStyle), it never steals
    ' keyboard focus. Seeded to -1 in Main so nothing is hovered at startup.
    s = s + "    DIM Hover  AS INTEGER\n"
    ' HoverTab = index of the hovered tab WITHIN the hovered TabStrip
    ' (-1 = none / not over a tab). Lets tab captions highlight one at a
    ' time instead of the whole bar. Only meaningful while Hover names a
    ' TabStrip; one field suffices since one widget is hovered at a time.
    s = s + "    DIM HoverTab AS INTEGER\n"
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM w AS DesignWidget = f.Widgets[i]
      IF w.Parent = "" THEN
        IF widgetComponent(w.Kind) THEN
            s = s + compEmitModelField(w)
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" THEN
            s = s + "    DIM " + w.Name + "_Val AS BOOLEAN\n"
        ELSEIF w.Kind = "ScrollBar" OR w.Kind = "TabStrip" THEN
            s = s + "    DIM " + w.Name + "_Val AS INTEGER\n"
        ELSEIF w.Kind = "Tree" THEN
            ' Cursor index into the node list + a per-node collapse flag.
            s = s + "    DIM " + w.Name + "_Val AS INTEGER\n"
            s = s + "    DIM " + w.Name + "_Collapsed AS []BOOLEAN\n"
        ELSEIF w.Kind = "ScrollPanel" THEN
            s = s + scrollPanelEmitModel(w)
        ELSEIF w.Kind = "Menubar" THEN
            s = s + menubarEmitModel(w)
        ELSEIF w.Kind = "StatusBar" THEN
            s = s + statusBarEmitModel(w)
        ELSEIF w.Kind = "Panel" THEN
            s = s + panelEmitModel(w)
        ELSEIF w.Kind = "Dialog" THEN
            s = s + dialogEmitModel(w)
        END IF
      END IF
    NEXT i
    s = s + "END TYPE\n"
    s = s + "\n"
    s = s + "FUNCTION (m AS Model) Init() AS tea.Cmd\n"
    s = s + "    RETURN NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- Update: resize, quit (Esc/Ctrl+C), Tab cycle, per-widget ---
    ' Package-level pointer to the current Model — set on every Update
    ' entry so user-defined event handlers (no-arg _Click, _Change,
    ' _Close) can mutate model state via the no-arg Show<Name>() and
    ' similar helpers without us having to thread `m` through every
    ' dispatch path. Only valid for the lifetime of an Update call;
    ' bubbletea copies the Model in/out so it's harmless after that.
    ' _dlg* fields are written by View when a dialog overlay renders;
    ' Update reads them to hit-test clicks against the dialog's actual
    ' on-screen rect.
    ' _currentModel lets no-arg user handlers (_Click / _Change /
    ' _Close / _Select) mutate model state; needed whenever such a
    ' handler might want to (dialogs, and Menubar _Select).
    IF hasDialog OR hasMenubar THEN
        s = s + "DIM _currentModel AS POINTER TO Model\n"
    END IF
    IF hasDialog THEN
        s = s + "DIM _dlgX AS INTEGER\n"
        s = s + "DIM _dlgY AS INTEGER\n"
        s = s + "DIM _dlgW AS INTEGER\n"
        s = s + "DIM _dlgH AS INTEGER\n"
        s = s + "\n"
    END IF
    ' (The open-dropdown box rects are stashed in the _mn* package slices
    ' declared by menubarEmitRuntime — written by View's _mnPaintBoxes,
    ' read by Update's _mnClickHit. No per-form _mb* vars needed now.)
    s = s + "FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)\n"
    IF hasDialog OR hasMenubar THEN
        s = s + "    _currentModel = @m\n"
    END IF
    s = s + "    DIM sz AS tea.WindowSizeMsg\n"
    s = s + "    DIM szOk AS BOOLEAN\n"
    s = s + "    sz, szOk = msg.(tea.WindowSizeMsg)\n"
    s = s + "    IF szOk THEN\n"
    s = s + "        m.Width = sz.Width\n"
    s = s + "        m.Height = sz.Height\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"

    ' --- Dialog / open-menu priority — when a dialog is active or a
    '     Menubar dropdown is open, route keys there first (so e.g. Esc
    '     closes the menu instead of quitting). Dialog: Esc cancels;
    '     Tab/arrows cycle; Enter/Space commits. Menu: arrows navigate;
    '     Enter selects; Esc closes.
    IF hasDialog OR hasMenubar THEN
        s = s + "    DIM kpd AS tea.KeyPressMsg\n"
        s = s + "    DIM kpdOk AS BOOLEAN\n"
        s = s + "    kpd, kpdOk = msg.(tea.KeyPressMsg)\n"
        s = s + "    IF kpdOk THEN\n"
        s = s + "        DIM kpdK AS STRING = kpd.String()\n"
        DIM dlgUI AS INTEGER
        FOR dlgUI = 0 TO n - 1
            DIM dlgUW AS DesignWidget = f.Widgets[dlgUI]
            IF dlgUW.Kind = "Dialog" THEN
                s = s + dialogEmitKeyPriority(dlgUW, qt)
            END IF
        NEXT dlgUI
        ' Open-menu key handling (modal while a dropdown is showing).
        DIM mbKI AS INTEGER
        FOR mbKI = 0 TO n - 1
            DIM mbKW AS DesignWidget = f.Widgets[mbKI]
            IF mbKW.Kind = "Menubar" THEN
                s = s + menubarEmitKeyPriority(mbKW, qt)
            END IF
        NEXT mbKI
        s = s + "    END IF\n"
    END IF
    ' --- Mouse click hit-test — back-to-front so a later (drawn-on-
    '     top) widget wins. Each kind reacts the way its keyboard
    '     handler does, focus follows the click. Hit-test box uses
    '     the design (X, Y, W, H) which matches what the user sees
    '     and was already used for the drag/select in DBtui.
    s = s + "    DIM mc AS tea.MouseClickMsg\n"
    s = s + "    DIM mcOk AS BOOLEAN\n"
    s = s + "    mc, mcOk = msg.(tea.MouseClickMsg)\n"
    s = s + "    IF mcOk AND mc.Button = tea.MouseLeft THEN\n"
    ' Dialog priority — hit-test the active dialog's ✕ glyph + button
    ' row in modal-local coords. Other clicks inside the dialog rect
    ' are swallowed; clicks outside fall through to the widget hit-
    ' tests below (so a stray click outside doesn't get blocked).
    IF hasDialog THEN
        DIM dcI AS INTEGER
        FOR dcI = 0 TO n - 1
            DIM dcW AS DesignWidget = f.Widgets[dcI]
            IF dcW.Kind = "Dialog" THEN
                s = s + dialogEmitClickPriority(dcW, qt)
            END IF
        NEXT dcI
    END IF
    ' Open-menu dropdown-item click priority — hit-test against the
    ' _mb* rect stashed by View (the open dropdown's on-screen box).
    IF hasMenubar THEN
        DIM mbMI AS INTEGER
        FOR mbMI = 0 TO n - 1
            DIM mbMW AS DesignWidget = f.Widgets[mbMI]
            IF mbMW.Kind = "Menubar" THEN
                s = s + menubarEmitClickPriority(mbMW, qt)
            END IF
        NEXT mbMI
    END IF
    ' DBasic identifiers are case-insensitive AND codegen hoists
    ' DIMs to function-scope, so every new local in this generator
    ' has to dodge collisions with the other loops above (mi/mw in
    ' Main-init, di/dw in dispatchClick, etc.). Prefixing with "mc"
    ' for "mouse-click" keeps everything distinct.
    DIM mci AS INTEGER
    FOR mci = n - 1 TO 0 STEP 0 - 1
        DIM mcw AS DesignWidget = f.Widgets[mci]
        DIM mcXs AS STRING = strconv.Itoa(mcw.X)
        DIM mcYs AS STRING = strconv.Itoa(mcw.Y)
        DIM mcWs AS STRING = strconv.Itoa(mcw.W)
        DIM mcHs AS STRING = strconv.Itoa(mcw.H)
        DIM mcIStr AS STRING = strconv.Itoa(mci)
      IF mcw.Parent = "" THEN
        s = s + "        IF mc.X >= " + mcXs + " AND mc.X < " + mcXs + " + " + mcWs + " AND mc.Y >= " + mcYs + " AND mc.Y < " + mcYs + " + " + mcHs + " THEN\n"
        s = s + "            m.Focus = " + mcIStr + "\n"
        IF hasTextInput OR hasTextArea OR hasTable THEN s = s + "            syncFocusComp(@m)\n"
        IF widgetForwards(mcw.Kind) THEN
            ' Component-backed: the click only takes focus (done above);
            ' selection is via keyboard / wheel forwarded to the component.
            ' (Click coords don't map into the component's own space.)
            s = s + "            _ = mc\n"
        ELSEIF mcw.Kind = "Button" THEN
            s = s + buttonEmitMouse(mcw, qt)
        ELSEIF mcw.Kind = "Checkbox" THEN
            s = s + checkboxEmitMouse(mcw, qt)
        ELSEIF mcw.Kind = "RadioButton" THEN
            s = s + radioButtonEmitMouse(mcw, mci, f.Widgets, n, qt)
        ELSEIF mcw.Kind = "ScrollBar" THEN
            s = s + scrollBarEmitMouse(mcw, mcIStr, mcXs, mcYs, mcWs, mcHs, qt)
        ELSEIF mcw.Kind = "Menubar" THEN
            ' Title-row click: pick the menu by column. Clicking the
            ' already-open active menu closes it; otherwise open it.
            s = s + menubarEmitMouse(mcw, mcIStr, mcXs, qt)
        ELSEIF mcw.Kind = "ScrollPanel" THEN
            ' Click the ▲ row (relative Y = 1) scrolls up; the ▼ row
            ' (relative Y = H-2) scrolls down.
            DIM spcVis AS INTEGER = mcw.H - 2
            IF spcVis < 1 THEN spcVis = 1
            DIM spcMax AS INTEGER = LEN(mcw.Items) - spcVis
            IF spcMax < 0 THEN spcMax = 0
            s = s + "            DIM spRel" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
            s = s + "            IF spRel" + mcIStr + " = 1 AND m." + mcw.Name + "_Scroll > 0 THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll - 1\n"
            s = s + "            IF spRel" + mcIStr + " = " + strconv.Itoa(mcw.H - 2) + " AND m." + mcw.Name + "_Scroll < " + strconv.Itoa(spcMax) + " THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll + 1\n"
            ' Track paging: a click on the scrollbar column (relative X =
            ' W-2) between the ▲/▼ arrows (relative Y 2..H-3) pages up if
            ' above the thumb, down if below. Page = one visible window.
            ' Recompute the thumb's track index exactly as the View does.
            DIM spcTrack AS INTEGER = mcw.H - 4
            IF spcTrack > 0 THEN
                s = s + "            DIM spRelX" + mcIStr + " AS INTEGER = mc.X - " + mcXs + "\n"
                s = s + "            IF spRelX" + mcIStr + " = " + strconv.Itoa(mcw.W - 2) + " AND spRel" + mcIStr + " >= 2 AND spRel" + mcIStr + " <= " + strconv.Itoa(mcw.H - 3) + " THEN\n"
                s = s + "                DIM spThm" + mcIStr + " AS INTEGER = 0\n"
                s = s + "                IF " + strconv.Itoa(spcMax) + " > 0 THEN\n"
                s = s + "                    spThm" + mcIStr + " = (m." + mcw.Name + "_Scroll * " + strconv.Itoa(spcTrack - 1) + ") / " + strconv.Itoa(spcMax) + "\n"
                s = s + "                    IF spThm" + mcIStr + " < 0 THEN spThm" + mcIStr + " = 0\n"
                s = s + "                    IF spThm" + mcIStr + " > " + strconv.Itoa(spcTrack - 1) + " THEN spThm" + mcIStr + " = " + strconv.Itoa(spcTrack - 1) + "\n"
                s = s + "                END IF\n"
                s = s + "                DIM spClk" + mcIStr + " AS INTEGER = spRel" + mcIStr + " - 2\n"
                s = s + "                IF spClk" + mcIStr + " < spThm" + mcIStr + " THEN\n"
                s = s + "                    m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll - " + strconv.Itoa(spcVis) + "\n"
                s = s + "                    IF m." + mcw.Name + "_Scroll < 0 THEN m." + mcw.Name + "_Scroll = 0\n"
                s = s + "                END IF\n"
                s = s + "                IF spClk" + mcIStr + " > spThm" + mcIStr + " THEN\n"
                s = s + "                    m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll + " + strconv.Itoa(spcVis) + "\n"
                s = s + "                    IF m." + mcw.Name + "_Scroll > " + strconv.Itoa(spcMax) + " THEN m." + mcw.Name + "_Scroll = " + strconv.Itoa(spcMax) + "\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            END IF
        ELSEIF mcw.Kind = "Tree" THEN
            s = s + treeEmitMouse(mcw, mcIStr, mcYs, qt)
        ELSEIF mcw.Kind = "TabStrip" THEN
            s = s + tabStripEmitMouse(mcw, mcIStr, mcXs, mcYs, qt)
        ELSEIF mcw.Kind = "Panel" THEN
            s = s + panelEmitMouse(mcw, mcIStr, mcYs, f.Widgets, qt)
        ELSE
            ' Label / TextInput / ProgressBar: focus follows the
            ' click but no state change. (TextInput Tier 2.)
            s = s + "            _ = mc\n"
        END IF
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
      END IF
    NEXT mci
    s = s + "    END IF\n"
    ' --- Mouse hover -> highlight (NOT focus) the widget under the cursor.
    '     Sets m.Hover only; keyboard focus (m.Focus) stays put. Moving off
    '     all widgets clears the hover (m.Hover = -1). Needs AllMotion so the
    '     Update handler receives motion events with no button held.
    s = s + "    DIM mm AS tea.MouseMotionMsg\n"
    s = s + "    DIM mmOk AS BOOLEAN\n"
    s = s + "    mm, mmOk = msg.(tea.MouseMotionMsg)\n"
    s = s + "    IF mmOk THEN\n"
    s = s + "        DIM mmHit AS INTEGER = 0 - 1\n"
    DIM mmi AS INTEGER
    FOR mmi = n - 1 TO 0 STEP 0 - 1
        DIM mmw AS DesignWidget = f.Widgets[mmi]
        IF mmw.Parent = "" THEN
            DIM mmXs AS STRING = strconv.Itoa(mmw.X)
            DIM mmYs AS STRING = strconv.Itoa(mmw.Y)
            DIM mmWs AS STRING = strconv.Itoa(mmw.W)
            ' Hover hit-height. TabStrip only hovers on its caption row (the
            ' rest of the strip is the tab body), so its hover rect is 1 row
            ' tall; every other widget uses its full height.
            DIM mmHs AS STRING = strconv.Itoa(mmw.H)
            IF mmw.Kind = "TabStrip" THEN mmHs = "1"
            s = s + "        IF mmHit < 0 AND mm.X >= " + mmXs + " AND mm.X < " + mmXs + " + " + mmWs + " AND mm.Y >= " + mmYs + " AND mm.Y < " + mmYs + " + " + mmHs + " THEN mmHit = " + strconv.Itoa(mmi) + "\n"
        END IF
    NEXT mmi
    s = s + "        _ = mm\n"
    s = s + "        m.Hover = mmHit\n"
    ' Which tab caption is under the cursor? For each TabStrip, walk the
    ' caption segments (each tab = label width + 2 for its [ ]/padding,
    ' plus 1 for the │ separator) and record the matching index. -1 when
    ' the cursor is between tabs or over a non-TabStrip.
    s = s + "        m.HoverTab = 0 - 1\n"
    DIM mmtI AS INTEGER
    FOR mmtI = 0 TO n - 1
        DIM mmtw AS DesignWidget = f.Widgets[mmtI]
        IF mmtw.Kind = "TabStrip" AND mmtw.Parent = "" AND LEN(mmtw.Items) > 0 THEN
            DIM mmtSfx AS STRING = strconv.Itoa(mmtI)
            s = s + "        IF mmHit = " + mmtSfx + " THEN\n"
            s = s + "            DIM thCol" + mmtSfx + " AS INTEGER = mm.X - " + strconv.Itoa(mmtw.X) + "\n"
            s = s + "            DIM thAcc" + mmtSfx + " AS INTEGER = 0\n"
            s = s + "            DIM thW" + mmtSfx + " AS INTEGER = 0\n"
            DIM mmtK AS INTEGER
            FOR mmtK = 0 TO LEN(mmtw.Items) - 1
                s = s + "            thW" + mmtSfx + " = lipgloss.Width(" + qt + escapeForDBString(mmtw.Items[mmtK]) + qt + ") + 2\n"
                s = s + "            IF thCol" + mmtSfx + " >= thAcc" + mmtSfx + " AND thCol" + mmtSfx + " < thAcc" + mmtSfx + " + thW" + mmtSfx + " THEN m.HoverTab = " + strconv.Itoa(mmtK) + "\n"
                s = s + "            thAcc" + mmtSfx + " = thAcc" + mmtSfx + " + thW" + mmtSfx + " + 1\n"
            NEXT mmtK
            s = s + "        END IF\n"
        END IF
    NEXT mmtI
    ' Menubar: which top-level title is under the cursor (reuses m.HoverTab).
    DIM mmnI AS INTEGER
    FOR mmnI = 0 TO n - 1
        IF f.Widgets[mmnI].Kind = "Menubar" AND f.Widgets[mmnI].Parent = "" THEN
            s = s + menubarEmitHoverTab(f.Widgets[mmnI], strconv.Itoa(mmnI), qt)
        END IF
    NEXT mmnI
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    ' --- Mouse wheel -> scroll/move the scrollable widget under the
    '     cursor (listbox/combobox/propgrid/tree selection, scrollbar
    '     value, scrollpanel offset). Mirrors the up/down key handlers.
    s = s + "    DIM mw AS tea.MouseWheelMsg\n"
    s = s + "    DIM mwOk AS BOOLEAN\n"
    s = s + "    mw, mwOk = msg.(tea.MouseWheelMsg)\n"
    s = s + "    IF mwOk THEN\n"
    DIM mwi AS INTEGER
    FOR mwi = n - 1 TO 0 STEP 0 - 1
        DIM mww AS DesignWidget = f.Widgets[mwi]
        DIM mwScroll AS BOOLEAN = (mww.Kind = "ListBox" OR mww.Kind = "ComboBox" OR mww.Kind = "PropGrid" OR mww.Kind = "ScrollBar" OR mww.Kind = "ScrollPanel" OR mww.Kind = "Tree")
        IF mww.Parent = "" AND mwScroll THEN
            DIM mwXs AS STRING = strconv.Itoa(mww.X)
            DIM mwYs AS STRING = strconv.Itoa(mww.Y)
            DIM mwWs AS STRING = strconv.Itoa(mww.W)
            DIM mwHs AS STRING = strconv.Itoa(mww.H)
            DIM mwNm AS STRING = mww.Name
            DIM mwVis AS INTEGER = mww.H - 2
            IF mwVis < 1 THEN mwVis = 1
            DIM mwSpMax AS INTEGER = LEN(mww.Items) - mwVis
            IF mwSpMax < 0 THEN mwSpMax = 0
            s = s + "        IF mw.X >= " + mwXs + " AND mw.X < " + mwXs + " + " + mwWs + " AND mw.Y >= " + mwYs + " AND mw.Y < " + mwYs + " + " + mwHs + " THEN\n"
            IF widgetForwards(mww.Kind) THEN
                ' Component-backed: forward the wheel to the hovered
                ' component's Update (it scrolls / moves selection itself).
                s = s + "            DIM wwc" + strconv.Itoa(mwi) + " AS tea.Cmd\n"
                s = s + "            m." + mwNm + compSuffix(mww.Kind) + ", wwc" + strconv.Itoa(mwi) + " = m." + mwNm + compSuffix(mww.Kind) + ".Update(msg)\n"
                s = s + "            _ = wwc" + strconv.Itoa(mwi) + "\n"
            ELSEIF mww.Kind = "ScrollBar" THEN
                s = s + "            IF mw.Button = tea.MouseWheelUp THEN\n"
                s = s + "                IF m." + mwNm + "_Val > " + strconv.Itoa(mww.Min) + " THEN\n"
                s = s + "                    m." + mwNm + "_Val = m." + mwNm + "_Val - 1\n"
                s = s + "                    dispatchChange(" + qt + mwNm + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            ELSE\n"
                s = s + "                IF m." + mwNm + "_Val < " + strconv.Itoa(mww.Max) + " THEN\n"
                s = s + "                    m." + mwNm + "_Val = m." + mwNm + "_Val + 1\n"
                s = s + "                    dispatchChange(" + qt + mwNm + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            ELSEIF mww.Kind = "ScrollPanel" THEN
                s = s + "            IF mw.Button = tea.MouseWheelUp THEN\n"
                s = s + "                IF m." + mwNm + "_Scroll > 0 THEN m." + mwNm + "_Scroll = m." + mwNm + "_Scroll - 1\n"
                s = s + "            ELSE\n"
                s = s + "                IF m." + mwNm + "_Scroll < " + strconv.Itoa(mwSpMax) + " THEN m." + mwNm + "_Scroll = m." + mwNm + "_Scroll + 1\n"
                s = s + "            END IF\n"
            ELSEIF mww.Kind = "Tree" THEN
                s = s + "            DIM twVis" + mwNm + " AS []INTEGER = treeVisibleRows(" + mwNm + "_depths(), m." + mwNm + "_Collapsed)\n"
                s = s + "            DIM twPos" + mwNm + " AS INTEGER = 0\n"
                s = s + "            DIM twJ" + mwNm + " AS INTEGER\n"
                s = s + "            FOR twJ" + mwNm + " = 0 TO LEN(twVis" + mwNm + ") - 1\n"
                s = s + "                IF twVis" + mwNm + "[twJ" + mwNm + "] = m." + mwNm + "_Val THEN twPos" + mwNm + " = twJ" + mwNm + "\n"
                s = s + "            NEXT twJ" + mwNm + "\n"
                s = s + "            IF mw.Button = tea.MouseWheelUp THEN\n"
                s = s + "                IF twPos" + mwNm + " > 0 THEN\n"
                s = s + "                    m." + mwNm + "_Val = twVis" + mwNm + "[twPos" + mwNm + " - 1]\n"
                s = s + "                    dispatchChange(" + qt + mwNm + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            ELSE\n"
                s = s + "                IF twPos" + mwNm + " < LEN(twVis" + mwNm + ") - 1 THEN\n"
                s = s + "                    m." + mwNm + "_Val = twVis" + mwNm + "[twPos" + mwNm + " + 1]\n"
                s = s + "                    dispatchChange(" + qt + mwNm + qt + ")\n"
                s = s + "                END IF\n"
                s = s + "            END IF\n"
            END IF
            s = s + "            RETURN m, NIL\n"
            s = s + "        END IF\n"
        END IF
    NEXT mwi
    s = s + "        _ = mw\n"
    s = s + "        RETURN m, NIL\n"
    s = s + "    END IF\n"
    s = s + "    DIM k AS tea.KeyPressMsg\n"
    s = s + "    DIM kOk AS BOOLEAN\n"
    s = s + "    k, kOk = msg.(tea.KeyPressMsg)\n"
    s = s + "    IF kOk THEN\n"
    s = s + "        DIM key AS STRING = k.String()\n"
    s = s + "        IF key = " + qt + "ctrl+c" + qt + " OR key = " + qt + "esc" + qt + " THEN RETURN m, tea.Quit\n"
    IF n > 0 THEN
        s = s + "        IF key = " + qt + "tab" + qt + " THEN\n"
        s = s + "            m.Focus = (m.Focus + 1) MOD " + nStr + "\n"
        IF hasTextInput OR hasTextArea OR hasTable THEN s = s + "            syncFocusComp(@m)\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        s = s + "        IF key = " + qt + "shift+tab" + qt + " THEN\n"
        s = s + "            m.Focus = m.Focus - 1\n"
        s = s + "            IF m.Focus < 0 THEN m.Focus = " + strconv.Itoa(n - 1) + "\n"
        IF hasTextInput OR hasTextArea OR hasTable THEN s = s + "            syncFocusComp(@m)\n"
        s = s + "            RETURN m, NIL\n"
        s = s + "        END IF\n"
        ' Per-widget key handling.
        FOR i = 0 TO n - 1
            DIM ww AS DesignWidget = f.Widgets[i]
            DIM iStr AS STRING = strconv.Itoa(i)
          IF ww.Parent = "" THEN
            s = s + "        IF m.Focus = " + iStr + " THEN\n"
            IF widgetForwards(ww.Kind) THEN
                ' Component-backed: forward the message to the component's
                ' own Update (it handles its keys + mouse) and return its cmd.
                s = s + compEmitForward(ww, iStr, qt)
            ELSEIF ww.Kind = "Checkbox" THEN
                s = s + checkboxEmitKey(ww, qt)
            ELSEIF ww.Kind = "RadioButton" THEN
                s = s + radioButtonEmitKey(ww, i, f.Widgets, n, qt)
            ELSEIF ww.Kind = "ScrollBar" THEN
                s = s + scrollBarEmitKey(ww, qt)
            ELSEIF ww.Kind = "TabStrip" THEN
                s = s + tabStripEmitKey(ww, qt)
            ELSEIF ww.Kind = "Menubar" THEN
                s = s + menubarEmitKey(ww, qt)
            ELSEIF ww.Kind = "Tree" THEN
                s = s + treeEmitKey(ww, qt)
            ELSEIF ww.Kind = "Button" THEN
                s = s + buttonEmitKey(ww, qt)
            ELSEIF ww.Kind = "Panel" THEN
                s = s + panelEmitKey(ww, f.Widgets, qt)
            ELSE
                ' Label / ProgressBar / others: no state changes.
                s = s + "            _ = key\n"
            END IF
            ' Forwarding kinds' EmitKey already RETURNs (it returns the
            ' component cmd); everything else needs the trailing swallow-return.
            IF NOT widgetForwards(ww.Kind) THEN s = s + "            RETURN m, NIL\n"
            s = s + "        END IF\n"
          END IF
        NEXT i
    END IF
    s = s + "    END IF\n"
    s = s + "    RETURN m, NIL\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' _blankCanvas — an h-line string of w spaces; the lipgloss base layer
    ' the widget layers composite onto (replaces the old rows[] buffer).
    s = s + "FUNCTION _blankCanvas(w AS INTEGER, h AS INTEGER) AS STRING\n"
    s = s + "    DIM cr AS []STRING\n"
    s = s + "    DIM ci AS INTEGER\n"
    s = s + "    FOR ci = 0 TO h - 1\n"
    s = s + "        cr = APPEND(cr, strings.Repeat(" + qt + " " + qt + ", w))\n"
    s = s + "    NEXT ci\n"
    s = s + "    RETURN strings.Join(cr, " + qt + "\\n" + qt + ")\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- View: a blank lipgloss canvas + every widget as a layer at (X,Y,Z).
    s = s + "FUNCTION (m AS Model) View() AS tea.View\n"
    s = s + "    DIM w AS INTEGER = m.Width\n"
    s = s + "    DIM h AS INTEGER = m.Height\n"
    s = s + "    IF w < 60 THEN w = 80\n"
    s = s + "    IF h < 20 THEN h = 24\n"
    ' Charm-component layers for ported widgets are accumulated here and
    ' composited over the rows[] base (built from un-ported kinds) just
    ' before the View is returned. portedSfx records each layer var suffix.
    DIM layerCode AS STRING = ""
    DIM portedSfx AS []STRING
    FOR i = 0 TO n - 1
        DIM wv  AS DesignWidget = f.Widgets[i]
        DIM xs  AS STRING = strconv.Itoa(wv.X)
        DIM ys  AS STRING = strconv.Itoa(wv.Y)
        DIM sfx AS STRING = strconv.Itoa(i)

        _ = xs
        _ = ys
      IF wv.Parent = "" AND wv.Kind <> "Dialog" THEN
        DIM zStr AS STRING = strconv.Itoa(i + 10)
        layerCode = layerCode + widgetEmitLayer(wv, sfx, xs, ys, zStr, f, n, qt)
        portedSfx = APPEND(portedSfx, sfx)
      END IF
    NEXT i
    ' --- Pure-lipgloss composition: a blank canvas base + every widget as a
    '     layer at its (X,Y,Z). No rows[] / overlay painting — the whole View
    '     is Charm composition. [[dbtui_charm_first]]
    s = s + "    DIM fullView AS STRING = _blankCanvas(w, h)\n"
    s = s + layerCode
    s = s + "    DIM baseLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)\n"
    s = s + "    DIM cmpLy AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(baseLy"
    DIM plI AS INTEGER
    FOR plI = 0 TO LEN(portedSfx) - 1
        s = s + ", ly" + portedSfx[plI]
    NEXT plI
    s = s + ")\n"
    s = s + "    fullView = cmpLy.Render()\n"
    ' --- Menubar open dropdowns: composited (as layers) over the frame so
    '     they sit above every widget. Also stashes each box rect for clicks.
    IF hasMenubar THEN
        DIM mbPI AS INTEGER
        FOR mbPI = 0 TO n - 1
            DIM mbPW AS DesignWidget = f.Widgets[mbPI]
            IF mbPW.Kind = "Menubar" THEN
                s = s + menubarEmitDropdownPass(mbPW, mbPI, qt)
            END IF
        NEXT mbPI
    END IF
    ' --- Dialog overlay: the active dialog composited as a centered, high-Z
    '     layer over everything. Its rect is stashed for the click hit-test.
    IF hasDialog THEN
        s = s + "    DIM dlgStr AS STRING = " + qt + qt + "\n"
        DIM dlgVI AS INTEGER
        FOR dlgVI = 0 TO n - 1
            DIM dlgVW AS DesignWidget = f.Widgets[dlgVI]
            IF dlgVW.Kind = "Dialog" THEN
                s = s + dialogEmitViewBuild(dlgVW, qt)
            END IF
        NEXT dlgVI
        s = s + "    IF dlgStr <> " + qt + qt + " THEN\n"
        s = s + "        DIM dwW AS INTEGER = lipgloss.Width(dlgStr)\n"
        s = s + "        DIM dwH AS INTEGER = lipgloss.Height(dlgStr)\n"
        s = s + "        DIM dwX AS INTEGER = (w - dwW) / 2\n"
        s = s + "        DIM dwY AS INTEGER = (h - dwH) / 2\n"
        s = s + "        IF dwX < 0 THEN dwX = 0\n"
        s = s + "        IF dwY < 0 THEN dwY = 0\n"
        s = s + "        _dlgX = dwX\n"
        s = s + "        _dlgY = dwY\n"
        s = s + "        _dlgW = dwW\n"
        s = s + "        _dlgH = dwH\n"
        s = s + "        DIM dBg AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullView)\n"
        s = s + "        DIM dLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dlgStr).X(dwX).Y(dwY).Z(100)\n"
        s = s + "        DIM dCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(dBg, dLy)\n"
        s = s + "        fullView = dCmp.Render()\n"
        s = s + "    ELSE\n"
        s = s + "        _dlgW = 0\n"
        s = s + "        _dlgH = 0\n"
        s = s + "    END IF\n"
    END IF
    s = s + "    DIM vw AS tea.View = tea.NewView(fullView)\n"
    s = s + "    vw.MouseMode = tea.MouseModeAllMotion\n"
    ' Alt-screen mode so bubbletea owns the whole terminal and clears
    ' it cleanly between frames. Without this, content that shrinks
    ' (e.g. a dialog closing) can leave residue from the previous
    ' frame in the regular terminal scrollback.
    s = s + "    vw.AltScreen = TRUE\n"
    s = s + "    RETURN vw\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    s = s + "SUB Main()\n"
    s = s + "    DIM m AS Model\n"
    ' Nothing is hovered until the mouse moves over a widget.
    s = s + "    m.Hover = 0 - 1\n"
    s = s + "    m.HoverTab = 0 - 1\n"
    ' Seed per-widget initial state from the design — bubbletea
    ' takes the Model by value at NewProgram time, so anything set
    ' here is what the user sees on the first frame.
    DIM mi AS INTEGER
    FOR mi = 0 TO n - 1
        DIM mw AS DesignWidget = f.Widgets[mi]
      IF mw.Parent = "" THEN
        IF widgetComponent(mw.Kind) THEN
            s = s + compEmitInit(mw, qt)
        ELSEIF mw.Kind = "RadioButton" AND mw.Checked THEN
            s = s + radioButtonEmitSeed(mw)
        ELSEIF mw.Kind = "TabStrip" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Selected) + "\n"
        ELSEIF mw.Kind = "ScrollBar" THEN
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Value) + "\n"
        ELSEIF mw.Kind = "Tree" THEN
            ' Cursor starts at Selected; every node starts expanded.
            s = s + "    m." + mw.Name + "_Val = " + strconv.Itoa(mw.Selected) + "\n"
            s = s + "    DIM seedC" + mw.Name + " AS INTEGER\n"
            s = s + "    FOR seedC" + mw.Name + " = 0 TO " + strconv.Itoa(LEN(mw.Items) - 1) + "\n"
            s = s + "        m." + mw.Name + "_Collapsed = APPEND(m." + mw.Name + "_Collapsed, FALSE)\n"
            s = s + "    NEXT seedC" + mw.Name + "\n"
        END IF
      END IF
    NEXT mi
    ' Sync component focus to the start-focused widget.
    IF hasTextInput OR hasTextArea OR hasTable THEN s = s + "    syncFocusComp(@m)\n"
    s = s + "    DIM prog AS POINTER TO tea.Program = tea.NewProgram(m)\n"
    s = s + "    DIM final AS tea.Model\n"
    s = s + "    DIM rerr AS ERROR\n"
    s = s + "    final, rerr = prog.Run()\n"
    s = s + "    IF rerr <> NIL THEN os.Exit(1)\n"
    s = s + "    _ = final\n"
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- syncFocusComp — blur every focusable Charm component, then focus
    '     the one whose widget index is m.Focus. Called from Main and on
    '     every focus change (Tab / Shift+Tab / click) so the focused
    '     component shows its cursor and receives forwarded input.
    IF hasTextInput OR hasTextArea OR hasTable THEN
        s = s + "SUB syncFocusComp(m AS POINTER TO Model)\n"
        DIM sfBI AS INTEGER
        FOR sfBI = 0 TO n - 1
            IF compHasFocus(f.Widgets[sfBI].Kind) AND f.Widgets[sfBI].Parent = "" THEN
                s = s + "    m." + f.Widgets[sfBI].Name + compSuffix(f.Widgets[sfBI].Kind) + ".Blur()\n"
            END IF
        NEXT sfBI
        DIM sfFI AS INTEGER
        FOR sfFI = 0 TO n - 1
            IF compHasFocus(f.Widgets[sfFI].Kind) AND f.Widgets[sfFI].Parent = "" THEN
                DIM sfNm AS STRING = f.Widgets[sfFI].Name + compSuffix(f.Widgets[sfFI].Kind)
                s = s + "    IF m.Focus = " + strconv.Itoa(sfFI) + " THEN\n"
                IF f.Widgets[sfFI].Kind = "PropGrid" THEN
                    ' table.Focus() returns nothing.
                    s = s + "        m." + sfNm + ".Focus()\n"
                ELSE
                    ' textinput / textarea Focus() returns a cmd.
                    s = s + "        DIM fcc" + strconv.Itoa(sfFI) + " AS tea.Cmd = m." + sfNm + ".Focus()\n"
                    s = s + "        _ = fcc" + strconv.Itoa(sfFI) + "\n"
                END IF
                s = s + "    END IF\n"
            END IF
        NEXT sfFI
        s = s + "END SUB\n"
        s = s + "\n"
    END IF
    s = s + "DIM focusStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)\n"
    s = s + "DIM hoverStyle AS lipgloss.Style = lipgloss.NewStyle().Reverse(TRUE)\n"
    s = s + "\n"
    ' compFocusView — wrap a Charm-composed widget view in the focus (or
    ' hover) style for the layer-composition path. Plain when neither.
    s = s + "FUNCTION compFocusView(v AS STRING, focused AS BOOLEAN, hovered AS BOOLEAN) AS STRING\n"
    s = s + "    IF focused THEN RETURN focusStyle.Render(v)\n"
    s = s + "    IF hovered THEN RETURN hoverStyle.Render(v)\n"
    s = s + "    RETURN v\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    ' --- Menubar runtime: the generic _MNode type + _mn* navigation /
    '     paint / hit-test helpers (once), then one _mnNodes_<Name>()
    '     data table per Menubar widget. Emitted before dispatchClick so
    '     Update / View (which reference them) resolve cleanly.
    IF hasMenubar THEN
        s = s + menubarEmitRuntime(qt)
        DIM mnTI AS INTEGER
        FOR mnTI = 0 TO n - 1
            IF f.Widgets[mnTI].Kind = "Menubar" THEN
                s = s + menubarEmitNodeTable(f.Widgets[mnTI], qt)
            END IF
        NEXT mnTI
    END IF
    ' --- dispatchClick — generated jump-table from widget Id to
    '     the user-defined SUB. Must live in the prelude so the
    '     generated Update can call it; the SUB bodies live below
    '     the marker so they survive regen.
    s = s + "' Generated dispatcher — routes a Button click to its user handler.\n"
    s = s + "' When a Button has OnClickDialog set, the dialog's Show<Name>()\n"
    s = s + "' fires first so the user doesn't have to wire it from code.\n"
    s = s + "SUB dispatchClick(id AS STRING)\n"
    DIM hadClick AS BOOLEAN = FALSE
    DIM di AS INTEGER
    FOR di = 0 TO n - 1
        DIM dw AS DesignWidget = f.Widgets[di]
        IF dw.Kind = "Button" AND dw.Parent = "" THEN
            s = s + buttonEmitClickDispatch(dw, qt)
            hadClick = TRUE
        END IF
    NEXT di
    IF NOT hadClick THEN
        ' Empty body — avoid an "unused parameter" Go warning.
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"
    s = s + "\n"
    ' --- dispatchChange — like dispatchClick but for value-change
    '     events on Checkbox / RadioButton / ComboBox / ListBox /
    '     ScrollBar. User handlers live below the marker.
    s = s + "' Generated dispatcher — routes a value change to its _Change handler.\n"
    s = s + "SUB dispatchChange(id AS STRING)\n"
    DIM hadChange AS BOOLEAN = FALSE
    DIM dchI AS INTEGER
    FOR dchI = 0 TO n - 1
        DIM dchW AS DesignWidget = f.Widgets[dchI]
        IF (dchW.Kind = "Checkbox" OR dchW.Kind = "RadioButton" OR dchW.Kind = "ComboBox" OR dchW.Kind = "ListBox" OR dchW.Kind = "ScrollBar" OR dchW.Kind = "TabStrip" OR dchW.Kind = "Tree" OR dchW.Kind = "PropGrid") AND dchW.Parent = "" THEN
            s = s + "    IF id = " + qt + dchW.Name + qt + " THEN " + dchW.Name + "_Change()\n"
            hadChange = TRUE
        END IF
    NEXT dchI
    IF NOT hadChange THEN
        s = s + "    _ = id\n"
    END IF
    s = s + "END SUB\n"

    ' --- Tree widget plumbing. A shared treeVisibleRows() walks the
    '     node depths + per-node collapse flags to produce the list of
    '     visible node indices (descendants of a collapsed parent are
    '     skipped). Per-tree _depths()/_labels()/_isParent() helpers
    '     bake the static node structure decoded from the leading-dash
    '     depth prefixes so both Update and View can read it.
    IF hasTree THEN
        s = s + treeEmitHelpers(f, n, qt)
    END IF

    ' --- TextArea cursor helpers. All byte-offset based (exact for
    '     ASCII). taLineHome/taLineEnd clamp a cursor to its line's
    '     bounds; taMoveVert moves up/down keeping the column; taRowCol
    '     maps a byte offset to a (row, col) for the renderer.
    IF hasTextArea THEN
        s = s + textAreaEmitHelpers(qt)
    END IF

    ' --- Dialog widget plumbing (confirm kind only — Phase 2).
    '     For each Dialog widget: a Show<Name> SUB the user calls to
    '     pop the dialog. A shared fdRenderConfirm() helper draws it
    '     using lipgloss, matching DBtui's own confirm-dialog style.
    IF hasDialog THEN
        DIM dlgI AS INTEGER
        FOR dlgI = 0 TO n - 1
            DIM dlgW AS DesignWidget = f.Widgets[dlgI]
            IF dlgW.Kind = "Dialog" THEN
                DIM dlgSK AS STRING = dlgW.DialogKind
                IF dlgSK = "" THEN dlgSK = "confirm"
                DIM closeSig AS STRING = "(button STRING)"
                IF dlgSK = "input" THEN closeSig = "(button STRING, text STRING)"
                s = s + "\n"
                s = s + "' Show" + dlgW.Name + " — pop the " + dlgW.Name + " dialog.\n"
                s = s + "' Call from inside a _Click / _Change handler. On commit/\n"
                s = s + "' cancel " + dlgW.Name + "_Close" + closeSig + " fires (defined\n"
                s = s + "' below the marker — user fills in the body).\n"
                s = s + "SUB Show" + dlgW.Name + "()\n"
                s = s + "    IF _currentModel = NIL THEN RETURN\n"
                s = s + "    _currentModel." + dlgW.Name + "_Active = TRUE\n"
                s = s + "    _currentModel." + dlgW.Name + "_Idx    = 0\n"
                IF dlgSK = "input" THEN
                    ' Input-kind: seed the field with DialogDef and put
                    ' the focus on the text field.
                    s = s + "    _currentModel." + dlgW.Name + "_Text    = " + qt + escapeForDBString(dlgW.DialogDef) + qt + "\n"
                    s = s + "    _currentModel." + dlgW.Name + "_OnField = TRUE\n"
                END IF
                s = s + "END SUB\n"
            END IF
        NEXT dlgI

        ' fdRenderConfirm — body + button row wrapped in a lipgloss
        ' frame with BorderTop(FALSE), then a hand-rolled top border
        ' carrying the title (left) + ✕ close glyph (right). Matches
        ' DBtui's own FileDialog / modal style. innerW fixed at 48.
        s = s + "\n"
        s = s + "FUNCTION fdRenderConfirm(title AS STRING, msg AS STRING, buttons AS []STRING, activeIdx AS INTEGER) AS STRING\n"
        s = s + "    DIM innerW AS INTEGER = 48\n"
        s = s + "    DIM cBg     AS STRING = " + qt + "#1a1b2e" + qt + "\n"
        s = s + "    DIM cFg     AS STRING = " + qt + "#e0def4" + qt + "\n"
        s = s + "    DIM cAccent AS STRING = " + qt + "#7dcfff" + qt + "\n"
        s = s + "    DIM cBorder AS STRING = " + qt + "#3b3d5e" + qt + "\n"
        s = s + "    DIM cHl     AS STRING = " + qt + "#2d4f67" + qt + "\n"
        s = s + "    DIM cClose  AS STRING = " + qt + "#f9e2af" + qt + "\n"
        s = s + "    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)\n"
        s = s + "    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)\n"
        s = s + "    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)\n"
        s = s + "    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)\n"
        ' Body — single line for now; Phase 4 can wrap multi-line.
        s = s + "    DIM body AS STRING = bodyStyle.Render(msg)\n"
        ' Button row.
        s = s + "    DIM totalW AS INTEGER = 0\n"
        s = s + "    DIM bi AS INTEGER\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        totalW = totalW + lipgloss.Width(" + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + ")\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2\n"
        s = s + "    NEXT bi\n"
        s = s + "    DIM padBtn AS INTEGER = innerW - totalW\n"
        s = s + "    IF padBtn < 0 THEN padBtn = 0\n"
        s = s + "    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" + qt + " " + qt + ", padBtn))\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        DIM lbl AS STRING = " + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + "\n"
        s = s + "        IF bi = activeIdx THEN\n"
        s = s + "            btnRow = btnRow + btnActive.Render(lbl)\n"
        s = s + "        ELSE\n"
        s = s + "            btnRow = btnRow + btnStyle.Render(lbl)\n"
        s = s + "        END IF\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render(" + qt + "  " + qt + ")\n"
        s = s + "    NEXT bi\n"
        ' Stack body / spacer / buttons, wrap in a frame with the top
        ' border suppressed; lipgloss draws the sides + bottom.
        s = s + "    DIM spacer AS STRING = bodyStyle.Render(" + qt + " " + qt + ")\n"
        s = s + "    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, body, spacer, btnRow)\n"
        s = s + "    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)\n"
        s = s + "    DIM bodyStr AS STRING = frame.Render(stacked)\n"
        s = s + "    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)\n"
        ' Hand-rolled top border: ╭─ Title ─…─ ✕ ╮ — title embedded
        ' left, ✕ embedded one cell in from the right corner.
        s = s + "    DIM titleTxt AS STRING = " + qt + " " + qt + " + title + " + qt + " " + qt + "\n"
        s = s + "    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)\n"
        s = s + "    DIM dashLen AS INTEGER = totalDW - titleLen - 6\n"
        s = s + "    IF dashLen < 0 THEN dashLen = 0\n"
        s = s + "    DIM topBorder AS STRING = borderStyle.Render(" + qt + "╭─" + qt + ") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat(" + qt + "─" + qt + ", dashLen) + " + qt + " " + qt + ") + closeStyle.Render(" + qt + "✕" + qt + ") + borderStyle.Render(" + qt + " ╮" + qt + ")\n"
        s = s + "    RETURN topBorder + " + qt + "\\n" + qt + " + bodyStr\n"
        s = s + "END FUNCTION\n"

        ' fdRenderInput — input-kind dialog renderer. Same outer
        ' frame as fdRenderConfirm: hand-rolled top border carrying
        ' title + ✕, BorderTop(FALSE) lipgloss frame around the
        ' stacked content. Content rows (between the inner padding):
        '   row 0: prompt
        '   row 1: spacer
        '   row 2: text field (single row, flat background)
        '   row 3: spacer
        '   row 4: OK/Cancel button row
        ' onField=TRUE shows the █ cursor in the field; activeIdx
        ' (-1 when onField=TRUE) picks the highlighted button.
        s = s + "\n"
        s = s + "FUNCTION fdRenderInput(title AS STRING, prompt AS STRING, txt AS STRING, onField AS BOOLEAN, activeIdx AS INTEGER) AS STRING\n"
        s = s + "    DIM innerW AS INTEGER = 48\n"
        s = s + "    DIM cBg     AS STRING = " + qt + "#1a1b2e" + qt + "\n"
        s = s + "    DIM cFg     AS STRING = " + qt + "#e0def4" + qt + "\n"
        s = s + "    DIM cAccent AS STRING = " + qt + "#7dcfff" + qt + "\n"
        s = s + "    DIM cBorder AS STRING = " + qt + "#3b3d5e" + qt + "\n"
        s = s + "    DIM cHl     AS STRING = " + qt + "#2d4f67" + qt + "\n"
        s = s + "    DIM cClose  AS STRING = " + qt + "#f9e2af" + qt + "\n"
        s = s + "    DIM cField  AS STRING = " + qt + "#11121f" + qt + "\n"
        s = s + "    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cBorder)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM titleStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cAccent)).Background(lipgloss.Color(cBg)).Bold(TRUE).Italic(TRUE)\n"
        s = s + "    DIM bodyStyle   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg)).Width(innerW)\n"
        s = s + "    DIM fieldStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cField)).Width(innerW)\n"
        s = s + "    DIM btnStyle    AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM btnActive   AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cFg)).Background(lipgloss.Color(cHl)).Bold(TRUE)\n"
        s = s + "    DIM bgFill      AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(cBg))\n"
        s = s + "    DIM closeStyle  AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(cClose)).Background(lipgloss.Color(cBg)).Bold(TRUE)\n"
        ' Prompt row + field row (flat box, dark background; cursor
        ' shown when focused).
        s = s + "    DIM promptRow AS STRING = bodyStyle.Render(prompt)\n"
        s = s + "    DIM fieldTxt AS STRING = " + qt + " " + qt + " + txt\n"
        s = s + "    IF onField THEN fieldTxt = fieldTxt + " + qt + "█" + qt + "\n"
        s = s + "    DIM fieldRow AS STRING = fieldStyle.Render(fieldTxt)\n"
        ' Hard-coded OK/Cancel button row (right-justified).
        s = s + "    DIM buttons AS []STRING\n"
        s = s + "    buttons = APPEND(buttons, " + qt + "OK" + qt + ")\n"
        s = s + "    buttons = APPEND(buttons, " + qt + "Cancel" + qt + ")\n"
        s = s + "    DIM totalW AS INTEGER = 0\n"
        s = s + "    DIM bi AS INTEGER\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        totalW = totalW + lipgloss.Width(" + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + ")\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN totalW = totalW + 2\n"
        s = s + "    NEXT bi\n"
        s = s + "    DIM padBtn AS INTEGER = innerW - totalW\n"
        s = s + "    IF padBtn < 0 THEN padBtn = 0\n"
        s = s + "    DIM btnRow AS STRING = bgFill.Render(strings.Repeat(" + qt + " " + qt + ", padBtn))\n"
        s = s + "    FOR bi = 0 TO LEN(buttons) - 1\n"
        s = s + "        DIM lbl AS STRING = " + qt + "[ " + qt + " + buttons[bi] + " + qt + " ]" + qt + "\n"
        s = s + "        IF bi = activeIdx THEN\n"
        s = s + "            btnRow = btnRow + btnActive.Render(lbl)\n"
        s = s + "        ELSE\n"
        s = s + "            btnRow = btnRow + btnStyle.Render(lbl)\n"
        s = s + "        END IF\n"
        s = s + "        IF bi < LEN(buttons) - 1 THEN btnRow = btnRow + bgFill.Render(" + qt + "  " + qt + ")\n"
        s = s + "    NEXT bi\n"
        ' Stack prompt / spacer / field / spacer / buttons, wrap in
        ' the same BorderTop(FALSE) frame as fdRenderConfirm.
        s = s + "    DIM spacer AS STRING = bodyStyle.Render(" + qt + " " + qt + ")\n"
        s = s + "    DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, promptRow, spacer, fieldRow, spacer, btnRow)\n"
        s = s + "    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderTop(FALSE).BorderForeground(lipgloss.Color(cBorder)).BorderBackground(lipgloss.Color(cBg)).Background(lipgloss.Color(cBg)).Padding(1, 2)\n"
        s = s + "    DIM bodyStr AS STRING = frame.Render(stacked)\n"
        s = s + "    DIM totalDW AS INTEGER = lipgloss.Width(bodyStr)\n"
        s = s + "    DIM titleTxt AS STRING = " + qt + " " + qt + " + title + " + qt + " " + qt + "\n"
        s = s + "    DIM titleLen AS INTEGER = lipgloss.Width(titleTxt)\n"
        s = s + "    DIM dashLen AS INTEGER = totalDW - titleLen - 6\n"
        s = s + "    IF dashLen < 0 THEN dashLen = 0\n"
        s = s + "    DIM topBorder AS STRING = borderStyle.Render(" + qt + "╭─" + qt + ") + titleStyle.Render(titleTxt) + borderStyle.Render(strings.Repeat(" + qt + "─" + qt + ", dashLen) + " + qt + " " + qt + ") + closeStyle.Render(" + qt + "✕" + qt + ") + borderStyle.Render(" + qt + " ╮" + qt + ")\n"
        s = s + "    RETURN topBorder + " + qt + "\\n" + qt + " + bodyStr\n"
        s = s + "END FUNCTION\n"
    END IF

    RETURN s
END FUNCTION

' subDefined — TRUE when `userCode` already declares a SUB named
' `name` (case-sensitive). Used so generateUserStubs doesn't
' duplicate handlers the user has already written.
FUNCTION subDefined(userCode AS STRING, name AS STRING) AS BOOLEAN
    DIM needle AS STRING = "SUB " + name + "("
    RETURN strings.Contains(userCode, needle)
END FUNCTION

' ensureSubSig — if `userCode` already declares `SUB <name>(...)`,
' rewrite ONLY that signature line so its parameter list matches
' `wantSig`, leaving the body untouched. Returns the patched code
' (unchanged if the stub is absent or already matches).
'
' This keeps a Dialog's auto-generated _Close stub in sync when the
' user flips the dialog kind in the designer: confirm uses
' `(button AS STRING)` while input uses `(button AS STRING, text AS
' STRING)`, and the generated call sites change arity to match. Go
' does not flag unused parameters, so widening a preserved stub is
' always build-safe; narrowing only breaks if the user's own body
' referenced the dropped parameter, which is their edit to own.
FUNCTION ensureSubSig(userCode AS STRING, name AS STRING, wantSig AS STRING) AS STRING
    DIM marker AS STRING = "SUB " + name + "("
    DIM at AS INTEGER = strings.Index(userCode, marker)
    IF at < 0 THEN RETURN userCode      ' stub not present — nothing to fix
    ' Length of the signature line (from the "SUB" up to, but not
    ' including, its terminating newline). strings.Index is 0-based;
    ' Mid is 1-based, so position at+1 == 0-based offset `at`.
    DIM rest AS STRING = Mid(userCode, at + 1, LEN(userCode) - at)
    DIM nl AS INTEGER = strings.Index(rest, "\n")
    IF nl < 0 THEN nl = LEN(rest)        ' signature runs to end of file
    DIM oldLine AS STRING = Mid(userCode, at + 1, nl)
    DIM newLine AS STRING = "SUB " + name + wantSig
    IF oldLine = newLine THEN RETURN userCode   ' already correct
    DIM prefix AS STRING = Mid(userCode, 1, at)
    DIM suffix AS STRING = Mid(userCode, at + nl + 1, LEN(userCode) - (at + nl))
    RETURN prefix + newLine + suffix
END FUNCTION

' generateUserStubs — produce the user section. On a fresh form
' (existingUser empty) seed it with a friendly preamble + an empty
' SUB <name>_Click() for every Button. On subsequent regens, keep
' the existing content verbatim and append stubs for any handler
' the user hasn't already written (e.g. a Button added since last
' run). Never rewrites or deletes existing content.
FUNCTION generateUserStubs(f AS DesignForm, existingUser AS STRING) AS STRING
    DIM out AS STRING = existingUser
    IF out = "" THEN
        ' Fresh user section: a one-line guide + a blank line.
        out = "' Your code below — DBtui preserves everything here on F5.\n\n"
    END IF
    DIM trailing AS BOOLEAN = strings.HasSuffix(out, "\n")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(f.Widgets) - 1
        DIM w AS DesignWidget = f.Widgets[i]
        DIM stubName AS STRING = ""
        DIM stubLabel AS STRING = ""
        DIM stubSig AS STRING = "()"
        DIM stubBody AS STRING = "    ' TODO: your code here.\n"
        IF w.Kind = "Button" THEN
            stubName = w.Name + "_Click"
            stubLabel = "Click"
        ELSEIF w.Kind = "Checkbox" OR w.Kind = "RadioButton" OR w.Kind = "ComboBox" OR w.Kind = "ListBox" OR w.Kind = "ScrollBar" OR w.Kind = "TabStrip" OR w.Kind = "Tree" OR w.Kind = "PropGrid" THEN
            stubName = w.Name + "_Change"
            stubLabel = "Change"
        ELSEIF w.Kind = "Dialog" THEN
            stubName  = w.Name + "_Close"
            stubLabel = "Close"
            DIM stubK AS STRING = w.DialogKind
            IF stubK = "" THEN stubK = "confirm"
            IF stubK = "input" THEN
                stubSig   = "(button AS STRING, text AS STRING)"
                stubBody  = "    ' Called when the user dismisses " + w.Name + ".\n"
                stubBody  = stubBody + "    ' `button` is the label clicked (" + Chr(34) + "OK" + Chr(34) + "/" + Chr(34) + "Cancel" + Chr(34) + ") or " + Chr(34) + Chr(34) + "\n"
                stubBody  = stubBody + "    ' for Esc / ✕ close. `text` is the value the user typed.\n"
                stubBody  = stubBody + "    _ = button\n"
                stubBody  = stubBody + "    _ = text\n"
            ELSE
                stubSig   = "(button AS STRING)"
                stubBody  = "    ' Called when the user dismisses " + w.Name + ".\n"
                stubBody  = stubBody + "    ' `button` is the label clicked (e.g. " + Chr(34) + "OK" + Chr(34) + "), or " + Chr(34) + Chr(34) + "\n"
                stubBody  = stubBody + "    ' for Esc / ✕ close. Add your branching code here.\n"
                stubBody  = stubBody + "    _ = button\n"
            END IF
        ELSEIF w.Kind = "Menubar" THEN
            ' One Click handler per selectable LEAF item (non-separator,
            ' non-submenu). Names come from the menu tree; each is emitted
            ' once and preserved across regens. stubName stays "" so the
            ' generic single-stub path below is skipped for menubars.
            IF w.Parent = "" THEN
                DIM mnLI AS INTEGER
                FOR mnLI = 0 TO LEN(w.Menu) - 1
                    DIM mln AS MenuNode = w.Menu[mnLI]
                    IF NOT mln.IsSep AND NOT menuIsSubmenu(w.Menu, mnLI) AND mln.Name <> "" THEN
                        DIM mlSub AS STRING = mln.Name + "_Click"
                        IF NOT subDefined(out, mlSub) THEN
                            IF NOT trailing THEN out = out + "\n"
                            IF NOT strings.HasSuffix(out, "\n\n") THEN out = out + "\n"
                            out = out + "' Click handler for " + w.Name + " ▸ " + mln.Caption + " — edit freely.\n"
                            out = out + "SUB " + mlSub + "()\n"
                            out = out + "    ' TODO: your code here.\n"
                            out = out + "END SUB\n"
                            trailing = TRUE
                        END IF
                    END IF
                NEXT mnLI
            END IF
        END IF
        ' A Dialog's _Close arity depends on its kind, and the kind can
        ' change between regens. If the stub already exists, repair its
        ' signature in place so it matches the current call sites.
        IF w.Kind = "Dialog" THEN
            out = ensureSubSig(out, stubName, stubSig)
        END IF
        IF stubName <> "" AND w.Parent = "" AND NOT subDefined(out, stubName) THEN
            IF NOT trailing THEN out = out + "\n"
            IF NOT strings.HasSuffix(out, "\n\n") THEN out = out + "\n"
            out = out + "' " + stubLabel + " handler for " + w.Name + " — edit freely.\n"
            out = out + "SUB " + stubName + stubSig + "\n"
            out = out + stubBody
            out = out + "END SUB\n"
            trailing = TRUE
        END IF
    NEXT i
    RETURN out
END FUNCTION

' extractUserSection — read `path` (if it exists) and return the
' content after the user marker. If the file is missing or the
' marker is absent (fresh form, or user nuked the marker), return
' the empty string — caller will seed a fresh user section.
FUNCTION extractUserSection(path AS STRING) AS STRING
    DIM data AS BYTES
    DIM rerr AS ERROR
    data, rerr = os.ReadFile(path)
    IF rerr <> NIL THEN RETURN ""
    DIM src AS STRING = string(data)
    DIM idx AS INTEGER = strings.Index(src, formUserMarker)
    IF idx < 0 THEN RETURN ""
    ' Skip the marker line itself plus its trailing newline so the
    ' returned section starts at the first user-owned byte.
    DIM after AS INTEGER = idx + LEN(formUserMarker)
    IF after < LEN(src) AND Mid(src, after + 1, 1) = "\n" THEN after = after + 1
    IF after >= LEN(src) THEN RETURN ""
    RETURN Mid(src, after + 1, LEN(src) - after)
END FUNCTION

' mergeFormDbas — build the final .dbas content by composing a
' fresh prelude (from the design), the user marker line, and the
' preserved/augmented user section (handlers). Idempotent: running
' it twice on the same form against its own output is a no-op.
FUNCTION mergeFormDbas(f AS DesignForm, existingPath AS STRING) AS STRING
    DIM prelude    AS STRING = generateFormPrelude(f)
    DIM existing   AS STRING = extractUserSection(existingPath)
    DIM userSection AS STRING = generateUserStubs(f, existing)
    DIM out AS STRING = prelude
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    ' One blank line before the marker line, exactly one newline
    ' after it. extractUserSection consumes that single newline so
    ' the round-trip is idempotent (running mergeFormDbas on its
    ' own output produces byte-identical bytes).
    out = out + "\n" + formUserMarker + "\n"
    out = out + userSection
    IF NOT strings.HasSuffix(out, "\n") THEN out = out + "\n"
    RETURN out
END FUNCTION

' formOutputPath — where doFormRun / gen writes the partner .dbas
' for a form within a project. Multi-form projects get one .dbas per
' form named <stem>_<formName>.dbas to keep their handler sections
' separate; single-form projects keep the legacy <stem>.dbas path.
FUNCTION formOutputPath(projectPath AS STRING, formName AS STRING, formCount AS INTEGER) AS STRING
    DIM stem AS STRING = strings.TrimSuffix(projectPath, ".dbproj")
    IF formCount > 1 AND formName <> "" THEN
        RETURN stem + "_" + formName + ".dbas"
    END IF
    RETURN stem + ".dbas"
END FUNCTION

' doFormRun — F5 in form mode. Saves the .dbproj, regenerates the
' partner .dbas for the ACTIVE form (per-form file in multi-form
' projects), hands the terminal to dbasic run.
FUNCTION doFormRun(m AS POINTER TO Model) AS tea.Cmd
    IF m.Tabs[m.TabIdx].Path = "" THEN
        m.Status = "save the form first (Ctrl+S)"
        RETURN NIL
    END IF
    saveForm(m)
    ' Pull form count from disk so single-form projects still emit
    ' <stem>.dbas (legacy) and multi-form projects get per-form files.
    DIM proj AS Project
    DIM pok  AS BOOLEAN
    DIM ureason AS STRING
    proj, pok, ureason = readProjectFromDisk(m.Tabs[m.TabIdx].Path)
    _ = ureason
    DIM nForms AS INTEGER = 1
    IF pok THEN nForms = LEN(proj.Forms)
    DIM outPath AS STRING = formOutputPath(m.Tabs[m.TabIdx].Path, m.Tabs[m.TabIdx].FormName, nForms)
    DIM code AS STRING = mergeFormDbas(m.Tabs[m.TabIdx].Form, outPath)
    DIM werr AS ERROR = os.WriteFile(outPath, Encode(code), 0644)
    IF werr <> NIL THEN
        m.Status = "write " + outPath + ": " + werr.Error()
        RETURN NIL
    END IF
    ' Pre-flight compile so codegen / Go errors land in the Output pane
    ' instead of flashing past once the terminal is handed to the program.
    m.Status = "compiling " + outPath + "..."
    DIM fbBin AS STRING
    DIM fbOk AS BOOLEAN
    fbBin, fbOk = preflightBuild(m, outPath)
    IF NOT fbOk THEN RETURN NIL
    m.Status = "running " + outPath
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command(fbBin)
    RETURN tea.ExecProcess(cmd, runFinishedHandler)
END FUNCTION

' pickWidgetEvent — the action behind the right-click event popup. Given
' the widget index and the chosen event ROW (index into widgetEvents),
' it: (1) closes the popup, (2) requires the form to be SAVED (it never
' writes the .dbproj itself — an untitled/unsaved form is rejected with a
' "save first" status, so wiring an event can't silently persist unsaved
' form edits), (3) regenerates the partner .dbas from the ON-DISK form,
' (4) ensures the handler SUB exists exactly once, placed ADJACENT to the
' widget's other handlers, (5) opens/refreshes that .dbas as a code tab,
' and (6) jumps the cursor to the handler.
SUB pickWidgetEvent(m AS POINTER TO Model, widgetIdx AS INTEGER, itemIdx AS INTEGER)
    IF NOT hasActiveTab(^m) THEN RETURN
    IF widgetIdx < 0 OR widgetIdx >= LEN(m.Tabs[m.TabIdx].Form.Widgets) THEN RETURN
    ' Close the popup first.
    m.CtxWidget = 0 - 1
    DIM w AS DesignWidget = m.Tabs[m.TabIdx].Form.Widgets[widgetIdx]
    ' Menubar has no widget-level event — its single popup entry opens the
    ' visual Menu Editor, where per-item <Name>_Click() handlers are managed.
    IF w.Kind = "Menubar" THEN
        showMenuEditor(m, widgetIdx)
        RETURN
    END IF
    DIM evs AS []STRING = widgetEvents(w.Kind)
    IF itemIdx < 0 OR itemIdx >= LEN(evs) THEN RETURN
    DIM ev AS STRING = evs[itemIdx]
    DIM handler AS STRING = w.Name + "_" + ev

    ' (2) Require a SAVED form. Wiring an event must never silently persist
    ' unsaved form edits: we don't write the .dbproj here at all, and we
    ' generate the partner .dbas from the ON-DISK project (not the live,
    ' possibly-unsaved form) so an unsaved addition (e.g. a stray Menubar)
    ' can't leak onto disk. Untitled / unreadable → ask the user to save.
    IF m.Tabs[m.TabIdx].Path = "" THEN
        m.Status = "Save the form first (Ctrl+S) to add an event handler"
        RETURN
    END IF
    DIM proj AS Project
    DIM pok AS BOOLEAN
    DIM preason AS STRING
    proj, pok, preason = readProjectFromDisk(m.Tabs[m.TabIdx].Path)
    _ = preason
    IF NOT pok OR LEN(proj.Forms) = 0 THEN
        m.Status = "Save the form first (Ctrl+S) to add an event handler"
        RETURN
    END IF
    DIM nForms AS INTEGER = LEN(proj.Forms)

    ' (3) Regenerate the partner .dbas from the SAVED form matching this tab.
    DIM diskForm AS DesignForm = proj.Forms[0]
    IF m.Tabs[m.TabIdx].FormName <> "" THEN
        DIM dfi AS INTEGER
        FOR dfi = 0 TO LEN(proj.Forms) - 1
            IF proj.Forms[dfi].Name = m.Tabs[m.TabIdx].FormName THEN diskForm = proj.Forms[dfi]
        NEXT dfi
    END IF
    DIM outPath AS STRING = formOutputPath(m.Tabs[m.TabIdx].Path, m.Tabs[m.TabIdx].FormName, nForms)
    DIM text AS STRING = mergeFormDbas(diskForm, outPath)

    ' (4) Ensure the handler exists — exactly once, adjacent to the
    ' widget's other handlers. mergeFormDbas already seeds the primary
    ' event; non-primary events are inserted here.
    IF NOT subDefined(text, handler) THEN
        text = insertHandlerStub(text, w.Name, buildEventStub(w, ev))
    END IF
    DIM pwWErr AS ERROR = os.WriteFile(outPath, Encode(text), 0644)
    IF pwWErr <> NIL THEN
        m.Status = "write " + outPath + ": " + pwWErr.Error()
        RETURN
    END IF

    ' (5) Open or refresh the partner .dbas as a code tab.
    DIM existing AS INTEGER = findTabIdx(^m, outPath)
    IF existing >= 0 THEN
        switchToTab(m, existing)
        IF NOT m.Tabs[m.TabIdx].Dirty THEN
            m.Tabs[m.TabIdx].Editor.SetValue(text)
            m.Tabs[m.TabIdx].Editor.MoveToBegin()
        END IF
    ELSE
        newEmptyTab(m, outPath)
        m.Tabs[m.TabIdx].Editor.SetValue(text)
        m.Tabs[m.TabIdx].Editor.MoveToBegin()
    END IF
    m.Tabs[m.TabIdx].Dirty = FALSE
    m.ViewMode = "code"
    setFocus(m, "editor")
    ' We just wrote outPath; sync the tab's mtime so the watcher doesn't
    ' flag our own write as an external edit.
    refreshActiveMtime(m)

    ' (6) Jump to the handler line.
    DIM olines AS []STRING = strings.Split(text, "\n")
    DIM entries AS []OutlineEntry = scanOutline(olines)
    DIM oi AS INTEGER
    FOR oi = 0 TO LEN(entries) - 1
        IF entries[oi].Name = handler THEN
            gotoLine(m, entries[oi].Row + 1)
            m.Status = ev + " handler for " + w.Name
            RETURN
        END IF
    NEXT oi
    m.Status = "opened " + outPath + " (couldn't locate " + handler + ")"
END SUB
