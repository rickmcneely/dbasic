' DBtui — internal/app/app.dbas
'
' Top-level bubbletea v2 model. Wires:
'   * MenuBar (top)
'   * StatusBar (bottom)
'   * A ScrollPanel left sidebar (placeholder project tree)
'   * An empty workspace center
'
' Keyboard:
'   F10           open the File menu
'   Tab           cycle focus: Sidebar → Workspace → Sidebar
'   Esc           close menu (in menu mode)
'   ↑/↓           cursor through the focused panel
'   PgUp / PgDn   scroll the focused panel
'   Enter         "select" — echoes action / selected line to status bar
'   q / Ctrl+C    quit (only when no menu is open)

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "charm.land/lipgloss/v2" AS lipgloss
IMPORT "fmt"

' ----------------------------------------------------------------------
' Model
' ----------------------------------------------------------------------

TYPE Model
    DIM Width     AS INTEGER
    DIM Height    AS INTEGER
    DIM Focus     AS INTEGER     ' which panel has focus (see ui/layout.dbas)
    DIM Mode      AS INTEGER     ' modal input mode (see ui/layout.dbas)
    DIM MenuBar   AS MenuBar
    DIM StatusBar AS StatusBar
    DIM Tree      AS Tree        ' project tree (left sidebar)
    DIM Registry  AS Registry    ' widget registry — feeds the palette
    DIM Palette   AS ScrollPanel ' widget palette (right sidebar)
    DIM LeftW     AS INTEGER     ' left sidebar width
    DIM RightW    AS INTEGER     ' right sidebar width
END TYPE

FUNCTION NewModel() AS Model
    DIM m AS Model
    m.Width = 0
    m.Height = 0
    m.Focus = FocusProjectTree
    m.Mode = ModeNormal
    m.LeftW = 28
    m.RightW = 22
    m.MenuBar = NewMenuBar()
    m.StatusBar = NewStatusBar()
    m.StatusBar.Message = defaultStatus()
    m.Tree = NewTree()
    m.Tree.SetFocused(TRUE)
    m.Registry = DefaultRegistry()
    m.Palette = NewScrollPanel()
    m.Palette.Title = "Widgets"
    m.Palette.Cursor = 0
    m.Palette.Lines = m.Registry.Kinds
    RETURN m
END FUNCTION

FUNCTION defaultStatus() AS STRING
    RETURN "DBtui — F10:Menu  |  Tab:Focus  |  ↑/↓:Move  |  Space:Expand  |  Enter:Pick  |  q:Quit"
END FUNCTION

' ----------------------------------------------------------------------
' bubbletea v2 lifecycle
' ----------------------------------------------------------------------

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' WindowSizeMsg — record dimensions and cascade to children.
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = sizeMsg.Width
        m.Height = sizeMsg.Height
        m.MenuBar.SetWidth(m.Width)
        m.StatusBar.SetWidth(m.Width)
        DIM bodyH AS INTEGER = m.Height - 2
        IF bodyH < 3 THEN bodyH = 3
        m.Tree.SetSize(m.LeftW, bodyH)
        m.Palette.Width = m.RightW
        m.Palette.Height = bodyH
        RETURN m, NIL
    END IF

    ' KeyPressMsg — dispatch by mode.
    DIM keyMsg AS tea.KeyPressMsg
    DIM keyOk AS BOOLEAN
    keyMsg, keyOk = msg.(tea.KeyPressMsg)
    IF keyOk THEN
        DIM k AS STRING = keyMsg.String()

        IF m.Mode = ModeMenuBar THEN
            ' --- Menu mode ---------------------------------------------
            IF k = "esc" THEN
                m.MenuBar.Close()
                m.Mode = ModeNormal
                m.StatusBar.Message = defaultStatus()
                RETURN m, NIL
            END IF
            IF k = "left" THEN
                m.MenuBar.PrevMenu()
                RETURN m, NIL
            END IF
            IF k = "right" THEN
                m.MenuBar.NextMenu()
                RETURN m, NIL
            END IF
            IF k = "up" THEN
                m.MenuBar.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.MenuBar.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM action AS STRING = m.MenuBar.SelectedAction()
                m.MenuBar.Close()
                m.Mode = ModeNormal
                IF action = "file.quit" THEN
                    RETURN m, tea.Quit
                END IF
                IF action <> "" THEN
                    m.StatusBar.Message = "selected: " + action + "  (action dispatch — TBD)"
                ELSE
                    m.StatusBar.Message = defaultStatus()
                END IF
                RETURN m, NIL
            END IF
            ' Swallow unhandled keys while a menu is open.
            RETURN m, NIL
        END IF

        ' --- Normal mode -----------------------------------------------
        IF k = "f10" THEN
            m.MenuBar.OpenMenu(0)
            m.Mode = ModeMenuBar
            m.StatusBar.Message = "Menu — Esc: Close  ←/→: Menu  ↑/↓: Item  Enter: Select"
            RETURN m, NIL
        END IF
        IF k = "tab" THEN
            ' Cycle ProjectTree → Workspace → Widgets → ProjectTree.
            IF m.Focus = FocusProjectTree THEN
                m.Focus = FocusVisual
                m.Tree.SetFocused(FALSE)
                m.Palette.Focused = FALSE
            ELSEIF m.Focus = FocusVisual THEN
                m.Focus = FocusWidgets
                m.Tree.SetFocused(FALSE)
                m.Palette.Focused = TRUE
            ELSE
                m.Focus = FocusProjectTree
                m.Tree.SetFocused(TRUE)
                m.Palette.Focused = FALSE
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = FocusProjectTree THEN
            IF k = "up" THEN
                m.Tree.Panel.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.Tree.Panel.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "pgup" THEN
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                RETURN m, NIL
            END IF
            IF k = "pgdown" THEN
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                RETURN m, NIL
            END IF
            IF k = "space" OR k = " " THEN
                m.Tree.ToggleExpand()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM node AS POINTER TO TreeNode = m.Tree.CursorNode()
                IF node <> NIL THEN
                    IF node.Kind = NodeFolder OR (node.Kind = NodeForm AND LEN(node.Children) > 0) THEN
                        m.Tree.ToggleExpand()
                    ELSE
                        m.StatusBar.Message = fmt.Sprintf("opened: %s  (loader — TBD)", node.Name)
                    END IF
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF m.Focus = FocusWidgets THEN
            IF k = "up" THEN
                m.Palette.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.Palette.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                IF m.Palette.Cursor >= 0 AND m.Palette.Cursor < LEN(m.Palette.Lines) THEN
                    DIM kind AS STRING = m.Palette.Lines[m.Palette.Cursor]
                    m.StatusBar.Message = fmt.Sprintf("would create: %s  (designer — TBD)", kind)
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF k = "q" OR k = "ctrl+c" THEN
            RETURN m, tea.Quit
        END IF
    END IF

    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM body AS STRING = renderBody(m)
    DIM v AS tea.View = tea.NewView(body)
    v.AltScreen = TRUE
    v.MouseMode = tea.MouseModeCellMotion
    RETURN v
END FUNCTION

' ----------------------------------------------------------------------
' Rendering
' ----------------------------------------------------------------------

FUNCTION renderBody(m AS Model) AS STRING
    IF m.Width <= 0 OR m.Height <= 0 THEN
        ' First frame before WindowSizeMsg arrives.
        RETURN BgStyle().Render("DBtui — booting…")
    END IF

    DIM menuBar AS STRING = m.MenuBar.Render()
    DIM statusBar AS STRING = m.StatusBar.Render()

    DIM bodyH AS INTEGER = m.Height - 2
    IF bodyH < 1 THEN bodyH = 1

    ' Three-column layout: project tree | workspace | widget palette.
    DIM leftPane AS STRING = m.Tree.Render()
    DIM rightPane AS STRING = m.Palette.Render()
    DIM centerW AS INTEGER = m.Width - m.LeftW - m.RightW
    IF centerW < 1 THEN centerW = 1
    DIM workspace AS STRING = BgStyle().Width(centerW).Height(bodyH).Align(lipgloss.Center, lipgloss.Center).Render("(workspace)")
    DIM bodyRow AS STRING = lipgloss.JoinHorizontal(lipgloss.Top, leftPane, workspace, rightPane)

    IF m.MenuBar.Open THEN
        DIM dropdown AS STRING = m.MenuBar.RenderDropdown()
        DIM xOff AS INTEGER = m.MenuBar.MenuXOffset(m.MenuBar.Active)
        DIM dropPadded AS STRING = lipgloss.NewStyle().PaddingLeft(xOff).Background(ColorBg()).Render(dropdown)
        ' Layer the dropdown on top of the body row by joining vertically;
        ' the dropdown lives in the area immediately under the menubar and
        ' eats the top portion of bodyRow.
        DIM dropH AS INTEGER = lipgloss.Height(dropPadded)
        DIM remH AS INTEGER = bodyH - dropH
        IF remH < 0 THEN remH = 0
        DIM trimmedBody AS STRING = bodyRow
        ' Cheap clip: re-render bodyRow with reduced height by composing
        ' a transparent backing — leaving as-is keeps the rest of the
        ' panel readable under the dropdown.
        _ = remH
        DIM stacked AS STRING = lipgloss.JoinVertical(lipgloss.Left, dropPadded, trimmedBody)
        RETURN lipgloss.JoinVertical(lipgloss.Left, menuBar, stacked, statusBar)
    END IF

    RETURN lipgloss.JoinVertical(lipgloss.Left, menuBar, bodyRow, statusBar)
END FUNCTION
