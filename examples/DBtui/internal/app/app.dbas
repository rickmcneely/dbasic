' DBtui — internal/app/app.dbas
'
' Top-level bubbletea v2 model. Wires the MenuBar (top) and StatusBar
' (bottom) around an empty workspace painted in the VBDOS theme.
'
' Keyboard:
'   F10 / Alt+F  → open the File menu
'   Esc          → close the menu, return to normal mode
'   Left / Right → cycle menus (when one is open)
'   Up / Down    → cursor through dropdown items
'   Enter        → "select" — currently just echoes the action to the
'                   status bar (action dispatch lands in a later pass)
'   q / Ctrl+C   → quit (only when no menu is open)

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "charm.land/lipgloss/v2" AS lipgloss

' ----------------------------------------------------------------------
' Model
' ----------------------------------------------------------------------

TYPE Model
    DIM Width        AS INTEGER
    DIM Height       AS INTEGER
    DIM Focus        AS INTEGER     ' currently-focused panel (see ui/layout.dbas)
    DIM Mode         AS INTEGER     ' modal input mode (see ui/layout.dbas)
    DIM MenuBar      AS MenuBar
    DIM StatusBar    AS StatusBar
END TYPE

FUNCTION NewModel() AS Model
    DIM m AS Model
    m.Width = 0
    m.Height = 0
    m.Focus = FocusVisual
    m.Mode = ModeNormal
    m.MenuBar = NewMenuBar()
    m.StatusBar = NewStatusBar()
    m.StatusBar.Message = "DBtui — F10: Menu  |  q: Quit"
    RETURN m
END FUNCTION

' ----------------------------------------------------------------------
' bubbletea v2 lifecycle
' ----------------------------------------------------------------------

FUNCTION (m AS Model) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' WindowSizeMsg — record dimensions and cascade to the menu/status bar.
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = sizeMsg.Width
        m.Height = sizeMsg.Height
        m.MenuBar.SetWidth(m.Width)
        m.StatusBar.SetWidth(m.Width)
        RETURN m, NIL
    END IF

    ' KeyPressMsg — dispatch based on current mode.
    DIM keyMsg AS tea.KeyPressMsg
    DIM keyOk AS BOOLEAN
    keyMsg, keyOk = msg.(tea.KeyPressMsg)
    IF keyOk THEN
        DIM k AS STRING = keyMsg.String()

        IF m.Mode = ModeMenuBar THEN
            ' --- Menu mode --------------------------------------------------
            IF k = "esc" THEN
                m.MenuBar.Close()
                m.Mode = ModeNormal
                m.StatusBar.Message = "DBtui — F10: Menu  |  q: Quit"
                RETURN m, NIL
            END IF
            IF k = "left" THEN
                m.MenuBar.PrevMenu()
                RETURN m, NIL
            END IF
            IF k = "right" THEN
                m.MenuBar.NextMenu()
                RETURN m, NIL
            END IF
            IF k = "up" THEN
                m.MenuBar.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.MenuBar.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM action AS STRING = m.MenuBar.SelectedAction()
                m.MenuBar.Close()
                m.Mode = ModeNormal
                IF action = "file.quit" THEN
                    RETURN m, tea.Quit
                END IF
                IF action <> "" THEN
                    m.StatusBar.Message = "selected: " + action + "  (action dispatch — TBD)"
                ELSE
                    m.StatusBar.Message = "DBtui — F10: Menu  |  q: Quit"
                END IF
                RETURN m, NIL
            END IF
            ' Swallow unhandled keys while a menu is open.
            RETURN m, NIL
        END IF

        ' --- Normal mode --------------------------------------------------
        IF k = "f10" THEN
            m.MenuBar.OpenMenu(0)
            m.Mode = ModeMenuBar
            m.StatusBar.Message = "Menu — Esc: Close  ←/→: Menu  ↑/↓: Item  Enter: Select"
            RETURN m, NIL
        END IF
        IF k = "q" OR k = "ctrl+c" THEN
            RETURN m, tea.Quit
        END IF
    END IF

    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM body AS STRING = renderBody(m)
    DIM v AS tea.View = tea.NewView(body)
    v.AltScreen = TRUE
    v.MouseMode = tea.MouseModeCellMotion
    RETURN v
END FUNCTION

' ----------------------------------------------------------------------
' Rendering
' ----------------------------------------------------------------------

FUNCTION renderBody(m AS Model) AS STRING
    IF m.Width <= 0 OR m.Height <= 0 THEN
        ' First frame before WindowSizeMsg arrives.
        RETURN BgStyle().Render("DBtui — booting…")
    END IF

    DIM menuBar AS STRING = m.MenuBar.Render()
    DIM statusBar AS STRING = m.StatusBar.Render()

    ' When a dropdown is open, render it directly under the menu bar at
    ' the current menu's x-offset. The dropdown itself eats the top of
    ' the workspace area; the rest of the workspace stays painted in the
    ' VBDOS background. This is the cheap-and-correct first pass — a
    ' proper overlay (with the workspace still visible *behind* the
    ' dropdown) lands when ScrollPanel does and we have a real
    ' compositing helper to share.
    DIM workspaceH AS INTEGER = m.Height - 2
    IF workspaceH < 1 THEN workspaceH = 1

    IF m.MenuBar.Open THEN
        DIM dropdown AS STRING = m.MenuBar.RenderDropdown()
        DIM xOff AS INTEGER = m.MenuBar.MenuXOffset(m.MenuBar.Active)
        DIM dropPadded AS STRING = lipgloss.NewStyle().PaddingLeft(xOff).Background(ColorBg()).Render(dropdown)
        DIM dropH AS INTEGER = lipgloss.Height(dropPadded)
        DIM remH AS INTEGER = workspaceH - dropH
        IF remH < 0 THEN remH = 0
        DIM rest AS STRING = BgStyle().Width(m.Width).Height(remH).Render("")
        DIM withDropdown AS STRING = lipgloss.JoinVertical(lipgloss.Left, dropPadded, rest)
        RETURN lipgloss.JoinVertical(lipgloss.Left, menuBar, withDropdown, statusBar)
    END IF

    DIM emptyWorkspace AS STRING = BgStyle().Width(m.Width).Height(workspaceH).Align(lipgloss.Center, lipgloss.Center).Render("(workspace)")
    RETURN lipgloss.JoinVertical(lipgloss.Left, menuBar, emptyWorkspace, statusBar)
END FUNCTION
