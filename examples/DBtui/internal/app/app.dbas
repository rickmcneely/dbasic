' DBtui — internal/app/app.dbas
'
' Top-level bubbletea v2 model. Wires:
'   * MenuBar (top)
'   * StatusBar (bottom)
'   * A ScrollPanel left sidebar (placeholder project tree)
'   * An empty workspace center
'
' Keyboard:
'   F10           open the File menu
'   Tab           cycle focus: Sidebar → Workspace → Sidebar
'   Esc           close menu (in menu mode)
'   ↑/↓           cursor through the focused panel
'   PgUp / PgDn   scroll the focused panel
'   Enter         "select" — echoes action / selected line to status bar
'   q / Ctrl+C    quit (only when no menu is open)

IMPORT "charm.land/bubbletea/v2" AS tea
IMPORT "charm.land/lipgloss/v2" AS lipgloss
IMPORT "charm.land/bubbles/v2/textarea" AS textarea
IMPORT "fmt"
IMPORT "os"
IMPORT "os/exec" AS osexec
IMPORT "path/filepath"
IMPORT "sort"
IMPORT "strings"
IMPORT "time"

' ----------------------------------------------------------------------
' Model
' ----------------------------------------------------------------------

' VisualSnapshot is a point-in-time copy of everything Undo needs to
' restore — the widget list (by value, deep), the current selection
' set, and the primary-selection index. FormName is stamped so a Undo
' across a form switch is a no-op (we just won't restore into the wrong
' form; the snapshot is meaningless then).
TYPE VisualSnapshot
    DIM FormName   AS STRING
    DIM Widgets    AS []Widget
    DIM Selections AS []INTEGER
    DIM Selected   AS INTEGER
END TYPE

CONST undoStackCap AS INTEGER = 100

TYPE Model
    DIM Width      AS INTEGER
    DIM Height     AS INTEGER
    DIM Focus      AS INTEGER         ' which panel has focus (see ui/layout.dbas)
    DIM Mode       AS INTEGER         ' modal input mode (see ui/layout.dbas)
    DIM MenuBar    AS MenuBar
    DIM StatusBar  AS StatusBar
    DIM Tree       AS Tree            ' project tree (left sidebar)
    DIM Registry   AS Registry        ' widget registry — feeds the Widgets tab
    DIM ToolReg    AS ToolRegistry    ' tool registry — feeds the Tools tab
    DIM PaletteTab AS INTEGER         ' 0 = Widgets, 1 = Tools
    DIM Palette    AS ScrollPanel     ' palette scroll panel (under the tabs)
    DIM Properties AS PropertiesPanel ' selected widget / form properties (right column, bottom)
    DIM Visual     AS VisualEditor    ' form designer canvas (centre)
    DIM LeftW      AS INTEGER         ' left sidebar width
    DIM RightW     AS INTEGER         ' right sidebar width
    DIM PaletteH   AS INTEGER         ' fixed height for the palette block

    ' Panel screen rectangles — recomputed on each WindowSizeMsg so the
    ' mouse dispatcher can route a click to the panel under the cursor.
    DIM MenuRect    AS Rect
    DIM StatusRect  AS Rect
    DIM TreeRect    AS Rect
    DIM VisualRect  AS Rect
    DIM PaletteRect AS Rect
    DIM PropsRect   AS Rect

    ' Drag tracking (canvas widget move / resize).
    DIM DragMode      AS INTEGER       ' DragNone / DragMove / DragResize / …
    DIM DragWidgetIdx AS INTEGER
    DIM DragResizeX   AS BOOLEAN        ' legacy: right-edge resize
    DIM DragResizeY   AS BOOLEAN        ' legacy: bottom-edge resize
    ' Active edges for 8-handle resize. Combinations cover corners.
    DIM DragEdgeT     AS BOOLEAN
    DIM DragEdgeR     AS BOOLEAN
    DIM DragEdgeB     AS BOOLEAN
    DIM DragEdgeL     AS BOOLEAN
    DIM DragOrigX     AS INTEGER
    DIM DragOrigY     AS INTEGER
    DIM DragOrigW     AS INTEGER
    DIM DragOrigH     AS INTEGER
    DIM DragStartMx   AS INTEGER        ' mouse X at drag start (global)
    DIM DragStartMy   AS INTEGER        ' mouse Y at drag start (global)
    ' For multi-select moves — snapshot of every selected widget's
    ' original position at drag start. Motion applies the same delta
    ' to each. Parallel arrays (Idxs[i] is at position OrigXs[i],OrigYs[i]).
    DIM DragMultiIdxs AS []INTEGER
    DIM DragMultiXs   AS []INTEGER
    DIM DragMultiYs   AS []INTEGER
    ' Set TRUE after the drag's first MotionMsg fires pushUndo, so a
    ' pure click (no motion) doesn't pollute the undo history.
    DIM DragUndoPushed AS BOOLEAN

    ' Rectangle marquee on the canvas (DragRectSelect). All four are
    ' form-local coords. Active only while DragMode = DragRectSelect.
    DIM RectSelActive AS BOOLEAN
    DIM RectSelX0     AS INTEGER
    DIM RectSelY0     AS INTEGER
    DIM RectSelX1     AS INTEGER
    DIM RectSelY1     AS INTEGER

    ' Clipboard — widgets snapshotted by Edit > Cut / Copy. Paste
    ' appends clones with auto-uniquified Ids at a small offset.
    DIM Clipboard     AS []Widget

    ' Undo / redo — VisualSnapshot stacks. pushUndo() is called at the
    ' entry of every canvas mutation; Undo pops UndoStack, pushes the
    ' current state to RedoStack, and restores. Capped to ~100 entries.
    DIM UndoStack    AS []VisualSnapshot
    DIM RedoStack    AS []VisualSnapshot

    ' Double-click tracking — used by the palette to place a widget on
    ' the canvas when the same row is clicked twice in quick succession.
    DIM LastClickPanel AS INTEGER
    DIM LastClickRow   AS INTEGER
    DIM LastClickAt    AS time.Time

    ' Modal text-input dialog (file picker / SaveAs prompt). One at a
    ' time; ModeFileDialog gates keyboard input while DialogActive.
    DIM DialogActive AS BOOLEAN
    DIM DialogTitle     AS STRING
    DIM DialogMode      AS STRING        ' "open" or "save"
    DIM DialogAction    AS STRING        ' action ID dispatched on OK (file.open / file.saveas)
    DIM DialogCurDir    AS STRING        ' currently-shown directory
    DIM DialogMask      AS STRING        ' glob filter (e.g. "*.dbproj"); empty = all
    DIM DialogFolders   AS []STRING
    DIM DialogFiles     AS []STRING
    DIM DialogPathBuf   AS STRING        ' editable full-path
    DIM DialogPathPos   AS INTEGER       ' caret offset in PathBuf
    DIM DialogFocus     AS INTEGER       ' DialogFocusPath / Folders / Files / OK / Cancel
    DIM DialogFoldCur   AS INTEGER
    DIM DialogFoldOff   AS INTEGER
    DIM DialogFileCur   AS INTEGER
    DIM DialogFileOff   AS INTEGER
    DIM DialogError     AS STRING        ' last commit-error, shown in red

    ' Dialog geometry — stored on Model so the user can drag the box's
    ' bottom-right corner to resize. Recomputed on openDialog and on
    ' the first WindowSizeMsg if previously zeroed.
    DIM DialogX      AS INTEGER
    DIM DialogY      AS INTEGER
    DIM DialogWidth  AS INTEGER
    DIM DialogHeight AS INTEGER

    ' Code editor pane — swapped in for the Visual canvas when F7
    ' toggles CodeMode. Editor is a charm bubbles textarea.
    DIM CodeMode    AS BOOLEAN
    DIM Editor      AS textarea.Model
    DIM CodePath    AS STRING        ' path of file currently in Editor
    DIM CodeScroll  AS INTEGER       ' vertical scroll offset for highlighted render
    DIM CodeViewH   AS INTEGER       ' visible height of the code-editor pane (rows)

    ' Autocomplete popup state — refreshed after each keystroke in code mode.
    DIM AutoActive  AS BOOLEAN
    DIM AutoPrefix  AS STRING
    DIM AutoItems   AS []STRING
    DIM AutoIdx     AS INTEGER

    ' Code-editor text selection. Anchor is the fixed end of the selection;
    ' the cursor end is whatever m.Editor reports. CodeClip is an internal
    ' clipboard used for cut/copy/paste so paste stays synchronous even if
    ' the terminal blocks OSC52 reads.
    DIM SelActive    AS BOOLEAN
    DIM SelAnchorRow AS INTEGER
    DIM SelAnchorCol AS INTEGER
    DIM CodeClip     AS STRING

    ' Right-click event-list popup for widgets on the canvas. Pops up
    ' when the user right-clicks a widget; selecting an event navigates
    ' (or creates a stub) in the code editor for that handler.
    DIM CtxMenuActive  AS BOOLEAN
    DIM CtxMenuX       AS INTEGER
    DIM CtxMenuY       AS INTEGER
    DIM CtxMenuWidId   AS STRING
    DIM CtxMenuWidKind AS STRING
    DIM CtxMenuItems   AS []STRING
    DIM CtxMenuIdx     AS INTEGER

    ' Bottom pane (Console + Shell tabs) — F12 toggles visibility.
    ' BottomHeight defaults to ~12 rows; later we can drag-resize.
    DIM BottomVisible AS BOOLEAN
    DIM BottomTab     AS INTEGER
    DIM BottomHeight  AS INTEGER
    DIM BottomRect    AS Rect
    DIM ConsoleBuf    AS []STRING        ' captured stdout/stderr lines
END TYPE

FUNCTION NewModel() AS Model
    DIM m AS Model
    m.Width = 0
    m.Height = 0
    m.Focus = FocusProjectTree
    m.Mode = ModeNormal
    m.LeftW = 28
    m.RightW = 32
    m.PaletteH = 8
    m.CodeMode = FALSE
    m.Editor = textarea.New()
    m.Editor.ShowLineNumbers = TRUE
    m.Editor.Prompt = ""
    m.Editor.Placeholder = "' Event handlers for this form — F7 returns to the canvas."
    m.BottomVisible = FALSE
    m.BottomTab = BottomTabConsole
    m.BottomHeight = 12
    m.MenuBar = NewMenuBar()
    m.StatusBar = NewStatusBar()
    m.StatusBar.Message = defaultStatus()
    m.Tree = NewTree()
    m.Tree.SetFocused(TRUE)
    m.Registry = DefaultRegistry()
    m.ToolReg = DefaultToolRegistry()
    m.PaletteTab = 0
    m.Palette = NewScrollPanel()
    m.Palette.Title = ""           ' tab strip renders the title now
    m.Palette.Cursor = 0
    m.Palette.Lines = m.Registry.Kinds
    m.Visual = NewVisualEditor()
    m.Properties = NewPropertiesPanel()
    ' Load the project's start form into the canvas. If the start
    ' form name doesn't match anything, fall back to the first form.
    DIM startIdx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Tree.Project.StartForm THEN startIdx = i
    NEXT i
    IF startIdx < 0 AND LEN(m.Tree.Project.Forms) > 0 THEN startIdx = 0
    IF startIdx >= 0 THEN
        m.Visual.LoadForm(m.Tree.Project.Forms[startIdx], m.Registry)
        ' Sync the properties panel to whatever the visual editor
        ' decided to select; if there are no widgets it shows the
        ' form's own properties instead.
        DIM sw AS Widget
        DIM swOk AS BOOLEAN
        sw, swOk = m.Visual.SelectedWidget()
        IF swOk THEN
            m.Properties.SetWidget(sw)
        ELSE
            m.Properties.SetForm(m.Tree.Project.Forms[startIdx])
        END IF
    END IF
    RETURN m
END FUNCTION

' syncProperties refreshes the right-hand Properties panel from the
' visual editor's current selection. Called whenever the selection
' may have changed.
SUB syncProperties(m AS POINTER TO Model)
    DIM sw AS Widget
    DIM swOk AS BOOLEAN
    sw, swOk = m.Visual.SelectedWidget()
    IF swOk THEN
        m.Properties.SetWidget(sw)
        RETURN
    END IF
    ' Fallback: show the loaded form's properties.
    DIM fname AS STRING = m.Visual.FormName
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = fname THEN
            m.Properties.SetForm(m.Tree.Project.Forms[i])
            RETURN
        END IF
    NEXT i
    m.Properties.Clear()
END SUB

FUNCTION defaultStatus() AS STRING
    RETURN "DBtui — F10:Menu  F5:Run  F7:Code  F12:Console  |  Tab:Focus  ↑/↓:Move  Enter:Pick  q:Quit"
END FUNCTION

' ----------------------------------------------------------------------
' Properties-panel edit application
'
' These three helpers route a property edit (initiated by Space, ←/→,
' or Enter on the Properties panel) to the right source of truth:
' the selected widget in m.Visual.Widgets, or the form lookup'd by
' name out of m.Tree.Project.Forms. They never refresh the panel
' themselves — the caller does that via refreshPropertiesFromSource
' so the same path handles bool, enum, and text/int/color commits.
' ----------------------------------------------------------------------

FUNCTION applyWidgetEdit(m AS POINTER TO Model, name AS STRING, value AS ANY) AS ERROR
    IF m.Visual.Selected < 0 OR m.Visual.Selected >= LEN(m.Visual.Widgets) THEN
        RETURN NewError("no widget selected")
    END IF
    RETURN SetWidgetProperty(@m.Visual.Widgets[m.Visual.Selected], name, value)
END FUNCTION

FUNCTION applyFormEdit(m AS POINTER TO Model, name AS STRING, value AS ANY) AS ERROR
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Visual.FormName THEN idx = i
    NEXT i
    IF idx < 0 THEN RETURN NewError("no current form")
    DIM err AS ERROR = SetFormProperty(@m.Tree.Project.Forms[idx], name, value)
    IF err <> NIL THEN RETURN err
    ' Sync display-relevant fields in the visual editor so the canvas
    ' reflects the change next paint. Non-visual props (Modal, Resizable*,
    ' StartPos, ShowInTaskbar, ShowStatusBar, Border, Corner) don't need
    ' a sync — the form file is the source of truth and a future save
    ' will persist them.
    IF name = "Name" THEN m.Visual.FormName = m.Tree.Project.Forms[idx].Name
    IF name = "Title" THEN m.Visual.FormTitle = m.Tree.Project.Forms[idx].Title
    IF name = "Width" THEN m.Visual.FormW = m.Tree.Project.Forms[idx].Width
    IF name = "Height" THEN m.Visual.FormH = m.Tree.Project.Forms[idx].Height
    IF name = "BgColor" THEN m.Visual.FormBgColor = m.Tree.Project.Forms[idx].BgColor
    IF name = "FgColor" THEN m.Visual.FormFgColor = m.Tree.Project.Forms[idx].FgColor
    RETURN NIL
END FUNCTION

' focusPanel — single chokepoint for transitioning focus. Mirrors the
' inline blocks in the Tab handler but consolidated so the mouse
' dispatcher doesn't re-derive the four panel SetFocused calls.
SUB focusPanel(m AS POINTER TO Model, target AS INTEGER)
    m.Focus = target
    m.Tree.SetFocused(target = FocusProjectTree)
    m.Visual.SetFocused(target = FocusVisual)
    m.Palette.Focused = (target = FocusWidgets)
    m.Properties.SetFocused(target = FocusProperties)
END SUB

' setPaletteTab — switches between Widgets and Tools and reloads the
' ScrollPanel's Lines from the active registry.
SUB setPaletteTab(m AS POINTER TO Model, tab AS INTEGER)
    m.PaletteTab = tab
    IF tab = 1 THEN
        m.Palette.Lines = m.ToolReg.Kinds
    ELSE
        m.Palette.Lines = m.Registry.Kinds
    END IF
    m.Palette.Cursor = 0
    m.Palette.Offset = 0
END SUB

' renderPaletteTabs — one-row strip with [ Widgets ] [ Tools ].
FUNCTION renderPaletteTabs(m AS Model, width AS INTEGER) AS STRING
    DIM activeStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorSelection()).Bold(TRUE)
    DIM inactiveStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorMenuFg()).Background(ColorMenuBg())
    DIM bracketActive AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorSelection()).Bold(TRUE)
    DIM bracketInactive AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorHotkey()).Background(ColorMenuBg())
    DIM gapStyle AS lipgloss.Style = lipgloss.NewStyle().Background(ColorMenuBg())

    DIM wTab AS STRING
    DIM tTab AS STRING
    IF m.PaletteTab = 0 THEN
        wTab = bracketActive.Render("[ ") + activeStyle.Render("Widgets") + bracketActive.Render(" ]")
        tTab = bracketInactive.Render("[ ") + inactiveStyle.Render("Tools") + bracketInactive.Render(" ]")
    ELSE
        wTab = bracketInactive.Render("[ ") + inactiveStyle.Render("Widgets") + bracketInactive.Render(" ]")
        tTab = bracketActive.Render("[ ") + activeStyle.Render("Tools") + bracketActive.Render(" ]")
    END IF
    DIM tabs AS STRING = wTab + gapStyle.Render(" ") + tTab
    DIM tabsW AS INTEGER = lipgloss.Width(tabs)
    DIM gap AS INTEGER = width - tabsW
    IF gap < 0 THEN gap = 0
    RETURN tabs + gapStyle.Render(strings.Repeat(" ", gap))
END FUNCTION

' placePaletteTool — adds a new ToolEntry to the active form's Tools
' array from the currently-selected tool kind in the palette.
FUNCTION placePaletteTool(m AS POINTER TO Model) AS ERROR
    IF m.Palette.Cursor < 0 OR m.Palette.Cursor >= LEN(m.Palette.Lines) THEN
        RETURN NewError("no tool selected")
    END IF
    DIM kind AS STRING = m.Palette.Lines[m.Palette.Cursor]
    ' Find the active form.
    DIM fIdx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Visual.FormName THEN fIdx = i
    NEXT i
    IF fIdx < 0 THEN RETURN NewError("no current form")
    DIM id AS STRING = fmt.Sprintf("%s%d", strings.ToLower(Mid(kind, 1, 1)) + Mid(kind, 2, LEN(kind) - 1), LEN(m.Tree.Project.Forms[fIdx].Tools) + 1)
    DIM t AS ToolEntry
    DIM err AS ERROR
    t, err = m.ToolReg.Create(kind, id)
    IF err <> NIL THEN RETURN err
    m.Tree.Project.Forms[fIdx].Tools = APPEND(m.Tree.Project.Forms[fIdx].Tools, t)
    m.Tree.buildFromProject()
    m.Tree.rebuildLines()
    m.Properties.SetTool(t)
    RETURN NIL
END FUNCTION

' placePaletteWidget — palette double-click handler. Creates a new
' instance of the cursor's kind via the registry and drops it at the
' centre of the form. Returns NIL on success or an error from
' Registry.Create.
FUNCTION placePaletteWidget(m AS POINTER TO Model) AS ERROR
    IF m.Palette.Cursor < 0 OR m.Palette.Cursor >= LEN(m.Palette.Lines) THEN
        RETURN NewError("no palette item selected")
    END IF
    DIM kind AS STRING = m.Palette.Lines[m.Palette.Cursor]
    DIM id AS STRING = fmt.Sprintf("%s%d", kind, LEN(m.Visual.Widgets) + 1)
    DIM w AS Widget
    DIM err AS ERROR
    w, err = m.Registry.Create(kind, id)
    IF err <> NIL THEN RETURN err
    w.X = (m.Visual.FormW - w.W) / 2
    IF w.X < 1 THEN w.X = 1
    w.Y = (m.Visual.FormH - w.H) / 2
    IF w.Y < 1 THEN w.Y = 1
    m.Visual.Widgets = APPEND(m.Visual.Widgets, w)
    m.Visual.Selected = LEN(m.Visual.Widgets) - 1
    RETURN NIL
END FUNCTION

' syncProjectFromVisual — push the visual editor's mutated Widgets back
' into the matching form's Widgets slice. Called before any Save so
' drags/resizes/property edits are reflected in the .dbproj output.
SUB syncProjectFromVisual(m AS POINTER TO Model)
    IF m.Visual.FormName = "" THEN RETURN
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Visual.FormName THEN idx = i
    NEXT i
    IF idx < 0 THEN RETURN
    DIM entries AS []WidgetEntry
    DIM j AS INTEGER
    FOR j = 0 TO LEN(m.Visual.Widgets) - 1
        entries = APPEND(entries, WidgetToEntry(m.Visual.Widgets[j]))
    NEXT j
    m.Tree.Project.Forms[idx].Widgets = entries
END SUB

' loadStartForm — after a fresh project is set on m.Tree.Project, load
' the start form into the visual editor and seed the Properties panel
' from the first widget (or the form itself).
SUB loadStartForm(m AS POINTER TO Model)
    DIM startIdx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Tree.Project.StartForm THEN startIdx = i
    NEXT i
    IF startIdx < 0 AND LEN(m.Tree.Project.Forms) > 0 THEN startIdx = 0
    IF startIdx < 0 THEN RETURN
    m.Visual.LoadForm(m.Tree.Project.Forms[startIdx], m.Registry)
    DIM sw AS Widget
    DIM swOk AS BOOLEAN
    sw, swOk = m.Visual.SelectedWidget()
    IF swOk THEN
        m.Properties.SetWidget(sw)
    ELSE
        m.Properties.SetForm(m.Tree.Project.Forms[startIdx])
    END IF
END SUB

' ----------------------------------------------------------------------
' Bottom pane (Console + Shell tabs) — F12 toggles visibility.
' Console captures Build/Run output; Shell is a stub for now.
' ----------------------------------------------------------------------

SUB toggleBottomPane(m AS POINTER TO Model)
    m.BottomVisible = NOT m.BottomVisible
    IF m.BottomVisible THEN
        m.StatusBar.Message = "Console open — F12 to hide  |  Tabs: Console / Shell"
    ELSE
        m.StatusBar.Message = defaultStatus()
    END IF
    applyLayout(m)
END SUB

' consoleAppend pushes a line into the captured console buffer.
SUB consoleAppend(m AS POINTER TO Model, line AS STRING)
    m.ConsoleBuf = APPEND(m.ConsoleBuf, line)
    ' Cap the buffer at 2000 lines so it doesn't grow forever.
    IF LEN(m.ConsoleBuf) > 2000 THEN
        DIM trimmed AS []STRING
        DIM i AS INTEGER
        FOR i = LEN(m.ConsoleBuf) - 2000 TO LEN(m.ConsoleBuf) - 1
            trimmed = APPEND(trimmed, m.ConsoleBuf[i])
        NEXT i
        m.ConsoleBuf = trimmed
    END IF
END SUB

' runBuild — Run→Build menu handler. Codegens the project to disk,
' shells out to `dbasic build` against the result, streams stdout +
' stderr into the console buffer. Pops the console pane open so the
' user sees the output. Returns TRUE on success, FALSE on failure.
FUNCTION runBuild(m AS POINTER TO Model) AS BOOLEAN
    syncProjectFromVisual(m)
    ' Ensure each form's code file exists. If a form has never been
    ' opened in the code editor, generate the wired stub now so the
    ' codegen has handlers to call (otherwise buttons fire empty
    ' auto-stubs and nothing happens at runtime).
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(m.Tree.Project.Forms) - 1
        DIM cp AS STRING = m.Tree.Project.Forms[fi].Code
        IF cp = "" THEN
            cp = "forms/" + m.Tree.Project.Forms[fi].Name + ".dbas"
            m.Tree.Project.Forms[fi].Code = cp
        END IF
        DIM probe AS BYTES
        DIM probeErr AS ERROR
        probe, probeErr = os.ReadFile(cp)
        _ = probe
        IF probeErr <> NIL THEN
            DIM parentDir AS STRING = filepath.Dir(cp)
            IF parentDir <> "" AND parentDir <> "." THEN
                DIM mkErr AS ERROR = os.MkdirAll(parentDir, 0755)
                _ = mkErr
            END IF
            WriteFile(cp, codeStubFor(m.Tree.Project.Forms[fi]))
            consoleAppend(m, "auto-created: " + cp)
        END IF
    NEXT fi
    DIM projName AS STRING = m.Tree.Project.Name
    IF projName = "" THEN projName = "untitled"
    DIM outDbas AS STRING = projName + ".dbas"
    DIM outBin  AS STRING = projName
    DIM code AS STRING = GenerateProgram(m.Tree.Project)
    WriteFile(outDbas, code)
    consoleAppend(m, "$ dbasic build " + outDbas + " -o " + outBin)

    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command("dbasic", "build", outDbas, "-o", outBin)
    DIM outBytes AS BYTES
    DIM err AS ERROR
    outBytes, err = cmd.CombinedOutput()
    DIM outStr AS STRING = string(outBytes)
    DIM lines AS []STRING = strings.Split(outStr, "\n")
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        IF lines[i] <> "" OR i < LEN(lines) - 1 THEN consoleAppend(m, lines[i])
    NEXT i
    m.BottomVisible = TRUE
    m.BottomTab = BottomTabConsole
    IF err <> NIL THEN
        consoleAppend(m, "[build failed] " + err.Error())
        m.StatusBar.Message = "⚠ build failed — see console"
        RETURN FALSE
    END IF
    consoleAppend(m, "[build ok] " + outBin)
    m.StatusBar.Message = "build ok: " + outBin
    RETURN TRUE
END FUNCTION

' ----------------------------------------------------------------------
' Project-tree loader — wires the "(loader — TBD)" stubs to real
' actions. Form node → load form into canvas. Code node → open editor
' on that file. Widget node → load parent form + select that widget.
' ----------------------------------------------------------------------

SUB loadFormByPath(m AS POINTER TO Model, formPath AS STRING)
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].File = formPath THEN idx = i
    NEXT i
    IF idx < 0 THEN RETURN
    m.Visual.LoadForm(m.Tree.Project.Forms[idx], m.Registry)
    DIM sw AS Widget
    DIM swOk AS BOOLEAN
    sw, swOk = m.Visual.SelectedWidget()
    IF swOk THEN
        m.Properties.SetWidget(sw)
    ELSE
        m.Properties.SetForm(m.Tree.Project.Forms[idx])
    END IF
    IF m.CodeMode THEN exitCodeMode(m)
    m.StatusBar.Message = "loaded form: " + m.Tree.Project.Forms[idx].Name
END SUB

SUB selectWidgetByName(m AS POINTER TO Model, formPath AS STRING, nodeName AS STRING)
    loadFormByPath(m, formPath)
    DIM idx AS INTEGER = strings.Index(nodeName, " (")
    DIM widgetId AS STRING = nodeName
    IF idx > 0 THEN widgetId = Mid(nodeName, 1, idx)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Visual.Widgets) - 1
        IF m.Visual.Widgets[i].Id = widgetId THEN
            m.Visual.Selected = i
            m.Properties.SetWidget(m.Visual.Widgets[i])
            m.StatusBar.Message = "selected: " + widgetId
            RETURN
        END IF
    NEXT i
END SUB

SUB openCodeForFormPath(m AS POINTER TO Model, codePath AS STRING)
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Code = codePath THEN idx = i
    NEXT i
    IF idx < 0 THEN
        m.StatusBar.Message = "⚠ no form for " + codePath
        RETURN
    END IF
    loadFormByPath(m, m.Tree.Project.Forms[idx].File)
    enterCodeMode(m)
END SUB

SUB selectToolByName(m AS POINTER TO Model, formPath AS STRING, nodeName AS STRING)
    loadFormByPath(m, formPath)
    DIM idx AS INTEGER = strings.Index(nodeName, " (")
    DIM toolId AS STRING = nodeName
    IF idx > 0 THEN toolId = Mid(nodeName, 1, idx)
    DIM fIdx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].File = formPath THEN fIdx = i
    NEXT i
    IF fIdx < 0 THEN RETURN
    DIM j AS INTEGER
    FOR j = 0 TO LEN(m.Tree.Project.Forms[fIdx].Tools) - 1
        IF m.Tree.Project.Forms[fIdx].Tools[j].Id = toolId THEN
            m.Properties.SetTool(m.Tree.Project.Forms[fIdx].Tools[j])
            m.StatusBar.Message = "selected tool: " + toolId
            RETURN
        END IF
    NEXT j
END SUB

' dispatchTreeOpen — single chokepoint used by both the mouse double-
' click handler and the keyboard Enter handler.
SUB dispatchTreeOpen(m AS POINTER TO Model, node AS POINTER TO TreeNode)
    IF node = NIL THEN RETURN
    IF node.Kind = NodeForm THEN
        loadFormByPath(m, node.Path)
        RETURN
    END IF
    IF node.Kind = NodeCode THEN
        openCodeForFormPath(m, node.Path)
        RETURN
    END IF
    IF node.Kind = NodeWidget THEN
        selectWidgetByName(m, node.Path, node.Name)
        RETURN
    END IF
    IF node.Kind = NodeTool THEN
        selectToolByName(m, node.Path, node.Name)
        RETURN
    END IF
END SUB

' runRun — Run→Run menu handler. Builds the project; on success,
' returns a tea.Cmd that suspends bubbletea, executes the generated
' binary with the terminal attached, then resumes. The user sees the
' running program full-screen until it exits.
FUNCTION runRun(m AS POINTER TO Model) AS tea.Cmd
    IF NOT runBuild(m) THEN RETURN NIL
    DIM projName AS STRING = m.Tree.Project.Name
    IF projName = "" THEN projName = "untitled"
    DIM binPath AS STRING = "./" + projName
    consoleAppend(m, "$ " + binPath)
    DIM cmd AS POINTER TO osexec.Cmd = osexec.Command(binPath)
    RETURN tea.ExecProcess(cmd, NIL)
END FUNCTION

' ----------------------------------------------------------------------
' Code editor pane — F7 toggles canvas ↔ code editor for the currently-
' loaded form. Editor buffer is backed by the form's Code path
' (form.Code, e.g. "forms/frmStart.dbas"). Loading auto-stubs a tiny
' template if the file doesn't exist yet.
' ----------------------------------------------------------------------

' renderBottomPane builds the Console / Shell tabbed strip + body.
' Tab strip at row 0 of the pane, content fills the rest.
FUNCTION renderBottomPane(m AS Model) AS STRING
    DIM w AS INTEGER = m.BottomRect.W
    DIM h AS INTEGER = m.BottomRect.H
    IF w < 1 THEN w = 1
    IF h < 2 THEN h = 2

    ' --- Tab strip (2 rows: labels + horizontal rule) ---------------
    DIM activeStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorSelection()).Bold(TRUE)
    DIM inactiveStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorMenuFg()).Background(ColorMenuBg())
    DIM bracketActive AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorSelection()).Bold(TRUE)
    DIM bracketInactive AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorHotkey()).Background(ColorMenuBg())
    DIM gapStyle AS lipgloss.Style = lipgloss.NewStyle().Background(ColorMenuBg())
    DIM ruleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorBg())

    DIM consoleLbl AS STRING = "Console"
    DIM shellLbl AS STRING = "Shell"
    DIM consoleTab AS STRING
    DIM shellTab AS STRING
    IF m.BottomTab = BottomTabConsole THEN
        consoleTab = bracketActive.Render("[ ") + activeStyle.Render(consoleLbl) + bracketActive.Render(" ]")
        shellTab   = bracketInactive.Render("[ ") + inactiveStyle.Render(shellLbl) + bracketInactive.Render(" ]")
    ELSE
        consoleTab = bracketInactive.Render("[ ") + inactiveStyle.Render(consoleLbl) + bracketInactive.Render(" ]")
        shellTab   = bracketActive.Render("[ ") + activeStyle.Render(shellLbl) + bracketActive.Render(" ]")
    END IF
    DIM tabs AS STRING = consoleTab + gapStyle.Render(" ") + shellTab
    DIM tabsW AS INTEGER = lipgloss.Width(tabs)
    DIM gap AS INTEGER = w - tabsW
    IF gap < 0 THEN gap = 0
    DIM tabRow AS STRING = tabs + gapStyle.Render(strings.Repeat(" ", gap))
    DIM ruleRow AS STRING = ruleStyle.Render(strings.Repeat("─", w))

    ' --- Content -----------------------------------------------------
    DIM contentH AS INTEGER = h - 2
    IF contentH < 1 THEN contentH = 1
    DIM contentStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorBg()).Width(w)
    DIM lines AS []STRING
    lines = APPEND(lines, tabRow)
    lines = APPEND(lines, ruleRow)
    IF m.BottomTab = BottomTabConsole THEN
        ' Show the last contentH lines of the console buffer.
        DIM start AS INTEGER = LEN(m.ConsoleBuf) - contentH
        IF start < 0 THEN start = 0
        DIM i AS INTEGER
        FOR i = 0 TO contentH - 1
            DIM bufIdx AS INTEGER = start + i
            DIM line AS STRING = ""
            IF bufIdx < LEN(m.ConsoleBuf) THEN line = m.ConsoleBuf[bufIdx]
            ' Trim to fit w cells (lipgloss .Width does the padding).
            IF lipgloss.Width(line) > w THEN
                DO WHILE lipgloss.Width(line) > w AND LEN(line) > 0
                    line = Mid(line, 1, LEN(line) - 1)
                LOOP
            END IF
            lines = APPEND(lines, contentStyle.Render(line))
        NEXT i
    ELSE
        ' Shell tab — PTY-backed live shell, rendered through vt10x.
        ' Lazy-start on first view. Pass the panel's current dims so
        ' bash spawns at the right size from the very first prompt.
        IF NOT ShellIsActive() THEN
            DIM serr AS ERROR = PtyShellStart(w, contentH)
            _ = serr
        END IF
        DIM screen AS STRING = ShellRender(w, contentH)
        DIM sbufV AS []STRING = strings.Split(screen, "\n")
        DIM shJ AS INTEGER
        FOR shJ = 0 TO contentH - 1
            DIM shLine AS STRING = ""
            IF shJ < LEN(sbufV) THEN shLine = sbufV[shJ]
            IF lipgloss.Width(shLine) > w THEN
                DO WHILE lipgloss.Width(shLine) > w AND LEN(shLine) > 0
                    shLine = Mid(shLine, 1, LEN(shLine) - 1)
                LOOP
            END IF
            lines = APPEND(lines, contentStyle.Render(shLine))
        NEXT shJ
    END IF
    RETURN strings.Join(lines, "\n")
END FUNCTION

' renderCanvasCaption builds the one-row title bar above the
' Visual canvas / Code editor. Styled as ─[ Title ]──────── filling the
' full canvas width, so the center column stays aligned with the
' sidebars and no cells are wasted on a full border.
FUNCTION renderCanvasCaption(text AS STRING, width AS INTEGER) AS STRING
    DIM ruleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorBg())
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorBg()).Bold(TRUE)
    DIM label AS STRING = "[ " + text + " ]"
    DIM maxLabelW AS INTEGER = width - 4
    IF maxLabelW < 1 THEN maxLabelW = 1
    IF lipgloss.Width(label) > maxLabelW THEN
        DO WHILE lipgloss.Width(label) > maxLabelW AND LEN(label) > 0
            label = Mid(label, 1, LEN(label) - 1)
        LOOP
    END IF
    DIM labelW AS INTEGER = lipgloss.Width(label)
    DIM fillW AS INTEGER = width - 1 - labelW - 1
    IF fillW < 0 THEN fillW = 0
    RETURN ruleStyle.Render("─") + titleStyle.Render(label) + ruleStyle.Render(strings.Repeat("─", fillW)) + ruleStyle.Render("─")
END FUNCTION

' codeStubFor returns the stub body written when a form's code file
' is opened for the first time. Seeds sample handlers for each Button
' and FileDialog so the user starts with something concrete; if the
' form has both, wires the first Button → first FileDialog's Show().
FUNCTION codeStubFor(form AS Form) AS STRING
    DIM s AS STRING = ""
    s = s + "' Event handlers for " + form.Name + ".\n"
    s = s + "' DBtui wires these to the form's widgets at codegen time.\n"
    s = s + "\n"
    s = s + "IMPORT \"fmt\"\n"
    s = s + "IMPORT \"os\"\n"
    s = s + "\n"
    s = s + "SUB FormLoad()\n"
    s = s + "    ' Called once when the form is shown.\n"
    s = s + "END SUB\n\n"

    ' Pick the first FileDialog tool (if any) to wire buttons to.
    DIM firstDlg AS STRING = ""
    DIM ti AS INTEGER
    FOR ti = 0 TO LEN(form.Tools) - 1
        IF firstDlg = "" AND form.Tools[ti].Kind = "FileDialog" THEN firstDlg = form.Tools[ti].Id
    NEXT ti

    DIM i AS INTEGER
    FOR i = 0 TO LEN(form.Widgets) - 1
        DIM w AS WidgetEntry = form.Widgets[i]
        IF w.Kind = WidgetKindButton THEN
            s = s + "SUB " + w.Id + "_Click()\n"
            IF firstDlg <> "" THEN
                s = s + "    ' Open the file dialog — result arrives via " + firstDlg + "_FileSelected.\n"
                s = s + "    " + firstDlg + "_Show()\n"
            ELSE
                s = s + "    ' Button click handler — fill in.\n"
            END IF
            s = s + "END SUB\n\n"
        END IF
    NEXT i

    ' Sample _Change handlers for interactive non-Button widgets.
    DIM j AS INTEGER
    FOR j = 0 TO LEN(form.Widgets) - 1
        DIM ww AS WidgetEntry = form.Widgets[j]
        DIM hasChange AS BOOLEAN = FALSE
        IF ww.Kind = WidgetKindTextInput   THEN hasChange = TRUE
        IF ww.Kind = WidgetKindCheckbox    THEN hasChange = TRUE
        IF ww.Kind = WidgetKindRadioButton THEN hasChange = TRUE
        IF ww.Kind = WidgetKindComboBox    THEN hasChange = TRUE
        IF ww.Kind = WidgetKindListBox     THEN hasChange = TRUE
        IF ww.Kind = WidgetKindScrollBar   THEN hasChange = TRUE
        IF ww.Kind = WidgetKindTabStrip    THEN hasChange = TRUE
        IF ww.Kind = WidgetKindScrollPane  THEN hasChange = TRUE
        IF ww.Kind = WidgetKindTreeView    THEN hasChange = TRUE
        IF ww.Kind = WidgetKindTextArea    THEN hasChange = TRUE
        IF ww.Kind = WidgetKindPropertyGrid THEN hasChange = TRUE
        IF hasChange THEN
            s = s + "SUB " + ww.Id + "_Change()\n"
            s = s + "    fmt.Fprintln(os.Stderr, \"" + ww.Id + " changed\")\n"
            s = s + "END SUB\n\n"
        END IF
        IF ww.Kind = WidgetKindMenuBar OR ww.Kind = WidgetKindToolbar THEN
            s = s + "SUB " + ww.Id + "_Action(action AS STRING)\n"
            s = s + "    SELECT CASE action\n"
            s = s + "        CASE \"file.exit\"\n"
            s = s + "            os.Exit(0)\n"
            s = s + "        CASE ELSE\n"
            s = s + "            fmt.Fprintln(os.Stderr, \"action:\", action)\n"
            s = s + "    END SELECT\n"
            s = s + "END SUB\n\n"
        END IF
    NEXT j

    FOR i = 0 TO LEN(form.Tools) - 1
        DIM t AS ToolEntry = form.Tools[i]
        IF t.Kind = "FileDialog" THEN
            s = s + "SUB " + t.Id + "_FileSelected(path AS STRING)\n"
            s = s + "    fmt.Fprintln(os.Stderr, \"selected:\", path)\n"
            s = s + "END SUB\n\n"
        END IF
    NEXT i

    RETURN s
END FUNCTION

' enterCodeMode reads the active form's code file into the editor and
' switches the view. If the file doesn't exist yet, a stub is written
' first so the user has something to edit.
SUB enterCodeMode(m AS POINTER TO Model)
    DIM idx AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[i].Name = m.Visual.FormName THEN idx = i
    NEXT i
    IF idx < 0 THEN
        m.StatusBar.Message = "⚠ no current form"
        RETURN
    END IF

    DIM codePath AS STRING = m.Tree.Project.Forms[idx].Code
    IF codePath = "" THEN
        codePath = "forms/" + m.Tree.Project.Forms[idx].Name + ".dbas"
        m.Tree.Project.Forms[idx].Code = codePath
    END IF

    DIM data AS BYTES
    DIM err AS ERROR
    data, err = os.ReadFile(codePath)
    DIM body AS STRING
    IF err <> NIL THEN
        body = codeStubFor(m.Tree.Project.Forms[idx])
        ' Best-effort write; ignore errors (project might be unsaved).
        WriteFile(codePath, body)
    ELSE
        body = string(data)
    END IF

    m.Editor.Reset()
    m.Editor.SetValue(body)
    ' SetValue lands the cursor at the end of the buffer; rewind to top
    ' so the user sees the start of the file in the highlighted view.
    DO WHILE m.Editor.Line() > 0
        m.Editor.CursorUp()
    LOOP
    m.Editor.CursorStart()
    DIM eCmd AS tea.Cmd = m.Editor.Focus()
    _ = eCmd
    m.CodePath = codePath
    m.CodeMode = TRUE
    m.CodeScroll = 0
    m.StatusBar.Message = "Code: " + codePath + "  —  F7: back to canvas  Ctrl+S: save"
END SUB

' exitCodeMode writes the buffer back to disk and switches back to the
' visual canvas.
SUB exitCodeMode(m AS POINTER TO Model)
    IF m.CodePath <> "" THEN
        WriteFile(m.CodePath, m.Editor.Value())
    END IF
    m.Editor.Blur()
    m.CodeMode = FALSE
    m.StatusBar.Message = defaultStatus()
END SUB

' ----------------------------------------------------------------------
' Code-editor text selection. The anchor is a frozen (row,col); the
' moving end of the selection is whatever m.Editor reports as its
' current cursor. Selection helpers normalize the (anchor, cursor)
' pair into (start, end) for rendering and mutation.
' ----------------------------------------------------------------------

' selBounds — (r0, c0, r1, c1) with the smaller of the two endpoints
' first. Safe to call even when m.SelActive is FALSE (returns zeros).
FUNCTION selBounds(m AS POINTER TO Model) AS (INTEGER, INTEGER, INTEGER, INTEGER)
    IF NOT m.SelActive THEN RETURN 0, 0, 0, 0
    DIM ar AS INTEGER = m.SelAnchorRow
    DIM ac AS INTEGER = m.SelAnchorCol
    DIM cr AS INTEGER = m.Editor.Line()
    DIM cc AS INTEGER = m.Editor.Column()
    IF ar < cr THEN RETURN ar, ac, cr, cc
    IF ar > cr THEN RETURN cr, cc, ar, ac
    IF ac <= cc THEN RETURN ar, ac, cr, cc
    RETURN cr, cc, ar, ac
END FUNCTION

' selText — extracts the currently selected substring from the buffer.
FUNCTION selText(m AS POINTER TO Model) AS STRING
    IF NOT m.SelActive THEN RETURN ""
    DIM r0 AS INTEGER
    DIM c0 AS INTEGER
    DIM r1 AS INTEGER
    DIM c1 AS INTEGER
    r0, c0, r1, c1 = selBounds(m)
    DIM lines AS []STRING = strings.Split(m.Editor.Value(), "\n")
    IF r0 < 0 OR r0 >= LEN(lines) THEN RETURN ""
    IF r1 < 0 OR r1 >= LEN(lines) THEN RETURN ""
    IF r0 = r1 THEN
        IF c1 <= c0 THEN RETURN ""
        RETURN Mid(lines[r0], c0 + 1, c1 - c0)
    END IF
    DIM parts AS []STRING
    parts = APPEND(parts, Mid(lines[r0], c0 + 1, LEN(lines[r0]) - c0))
    DIM rr AS INTEGER
    FOR rr = r0 + 1 TO r1 - 1
        parts = APPEND(parts, lines[rr])
    NEXT rr
    parts = APPEND(parts, Mid(lines[r1], 1, c1))
    RETURN strings.Join(parts, "\n")
END FUNCTION

' moveCursorTo — drive m.Editor.Line()/Column() to (row, col) using the
' coarse-grained motion the bubbles textarea exposes. CursorUp/Down for
' the row, SetCursorColumn for the col. Row is clamped to buffer length.
SUB moveCursorTo(m AS POINTER TO Model, row AS INTEGER, col AS INTEGER)
    IF row < 0 THEN row = 0
    DIM safety AS INTEGER = 0
    DO WHILE m.Editor.Line() > row AND safety < 10000
        m.Editor.CursorUp()
        safety = safety + 1
    LOOP
    safety = 0
    DO WHILE m.Editor.Line() < row AND safety < 10000
        DIM before AS INTEGER = m.Editor.Line()
        m.Editor.CursorDown()
        IF m.Editor.Line() = before THEN EXIT DO
        safety = safety + 1
    LOOP
    IF col < 0 THEN col = 0
    m.Editor.SetCursorColumn(col)
END SUB

' deleteSelection — remove selected text from the buffer and leave the
' cursor at the selection's start. Clears m.SelActive.
SUB deleteSelection(m AS POINTER TO Model)
    IF NOT m.SelActive THEN RETURN
    DIM r0 AS INTEGER
    DIM c0 AS INTEGER
    DIM r1 AS INTEGER
    DIM c1 AS INTEGER
    r0, c0, r1, c1 = selBounds(m)
    DIM lines AS []STRING = strings.Split(m.Editor.Value(), "\n")
    IF r0 < 0 OR r1 >= LEN(lines) THEN
        m.SelActive = FALSE
        RETURN
    END IF
    DIM beforeStr AS STRING = ""
    IF c0 > 0 THEN beforeStr = Mid(lines[r0], 1, c0)
    DIM afterStr AS STRING = ""
    IF c1 < LEN(lines[r1]) THEN afterStr = Mid(lines[r1], c1 + 1, LEN(lines[r1]) - c1)
    DIM newLine AS STRING = beforeStr + afterStr
    DIM newLines AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO r0 - 1
        newLines = APPEND(newLines, lines[i])
    NEXT i
    newLines = APPEND(newLines, newLine)
    FOR i = r1 + 1 TO LEN(lines) - 1
        newLines = APPEND(newLines, lines[i])
    NEXT i
    DIM newText AS STRING = strings.Join(newLines, "\n")
    m.Editor.SetValue(newText)
    moveCursorTo(m, r0, c0)
    m.SelActive = FALSE
END SUB

' beginOrExtendSelection — called before any cursor-moving keystroke
' with Shift held. Sets the anchor at the current cursor position if
' selection wasn't already active.
SUB beginOrExtendSelection(m AS POINTER TO Model)
    IF NOT m.SelActive THEN
        m.SelActive = TRUE
        m.SelAnchorRow = m.Editor.Line()
        m.SelAnchorCol = m.Editor.Column()
    END IF
END SUB

' clearSelection — drop the selection without modifying buffer state.
SUB clearSelection(m AS POINTER TO Model)
    m.SelActive = FALSE
END SUB

' copySelection — stash the selected text in m.CodeClip and (best-effort)
' push to the OS clipboard via OSC52. Caller decides whether to delete.
FUNCTION copySelection(m AS POINTER TO Model) AS tea.Cmd
    IF NOT m.SelActive THEN RETURN NIL
    DIM s AS STRING = selText(m)
    IF s = "" THEN RETURN NIL
    m.CodeClip = s
    RETURN tea.SetClipboard(s)
END FUNCTION

' pasteAtCursor — replace any active selection with the clipboard
' contents (m.CodeClip) and leave the cursor after the inserted text.
SUB pasteAtCursor(m AS POINTER TO Model)
    IF m.SelActive THEN deleteSelection(m)
    IF m.CodeClip = "" THEN RETURN
    m.Editor.InsertString(m.CodeClip)
END SUB

' isInSelection — TRUE when (row, col) falls inside the currently
' active selection. Inclusive at the start, exclusive at the end
' (matches how cursor/selection rendering treats the end-bound).
FUNCTION isInSelection(m AS POINTER TO Model, row AS INTEGER, col AS INTEGER) AS BOOLEAN
    IF NOT m.SelActive THEN RETURN FALSE
    DIM r0 AS INTEGER
    DIM c0 AS INTEGER
    DIM r1 AS INTEGER
    DIM c1 AS INTEGER
    r0, c0, r1, c1 = selBounds(m)
    IF row < r0 OR row > r1 THEN RETURN FALSE
    IF row = r0 AND col < c0 THEN RETURN FALSE
    IF row = r1 AND col >= c1 THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' moveSelectionTo — cut the currently selected text out and re-insert
' it at the supplied drop position. The drop coords are adjusted so
' they continue to point at the correct cell after the deletion shifts
' the buffer around. Caller must guarantee (dr, dc) is OUTSIDE the
' current selection.
SUB moveSelectionTo(m AS POINTER TO Model, dr AS INTEGER, dc AS INTEGER)
    IF NOT m.SelActive THEN RETURN
    DIM moved AS STRING = selText(m)
    IF moved = "" THEN RETURN
    DIM r0 AS INTEGER
    DIM c0 AS INTEGER
    DIM r1 AS INTEGER
    DIM c1 AS INTEGER
    r0, c0, r1, c1 = selBounds(m)
    DIM adjDR AS INTEGER = dr
    DIM adjDC AS INTEGER = dc
    IF dr > r1 THEN
        adjDR = dr - (r1 - r0)
    ELSEIF dr = r1 AND dc > c1 THEN
        adjDR = r0
        adjDC = c0 + (dc - c1)
    END IF
    deleteSelection(m)
    moveCursorTo(m, adjDR, adjDC)
    m.Editor.InsertString(moved)
END SUB

' ----------------------------------------------------------------------
' Widget event registry — what handlers each kind exposes. Drives the
' right-click context menu and the locate/insert flow when the user
' picks one. Names mirror the handler suffix in the generated code:
' for kind "Click" the handler is `<widId>_Click()`.
' ----------------------------------------------------------------------
FUNCTION widgetEventNames(kind AS STRING) AS []STRING
    DIM out AS []STRING
    IF kind = WidgetKindButton THEN
        out = APPEND(out, "Click")
    ELSEIF kind = WidgetKindCheckbox THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindRadioButton THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindComboBox THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindListBox THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindTextInput THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindScrollBar THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindTabStrip THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindScrollPane THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindTreeView THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindTextArea THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindPropertyGrid THEN
        out = APPEND(out, "Change")
    ELSEIF kind = WidgetKindMenuBar THEN
        out = APPEND(out, "Action")
    ELSEIF kind = WidgetKindToolbar THEN
        out = APPEND(out, "Action")
    END IF
    RETURN out
END FUNCTION

' handlerSignature — returns the SUB declaration line for a (widget, event)
' pair: e.g. "SUB btnOpen_Click()" or "SUB mbar_Action(action AS STRING)".
FUNCTION handlerSignature(widId AS STRING, ev AS STRING) AS STRING
    IF ev = "Action" THEN RETURN "SUB " + widId + "_Action(action AS STRING)"
    RETURN "SUB " + widId + "_" + ev + "()"
END FUNCTION

' findHandlerLine — returns the 0-indexed row of the SUB header for
' (widId, ev) if it exists in the supplied buffer, else -1. Case
' insensitive on the SUB keyword to match DBasic.
FUNCTION findHandlerLine(text AS STRING, widId AS STRING, ev AS STRING) AS INTEGER
    DIM lines AS []STRING = strings.Split(text, "\n")
    DIM needle AS STRING = widId + "_" + ev
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lines) - 1
        DIM trimmed AS STRING = strings.TrimSpace(lines[i])
        DIM upT AS STRING = strings.ToUpper(trimmed)
        IF strings.HasPrefix(upT, "SUB ") OR strings.HasPrefix(upT, "FUNCTION ") THEN
            ' Strip "SUB " / "FUNCTION " and look at the identifier.
            DIM rest AS STRING = ""
            IF strings.HasPrefix(upT, "SUB ") THEN rest = Mid(trimmed, 5, LEN(trimmed) - 4)
            IF strings.HasPrefix(upT, "FUNCTION ") THEN rest = Mid(trimmed, 10, LEN(trimmed) - 9)
            ' Identifier ends at first "(" or whitespace.
            DIM pi AS INTEGER = strings.Index(rest, "(")
            DIM ident AS STRING = rest
            IF pi >= 0 THEN ident = Mid(rest, 1, pi)
            ident = strings.TrimSpace(ident)
            IF ident = needle THEN RETURN i
        END IF
    NEXT i
    RETURN -1
END FUNCTION

' findInsertPointFor — picks the buffer row where a new handler for
' (widId, ev) should be inserted, so handlers stay grouped by widget.
' Strategy: walk all SUB/FUNCTION declarations, remember the END of
' the last block that starts with `widId_`. If none exist, return the
' line count (end of file). Returns a 0-indexed row meaning "insert
' BEFORE this row" (or == row count to append).
FUNCTION findInsertPointFor(text AS STRING, widId AS STRING) AS INTEGER
    DIM lines AS []STRING = strings.Split(text, "\n")
    DIM total AS INTEGER = LEN(lines)
    DIM prefix AS STRING = widId + "_"
    DIM upPrefix AS STRING = strings.ToUpper(prefix)
    DIM lastEnd AS INTEGER = -1
    DIM inBlock AS BOOLEAN = FALSE
    DIM matchedBlock AS BOOLEAN = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO total - 1
        DIM trimmed AS STRING = strings.TrimSpace(lines[i])
        DIM upT AS STRING = strings.ToUpper(trimmed)
        IF strings.HasPrefix(upT, "SUB ") OR strings.HasPrefix(upT, "FUNCTION ") THEN
            ' Identifier check.
            DIM rest AS STRING = ""
            IF strings.HasPrefix(upT, "SUB ") THEN rest = Mid(trimmed, 5, LEN(trimmed) - 4)
            IF strings.HasPrefix(upT, "FUNCTION ") THEN rest = Mid(trimmed, 10, LEN(trimmed) - 9)
            DIM pi AS INTEGER = strings.Index(rest, "(")
            DIM ident AS STRING = rest
            IF pi >= 0 THEN ident = Mid(rest, 1, pi)
            ident = strings.ToUpper(strings.TrimSpace(ident))
            inBlock = TRUE
            matchedBlock = strings.HasPrefix(ident, upPrefix)
        ELSEIF inBlock AND (upT = "END SUB" OR upT = "END FUNCTION") THEN
            IF matchedBlock THEN lastEnd = i
            inBlock = FALSE
            matchedBlock = FALSE
        END IF
    NEXT i
    IF lastEnd >= 0 THEN
        ' Insert just AFTER the last matching block — i.e., at the line
        ' immediately following its END (with a blank line gap).
        RETURN lastEnd + 1
    END IF
    RETURN total
END FUNCTION

' openWidgetContextMenu — populates m.CtxMenu* and switches the input
' mode. (x, y) is the screen position where the menu should appear
' (typically the click point).
SUB openWidgetContextMenu(m AS POINTER TO Model, widIdx AS INTEGER, x AS INTEGER, y AS INTEGER)
    IF widIdx < 0 OR widIdx >= LEN(m.Visual.Widgets) THEN RETURN
    DIM w AS Widget = m.Visual.Widgets[widIdx]
    DIM events AS []STRING = widgetEventNames(w.Kind)
    IF LEN(events) = 0 THEN RETURN
    m.CtxMenuActive  = TRUE
    m.CtxMenuX       = x
    m.CtxMenuY       = y
    m.CtxMenuWidId   = w.Id
    m.CtxMenuWidKind = w.Kind
    m.CtxMenuItems   = events
    m.CtxMenuIdx     = 0
    m.Mode           = ModeContextMenu
END SUB

' closeWidgetContextMenu — dismisses the popup and returns to Normal.
SUB closeWidgetContextMenu(m AS POINTER TO Model)
    m.CtxMenuActive = FALSE
    m.CtxMenuItems  = NIL
    m.CtxMenuIdx    = 0
    IF m.Mode = ModeContextMenu THEN m.Mode = ModeNormal
END SUB

' renderWidgetContextMenu — small framed list of events. Width auto-fits
' the longest entry. The selected item gets the accent highlight.
FUNCTION renderWidgetContextMenu(m AS Model) AS STRING
    IF NOT m.CtxMenuActive OR LEN(m.CtxMenuItems) = 0 THEN RETURN ""
    DIM title AS STRING = m.CtxMenuWidId + " events"
    DIM maxW AS INTEGER = LEN(title)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.CtxMenuItems) - 1
        IF LEN(m.CtxMenuItems[i]) > maxW THEN maxW = LEN(m.CtxMenuItems[i])
    NEXT i
    IF maxW < 10 THEN maxW = 10
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(ColorAccentHex)).Background(lipgloss.Color(ColorMenuBgHex)).Bold(TRUE).Italic(TRUE).Padding(0, 1)
    DIM rowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(ColorMenuFgHex)).Background(lipgloss.Color(ColorMenuBgHex)).Padding(0, 1)
    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(ColorBgHex)).Background(lipgloss.Color(ColorAccentHex)).Bold(TRUE).Padding(0, 1)
    DIM lines AS []STRING
    DIM titlePad AS STRING = title
    IF LEN(titlePad) < maxW THEN titlePad = titlePad + strings.Repeat(" ", maxW - LEN(titlePad))
    lines = APPEND(lines, titleStyle.Render(titlePad))
    FOR i = 0 TO LEN(m.CtxMenuItems) - 1
        DIM txt AS STRING = m.CtxMenuItems[i]
        IF LEN(txt) < maxW THEN txt = txt + strings.Repeat(" ", maxW - LEN(txt))
        IF i = m.CtxMenuIdx THEN
            lines = APPEND(lines, selStyle.Render(txt))
        ELSE
            lines = APPEND(lines, rowStyle.Render(txt))
        END IF
    NEXT i
    DIM body AS STRING = strings.Join(lines, "\n")
    DIM frame AS lipgloss.Style = lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color(ColorAccentHex)).Background(lipgloss.Color(ColorMenuBgHex))
    RETURN frame.Render(body)
END FUNCTION

' openHandlerInCode — switch to code mode for the active form, then
' either move the cursor to the existing `SUB <widId>_<ev>` block or
' insert a fresh stub at the appropriate grouping point. Idempotent:
' multiple clicks just keep the cursor on the same handler.
SUB openHandlerInCode(m AS POINTER TO Model, widId AS STRING, ev AS STRING)
    IF NOT m.CodeMode THEN enterCodeMode(m)
    DIM text AS STRING = m.Editor.Value()
    DIM row AS INTEGER = findHandlerLine(text, widId, ev)
    IF row >= 0 THEN
        ' Existing handler — drop the cursor just inside the body
        ' (one line after the SUB header) so the user can start typing.
        DIM target AS INTEGER = row + 1
        DIM lines AS []STRING = strings.Split(text, "\n")
        IF target >= LEN(lines) THEN target = LEN(lines) - 1
        DIM col AS INTEGER = 0
        IF target < LEN(lines) THEN
            ' Skip leading whitespace to land at first non-blank char.
            DIM ln AS STRING = lines[target]
            DO WHILE col < LEN(ln) AND Mid(ln, col + 1, 1) = " "
                col = col + 1
            LOOP
        END IF
        moveCursorTo(m, target, col)
        m.CodeScroll = computeScroll(target, m.CodeScroll, m.CodeViewH)
        m.StatusBar.Message = "opened " + widId + "_" + ev
        RETURN
    END IF
    ' Insert a fresh stub at the grouping point and put the cursor inside.
    DIM lines2 AS []STRING = strings.Split(text, "\n")
    DIM ip AS INTEGER = findInsertPointFor(text, widId)
    DIM stub AS []STRING
    stub = APPEND(stub, "")
    stub = APPEND(stub, handlerSignature(widId, ev))
    stub = APPEND(stub, "    ' " + ev + " handler for " + widId)
    stub = APPEND(stub, "END SUB")
    DIM newLines AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO ip - 1
        newLines = APPEND(newLines, lines2[i])
    NEXT i
    FOR i = 0 TO LEN(stub) - 1
        newLines = APPEND(newLines, stub[i])
    NEXT i
    FOR i = ip TO LEN(lines2) - 1
        newLines = APPEND(newLines, lines2[i])
    NEXT i
    m.Editor.SetValue(strings.Join(newLines, "\n"))
    ' Cursor at the body line (ip + 2 because of leading blank + SUB line).
    DIM cursorRow AS INTEGER = ip + 2
    moveCursorTo(m, cursorRow, 4)
    m.CodeScroll = computeScroll(cursorRow, m.CodeScroll, m.CodeViewH)
    m.StatusBar.Message = "added " + widId + "_" + ev
END SUB

' codeXYToRowCol — translate a screen (x, y) inside the canvas into a
' (row, col) position in the buffer. Mirrors RenderCode's gutter math:
' gutter width = digits(of total lines) + 2 cells, with one leading
' space. Clamps to valid positions for the buffer.
FUNCTION codeXYToRowCol(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER) AS (INTEGER, INTEGER)
    DIM lines AS []STRING = strings.Split(m.Editor.Value(), "\n")
    DIM total AS INTEGER = LEN(lines)
    DIM digits AS INTEGER = LEN(fmt.Sprintf("%d", total))
    IF digits < 2 THEN digits = 2
    DIM gutW AS INTEGER = digits + 2
    DIM row AS INTEGER = (y - m.VisualRect.Y) + m.CodeScroll
    DIM col AS INTEGER = x - m.VisualRect.X - gutW
    IF row < 0 THEN row = 0
    IF row >= total THEN row = total - 1
    IF row < 0 THEN row = 0
    DIM ln AS STRING = ""
    IF row < total THEN ln = lines[row]
    IF col < 0 THEN col = 0
    IF col > LEN(ln) THEN col = LEN(ln)
    RETURN row, col
END FUNCTION

' selectAllCode — anchor at (0,0), cursor at end of last line.
SUB selectAllCode(m AS POINTER TO Model)
    DIM lines AS []STRING = strings.Split(m.Editor.Value(), "\n")
    IF LEN(lines) = 0 THEN RETURN
    m.SelActive = TRUE
    m.SelAnchorRow = 0
    m.SelAnchorCol = 0
    moveCursorTo(m, LEN(lines) - 1, LEN(lines[LEN(lines) - 1]))
END SUB

' autoIndent — after Enter splits a line, copy the previous line's
' leading whitespace (spaces or tabs) onto the new line so the cursor
' lands aligned with the prior indent rather than at column 0.
SUB autoIndent(m AS POINTER TO Model)
    DIM curRow AS INTEGER = m.Editor.Line()
    IF curRow < 1 THEN RETURN
    DIM prev AS STRING = currentLine(m.Editor.Value(), curRow - 1)
    DIM indent AS STRING = ""
    DIM i AS INTEGER = 1
    DO WHILE i <= LEN(prev)
        DIM c AS STRING = Mid(prev, i, 1)
        IF c <> " " AND c <> Chr(9) THEN EXIT DO
        indent = indent + c
        i = i + 1
    LOOP
    IF indent <> "" THEN m.Editor.InsertString(indent)
END SUB

' refreshAutocomplete is called after every keystroke the textarea
' processes in code mode. It looks at the word preceding the cursor
' and (re)populates the suggestion list, or deactivates the popup if
' there's nothing useful to suggest.
SUB refreshAutocomplete(m AS POINTER TO Model)
    DIM line AS STRING = currentLine(m.Editor.Value(), m.Editor.Line())
    DIM prefix AS STRING = AutocompletePrefix(line, m.Editor.Column())
    IF LEN(prefix) < 1 THEN
        m.AutoActive = FALSE
        RETURN
    END IF
    DIM items AS []STRING = AutocompleteCandidates(prefix, m.Editor.Value())
    IF LEN(items) = 0 THEN
        m.AutoActive = FALSE
        RETURN
    END IF
    ' If the only suggestion exactly matches what's already typed there's
    ' nothing to complete to — hide the popup.
    IF LEN(items) = 1 AND strings.ToUpper(items[0]) = strings.ToUpper(prefix) THEN
        m.AutoActive = FALSE
        RETURN
    END IF
    m.AutoActive = TRUE
    m.AutoPrefix = prefix
    m.AutoItems = items
    IF m.AutoIdx < 0 OR m.AutoIdx >= LEN(items) THEN m.AutoIdx = 0
END SUB

' acceptCompletion inserts the suffix of the selected completion that
' isn't already typed and clears the popup. Keeps the textarea's own
' cursor position correct via InsertString.
SUB acceptCompletion(m AS POINTER TO Model)
    IF NOT m.AutoActive THEN RETURN
    IF m.AutoIdx < 0 OR m.AutoIdx >= LEN(m.AutoItems) THEN RETURN
    DIM full AS STRING = m.AutoItems[m.AutoIdx]
    DIM pl AS INTEGER = LEN(m.AutoPrefix)
    IF pl <= LEN(full) THEN
        DIM suffix AS STRING = Mid(full, pl + 1, LEN(full) - pl)
        IF suffix <> "" THEN m.Editor.InsertString(suffix)
    END IF
    m.AutoActive = FALSE
END SUB

' saveCodeBuffer flushes the editor buffer to disk without changing
' view mode. Used by Ctrl+S in code mode.
SUB saveCodeBuffer(m AS POINTER TO Model)
    IF m.CodePath = "" THEN RETURN
    WriteFile(m.CodePath, m.Editor.Value())
    m.StatusBar.Message = "saved: " + m.CodePath
END SUB

' dispatchFileAction — the chokepoint for File→… menu actions. Returns
' a tea.Cmd to chain (e.g., tea.Quit for File→Quit). The Cmd is NIL
' for actions that just mutate state.
FUNCTION dispatchFileAction(m AS POINTER TO Model, action AS STRING) AS tea.Cmd
    IF action = "file.quit" THEN RETURN tea.Quit
    IF action = "file.new" THEN
        m.Tree.Project = DefaultProject()
        m.Tree.buildFromProject()
        m.Tree.rebuildLines()
        loadStartForm(m)
        m.StatusBar.Message = "new project"
        RETURN NIL
    END IF
    IF action = "file.open" THEN
        openDialog(m, "Open Project", "open", "file.open", "*.dbproj", m.Tree.Project.Path)
        RETURN NIL
    END IF
    IF action = "file.save" THEN
        IF m.Tree.Project.Path = "" THEN
            openDialog(m, "Save Project As", "save", "file.saveas", "*.dbproj", m.Tree.Project.Name + ".dbproj")
            RETURN NIL
        END IF
        syncProjectFromVisual(m)
        DIM serr AS ERROR = SaveProject(m.Tree.Project, m.Tree.Project.Path)
        IF serr <> NIL THEN
            m.StatusBar.Message = "save: " + serr.Error()
        ELSE
            m.StatusBar.Message = "saved: " + m.Tree.Project.Path
        END IF
        RETURN NIL
    END IF
    IF action = "file.saveas" THEN
        DIM initial AS STRING = m.Tree.Project.Path
        IF initial = "" THEN initial = m.Tree.Project.Name + ".dbproj"
        openDialog(m, "Save Project As", "save", "file.saveas", "*.dbproj", initial)
        RETURN NIL
    END IF
    IF action = "run.build" THEN
        _ = runBuild(m)
        RETURN NIL
    END IF
    IF action = "run.run" THEN
        RETURN runRun(m)
    END IF
    IF action = "file.newform" THEN
        DIM nm AS STRING = fmt.Sprintf("frmNew%d", LEN(m.Tree.Project.Forms) + 1)
        DIM f AS Form = FormDefaults(nm)
        m.Tree.Project.Forms = APPEND(m.Tree.Project.Forms, f)
        m.Tree.buildFromProject()
        m.Tree.rebuildLines()
        m.StatusBar.Message = "new form: " + nm
        RETURN NIL
    END IF

    ' --- Edit menu --------------------------------------------------
    ' Code-mode dispatch comes first: when the code editor is open the
    ' Edit menu (and its Ctrl+ shortcuts) act on text, not widgets.
    IF m.CodeMode THEN
        IF action = "edit.selectall" THEN
            selectAllCode(m)
            m.StatusBar.Message = "selected all"
            RETURN NIL
        END IF
        IF action = "edit.copy" THEN
            DIM ccCmd AS tea.Cmd = copySelection(m)
            IF m.CodeClip = "" THEN
                m.StatusBar.Message = "nothing selected"
            ELSE
                m.StatusBar.Message = fmt.Sprintf("copied %d chars", LEN(m.CodeClip))
            END IF
            RETURN ccCmd
        END IF
        IF action = "edit.cut" THEN
            DIM cxCmd AS tea.Cmd = copySelection(m)
            DIM codeN AS INTEGER = LEN(m.CodeClip)
            deleteSelection(m)
            IF codeN = 0 THEN
                m.StatusBar.Message = "nothing selected"
            ELSE
                m.StatusBar.Message = fmt.Sprintf("cut %d chars", codeN)
            END IF
            RETURN cxCmd
        END IF
        IF action = "edit.paste" THEN
            IF m.CodeClip = "" THEN
                m.StatusBar.Message = "clipboard empty"
                RETURN NIL
            END IF
            pasteAtCursor(m)
            m.StatusBar.Message = fmt.Sprintf("pasted %d chars", LEN(m.CodeClip))
            RETURN NIL
        END IF
        ' Undo/redo in code mode fall through to bubbles' own buffer
        ' history via Update — handle in the key dispatch, not here.
    END IF
    IF action = "edit.undo" THEN
        applyUndo(m)
        RETURN NIL
    END IF
    IF action = "edit.redo" THEN
        applyRedo(m)
        RETURN NIL
    END IF
    IF action = "edit.selectall" THEN
        m.Visual.SelectAll()
        m.StatusBar.Message = fmt.Sprintf("%d widgets selected", m.Visual.SelectionCount())
        RETURN NIL
    END IF
    IF action = "edit.copy" THEN
        copySelectionToClipboard(m)
        m.StatusBar.Message = fmt.Sprintf("copied %d widgets", LEN(m.Clipboard))
        RETURN NIL
    END IF
    IF action = "edit.cut" THEN
        pushUndo(m)
        copySelectionToClipboard(m)
        DIM n AS INTEGER = LEN(m.Clipboard)
        removeSelection(m)
        m.StatusBar.Message = fmt.Sprintf("cut %d widgets", n)
        RETURN NIL
    END IF
    IF action = "edit.paste" THEN
        IF LEN(m.Clipboard) = 0 THEN
            m.StatusBar.Message = "clipboard empty"
            RETURN NIL
        END IF
        pushUndo(m)
        DIM placed AS INTEGER = pasteFromClipboard(m)
        m.StatusBar.Message = fmt.Sprintf("pasted %d widgets", placed)
        RETURN NIL
    END IF

    m.StatusBar.Message = "selected: " + action + "  (action dispatch — TBD)"
    RETURN NIL
END FUNCTION

' --- Undo / Redo ---------------------------------------------------

' snapshotVisual builds a deep-enough copy of the visual editor's
' state for undo restoration. Widget is a TYPE value, so APPENDing
' each element gives an independent copy; same for the INTEGER
' selection slice.
FUNCTION snapshotVisual(m AS POINTER TO Model) AS VisualSnapshot
    DIM s AS VisualSnapshot
    s.FormName = m.Visual.FormName
    s.Selected = m.Visual.Selected
    DIM ws AS []Widget
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Visual.Widgets) - 1
        ws = APPEND(ws, m.Visual.Widgets[i])
    NEXT i
    s.Widgets = ws
    DIM sel AS []INTEGER
    DIM j AS INTEGER
    FOR j = 0 TO LEN(m.Visual.Selections) - 1
        sel = APPEND(sel, m.Visual.Selections[j])
    NEXT j
    s.Selections = sel
    RETURN s
END FUNCTION

' restoreVisual swaps the visual editor's state to match the snapshot.
' Caller is responsible for refreshing dependent panels (Properties).
SUB restoreVisual(m AS POINTER TO Model, s AS VisualSnapshot)
    m.Visual.Widgets = s.Widgets
    m.Visual.Selections = s.Selections
    m.Visual.Selected = s.Selected
END SUB

' pushUndo records the current visual state so a follow-up Undo can
' restore it. Called at the start of every mutation. Clears RedoStack
' (the redo lineage diverges after a fresh edit). Caps UndoStack at
' undoStackCap by dropping the oldest entry.
SUB pushUndo(m AS POINTER TO Model)
    DIM snap AS VisualSnapshot = snapshotVisual(m)
    m.UndoStack = APPEND(m.UndoStack, snap)
    IF LEN(m.UndoStack) > undoStackCap THEN
        DIM trimmed AS []VisualSnapshot
        DIM k AS INTEGER
        FOR k = LEN(m.UndoStack) - undoStackCap TO LEN(m.UndoStack) - 1
            trimmed = APPEND(trimmed, m.UndoStack[k])
        NEXT k
        m.UndoStack = trimmed
    END IF
    DIM emptyRedo AS []VisualSnapshot
    m.RedoStack = emptyRedo
END SUB

' applyUndo pops the latest UndoStack entry, snapshots the current
' state onto RedoStack (so Redo can revert), and restores. No-op if
' the stack is empty or the snapshot belongs to a different form.
SUB applyUndo(m AS POINTER TO Model)
    IF LEN(m.UndoStack) = 0 THEN
        m.StatusBar.Message = "nothing to undo"
        RETURN
    END IF
    DIM top AS VisualSnapshot = m.UndoStack[LEN(m.UndoStack) - 1]
    IF top.FormName <> m.Visual.FormName THEN
        m.StatusBar.Message = "undo skipped — snapshot belongs to " + top.FormName
        RETURN
    END IF
    m.UndoStack = m.UndoStack[0:LEN(m.UndoStack) - 1]
    m.RedoStack = APPEND(m.RedoStack, snapshotVisual(m))
    restoreVisual(m, top)
    syncProjectFromVisual(m)
    refreshAfterSelectionChange(m)
    m.StatusBar.Message = fmt.Sprintf("undo — %d in history", LEN(m.UndoStack))
END SUB

' applyRedo mirrors applyUndo.
SUB applyRedo(m AS POINTER TO Model)
    IF LEN(m.RedoStack) = 0 THEN
        m.StatusBar.Message = "nothing to redo"
        RETURN
    END IF
    DIM top AS VisualSnapshot = m.RedoStack[LEN(m.RedoStack) - 1]
    IF top.FormName <> m.Visual.FormName THEN
        m.StatusBar.Message = "redo skipped — snapshot belongs to " + top.FormName
        RETURN
    END IF
    m.RedoStack = m.RedoStack[0:LEN(m.RedoStack) - 1]
    m.UndoStack = APPEND(m.UndoStack, snapshotVisual(m))
    restoreVisual(m, top)
    syncProjectFromVisual(m)
    refreshAfterSelectionChange(m)
    m.StatusBar.Message = fmt.Sprintf("redo — %d in history", LEN(m.RedoStack))
END SUB

' refreshAfterSelectionChange surfaces either the new primary widget
' or the form in Properties, depending on whether anything is
' selected after the state swap.
SUB refreshAfterSelectionChange(m AS POINTER TO Model)
    IF m.Visual.Selected >= 0 AND m.Visual.Selected < LEN(m.Visual.Widgets) THEN
        m.Properties.SetWidget(m.Visual.Widgets[m.Visual.Selected])
        RETURN
    END IF
    DIM k AS INTEGER
    FOR k = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[k].Name = m.Visual.FormName THEN
            m.Properties.SetForm(m.Tree.Project.Forms[k])
            RETURN
        END IF
    NEXT k
END SUB

' finishRectSelect commits the marquee at MouseReleaseMsg. Selects
' every widget whose bounding rect intersects the marquee. A 1x1
' marquee (no real drag) just clears selection — covers the
' "click empty area to deselect" case. Updates Properties.
SUB finishRectSelect(m AS POINTER TO Model)
    m.RectSelActive = FALSE
    DIM x0 AS INTEGER = m.RectSelX0
    DIM y0 AS INTEGER = m.RectSelY0
    DIM x1 AS INTEGER = m.RectSelX1
    DIM y1 AS INTEGER = m.RectSelY1
    IF x1 < x0 THEN
        DIM t1 AS INTEGER = x0
        x0 = x1
        x1 = t1
    END IF
    IF y1 < y0 THEN
        DIM t2 AS INTEGER = y0
        y0 = y1
        y1 = t2
    END IF
    DIM dragArea AS INTEGER = (x1 - x0) * (y1 - y0)
    IF dragArea = 0 THEN
        ' Pure click; selection already cleared at start.
        RETURN
    END IF
    DIM newSel AS []INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Visual.Widgets) - 1
        DIM w AS Widget = m.Visual.Widgets[i]
        DIM wx0 AS INTEGER = w.X
        DIM wy0 AS INTEGER = w.Y
        DIM wx1 AS INTEGER = w.X + w.W - 1
        DIM wy1 AS INTEGER = w.Y + w.H - 1
        IF wx1 >= x0 AND wx0 <= x1 AND wy1 >= y0 AND wy0 <= y1 THEN
            newSel = APPEND(newSel, i)
        END IF
    NEXT i
    m.Visual.Selections = newSel
    IF LEN(newSel) > 0 THEN
        m.Visual.Selected = newSel[LEN(newSel) - 1]
        m.Properties.SetWidget(m.Visual.Widgets[m.Visual.Selected])
        m.StatusBar.Message = fmt.Sprintf("%d widgets selected", LEN(newSel))
    END IF
END SUB

' --- Clipboard / selection helpers ---------------------------------

' copySelectionToClipboard snapshots every selected widget into the
' Model's Clipboard (by value, deep enough for the in-memory Widget
' TYPE — kind-specific fields are part of the same TYPE so they copy
' along).
SUB copySelectionToClipboard(m AS POINTER TO Model)
    DIM clip AS []Widget
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Visual.Selections) - 1
        DIM idx AS INTEGER = m.Visual.Selections[i]
        IF idx >= 0 AND idx < LEN(m.Visual.Widgets) THEN
            clip = APPEND(clip, m.Visual.Widgets[idx])
        END IF
    NEXT i
    m.Clipboard = clip
END SUB

' removeSelection removes every selected widget from Visual.Widgets
' and clears the selection. Surfaces the form in Properties after,
' since the previously-selected widgets are gone.
SUB removeSelection(m AS POINTER TO Model)
    IF LEN(m.Visual.Selections) = 0 THEN RETURN
    ' Build a "keep" set so a single linear scan does the filter.
    DIM kept AS []Widget
    DIM j AS INTEGER
    FOR j = 0 TO LEN(m.Visual.Widgets) - 1
        IF NOT m.Visual.IsSelected(j) THEN kept = APPEND(kept, m.Visual.Widgets[j])
    NEXT j
    m.Visual.Widgets = kept
    m.Visual.ClearSelections()
    syncProjectFromVisual(m)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(m.Tree.Project.Forms) - 1
        IF m.Tree.Project.Forms[k].Name = m.Visual.FormName THEN
            m.Properties.SetForm(m.Tree.Project.Forms[k])
        END IF
    NEXT k
END SUB

' uniqueWidgetId returns a copy of base with a numeric suffix bumped
' until no existing widget on the canvas owns the same Id. Lets Paste
' drop clones without collision.
FUNCTION uniqueWidgetId(m AS POINTER TO Model, baseId AS STRING) AS STRING
    DIM candidate AS STRING = baseId
    DIM n AS INTEGER = 1
    DO WHILE widgetIdExists(m, candidate)
        n = n + 1
        candidate = fmt.Sprintf("%s_%d", baseId, n)
    LOOP
    RETURN candidate
END FUNCTION

FUNCTION widgetIdExists(m AS POINTER TO Model, id AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Visual.Widgets) - 1
        IF m.Visual.Widgets[i].Id = id THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' pasteFromClipboard appends a copy of each clipboard widget to the
' canvas with a +2,+1 offset and a uniquified Id. Selects the newly
' pasted widgets so a follow-up Cut or drag operates on them.
FUNCTION pasteFromClipboard(m AS POINTER TO Model) AS INTEGER
    IF LEN(m.Clipboard) = 0 THEN RETURN 0
    DIM newIdxs AS []INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.Clipboard) - 1
        DIM clone AS Widget = m.Clipboard[i]
        clone.Id = uniqueWidgetId(m, clone.Id)
        clone.X = clone.X + 2
        clone.Y = clone.Y + 1
        m.Visual.Widgets = APPEND(m.Visual.Widgets, clone)
        newIdxs = APPEND(newIdxs, LEN(m.Visual.Widgets) - 1)
    NEXT i
    m.Visual.Selections = newIdxs
    IF LEN(newIdxs) > 0 THEN
        m.Visual.Selected = newIdxs[LEN(newIdxs) - 1]
        m.Properties.SetWidget(m.Visual.Widgets[m.Visual.Selected])
    END IF
    syncProjectFromVisual(m)
    RETURN LEN(newIdxs)
END FUNCTION

SUB refreshPropertiesFromSource(m AS POINTER TO Model)
    IF m.Properties.HasWidget THEN
        IF m.Visual.Selected >= 0 AND m.Visual.Selected < LEN(m.Visual.Widgets) THEN
            m.Properties.RefreshFromWidget(m.Visual.Widgets[m.Visual.Selected])
        END IF
        RETURN
    END IF
    IF m.Properties.ShowForm THEN
        DIM j AS INTEGER
        FOR j = 0 TO LEN(m.Tree.Project.Forms) - 1
            IF m.Tree.Project.Forms[j].Name = m.Visual.FormName THEN
                m.Properties.RefreshFromForm(m.Tree.Project.Forms[j])
                RETURN
            END IF
        NEXT j
    END IF
END SUB

' ----------------------------------------------------------------------
' Mouse dispatch
' ----------------------------------------------------------------------

' dialogRect returns the file-dialog's outer screen rectangle.
FUNCTION dialogRect(m AS POINTER TO Model) AS Rect
    DIM r AS Rect
    r.X = m.DialogX
    r.Y = m.DialogY
    r.W = m.DialogWidth
    r.H = m.DialogHeight
    RETURN r
END FUNCTION

' handleDialogClick dispatches a click that has been confirmed to land
' inside the dialog. Returns a tea.Cmd if the click resolves to a
' deferred bubbletea action (none today; reserved for future).
FUNCTION handleDialogClick(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER) AS tea.Cmd
    DIM lx AS INTEGER = x - m.DialogX
    DIM ly AS INTEGER = y - m.DialogY
    DIM innerW AS INTEGER = m.DialogWidth - 2
    DIM listH AS INTEGER = dialogListVisibleRows(m)

    ' Resize handle — the bottom-right corner cell.
    IF lx = m.DialogWidth - 1 AND ly = m.DialogHeight - 1 THEN
        m.DragMode = DragDialogResize
        m.DragOrigW = m.DialogWidth
        m.DragOrigH = m.DialogHeight
        m.DragStartMx = x
        m.DragStartMy = y
        RETURN NIL
    END IF

    ' Path field — row 2 (counting from 0 at the top border).
    IF ly = 2 THEN
        m.DialogFocus = DialogFocusPath
        DIM fieldStartX AS INTEGER = 1 + 7 + 1  ' border + " Path: " (7) + " " leading
        DIM caret AS INTEGER = lx - fieldStartX
        IF caret < 0 THEN caret = 0
        IF caret > LEN(m.DialogPathBuf) THEN caret = LEN(m.DialogPathBuf)
        m.DialogPathPos = caret
        m.DialogError = ""
        RETURN NIL
    END IF

    ' List header row (4) — give focus but no action.
    IF ly = 4 THEN
        DIM colW AS INTEGER = (innerW - 1) / 2
            IF colW > 25 THEN colW = 25
        IF lx >= 1 AND lx < 1 + colW THEN
            m.DialogFocus = DialogFocusFolders
        ELSEIF lx > 1 + colW AND lx <= innerW THEN
            m.DialogFocus = DialogFocusFiles
        END IF
        RETURN NIL
    END IF

    ' List rows — indices 5 to 4+listH, inclusive.
    IF ly >= 5 AND ly < 5 + listH THEN
        DIM rowIdx AS INTEGER = ly - 5
        DIM colW2 AS INTEGER = (innerW - 1) / 2
        IF colW2 > 25 THEN colW2 = 25
        IF lx >= 1 AND lx < 1 + colW2 THEN
            ' Folders column.
            m.DialogFocus = DialogFocusFolders
            DIM idx AS INTEGER = m.DialogFoldOff + rowIdx
            IF idx < 0 OR idx >= LEN(m.DialogFolders) THEN RETURN NIL
            DIM wasCur AS BOOLEAN = (idx = m.DialogFoldCur)
            m.DialogFoldCur = idx
            DIM dbl AS BOOLEAN = isDoubleClick(m, 1000, idx)
            IF dbl OR wasCur THEN
                cdInto(m, m.DialogFolders[idx])
            END IF
            RETURN NIL
        END IF
        IF lx > 1 + colW2 AND lx <= innerW THEN
            ' Files column.
            m.DialogFocus = DialogFocusFiles
            DIM fidx AS INTEGER = m.DialogFileOff + rowIdx
            IF fidx < 0 OR fidx >= LEN(m.DialogFiles) THEN RETURN NIL
            m.DialogFileCur = fidx
            m.DialogPathBuf = filepath.Join(m.DialogCurDir, m.DialogFiles[fidx])
            m.DialogPathPos = LEN(m.DialogPathBuf)
            DIM dbl2 AS BOOLEAN = isDoubleClick(m, 1001, fidx)
            IF dbl2 THEN
                IF dispatchDialogAction(m) THEN closeDialog(m)
            END IF
            RETURN NIL
        END IF
        RETURN NIL
    END IF

    ' Buttons row — listH + 6 (top:0, title:1, path:2, hr:3,
    ' header:4, list rows 5..4+listH, hr:5+listH, buttons:6+listH,
    ' bottom:7+listH).
    IF ly = 6 + listH THEN
        DIM pad AS INTEGER = innerW - 20
        IF pad < 0 THEN pad = 0
        DIM okStart AS INTEGER = 1 + pad
        DIM okEnd AS INTEGER = okStart + 6
        DIM cnStart AS INTEGER = okEnd + 3
        DIM cnEnd AS INTEGER = cnStart + 10
        IF lx >= okStart AND lx < okEnd THEN
            m.DialogFocus = DialogFocusOK
            IF dispatchDialogAction(m) THEN closeDialog(m)
            RETURN NIL
        END IF
        IF lx >= cnStart AND lx < cnEnd THEN
            closeDialog(m)
            RETURN NIL
        END IF
        RETURN NIL
    END IF

    RETURN NIL
END FUNCTION

' handleMouseClick routes a left-button click to the panel under (x, y)
' and triggers the appropriate selection / drag / placement. Returns a
' tea.Cmd if the click resolves to a deferred bubbletea action (today
' that's just File→Quit); NIL otherwise.
FUNCTION handleMouseClick(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER, shift AS BOOLEAN) AS tea.Cmd
    ' --- Modal file dialog (highest priority while active) -----------
    IF m.DialogActive THEN
        IF pointInRect(x, y, dialogRect(m)) THEN
            RETURN handleDialogClick(m, x, y)
        END IF
        ' Clicks outside the dialog are swallowed — the user must use
        ' Cancel/Esc to dismiss; we don't want stray clicks closing it.
        RETURN NIL
    END IF

    ' --- Pane split bars — drag handles between resizable regions ----
    DIM bodyTop AS INTEGER = m.TreeRect.Y
    DIM bodyBot AS INTEGER = bodyTop + m.TreeRect.H - 1
    ' Vertical split between tree and canvas — column at TreeRect's
    ' right border (x = LeftW - 1).
    IF y >= bodyTop AND y <= bodyBot AND x = m.TreeRect.X + m.TreeRect.W - 1 THEN
        m.DragMode = DragSplitLeft
        m.DragOrigW = m.LeftW
        m.DragStartMx = x
        m.DragStartMy = y
        m.StatusBar.Message = "Drag to resize left sidebar — release to commit"
        RETURN NIL
    END IF
    ' Vertical split between canvas and palette/properties — column at
    ' PaletteRect's left edge (x = LeftW + canvasW).
    IF y >= bodyTop AND y <= bodyBot AND x = m.PaletteRect.X THEN
        m.DragMode = DragSplitRight
        m.DragOrigW = m.RightW
        m.DragStartMx = x
        m.DragStartMy = y
        m.StatusBar.Message = "Drag to resize right sidebar — release to commit"
        RETURN NIL
    END IF
    ' Horizontal split between palette and properties — row at the
    ' bottom edge of the palette (y = 1 + PaletteH - 1).
    IF x >= m.PaletteRect.X AND x < m.PaletteRect.X + m.PaletteRect.W AND y = m.PaletteRect.Y + m.PaletteRect.H - 1 THEN
        m.DragMode = DragSplitPalette
        m.DragOrigH = m.PaletteH
        m.DragStartMx = x
        m.DragStartMy = y
        m.StatusBar.Message = "Drag to resize palette/properties split — release to commit"
        RETURN NIL
    END IF
    ' Horizontal split between body and bottom pane — only when bottom
    ' pane is visible. The tab row (BottomRect.Y) doubles as the split
    ' handle, but only past the tab labels — clicks on "[ Console ]"
    ' or "[ Shell ]" should switch tabs, not start a drag.
    IF m.BottomVisible AND y = m.BottomRect.Y THEN
        DIM tabsEdge AS INTEGER = lipgloss.Width("[ Console ] [ Shell ]")
        IF x > tabsEdge THEN
            m.DragMode = DragSplitBottom
            m.DragOrigH = m.BottomHeight
            m.DragStartMx = x
            m.DragStartMy = y
            m.StatusBar.Message = "Drag to resize bottom pane — release to commit"
            RETURN NIL
        END IF
    END IF

    ' --- Menu mode (a menu is open) ----------------------------------
    IF m.Mode = ModeMenuBar THEN
        ' Click on the menubar — switch to that menu (or close if same).
        IF y = 0 THEN
            DIM hitMenu AS INTEGER = m.MenuBar.MenuIndexAt(x)
            IF hitMenu < 0 THEN
                m.MenuBar.Close()
                m.MenuBar.ClearHover()
                m.Mode = ModeNormal
                m.StatusBar.Message = defaultStatus()
                RETURN NIL
            END IF
            IF hitMenu = m.MenuBar.Active THEN
                m.MenuBar.Close()
                m.MenuBar.ClearHover()
                m.Mode = ModeNormal
                m.StatusBar.Message = defaultStatus()
                RETURN NIL
            END IF
            m.MenuBar.OpenMenu(hitMenu)
            RETURN NIL
        END IF
        ' Click on the open dropdown — select the item if it's a row.
        DIM hitItem AS INTEGER = m.MenuBar.DropdownItemAt(x, y)
        IF hitItem >= 0 THEN
            m.MenuBar.DropCursor = hitItem
            DIM menuAction AS STRING = m.MenuBar.SelectedAction()
            m.MenuBar.Close()
            m.MenuBar.ClearHover()
            m.Mode = ModeNormal
            IF menuAction = "" THEN
                m.StatusBar.Message = defaultStatus()
                RETURN NIL
            END IF
            ' Most actions mutate state inline and return NIL; for
            ' file.quit dispatchFileAction returns tea.Quit which we
            ' bubble back to bubbletea via Update().
            RETURN dispatchFileAction(m, menuAction)
        END IF
        ' Click outside the menubar or any dropdown row — dismiss.
        m.MenuBar.Close()
        m.MenuBar.ClearHover()
        m.Mode = ModeNormal
        m.StatusBar.Message = defaultStatus()
        RETURN NIL
    END IF

    ' --- Bottom pane tabs (when visible) ----------------------------
    IF m.BottomVisible AND pointInRect(x, y, m.BottomRect) THEN
        ' Tab strip is the top row of the bottom pane. Tabs render as
        ' "[ Console ] [ Shell ]" (11 chars + 1 gap + 9 chars).
        IF y = m.BottomRect.Y THEN
            DIM consoleEnd AS INTEGER = lipgloss.Width("[ Console ]")
            DIM gapEnd AS INTEGER = consoleEnd + 1
            DIM shellEnd AS INTEGER = gapEnd + lipgloss.Width("[ Shell ]")
            IF x < consoleEnd THEN
                m.BottomTab = BottomTabConsole
            ELSEIF x >= gapEnd AND x < shellEnd THEN
                m.BottomTab = BottomTabShell
            END IF
            RETURN NIL
        END IF
        RETURN NIL
    END IF

    ' --- Menubar (closed) — open the menu under the cursor -----------
    IF pointInRect(x, y, m.MenuRect) THEN
        DIM hitMenu2 AS INTEGER = m.MenuBar.MenuIndexAt(x)
        IF hitMenu2 < 0 THEN RETURN NIL
        m.MenuBar.OpenMenu(hitMenu2)
        m.Mode = ModeMenuBar
        m.StatusBar.Message = "Menu — Esc: Close  ←/→: Menu  ↑/↓: Item  Enter: Select"
        RETURN NIL
    END IF

    ' --- Project tree ------------------------------------------------
    IF pointInRect(x, y, m.TreeRect) THEN
        focusPanel(m, FocusProjectTree)
        DIM lx AS INTEGER = x - m.TreeRect.X
        DIM ly AS INTEGER = y - m.TreeRect.Y
        DIM node AS POINTER TO TreeNode = m.Tree.ClickAt(lx, ly)
        IF node = NIL THEN RETURN NIL
        ' Double-click on a folder/expandable form node toggles expand;
        ' double-click on a code node / form leaf opens it (future).
        DIM isDouble AS BOOLEAN = isDoubleClick(m, FocusProjectTree, m.Tree.Panel.Cursor)
        IF isDouble THEN
            IF node.Kind = NodeFolder OR (node.Kind = NodeForm AND LEN(node.Children) > 0) THEN
                m.Tree.ToggleExpand()
            ELSE
                dispatchTreeOpen(m, node)
            END IF
        END IF
        RETURN NIL
    END IF

    ' --- Visual canvas -----------------------------------------------
    IF pointInRect(x, y, m.VisualRect) THEN
        focusPanel(m, FocusVisual)
        DIM lx2 AS INTEGER = x - m.VisualRect.X
        DIM ly2 AS INTEGER = y - m.VisualRect.Y
        ' Shift+click: toggle the hit widget in/out of the selection
        ' instead of starting a drag. Skips drag-mode entirely so the
        ' user can build up a multi-selection without dragging things.
        IF shift THEN
            DIM hitIdx2 AS INTEGER
            DIM hitOk AS BOOLEAN
            hitIdx2, hitOk = m.Visual.ClickAtMod(lx2, ly2, TRUE)
            _ = hitIdx2
            IF hitOk THEN
                IF m.Visual.Selected >= 0 AND m.Visual.Selected < LEN(m.Visual.Widgets) THEN
                    m.Properties.SetWidget(m.Visual.Widgets[m.Visual.Selected])
                END IF
                m.StatusBar.Message = fmt.Sprintf("%d widgets selected", m.Visual.SelectionCount())
            END IF
            RETURN NIL
        END IF
        DIM wIdx AS INTEGER
        DIM eT AS BOOLEAN
        DIM eR AS BOOLEAN
        DIM eB AS BOOLEAN
        DIM eL AS BOOLEAN
        DIM dragOk AS BOOLEAN
        wIdx, eT, eR, eB, eL, dragOk = m.Visual.BeginDragAt(lx2, ly2)
        IF dragOk THEN
            ' Start a drag — Move by default, Resize on edge/corner.
            ' Defer the undo snapshot to first motion: pure clicks
            ' (no drag) shouldn't pollute the undo history.
            m.DragUndoPushed = FALSE
            DIM w AS Widget = m.Visual.Widgets[wIdx]
            m.DragWidgetIdx = wIdx
            m.DragOrigX = w.X
            m.DragOrigY = w.Y
            m.DragOrigW = w.W
            m.DragOrigH = w.H
            m.DragStartMx = x
            m.DragStartMy = y
            m.DragEdgeT = eT
            m.DragEdgeR = eR
            m.DragEdgeB = eB
            m.DragEdgeL = eL
            IF eT OR eR OR eB OR eL THEN
                m.DragMode = DragResize
                m.DragResizeX = eR
                m.DragResizeY = eB
                m.StatusBar.Message = fmt.Sprintf("resizing %s — drag, release to drop", w.Id)
            ELSE
                m.DragMode = DragMove
                m.DragResizeX = FALSE
                m.DragResizeY = FALSE
                ' Snapshot every selected widget's starting position so
                ' the motion handler can move them all in lockstep.
                DIM emptyI AS []INTEGER
                DIM emptyX AS []INTEGER
                DIM emptyY AS []INTEGER
                m.DragMultiIdxs = emptyI
                m.DragMultiXs = emptyX
                m.DragMultiYs = emptyY
                DIM si AS INTEGER
                FOR si = 0 TO LEN(m.Visual.Selections) - 1
                    DIM sidx AS INTEGER = m.Visual.Selections[si]
                    IF sidx >= 0 AND sidx < LEN(m.Visual.Widgets) THEN
                        m.DragMultiIdxs = APPEND(m.DragMultiIdxs, sidx)
                        m.DragMultiXs = APPEND(m.DragMultiXs, m.Visual.Widgets[sidx].X)
                        m.DragMultiYs = APPEND(m.DragMultiYs, m.Visual.Widgets[sidx].Y)
                    END IF
                NEXT si
                DIM moveCount AS INTEGER = m.Visual.SelectionCount()
                IF moveCount > 1 THEN
                    m.StatusBar.Message = fmt.Sprintf("moving %d widgets — drag, release to drop", moveCount)
                ELSE
                    m.StatusBar.Message = fmt.Sprintf("moving %s — drag, release to drop", w.Id)
                END IF
            END IF
            ' Switch the Properties panel to the newly-selected widget
            ' (not refresh — selection may have changed since last paint).
            m.Properties.SetWidget(w)
        ELSE
            ' Click on form interior outside any widget — start a
            ' rectangle-marquee drag. Selection is cleared up front;
            ' on release we'll add every intersecting widget. If the
            ' user just clicks (no drag), the release-handler treats
            ' it as a "click empty area to clear" and the form
            ' surfaces in Properties.
            m.Visual.ClearSelections()
            m.DragMode = DragRectSelect
            m.RectSelActive = TRUE
            m.RectSelX0 = lx2 - 1   ' convert canvas→form-local
            m.RectSelY0 = ly2 - 1
            m.RectSelX1 = m.RectSelX0
            m.RectSelY1 = m.RectSelY0
            m.DragStartMx = x
            m.DragStartMy = y
            m.Visual.SetMarquee(m.RectSelX0, m.RectSelY0, m.RectSelX1, m.RectSelY1)
            DIM kk AS INTEGER
            FOR kk = 0 TO LEN(m.Tree.Project.Forms) - 1
                IF m.Tree.Project.Forms[kk].Name = m.Visual.FormName THEN
                    m.Properties.SetForm(m.Tree.Project.Forms[kk])
                END IF
            NEXT kk
        END IF
        RETURN NIL
    END IF

    ' --- Widget palette ----------------------------------------------
    IF pointInRect(x, y, m.PaletteRect) THEN
        focusPanel(m, FocusWidgets)
        DIM lx3 AS INTEGER = x - m.PaletteRect.X
        DIM ly3 AS INTEGER = y - m.PaletteRect.Y
        ' Top row (ly3=0) is the tab strip — click switches tab.
        IF ly3 = 0 THEN
            DIM widEnd AS INTEGER = lipgloss.Width("[ Widgets ]")
            DIM gapEndW AS INTEGER = widEnd + 1
            DIM tlEnd AS INTEGER = gapEndW + lipgloss.Width("[ Tools ]")
            IF lx3 < widEnd THEN
                setPaletteTab(m, 0)
            ELSEIF lx3 >= gapEndW AND lx3 < tlEnd THEN
                setPaletteTab(m, 1)
            END IF
            RETURN NIL
        END IF
        ' Below the tab strip — route to the ScrollPanel.
        DIM idx AS INTEGER
        DIM pok AS BOOLEAN
        idx, pok = m.Palette.ClickAt(lx3, ly3 - 1)
        IF NOT pok THEN RETURN NIL
        IF isDoubleClick(m, FocusWidgets, idx) THEN
            ' Placement is a mutation — snapshot before so Undo can
            ' remove it. Skip the snapshot for tool placement since
            ' tools aren't part of Visual.Widgets.
            DIM perr AS ERROR
            IF m.PaletteTab = 1 THEN
                perr = placePaletteTool(m)
            ELSE
                pushUndo(m)
                perr = placePaletteWidget(m)
            END IF
            IF perr <> NIL THEN
                m.StatusBar.Message = "place: " + perr.Error()
            ELSE
                IF m.PaletteTab = 0 THEN refreshPropertiesFromSource(m)
                m.StatusBar.Message = fmt.Sprintf("placed: %s", m.Palette.Lines[idx])
            END IF
        END IF
        RETURN NIL
    END IF

    ' --- Properties panel --------------------------------------------
    IF pointInRect(x, y, m.PropsRect) THEN
        focusPanel(m, FocusProperties)
        DIM lx4 AS INTEGER = x - m.PropsRect.X
        DIM ly4 AS INTEGER = y - m.PropsRect.Y
        DIM action AS INTEGER = m.Properties.ClickAt(lx4, ly4)
        applyPropClickAction(m, action)
        RETURN NIL
    END IF
    RETURN NIL
END FUNCTION

' applyPropClickAction performs the cross-panel effects of a property
' click (bool toggle, enum cycle, begin-edit). Cursor positioning was
' already applied by PropertiesPanel.ClickAt.
SUB applyPropClickAction(m AS POINTER TO Model, action AS INTEGER)
    IF action = PropClickToggle THEN
        DIM tname AS STRING
        DIM tnewVal AS BOOLEAN
        DIM tok AS BOOLEAN
        tname, tnewVal, tok = m.Properties.ToggleBool()
        IF tok THEN
            IF m.Properties.HasWidget THEN pushUndo(m)
            DIM terr AS ERROR
            IF m.Properties.HasWidget THEN
                terr = applyWidgetEdit(m, tname, tnewVal)
            ELSE
                terr = applyFormEdit(m, tname, tnewVal)
            END IF
            IF terr <> NIL THEN
                m.StatusBar.Message = tname + ": " + terr.Error()
            ELSE
                refreshPropertiesFromSource(m)
                IF tnewVal THEN
                    m.StatusBar.Message = "set " + tname + " = true"
                ELSE
                    m.StatusBar.Message = "set " + tname + " = false"
                END IF
            END IF
        END IF
        RETURN
    END IF
    IF action = PropClickEnumPrev OR action = PropClickEnumNext THEN
        DIM cdir AS INTEGER = 1
        IF action = PropClickEnumPrev THEN cdir = -1
        DIM cname AS STRING
        DIM cnew AS STRING
        DIM cok AS BOOLEAN
        cname, cnew, cok = m.Properties.CycleEnum(cdir)
        IF cok THEN
            IF m.Properties.HasWidget THEN pushUndo(m)
            DIM cerr AS ERROR
            IF m.Properties.HasWidget THEN
                cerr = applyWidgetEdit(m, cname, cnew)
            ELSE
                cerr = applyFormEdit(m, cname, cnew)
            END IF
            IF cerr <> NIL THEN
                m.StatusBar.Message = cname + ": " + cerr.Error()
            ELSE
                refreshPropertiesFromSource(m)
                m.StatusBar.Message = "set " + cname + " = " + cnew
            END IF
        END IF
        RETURN
    END IF
    IF action = PropClickBeginEdit THEN
        IF m.Properties.BeginEdit() THEN
            DIM crow AS PropRow
            DIM crowOk AS BOOLEAN
            crow, crowOk = m.Properties.CurrentRow()
            IF crowOk THEN
                m.Mode = ModePropEdit
                m.StatusBar.Message = "Editing " + crow.Name + " — Enter: commit  Esc: cancel"
            END IF
        END IF
        RETURN
    END IF
    IF action = PropClickReadOnly THEN
        DIM crow2 AS PropRow
        DIM crowOk2 AS BOOLEAN
        crow2, crowOk2 = m.Properties.CurrentRow()
        IF crowOk2 THEN m.StatusBar.Message = crow2.Name + ": read-only"
        RETURN
    END IF
END SUB

' handleMouseDrag applies a mouse-motion event to the in-progress
' canvas drag. Recomputes the dragged widget's position or size from
' the original snapshot plus the (current − start) delta.
SUB handleMouseDrag(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER)
    DIM dx AS INTEGER = x - m.DragStartMx
    DIM dy AS INTEGER = y - m.DragStartMy
    ' Rectangle marquee — translate global → canvas-local → form-local
    ' and update the live X1/Y1 corner. Visual.SetMarquee keeps the
    ' overlay in sync so the user sees the marquee grow.
    IF m.DragMode = DragRectSelect THEN
        DIM rlx AS INTEGER = x - m.VisualRect.X
        DIM rly AS INTEGER = y - m.VisualRect.Y
        m.RectSelX1 = rlx - 1
        m.RectSelY1 = rly - 1
        m.Visual.SetMarquee(m.RectSelX0, m.RectSelY0, m.RectSelX1, m.RectSelY1)
        RETURN
    END IF
    ' Code-mode text selection — drag the cursor end while the anchor
    ' stays where the click first landed.
    IF m.DragMode = DragCodeSelect THEN
        DIM csRow AS INTEGER
        DIM csCol AS INTEGER
        csRow, csCol = codeXYToRowCol(m, x, y)
        moveCursorTo(m, csRow, csCol)
        IF csRow <> m.SelAnchorRow OR csCol <> m.SelAnchorCol THEN m.SelActive = TRUE
        m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
        RETURN
    END IF
    ' On the first real motion of a Move/Resize drag, snapshot for
    ' undo. Pure clicks (no motion) skip this and don't pollute the
    ' undo history.
    IF NOT m.DragUndoPushed AND (m.DragMode = DragMove OR m.DragMode = DragResize) THEN
        IF dx <> 0 OR dy <> 0 THEN
            pushUndo(m)
            m.DragUndoPushed = TRUE
        END IF
    END IF
    IF m.DragMode = DragMove THEN
        ' If a multi-select drag is active, apply the delta to every
        ' snapshotted widget. The fallback (no snapshot) just moves
        ' the primary — covers any path that armed a Move without
        ' populating DragMultiIdxs.
        IF LEN(m.DragMultiIdxs) > 0 THEN
            DIM mi AS INTEGER
            FOR mi = 0 TO LEN(m.DragMultiIdxs) - 1
                m.Visual.MoveWidget(m.DragMultiIdxs[mi], m.DragMultiXs[mi] + dx, m.DragMultiYs[mi] + dy)
            NEXT mi
        ELSE
            m.Visual.MoveWidget(m.DragWidgetIdx, m.DragOrigX + dx, m.DragOrigY + dy)
        END IF
        refreshPropertiesFromSource(m)
        RETURN
    END IF
    IF m.DragMode = DragResize THEN
        ' 8-handle resize: right/bottom edges extend, left/top edges
        ' move the origin and shrink. Combinations cover corners.
        DIM newX AS INTEGER = m.DragOrigX
        DIM newY AS INTEGER = m.DragOrigY
        DIM newW AS INTEGER = m.DragOrigW
        DIM newH AS INTEGER = m.DragOrigH
        IF m.DragEdgeR THEN newW = m.DragOrigW + dx
        IF m.DragEdgeB THEN newH = m.DragOrigH + dy
        IF m.DragEdgeL THEN
            newX = m.DragOrigX + dx
            newW = m.DragOrigW - dx
        END IF
        IF m.DragEdgeT THEN
            newY = m.DragOrigY + dy
            newH = m.DragOrigH - dy
        END IF
        IF newW < 1 THEN newW = 1
        IF newH < 1 THEN newH = 1
        m.Visual.MoveWidget(m.DragWidgetIdx, newX, newY)
        m.Visual.ResizeWidget(m.DragWidgetIdx, newW, newH)
        refreshPropertiesFromSource(m)
        RETURN
    END IF
    IF m.DragMode = DragDialogResize THEN
        DIM dw AS INTEGER = m.DragOrigW + dx
        DIM dh AS INTEGER = m.DragOrigH + dy
        IF dw < 40 THEN dw = 40
        IF dh < 12 THEN dh = 12
        IF dw > m.Width - m.DialogX THEN dw = m.Width - m.DialogX
        IF dh > m.Height - m.DialogY THEN dh = m.Height - m.DialogY
        m.DialogWidth = dw
        m.DialogHeight = dh
        RETURN
    END IF
    IF m.DragMode = DragSplitLeft THEN
        DIM newL AS INTEGER = m.DragOrigW + dx
        IF newL < 12 THEN newL = 12
        IF newL > m.Width - m.RightW - 10 THEN newL = m.Width - m.RightW - 10
        m.LeftW = newL
        applyLayout(m)
        RETURN
    END IF
    IF m.DragMode = DragSplitRight THEN
        ' Right boundary X grew by dx → RightW shrank by dx.
        DIM newR AS INTEGER = m.DragOrigW - dx
        IF newR < 16 THEN newR = 16
        IF newR > m.Width - m.LeftW - 10 THEN newR = m.Width - m.LeftW - 10
        m.RightW = newR
        applyLayout(m)
        RETURN
    END IF
    IF m.DragMode = DragSplitPalette THEN
        DIM newPH AS INTEGER = m.DragOrigH + dy
        DIM bodyH AS INTEGER = m.Height - 2
        DIM topH AS INTEGER = bodyH
        IF m.BottomVisible THEN topH = bodyH - m.BottomHeight
        IF newPH < 4 THEN newPH = 4
        IF newPH > topH - 5 THEN newPH = topH - 5
        m.PaletteH = newPH
        applyLayout(m)
        RETURN
    END IF
    IF m.DragMode = DragSplitBottom THEN
        ' Bottom-pane top edge moved by dy → BottomHeight shrank by dy.
        DIM newBH AS INTEGER = m.DragOrigH - dy
        DIM bodyH2 AS INTEGER = m.Height - 2
        IF newBH < 4 THEN newBH = 4
        IF newBH > bodyH2 - 5 THEN newBH = bodyH2 - 5
        m.BottomHeight = newBH
        applyLayout(m)
        RETURN
    END IF
END SUB

' handleMouseMotion drives mouseover/hover state when no drag is in
' progress. Currently feeds the menubar (which uses HoverIdx + HoverItem
' for label/row highlight, and auto-switches the active menu when the
' mouse moves across menubar labels while a menu is open).
SUB handleMouseMotion(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER)
    ' Menubar / dropdown hover.
    IF y = 0 THEN
        m.MenuBar.SetHover(x, y)
        RETURN
    END IF
    IF m.MenuBar.Open THEN
        ' Inside dropdown? — let the menubar decide.
        DIM hitItem AS INTEGER = m.MenuBar.DropdownItemAt(x, y)
        IF hitItem >= 0 THEN
            m.MenuBar.SetHover(x, y)
            RETURN
        END IF
    END IF
    ' Mouse is somewhere else — clear any stale menubar hover.
    m.MenuBar.ClearHover()
END SUB

' handleMouseWheel scrolls the panel under (x, y).
SUB handleMouseWheel(m AS POINTER TO Model, x AS INTEGER, y AS INTEGER, up AS BOOLEAN)
    ' Dialog wheel routing — when the file dialog is open and the
    ' cursor is over one of its lists, scroll the list.
    IF m.DialogActive AND pointInRect(x, y, dialogRect(m)) THEN
        DIM ly AS INTEGER = y - m.DialogY
        DIM listH AS INTEGER = dialogListVisibleRows(m)
        IF ly >= 5 AND ly < 5 + listH THEN
            DIM innerW AS INTEGER = m.DialogWidth - 2
            DIM colW AS INTEGER = (innerW - 1) / 2
            IF colW > 25 THEN colW = 25
            DIM lx AS INTEGER = x - m.DialogX
            DIM whichList AS INTEGER = 0
            IF lx > 1 + colW THEN whichList = 1
            DIM delta AS INTEGER = 1
            IF up THEN delta = -1
            dialogListMove(m, whichList, delta)
        END IF
        RETURN
    END IF
    IF pointInRect(x, y, m.TreeRect) THEN
        IF up THEN
            m.Tree.WheelUp()
        ELSE
            m.Tree.WheelDown()
        END IF
        RETURN
    END IF
    IF pointInRect(x, y, m.PaletteRect) THEN
        IF up THEN
            m.Palette.WheelUp()
        ELSE
            m.Palette.WheelDown()
        END IF
        RETURN
    END IF
    IF pointInRect(x, y, m.PropsRect) THEN
        IF up THEN
            m.Properties.WheelUp()
        ELSE
            m.Properties.WheelDown()
        END IF
        RETURN
    END IF
    ' Visual canvas wheel is reserved for future pan/zoom — no-op for
    ' now so it doesn't interfere with widget selection.
END SUB

' ----------------------------------------------------------------------
' Modal text-input dialog
'
' Used by File→Open / File→SaveAs to pick a path. The dialog is a
' full file picker: editable path field on top, two scrollable lists
' (folders left, mask-filtered files right), OK + Cancel buttons.
'
' Tab cycles focus: Path → Folders → Files → OK → Cancel → Path.
' Inside the Path field, the existing readline-style keys work
' (Left/Right/Home/End/Ctrl+A/Ctrl+E/Ctrl+K/Ctrl+U/Backspace/Delete).
' In the lists, ↑/↓ moves, Enter on a folder cd's in, Enter on a file
' commits the dialog.
' ----------------------------------------------------------------------

' dirOf splits a path into its directory component. Empty string for a
' bare filename returns ".".
FUNCTION dirOf(p AS STRING) AS STRING
    DIM d AS STRING = filepath.Dir(p)
    IF d = "" THEN RETURN "."
    RETURN d
END FUNCTION

' readDialogDir scans m.DialogCurDir, sorts folders + files (files
' filtered by m.DialogMask), and writes them into m.DialogFolders /
' m.DialogFiles. A ".." folder is always prepended unless we're at /.
SUB readDialogDir(m AS POINTER TO Model)
    DIM folders AS []STRING
    DIM files   AS []STRING

    ' "../" is always available (except at the filesystem root).
    IF m.DialogCurDir <> "/" THEN folders = APPEND(folders, "..")

    DIM entries AS []os.DirEntry
    DIM err AS ERROR
    entries, err = os.ReadDir(m.DialogCurDir)
    IF err <> NIL THEN
        m.DialogError = err.Error()
        m.DialogFolders = folders
        m.DialogFiles = files
        RETURN
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(entries) - 1
        DIM e AS os.DirEntry = entries[i]
        DIM nm AS STRING = e.Name()
        IF strings.HasPrefix(nm, ".") THEN
            ' skip dotfiles for now — too noisy at $HOME
        ELSEIF e.IsDir() THEN
            folders = APPEND(folders, nm)
        ELSE
            DIM matched AS BOOLEAN = TRUE
            IF m.DialogMask <> "" AND m.DialogMask <> "*" THEN
                DIM matchErr AS ERROR
                matched, matchErr = filepath.Match(m.DialogMask, nm)
                _ = matchErr
            END IF
            IF matched THEN files = APPEND(files, nm)
        END IF
    NEXT i
    sort.Strings(folders)
    sort.Strings(files)
    m.DialogFolders = folders
    m.DialogFiles = files
    IF m.DialogFoldCur >= LEN(folders) THEN m.DialogFoldCur = LEN(folders) - 1
    IF m.DialogFoldCur < 0 THEN m.DialogFoldCur = 0
    IF m.DialogFileCur >= LEN(files) THEN m.DialogFileCur = LEN(files) - 1
    IF m.DialogFileCur < 0 THEN m.DialogFileCur = 0
    m.DialogFoldOff = 0
    m.DialogFileOff = 0
    m.DialogError = ""
END SUB

' openDialog opens the file picker. mode is "open" or "save". For save
' the initial filename seeds the path buffer; for open the user usually
' clicks a file to populate it.
SUB openDialog(m AS POINTER TO Model, title AS STRING, mode AS STRING, action AS STRING, mask AS STRING, initialPath AS STRING)
    m.DialogActive = TRUE
    m.DialogTitle = title
    m.DialogMode = mode
    m.DialogAction = action
    m.DialogMask = mask
    m.DialogError = ""
    m.DialogFocus = DialogFocusPath
    m.DialogFoldCur = 0
    m.DialogFoldOff = 0
    m.DialogFileCur = 0
    m.DialogFileOff = 0

    ' Default size: 72 cols × 20 rows (or smaller if the screen is). The
    ' user can drag the bottom-right corner ⤡ to resize.
    DIM dw AS INTEGER = 72
    DIM dh AS INTEGER = 20
    IF dw > m.Width - 2 THEN dw = m.Width - 2
    IF dh > m.Height - 2 THEN dh = m.Height - 2
    IF dw < 40 THEN dw = 40
    IF dh < 12 THEN dh = 12
    m.DialogWidth = dw
    m.DialogHeight = dh
    m.DialogX = (m.Width - dw) / 2
    m.DialogY = (m.Height - dh) / 2
    IF m.DialogX < 0 THEN m.DialogX = 0
    IF m.DialogY < 0 THEN m.DialogY = 0

    ' Seed CurDir + PathBuf from initialPath. If it's a relative path or
    ' bare name, anchor to the current working directory.
    DIM startPath AS STRING = initialPath
    IF startPath = "" THEN
        DIM wd AS STRING
        DIM wdErr AS ERROR
        wd, wdErr = os.Getwd()
        IF wdErr = NIL THEN startPath = wd + "/"
    END IF
    DIM startDir AS STRING = dirOf(startPath)
    IF NOT filepath.IsAbs(startDir) THEN
        DIM wd2 AS STRING
        DIM wdErr2 AS ERROR
        wd2, wdErr2 = os.Getwd()
        IF wdErr2 = NIL THEN
            startDir = filepath.Join(wd2, startDir)
        END IF
    END IF
    m.DialogCurDir = startDir
    m.DialogPathBuf = startPath
    m.DialogPathPos = LEN(startPath)
    readDialogDir(m)

    m.Mode = ModeFileDialog
END SUB

SUB closeDialog(m AS POINTER TO Model)
    m.DialogActive = FALSE
    m.DialogTitle = ""
    m.DialogMode = ""
    m.DialogAction = ""
    m.DialogCurDir = ""
    m.DialogMask = ""
    DIM emptyF AS []STRING
    m.DialogFolders = emptyF
    DIM emptyFi AS []STRING
    m.DialogFiles = emptyFi
    m.DialogPathBuf = ""
    m.DialogPathPos = 0
    m.DialogFocus = DialogFocusPath
    m.DialogFoldCur = 0
    m.DialogFoldOff = 0
    m.DialogFileCur = 0
    m.DialogFileOff = 0
    m.DialogError = ""
    m.Mode = ModeNormal
END SUB

' cdInto changes the dialog's currently-shown directory and refreshes
' the lists. Used by Enter on a folder row and by ".." navigation.
SUB cdInto(m AS POINTER TO Model, folderName AS STRING)
    DIM newDir AS STRING
    IF folderName = ".." THEN
        newDir = filepath.Dir(m.DialogCurDir)
    ELSE
        newDir = filepath.Join(m.DialogCurDir, folderName)
    END IF
    m.DialogCurDir = newDir
    m.DialogPathBuf = newDir + "/"
    m.DialogPathPos = LEN(m.DialogPathBuf)
    readDialogDir(m)
END SUB

' dispatchDialogAction commits the dialog's current PathBuf. Returns
' TRUE if the action succeeded (dialog closes); FALSE leaves the dialog
' open with DialogError set.
FUNCTION dispatchDialogAction(m AS POINTER TO Model) AS BOOLEAN
    DIM path AS STRING = m.DialogPathBuf
    IF path = "" THEN
        m.StatusBar.Message = "⚠ path required"
        RETURN FALSE
    END IF
    IF m.DialogAction = "file.open" THEN
        DIM p AS Project
        DIM err AS ERROR
        p, err = LoadProject(path)
        IF err <> NIL THEN
            m.StatusBar.Message = "⚠ open: " + err.Error()
            RETURN FALSE
        END IF
        m.Tree.Project = p
        m.Tree.buildFromProject()
        m.Tree.rebuildLines()
        loadStartForm(m)
        m.StatusBar.Message = "opened: " + path
        RETURN TRUE
    END IF
    IF m.DialogAction = "file.saveas" THEN
        syncProjectFromVisual(m)
        m.Tree.Project.Path = path
        DIM serr AS ERROR = SaveProject(m.Tree.Project, path)
        IF serr <> NIL THEN
            m.StatusBar.Message = "⚠ save: " + serr.Error()
            RETURN FALSE
        END IF
        m.StatusBar.Message = "saved: " + path
        RETURN TRUE
    END IF
    m.StatusBar.Message = "⚠ unknown dialog action: " + m.DialogAction
    RETURN FALSE
END FUNCTION

' dialogPathEdit handles one keystroke while the path field has focus.
SUB dialogPathEdit(m AS POINTER TO Model, k AS STRING)
    IF k = "backspace" THEN
        IF m.DialogPathPos > 0 THEN
            DIM before AS STRING = Mid(m.DialogPathBuf, 1, m.DialogPathPos - 1)
            DIM after AS STRING = ""
            IF m.DialogPathPos < LEN(m.DialogPathBuf) THEN
                after = Mid(m.DialogPathBuf, m.DialogPathPos + 1, LEN(m.DialogPathBuf) - m.DialogPathPos)
            END IF
            m.DialogPathBuf = before + after
            m.DialogPathPos = m.DialogPathPos - 1
            m.DialogError = ""
        END IF
        RETURN
    END IF
    IF k = "delete" THEN
        IF m.DialogPathPos < LEN(m.DialogPathBuf) THEN
            DIM before2 AS STRING = Mid(m.DialogPathBuf, 1, m.DialogPathPos)
            DIM after2 AS STRING = ""
            IF m.DialogPathPos + 1 < LEN(m.DialogPathBuf) THEN
                after2 = Mid(m.DialogPathBuf, m.DialogPathPos + 2, LEN(m.DialogPathBuf) - m.DialogPathPos - 1)
            END IF
            m.DialogPathBuf = before2 + after2
            m.DialogError = ""
        END IF
        RETURN
    END IF
    IF k = "left" THEN
        IF m.DialogPathPos > 0 THEN m.DialogPathPos = m.DialogPathPos - 1
        RETURN
    END IF
    IF k = "right" THEN
        IF m.DialogPathPos < LEN(m.DialogPathBuf) THEN m.DialogPathPos = m.DialogPathPos + 1
        RETURN
    END IF
    IF k = "home" OR k = "ctrl+a" THEN
        m.DialogPathPos = 0
        RETURN
    END IF
    IF k = "end" OR k = "ctrl+e" THEN
        m.DialogPathPos = LEN(m.DialogPathBuf)
        RETURN
    END IF
    IF k = "ctrl+u" THEN
        m.DialogPathBuf = Mid(m.DialogPathBuf, m.DialogPathPos + 1, LEN(m.DialogPathBuf) - m.DialogPathPos)
        m.DialogPathPos = 0
        m.DialogError = ""
        RETURN
    END IF
    IF k = "ctrl+k" THEN
        m.DialogPathBuf = Mid(m.DialogPathBuf, 1, m.DialogPathPos)
        m.DialogError = ""
        RETURN
    END IF
    IF LEN(k) = 1 THEN
        DIM b AS STRING = Mid(m.DialogPathBuf, 1, m.DialogPathPos)
        DIM a AS STRING = ""
        IF m.DialogPathPos < LEN(m.DialogPathBuf) THEN
            a = Mid(m.DialogPathBuf, m.DialogPathPos + 1, LEN(m.DialogPathBuf) - m.DialogPathPos)
        END IF
        m.DialogPathBuf = b + k + a
        m.DialogPathPos = m.DialogPathPos + 1
        m.DialogError = ""
    END IF
END SUB

' dialogListMove advances a list cursor by delta, clamps, and adjusts
' the offset to keep the cursor on-screen. listIdx 0 = folders, 1 = files.
SUB dialogListMove(m AS POINTER TO Model, listIdx AS INTEGER, delta AS INTEGER)
    IF listIdx = 0 THEN
        DIM n AS INTEGER = LEN(m.DialogFolders)
        IF n = 0 THEN RETURN
        m.DialogFoldCur = m.DialogFoldCur + delta
        IF m.DialogFoldCur < 0 THEN m.DialogFoldCur = 0
        IF m.DialogFoldCur >= n THEN m.DialogFoldCur = n - 1
        IF m.DialogFoldCur < m.DialogFoldOff THEN m.DialogFoldOff = m.DialogFoldCur
        IF m.DialogFoldCur >= m.DialogFoldOff + dialogListVisibleRows(m) THEN
            m.DialogFoldOff = m.DialogFoldCur - dialogListVisibleRows(m) + 1
        END IF
        RETURN
    END IF
    DIM nf AS INTEGER = LEN(m.DialogFiles)
    IF nf = 0 THEN RETURN
    m.DialogFileCur = m.DialogFileCur + delta
    IF m.DialogFileCur < 0 THEN m.DialogFileCur = 0
    IF m.DialogFileCur >= nf THEN m.DialogFileCur = nf - 1
    IF m.DialogFileCur < m.DialogFileOff THEN m.DialogFileOff = m.DialogFileCur
    IF m.DialogFileCur >= m.DialogFileOff + dialogListVisibleRows(m) THEN
        m.DialogFileOff = m.DialogFileCur - dialogListVisibleRows(m) + 1
    END IF
END SUB

' handleDialogKey routes a keypress to the focused area. Returns TRUE
' if the dialog should close (Esc or successful commit), FALSE to stay.
FUNCTION handleDialogKey(m AS POINTER TO Model, k AS STRING) AS BOOLEAN
    IF k = "esc" THEN RETURN TRUE
    IF k = "tab" THEN
        m.DialogFocus = (m.DialogFocus + 1) MOD DialogFocusCount
        RETURN FALSE
    END IF
    IF k = "shift+tab" THEN
        m.DialogFocus = m.DialogFocus - 1
        IF m.DialogFocus < 0 THEN m.DialogFocus = DialogFocusCount - 1
        RETURN FALSE
    END IF

    ' Per-focus dispatch.
    IF m.DialogFocus = DialogFocusFolders THEN
        IF k = "up" THEN
            dialogListMove(m, 0, -1)
            RETURN FALSE
        END IF
        IF k = "down" THEN
            dialogListMove(m, 0, 1)
            RETURN FALSE
        END IF
        IF k = "pgup" THEN
            dialogListMove(m, 0, -dialogListVisibleRows(m))
            RETURN FALSE
        END IF
        IF k = "pgdown" THEN
            dialogListMove(m, 0, dialogListVisibleRows(m))
            RETURN FALSE
        END IF
        IF k = "enter" THEN
            IF m.DialogFoldCur >= 0 AND m.DialogFoldCur < LEN(m.DialogFolders) THEN
                cdInto(m, m.DialogFolders[m.DialogFoldCur])
            END IF
            RETURN FALSE
        END IF
        RETURN FALSE
    END IF

    IF m.DialogFocus = DialogFocusFiles THEN
        IF k = "up" THEN
            dialogListMove(m, 1, -1)
            RETURN FALSE
        END IF
        IF k = "down" THEN
            dialogListMove(m, 1, 1)
            RETURN FALSE
        END IF
        IF k = "pgup" THEN
            dialogListMove(m, 1, -dialogListVisibleRows(m))
            RETURN FALSE
        END IF
        IF k = "pgdown" THEN
            dialogListMove(m, 1, dialogListVisibleRows(m))
            RETURN FALSE
        END IF
        IF k = "enter" THEN
            IF m.DialogFileCur >= 0 AND m.DialogFileCur < LEN(m.DialogFiles) THEN
                m.DialogPathBuf = filepath.Join(m.DialogCurDir, m.DialogFiles[m.DialogFileCur])
                m.DialogPathPos = LEN(m.DialogPathBuf)
                DIM ok AS BOOLEAN = dispatchDialogAction(m)
                RETURN ok
            END IF
            RETURN FALSE
        END IF
        RETURN FALSE
    END IF

    IF m.DialogFocus = DialogFocusOK THEN
        IF k = "enter" OR k = "space" THEN
            DIM ok2 AS BOOLEAN = dispatchDialogAction(m)
            RETURN ok2
        END IF
        RETURN FALSE
    END IF

    IF m.DialogFocus = DialogFocusCancel THEN
        IF k = "enter" OR k = "space" THEN RETURN TRUE
        RETURN FALSE
    END IF

    ' Path field — also handles Enter (commit) and the readline keys.
    IF k = "enter" THEN
        DIM ok3 AS BOOLEAN = dispatchDialogAction(m)
        RETURN ok3
    END IF
    dialogPathEdit(m, k)
    RETURN FALSE
END FUNCTION

' truncR — right-trim by visible-width; appends "…" if cut.
FUNCTION truncR(s AS STRING, w AS INTEGER) AS STRING
    IF lipgloss.Width(s) <= w THEN RETURN s
    IF w <= 1 THEN RETURN "…"
    DIM out AS STRING = s
    DO WHILE lipgloss.Width(out + "…") > w AND LEN(out) > 0
        out = Mid(out, 1, LEN(out) - 1)
    LOOP
    RETURN out + "…"
END FUNCTION

' renderDialogPathRow builds the editable path-field row.
FUNCTION renderDialogPathRow(m AS Model, innerW AS INTEGER) AS STRING
    DIM bStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorMenuBg())
    DIM labelStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorMenuBg()).Bold(TRUE)
    DIM textStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorBg())
    DIM textFocused AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorSelection())

    DIM tStyle AS lipgloss.Style = textStyle
    IF m.DialogFocus = DialogFocusPath THEN tStyle = textFocused

    DIM label AS STRING = " Path: "
    DIM labelW AS INTEGER = lipgloss.Width(label)
    DIM fieldW AS INTEGER = innerW - labelW

    DIM pre AS STRING = ""
    DIM post AS STRING = ""
    IF m.DialogPathPos > 0 THEN pre = Mid(m.DialogPathBuf, 1, m.DialogPathPos)
    IF m.DialogPathPos < LEN(m.DialogPathBuf) THEN
        post = Mid(m.DialogPathBuf, m.DialogPathPos + 1, LEN(m.DialogPathBuf) - m.DialogPathPos)
    END IF
    DIM caret AS STRING = "▎"
    IF m.DialogFocus <> DialogFocusPath THEN caret = ""
    DIM content AS STRING = pre + caret + post
    content = truncR(content, fieldW - 1)
    DIM pad AS INTEGER = fieldW - lipgloss.Width(content) - 1
    IF pad < 0 THEN pad = 0
    RETURN bStyle.Render("║") + labelStyle.Render(label) + tStyle.Render(" " + content + strings.Repeat(" ", pad)) + bStyle.Render("║")
END FUNCTION

' dialogListVisibleRows — visible rows in each list, derived from the
' current dialog height. Total chrome (top border, title, cwd, path,
' separator, header, separator, footer, buttons, bottom border) = 10.
FUNCTION dialogListVisibleRows(m AS POINTER TO Model) AS INTEGER
    DIM n AS INTEGER = m.DialogHeight - 8
    IF n < 3 THEN n = 3
    RETURN n
END FUNCTION

' renderDialogListsRow builds the side-by-side Folders / Files lists
' as a list of cell rows.
FUNCTION renderDialogListsRows(m AS Model, innerW AS INTEGER) AS []STRING
    DIM bStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorMenuBg())
    DIM headStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorMenuBg()).Bold(TRUE)
    DIM sepStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorBorder()).Background(ColorMenuBg())
    DIM rowStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorBg())
    DIM cursorStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorSelection()).Bold(TRUE)
    DIM dimStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorBorder()).Background(ColorBg())

    DIM colW AS INTEGER = (innerW - 1) / 2
    IF colW > 25 THEN colW = 25
    DIM colWR AS INTEGER = innerW - 1 - colW

    ' Header row.
    DIM foldHead AS STRING = " Folders"
    DIM fileHead AS STRING = " Files"
    IF m.DialogMask <> "" AND m.DialogMask <> "*" THEN fileHead = fileHead + " (" + m.DialogMask + ")"
    DIM foldHeadPad AS INTEGER = colW - lipgloss.Width(foldHead)
    IF foldHeadPad < 0 THEN foldHeadPad = 0
    DIM fileHeadPad AS INTEGER = colWR - lipgloss.Width(fileHead)
    IF fileHeadPad < 0 THEN fileHeadPad = 0
    DIM headRow AS STRING = bStyle.Render("║") + headStyle.Render(foldHead + strings.Repeat(" ", foldHeadPad)) + sepStyle.Render("│") + headStyle.Render(fileHead + strings.Repeat(" ", fileHeadPad)) + bStyle.Render("║")

    DIM rows AS []STRING
    rows = APPEND(rows, headRow)

    DIM listH AS INTEGER = dialogListVisibleRows(@m)
    DIM r AS INTEGER
    FOR r = 0 TO listH - 1
        DIM foldIdx AS INTEGER = m.DialogFoldOff + r
        DIM fileIdx AS INTEGER = m.DialogFileOff + r

        DIM foldText AS STRING = ""
        DIM foldDim AS BOOLEAN = TRUE
        IF foldIdx >= 0 AND foldIdx < LEN(m.DialogFolders) THEN
            foldText = m.DialogFolders[foldIdx] + "/"
            foldDim = FALSE
        END IF
        DIM foldVis AS STRING = " " + truncR(foldText, colW - 1)
        DIM foldPad AS INTEGER = colW - lipgloss.Width(foldVis)
        IF foldPad < 0 THEN foldPad = 0
        DIM foldRendered AS STRING
        IF foldDim THEN
            foldRendered = dimStyle.Render(foldVis + strings.Repeat(" ", foldPad))
        ELSEIF foldIdx = m.DialogFoldCur AND m.DialogFocus = DialogFocusFolders THEN
            foldRendered = cursorStyle.Render(foldVis + strings.Repeat(" ", foldPad))
        ELSE
            foldRendered = rowStyle.Render(foldVis + strings.Repeat(" ", foldPad))
        END IF

        DIM fileText AS STRING = ""
        DIM fileDim AS BOOLEAN = TRUE
        IF fileIdx >= 0 AND fileIdx < LEN(m.DialogFiles) THEN
            fileText = m.DialogFiles[fileIdx]
            fileDim = FALSE
        END IF
        DIM fileVis AS STRING = " " + truncR(fileText, colWR - 1)
        DIM filePad AS INTEGER = colWR - lipgloss.Width(fileVis)
        IF filePad < 0 THEN filePad = 0
        DIM fileRendered AS STRING
        IF fileDim THEN
            fileRendered = dimStyle.Render(fileVis + strings.Repeat(" ", filePad))
        ELSEIF fileIdx = m.DialogFileCur AND m.DialogFocus = DialogFocusFiles THEN
            fileRendered = cursorStyle.Render(fileVis + strings.Repeat(" ", filePad))
        ELSE
            fileRendered = rowStyle.Render(fileVis + strings.Repeat(" ", filePad))
        END IF

        rows = APPEND(rows, bStyle.Render("║") + foldRendered + sepStyle.Render("│") + fileRendered + bStyle.Render("║"))
    NEXT r
    RETURN rows
END FUNCTION

' renderDialogButtonsRow — right-aligned [ OK ]   [ Cancel ].
FUNCTION renderDialogButtonsRow(m AS Model, innerW AS INTEGER) AS STRING
    DIM bStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorMenuBg())
    DIM bg AS lipgloss.Style = lipgloss.NewStyle().Background(ColorMenuBg())
    DIM btnStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorMenuFg()).Background(ColorMenuBg())
    DIM btnFocused AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFg()).Background(ColorSelection()).Bold(TRUE)

    DIM okLabel AS STRING = "[ OK ]"
    DIM cnLabel AS STRING = "[ Cancel ]"
    DIM okText AS STRING
    IF m.DialogFocus = DialogFocusOK THEN
        okText = btnFocused.Render(okLabel)
    ELSE
        okText = btnStyle.Render(okLabel)
    END IF
    DIM cnText AS STRING
    IF m.DialogFocus = DialogFocusCancel THEN
        cnText = btnFocused.Render(cnLabel)
    ELSE
        cnText = btnStyle.Render(cnLabel)
    END IF
    DIM rightW AS INTEGER = lipgloss.Width(okLabel) + 3 + lipgloss.Width(cnLabel) + 1
    DIM pad AS INTEGER = innerW - rightW
    IF pad < 0 THEN pad = 0
    RETURN bStyle.Render("║") + bg.Render(strings.Repeat(" ", pad)) + okText + bg.Render("   ") + cnText + bg.Render(" ") + bStyle.Render("║")
END FUNCTION

' renderDialog produces the overlay box at (DialogX, DialogY) with size
' (DialogWidth, DialogHeight). Returns ("", 0, 0) if the dialog isn't
' active.
FUNCTION renderDialog(m AS Model) AS (STRING, INTEGER, INTEGER)
    IF NOT m.DialogActive THEN RETURN "", 0, 0
    DIM innerW AS INTEGER = m.DialogWidth - 2
    IF innerW < 30 THEN innerW = 30

    DIM bStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorFocusBorder()).Background(ColorMenuBg())
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorMenuBg()).Bold(TRUE)
    DIM bg AS lipgloss.Style = lipgloss.NewStyle().Background(ColorMenuBg()).Foreground(ColorFg())
    DIM handleStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(ColorAccent()).Background(ColorMenuBg()).Bold(TRUE)

    DIM hr AS STRING = strings.Repeat("═", innerW)
    DIM top AS STRING = bStyle.Render("╔") + bStyle.Render(hr) + bStyle.Render("╗")
    ' Bottom border ends with a resize handle ⤡ in place of the corner.
    DIM bottom AS STRING = bStyle.Render("╚") + bStyle.Render(hr) + handleStyle.Render("⤡")
    DIM hrLight AS STRING = bStyle.Render("║") + bg.Render(strings.Repeat("─", innerW)) + bStyle.Render("║")

    ' Title row (centred).
    DIM titleW AS INTEGER = lipgloss.Width(m.DialogTitle)
    DIM titlePad AS INTEGER = (innerW - titleW) / 2
    IF titlePad < 0 THEN titlePad = 0
    DIM titlePadR AS INTEGER = innerW - titlePad - titleW
    IF titlePadR < 0 THEN titlePadR = 0
    DIM titleRow AS STRING = bStyle.Render("║") + bg.Render(strings.Repeat(" ", titlePad)) + titleStyle.Render(m.DialogTitle) + bg.Render(strings.Repeat(" ", titlePadR)) + bStyle.Render("║")

    ' Path field row.
    DIM pathRow AS STRING = renderDialogPathRow(m, innerW)

    ' Lists.
    DIM listRows AS []STRING = renderDialogListsRows(m, innerW)

    ' Buttons row.
    DIM buttonsRow AS STRING = renderDialogButtonsRow(m, innerW)

    DIM lines AS []STRING
    lines = APPEND(lines, top)
    lines = APPEND(lines, titleRow)
    lines = APPEND(lines, pathRow)
    lines = APPEND(lines, hrLight)
    DIM li AS INTEGER
    FOR li = 0 TO LEN(listRows) - 1
        lines = APPEND(lines, listRows[li])
    NEXT li
    lines = APPEND(lines, hrLight)
    lines = APPEND(lines, buttonsRow)
    lines = APPEND(lines, bottom)
    DIM dlg AS STRING = strings.Join(lines, "\n")
    RETURN dlg, m.DialogX, m.DialogY
END FUNCTION

' isDoubleClick — TRUE when this click is within 500ms of a previous
' click on the same panel + row. Records this click as "last" either
' way so two slow clicks count as two singles.
FUNCTION isDoubleClick(m AS POINTER TO Model, panel AS INTEGER, row AS INTEGER) AS BOOLEAN
    DIM now AS time.Time = time.Now()
    DIM result AS BOOLEAN = FALSE
    IF m.LastClickPanel = panel AND m.LastClickRow = row THEN
        DIM dur AS time.Duration = now.Sub(m.LastClickAt)
        IF dur < 500 * time.Millisecond THEN result = TRUE
    END IF
    m.LastClickPanel = panel
    m.LastClickRow = row
    m.LastClickAt = now
    RETURN result
END FUNCTION

' ----------------------------------------------------------------------
' bubbletea v2 lifecycle
' ----------------------------------------------------------------------

' shellTickEvent is emitted by tea.Tick — fires every ~50ms when the
' Shell tab is active so we can drain PTY output into the scrollback.
TYPE shellTickEvent
    DIM Tick AS BOOLEAN
END TYPE

FUNCTION shellTickHandler(t AS time.Time) AS tea.Msg
    _ = t
    DIM changed AS BOOLEAN = ShellDrain()
    _ = changed
    DIM ev AS shellTickEvent
    ev.Tick = TRUE
    RETURN ev
END FUNCTION

FUNCTION (m AS Model) Init() AS tea.Cmd
    ' Bootstrap the shell-drain tick loop.
    RETURN tea.Tick(50 * time.Millisecond, shellTickHandler)
END FUNCTION

' applyLayout recomputes panel rectangles + cascades sizes to children
' based on m.Width/m.Height/m.LeftW/m.RightW/m.PaletteH/m.BottomHeight.
' Clamps each tunable to its safe range. Called from the WindowSizeMsg
' handler AND from split-bar drag motion so resizing happens live.
SUB applyLayout(m AS POINTER TO Model)
    m.MenuBar.SetWidth(m.Width)
    m.StatusBar.SetWidth(m.Width)
    DIM bodyH AS INTEGER = m.Height - 2
    IF bodyH < 3 THEN bodyH = 3
    DIM bottomH AS INTEGER = 0
    IF m.BottomVisible THEN
        bottomH = m.BottomHeight
        IF bottomH > bodyH - 5 THEN bottomH = bodyH - 5
        IF bottomH < 4 THEN bottomH = 4
        m.BottomHeight = bottomH
    END IF
    DIM topH AS INTEGER = bodyH - bottomH
    IF topH < 3 THEN topH = 3

    ' Sidebar widths — clamp so neither overruns the canvas budget.
    IF m.LeftW < 12 THEN m.LeftW = 12
    IF m.RightW < 16 THEN m.RightW = 16
    DIM maxCanvas AS INTEGER = m.Width - m.LeftW - m.RightW
    IF maxCanvas < 10 THEN
        ' Squeeze proportionally if the terminal is too narrow.
        DIM need AS INTEGER = 10 - maxCanvas
        DIM trimL AS INTEGER = need / 2
        DIM trimR AS INTEGER = need - trimL
        IF m.LeftW - trimL >= 12 THEN m.LeftW = m.LeftW - trimL
        IF m.RightW - trimR >= 16 THEN m.RightW = m.RightW - trimR
    END IF
    DIM canvasW AS INTEGER = m.Width - m.LeftW - m.RightW
    IF canvasW < 1 THEN canvasW = 1

    m.Tree.SetSize(m.LeftW, topH)
    DIM paletteH AS INTEGER = m.PaletteH
    IF paletteH > topH - 5 THEN paletteH = topH - 5
    IF paletteH < 4 THEN paletteH = 4
    m.PaletteH = paletteH
    DIM propsH AS INTEGER = topH - paletteH
    IF propsH < 3 THEN propsH = 3
    m.Palette.Width = m.RightW
    m.Palette.Height = paletteH - 1
    m.Properties.SetSize(m.RightW, propsH)
    DIM centerInnerH AS INTEGER = topH - 1
    IF centerInnerH < 1 THEN centerInnerH = 1
    m.Visual.SetSize(canvasW, centerInnerH)
    m.Editor.SetWidth(canvasW)
    m.Editor.SetHeight(centerInnerH)
    m.CodeViewH = centerInnerH

    m.MenuRect.X = 0
    m.MenuRect.Y = 0
    m.MenuRect.W = m.Width
    m.MenuRect.H = 1
    m.TreeRect.X = 0
    m.TreeRect.Y = 1
    m.TreeRect.W = m.LeftW
    m.TreeRect.H = topH
    m.VisualRect.X = m.LeftW
    m.VisualRect.Y = 2
    m.VisualRect.W = canvasW
    m.VisualRect.H = centerInnerH
    m.PaletteRect.X = m.LeftW + canvasW
    m.PaletteRect.Y = 1
    m.PaletteRect.W = m.RightW
    m.PaletteRect.H = paletteH
    m.PropsRect.X = m.LeftW + canvasW
    m.PropsRect.Y = 1 + paletteH
    m.PropsRect.W = m.RightW
    m.PropsRect.H = propsH
    m.BottomRect.X = 0
    m.BottomRect.Y = 1 + topH
    m.BottomRect.W = m.Width
    m.BottomRect.H = bottomH
    m.StatusRect.X = 0
    m.StatusRect.Y = m.Height - 1
    m.StatusRect.W = m.Width
    m.StatusRect.H = 1
END SUB

FUNCTION (m AS Model) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' shellTickEvent — drain the PTY buffer + re-arm the timer.
    DIM stk AS shellTickEvent
    DIM stkOk AS BOOLEAN
    stk, stkOk = msg.(shellTickEvent)
    IF stkOk THEN
        _ = stk
        RETURN m, tea.Tick(50 * time.Millisecond, shellTickHandler)
    END IF

    ' WindowSizeMsg — record dimensions and cascade to children.
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = sizeMsg.Width
        m.Height = sizeMsg.Height
        applyLayout(@m)
        RETURN m, NIL
    END IF

    ' Bracketed paste — most terminals intercept Ctrl+V (or Cmd+V) and
    ' deliver the system-clipboard contents as a paste event rather than
    ' as a Ctrl+V key. Code mode pastes into the buffer; form-designer
    ' mode treats it as a widget-clipboard paste (since the OS clipboard
    ' content is irrelevant — the user wanted to paste the widgets they
    ' just copied via Ctrl+C).
    DIM pasteMsg AS tea.PasteMsg
    DIM pasteOk AS BOOLEAN
    pasteMsg, pasteOk = msg.(tea.PasteMsg)
    IF pasteOk THEN
        IF m.CodeMode THEN
            m.CodeClip = pasteMsg.Content
            pasteAtCursor(@m)
            m.StatusBar.Message = fmt.Sprintf("pasted %d chars", LEN(pasteMsg.Content))
            m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
            refreshAutocomplete(@m)
            RETURN m, NIL
        END IF
        RETURN m, dispatchFileAction(@m, "edit.paste")
    END IF

    ' Shell tab key routing — when the bottom pane is visible and the
    ' Shell tab is active, all key presses go to the PTY (the Shell
    ' has "implicit focus" while shown). Mouse clicks fall through so
    ' the user can switch back to the Console tab.
    DIM shKey AS tea.KeyPressMsg
    DIM shKeyOk AS BOOLEAN
    shKey, shKeyOk = msg.(tea.KeyPressMsg)
    IF shKeyOk AND m.BottomVisible AND m.BottomTab = BottomTabShell AND ShellIsActive() THEN
        DIM ks AS STRING = shKey.String()
        ' Escape hatches: F12 hides the bottom pane; Ctrl+\ kills the
        ' shell (gets us back to a normal IDE state).
        IF ks = "f12" THEN
            m.BottomVisible = FALSE
            applyLayout(@m)
            RETURN m, NIL
        END IF
        IF ks = "ctrl+\\" THEN
            ShellStop()
            RETURN m, NIL
        END IF
        ShellWriteKey(ks)
        RETURN m, NIL
    END IF

    ' MouseClickMsg — route to panel under cursor.
    DIM mcMsg AS tea.MouseClickMsg
    DIM mcOk AS BOOLEAN
    mcMsg, mcOk = msg.(tea.MouseClickMsg)
    IF mcOk THEN
        ' Code-mode canvas click: if the click landed inside an active
        ' selection, arm a text-drag (we'll cut + reinsert at the drop
        ' position on release). Otherwise place the cursor at the
        ' clicked spot and arm a fresh selection drag.
        IF m.CodeMode AND pointInRect(mcMsg.X, mcMsg.Y, m.VisualRect) THEN
            DIM cmRow AS INTEGER
            DIM cmCol AS INTEGER
            cmRow, cmCol = codeXYToRowCol(@m, mcMsg.X, mcMsg.Y)
            IF mcMsg.Button = tea.MouseLeft AND isInSelection(@m, cmRow, cmCol) THEN
                m.DragMode = DragCodeMoveText
                m.DragStartMx = mcMsg.X
                m.DragStartMy = mcMsg.Y
                RETURN m, NIL
            END IF
            moveCursorTo(@m, cmRow, cmCol)
            m.SelActive = FALSE
            m.SelAnchorRow = cmRow
            m.SelAnchorCol = cmCol
            m.DragMode = DragCodeSelect
            RETURN m, NIL
        END IF
        ' Right-click on a widget in the form designer pops a context
        ' menu listing the events that widget supports.
        IF mcMsg.Button = tea.MouseRight AND NOT m.CodeMode AND pointInRect(mcMsg.X, mcMsg.Y, m.VisualRect) THEN
            DIM rcFx AS INTEGER = mcMsg.X - m.VisualRect.X - 1
            DIM rcFy AS INTEGER = mcMsg.Y - m.VisualRect.Y - 1
            DIM widIdx AS INTEGER = m.Visual.WidgetAt(rcFx, rcFy)
            IF widIdx >= 0 THEN
                m.Visual.SelectOnly(widIdx)
                refreshPropertiesFromSource(@m)
                openWidgetContextMenu(@m, widIdx, mcMsg.X, mcMsg.Y)
                RETURN m, NIL
            END IF
        END IF
        ' Any click closes an open context menu (besides the right-click
        ' that just opened it, which returned above).
        IF m.CtxMenuActive THEN closeWidgetContextMenu(@m)
        DIM clickCmd AS tea.Cmd = NIL
        IF mcMsg.Button = tea.MouseLeft THEN
            ' Most terminals intercept Shift+click for their own text
            ' selection. Treat ANY modifier (Shift OR Ctrl OR Alt) as
            ' "additive" — whichever modifier the terminal lets pass
            ' through is fine.
            DIM modMask AS INTEGER = Int(tea.ModShift) + Int(tea.ModCtrl) + Int(tea.ModAlt)
            DIM additive AS BOOLEAN = (BitAnd(Int(mcMsg.Mod), modMask) <> 0)
            clickCmd = handleMouseClick(@m, mcMsg.X, mcMsg.Y, additive)
        END IF
        RETURN m, clickCmd
    END IF

    ' MouseReleaseMsg — finalize any in-progress drag.
    DIM mrMsg AS tea.MouseReleaseMsg
    DIM mrOk AS BOOLEAN
    mrMsg, mrOk = msg.(tea.MouseReleaseMsg)
    IF mrOk THEN
        IF m.DragMode = DragRectSelect THEN
            finishRectSelect(@m)
            m.Visual.ClearMarquee()
        END IF
        IF m.DragMode = DragCodeSelect THEN
            ' If cursor never moved off the anchor it's just a click —
            ' don't leave a phantom zero-length selection.
            IF m.Editor.Line() = m.SelAnchorRow AND m.Editor.Column() = m.SelAnchorCol THEN
                m.SelActive = FALSE
            END IF
        END IF
        IF m.DragMode = DragCodeMoveText THEN
            DIM mtDr AS INTEGER
            DIM mtDc AS INTEGER
            mtDr, mtDc = codeXYToRowCol(@m, mrMsg.X, mrMsg.Y)
            IF isInSelection(@m, mtDr, mtDc) THEN
                ' Dropped inside the selection — treat as a plain click:
                ' put the cursor at that spot and drop the selection.
                moveCursorTo(@m, mtDr, mtDc)
                m.SelActive = FALSE
            ELSE
                moveSelectionTo(@m, mtDr, mtDc)
            END IF
        END IF
        IF m.DragMode <> DragNone THEN
            m.DragMode = DragNone
            refreshPropertiesFromSource(@m)
        END IF
        RETURN m, NIL
    END IF

    ' MouseMotionMsg — drive hover state, and apply any in-progress drag.
    DIM mmMsg AS tea.MouseMotionMsg
    DIM mmOk AS BOOLEAN
    mmMsg, mmOk = msg.(tea.MouseMotionMsg)
    IF mmOk THEN
        IF m.DragMode <> DragNone THEN
            handleMouseDrag(@m, mmMsg.X, mmMsg.Y)
        ELSE
            handleMouseMotion(@m, mmMsg.X, mmMsg.Y)
        END IF
        RETURN m, NIL
    END IF

    ' MouseWheelMsg — scroll the panel under the cursor.
    DIM mwMsg AS tea.MouseWheelMsg
    DIM mwOk AS BOOLEAN
    mwMsg, mwOk = msg.(tea.MouseWheelMsg)
    IF mwOk THEN
        handleMouseWheel(@m, mwMsg.X, mwMsg.Y, mwMsg.Button = tea.MouseWheelUp)
        RETURN m, NIL
    END IF

    ' KeyPressMsg — dispatch by mode.
    DIM keyMsg AS tea.KeyPressMsg
    DIM keyOk AS BOOLEAN
    keyMsg, keyOk = msg.(tea.KeyPressMsg)
    IF keyOk THEN
        DIM k AS STRING = keyMsg.String()

        IF m.Mode = ModeFileDialog THEN
            DIM done AS BOOLEAN = handleDialogKey(@m, k)
            IF done THEN closeDialog(@m)
            RETURN m, NIL
        END IF

        IF m.Mode = ModePropEdit THEN
            ' --- Property edit mode ------------------------------------
            IF k = "esc" THEN
                m.Properties.CancelEdit()
                m.Mode = ModeNormal
                m.StatusBar.Message = defaultStatus()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM pname AS STRING
                DIM pbuf AS STRING
                DIM pok AS BOOLEAN
                pname, pbuf, pok = m.Properties.CommitEdit()
                IF NOT pok THEN
                    m.Properties.CancelEdit()
                    m.Mode = ModeNormal
                    m.StatusBar.Message = defaultStatus()
                    RETURN m, NIL
                END IF
                IF m.Properties.HasWidget THEN pushUndo(@m)
                DIM aerr AS ERROR
                IF m.Properties.HasWidget THEN
                    aerr = applyWidgetEdit(@m, pname, pbuf)
                ELSE
                    aerr = applyFormEdit(@m, pname, pbuf)
                END IF
                IF aerr <> NIL THEN
                    m.Properties.SetEditError(aerr.Error())
                    m.StatusBar.Message = pname + ": " + aerr.Error()
                    RETURN m, NIL
                END IF
                m.Properties.FinishEdit()
                refreshPropertiesFromSource(@m)
                m.Mode = ModeNormal
                m.StatusBar.Message = "set " + pname + " = " + pbuf
                RETURN m, NIL
            END IF
            IF k = "backspace" THEN
                m.Properties.EditBackspace()
                RETURN m, NIL
            END IF
            IF k = "delete" THEN
                m.Properties.EditDelete()
                RETURN m, NIL
            END IF
            IF k = "left" THEN
                m.Properties.EditCursorLeft()
                RETURN m, NIL
            END IF
            IF k = "right" THEN
                m.Properties.EditCursorRight()
                RETURN m, NIL
            END IF
            IF k = "home" OR k = "ctrl+a" THEN
                m.Properties.EditCursorHome()
                RETURN m, NIL
            END IF
            IF k = "end" OR k = "ctrl+e" THEN
                m.Properties.EditCursorEnd()
                RETURN m, NIL
            END IF
            IF k = "ctrl+left" OR k = "alt+left" OR k = "alt+b" THEN
                m.Properties.EditCursorWordLeft()
                RETURN m, NIL
            END IF
            IF k = "ctrl+right" OR k = "alt+right" OR k = "alt+f" THEN
                m.Properties.EditCursorWordRight()
                RETURN m, NIL
            END IF
            IF k = "ctrl+k" THEN
                m.Properties.EditKillToEnd()
                RETURN m, NIL
            END IF
            IF k = "ctrl+u" THEN
                m.Properties.EditKillToStart()
                RETURN m, NIL
            END IF
            IF k = "ctrl+w" OR k = "ctrl+backspace" THEN
                m.Properties.EditKillWordLeft()
                RETURN m, NIL
            END IF
            ' Single-character keys append to the edit buffer. Anything
            ' longer is a control key (arrow, fn key, etc.) and is
            ' swallowed so it doesn't leak through to normal-mode
            ' dispatch.
            IF LEN(k) = 1 THEN
                m.Properties.EditChar(k)
                RETURN m, NIL
            END IF
            RETURN m, NIL
        END IF

        IF m.Mode = ModeContextMenu THEN
            ' --- Right-click widget context menu -----------------------
            IF k = "esc" THEN
                closeWidgetContextMenu(@m)
                RETURN m, NIL
            END IF
            IF k = "up" THEN
                m.CtxMenuIdx = m.CtxMenuIdx - 1
                IF m.CtxMenuIdx < 0 THEN m.CtxMenuIdx = LEN(m.CtxMenuItems) - 1
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.CtxMenuIdx = m.CtxMenuIdx + 1
                IF m.CtxMenuIdx >= LEN(m.CtxMenuItems) THEN m.CtxMenuIdx = 0
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM evName AS STRING = m.CtxMenuItems[m.CtxMenuIdx]
                DIM ctxWid AS STRING = m.CtxMenuWidId
                closeWidgetContextMenu(@m)
                openHandlerInCode(@m, ctxWid, evName)
                RETURN m, NIL
            END IF
            RETURN m, NIL
        END IF

        IF m.Mode = ModeMenuBar THEN
            ' --- Menu mode ---------------------------------------------
            IF k = "esc" THEN
                m.MenuBar.Close()
                m.Mode = ModeNormal
                m.StatusBar.Message = defaultStatus()
                RETURN m, NIL
            END IF
            IF k = "left" THEN
                m.MenuBar.PrevMenu()
                RETURN m, NIL
            END IF
            IF k = "right" THEN
                m.MenuBar.NextMenu()
                RETURN m, NIL
            END IF
            IF k = "up" THEN
                m.MenuBar.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.MenuBar.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM kbAction AS STRING = m.MenuBar.SelectedAction()
                m.MenuBar.Close()
                m.MenuBar.ClearHover()
                m.Mode = ModeNormal
                IF kbAction = "" THEN
                    m.StatusBar.Message = defaultStatus()
                    RETURN m, NIL
                END IF
                DIM kbCmd AS tea.Cmd = dispatchFileAction(@m, kbAction)
                RETURN m, kbCmd
            END IF
            ' Alt+letter while a menu is open switches to that top-level
            ' menu, mirroring the open-from-anywhere shortcuts below.
            IF LEN(k) > 4 AND Mid(k, 1, 4) = "alt+" THEN
                DIM altLetter AS STRING = Mid(k, 5, LEN(k) - 4)
                DIM altIdx AS INTEGER = m.MenuBar.MenuIndexByHotkey(altLetter)
                IF altIdx >= 0 THEN
                    m.MenuBar.OpenMenu(altIdx)
                    RETURN m, NIL
                END IF
                RETURN m, NIL
            END IF
            ' Single printable letter — match against the current menu's
            ' item hotkeys. Found → dispatch immediately (no Enter needed).
            IF LEN(k) = 1 THEN
                DIM hkIdx AS INTEGER = m.MenuBar.ItemIndexByHotkey(k)
                IF hkIdx >= 0 THEN
                    DIM hkItems AS []DropdownItem = m.MenuBar.ActiveItems()
                    DIM hkAction AS STRING = hkItems[hkIdx].Action
                    m.MenuBar.Close()
                    m.MenuBar.ClearHover()
                    m.Mode = ModeNormal
                    IF hkAction = "" THEN
                        m.StatusBar.Message = defaultStatus()
                        RETURN m, NIL
                    END IF
                    DIM hkCmd AS tea.Cmd = dispatchFileAction(@m, hkAction)
                    RETURN m, hkCmd
                END IF
            END IF
            ' Swallow unhandled keys while a menu is open.
            RETURN m, NIL
        END IF

        ' --- Code-editor mode (parallel to focus, but suppresses normal
        '     keybinds while the textarea has the keyboard).
        IF m.CodeMode THEN
            ' Autocomplete popup intercepts navigation keys while open so
            ' Up/Down move within suggestions and Tab/Enter accept the
            ' selected item. Esc dismisses without inserting.
            IF m.AutoActive THEN
                IF k = "esc" THEN
                    m.AutoActive = FALSE
                    RETURN m, NIL
                END IF
                IF k = "up" THEN
                    m.AutoIdx = m.AutoIdx - 1
                    IF m.AutoIdx < 0 THEN m.AutoIdx = LEN(m.AutoItems) - 1
                    RETURN m, NIL
                END IF
                IF k = "down" THEN
                    m.AutoIdx = m.AutoIdx + 1
                    IF m.AutoIdx >= LEN(m.AutoItems) THEN m.AutoIdx = 0
                    RETURN m, NIL
                END IF
                IF k = "tab" OR k = "enter" THEN
                    acceptCompletion(@m)
                    RETURN m, NIL
                END IF
            END IF
            IF k = "f7" OR k = "esc" THEN
                exitCodeMode(@m)
                RETURN m, NIL
            END IF
            IF k = "ctrl+s" THEN
                saveCodeBuffer(@m)
                RETURN m, NIL
            END IF
            IF k = "f5" THEN
                ' Save buffer so codegen picks up the latest edits, then run.
                saveCodeBuffer(@m)
                RETURN m, dispatchFileAction(@m, "run.run")
            END IF
            ' --- Selection clipboard shortcuts ---
            IF k = "ctrl+c" THEN
                IF m.SelActive THEN
                    DIM ccCmd AS tea.Cmd = copySelection(@m)
                    m.StatusBar.Message = fmt.Sprintf("copied %d chars", LEN(m.CodeClip))
                    RETURN m, ccCmd
                END IF
                m.StatusBar.Message = "nothing selected"
                RETURN m, NIL
            END IF
            IF k = "ctrl+x" THEN
                IF m.SelActive THEN
                    DIM cxCmd AS tea.Cmd = copySelection(@m)
                    DIM xN AS INTEGER = LEN(m.CodeClip)
                    deleteSelection(@m)
                    m.StatusBar.Message = fmt.Sprintf("cut %d chars", xN)
                    refreshAutocomplete(@m)
                    RETURN m, cxCmd
                END IF
                m.StatusBar.Message = "nothing selected"
                RETURN m, NIL
            END IF
            IF k = "ctrl+v" THEN
                IF m.CodeClip = "" THEN
                    m.StatusBar.Message = "clipboard empty"
                    RETURN m, NIL
                END IF
                DIM pN AS INTEGER = LEN(m.CodeClip)
                pasteAtCursor(@m)
                m.StatusBar.Message = fmt.Sprintf("pasted %d chars", pN)
                m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
                refreshAutocomplete(@m)
                RETURN m, NIL
            END IF
            IF k = "ctrl+a" THEN
                selectAllCode(@m)
                m.StatusBar.Message = "selected all"
                m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
                RETURN m, NIL
            END IF
            ' --- Shift+motion extends the selection ---
            DIM isShiftMotion AS BOOLEAN = FALSE
            IF k = "shift+left" OR k = "shift+right" OR k = "shift+up" OR k = "shift+down" THEN isShiftMotion = TRUE
            IF k = "shift+home" OR k = "shift+end" THEN isShiftMotion = TRUE
            IF k = "shift+ctrl+left" OR k = "shift+ctrl+right" THEN isShiftMotion = TRUE
            IF isShiftMotion THEN
                beginOrExtendSelection(@m)
                IF k = "shift+left" THEN
                    IF m.Editor.Column() > 0 THEN
                        m.Editor.SetCursorColumn(m.Editor.Column() - 1)
                    ELSEIF m.Editor.Line() > 0 THEN
                        DIM upLine AS STRING = currentLine(m.Editor.Value(), m.Editor.Line() - 1)
                        m.Editor.CursorUp()
                        m.Editor.SetCursorColumn(LEN(upLine))
                    END IF
                ELSEIF k = "shift+right" THEN
                    DIM curLine AS STRING = currentLine(m.Editor.Value(), m.Editor.Line())
                    IF m.Editor.Column() < LEN(curLine) THEN
                        m.Editor.SetCursorColumn(m.Editor.Column() + 1)
                    ELSE
                        m.Editor.CursorDown()
                        IF m.Editor.Line() > 0 THEN m.Editor.SetCursorColumn(0)
                    END IF
                ELSEIF k = "shift+up" THEN
                    m.Editor.CursorUp()
                ELSEIF k = "shift+down" THEN
                    m.Editor.CursorDown()
                ELSEIF k = "shift+home" THEN
                    m.Editor.CursorStart()
                ELSEIF k = "shift+end" THEN
                    m.Editor.CursorEnd()
                END IF
                m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
                RETURN m, NIL
            END IF
            ' --- Plain motion clears the selection (but still moves) and
            '     dismisses the autocomplete popup so the suggestions
            '     don't follow the cursor as you navigate over words.
            DIM isCursorMotion AS BOOLEAN = FALSE
            IF k = "left" OR k = "right" OR k = "up" OR k = "down" OR k = "home" OR k = "end" OR k = "pgup" OR k = "pgdown" THEN
                isCursorMotion = TRUE
            END IF
            IF isCursorMotion THEN
                IF m.SelActive THEN clearSelection(@m)
                m.AutoActive = FALSE
            END IF
            ' --- Edits that replace the selection ---
            DIM isInsertion AS BOOLEAN = FALSE
            IF LEN(k) = 1 THEN isInsertion = TRUE
            IF k = "space" THEN isInsertion = TRUE
            IF k = "backspace" OR k = "delete" THEN isInsertion = TRUE
            IF k = "enter" THEN isInsertion = TRUE
            IF k = "tab" THEN isInsertion = TRUE
            IF isInsertion AND m.SelActive THEN
                ' Backspace/Delete with a live selection just removes it.
                IF k = "backspace" OR k = "delete" THEN
                    deleteSelection(@m)
                    refreshAutocomplete(@m)
                    RETURN m, NIL
                END IF
                deleteSelection(@m)
            END IF
            ' Tab inserts four spaces inline (bubbles textarea otherwise
            ' swallows tab as a no-op since it isn't a printable rune).
            IF k = "tab" THEN
                m.Editor.InsertString("    ")
                m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
                refreshAutocomplete(@m)
                RETURN m, NIL
            END IF
            DIM newEditor AS textarea.Model
            DIM eCmd AS tea.Cmd
            newEditor, eCmd = m.Editor.Update(msg)
            m.Editor = newEditor
            ' Enter auto-indents the new line to match the previous line's
            ' leading whitespace — standard code-editor behavior.
            IF k = "enter" THEN autoIndent(@m)
            m.CodeScroll = computeScroll(m.Editor.Line(), m.CodeScroll, m.CodeViewH)
            ' Only refresh suggestions when the user is actually editing —
            ' cursor navigation shouldn't pop the menu just because the
            ' cursor crossed over an identifier.
            IF NOT isCursorMotion THEN refreshAutocomplete(@m)
            RETURN m, eCmd
        END IF

        ' --- Normal mode -----------------------------------------------
        IF k = "f10" THEN
            m.MenuBar.OpenMenu(0)
            m.Mode = ModeMenuBar
            m.StatusBar.Message = "Menu — Esc: Close  ←/→: Menu  ↑/↓: Item  Enter: Select"
            RETURN m, NIL
        END IF
        ' Alt+letter — jump straight into the matching top menu.
        IF LEN(k) > 4 AND Mid(k, 1, 4) = "alt+" THEN
            DIM altL AS STRING = Mid(k, 5, LEN(k) - 4)
            DIM mIdx AS INTEGER = m.MenuBar.MenuIndexByHotkey(altL)
            IF mIdx >= 0 THEN
                m.MenuBar.OpenMenu(mIdx)
                m.Mode = ModeMenuBar
                m.StatusBar.Message = "Menu — Esc: Close  ←/→: Menu  ↑/↓: Item  Enter: Select"
                RETURN m, NIL
            END IF
        END IF
        IF k = "f5" THEN
            RETURN m, dispatchFileAction(@m, "run.run")
        END IF
        IF k = "f7" THEN
            enterCodeMode(@m)
            RETURN m, NIL
        END IF
        IF k = "f12" THEN
            toggleBottomPane(@m)
            RETURN m, NIL
        END IF
        ' Edit-menu keyboard shortcuts (the menu hints already advertise
        ' them; this just makes them work without opening the menu).
        IF k = "ctrl+z" THEN
            RETURN m, dispatchFileAction(@m, "edit.undo")
        END IF
        IF k = "ctrl+y" THEN
            RETURN m, dispatchFileAction(@m, "edit.redo")
        END IF
        IF k = "ctrl+c" THEN
            RETURN m, dispatchFileAction(@m, "edit.copy")
        END IF
        IF k = "ctrl+x" THEN
            RETURN m, dispatchFileAction(@m, "edit.cut")
        END IF
        IF k = "ctrl+v" THEN
            RETURN m, dispatchFileAction(@m, "edit.paste")
        END IF
        IF k = "ctrl+a" THEN
            RETURN m, dispatchFileAction(@m, "edit.selectall")
        END IF
        IF k = "tab" THEN
            ' Cycle ProjectTree → Visual → Widgets → Properties → ProjectTree.
            IF m.Focus = FocusProjectTree THEN
                m.Focus = FocusVisual
                m.Tree.SetFocused(FALSE)
                m.Visual.SetFocused(TRUE)
                m.Palette.Focused = FALSE
                m.Properties.SetFocused(FALSE)
            ELSEIF m.Focus = FocusVisual THEN
                m.Focus = FocusWidgets
                m.Tree.SetFocused(FALSE)
                m.Visual.SetFocused(FALSE)
                m.Palette.Focused = TRUE
                m.Properties.SetFocused(FALSE)
            ELSEIF m.Focus = FocusWidgets THEN
                m.Focus = FocusProperties
                m.Tree.SetFocused(FALSE)
                m.Visual.SetFocused(FALSE)
                m.Palette.Focused = FALSE
                m.Properties.SetFocused(TRUE)
            ELSE
                m.Focus = FocusProjectTree
                m.Tree.SetFocused(TRUE)
                m.Visual.SetFocused(FALSE)
                m.Palette.Focused = FALSE
                m.Properties.SetFocused(FALSE)
            END IF
            RETURN m, NIL
        END IF
        IF m.Focus = FocusProjectTree THEN
            IF k = "up" THEN
                m.Tree.Panel.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.Tree.Panel.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "pgup" THEN
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                m.Tree.Panel.ScrollUp()
                RETURN m, NIL
            END IF
            IF k = "pgdown" THEN
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                m.Tree.Panel.ScrollDown()
                RETURN m, NIL
            END IF
            IF k = "space" OR k = " " THEN
                m.Tree.ToggleExpand()
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM node AS POINTER TO TreeNode = m.Tree.CursorNode()
                IF node <> NIL THEN
                    IF node.Kind = NodeFolder OR (node.Kind = NodeForm AND LEN(node.Children) > 0) THEN
                        m.Tree.ToggleExpand()
                    ELSE
                        dispatchTreeOpen(@m, node)
                    END IF
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF m.Focus = FocusVisual THEN
            ' Arrow keys cycle widget selection forward / backward;
            ' Enter echoes selection info to the status bar; Space
            ' toggles the primary widget in/out of the selection set
            ' (keyboard fallback for terminals that eat modifier+click).
            IF k = "right" OR k = "down" THEN
                m.Visual.SelectNext()
                syncProperties(@m)
                RETURN m, NIL
            END IF
            IF k = "left" OR k = "up" THEN
                m.Visual.SelectPrev()
                syncProperties(@m)
                RETURN m, NIL
            END IF
            IF k = "space" OR k = " " THEN
                IF m.Visual.Selected >= 0 AND m.Visual.Selected < LEN(m.Visual.Widgets) THEN
                    m.Visual.ToggleSelection(m.Visual.Selected)
                    m.StatusBar.Message = fmt.Sprintf("%d widgets selected", m.Visual.SelectionCount())
                END IF
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM sw AS Widget
                DIM swOk AS BOOLEAN
                sw, swOk = m.Visual.SelectedWidget()
                IF swOk THEN
                    m.StatusBar.Message = fmt.Sprintf("selected %s (%s) at (%d,%d) %dx%d", sw.Id, sw.Kind, sw.X, sw.Y, sw.W, sw.H)
                ELSE
                    m.StatusBar.Message = "no widget selected on " + m.Visual.FormName
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF m.Focus = FocusProperties THEN
            IF k = "up" THEN
                m.Properties.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.Properties.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "space" OR k = " " THEN
                DIM tname AS STRING
                DIM tnewVal AS BOOLEAN
                DIM tok AS BOOLEAN
                tname, tnewVal, tok = m.Properties.ToggleBool()
                IF tok THEN
                    IF m.Properties.HasWidget THEN pushUndo(@m)
                    DIM terr AS ERROR
                    IF m.Properties.HasWidget THEN
                        terr = applyWidgetEdit(@m, tname, tnewVal)
                    ELSE
                        terr = applyFormEdit(@m, tname, tnewVal)
                    END IF
                    IF terr <> NIL THEN
                        m.StatusBar.Message = tname + ": " + terr.Error()
                    ELSE
                        refreshPropertiesFromSource(@m)
                        IF tnewVal THEN
                            m.StatusBar.Message = "set " + tname + " = true"
                        ELSE
                            m.StatusBar.Message = "set " + tname + " = false"
                        END IF
                    END IF
                END IF
                RETURN m, NIL
            END IF
            IF k = "left" OR k = "right" THEN
                DIM cdir AS INTEGER = 1
                IF k = "left" THEN cdir = -1
                DIM cname AS STRING
                DIM cnew AS STRING
                DIM cok AS BOOLEAN
                cname, cnew, cok = m.Properties.CycleEnum(cdir)
                IF cok THEN
                    IF m.Properties.HasWidget THEN pushUndo(@m)
                    DIM cerr AS ERROR
                    IF m.Properties.HasWidget THEN
                        cerr = applyWidgetEdit(@m, cname, cnew)
                    ELSE
                        cerr = applyFormEdit(@m, cname, cnew)
                    END IF
                    IF cerr <> NIL THEN
                        m.StatusBar.Message = cname + ": " + cerr.Error()
                    ELSE
                        refreshPropertiesFromSource(@m)
                        m.StatusBar.Message = "set " + cname + " = " + cnew
                    END IF
                END IF
                RETURN m, NIL
            END IF
            IF k = "enter" THEN
                DIM crow AS PropRow
                DIM crowOk AS BOOLEAN
                crow, crowOk = m.Properties.CurrentRow()
                IF crowOk AND crow.Category = "" AND NOT crow.Editable THEN
                    m.StatusBar.Message = crow.Name + ": read-only"
                    RETURN m, NIL
                END IF
                IF m.Properties.BeginEdit() THEN
                    m.Mode = ModePropEdit
                    m.StatusBar.Message = "Editing " + crow.Name + " — Enter: commit  Esc: cancel"
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF m.Focus = FocusWidgets THEN
            IF k = "up" THEN
                m.Palette.CursorUp()
                RETURN m, NIL
            END IF
            IF k = "down" THEN
                m.Palette.CursorDown()
                RETURN m, NIL
            END IF
            IF k = "tab" OR k = "left" OR k = "right" THEN
                ' Swap between Widgets/Tools tabs in addition to Tab's
                ' normal focus cycle.
                IF k = "left" OR k = "right" THEN
                    setPaletteTab(@m, 1 - m.PaletteTab)
                    RETURN m, NIL
                END IF
            END IF
            IF k = "enter" THEN
                IF m.Palette.Cursor >= 0 AND m.Palette.Cursor < LEN(m.Palette.Lines) THEN
                    DIM kind AS STRING = m.Palette.Lines[m.Palette.Cursor]
                    DIM kperr AS ERROR
                    IF m.PaletteTab = 1 THEN
                        kperr = placePaletteTool(@m)
                    ELSE
                        kperr = placePaletteWidget(@m)
                    END IF
                    IF kperr <> NIL THEN
                        m.StatusBar.Message = "place: " + kperr.Error()
                    ELSE
                        IF m.PaletteTab = 0 THEN refreshPropertiesFromSource(@m)
                        m.StatusBar.Message = "placed: " + kind
                    END IF
                END IF
                RETURN m, NIL
            END IF
        END IF
        IF k = "q" THEN
            RETURN m, tea.Quit
        END IF
    END IF

    RETURN m, NIL
END FUNCTION

FUNCTION (m AS Model) View() AS tea.View
    DIM body AS STRING = renderBody(m)
    DIM v AS tea.View = tea.NewView(body)
    v.AltScreen = TRUE
    v.MouseMode = tea.MouseModeAllMotion
    RETURN v
END FUNCTION

' ----------------------------------------------------------------------
' Rendering
' ----------------------------------------------------------------------

FUNCTION renderBody(m AS Model) AS STRING
    IF m.Width <= 0 OR m.Height <= 0 THEN
        ' First frame before WindowSizeMsg arrives.
        RETURN BgStyle().Render("DBtui — booting…")
    END IF

    DIM menuBar AS STRING = m.MenuBar.Render()
    DIM statusBar AS STRING = m.StatusBar.Render()

    DIM bodyH AS INTEGER = m.Height - 2
    IF bodyH < 1 THEN bodyH = 1

    ' Three-column layout: project tree | visual editor canvas |
    ' (palette stacked over properties) on the right.
    DIM leftPane AS STRING = m.Tree.Render()
    DIM paletteTabs AS STRING = renderPaletteTabs(m, m.RightW)
    DIM rightPane AS STRING = lipgloss.JoinVertical(lipgloss.Left, paletteTabs, m.Palette.Render(), m.Properties.Render())
    DIM canvasW AS INTEGER = m.Width - m.LeftW - m.RightW
    IF canvasW < 1 THEN canvasW = 1
    DIM captionText AS STRING
    DIM canvasBody AS STRING
    IF m.CodeMode THEN
        captionText = "Code Editor"
        IF m.CodePath <> "" THEN captionText = "Code Editor — " + m.CodePath
        DIM codeH AS INTEGER = m.CodeViewH
        IF codeH < 1 THEN codeH = 1
        DIM sR0 AS INTEGER
        DIM sC0 AS INTEGER
        DIM sR1 AS INTEGER
        DIM sC1 AS INTEGER
        sR0, sC0, sR1, sC1 = selBounds(@m)
        canvasBody = RenderCode(m.Editor.Value(), canvasW, codeH, m.Editor.Line(), m.Editor.Column(), TRUE, m.CodeScroll, m.SelActive, sR0, sC0, sR1, sC1)
    ELSE
        captionText = "Form Designer"
        IF m.Visual.FormName <> "" THEN captionText = "Form Designer — " + m.Visual.FormName
        canvasBody = m.Visual.Render()
    END IF
    DIM caption AS STRING = renderCanvasCaption(captionText, canvasW)
    DIM canvas AS STRING = lipgloss.JoinVertical(lipgloss.Left, caption, canvasBody)
    DIM bodyRow AS STRING = lipgloss.JoinHorizontal(lipgloss.Top, leftPane, canvas, rightPane)

    DIM fullScreen AS STRING
    IF m.BottomVisible THEN
        DIM bottomPane AS STRING = renderBottomPane(m)
        fullScreen = lipgloss.JoinVertical(lipgloss.Left, menuBar, bodyRow, bottomPane, statusBar)
    ELSE
        fullScreen = lipgloss.JoinVertical(lipgloss.Left, menuBar, bodyRow, statusBar)
    END IF

    ' Layer overlays on top: menu dropdown first (Z=1), modal dialog
    ' second (Z=2). Both go through lipgloss v2's Compositor so the
    ' underlying body content stays in place.
    DIM bgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(fullScreen)
    DIM hasOverlay AS BOOLEAN = FALSE
    DIM stack AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bgLayer)

    IF m.MenuBar.Open THEN
        DIM dropdown AS STRING = m.MenuBar.RenderDropdown()
        DIM xOff AS INTEGER = m.MenuBar.MenuXOffset(m.MenuBar.Active)
        DIM ddLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dropdown).X(xOff).Y(1).Z(1)
        stack = lipgloss.NewCompositor(bgLayer, ddLayer)
        hasOverlay = TRUE
    END IF

    IF m.DialogActive THEN
        DIM dlgStr AS STRING
        DIM dlgX AS INTEGER
        DIM dlgY AS INTEGER
        dlgStr, dlgX, dlgY = renderDialog(m)
        IF dlgStr <> "" THEN
            DIM dlgLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dlgStr).X(dlgX).Y(dlgY).Z(2)
            IF m.MenuBar.Open THEN
                ' Already composed with dropdown — rebuild with the dialog too.
                DIM dropdown2 AS STRING = m.MenuBar.RenderDropdown()
                DIM xOff2 AS INTEGER = m.MenuBar.MenuXOffset(m.MenuBar.Active)
                DIM ddLayer2 AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(dropdown2).X(xOff2).Y(1).Z(1)
                stack = lipgloss.NewCompositor(bgLayer, ddLayer2, dlgLayer)
            ELSE
                stack = lipgloss.NewCompositor(bgLayer, dlgLayer)
            END IF
            hasOverlay = TRUE
        END IF
    END IF

    ' Right-click widget context menu. Z=3 so it floats above the
    ' menu bar dropdown and any other overlay except autocomplete.
    IF m.CtxMenuActive THEN
        DIM ctxStr AS STRING = renderWidgetContextMenu(m)
        IF ctxStr <> "" THEN
            DIM ctxLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(ctxStr).X(m.CtxMenuX).Y(m.CtxMenuY).Z(3)
            IF hasOverlay THEN
                stack = stack.AddLayers(ctxLayer)
            ELSE
                stack = lipgloss.NewCompositor(bgLayer, ctxLayer)
            END IF
            hasOverlay = TRUE
        END IF
    END IF

    ' Code-editor autocomplete popup. Positioned just below the cursor,
    ' anchored against the gutter so the suggestions line up under the
    ' word being typed. Z=3 so it floats above menus + dialogs.
    IF m.CodeMode AND m.AutoActive AND LEN(m.AutoItems) > 0 THEN
        DIM acStr AS STRING = RenderAutocompletePopup(m.AutoItems, m.AutoIdx)
        IF acStr <> "" THEN
            ' Mirror RenderCode's gutter math: digits-of-total-lines + 2 cells.
            DIM totalLines AS INTEGER = LEN(strings.Split(m.Editor.Value(), "\n"))
            DIM acDigits AS INTEGER = LEN(fmt.Sprintf("%d", totalLines))
            IF acDigits < 2 THEN acDigits = 2
            DIM gutW AS INTEGER = acDigits + 2
            ' curCol of identifier start = column - prefix length.
            DIM startCol AS INTEGER = m.Editor.Column() - LEN(m.AutoPrefix)
            IF startCol < 0 THEN startCol = 0
            DIM acX AS INTEGER = m.LeftW + gutW + startCol
            DIM acY AS INTEGER = 2 + (m.Editor.Line() - m.CodeScroll) + 1
            DIM acLayer AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(acStr).X(acX).Y(acY).Z(3)
            IF hasOverlay THEN
                stack = stack.AddLayers(acLayer)
            ELSE
                stack = lipgloss.NewCompositor(bgLayer, acLayer)
            END IF
            hasOverlay = TRUE
        END IF
    END IF

    IF hasOverlay THEN RETURN stack.Render()
    RETURN fullScreen
END FUNCTION
