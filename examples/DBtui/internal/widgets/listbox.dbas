' DBtui — internal/widgets/listbox.dbas
'
' ListBox widget — scrollable list with single selection. Items are
' stored as a ";"-separated STRING; LstIdx is the currently-selected
' index (-1 = no selection). Renders as a bordered multi-line box;
' default height is 6 rows so a few items are visible.

FUNCTION NewListBox(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindListBox
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 24
    w.H = 6
    w.Style.BgColor = "#FFFFFF"
    w.Style.FgColor = "#000000"
    w.Style.Border = "normal"
    w.Style.Corner = "square"
    w.LstItems = "First;Second;Third"
    w.LstIdx = 0
    RETURN w
END FUNCTION

FUNCTION ListBoxProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Items", w.LstItems))
    out = APPEND(out, StringProp("Selected", fmt.Sprintf("%d", w.LstIdx)))
    DIM stylePs AS []Property = StyleProperties(w.Style, TRUE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetListBoxProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    IF name = "Items" THEN
        DIM s AS STRING
        DIM err AS ERROR
        s, err = coerceString(name, value)
        IF err <> NIL THEN RETURN err
        w.LstItems = s
        RETURN NIL
    END IF
    IF name = "Selected" THEN
        DIM iv AS INTEGER
        DIM ierr AS ERROR
        iv, ierr = coerceInt(name, value)
        IF ierr <> NIL THEN RETURN ierr
        w.LstIdx = iv
        RETURN NIL
    END IF
    RETURN NewError("unknown ListBox property: " + name)
END FUNCTION
