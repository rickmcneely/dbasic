' =========================================================================
' widgets/textinput.dbas — TextInput widget (per-kind module).
'
' A single-line text field. Runtime value lives in <Name>_Val (STRING).
' Typing appends; backspace trims. No mouse handler beyond focus.
'
' Dispatch points this module owns:
'   A  textInputDefault      — defaultWidget() defaults
'   B  textInputVisibleText  — single-line preview
'   E  textInputEmitModel    — Model field decl (_Val AS STRING)
'   F  textInputEmitKey      — Update() keyboard fragment
'   H  textInputEmitView     — View() paint fragment (sets body<sfx>)
'
' Stays inline in form.dbas: nothing kind-specific beyond the above (E's
' branch is the head of the Model IF/ELSEIF chain; the router keeps the IF
' and delegates the body).
' =========================================================================

' A — defaults: empty 16-wide field.
FUNCTION textInputDefault(w AS DesignWidget) AS DesignWidget
    w.Text = ""
    w.W = 16
    RETURN w
END FUNCTION

' B — single-line preview: the text padded to W-2 inside brackets.
FUNCTION textInputVisibleText(w AS DesignWidget) AS STRING
    DIM inner AS STRING = w.Text
    IF LEN(inner) < w.W - 2 THEN inner = inner + strings.Repeat(" ", w.W - 2 - LEN(inner))
    RETURN "[" + inner + "]"
END FUNCTION

' --- CHARM-BACKED (bubbles/textinput) -----------------------------------
' Runtime state is a real bubbles textinput.Model; the field is rendered as
' its .View() composed as a lipgloss layer, not painted into rows[].
' [[dbtui_charm_first]]

' E — Model field: the bubbles textinput component.
FUNCTION textInputEmitModel(w AS DesignWidget) AS STRING
    RETURN "    DIM " + w.Name + "_ti AS textinput.Model\n"
END FUNCTION

' Init (Main seed): construct the component, size it to the widget box, seed
' the design Text. Prompt cleared so it reads as a plain field (no "> ").
FUNCTION textInputEmitInit(w AS DesignWidget, qt AS STRING) AS STRING
    DIM wInner AS INTEGER = w.W - 1
    IF wInner < 1 THEN wInner = 1
    DIM s AS STRING = ""
    s = s + "    m." + w.Name + "_ti = textinput.New()\n"
    s = s + "    m." + w.Name + "_ti.Prompt = " + qt + qt + "\n"
    s = s + "    m." + w.Name + "_ti.SetWidth(" + strconv.Itoa(wInner) + ")\n"
    IF w.Text <> "" THEN s = s + "    m." + w.Name + "_ti.SetValue(" + qt + escapeForDBString(w.Text) + qt + ")\n"
    RETURN s
END FUNCTION

' F — keyboard: forward the message to the component; return its cmd. The
' router skips its own trailing RETURN for ported kinds.
FUNCTION textInputEmitKey(ww AS DesignWidget, sfx AS STRING, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    s = s + "            DIM tiCmd" + sfx + " AS tea.Cmd\n"
    s = s + "            m." + ww.Name + "_ti, tiCmd" + sfx + " = m." + ww.Name + "_ti.Update(msg)\n"
    s = s + "            RETURN m, tiCmd" + sfx + "\n"
    RETURN s
END FUNCTION

' Layer view: append code building this widget's component view + a lipgloss
' layer placed at its (X,Y). `zStr` is the Z-order; layer var is _ly<sfx>.
FUNCTION textInputEmitLayer(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, zStr AS STRING, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    s = s + "    DIM vw" + sfx + " AS STRING = m." + wv.Name + "_ti.View()\n"
    s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
    RETURN s
END FUNCTION
