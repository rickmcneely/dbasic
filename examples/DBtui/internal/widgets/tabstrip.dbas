' =========================================================================
' widgets/tabstrip.dbas — TabStrip widget (per-kind module).
'
' A TabStrip is a row of tabs over a content area. The active tab index is
' tracked at runtime in <Name>_Val (an INTEGER Model field — declared by the
' shared multi-kind Model group, which stays in form.dbas). Left/Right keys
' and tab-row clicks change the active tab and fire _Change.
'
' This is the pilot's complex case — it exercises every emitter shape:
' multi-row design render (C), and all three codegen emitters (mouse, key,
' View paint). It calls the shared helper tabStripBar() (kept in form.dbas).
'
' Dispatch points this module owns:
'   A  tabStripDefault      — defaultWidget() defaults
'   B  tabStripVisibleText  — single-line preview (just the tab bar)
'   C  tabStripVisibleLines — multi-row design render (bar + rule + content)
'   G  tabStripEmitMouse    — Update() mouse-click fragment
'   F  tabStripEmitKey      — Update() keyboard fragment
'   H  tabStripEmitView     — View() paint fragment
'
' Stays inline in form.dbas (shared with other kinds — can't extract without
' touching them): the Model _Val decl, the property rows (D, cursor-machine),
' dispatchChange membership, and the _Change user-stub.
' =========================================================================

' A — defaults: three sample tabs, active = first.
FUNCTION tabStripDefault(w AS DesignWidget) AS DesignWidget
    w.Text = "TabStrip"
    w.W    = 34
    w.H    = 6
    DIM tstabs AS []STRING
    tstabs = APPEND(tstabs, "General")
    tstabs = APPEND(tstabs, "Advanced")
    tstabs = APPEND(tstabs, "About")
    w.Items    = tstabs
    w.Selected = 0
    RETURN w
END FUNCTION

' B — single-line preview: just the tab row (widgetVisibleLines paints the
' rule + content rows below it).
FUNCTION tabStripVisibleText(w AS DesignWidget) AS STRING
    RETURN tabStripBar(w.Items, w.Selected, w.W)
END FUNCTION

' C — multi-row design render. Row 0: tab bar. Row 1: horizontal rule.
' Rows 2..H-1: the active tab's content placeholder (the generated program
' shows the active label; real page content is the user's to add).
FUNCTION tabStripVisibleLines(w AS DesignWidget) AS []STRING
    DIM lines AS []STRING
    DIM th AS INTEGER = w.H
    IF th < 3 THEN th = 3
    lines = APPEND(lines, tabStripBar(w.Items, w.Selected, w.W))
    lines = APPEND(lines, strings.Repeat("─", w.W))
    DIM activeLbl AS STRING = ""
    IF w.Selected >= 0 AND w.Selected < LEN(w.Items) THEN activeLbl = w.Items[w.Selected]
    DIM tj AS INTEGER
    FOR tj = 2 TO th - 1
        IF tj = 2 THEN
            DIM crow AS STRING = " " + activeLbl + " tab"
            IF lipgloss.Width(crow) < w.W THEN crow = crow + strings.Repeat(" ", w.W - lipgloss.Width(crow))
            lines = APPEND(lines, crow)
        ELSE
            lines = APPEND(lines, strings.Repeat(" ", w.W))
        END IF
    NEXT tj
    RETURN lines
END FUNCTION

' G — mouse: only the tab row (relative Y = 0) is clickable; the click
' column is mapped to a tab via the static label widths (" label " =
' width+2, "│" separators add 1). Selecting a new tab fires _Change.
' Caller supplies the widget, its index string, and the emitted x/y origin
' expressions, plus the quote char.
FUNCTION tabStripEmitMouse(mcw AS DesignWidget, mcIStr AS STRING, mcXs AS STRING, mcYs AS STRING, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    s = s + "            DIM mcTsY" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
    s = s + "            DIM mcTsX" + mcIStr + " AS INTEGER = mc.X - " + mcXs + "\n"
    s = s + "            IF mcTsY" + mcIStr + " = 0 THEN\n"
    DIM mcTsCol AS INTEGER = 0
    DIM mcTsi AS INTEGER
    FOR mcTsi = 0 TO LEN(mcw.Items) - 1
        DIM mcTsCellW AS INTEGER = lipgloss.Width(mcw.Items[mcTsi]) + 2
        s = s + "                IF mcTsX" + mcIStr + " >= " + strconv.Itoa(mcTsCol) + " AND mcTsX" + mcIStr + " < " + strconv.Itoa(mcTsCol + mcTsCellW) + " THEN\n"
        s = s + "                    IF m." + mcw.Name + "_Val <> " + strconv.Itoa(mcTsi) + " THEN\n"
        s = s + "                        m." + mcw.Name + "_Val = " + strconv.Itoa(mcTsi) + "\n"
        s = s + "                        dispatchChange(" + qt + mcw.Name + qt + ")\n"
        s = s + "                    END IF\n"
        s = s + "                END IF\n"
        mcTsCol = mcTsCol + mcTsCellW
        IF mcTsi < LEN(mcw.Items) - 1 THEN mcTsCol = mcTsCol + 1
    NEXT mcTsi
    s = s + "            END IF\n"
    RETURN s
END FUNCTION

' F — keyboard: Left / Right move between tabs; each move fires _Change so
' user code can react to the new active page.
FUNCTION tabStripEmitKey(ww AS DesignWidget, qt AS STRING) AS STRING
    DIM nTabsStr AS STRING = strconv.Itoa(LEN(ww.Items))
    DIM s AS STRING = ""
    s = s + "            IF key = " + qt + "left" + qt + " THEN\n"
    s = s + "                IF m." + ww.Name + "_Val > 0 THEN\n"
    s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val - 1\n"
    s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    s = s + "            IF key = " + qt + "right" + qt + " THEN\n"
    s = s + "                IF m." + ww.Name + "_Val < " + nTabsStr + " - 1 THEN\n"
    s = s + "                    m." + ww.Name + "_Val = m." + ww.Name + "_Val + 1\n"
    s = s + "                    dispatchChange(" + qt + ww.Name + qt + ")\n"
    s = s + "                END IF\n"
    s = s + "            END IF\n"
    RETURN s
END FUNCTION

' H — View paint. Row 0: tab bar (active tab in [brackets], reading
' <name>_Val; a > marker when focused). Row 1: rule. Row 2: active-tab
' content placeholder. Plain text — no lipgloss dependency. Caller supplies
' the widget, its suffix, and the emitted x/y origin expressions + quote.
FUNCTION tabStripEmitView(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, qt AS STRING) AS STRING
    DIM tsWStr AS STRING = strconv.Itoa(wv.W)
    DIM s AS STRING = ""
    s = s + "    DIM tsItems" + sfx + " AS []STRING\n"
    DIM tsvI AS INTEGER
    FOR tsvI = 0 TO LEN(wv.Items) - 1
        s = s + "    tsItems" + sfx + " = APPEND(tsItems" + sfx + ", " + qt + escapeForDBString(wv.Items[tsvI]) + qt + ")\n"
    NEXT tsvI
    s = s + "    DIM tsBar" + sfx + " AS STRING = " + qt + qt + "\n"
    s = s + "    DIM tsk" + sfx + " AS INTEGER\n"
    s = s + "    FOR tsk" + sfx + " = 0 TO LEN(tsItems" + sfx + ") - 1\n"
    s = s + "        IF tsk" + sfx + " > 0 THEN tsBar" + sfx + " = tsBar" + sfx + " + " + qt + "│" + qt + "\n"
    s = s + "        IF tsk" + sfx + " = m." + wv.Name + "_Val THEN\n"
    s = s + "            tsBar" + sfx + " = tsBar" + sfx + " + " + qt + "[" + qt + " + tsItems" + sfx + "[tsk" + sfx + "] + " + qt + "]" + qt + "\n"
    s = s + "        ELSE\n"
    s = s + "            tsBar" + sfx + " = tsBar" + sfx + " + " + qt + " " + qt + " + tsItems" + sfx + "[tsk" + sfx + "] + " + qt + " " + qt + "\n"
    s = s + "        END IF\n"
    s = s + "    NEXT tsk" + sfx + "\n"
    s = s + "    IF m.Focus = " + sfx + " THEN\n"
    s = s + "        tsBar" + sfx + " = " + qt + ">" + qt + " + tsBar" + sfx + "\n"
    s = s + "    ELSE\n"
    s = s + "        tsBar" + sfx + " = " + qt + " " + qt + " + tsBar" + sfx + "\n"
    s = s + "    END IF\n"
    s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", tsBar" + sfx + ")\n"
    s = s + "    DIM tsRule" + sfx + " AS STRING = " + qt + " " + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + tsWStr + ")\n"
    s = s + "    DIM tsRuleY" + sfx + " AS INTEGER = " + ys + " + 1\n"
    s = s + "    IF tsRuleY" + sfx + " >= 0 AND tsRuleY" + sfx + " < LEN(rows) THEN rows[tsRuleY" + sfx + "] = overlayRow(rows[tsRuleY" + sfx + "], " + xs + ", tsRule" + sfx + ")\n"
    s = s + "    DIM tsAct" + sfx + " AS STRING = " + qt + qt + "\n"
    s = s + "    IF m." + wv.Name + "_Val >= 0 AND m." + wv.Name + "_Val < LEN(tsItems" + sfx + ") THEN tsAct" + sfx + " = tsItems" + sfx + "[m." + wv.Name + "_Val]\n"
    s = s + "    DIM tsContent" + sfx + " AS STRING = " + qt + " " + qt + " + tsAct" + sfx + " + " + qt + " tab" + qt + "\n"
    s = s + "    DIM tsContentY" + sfx + " AS INTEGER = " + ys + " + 2\n"
    s = s + "    IF tsContentY" + sfx + " >= 0 AND tsContentY" + sfx + " < LEN(rows) THEN rows[tsContentY" + sfx + "] = overlayRow(rows[tsContentY" + sfx + "], " + xs + ", tsContent" + sfx + ")\n"
    RETURN s
END FUNCTION
