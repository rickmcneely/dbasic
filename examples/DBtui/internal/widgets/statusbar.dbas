' DBtui — internal/widgets/statusbar.dbas
'
' StatusBar — bottom-of-form labeled segments. Segments stored in the
' shared LstItems field as ";"-separated "Label:Value" pairs. Example:
'
'   "Status:Ready;Line:1;Col:5;Mode:Insert"
'
' Renders inline as " Label: Value │ Label: Value │ ... " with vertical
' bar separators between segments. Not interactive (TabStop=FALSE);
' user code mutates the segments via the widget's runtime API.

FUNCTION NewStatusBarWidget(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindStatusBar
    w.Visible = TRUE
    w.TabStop = FALSE
    w.X = 0
    w.Y = 0
    w.W = 60
    w.H = 1
    w.Style.BgColor = "#16161e"
    w.Style.FgColor = "#a9b1d6"
    w.Style.Border = "none"
    w.Style.Corner = "square"
    w.LstItems = "Status:Ready;Line:1;Col:1;Mode:Insert"
    RETURN w
END FUNCTION

FUNCTION StatusBarProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Segments", w.LstItems))
    DIM stylePs AS []Property = StyleProperties(w.Style, FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetStatusBarProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    IF name = "Segments" THEN
        DIM s AS STRING
        DIM err AS ERROR
        s, err = coerceString(name, value)
        IF err <> NIL THEN RETURN err
        w.LstItems = s
        RETURN NIL
    END IF
    RETURN NewError("unknown StatusBar property: " + name)
END FUNCTION
