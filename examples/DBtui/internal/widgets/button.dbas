' DBtui — internal/widgets/button.dbas
'
' Button widget — kind-specific factory + property handlers.

FUNCTION NewButton(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindButton
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 12
    w.H = 3
    w.Style.BgColor = "#C0C0C0"
    w.Style.FgColor = "#000000"
    w.Style.BgHover = "#D0D0D0"
    w.Style.FgHover = "#000000"
    w.Style.Border = "normal"
    w.Style.Corner = "round"
    w.ButText = "Button"
    w.ButBgPress = "#808080"
    w.ButFgPress = "#FFFFFF"
    RETURN w
END FUNCTION

FUNCTION ButtonProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Text", w.ButText))
    DIM stylePs AS []Property = StyleProperties(w.Style, TRUE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    out = APPEND(out, ColorProp("BgPress", w.ButBgPress))
    out = APPEND(out, ColorProp("FgPress", w.ButFgPress))
    RETURN out
END FUNCTION

FUNCTION SetButtonProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    DIM str AS STRING
    DIM ok AS BOOLEAN
    str, ok = value.(STRING)
    IF name = "Text" THEN
        IF NOT ok THEN RETURN NewError("Text must be a string")
        w.ButText = str
        RETURN NIL
    END IF
    IF name = "BgPress" THEN
        IF ok THEN w.ButBgPress = str
        RETURN NIL
    END IF
    IF name = "FgPress" THEN
        IF ok THEN w.ButFgPress = str
        RETURN NIL
    END IF
    RETURN NewError("unknown Button property: " + name)
END FUNCTION
