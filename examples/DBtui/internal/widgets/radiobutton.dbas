' DBtui — internal/widgets/radiobutton.dbas
'
' RadioButton — single selection within a Group. At design/runtime,
' radios sharing the same Group string are mutually exclusive: when
' one becomes Checked, the others in the same group are unchecked.
' Renders as "(•) Label" (selected) or "( ) Label" (not), borderless.

FUNCTION NewRadioButton(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindRadioButton
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 20
    w.H = 1
    w.Style.FgColor = "#e0def4"
    w.Style.Border = "none"
    w.Style.Corner = "square"
    w.RbText = "RadioButton"
    w.RbChecked = FALSE
    w.RbGroup = "default"
    RETURN w
END FUNCTION

FUNCTION RadioButtonProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Text", w.RbText))
    out = APPEND(out, BoolProp("Checked", w.RbChecked))
    out = APPEND(out, StringProp("Group", w.RbGroup))
    DIM stylePs AS []Property = StyleProperties(w.Style, FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetRadioButtonProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    IF name = "Text" THEN
        DIM s AS STRING
        DIM err AS ERROR
        s, err = coerceString(name, value)
        IF err <> NIL THEN RETURN err
        w.RbText = s
        RETURN NIL
    END IF
    IF name = "Checked" THEN
        DIM b AS BOOLEAN
        DIM berr AS ERROR
        b, berr = coerceBool(name, value)
        IF berr <> NIL THEN RETURN berr
        w.RbChecked = b
        RETURN NIL
    END IF
    IF name = "Group" THEN
        DIM g AS STRING
        DIM gerr AS ERROR
        g, gerr = coerceString(name, value)
        IF gerr <> NIL THEN RETURN gerr
        w.RbGroup = g
        RETURN NIL
    END IF
    RETURN NewError("unknown RadioButton property: " + name)
END FUNCTION
