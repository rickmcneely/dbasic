' =========================================================================
' widgets/scrollpanel.dbas — ScrollPanel (scrollable content viewport).
'
' Code extracted verbatim from internal/form.dbas during the per-widget
' refactor (behaviour-preserving; see [[dbtui_widget_refactor]]).
'
' A framed viewport over Items (content lines) with an embedded vertical
' scrollbar column. Top visible line tracked in <Name>_Scroll (INTEGER).
' Passive (no _Change). Up/Down keys or ▲/▼ end-cell clicks scroll. Uses
' shared overlayRow/escapeForDBString.
'
' Owns: A default, B visibleText, C visibleLines, E Model (_Scroll),
' G mouse, F keyboard, H View. NOTE: the emitter bodies below are copied
' byte-for-byte from the inline originals — including a couple of dead/odd
' codegen-time locals — so generated output stays identical.
' =========================================================================

' A — defaults: a 28x8 box with 12 content lines.
FUNCTION scrollPanelDefault(w AS DesignWidget) AS DesignWidget
    w.Text = "ScrollPanel"
    w.W    = 28
    w.H    = 8
    DIM splines AS []STRING
    DIM spk AS INTEGER
    FOR spk = 1 TO 12
        splines = APPEND(splines, "Content line " + strconv.Itoa(spk))
    NEXT spk
    w.Items = splines
    RETURN w
END FUNCTION

' B — single-line preview: a top-border proxy.
FUNCTION scrollPanelVisibleText(w AS DesignWidget) AS STRING
    RETURN "┌" + strings.Repeat("─", w.W - 2) + "┐"
END FUNCTION

' C — multi-row design render: framed box, H-2 content rows + scrollbar
' column, thumb parked at the top (scroll = 0).
FUNCTION scrollPanelVisibleLines(w AS DesignWidget) AS []STRING
    IF widgetFramed(w) THEN
        DIM sbody AS []STRING
        DIM sbi AS INTEGER
        FOR sbi = 0 TO w.H - 3
            DIM sbl AS STRING = ""
            IF sbi < LEN(w.Items) THEN sbl = w.Items[sbi]
            sbody = APPEND(sbody, sbl)
        NEXT sbi
        RETURN designFrame(w, sbody)
    END IF
    DIM lines AS []STRING
    DIM spw AS INTEGER = w.W
    IF spw < 4 THEN spw = 4
    DIM sph AS INTEGER = w.H
    IF sph < 3 THEN sph = 3
    DIM spVisible AS INTEGER = sph - 2
    DIM spContentW AS INTEGER = spw - 3
    IF spContentW < 1 THEN spContentW = 1
    DIM spi AS INTEGER
    FOR spi = 0 TO spVisible - 1
        DIM spLine AS STRING = ""
        IF spi < LEN(w.Items) THEN spLine = w.Items[spi]
        IF lipgloss.Width(spLine) > spContentW THEN spLine = Mid(spLine, 1, spContentW)
        IF lipgloss.Width(spLine) < spContentW THEN spLine = spLine + strings.Repeat(" ", spContentW - lipgloss.Width(spLine))
        DIM spbar AS STRING = "░"
        IF spi = 0 THEN spbar = "▲"
        IF spi = spVisible - 1 THEN spbar = "▼"
        lines = APPEND(lines, "│" + spLine + spbar + "│")
    NEXT spi
    RETURN lines
END FUNCTION

' E — Model field: top visible content line.
FUNCTION scrollPanelEmitModel(w AS DesignWidget) AS STRING
    RETURN "    DIM " + w.Name + "_Scroll AS INTEGER\n"
END FUNCTION

' Framed layer: wrap the viewport's content in a border + caption, with an
' optional vertical scrollbar gutter (thumb tracks the viewport's YOffset).
' Used instead of the bare component layer when widgetFramed(wv) is true.
FUNCTION scrollPanelEmitFramedLayer(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, zStr AS STRING, qt AS STRING) AS STRING
    DIM nm AS STRING = wv.Name
    DIM innerH AS INTEGER = framedContentH(wv)
    DIM contentW AS INTEGER = framedContentW(wv)
    DIM showV AS BOOLEAN = widgetReserveVGutter(wv)
    DIM showH AS BOOLEAN = widgetReserveHGutter(wv)
    DIM total AS STRING = strconv.Itoa(LEN(wv.Items))
    DIM cwS AS STRING = strconv.Itoa(contentW)
    DIM vhS AS STRING = strconv.Itoa(innerH)
    DIM s AS STRING = ""
    s = s + "    DIM spv" + sfx + " AS STRING = m." + nm + "_vp.View()\n"
    s = s + "    DIM spl" + sfx + " AS []STRING = strings.Split(spv" + sfx + ", " + qt + "\\n" + qt + ")\n"
    s = s + "    DIM spfin" + sfx + " AS []STRING\n"
    s = s + "    DIM spr" + sfx + " AS INTEGER\n"
    s = s + "    FOR spr" + sfx + " = 0 TO " + vhS + " - 1\n"
    s = s + "        DIM spc" + sfx + " AS STRING = " + qt + qt + "\n"
    s = s + "        IF spr" + sfx + " < LEN(spl" + sfx + ") THEN spc" + sfx + " = spl" + sfx + "[spr" + sfx + "]\n"
    s = s + "        IF lipgloss.Width(spc" + sfx + ") > " + cwS + " THEN spc" + sfx + " = Mid(spc" + sfx + ", 1, " + cwS + ")\n"
    s = s + "        IF lipgloss.Width(spc" + sfx + ") < " + cwS + " THEN spc" + sfx + " = spc" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + cwS + " - lipgloss.Width(spc" + sfx + "))\n"
    IF showV THEN
        s = s + "        spc" + sfx + " = spc" + sfx + " + _vgutter(spr" + sfx + ", " + vhS + ", m." + nm + "_vp.YOffset(), " + total + ")\n"
    END IF
    s = s + "        spfin" + sfx + " = APPEND(spfin" + sfx + ", spc" + sfx + ")\n"
    s = s + "    NEXT spr" + sfx + "\n"
    IF showH THEN
        DIM tm1 AS INTEGER = contentW - 3
        IF tm1 < 0 THEN tm1 = 0
        s = s + "    DIM sphth" + sfx + " AS INTEGER = Int(m." + nm + "_vp.HorizontalScrollPercent() * " + strconv.Itoa(tm1) + ".0)\n"
        s = s + "    spfin" + sfx + " = APPEND(spfin" + sfx + ", _hbar(" + cwS + ", sphth" + sfx + "))\n"
    END IF
    s = s + "    DIM vw" + sfx + " AS STRING = _frame(spfin" + sfx + ", " + strconv.Itoa(wv.W - 2) + ", " + frameCallArgs(wv, qt) + ")\n"
    s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
    RETURN s
END FUNCTION

' Framed-gutter clicks: scroll the viewport when the user clicks the v-gutter
' (▲/▼/track on the right column) or h-gutter (◀/▶/track on the bottom row).
' Emitted inside the click dispatch for a framed ScrollPanel (the bare/unframed
' one has no gutter). Coords are relative to the widget's (X, Y).
FUNCTION scrollPanelEmitGutterClick(wv AS DesignWidget, xs AS STRING, ys AS STRING, qt AS STRING) AS STRING
    DIM nm AS STRING = wv.Name
    DIM showV AS BOOLEAN = widgetReserveVGutter(wv)
    DIM showH AS BOOLEAN = widgetReserveHGutter(wv)
    DIM s AS STRING = ""
    IF showV THEN
        DIM vcol AS INTEGER = wv.W - 2
        DIM vlast AS INTEGER = framedContentH(wv)
        DIM maxY AS INTEGER = LEN(wv.Items) - vlast
        IF maxY < 0 THEN maxY = 0
        DIM vspan AS INTEGER = vlast - 3
        IF vspan < 1 THEN vspan = 1
        ' ▲ / ▼ step by one; clicking the track jumps the thumb to that
        ' position (SetYOffset proportional), so repeated/positional clicks
        ' behave predictably and small overflows aren't slammed to the end.
        s = s + "            IF mc.X - " + xs + " = " + strconv.Itoa(vcol) + " AND mc.Y - " + ys + " >= 1 AND mc.Y - " + ys + " <= " + strconv.Itoa(vlast) + " THEN\n"
        s = s + "                IF mc.Y - " + ys + " = 1 THEN\n"
        s = s + "                    m." + nm + "_vp.ScrollUp(1)\n"
        s = s + "                ELSEIF mc.Y - " + ys + " = " + strconv.Itoa(vlast) + " THEN\n"
        s = s + "                    m." + nm + "_vp.ScrollDown(1)\n"
        s = s + "                ELSE\n"
        s = s + "                    m." + nm + "_vp.SetYOffset(((mc.Y - " + ys + " - 2) * " + strconv.Itoa(maxY) + ") / " + strconv.Itoa(vspan) + ")\n"
        s = s + "                END IF\n"
        s = s + "                RETURN m, NIL\n"
        s = s + "            END IF\n"
    END IF
    IF showH THEN
        DIM hrow AS INTEGER = wv.H - 2
        DIM hlast AS INTEGER = framedContentW(wv)
        DIM maxX AS INTEGER = widgetMaxLineW(wv) - hlast
        IF maxX < 0 THEN maxX = 0
        DIM hspan AS INTEGER = hlast - 3
        IF hspan < 1 THEN hspan = 1
        s = s + "            IF mc.Y - " + ys + " = " + strconv.Itoa(hrow) + " AND mc.X - " + xs + " >= 1 AND mc.X - " + xs + " <= " + strconv.Itoa(hlast) + " THEN\n"
        s = s + "                IF mc.X - " + xs + " = 1 THEN\n"
        s = s + "                    m." + nm + "_vp.ScrollLeft(1)\n"
        s = s + "                ELSEIF mc.X - " + xs + " = " + strconv.Itoa(hlast) + " THEN\n"
        s = s + "                    m." + nm + "_vp.ScrollRight(1)\n"
        s = s + "                ELSE\n"
        s = s + "                    m." + nm + "_vp.SetXOffset(((mc.X - " + xs + " - 2) * " + strconv.Itoa(maxX) + ") / " + strconv.Itoa(hspan) + ")\n"
        s = s + "                END IF\n"
        s = s + "                RETURN m, NIL\n"
        s = s + "            END IF\n"
    END IF
    RETURN s
END FUNCTION

' G — mouse: click the top cell (rel Y = 1) scrolls up, the bottom cell
' (rel Y = H-2) scrolls down (the ▲ / ▼ scrollbar ends).
FUNCTION scrollPanelEmitMouse(mcw AS DesignWidget, mcIStr AS STRING, mcYs AS STRING, qt AS STRING) AS STRING
    DIM spMaxStr AS STRING = strconv.Itoa(LEN(mcw.Items))
    DIM spVisStr AS STRING = strconv.Itoa(mcw.H - 2)
    DIM s AS STRING = ""
    s = s + "            DIM spRel" + mcIStr + " AS INTEGER = mc.Y - " + mcYs + "\n"
    s = s + "            IF spRel" + mcIStr + " = 1 AND m." + mcw.Name + "_Scroll > 0 THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll - 1\n"
    s = s + "            IF spRel" + mcIStr + " = " + strconv.Itoa(mcw.H - 2) + " AND m." + mcw.Name + "_Scroll < " + spMaxStr + " - " + spVisStr + " THEN m." + mcw.Name + "_Scroll = m." + mcw.Name + "_Scroll + 1\n"
    RETURN s
END FUNCTION

' F — keyboard: Up/Down scroll the viewport by a line; clamp to the content
' height minus the visible rows.
FUNCTION scrollPanelEmitKey(ww AS DesignWidget, qt AS STRING) AS STRING
    DIM spVis AS INTEGER = ww.H - 2
    DIM spMaxScroll AS INTEGER = LEN(ww.Items) - spVis
    IF spMaxScroll < 0 THEN spMaxScroll = 0
    DIM s AS STRING = ""
    s = s + "            IF key = " + qt + "up" + qt + " AND m." + ww.Name + "_Scroll > 0 THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll - 1\n"
    s = s + "            IF key = " + qt + "down" + qt + " AND m." + ww.Name + "_Scroll < " + strconv.Itoa(spMaxScroll) + " THEN m." + ww.Name + "_Scroll = m." + ww.Name + "_Scroll + 1\n"
    _ = spVis
    RETURN s
END FUNCTION

' H — View paint: framed scroll viewport; top border, H-2 content rows (each
' a content line + scrollbar cell), bottom border; thumb tracks _Scroll.
FUNCTION scrollPanelEmitView(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, qt AS STRING) AS STRING
    DIM spCWStr AS STRING = strconv.Itoa(wv.W - 3)
    IF wv.W - 3 < 1 THEN spCWStr = "1"
    DIM spVisStr2 AS STRING = strconv.Itoa(wv.H - 2)
    DIM spMaxStr2 AS STRING = strconv.Itoa(LEN(wv.Items) - (wv.H - 2))
    IF LEN(wv.Items) - (wv.H - 2) < 0 THEN spMaxStr2 = "0"
    ' Divisor clamped to >=1: the thumb division is dead when max = 0 (the
    ' guard requires spMaxStr2 > 0), but Go rejects a literal "/ 0" as a
    ' constant division-by-zero even on the unreachable branch.
    DIM spDivStr2 AS STRING = strconv.Itoa(LEN(wv.Items) - (wv.H - 2))
    IF LEN(wv.Items) - (wv.H - 2) < 1 THEN spDivStr2 = "1"
    DIM spTrackStr AS STRING = strconv.Itoa((wv.H - 2) - 2)
    IF (wv.H - 2) - 2 < 1 THEN spTrackStr = "1"
    DIM s AS STRING = ""
    s = s + "    DIM spItems" + sfx + " AS []STRING\n"
    DIM spvI AS INTEGER
    FOR spvI = 0 TO LEN(wv.Items) - 1
        s = s + "    spItems" + sfx + " = APPEND(spItems" + sfx + ", " + qt + escapeForDBString(wv.Items[spvI]) + qt + ")\n"
    NEXT spvI
    s = s + "    DIM spTop" + sfx + " AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + spCWStr + " + 1) + " + qt + "┐" + qt + "\n"
    s = s + "    IF " + ys + " >= 0 AND " + ys + " < LEN(rows) THEN rows[" + ys + "] = overlayRow(rows[" + ys + "], " + xs + ", spTop" + sfx + ")\n"
    s = s + "    DIM spThumb" + sfx + " AS INTEGER = 0 - 1\n"
    s = s + "    IF " + spMaxStr2 + " > 0 AND " + spTrackStr + " > 0 THEN\n"
    s = s + "        spThumb" + sfx + " = (m." + wv.Name + "_Scroll * (" + spTrackStr + " - 1)) / " + spDivStr2 + "\n"
    s = s + "        IF spThumb" + sfx + " < 0 THEN spThumb" + sfx + " = 0\n"
    s = s + "        IF spThumb" + sfx + " > " + spTrackStr + " - 1 THEN spThumb" + sfx + " = " + spTrackStr + " - 1\n"
    s = s + "    END IF\n"
    s = s + "    DIM spRow" + sfx + " AS INTEGER\n"
    s = s + "    FOR spRow" + sfx + " = 0 TO " + spVisStr2 + " - 1\n"
    s = s + "        DIM spSrc" + sfx + " AS INTEGER = m." + wv.Name + "_Scroll + spRow" + sfx + "\n"
    s = s + "        DIM spcl" + sfx + " AS STRING = " + qt + qt + "\n"
    s = s + "        IF spSrc" + sfx + " < LEN(spItems" + sfx + ") THEN spcl" + sfx + " = spItems" + sfx + "[spSrc" + sfx + "]\n"
    s = s + "        IF lipgloss.Width(spcl" + sfx + ") > " + spCWStr + " THEN spcl" + sfx + " = Mid(spcl" + sfx + ", 1, " + spCWStr + ")\n"
    s = s + "        IF lipgloss.Width(spcl" + sfx + ") < " + spCWStr + " THEN spcl" + sfx + " = spcl" + sfx + " + strings.Repeat(" + qt + " " + qt + ", " + spCWStr + " - lipgloss.Width(spcl" + sfx + "))\n"
    s = s + "        DIM spsb" + sfx + " AS STRING = " + qt + "░" + qt + "\n"
    s = s + "        IF spRow" + sfx + " = 0 THEN spsb" + sfx + " = " + qt + "▲" + qt + "\n"
    s = s + "        IF spRow" + sfx + " = " + spVisStr2 + " - 1 THEN spsb" + sfx + " = " + qt + "▼" + qt + "\n"
    s = s + "        IF spRow" + sfx + " >= 1 AND spRow" + sfx + " <= " + spVisStr2 + " - 2 AND (spRow" + sfx + " - 1) = spThumb" + sfx + " THEN spsb" + sfx + " = " + qt + "█" + qt + "\n"
    s = s + "        DIM spLine" + sfx + " AS STRING = " + qt + "│" + qt + " + spcl" + sfx + " + spsb" + sfx + " + " + qt + "│" + qt + "\n"
    s = s + "        DIM spY" + sfx + " AS INTEGER = " + ys + " + 1 + spRow" + sfx + "\n"
    s = s + "        IF spY" + sfx + " >= 0 AND spY" + sfx + " < LEN(rows) THEN rows[spY" + sfx + "] = overlayRow(rows[spY" + sfx + "], " + xs + ", spLine" + sfx + ")\n"
    s = s + "    NEXT spRow" + sfx + "\n"
    s = s + "    DIM spBot" + sfx + " AS STRING = " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", " + spCWStr + " + 1) + " + qt + "┘" + qt + "\n"
    s = s + "    DIM spBotY" + sfx + " AS INTEGER = " + ys + " + " + strconv.Itoa(wv.H - 1) + "\n"
    s = s + "    IF spBotY" + sfx + " >= 0 AND spBotY" + sfx + " < LEN(rows) THEN rows[spBotY" + sfx + "] = overlayRow(rows[spBotY" + sfx + "], " + xs + ", spBot" + sfx + ")\n"
    RETURN s
END FUNCTION
