' DBtui — internal/widgets/label.dbas
'
' Label widget — static text, no border by default.

FUNCTION NewLabel(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindLabel
    w.Visible = TRUE
    w.TabStop = FALSE
    w.W = 20
    w.H = 1
    w.Style.FgColor = "#e0def4"
    w.Style.Border = "none"
    w.Style.Corner = "square"
    w.LblText = "Label"
    w.LblAlign = "left"
    RETURN w
END FUNCTION

FUNCTION LabelProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Text", w.LblText))
    DIM alignOpts AS []STRING
    alignOpts = APPEND(alignOpts, "left")
    alignOpts = APPEND(alignOpts, "center")
    alignOpts = APPEND(alignOpts, "right")
    out = APPEND(out, EnumProp("Align", w.LblAlign, alignOpts))
    DIM stylePs AS []Property = StyleProperties(w.Style, FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetLabelProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    DIM str AS STRING
    DIM ok AS BOOLEAN
    str, ok = value.(STRING)
    IF name = "Text" THEN
        IF NOT ok THEN RETURN NewError("Text must be a string")
        w.LblText = str
        RETURN NIL
    END IF
    IF name = "Align" THEN
        IF NOT ok THEN RETURN NewError("Align must be a string")
        w.LblAlign = str
        RETURN NIL
    END IF
    RETURN NewError("unknown Label property: " + name)
END FUNCTION
