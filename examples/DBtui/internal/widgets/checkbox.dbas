' DBtui — internal/widgets/checkbox.dbas
'
' Checkbox widget — toggleable bool with a label. Renders as
' "[x] Label" or "[ ] Label", no border by default. Default height
' is 1 row.

FUNCTION NewCheckbox(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindCheckbox
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 20
    w.H = 1
    w.Style.FgColor = "#e0def4"
    w.Style.Border = "none"
    w.Style.Corner = "square"
    w.ChkText = "Checkbox"
    w.ChkChecked = FALSE
    RETURN w
END FUNCTION

FUNCTION CheckboxProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Text", w.ChkText))
    out = APPEND(out, BoolProp("Checked", w.ChkChecked))
    DIM stylePs AS []Property = StyleProperties(w.Style, FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetCheckboxProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    IF name = "Text" THEN
        DIM s AS STRING
        DIM ok AS BOOLEAN
        s, ok = value.(STRING)
        IF NOT ok THEN RETURN NewError("Text must be a string")
        w.ChkText = s
        RETURN NIL
    END IF
    IF name = "Checked" THEN
        DIM b AS BOOLEAN
        DIM cErr AS ERROR
        b, cErr = coerceBool(name, value)
        IF cErr <> NIL THEN RETURN cErr
        w.ChkChecked = b
        RETURN NIL
    END IF
    RETURN NewError("unknown Checkbox property: " + name)
END FUNCTION
