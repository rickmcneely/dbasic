' =========================================================================
' widgets/menubar.dbas — Menubar (drop-down menu strip) widget.
'
' The menu tree is a structured []MenuNode on the widget (TYPE MenuNode in
' dbtui.dbas), edited via the visual Menu Editor. Each node carries its own
' Depth (0 = bar title, 1 = item, 2+ = submenu item); a node is a submenu
' parent when the node after it is deeper. This supports arbitrarily nested
' cascading submenus, per-item Checked / Disabled flags, separators, and a
' display-only Shortcut label.
'
' Runtime model: this generator emits a node TABLE per menubar plus a small
' set of GENERIC helper subs (emitted once via menubarEmitRuntime) that
' navigate / paint / hit-test the tree from an open-path slice:
'   <Name>_Active  active top-level title index
'   <Name>_Open    is a dropdown showing?
'   <Name>_Path    []INTEGER — highlighted child index per open level
' Choosing a leaf fires that node's <ItemName>_Click() handler (one stub
' per leaf, generated in generateUserStubs). The generic helpers live in
' the generated program as _MNode / _mn* and the per-widget node table as
' _mnNodes_<Name>().
'
' Owns: A default, B visibleText, E Model, F closed-state keyboard,
' G title-row mouse, H View title bar, the open-dropdown key/click priority
' emitters, the View dropdown post-pass, plus menubarEmitRuntime (the shared
' helper block) and menubarEmitNodeTable (the per-widget data table).
' =========================================================================

' mbNode / mbSep — terse constructors for the structured default below.
FUNCTION mbNode(caption AS STRING, name AS STRING, depth AS INTEGER, shortcut AS STRING) AS MenuNode
    DIM n AS MenuNode
    n.Caption  = caption
    n.Name     = name
    n.Depth    = depth
    n.Shortcut = shortcut
    RETURN n
END FUNCTION

FUNCTION mbSep(depth AS INTEGER) AS MenuNode
    DIM n AS MenuNode
    n.Depth = depth
    n.IsSep = TRUE
    RETURN n
END FUNCTION

' A — defaults: File / Edit / Help, demonstrating a submenu (File ▸ Recent),
' a separator, and shortcut-key labels so the widget is self-explanatory.
FUNCTION menubarDefault(w AS DesignWidget) AS DesignWidget
    w.Text = "Menubar"
    w.W    = 44
    w.H    = 1
    DIM nodes AS []MenuNode
    nodes = APPEND(nodes, mbNode("File", "mnuFile", 0, ""))
    nodes = APPEND(nodes, mbNode("New",  "mnuFileNew", 1, "Ctrl+N"))
    nodes = APPEND(nodes, mbNode("Open", "mnuFileOpen", 1, "Ctrl+O"))
    nodes = APPEND(nodes, mbNode("Recent", "mnuFileRecent", 1, ""))
    nodes = APPEND(nodes, mbNode("Project One", "mnuFileRecent1", 2, ""))
    nodes = APPEND(nodes, mbNode("Project Two", "mnuFileRecent2", 2, ""))
    nodes = APPEND(nodes, mbSep(1))
    nodes = APPEND(nodes, mbNode("Exit", "mnuFileExit", 1, "Ctrl+Q"))
    nodes = APPEND(nodes, mbNode("Edit", "mnuEdit", 0, ""))
    nodes = APPEND(nodes, mbNode("Cut",   "mnuEditCut", 1, "Ctrl+X"))
    nodes = APPEND(nodes, mbNode("Copy",  "mnuEditCopy", 1, "Ctrl+C"))
    nodes = APPEND(nodes, mbNode("Paste", "mnuEditPaste", 1, "Ctrl+V"))
    nodes = APPEND(nodes, mbNode("Help", "mnuHelp", 0, ""))
    nodes = APPEND(nodes, mbNode("About", "mnuHelpAbout", 1, ""))
    w.Menu = nodes
    RETURN w
END FUNCTION

' B — single-line preview: the title row.
FUNCTION menubarVisibleText(w AS DesignWidget) AS STRING
    RETURN menuTopTitles(w.Menu)
END FUNCTION

' E — Model fields: active top menu, open state, open-path highlight stack.
FUNCTION menubarEmitModel(w AS DesignWidget) AS STRING
    DIM s AS STRING = ""
    s = s + "    DIM " + w.Name + "_Active AS INTEGER\n"
    s = s + "    DIM " + w.Name + "_Open   AS BOOLEAN\n"
    s = s + "    DIM " + w.Name + "_Path   AS []INTEGER\n"
    RETURN s
END FUNCTION

' mbBool — emit a DBasic boolean literal.
FUNCTION mbBool(b AS BOOLEAN) AS STRING
    IF b THEN RETURN "TRUE"
    RETURN "FALSE"
END FUNCTION

' menubarEmitNodeTable — the per-widget data table: a FUNCTION returning the
' menu's []_MNode, rebuilt fresh each call (cheap; menus are small).
FUNCTION menubarEmitNodeTable(w AS DesignWidget, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    s = s + "FUNCTION _mnNodes_" + w.Name + "() AS []_MNode\n"
    s = s + "    DIM ns AS []_MNode\n"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(w.Menu) - 1
        DIM nd AS MenuNode = w.Menu[i]
        s = s + "    ns = APPEND(ns, _mkMN(" + qt + escapeForDBString(nd.Caption) + qt + ", " + qt + escapeForDBString(nd.Name) + qt + ", " + strconv.Itoa(nd.Depth) + ", " + qt + escapeForDBString(nd.Shortcut) + qt + ", " + mbBool(nd.Checked) + ", " + mbBool(nd.Disabled) + ", " + mbBool(nd.IsSep) + "))\n"
    NEXT i
    s = s + "    RETURN ns\n"
    s = s + "END FUNCTION\n"
    s = s + "\n"
    RETURN s
END FUNCTION

' menubarEmitDispatch — unrolled "IF chosen = name THEN name_Click()" chain
' over every selectable LEAF node (non-separator, non-submenu, named).
FUNCTION menubarEmitDispatch(w AS DesignWidget, chosenVar AS STRING, indent AS STRING, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(w.Menu) - 1
        IF NOT w.Menu[i].IsSep AND NOT menuIsSubmenu(w.Menu, i) AND w.Menu[i].Name <> "" THEN
            s = s + indent + "IF " + chosenVar + " = " + qt + escapeForDBString(w.Menu[i].Name) + qt + " THEN " + w.Menu[i].Name + "_Click()\n"
        END IF
    NEXT i
    RETURN s
END FUNCTION

' Priority key handling while a dropdown is open (modal). Emitted inside the
' Update key block's per-menubar FOR loop, BEFORE the closed-state handler.
' `kpdK` is the key string in the generated program.
FUNCTION menubarEmitKeyPriority(mbKW AS DesignWidget, qt AS STRING) AS STRING
    DIM nm AS STRING = mbKW.Name
    DIM s AS STRING = ""
    s = s + "        IF m." + nm + "_Open THEN\n"
    s = s + "            DIM mnA" + nm + " AS INTEGER\n"
    s = s + "            DIM mnO" + nm + " AS BOOLEAN\n"
    s = s + "            DIM mnP" + nm + " AS []INTEGER\n"
    s = s + "            DIM mnC" + nm + " AS STRING\n"
    s = s + "            mnA" + nm + ", mnO" + nm + ", mnP" + nm + ", mnC" + nm + " = _mnKey(_mnNodes_" + nm + "(), kpdK, m." + nm + "_Active, m." + nm + "_Open, m." + nm + "_Path)\n"
    s = s + "            m." + nm + "_Active = mnA" + nm + "\n"
    s = s + "            m." + nm + "_Open = mnO" + nm + "\n"
    s = s + "            m." + nm + "_Path = mnP" + nm + "\n"
    s = s + "            IF mnC" + nm + " <> " + qt + qt + " THEN\n"
    s = s + menubarEmitDispatch(mbKW, "mnC" + nm, "                ", qt)
    s = s + "            END IF\n"
    s = s + "            RETURN m, NIL\n"
    s = s + "        END IF\n"
    RETURN s
END FUNCTION

' Priority dropdown-item click (modal while open). Emitted inside the mouse
' handler's per-menubar FOR loop. Delegates to _mnClickHit against the box
' rects stashed by the View paint; only consumes the click when it lands
' inside an open box.
FUNCTION menubarEmitClickPriority(mbMW AS DesignWidget, qt AS STRING) AS STRING
    DIM nm AS STRING = mbMW.Name
    DIM s AS STRING = ""
    s = s + "        IF m." + nm + "_Open THEN\n"
    s = s + "            DIM mcA" + nm + " AS INTEGER\n"
    s = s + "            DIM mcO" + nm + " AS BOOLEAN\n"
    s = s + "            DIM mcP" + nm + " AS []INTEGER\n"
    s = s + "            DIM mcC" + nm + " AS STRING\n"
    s = s + "            DIM mcH" + nm + " AS BOOLEAN\n"
    s = s + "            mcA" + nm + ", mcO" + nm + ", mcP" + nm + ", mcC" + nm + ", mcH" + nm + " = _mnClickHit(_mnNodes_" + nm + "(), mc.X, mc.Y, m." + nm + "_Active, m." + nm + "_Open, m." + nm + "_Path)\n"
    s = s + "            IF mcH" + nm + " THEN\n"
    s = s + "                m." + nm + "_Active = mcA" + nm + "\n"
    s = s + "                m." + nm + "_Open = mcO" + nm + "\n"
    s = s + "                m." + nm + "_Path = mcP" + nm + "\n"
    s = s + "                IF mcC" + nm + " <> " + qt + qt + " THEN\n"
    s = s + menubarEmitDispatch(mbMW, "mcC" + nm, "                    ", qt)
    s = s + "                END IF\n"
    s = s + "                RETURN m, NIL\n"
    s = s + "            END IF\n"
    s = s + "        END IF\n"
    RETURN s
END FUNCTION

' G — title-row mouse: pick a top menu by column. Clicking the already-open
' active menu closes it; otherwise open it (seeding the highlight path).
' Columns are unrolled from the design-time titles.
FUNCTION menubarEmitMouse(mcw AS DesignWidget, mcIStr AS STRING, mcXs AS STRING, qt AS STRING) AS STRING
    DIM nm AS STRING = mcw.Name
    DIM s AS STRING = ""
    s = s + "            DIM mbTX" + mcIStr + " AS INTEGER = mc.X - " + mcXs + "\n"
    DIM col AS INTEGER = 0
    DIM k AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(mcw.Menu) - 1
        IF mcw.Menu[i].Depth = 0 AND NOT mcw.Menu[i].IsSep THEN
            DIM ww AS INTEGER = lipgloss.Width(mcw.Menu[i].Caption) + 2
            s = s + "            IF mbTX" + mcIStr + " >= " + strconv.Itoa(col) + " AND mbTX" + mcIStr + " < " + strconv.Itoa(col + ww) + " THEN\n"
            s = s + "                IF m." + nm + "_Open AND m." + nm + "_Active = " + strconv.Itoa(k) + " THEN\n"
            s = s + "                    m." + nm + "_Open = FALSE\n"
            s = s + "                ELSE\n"
            s = s + "                    m." + nm + "_Active = " + strconv.Itoa(k) + "\n"
            s = s + "                    m." + nm + "_Open = TRUE\n"
            s = s + "                    m." + nm + "_Path = _mnOpenPath(_mnNodes_" + nm + "(), " + strconv.Itoa(k) + ")\n"
            s = s + "                END IF\n"
            s = s + "            END IF\n"
            col = col + ww
            k = k + 1
        END IF
    NEXT i
    RETURN s
END FUNCTION

' F — closed-state keyboard: Left/Right move the active menu; Down/Enter/
' Space open it. (The open dropdown is handled by menubarEmitKeyPriority.)
FUNCTION menubarEmitKey(ww AS DesignWidget, qt AS STRING) AS STRING
    DIM nm AS STRING = ww.Name
    DIM topm1 AS STRING = strconv.Itoa(menuTopCount(ww.Menu) - 1)
    DIM s AS STRING = ""
    s = s + "            IF key = " + qt + "left" + qt + " AND m." + nm + "_Active > 0 THEN m." + nm + "_Active = m." + nm + "_Active - 1\n"
    s = s + "            IF key = " + qt + "right" + qt + " AND m." + nm + "_Active < " + topm1 + " THEN m." + nm + "_Active = m." + nm + "_Active + 1\n"
    s = s + "            IF key = " + qt + "down" + qt + " OR key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN\n"
    s = s + "                m." + nm + "_Open = TRUE\n"
    s = s + "                m." + nm + "_Path = _mnOpenPath(_mnNodes_" + nm + "(), m." + nm + "_Active)\n"
    s = s + "            END IF\n"
    RETURN s
END FUNCTION

' Layer view: the title bar as a lipgloss layer (active title bracketed when
' the bar is focused or a menu is open). Dropdowns are composited separately
' by menubarEmitDropdownPass over the fully-composited frame.
FUNCTION menubarEmitLayer(wv AS DesignWidget, sfx AS STRING, xs AS STRING, ys AS STRING, zStr AS STRING, qt AS STRING) AS STRING
    DIM nm AS STRING = wv.Name
    DIM s AS STRING = ""
    ' Hover highlight: m.Hover = this widget marks the bar hovered; m.HoverTab
    ' is which top title the mouse is over (set by the motion handler).
    s = s + "    DIM vw" + sfx + " AS STRING = _mnBarView(_mnNodes_" + nm + "(), m." + nm + "_Active, m." + nm + "_Open, m.Focus = " + sfx + ", m.Hover = " + sfx + ", m.HoverTab)\n"
    s = s + "    DIM ly" + sfx + " AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(vw" + sfx + ").X(" + xs + ").Y(" + ys + ").Z(" + zStr + ")\n"
    RETURN s
END FUNCTION

' menubarEmitHoverTab — emitted inside the View motion handler's m.HoverTab
' computation: when this Menubar is hovered, set m.HoverTab to the top-level
' title under the cursor (each title spans width(cap)+2 columns, no gap).
FUNCTION menubarEmitHoverTab(wv AS DesignWidget, iStr AS STRING, qt AS STRING) AS STRING
    DIM s AS STRING = ""
    s = s + "        IF mmHit = " + iStr + " THEN\n"
    s = s + "            DIM mhCol" + iStr + " AS INTEGER = mm.X - " + strconv.Itoa(wv.X) + "\n"
    DIM col AS INTEGER = 0
    DIM vk AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(wv.Menu) - 1
        IF wv.Menu[i].Depth = 0 AND NOT wv.Menu[i].IsSep THEN
            DIM w AS INTEGER = lipgloss.Width(wv.Menu[i].Caption) + 2
            s = s + "            IF mhCol" + iStr + " >= " + strconv.Itoa(col) + " AND mhCol" + iStr + " < " + strconv.Itoa(col + w) + " THEN m.HoverTab = " + strconv.Itoa(vk) + "\n"
            col = col + w
            vk = vk + 1
        END IF
    NEXT i
    s = s + "        END IF\n"
    RETURN s
END FUNCTION

' View post-pass: composite the open cascading dropdown boxes over `full`
' (after all widget layers) and stash their rects for the click hit-test.
FUNCTION menubarEmitDropdownPass(mbPW AS DesignWidget, mbPI AS INTEGER, qt AS STRING) AS STRING
    DIM nm AS STRING = mbPW.Name
    DIM s AS STRING = ""
    s = s + "    IF m." + nm + "_Open THEN fullView = _mnComposeBoxes(fullView, _mnNodes_" + nm + "(), " + strconv.Itoa(mbPW.X) + ", " + strconv.Itoa(mbPW.Y) + ", m." + nm + "_Active, m." + nm + "_Path)\n"
    RETURN s
END FUNCTION

' menubarEmitRuntime — the GENERIC menu runtime, emitted once per form when
' it contains any Menubar. Defines the _MNode type, the package-level box
' hit-test stash, a faint style for disabled items, and the _mn* helpers
' shared by every menubar's navigation / painting / click code.
FUNCTION menubarEmitRuntime(qt AS STRING) AS STRING
    DIM s AS STRING = ""

    ' --- node type + constructor ---
    s = s + "TYPE _MNode\n"
    s = s + "    DIM Cap AS STRING\n"
    s = s + "    DIM Nm  AS STRING\n"
    s = s + "    DIM Dp  AS INTEGER\n"
    s = s + "    DIM Sc  AS STRING\n"
    s = s + "    DIM Ck  AS BOOLEAN\n"
    s = s + "    DIM Ds  AS BOOLEAN\n"
    s = s + "    DIM Sp  AS BOOLEAN\n"
    s = s + "END TYPE\n\n"

    s = s + "FUNCTION _mkMN(cap AS STRING, nm AS STRING, dp AS INTEGER, sc AS STRING, ck AS BOOLEAN, ds AS BOOLEAN, sp AS BOOLEAN) AS _MNode\n"
    s = s + "    DIM n AS _MNode\n"
    s = s + "    n.Cap = cap\n"
    s = s + "    n.Nm = nm\n"
    s = s + "    n.Dp = dp\n"
    s = s + "    n.Sc = sc\n"
    s = s + "    n.Ck = ck\n"
    s = s + "    n.Ds = ds\n"
    s = s + "    n.Sp = sp\n"
    s = s + "    RETURN n\n"
    s = s + "END FUNCTION\n\n"

    ' --- package-level dropdown box stash (one entry per open level) ---
    s = s + "DIM _mnBX AS []INTEGER\n"
    s = s + "DIM _mnBY AS []INTEGER\n"
    s = s + "DIM _mnBW AS []INTEGER\n"
    s = s + "DIM _mnBP AS []INTEGER\n"
    s = s + "DIM _mnDim AS lipgloss.Style = lipgloss.NewStyle().Faint(TRUE)\n\n"

    ' --- _mnKids: direct children of parentIdx (<0 → top-level) ---
    s = s + "FUNCTION _mnKids(nodes AS []_MNode, parentIdx AS INTEGER) AS []INTEGER\n"
    s = s + "    DIM out AS []INTEGER\n"
    s = s + "    IF parentIdx < 0 THEN\n"
    s = s + "        DIM t AS INTEGER\n"
    s = s + "        FOR t = 0 TO LEN(nodes) - 1\n"
    s = s + "            IF nodes[t].Dp = 0 THEN out = APPEND(out, t)\n"
    s = s + "        NEXT t\n"
    s = s + "        RETURN out\n"
    s = s + "    END IF\n"
    s = s + "    IF parentIdx >= LEN(nodes) THEN RETURN out\n"
    s = s + "    DIM pd AS INTEGER = nodes[parentIdx].Dp\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = parentIdx + 1 TO LEN(nodes) - 1\n"
    s = s + "        IF nodes[i].Dp <= pd THEN RETURN out\n"
    s = s + "        IF nodes[i].Dp = pd + 1 THEN out = APPEND(out, i)\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN out\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnIsSub: does the node at idx open a submenu? ---
    s = s + "FUNCTION _mnIsSub(nodes AS []_MNode, idx AS INTEGER) AS BOOLEAN\n"
    s = s + "    IF idx < 0 OR idx + 1 >= LEN(nodes) THEN RETURN FALSE\n"
    s = s + "    RETURN nodes[idx + 1].Dp > nodes[idx].Dp\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnTopCount ---
    s = s + "FUNCTION _mnTopCount(nodes AS []_MNode) AS INTEGER\n"
    s = s + "    DIM c AS INTEGER = 0\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(nodes) - 1\n"
    s = s + "        IF nodes[i].Dp = 0 THEN c = c + 1\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN c\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnColAt: x offset of the k-th top title within the bar ---
    s = s + "FUNCTION _mnColAt(nodes AS []_MNode, k AS INTEGER) AS INTEGER\n"
    s = s + "    DIM col AS INTEGER = 0\n"
    s = s + "    DIM c AS INTEGER = 0\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(nodes) - 1\n"
    s = s + "        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN\n"
    s = s + "            IF c = k THEN RETURN col\n"
    s = s + "            col = col + lipgloss.Width(nodes[i].Cap) + 2\n"
    s = s + "            c = c + 1\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN col\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnNodeAt: node reached by following path[0..depth-1] from `active` ---
    s = s + "FUNCTION _mnNodeAt(nodes AS []_MNode, active AS INTEGER, path AS []INTEGER, depth AS INTEGER) AS INTEGER\n"
    s = s + "    DIM tops AS []INTEGER = _mnKids(nodes, 0 - 1)\n"
    s = s + "    IF active < 0 OR active >= LEN(tops) THEN RETURN 0 - 1\n"
    s = s + "    DIM cur AS INTEGER = tops[active]\n"
    s = s + "    DIM l AS INTEGER\n"
    s = s + "    FOR l = 0 TO depth - 1\n"
    s = s + "        DIM kids AS []INTEGER = _mnKids(nodes, cur)\n"
    s = s + "        IF l >= LEN(path) OR path[l] < 0 OR path[l] >= LEN(kids) THEN RETURN cur\n"
    s = s + "        cur = kids[path[l]]\n"
    s = s + "    NEXT l\n"
    s = s + "    RETURN cur\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnFirst: first non-separator position within kids ---
    s = s + "FUNCTION _mnFirst(nodes AS []_MNode, kids AS []INTEGER) AS INTEGER\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(kids) - 1\n"
    s = s + "        IF NOT nodes[kids[i]].Sp THEN RETURN i\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN 0\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnStep: move selection by dir, skipping separators, clamped ---
    s = s + "FUNCTION _mnStep(nodes AS []_MNode, kids AS []INTEGER, cur AS INTEGER, dir AS INTEGER) AS INTEGER\n"
    s = s + "    DIM i AS INTEGER = cur + dir\n"
    s = s + "    DO WHILE i >= 0 AND i < LEN(kids)\n"
    s = s + "        IF NOT nodes[kids[i]].Sp THEN RETURN i\n"
    s = s + "        i = i + dir\n"
    s = s + "    LOOP\n"
    s = s + "    RETURN cur\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnOpenPath: a fresh open path for top menu `active` ---
    s = s + "FUNCTION _mnOpenPath(nodes AS []_MNode, active AS INTEGER) AS []INTEGER\n"
    s = s + "    DIM p AS []INTEGER\n"
    s = s + "    DIM top AS INTEGER = _mnNodeAt(nodes, active, p, 0)\n"
    s = s + "    p = APPEND(p, _mnFirst(nodes, _mnKids(nodes, top)))\n"
    s = s + "    RETURN p\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnKey: keyboard navigation while a dropdown is open ---
    s = s + "FUNCTION _mnKey(nodes AS []_MNode, key AS STRING, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING)\n"
    s = s + "    DIM chosen AS STRING = " + qt + qt + "\n"
    s = s + "    IF NOT open THEN RETURN active, open, path, chosen\n"
    s = s + "    DIM topc AS INTEGER = _mnTopCount(nodes)\n"
    s = s + "    DIM L AS INTEGER = LEN(path)\n"
    s = s + "    IF L = 0 THEN\n"
    s = s + "        path = APPEND(path, 0)\n"
    s = s + "        L = 1\n"
    s = s + "    END IF\n"
    s = s + "    DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, L - 1)\n"
    s = s + "    DIM kids AS []INTEGER = _mnKids(nodes, parent)\n"
    s = s + "    IF LEN(kids) = 0 THEN RETURN active, open, path, chosen\n"
    s = s + "    DIM cur AS INTEGER = path[L - 1]\n"
    s = s + "    IF cur < 0 THEN cur = 0\n"
    s = s + "    IF cur >= LEN(kids) THEN cur = LEN(kids) - 1\n"
    s = s + "    IF key = " + qt + "esc" + qt + " THEN RETURN active, FALSE, NIL, chosen\n"
    s = s + "    IF key = " + qt + "down" + qt + " THEN\n"
    s = s + "        path[L - 1] = _mnStep(nodes, kids, cur, 1)\n"
    s = s + "        RETURN active, open, path, chosen\n"
    s = s + "    END IF\n"
    s = s + "    IF key = " + qt + "up" + qt + " THEN\n"
    s = s + "        path[L - 1] = _mnStep(nodes, kids, cur, 0 - 1)\n"
    s = s + "        RETURN active, open, path, chosen\n"
    s = s + "    END IF\n"
    s = s + "    IF key = " + qt + "left" + qt + " THEN\n"
    s = s + "        IF L > 1 THEN\n"
    s = s + "            DIM np AS []INTEGER\n"
    s = s + "            DIM a AS INTEGER\n"
    s = s + "            FOR a = 0 TO L - 2\n"
    s = s + "                np = APPEND(np, path[a])\n"
    s = s + "            NEXT a\n"
    s = s + "            RETURN active, open, np, chosen\n"
    s = s + "        END IF\n"
    s = s + "        IF active > 0 THEN active = active - 1\n"
    s = s + "        RETURN active, open, _mnOpenPath(nodes, active), chosen\n"
    s = s + "    END IF\n"
    s = s + "    IF key = " + qt + "right" + qt + " THEN\n"
    s = s + "        DIM rnode AS INTEGER = kids[cur]\n"
    s = s + "        IF _mnIsSub(nodes, rnode) THEN\n"
    s = s + "            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, rnode)))\n"
    s = s + "            RETURN active, open, path, chosen\n"
    s = s + "        END IF\n"
    s = s + "        IF L = 1 AND active < topc - 1 THEN\n"
    s = s + "            active = active + 1\n"
    s = s + "            RETURN active, open, _mnOpenPath(nodes, active), chosen\n"
    s = s + "        END IF\n"
    s = s + "        RETURN active, open, path, chosen\n"
    s = s + "    END IF\n"
    s = s + "    IF key = " + qt + "enter" + qt + " OR key = " + qt + "space" + qt + " THEN\n"
    s = s + "        DIM enode AS INTEGER = kids[cur]\n"
    s = s + "        IF nodes[enode].Ds THEN RETURN active, open, path, chosen\n"
    s = s + "        IF _mnIsSub(nodes, enode) THEN\n"
    s = s + "            path = APPEND(path, _mnFirst(nodes, _mnKids(nodes, enode)))\n"
    s = s + "            RETURN active, open, path, chosen\n"
    s = s + "        END IF\n"
    s = s + "        RETURN active, FALSE, NIL, nodes[enode].Nm\n"
    s = s + "    END IF\n"
    s = s + "    RETURN active, open, path, chosen\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnBarView: the title strip, as a string (placed as a layer). The
    '     active title is bracketed when focused/open; the title under the
    '     mouse (hovActive + hoverIdx, from m.Hover/m.HoverTab) is reverse-
    '     highlighted via hoverStyle. ---
    s = s + "FUNCTION _mnBarView(nodes AS []_MNode, active AS INTEGER, open AS BOOLEAN, focused AS BOOLEAN, hovActive AS BOOLEAN, hoverIdx AS INTEGER) AS STRING\n"
    s = s + "    DIM bar AS STRING = " + qt + qt + "\n"
    s = s + "    DIM k AS INTEGER = 0\n"
    s = s + "    DIM i AS INTEGER\n"
    s = s + "    FOR i = 0 TO LEN(nodes) - 1\n"
    s = s + "        IF nodes[i].Dp = 0 AND NOT nodes[i].Sp THEN\n"
    s = s + "            IF (focused OR open) AND active = k THEN\n"
    s = s + "                bar = bar + " + qt + "[" + qt + " + nodes[i].Cap + " + qt + "]" + qt + "\n"
    s = s + "            ELSEIF hovActive AND hoverIdx = k THEN\n"
    s = s + "                bar = bar + hoverStyle.Render(" + qt + " " + qt + " + nodes[i].Cap + " + qt + " " + qt + ")\n"
    s = s + "            ELSE\n"
    s = s + "                bar = bar + " + qt + " " + qt + " + nodes[i].Cap + " + qt + " " + qt + "\n"
    s = s + "            END IF\n"
    s = s + "            k = k + 1\n"
    s = s + "        END IF\n"
    s = s + "    NEXT i\n"
    s = s + "    RETURN bar\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnComposeBoxes: composite the cascading dropdown boxes (as lipgloss
    '     layers) over `full`, returning the new full; stashes each box's rect
    '     into _mnB* for the click hit-test. ---
    s = s + "FUNCTION _mnComposeBoxes(full AS STRING, nodes AS []_MNode, baseX AS INTEGER, baseY AS INTEGER, active AS INTEGER, path AS []INTEGER) AS STRING\n"
    s = s + "    _mnBX = NIL\n"
    s = s + "    _mnBY = NIL\n"
    s = s + "    _mnBW = NIL\n"
    s = s + "    _mnBP = NIL\n"
    s = s + "    IF LEN(path) = 0 THEN RETURN full\n"
    s = s + "    DIM prevX AS INTEGER = 0\n"
    s = s + "    DIM prevW AS INTEGER = 0\n"
    s = s + "    DIM prevTopY AS INTEGER = 0\n"
    s = s + "    DIM lev AS INTEGER\n"
    s = s + "    FOR lev = 0 TO LEN(path) - 1\n"
    s = s + "        DIM parent AS INTEGER = _mnNodeAt(nodes, active, path, lev)\n"
    s = s + "        DIM kids AS []INTEGER = _mnKids(nodes, parent)\n"
    s = s + "        IF LEN(kids) = 0 THEN RETURN full\n"
    s = s + "        DIM boxX AS INTEGER = 0\n"
    s = s + "        DIM topY AS INTEGER = 0\n"
    s = s + "        IF lev = 0 THEN\n"
    s = s + "            boxX = baseX + _mnColAt(nodes, active)\n"
    s = s + "            topY = baseY + 1\n"
    s = s + "        ELSE\n"
    s = s + "            boxX = prevX + prevW\n"
    s = s + "            topY = prevTopY + path[lev - 1]\n"
    s = s + "        END IF\n"
    s = s + "        DIM innerW AS INTEGER = 1\n"
    s = s + "        DIM j AS INTEGER\n"
    s = s + "        FOR j = 0 TO LEN(kids) - 1\n"
    s = s + "            DIM cw AS INTEGER = 4 + lipgloss.Width(nodes[kids[j]].Cap)\n"
    s = s + "            IF nodes[kids[j]].Sc <> " + qt + qt + " THEN cw = cw + 2 + lipgloss.Width(nodes[kids[j]].Sc)\n"
    s = s + "            IF _mnIsSub(nodes, kids[j]) THEN cw = cw + 2\n"
    s = s + "            IF cw > innerW THEN innerW = cw\n"
    s = s + "        NEXT j\n"
    s = s + "        DIM box AS STRING = " + qt + "┌" + qt + " + strings.Repeat(" + qt + "─" + qt + ", innerW) + " + qt + "┐" + qt + "\n"
    s = s + "        DIM sel AS INTEGER = path[lev]\n"
    s = s + "        FOR j = 0 TO LEN(kids) - 1\n"
    s = s + "            DIM ndx AS INTEGER = kids[j]\n"
    s = s + "            IF nodes[ndx].Sp THEN\n"
    s = s + "                box = box + " + qt + "\\n" + qt + " + " + qt + "├" + qt + " + strings.Repeat(" + qt + "─" + qt + ", innerW) + " + qt + "┤" + qt + "\n"
    s = s + "            ELSE\n"
    s = s + "                DIM chk AS STRING = " + qt + "  " + qt + "\n"
    s = s + "                IF nodes[ndx].Ck THEN chk = " + qt + "✓ " + qt + "\n"
    s = s + "                DIM rgt AS STRING = nodes[ndx].Sc\n"
    s = s + "                IF _mnIsSub(nodes, ndx) THEN\n"
    s = s + "                    IF rgt <> " + qt + qt + " THEN\n"
    s = s + "                        rgt = rgt + " + qt + " ▸" + qt + "\n"
    s = s + "                    ELSE\n"
    s = s + "                        rgt = " + qt + "▸" + qt + "\n"
    s = s + "                    END IF\n"
    s = s + "                END IF\n"
    s = s + "                DIM inner AS STRING = " + qt + " " + qt + " + chk + nodes[ndx].Cap\n"
    s = s + "                DIM pad AS INTEGER = innerW - lipgloss.Width(inner) - lipgloss.Width(rgt) - 1\n"
    s = s + "                IF pad < 0 THEN pad = 0\n"
    s = s + "                inner = inner + strings.Repeat(" + qt + " " + qt + ", pad) + rgt + " + qt + " " + qt + "\n"
    s = s + "                DO WHILE lipgloss.Width(inner) > innerW\n"
    s = s + "                    inner = Mid(inner, 1, LEN(inner) - 1)\n"
    s = s + "                LOOP\n"
    s = s + "                DO WHILE lipgloss.Width(inner) < innerW\n"
    s = s + "                    inner = inner + " + qt + " " + qt + "\n"
    s = s + "                LOOP\n"
    s = s + "                DIM cell AS STRING = inner\n"
    s = s + "                IF j = sel THEN\n"
    s = s + "                    cell = focusStyle.Render(inner)\n"
    s = s + "                ELSEIF nodes[ndx].Ds THEN\n"
    s = s + "                    cell = _mnDim.Render(inner)\n"
    s = s + "                END IF\n"
    s = s + "                box = box + " + qt + "\\n" + qt + " + " + qt + "│" + qt + " + cell + " + qt + "│" + qt + "\n"
    s = s + "            END IF\n"
    s = s + "        NEXT j\n"
    s = s + "        box = box + " + qt + "\\n" + qt + " + " + qt + "└" + qt + " + strings.Repeat(" + qt + "─" + qt + ", innerW) + " + qt + "┘" + qt + "\n"
    s = s + "        DIM bBg AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(full)\n"
    s = s + "        DIM bLy AS POINTER TO lipgloss.Layer = lipgloss.NewLayer(box).X(boxX).Y(topY).Z(50 + lev)\n"
    s = s + "        DIM bCmp AS POINTER TO lipgloss.Compositor = lipgloss.NewCompositor(bBg, bLy)\n"
    s = s + "        full = bCmp.Render()\n"
    s = s + "        _mnBX = APPEND(_mnBX, boxX)\n"
    s = s + "        _mnBY = APPEND(_mnBY, topY + 1)\n"
    s = s + "        _mnBW = APPEND(_mnBW, innerW + 2)\n"
    s = s + "        _mnBP = APPEND(_mnBP, parent)\n"
    s = s + "        prevX = boxX\n"
    s = s + "        prevW = innerW + 2\n"
    s = s + "        prevTopY = topY\n"
    s = s + "    NEXT lev\n"
    s = s + "    RETURN full\n"
    s = s + "END FUNCTION\n\n"

    ' --- _mnClickHit: map a click to a box row (topmost box wins) ---
    s = s + "FUNCTION _mnClickHit(nodes AS []_MNode, mx AS INTEGER, my AS INTEGER, active AS INTEGER, open AS BOOLEAN, path AS []INTEGER) AS (INTEGER, BOOLEAN, []INTEGER, STRING, BOOLEAN)\n"
    s = s + "    DIM chosen AS STRING = " + qt + qt + "\n"
    s = s + "    IF NOT open THEN RETURN active, open, path, chosen, FALSE\n"
    s = s + "    DIM b AS INTEGER\n"
    s = s + "    FOR b = LEN(_mnBX) - 1 TO 0 STEP 0 - 1\n"
    s = s + "        DIM parent AS INTEGER = _mnBP[b]\n"
    s = s + "        DIM kids AS []INTEGER = _mnKids(nodes, parent)\n"
    s = s + "        IF mx >= _mnBX[b] AND mx < _mnBX[b] + _mnBW[b] AND my >= _mnBY[b] AND my < _mnBY[b] + LEN(kids) THEN\n"
    s = s + "            DIM row AS INTEGER = my - _mnBY[b]\n"
    s = s + "            DIM ndx AS INTEGER = kids[row]\n"
    s = s + "            DIM np AS []INTEGER\n"
    s = s + "            DIM a AS INTEGER\n"
    s = s + "            FOR a = 0 TO b - 1\n"
    s = s + "                np = APPEND(np, path[a])\n"
    s = s + "            NEXT a\n"
    s = s + "            np = APPEND(np, row)\n"
    s = s + "            IF nodes[ndx].Sp THEN RETURN active, open, path, chosen, TRUE\n"
    s = s + "            IF nodes[ndx].Ds THEN RETURN active, open, np, chosen, TRUE\n"
    s = s + "            IF _mnIsSub(nodes, ndx) THEN\n"
    s = s + "                np = APPEND(np, _mnFirst(nodes, _mnKids(nodes, ndx)))\n"
    s = s + "                RETURN active, open, np, chosen, TRUE\n"
    s = s + "            END IF\n"
    s = s + "            RETURN active, FALSE, NIL, nodes[ndx].Nm, TRUE\n"
    s = s + "        END IF\n"
    s = s + "    NEXT b\n"
    s = s + "    RETURN active, open, path, chosen, FALSE\n"
    s = s + "END FUNCTION\n\n"

    RETURN s
END FUNCTION
