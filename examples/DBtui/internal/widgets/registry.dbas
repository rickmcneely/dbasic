' DBtui — internal/widgets/registry.dbas
'
' Widget registry — kind → factory routing. vgtui uses
' `map[string]Factory` with sync.RWMutex; we don't need concurrent
' access in DBtui (the bubbletea model is single-threaded), so we
' keep just a sorted list of known kinds and dispatch through
' switchable Create. A future extension point can add custom kinds
' by editing this file (the user-defined widget plugin path).

IMPORT "sort"

TYPE Registry
    DIM Kinds AS []STRING        ' sorted list of registered kinds
END TYPE

' DefaultRegistry returns a Registry pre-populated with the built-in
' widget kinds (Button, Label, TextInput for now; more land as more
' widgets are ported).
FUNCTION DefaultRegistry() AS Registry
    DIM r AS Registry
    r.Kinds = APPEND(r.Kinds, WidgetKindButton)
    r.Kinds = APPEND(r.Kinds, WidgetKindLabel)
    r.Kinds = APPEND(r.Kinds, WidgetKindTextInput)
    r.Kinds = APPEND(r.Kinds, WidgetKindCheckbox)
    r.Kinds = APPEND(r.Kinds, WidgetKindComboBox)
    r.Kinds = APPEND(r.Kinds, WidgetKindListBox)
    r.Kinds = APPEND(r.Kinds, WidgetKindRadioButton)
    r.Kinds = APPEND(r.Kinds, WidgetKindProgressBar)
    r.Kinds = APPEND(r.Kinds, WidgetKindScrollBar)
    r.Kinds = APPEND(r.Kinds, WidgetKindTabStrip)
    r.Kinds = APPEND(r.Kinds, WidgetKindScrollPane)
    r.Kinds = APPEND(r.Kinds, WidgetKindTreeView)
    r.Kinds = APPEND(r.Kinds, WidgetKindGroupBox)
    r.Kinds = APPEND(r.Kinds, WidgetKindMenuBar)
    r.Kinds = APPEND(r.Kinds, WidgetKindStatusBar)
    r.Kinds = APPEND(r.Kinds, WidgetKindTextArea)
    r.Kinds = APPEND(r.Kinds, WidgetKindSplitPanel)
    r.Kinds = APPEND(r.Kinds, WidgetKindPropertyGrid)
    r.Kinds = APPEND(r.Kinds, WidgetKindToolbar)
    sort.Strings(r.Kinds)
    ' Note: WidgetKindFileDialog stays in registry.Create for backwards
    ' compat with old projects that placed it as a widget, but is no
    ' longer listed here — new projects use it as a Tool instead.
    RETURN r
END FUNCTION

' Has reports whether the given kind is registered.
FUNCTION (r AS Registry) Has(kind AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(r.Kinds) - 1
        IF r.Kinds[i] = kind THEN RETURN TRUE
    NEXT i
    RETURN FALSE
END FUNCTION

' Create instantiates a new widget of the given kind. Returns the
' zero Widget and an error when the kind is unknown.
FUNCTION (r AS Registry) Create(kind AS STRING, id AS STRING) AS (Widget, ERROR)
    IF kind = WidgetKindButton THEN
        RETURN NewButton(id), NIL
    END IF
    IF kind = WidgetKindLabel THEN
        RETURN NewLabel(id), NIL
    END IF
    IF kind = WidgetKindTextInput THEN
        RETURN NewTextInput(id), NIL
    END IF
    IF kind = WidgetKindFileDialog THEN
        RETURN NewFileDialog(id), NIL
    END IF
    IF kind = WidgetKindCheckbox THEN
        RETURN NewCheckbox(id), NIL
    END IF
    IF kind = WidgetKindComboBox THEN
        RETURN NewComboBox(id), NIL
    END IF
    IF kind = WidgetKindListBox THEN
        RETURN NewListBox(id), NIL
    END IF
    IF kind = WidgetKindRadioButton THEN
        RETURN NewRadioButton(id), NIL
    END IF
    IF kind = WidgetKindProgressBar THEN
        RETURN NewProgressBar(id), NIL
    END IF
    IF kind = WidgetKindScrollBar THEN
        RETURN NewScrollBar(id), NIL
    END IF
    IF kind = WidgetKindTabStrip THEN
        RETURN NewTabStrip(id), NIL
    END IF
    IF kind = WidgetKindScrollPane THEN
        RETURN NewScrollPane(id), NIL
    END IF
    IF kind = WidgetKindTreeView THEN
        RETURN NewTreeView(id), NIL
    END IF
    IF kind = WidgetKindGroupBox THEN
        RETURN NewGroupBox(id), NIL
    END IF
    IF kind = WidgetKindMenuBar THEN
        RETURN NewMenuBarWidget(id), NIL
    END IF
    IF kind = WidgetKindStatusBar THEN
        RETURN NewStatusBarWidget(id), NIL
    END IF
    IF kind = WidgetKindTextArea THEN
        RETURN NewTextArea(id), NIL
    END IF
    IF kind = WidgetKindSplitPanel THEN
        RETURN NewSplitPanel(id), NIL
    END IF
    IF kind = WidgetKindPropertyGrid THEN
        RETURN NewPropertyGrid(id), NIL
    END IF
    IF kind = WidgetKindToolbar THEN
        RETURN NewToolbar(id), NIL
    END IF
    DIM zero AS Widget
    RETURN zero, NewError("unknown widget kind: " + kind)
END FUNCTION
