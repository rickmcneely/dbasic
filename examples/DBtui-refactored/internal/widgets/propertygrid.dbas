' DBtui — internal/widgets/propertygrid.dbas
'
' PropertyGrid — a name|value table with categories, type-aware value
' rendering, and a scrollbar. Models the IDE's own Properties panel
' (internal/properties/panel.dbas) but packaged as a reusable widget.
'
' Rows live in the shared LstItems field as ";"-separated entries.
' Each entry has four pipe-separated parts: "Category|Name|Value|Type"
'
'   Category — if non-empty, the row is a category header that spans
'              the full width as "▸ Category ────"; Name/Value/Type
'              are ignored for header rows.
'   Name     — left column label
'   Value    — raw text; how it renders is determined by Type
'   Type     — one of:
'                ""            — plain string
'                "bool"        — Value is "true"/"false"; renders [x]/[ ]
'                "color"       — Value is a hex like "#1a1b2e"; renders ██ swatch + hex
'                "int"         — Value is an integer (renders verbatim)
'                "enum:a:b:c"  — Value is one of the colon-separated
'                                options; renders as ◂ value ▸
'
' Runtime state reuses existing WState fields:
'   LstIdx — cursor row (into the full row list, *not* visible only)
'   Offset — scroll position
'
' v1 is display-only: cursor moves with ↑/↓ (auto-scrolls), mouse
' clicks set the cursor. Editing comes in a later slice.

FUNCTION NewPropertyGrid(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindPropertyGrid
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 32
    w.H = 14
    w.Style.BgColor = "#1a1b2e"
    w.Style.FgColor = "#e0def4"
    w.Style.Border = "normal"
    w.Style.Corner = "round"
    w.Title = "Properties"
    w.LstItems = "Layout||||;|X|2|int;|Y|1|int;|Width|24|int;|Height|3|int;Visual||||;|Text|Button|;|Align|left|enum:left:center:right;|BgColor|#1a1b2e|color;|Visible|true|bool"
    w.LstIdx = 0
    w.Offset = 0
    RETURN w
END FUNCTION

FUNCTION PropertyGridProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Title", w.Title))
    out = APPEND(out, StringProp("Rows", w.LstItems))
    out = APPEND(out, StringProp("Selected", fmt.Sprintf("%d", w.LstIdx)))
    out = APPEND(out, StringProp("Offset", fmt.Sprintf("%d", w.Offset)))
    DIM stylePs AS []Property = StyleProperties(w.Style, TRUE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetPropertyGridProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    IF name = "Title" THEN
        DIM s AS STRING
        DIM err AS ERROR
        s, err = coerceString(name, value)
        IF err <> NIL THEN RETURN err
        w.Title = s
        RETURN NIL
    END IF
    IF name = "Rows" THEN
        DIM s2 AS STRING
        DIM err2 AS ERROR
        s2, err2 = coerceString(name, value)
        IF err2 <> NIL THEN RETURN err2
        w.LstItems = s2
        RETURN NIL
    END IF
    IF name = "Selected" THEN
        DIM iv AS INTEGER
        DIM ierr AS ERROR
        iv, ierr = coerceInt(name, value)
        IF ierr <> NIL THEN RETURN ierr
        w.LstIdx = iv
        RETURN NIL
    END IF
    IF name = "Offset" THEN
        DIM ov AS INTEGER
        DIM oerr AS ERROR
        ov, oerr = coerceInt(name, value)
        IF oerr <> NIL THEN RETURN oerr
        w.Offset = ov
        RETURN NIL
    END IF
    RETURN NewError("unknown PropertyGrid property: " + name)
END FUNCTION
