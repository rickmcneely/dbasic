' DBtui — internal/widgets/textinput.dbas
'
' Single-line text-input widget.

FUNCTION NewTextInput(id AS STRING) AS Widget
    DIM w AS Widget
    w.Id = id
    w.Kind = WidgetKindTextInput
    w.Visible = TRUE
    w.TabStop = TRUE
    w.W = 24
    w.H = 1
    w.Style.BgColor = "#FFFFFF"
    w.Style.FgColor = "#000000"
    w.Style.Border = "normal"
    w.Style.Corner = "square"
    w.TiPlaceholder = ""
    w.TiValue = ""
    RETURN w
END FUNCTION

FUNCTION TextInputProperties(w AS Widget) AS []Property
    DIM out AS []Property
    out = APPEND(out, StringProp("Placeholder", w.TiPlaceholder))
    out = APPEND(out, StringProp("Value", w.TiValue))
    DIM stylePs AS []Property = StyleProperties(w.Style, TRUE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(stylePs) - 1
        out = APPEND(out, stylePs[i])
    NEXT i
    RETURN out
END FUNCTION

FUNCTION SetTextInputProperty(w AS POINTER TO Widget, name AS STRING, value AS ANY) AS ERROR
    IF SetStyleProperty(@w.Style, name, value) THEN RETURN NIL
    DIM str AS STRING
    DIM ok AS BOOLEAN
    str, ok = value.(STRING)
    IF name = "Placeholder" THEN
        IF NOT ok THEN RETURN NewError("Placeholder must be a string")
        w.TiPlaceholder = str
        RETURN NIL
    END IF
    IF name = "Value" THEN
        IF NOT ok THEN RETURN NewError("Value must be a string")
        w.TiValue = str
        RETURN NIL
    END IF
    RETURN NewError("unknown TextInput property: " + name)
END FUNCTION
