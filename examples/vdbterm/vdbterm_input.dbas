' VDBTerm Input Handlers
' Keyboard, mouse, dialog, and menu input handling

' Helper function to activate theme editor buttons
FUNCTION ThemeEditorActivateButton(m AS VDBTermModel) AS VDBTermModel
    IF m.ThemeEditorIndex = 0 THEN
        ' Apply to All - apply theme to all existing controls
        m.Project.Theme = m.ThemeEditingTheme
        ApplyThemeToProject(@m.Project)
        m.Message = "Theme applied to all controls"
    ELSEIF m.ThemeEditorIndex = 1 THEN
        ' OK - save theme and close
        m.Project.Theme = m.ThemeEditingTheme
        m.Message = "Theme saved"
        m.DialogMode = DIALOG_NONE
    ELSEIF m.ThemeEditorIndex = 2 THEN
        ' Cancel - close without saving
        m.DialogMode = DIALOG_NONE
    ENDIF
    RETURN m
END FUNCTION

' Render a scrolling text field with cursor
' Returns the visible portion of text with cursor indicator (inverted character)
FUNCTION RenderDialogTextField(text AS STRING, cursor AS INTEGER, fieldWidth AS INTEGER) AS STRING
    DIM textLen AS INTEGER = Len(text)
    DIM visibleStart AS INTEGER = 0

    ' Calculate visible window to keep cursor in view
    IF cursor > fieldWidth - 2 THEN
        visibleStart = cursor - fieldWidth + 2
    ENDIF

    ' ANSI escape codes for reverse video
    DIM esc AS STRING = Chr(27)
    DIM reverseOn AS STRING = esc & "[7m"
    DIM reverseOff AS STRING = esc & "[27m"

    ' Build the display string character by character
    DIM result AS STRING = ""
    DIM i AS INTEGER
    FOR i = 0 TO fieldWidth - 1
        DIM textIdx AS INTEGER = visibleStart + i
        DIM ch AS STRING
        IF textIdx < textLen THEN
            ch = Mid(text, textIdx + 1, 1)
        ELSE
            ch = " "
        ENDIF

        IF textIdx = cursor THEN
            ' Show inverted character at cursor position
            result = result & reverseOn & ch & reverseOff
        ELSE
            result = result & ch
        ENDIF
    NEXT

    RETURN result
END FUNCTION

' Handle dialog input with custom scrolling text field
FUNCTION HandleDialogInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    ' Find/Replace dialog input (handle before generic esc)
    IF m.DialogMode = DIALOG_FIND OR m.DialogMode = DIALOG_REPLACE THEN
        IF key = "esc" THEN
            m.DialogMode = DIALOG_NONE
            m.FindActive = FALSE
            DIM clearMatches AS [][]INTEGER
            m.FindMatches = clearMatches
            RETURN m, NIL
        ELSEIF key = "enter" OR key = "f3" THEN
            ' Find next match
            IF Len(m.FindMatches) > 0 THEN
                m.FindMatchIdx = (m.FindMatchIdx + 1) MOD Len(m.FindMatches)
                ' Navigate to match
                DIM matchInfo AS []INTEGER = m.FindMatches[m.FindMatchIdx]
                m.CodeCursorY = matchInfo[0]
                m.CodeCursorX = matchInfo[1]
            ENDIF
            RETURN m, NIL
        ELSEIF key = "shift+f3" THEN
            ' Find previous match
            IF Len(m.FindMatches) > 0 THEN
                m.FindMatchIdx = m.FindMatchIdx - 1
                IF m.FindMatchIdx < 0 THEN
                    m.FindMatchIdx = Len(m.FindMatches) - 1
                ENDIF
                DIM matchInfo2 AS []INTEGER = m.FindMatches[m.FindMatchIdx]
                m.CodeCursorY = matchInfo2[0]
                m.CodeCursorX = matchInfo2[1]
            ENDIF
            RETURN m, NIL
        ELSEIF key = "ctrl+r" THEN
            ' Replace current match (only in DIALOG_REPLACE mode)
            IF m.DialogMode = DIALOG_REPLACE AND Len(m.FindMatches) > 0 AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                DIM rMatchInfo AS []INTEGER = m.FindMatches[m.FindMatchIdx]
                DIM rLine AS INTEGER = rMatchInfo[0]
                DIM rCol AS INTEGER = rMatchInfo[1]
                DIM rLen AS INTEGER = rMatchInfo[2]
                ' Get current code
                DIM formCode AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
                DIM codeLines AS []STRING = SplitStr(formCode, Chr(10))
                IF rLine < Len(codeLines) THEN
                    DIM origLine AS STRING = codeLines[rLine]
                    DIM newLine AS STRING = Left(origLine, rCol) & m.ReplaceText & Mid(origLine, rCol + rLen + 1, Len(origLine) - rCol - rLen)
                    codeLines[rLine] = newLine
                    ' Rebuild code
                    DIM newCode AS STRING = ""
                    DIM k AS INTEGER
                    FOR k = 0 TO Len(codeLines) - 1
                        IF k > 0 THEN
                            newCode = newCode & Chr(10)
                        ENDIF
                        newCode = newCode & codeLines[k]
                    NEXT
                    m.Project.Forms[m.CurrentFormIdx].Code = newCode
                    m.Project.Modified = TRUE
                    ' Re-search
                    m.FindMatches = FindAllMatches(newCode, m.FindText)
                    IF m.FindMatchIdx >= Len(m.FindMatches) THEN
                        m.FindMatchIdx = 0
                    ENDIF
                    ' Update code editor
                    IF m.CodeEditorInited THEN
                        m.CodeEditor.SetValue(newCode)
                    ENDIF
                ENDIF
            ENDIF
            RETURN m, NIL
        ELSEIF key = "backspace" THEN
            IF m.DialogMode = DIALOG_REPLACE AND m.DialogField = 1 AND Len(m.ReplaceText) > 0 THEN
                m.ReplaceText = Left(m.ReplaceText, Len(m.ReplaceText) - 1)
            ELSEIF (m.DialogMode = DIALOG_FIND OR m.DialogField = 0) AND Len(m.FindText) > 0 THEN
                m.FindText = Left(m.FindText, Len(m.FindText) - 1)
                ' Re-search
                IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                    m.FindMatches = FindAllMatches(m.Project.Forms[m.CurrentFormIdx].Code, m.FindText)
                    m.FindMatchIdx = 0
                ENDIF
            ENDIF
            RETURN m, NIL
        ELSEIF key = "tab" THEN
            ' Switch between find and replace fields
            IF m.DialogMode = DIALOG_REPLACE THEN
                m.DialogField = 1 - m.DialogField
            ENDIF
            RETURN m, NIL
        ELSE
            ' Type character into find/replace field
            IF Len(key) = 1 THEN
                IF m.DialogMode = DIALOG_REPLACE AND m.DialogField = 1 THEN
                    m.ReplaceText = m.ReplaceText & key
                ELSE
                    m.FindText = m.FindText & key
                    ' Re-search as you type
                    IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                        m.FindMatches = FindAllMatches(m.Project.Forms[m.CurrentFormIdx].Code, m.FindText)
                        m.FindMatchIdx = 0
                    ENDIF
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF
    ENDIF

    IF key = "esc" THEN
        m.DialogMode = DIALOG_NONE
        RETURN m, NIL
    ENDIF

    ' Simple info dialogs
    IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
        IF key = "enter" OR key = " " THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Compile error dialog
    IF m.DialogMode = DIALOG_COMPILE_ERROR THEN
        IF key = "left" OR key = "right" OR key = "tab" THEN
            ' Toggle between OK and Copy buttons
            m.CompileErrorBtnIdx = 1 - m.CompileErrorBtnIdx
        ELSEIF key = "up" THEN
            ' Scroll up
            IF m.CompileErrorScroll > 0 THEN
                m.CompileErrorScroll = m.CompileErrorScroll - 1
            ENDIF
        ELSEIF key = "down" THEN
            ' Scroll down
            DIM errorLines AS []STRING = SplitStr(m.CompileErrors, Chr(10))
            DIM maxVisible AS INTEGER = 12
            IF m.CompileErrorScroll < Len(errorLines) - maxVisible THEN
                m.CompileErrorScroll = m.CompileErrorScroll + 1
            ENDIF
        ELSEIF key = "pgup" THEN
            m.CompileErrorScroll = m.CompileErrorScroll - 10
            IF m.CompileErrorScroll < 0 THEN
                m.CompileErrorScroll = 0
            ENDIF
        ELSEIF key = "pgdown" THEN
            DIM pgErrorLines AS []STRING = SplitStr(m.CompileErrors, Chr(10))
            DIM pgMaxVisible AS INTEGER = 12
            m.CompileErrorScroll = m.CompileErrorScroll + 10
            IF m.CompileErrorScroll > Len(pgErrorLines) - pgMaxVisible THEN
                m.CompileErrorScroll = Len(pgErrorLines) - pgMaxVisible
            ENDIF
            IF m.CompileErrorScroll < 0 THEN
                m.CompileErrorScroll = 0
            ENDIF
        ELSEIF key = "enter" OR key = " " THEN
            IF m.CompileErrorBtnIdx = 0 THEN
                ' OK - close dialog
                m.DialogMode = DIALOG_NONE
            ELSE
                ' Copy - copy errors to clipboard
                CopyToClipboard(m.CompileErrors)
                m.Message = "Errors copied to clipboard"
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Object Browser dialog
    IF m.DialogMode = DIALOG_OBJECT_BROWSER THEN
        DIM widgetCount AS INTEGER = Len(GetObjectBrowserWidgets())
        DIM maxWidgetIdx AS INTEGER = widgetCount - 1
        IF key = "tab" THEN
            ' Cycle through tabs: Widgets -> Props -> Events -> Functions -> Widgets
            m.ObjectBrowserTab = (m.ObjectBrowserTab + 1) MOD 4
            m.ObjectBrowserScroll = 0
        ELSEIF key = "up" THEN
            IF m.ObjectBrowserTab = 0 THEN
                ' In Widgets tab, move selection up
                IF m.ObjectBrowserWidgetIdx > 0 THEN
                    m.ObjectBrowserWidgetIdx = m.ObjectBrowserWidgetIdx - 1
                    IF m.ObjectBrowserWidgetIdx < m.ObjectBrowserScroll THEN
                        m.ObjectBrowserScroll = m.ObjectBrowserWidgetIdx
                    ENDIF
                ENDIF
            ELSE
                ' In Properties/Events tab, scroll up
                IF m.ObjectBrowserScroll > 0 THEN
                    m.ObjectBrowserScroll = m.ObjectBrowserScroll - 1
                ENDIF
            ENDIF
        ELSEIF key = "down" THEN
            IF m.ObjectBrowserTab = 0 THEN
                ' In Widgets tab, move selection down
                IF m.ObjectBrowserWidgetIdx < maxWidgetIdx THEN
                    m.ObjectBrowserWidgetIdx = m.ObjectBrowserWidgetIdx + 1
                    IF m.ObjectBrowserWidgetIdx >= m.ObjectBrowserScroll + 16 THEN
                        m.ObjectBrowserScroll = m.ObjectBrowserWidgetIdx - 15
                    ENDIF
                ENDIF
            ELSE
                ' In Properties/Events tab, scroll down
                m.ObjectBrowserScroll = m.ObjectBrowserScroll + 1
            ENDIF
        ELSEIF key = "pgup" THEN
            IF m.ObjectBrowserTab = 0 THEN
                m.ObjectBrowserWidgetIdx = m.ObjectBrowserWidgetIdx - 5
                IF m.ObjectBrowserWidgetIdx < 0 THEN
                    m.ObjectBrowserWidgetIdx = 0
                ENDIF
                m.ObjectBrowserScroll = m.ObjectBrowserWidgetIdx
            ELSE
                m.ObjectBrowserScroll = m.ObjectBrowserScroll - 5
                IF m.ObjectBrowserScroll < 0 THEN
                    m.ObjectBrowserScroll = 0
                ENDIF
            ENDIF
        ELSEIF key = "pgdown" THEN
            IF m.ObjectBrowserTab = 0 THEN
                m.ObjectBrowserWidgetIdx = m.ObjectBrowserWidgetIdx + 5
                IF m.ObjectBrowserWidgetIdx > maxWidgetIdx THEN
                    m.ObjectBrowserWidgetIdx = maxWidgetIdx
                ENDIF
            ELSE
                m.ObjectBrowserScroll = m.ObjectBrowserScroll + 5
            ENDIF
        ELSEIF key = "enter" OR key = " " THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Theme Editor dialog
    IF m.DialogMode = DIALOG_THEME_EDITOR THEN
        DIM propCount AS INTEGER = 21
        DIM viewHeight AS INTEGER = 8
        DIM use256 AS BOOLEAN = m.ThemeEditingTheme.Use256Colors

        ' Theme preset keys (always available)
        IF key = "1" THEN
            m.ThemeEditingTheme = NewDefaultTheme()
            m.ThemeEditorPropIdx = 0
            m.ThemeEditorScroll = 0
        ELSEIF key = "2" THEN
            m.ThemeEditingTheme = NewDarkTheme()
            m.ThemeEditorPropIdx = 0
            m.ThemeEditorScroll = 0
        ELSEIF key = "3" THEN
            m.ThemeEditingTheme = NewLightTheme()
            m.ThemeEditorPropIdx = 0
            m.ThemeEditorScroll = 0
        ELSEIF key = "4" THEN
            m.ThemeEditingTheme = NewGreenTerminalTheme()
            m.ThemeEditorPropIdx = 0
            m.ThemeEditorScroll = 0

        ' Escape - close dialog
        ELSEIF key = "esc" THEN
            m.DialogMode = DIALOG_NONE

        ' Tab - cycle focus areas (Props -> Buttons -> Props)
        ELSEIF key = "tab" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorFocus = THEME_FOCUS_BUTTONS
            ELSE
                m.ThemeEditorFocus = THEME_FOCUS_PROPS
            ENDIF

        ' Shift+Tab - reverse cycle
        ELSEIF key = "shift+tab" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorFocus = THEME_FOCUS_BUTTONS
            ELSE
                m.ThemeEditorFocus = THEME_FOCUS_PROPS
            ENDIF

        ' Space - toggle checkboxes (only when in props focus)
        ELSEIF key = " " THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.Project.UseTheme = NOT m.Project.UseTheme
            ELSEIF m.ThemeEditorFocus = THEME_FOCUS_BUTTONS THEN
                ' Activate button with space
                m = ThemeEditorActivateButton(m)
            ENDIF

        ' E key - toggle 256-color mode
        ELSEIF key = "e" OR key = "E" THEN
            m.ThemeEditingTheme.Use256Colors = NOT m.ThemeEditingTheme.Use256Colors
            m.ThemeEditingTheme.Name = "Custom"

        ' Arrow keys - depends on focus area
        ELSEIF key = "up" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                IF m.ThemeEditorPropIdx > 0 THEN
                    m.ThemeEditorPropIdx = m.ThemeEditorPropIdx - 1
                    IF m.ThemeEditorPropIdx < m.ThemeEditorScroll THEN
                        m.ThemeEditorScroll = m.ThemeEditorPropIdx
                    ENDIF
                ENDIF
            ENDIF

        ELSEIF key = "down" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                IF m.ThemeEditorPropIdx < propCount - 1 THEN
                    m.ThemeEditorPropIdx = m.ThemeEditorPropIdx + 1
                    IF m.ThemeEditorPropIdx >= m.ThemeEditorScroll + viewHeight THEN
                        m.ThemeEditorScroll = m.ThemeEditorPropIdx - viewHeight + 1
                    ENDIF
                ENDIF
            ENDIF

        ELSEIF key = "left" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorColIdx = 0
            ELSEIF m.ThemeEditorFocus = THEME_FOCUS_BUTTONS THEN
                IF m.ThemeEditorIndex > 0 THEN
                    m.ThemeEditorIndex = m.ThemeEditorIndex - 1
                ENDIF
            ENDIF

        ELSEIF key = "right" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorColIdx = 1
            ELSEIF m.ThemeEditorFocus = THEME_FOCUS_BUTTONS THEN
                IF m.ThemeEditorIndex < 2 THEN
                    m.ThemeEditorIndex = m.ThemeEditorIndex + 1
                ENDIF
            ENDIF

        ' Page Up/Down - only for props
        ELSEIF key = "pgup" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorPropIdx = m.ThemeEditorPropIdx - viewHeight
                IF m.ThemeEditorPropIdx < 0 THEN
                    m.ThemeEditorPropIdx = 0
                ENDIF
                m.ThemeEditorScroll = m.ThemeEditorPropIdx
            ENDIF

        ELSEIF key = "pgdown" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorPropIdx = m.ThemeEditorPropIdx + viewHeight
                IF m.ThemeEditorPropIdx > propCount - 1 THEN
                    m.ThemeEditorPropIdx = propCount - 1
                ENDIF
                IF m.ThemeEditorPropIdx >= m.ThemeEditorScroll + viewHeight THEN
                    m.ThemeEditorScroll = m.ThemeEditorPropIdx - viewHeight + 1
                ENDIF
            ENDIF

        ELSEIF key = "home" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorPropIdx = 0
                m.ThemeEditorScroll = 0
            ENDIF

        ELSEIF key = "end" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditorPropIdx = propCount - 1
                m.ThemeEditorScroll = propCount - viewHeight
                IF m.ThemeEditorScroll < 0 THEN
                    m.ThemeEditorScroll = 0
                ENDIF
            ENDIF

        ' +/- for 16-color mode adjustment
        ELSEIF (key = "+" OR key = "=") AND NOT use256 THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditingTheme = AdjustThemeColor(m.ThemeEditingTheme, m.ThemeEditorPropIdx, m.ThemeEditorColIdx, 1)
                m.ThemeEditingTheme.Name = "Custom"
            ENDIF

        ELSEIF (key = "-" OR key = "_") AND NOT use256 THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                m.ThemeEditingTheme = AdjustThemeColor(m.ThemeEditingTheme, m.ThemeEditorPropIdx, m.ThemeEditorColIdx, -1)
                m.ThemeEditingTheme.Name = "Custom"
            ENDIF

        ' Enter - open 256-color picker popup or activate button
        ELSEIF key = "enter" THEN
            IF m.ThemeEditorFocus = THEME_FOCUS_PROPS THEN
                IF use256 THEN
                    ' Open 256-color picker popup - initialize with current color
                    DIM foreColor AS INTEGER
                    DIM backColor AS INTEGER
                    foreColor, backColor = GetThemePropColors(m.ThemeEditingTheme, m.ThemeEditorPropIdx)
                    DIM currentColor AS INTEGER
                    IF m.ThemeEditorColIdx = 0 THEN
                        currentColor = foreColor
                    ELSE
                        currentColor = backColor
                    ENDIF
                    m.ThemeColorPickerY = currentColor / 16
                    m.ThemeColorPickerX = currentColor MOD 16
                    m.ThemeEditorIndex = 0  ' Reset to OK button
                    m.DialogMode = DIALOG_COLOR_PICKER_256
                ENDIF
            ELSEIF m.ThemeEditorFocus = THEME_FOCUS_BUTTONS THEN
                m = ThemeEditorActivateButton(m)
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' 256-Color Picker popup dialog
    IF m.DialogMode = DIALOG_COLOR_PICKER_256 THEN
        ' Escape - cancel and return to theme editor
        IF key = "esc" THEN
            m.DialogMode = DIALOG_THEME_EDITOR
            RETURN m, NIL
        ENDIF

        ' Arrow keys - navigate color grid
        IF key = "up" THEN
            IF m.ThemeColorPickerY > 0 THEN
                m.ThemeColorPickerY = m.ThemeColorPickerY - 1
            ENDIF
        ELSEIF key = "down" THEN
            IF m.ThemeColorPickerY < 15 THEN
                m.ThemeColorPickerY = m.ThemeColorPickerY + 1
            ENDIF
        ELSEIF key = "left" THEN
            IF m.ThemeColorPickerX > 0 THEN
                m.ThemeColorPickerX = m.ThemeColorPickerX - 1
            ENDIF
        ELSEIF key = "right" THEN
            IF m.ThemeColorPickerX < 15 THEN
                m.ThemeColorPickerX = m.ThemeColorPickerX + 1
            ENDIF
        ELSEIF key = "home" THEN
            m.ThemeColorPickerX = 0
            m.ThemeColorPickerY = 0
        ELSEIF key = "end" THEN
            m.ThemeColorPickerX = 15
            m.ThemeColorPickerY = 15

        ' Tab - switch between OK and Cancel buttons
        ELSEIF key = "tab" OR key = "shift+tab" THEN
            IF m.ThemeEditorIndex = 0 THEN
                m.ThemeEditorIndex = 1
            ELSE
                m.ThemeEditorIndex = 0
            ENDIF

        ' Enter or Space - apply selected color or cancel
        ELSEIF key = "enter" OR key = " " THEN
            IF m.ThemeEditorIndex = 0 THEN
                ' OK - apply selected color
                DIM selectedColor AS INTEGER = m.ThemeColorPickerY * 16 + m.ThemeColorPickerX
                m.ThemeEditingTheme = SetThemeColor(m.ThemeEditingTheme, m.ThemeEditorPropIdx, m.ThemeEditorColIdx, selectedColor)
                m.ThemeEditingTheme.Name = "Custom"
            ENDIF
            ' Return to theme editor (whether OK or Cancel)
            m.DialogMode = DIALOG_THEME_EDITOR
            m.ThemeEditorFocus = THEME_FOCUS_PROPS
        ENDIF
        RETURN m, NIL
    ENDIF

    ' File Browser dialog
    IF m.DialogMode = DIALOG_FILE_BROWSER THEN
        DIM dirListHeight AS INTEGER = 10
        DIM fileListHeight AS INTEGER = 10

        IF key = "esc" THEN
            m.DialogMode = DIALOG_NONE
            RETURN m, NIL
        ENDIF

        IF key = "tab" THEN
            ' Cycle focus: Dirs -> Files -> Buttons -> Dirs
            IF m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS THEN
                m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES
            ELSEIF m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES THEN
                m.FileBrowserFocus = FILEBROWSER_FOCUS_BUTTONS
            ELSE
                m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS
            ENDIF
            RETURN m, NIL
        ENDIF

        IF key = "shift+tab" THEN
            ' Reverse cycle
            IF m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS THEN
                m.FileBrowserFocus = FILEBROWSER_FOCUS_BUTTONS
            ELSEIF m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES THEN
                m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS
            ELSE
                m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Handle directory list navigation
        IF m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS THEN
            IF key = "up" THEN
                IF m.FileBrowserDirIdx > 0 THEN
                    m.FileBrowserDirIdx = m.FileBrowserDirIdx - 1
                    IF m.FileBrowserDirIdx < m.FileBrowserDirScroll THEN
                        m.FileBrowserDirScroll = m.FileBrowserDirIdx
                    ENDIF
                ENDIF
            ELSEIF key = "down" THEN
                IF m.FileBrowserDirIdx < Len(m.FileBrowserDirs) - 1 THEN
                    m.FileBrowserDirIdx = m.FileBrowserDirIdx + 1
                    IF m.FileBrowserDirIdx >= m.FileBrowserDirScroll + dirListHeight THEN
                        m.FileBrowserDirScroll = m.FileBrowserDirIdx - dirListHeight + 1
                    ENDIF
                ENDIF
            ELSEIF key = "enter" THEN
                ' Navigate into selected directory
                IF Len(m.FileBrowserDirs) > 0 AND m.FileBrowserDirIdx < Len(m.FileBrowserDirs) THEN
                    FileBrowserNavigate(@m, m.FileBrowserDirs[m.FileBrowserDirIdx])
                ENDIF
            ELSEIF key = "right" THEN
                ' Move focus to files
                m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Handle file list navigation
        IF m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES THEN
            IF key = "up" THEN
                IF m.FileBrowserFileIdx > 0 THEN
                    m.FileBrowserFileIdx = m.FileBrowserFileIdx - 1
                    IF m.FileBrowserFileIdx < m.FileBrowserFileScroll THEN
                        m.FileBrowserFileScroll = m.FileBrowserFileIdx
                    ENDIF
                ENDIF
            ELSEIF key = "down" THEN
                IF m.FileBrowserFileIdx < Len(m.FileBrowserFiles) - 1 THEN
                    m.FileBrowserFileIdx = m.FileBrowserFileIdx + 1
                    IF m.FileBrowserFileIdx >= m.FileBrowserFileScroll + fileListHeight THEN
                        m.FileBrowserFileScroll = m.FileBrowserFileIdx - fileListHeight + 1
                    ENDIF
                ENDIF
            ELSEIF key = "enter" THEN
                ' Select the file and open it
                DIM selectedPath AS STRING = FileBrowserGetSelectedPath(m)
                IF selectedPath <> "" THEN
                    m.DialogMode = DIALOG_NONE
                    ' Load the project
                    DIM proj AS VDBProject
                    DIM loadErr AS STRING
                    proj, loadErr = LoadProject(selectedPath)
                    IF loadErr <> "" THEN
                        m.Message = "Error: " & loadErr
                    ELSE
                        m.Project = proj
                        m.ProjectLoaded = TRUE
                        m.CurrentFormIdx = 0
                        m.SelectedCtrlIdx = -1
                        m.TreeIndex = 0
                        m.TreeExpanded = []BOOLEAN{}
                        m = EnsureTreeExpanded(m)
                        m.Message = "Loaded: " & selectedPath
                    ENDIF
                ENDIF
            ELSEIF key = "left" THEN
                ' Move focus to directories
                m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Handle button navigation
        IF m.FileBrowserFocus = FILEBROWSER_FOCUS_BUTTONS THEN
            IF key = "left" THEN
                m.FileBrowserBtnIdx = 0
            ELSEIF key = "right" THEN
                m.FileBrowserBtnIdx = 1
            ELSEIF key = "enter" THEN
                IF m.FileBrowserBtnIdx = 0 THEN
                    ' Open button - same as pressing Enter on file
                    DIM btnSelectedPath AS STRING = FileBrowserGetSelectedPath(m)
                    IF btnSelectedPath <> "" THEN
                        m.DialogMode = DIALOG_NONE
                        DIM btnProj AS VDBProject
                        DIM btnLoadErr AS STRING
                        btnProj, btnLoadErr = LoadProject(btnSelectedPath)
                        IF btnLoadErr <> "" THEN
                            m.Message = "Error: " & btnLoadErr
                        ELSE
                            m.Project = btnProj
                            m.ProjectLoaded = TRUE
                            m.CurrentFormIdx = 0
                            m.SelectedCtrlIdx = -1
                            m.TreeIndex = 0
                            m.TreeExpanded = []BOOLEAN{}
                            m = EnsureTreeExpanded(m)
                            m.Message = "Loaded: " & btnSelectedPath
                        ENDIF
                    ELSE
                        m.Message = "No file selected"
                    ENDIF
                ELSE
                    ' Cancel button
                    m.DialogMode = DIALOG_NONE
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF

        RETURN m, NIL
    ENDIF

    ' Confirmation dialog
    IF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        IF key = "y" OR key = "Y" THEN
            RETURN m, tea.Quit
        ELSEIF key = "n" OR key = "N" THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Text input dialogs
    IF key = "enter" THEN
        IF m.DialogMode = DIALOG_NEW_PROJECT THEN
            m.Project = NewProject(m.DialogInput)
            m.ProjectLoaded = TRUE
            m.CurrentFormIdx = 0
            m.SelectedCtrlIdx = -1
            m.TreeIndex = 0
            m.TreeExpanded = []BOOLEAN{}
            m = EnsureTreeExpanded(m)
            m.Message = "New project: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_FORM THEN
            DIM addForm AS VDBForm
            addForm = NewForm(m.DialogInput)
            m.Project.Forms = APPEND(m.Project.Forms, addForm)
            m.CurrentFormIdx = Len(m.Project.Forms) - 1
            m.SelectedCtrlIdx = -1
            m.TreeExpanded = APPEND(m.TreeExpanded, TRUE)
            m.Project.Modified = TRUE
            m.Message = "New form: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_MODULE THEN
            DIM addMod AS VDBModule
            addMod = NewModule(m.DialogInput)
            m.Project.Modules = APPEND(m.Project.Modules, addMod)
            m.Project.Modified = TRUE
            m.Message = "New module: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_SAVE_PROJECT THEN
            ' Sync code editor content before saving
            IF m.CodeEditorInited AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            ENDIF
            SaveProject(@m.Project, m.DialogInput)
            m.Message = "Project saved: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_OPEN_PROJECT THEN
            ' Legacy text input handler (now using file browser instead)
            DIM legacyProj AS VDBProject
            DIM legacyErr AS STRING
            legacyProj, legacyErr = LoadProject(m.DialogInput)
            IF legacyErr = "" THEN
                m.Project = legacyProj
                m.ProjectLoaded = TRUE
                m.CurrentFormIdx = 0
                m.SelectedCtrlIdx = -1
                m.TreeIndex = 0
                m.TreeExpanded = []BOOLEAN{}
                m = EnsureTreeExpanded(m)
                m.Message = "Project loaded: " & legacyProj.Name
            ELSE
                m.ErrorMsg = legacyErr
                m.Message = "Failed to load project"
            ENDIF
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_SAVE_AS THEN
            ' Sync code editor content before saving
            IF m.CodeEditorInited AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            ENDIF
            DIM savePath AS STRING = m.DialogInput
            IF m.SaveAsWidget THEN
                ' Save to plugins/widgets/ directory
                savePath = "plugins/widgets/" & m.DialogInput
                SaveProjectAsWidget(@m.Project, savePath)
                m.Message = "Widget saved: " & savePath
            ELSE
                ' Regular save
                SaveProject(@m.Project, savePath)
                m.Message = "Project saved: " & savePath
            ENDIF
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Save As dialog: Tab toggles checkbox, Space toggles if on checkbox
    IF m.DialogMode = DIALOG_SAVE_AS THEN
        IF key = "tab" THEN
            m.DialogField = 1 - m.DialogField  ' Toggle between 0 (filename) and 1 (checkbox)
            RETURN m, NIL
        ELSEIF key = " " AND m.DialogField = 1 THEN
            m.SaveAsWidget = NOT m.SaveAsWidget
            RETURN m, NIL
        ELSEIF m.DialogField = 1 THEN
            ' When checkbox has focus, only allow tab and space
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Handle text editing keys
    DIM textLen AS INTEGER = Len(m.DialogInput)

    IF key = "left" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "right" THEN
        IF m.DialogCursor < textLen THEN
            m.DialogCursor = m.DialogCursor + 1
        ENDIF
    ELSEIF key = "home" OR key = "ctrl+a" THEN
        m.DialogCursor = 0
    ELSEIF key = "end" OR key = "ctrl+e" THEN
        m.DialogCursor = textLen
    ELSEIF key = "ctrl+left" THEN
        ' Move to previous word
        DO WHILE m.DialogCursor > 0 AND Mid(m.DialogInput, m.DialogCursor, 1) = " "
            m.DialogCursor = m.DialogCursor - 1
        LOOP
        DO WHILE m.DialogCursor > 0 AND Mid(m.DialogInput, m.DialogCursor, 1) <> " "
            m.DialogCursor = m.DialogCursor - 1
        LOOP
    ELSEIF key = "ctrl+right" THEN
        ' Move to next word
        DO WHILE m.DialogCursor < textLen AND Mid(m.DialogInput, m.DialogCursor + 1, 1) <> " "
            m.DialogCursor = m.DialogCursor + 1
        LOOP
        DO WHILE m.DialogCursor < textLen AND Mid(m.DialogInput, m.DialogCursor + 1, 1) = " "
            m.DialogCursor = m.DialogCursor + 1
        LOOP
    ELSEIF key = "backspace" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor - 1) & Mid(m.DialogInput, m.DialogCursor + 1, textLen)
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "delete" THEN
        IF m.DialogCursor < textLen THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor) & Mid(m.DialogInput, m.DialogCursor + 2, textLen)
        ENDIF
    ELSEIF key = "ctrl+u" THEN
        ' Delete to start of line
        m.DialogInput = Mid(m.DialogInput, m.DialogCursor + 1, textLen)
        m.DialogCursor = 0
    ELSEIF key = "ctrl+k" THEN
        ' Delete to end of line
        m.DialogInput = Left(m.DialogInput, m.DialogCursor)
    ELSEIF Len(key) = 1 THEN
        ' Insert printable character
        m.DialogInput = Left(m.DialogInput, m.DialogCursor) & key & Mid(m.DialogInput, m.DialogCursor + 1, textLen)
        m.DialogCursor = m.DialogCursor + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.MenuOpen = MENU_NONE
        RETURN m, NIL
    ELSEIF key = "left" THEN
        m.MenuOpen = m.MenuOpen - 1
        IF m.MenuOpen < MENU_FILE THEN
            m.MenuOpen = MENU_HELP
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "right" THEN
        m.MenuOpen = m.MenuOpen + 1
        IF m.MenuOpen > MENU_HELP THEN
            m.MenuOpen = MENU_FILE
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "up" THEN
        m.MenuIndex = m.MenuIndex - 1
        IF m.MenuIndex < 0 THEN
            m.MenuIndex = GetMenuItemCount(m.MenuOpen) - 1
        ENDIF
        RETURN m, NIL
    ELSEIF key = "down" THEN
        m.MenuIndex = m.MenuIndex + 1
        IF m.MenuIndex >= GetMenuItemCount(m.MenuOpen) THEN
            m.MenuIndex = 0
        ENDIF
        RETURN m, NIL
    ELSEIF key = "enter" THEN
        RETURN ExecuteMenuItem(m)
    ENDIF

    ' Check for hotkey selection (single character keys)
    IF Len(key) = 1 THEN
        DIM hotKeyIdx AS INTEGER = GetMenuHotkeyIndex(m.MenuOpen, key)
        IF hotKeyIdx >= 0 THEN
            m.MenuIndex = hotKeyIdx
            RETURN ExecuteMenuItem(m)
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' Get menu item index for a hotkey character, returns -1 if not found
FUNCTION GetMenuHotkeyIndex(menu AS INTEGER, key AS STRING) AS INTEGER
    DIM upperKey AS STRING = UCase(key)

    IF menu = MENU_FILE THEN
        IF upperKey = "N" THEN
            RETURN 0  ' New Project
        ELSEIF upperKey = "O" THEN
            RETURN 1  ' Open Project
        ELSEIF upperKey = "S" THEN
            RETURN 2  ' Save Project
        ELSEIF upperKey = "F" THEN
            RETURN 4  ' New Form
        ELSEIF upperKey = "M" THEN
            RETURN 5  ' New Module
        ELSEIF upperKey = "X" THEN
            RETURN 7  ' Exit
        ENDIF
    ELSEIF menu = MENU_EDIT THEN
        IF upperKey = "T" THEN
            RETURN 0  ' Cut
        ELSEIF upperKey = "C" THEN
            RETURN 1  ' Copy
        ELSEIF upperKey = "P" THEN
            RETURN 2  ' Paste
        ELSEIF upperKey = "A" THEN
            RETURN 4  ' Select All
        ELSEIF upperKey = "D" THEN
            RETURN 5  ' Delete
        ELSEIF upperKey = "M" THEN
            RETURN 7  ' Menu Editor
        ENDIF
    ELSEIF menu = MENU_VIEW THEN
        IF upperKey = "F" THEN
            RETURN 0  ' Form View
        ELSEIF upperKey = "C" THEN
            RETURN 1  ' Code View
        ELSEIF upperKey = "G" THEN
            RETURN 3  ' Show Grid
        ELSEIF upperKey = "L" THEN
            RETURN 4  ' Line Numbers
        ELSEIF upperKey = "O" THEN
            RETURN 6  ' Object Browser
        ENDIF
    ELSEIF menu = MENU_RUN THEN
        IF upperKey = "R" THEN
            RETURN 0  ' Run
        ELSEIF upperKey = "B" THEN
            RETURN 1  ' Build
        ELSEIF upperKey = "S" THEN
            RETURN 3  ' Set Startup
        ENDIF
    ELSEIF menu = MENU_DEBUG THEN
        IF upperKey = "S" THEN
            RETURN 0  ' Step
        ELSEIF upperKey = "B" THEN
            RETURN 1  ' Breakpoint
        ELSEIF upperKey = "W" THEN
            RETURN 2  ' Watch
        ELSEIF upperKey = "C" THEN
            RETURN 4  ' Clear All
        ENDIF
    ELSEIF menu = MENU_OPTIONS THEN
        IF upperKey = "E" THEN
            RETURN 0  ' Environment (first match)
        ELSEIF upperKey = "D" THEN
            RETURN 1  ' Editor (use 'd' since 'E' is taken)
        ELSEIF upperKey = "C" THEN
            RETURN 3  ' Colors
        ENDIF
    ELSEIF menu = MENU_HELP THEN
        IF upperKey = "H" THEN
            RETURN 0  ' Help
        ELSEIF upperKey = "A" THEN
            RETURN 1  ' About
        ENDIF
    ENDIF

    RETURN -1
END FUNCTION

FUNCTION GetMenuItemCount(menu AS INTEGER) AS INTEGER
    IF menu = MENU_FILE THEN
        RETURN 9
    ELSEIF menu = MENU_EDIT THEN
        RETURN 8
    ELSEIF menu = MENU_VIEW THEN
        RETURN 7
    ELSEIF menu = MENU_RUN THEN
        RETURN 4
    ELSEIF menu = MENU_DEBUG THEN
        RETURN 5
    ELSEIF menu = MENU_OPTIONS THEN
        RETURN 5
    ELSEIF menu = MENU_HELP THEN
        RETURN 2
    ENDIF
    RETURN 0
END FUNCTION

FUNCTION ExecuteMenuItem(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    DIM currentMenu AS INTEGER = m.MenuOpen
    m.MenuOpen = MENU_NONE

    IF currentMenu = MENU_FILE THEN
        IF m.MenuIndex = 0 THEN
            ' New Project
            m.DialogMode = DIALOG_NEW_PROJECT
            m.DialogInput = "Project1"
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 1 THEN
            ' Open Project - use file browser
            InitFileBrowser(@m, "Open Project", "*.vdbp")
        ELSEIF m.MenuIndex = 2 THEN
            ' Save Project
            ' First sync code editor content to form if in code view
            IF m.CodeEditorInited AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            ENDIF
            IF Len(m.Project.Path) = 0 THEN
                m.DialogMode = DIALOG_SAVE_PROJECT
                m.DialogInput = m.Project.Name & ".vdb"
                m.DialogCursor = Len(m.DialogInput)
            ELSE
                SaveProject(@m.Project, m.Project.Path)
                m.Message = "Project saved"
            ENDIF
        ELSEIF m.MenuIndex = 3 THEN
            ' Save As
            m.DialogMode = DIALOG_SAVE_AS
            m.DialogInput = m.Project.Name & ".vdbp"
            m.DialogCursor = Len(m.DialogInput)
            m.SaveAsWidget = FALSE
            m.DialogField = 0
        ELSEIF m.MenuIndex = 5 THEN
            ' New Form
            m.DialogMode = DIALOG_NEW_FORM
            m.DialogInput = "Form" & Str(Len(m.Project.Forms) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 6 THEN
            ' New Module
            m.DialogMode = DIALOG_NEW_MODULE
            m.DialogInput = "Module" & Str(Len(m.Project.Modules) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 8 THEN
            ' Exit
            IF m.Project.Modified THEN
                m.DialogMode = DIALOG_CONFIRM_EXIT
            ELSE
                RETURN m, tea.Quit
            ENDIF
        ENDIF
    ELSEIF currentMenu = MENU_EDIT THEN
        IF m.MenuIndex = 7 THEN
            ' Menu Editor
            m.DialogMode = DIALOG_MENU_EDITOR
        ENDIF
    ELSEIF currentMenu = MENU_VIEW THEN
        IF m.MenuIndex = 0 THEN
            m.ViewMode = VIEW_FORM
        ELSEIF m.MenuIndex = 1 THEN
            m.ViewMode = VIEW_CODE
        ELSEIF m.MenuIndex = 3 THEN
            m.ShowGrid = NOT m.ShowGrid
        ELSEIF m.MenuIndex = 6 THEN
            m.DialogMode = DIALOG_OBJECT_BROWSER
            m.ObjectBrowserScroll = 0
            m.ObjectBrowserTab = 0
            m.ObjectBrowserWidgetIdx = 0
        ENDIF
    ELSEIF currentMenu = MENU_RUN THEN
        IF m.MenuIndex = 0 THEN
            RETURN DoRun(m)
        ELSEIF m.MenuIndex = 1 THEN
            RETURN DoBuild(m)
        ENDIF
    ELSEIF currentMenu = MENU_OPTIONS THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_ENVIRONMENT
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_EDITOR
        ELSEIF m.MenuIndex = 2 THEN
            ' Initialize theme editor
            m.DialogMode = DIALOG_THEME_EDITOR
            m.ThemeEditorIndex = 0
            m.ThemeEditorPropIdx = 0
            m.ThemeEditorScroll = 0
            m.ThemeEditorColIdx = 0
            m.ThemeEditingTheme = m.Project.Theme
        ELSEIF m.MenuIndex = 4 THEN
            m.DialogMode = DIALOG_COLORS
        ENDIF
    ELSEIF currentMenu = MENU_HELP THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_HELP
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_ABOUT
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle input for Widgets panel (visible widgets: Button, Label, TextBox, etc.)
FUNCTION HandleWidgetsInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    DIM visibleRows AS INTEGER = m.WidgetsHeight - 1  ' Minus title row
    IF visibleRows < 1 THEN
        visibleRows = 1
    ENDIF

    IF key = "up" THEN
        IF m.WidgetsIndex > 0 THEN
            m.WidgetsIndex = m.WidgetsIndex - 1
            ' Scroll up if selection is above visible area
            IF m.WidgetsIndex < m.WidgetsScroll THEN
                m.WidgetsScroll = m.WidgetsIndex
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.WidgetsIndex < VISIBLE_WIDGET_COUNT - 1 THEN
            m.WidgetsIndex = m.WidgetsIndex + 1
            ' Scroll down if selection is below visible area
            IF m.WidgetsIndex >= m.WidgetsScroll + visibleRows THEN
                m.WidgetsScroll = m.WidgetsIndex - visibleRows + 1
            ENDIF
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Add visible control to form
        IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            ' Map widget index to control type (handles all visible widgets including DirBrowser)
            DIM ctlType AS INTEGER = WidgetIndexToCtrlType(m.WidgetsIndex)
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM ctrl AS VDBControl = NewControl(ctlType, ctlName, 5, 5)
            ctrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID

            ' Apply theme colors if UseTheme is enabled
            IF m.Project.UseTheme THEN
                DIM foreColor AS INTEGER
                DIM backColor AS INTEGER
                foreColor, backColor = GetThemeColorsForControl(m.Project.Theme, ctlType)
                ctrl.ForeColor = foreColor
                ctrl.BackColor = backColor
            ENDIF

            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, ctrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.FocusArea = FOCUS_FORM
            m.Message = "Added " & ctlName
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

' Handle input for Toolbox panel (non-visible widgets: Timer)
FUNCTION HandleToolboxInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    DIM visibleRows AS INTEGER = m.ToolboxHeight - 1  ' Minus title row
    IF visibleRows < 1 THEN
        visibleRows = 1
    ENDIF

    IF key = "up" THEN
        IF m.ToolboxIndex > 0 THEN
            m.ToolboxIndex = m.ToolboxIndex - 1
            ' Scroll up if selection is above visible area
            IF m.ToolboxIndex < m.ToolboxScroll THEN
                m.ToolboxScroll = m.ToolboxIndex
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.ToolboxIndex < NONVISIBLE_WIDGET_COUNT - 1 THEN
            m.ToolboxIndex = m.ToolboxIndex + 1
            ' Scroll down if selection is below visible area
            IF m.ToolboxIndex >= m.ToolboxScroll + visibleRows THEN
                m.ToolboxScroll = m.ToolboxIndex - visibleRows + 1
            ENDIF
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Add non-visible control to form
        IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            ' Non-visible widgets start at CTRL_TIMER (11)
            DIM ctlType AS INTEGER = CTRL_TIMER + m.ToolboxIndex
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM ctrl AS VDBControl = NewControl(ctlType, ctlName, 0, 0)
            ctrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.Width = 3
            ctrl.Height = 1

            ' Apply theme colors if UseTheme is enabled
            IF m.Project.UseTheme THEN
                DIM foreColor AS INTEGER
                DIM backColor AS INTEGER
                foreColor, backColor = GetThemeColorsForControl(m.Project.Theme, ctlType)
                ctrl.ForeColor = foreColor
                ctrl.BackColor = backColor
            ENDIF

            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, ctrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.Message = "Added " & ctlName
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)

    IF key = "up" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "down" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "left" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "right" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "pgup" THEN
        ' Select previous control
        IF m.SelectedCtrlIdx > 0 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx - 1
        ENDIF
    ELSEIF key = "pgdown" THEN
        ' Select next control
        IF m.SelectedCtrlIdx < ctrlCount - 1 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx + 1
        ENDIF
    ELSEIF key = "delete" THEN
        ' Delete selected control
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            DIM newControls AS []VDBControl
            DIM i AS INTEGER
            FOR i = 0 TO ctrlCount - 1
                IF i <> m.SelectedCtrlIdx THEN
                    newControls = APPEND(newControls, m.Project.Forms[m.CurrentFormIdx].Controls[i])
                ENDIF
            NEXT
            m.Project.Forms[m.CurrentFormIdx].Controls = newControls
            IF m.SelectedCtrlIdx >= Len(newControls) THEN
                m.SelectedCtrlIdx = Len(newControls) - 1
            ENDIF
            m.Project.Modified = TRUE
            m.Message = "Control deleted"
        ENDIF
    ELSEIF key = "+" THEN
        ' Increase width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "-" THEN
        ' Decrease width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width > 1 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width - 1
                m.Project.Modified = TRUE
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    ' Legacy manual code handling (textarea handles input via HandleCodeInputMsg)
    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)
    DIM currentLine AS STRING = GetLine(code, m.CodeCursorY + 1)
    DIM lineLen AS INTEGER = Len(currentLine)

    IF key = "left" THEN
        IF m.CodeCursorX > 0 THEN
            m.CodeCursorX = m.CodeCursorX - 1
        ELSEIF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = Len(GetLine(code, m.CodeCursorY + 1))
        ENDIF
    ELSEIF key = "right" THEN
        IF m.CodeCursorX < lineLen THEN
            m.CodeCursorX = m.CodeCursorX + 1
        ELSEIF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            m.CodeCursorX = 0
        ENDIF
    ELSEIF key = "up" THEN
        IF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            DIM upLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > upLineLen THEN
                m.CodeCursorX = upLineLen
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            DIM downLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > downLineLen THEN
                m.CodeCursorX = downLineLen
            ENDIF
        ENDIF
    ELSEIF key = "home" THEN
        m.CodeCursorX = 0
    ELSEIF key = "end" THEN
        m.CodeCursorX = lineLen
    ELSEIF key = "enter" THEN
        ' Insert new line
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeNewLine(code, m.CodeCursorY + 1, m.CodeCursorX)
        m.CodeCursorY = m.CodeCursorY + 1
        m.CodeCursorX = 0
        m.Project.Modified = TRUE
    ELSEIF key = "backspace" THEN
        IF m.CodeCursorX > 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Code = DeleteCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX - 1)
            m.CodeCursorX = m.CodeCursorX - 1
            m.Project.Modified = TRUE
        ELSEIF m.CodeCursorY > 0 THEN
            DIM prevLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY))
            m.Project.Forms[m.CurrentFormIdx].Code = JoinCodeWithPrevLine(code, m.CodeCursorY + 1)
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = prevLineLen
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF Len(key) = 1 THEN
        ' Insert character
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX, key)
        m.CodeCursorX = m.CodeCursorX + 1
        m.Project.Modified = TRUE
    ENDIF

    ' Update scroll position
    DIM visibleLines AS INTEGER = m.Height - 6
    IF m.CodeCursorY < m.CodeScrollY THEN
        m.CodeScrollY = m.CodeCursorY
    ELSEIF m.CodeCursorY >= m.CodeScrollY + visibleLines THEN
        m.CodeScrollY = m.CodeCursorY - visibleLines + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle code input with raw message for textarea
FUNCTION HandleCodeInputMsg(m AS VDBTermModel, msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    IF NOT m.CodeEditorInited THEN
        ' Fall back to string-based handler
        DIM keyMsg AS tea.KeyPressMsg
        DIM ok AS BOOLEAN
        keyMsg, ok = msg.(tea.KeyPressMsg)
        IF ok THEN
            RETURN HandleCodeInput(m, keyMsg.String())
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Check for special keys before passing to textarea
    DIM specialKeyMsg AS tea.KeyPressMsg
    DIM specialKeyOk AS BOOLEAN
    specialKeyMsg, specialKeyOk = msg.(tea.KeyPressMsg)
    IF specialKeyOk THEN
        DIM specialKey AS STRING = specialKeyMsg.String()
        DIM keystroke AS STRING = specialKeyMsg.Keystroke()


        ' Tab - insert spaces manually since textarea doesn't handle it
        IF specialKey = "tab" THEN
            ' If selection active, delete it first then insert
            IF m.CodeSelecting THEN
                DIM tabCode AS STRING = GetEditorCode(m.CodeEditor)
                tabCode = DeleteSelectedText(tabCode, m)
                m.CodeEditor.SetValue(tabCode)
                ClearSelection(@m)
            ENDIF
            DIM spaces AS STRING = RepeatStr(" ", m.TabSize)
            m.CodeEditor.InsertString(spaces)
            m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            m.Project.Modified = TRUE
            m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
            m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
            RETURN m, NIL
        ENDIF

        ' === SELECTION KEYS (Shift+arrow, Shift+Home/End) ===
        ' Use direct textarea cursor methods to move, then track selection

        IF specialKey = "shift+right" OR keystroke = "shift+right" THEN
            StartSelection(@m)
            DIM srLineLen AS INTEGER = Len(GetCachedLine(m.CodeCursorY))
            IF m.CodeCursorX < srLineLen THEN
                m.CodeCursorX = m.CodeCursorX + 1
            ELSEIF m.CodeCursorY < gCodeLineCount - 1 THEN
                m.CodeCursorY = m.CodeCursorY + 1
                m.CodeCursorX = 0
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        IF specialKey = "shift+left" OR keystroke = "shift+left" THEN
            StartSelection(@m)
            IF m.CodeCursorX > 0 THEN
                m.CodeCursorX = m.CodeCursorX - 1
            ELSEIF m.CodeCursorY > 0 THEN
                m.CodeCursorY = m.CodeCursorY - 1
                m.CodeCursorX = Len(GetCachedLine(m.CodeCursorY))
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        IF specialKey = "shift+up" OR keystroke = "shift+up" THEN
            StartSelection(@m)
            IF m.CodeCursorY > 0 THEN
                m.CodeCursorY = m.CodeCursorY - 1
                m.CodeCursorX = ClampCol(m.CodeCursorY, m.CodeCursorX)
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        IF specialKey = "shift+down" OR keystroke = "shift+down" THEN
            StartSelection(@m)
            IF m.CodeCursorY < gCodeLineCount - 1 THEN
                m.CodeCursorY = m.CodeCursorY + 1
                m.CodeCursorX = ClampCol(m.CodeCursorY, m.CodeCursorX)
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        IF specialKey = "shift+home" OR keystroke = "shift+home" THEN
            StartSelection(@m)
            m.CodeCursorX = 0
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        IF specialKey = "shift+end" OR keystroke = "shift+end" THEN
            StartSelection(@m)
            m.CodeCursorX = Len(GetCachedLine(m.CodeCursorY))
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Shift+Right - select word right
        IF keystroke = "ctrl+shift+right" THEN
            StartSelection(@m)
            DIM wrLine AS INTEGER
            DIM wrCol AS INTEGER
            wrLine, wrCol = WordRight(m.CodeCursorY, m.CodeCursorX)
            m.CodeCursorY = wrLine
            m.CodeCursorX = wrCol
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Shift+Left - select word left
        IF keystroke = "ctrl+shift+left" THEN
            StartSelection(@m)
            DIM wlLine AS INTEGER
            DIM wlCol AS INTEGER
            wlLine, wlCol = WordLeft(m.CodeCursorY, m.CodeCursorX)
            m.CodeCursorY = wlLine
            m.CodeCursorX = wlCol
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Shift+Home - select to beginning of document
        IF keystroke = "ctrl+shift+home" THEN
            StartSelection(@m)
            m.CodeCursorY = 0
            m.CodeCursorX = 0
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Shift+End - select to end of document
        IF keystroke = "ctrl+shift+end" THEN
            StartSelection(@m)
            IF gCodeLineCount > 0 THEN
                m.CodeCursorY = gCodeLineCount - 1
                m.CodeCursorX = Len(GetCachedLine(m.CodeCursorY))
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Up - select line up (terminal can't send ctrl+shift+up)
        IF keystroke = "ctrl+shift+up" OR keystroke = "ctrl+up" OR specialKey = "ctrl+up" THEN
            StartSelection(@m)
            IF m.CodeCursorY > 0 THEN
                m.CodeCursorY = m.CodeCursorY - 1
                m.CodeCursorX = ClampCol(m.CodeCursorY, m.CodeCursorX)
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Down - select line down (terminal can't send ctrl+shift+down)
        IF keystroke = "ctrl+shift+down" OR keystroke = "ctrl+down" OR specialKey = "ctrl+down" THEN
            StartSelection(@m)
            IF m.CodeCursorY < gCodeLineCount - 1 THEN
                m.CodeCursorY = m.CodeCursorY + 1
                m.CodeCursorX = ClampCol(m.CodeCursorY, m.CodeCursorX)
            ENDIF
            UpdateSelectionEnd(@m)
            RETURN m, NIL
        ENDIF

        ' Ctrl+Right - word right (no selection)
        IF keystroke = "ctrl+right" OR specialKey = "ctrl+right" THEN
            IF m.CodeSelecting THEN ClearSelection(@m)
            DIM crLine AS INTEGER
            DIM crCol AS INTEGER
            crLine, crCol = WordRight(m.CodeCursorY, m.CodeCursorX)
            m.CodeCursorY = crLine
            m.CodeCursorX = crCol
            RETURN m, NIL
        ENDIF

        ' Ctrl+Left - word left (no selection)
        IF keystroke = "ctrl+left" OR specialKey = "ctrl+left" THEN
            IF m.CodeSelecting THEN ClearSelection(@m)
            DIM clLine AS INTEGER
            DIM clCol AS INTEGER
            clLine, clCol = WordLeft(m.CodeCursorY, m.CodeCursorX)
            m.CodeCursorY = clLine
            m.CodeCursorX = clCol
            RETURN m, NIL
        ENDIF

        ' Ctrl+A - select all
        IF specialKey = "ctrl+a" THEN
            DIM allCode AS STRING = GetEditorCode(m.CodeEditor)
            DIM allLines AS []STRING = SplitStr(allCode, Chr(10))
            m.CodeSelecting = TRUE
            m.CodeSelStartX = 0
            m.CodeSelStartY = 0
            IF Len(allLines) > 0 THEN
                m.CodeSelEndY = Len(allLines) - 1
                m.CodeSelEndX = Len(allLines[Len(allLines) - 1])
            ELSE
                m.CodeSelEndY = 0
                m.CodeSelEndX = 0
            ENDIF
            m.Message = "All code selected"
            RETURN m, NIL
        ENDIF

        ' === CLIPBOARD KEYS (selection-aware) ===

        ' Ctrl+C - copy selection (or current line if no selection)
        IF specialKey = "ctrl+c" THEN
            DIM copyCode AS STRING = GetEditorCode(m.CodeEditor)
            IF m.CodeSelecting THEN
                DIM selText AS STRING = GetSelectedText(copyCode, m)
                IF Len(selText) > 0 THEN
                    CopyToClipboard(selText)
                    m.Message = "Selection copied"
                ENDIF
            ELSE
                DIM codeLines AS []STRING = SplitStr(copyCode, Chr(10))
                DIM currentLine AS INTEGER = GetEditorCursorLine(m.CodeEditor)
                IF currentLine >= 0 AND currentLine < Len(codeLines) THEN
                    CopyToClipboard(codeLines[currentLine])
                    m.Message = "Line copied"
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Ctrl+X - cut selection (or current line if no selection)
        IF specialKey = "ctrl+x" THEN
            DIM cutCode AS STRING = GetEditorCode(m.CodeEditor)
            IF m.CodeSelecting THEN
                DIM cutText AS STRING = GetSelectedText(cutCode, m)
                IF Len(cutText) > 0 THEN
                    CopyToClipboard(cutText)
                    cutCode = DeleteSelectedText(cutCode, m)
                    m.CodeEditor.SetValue(cutCode)
                    ClearSelection(@m)
                    m.Project.Forms[m.CurrentFormIdx].Code = cutCode
                    m.Project.Modified = TRUE
                    m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
                    m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
                    m.Message = "Selection cut"
                ENDIF
            ELSE
                ' Cut entire current line
                DIM cutLines AS []STRING = SplitStr(cutCode, Chr(10))
                DIM cutLineIdx AS INTEGER = GetEditorCursorLine(m.CodeEditor)
                IF cutLineIdx >= 0 AND cutLineIdx < Len(cutLines) THEN
                    CopyToClipboard(cutLines[cutLineIdx])
                    ' Remove the line
                    DIM newLines AS []STRING
                    DIM cli AS INTEGER
                    FOR cli = 0 TO Len(cutLines) - 1
                        IF cli <> cutLineIdx THEN
                            newLines = APPEND(newLines, cutLines[cli])
                        ENDIF
                    NEXT
                    DIM newCutCode AS STRING = strings.Join(newLines, Chr(10))
                    m.CodeEditor.SetValue(newCutCode)
                    m.Project.Forms[m.CurrentFormIdx].Code = newCutCode
                    m.Project.Modified = TRUE
                    m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
                    m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
                    m.Message = "Line cut"
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Ctrl+Shift+C - copy all code to clipboard
        IF specialKey = "ctrl+shift+c" THEN
            DIM allCodeToCopy AS STRING = GetEditorCode(m.CodeEditor)
            CopyToClipboard(allCodeToCopy)
            m.Message = "All code copied to clipboard"
            RETURN m, NIL
        ENDIF

        ' Any non-shift navigation key clears selection
        IF specialKey = "left" OR specialKey = "right" OR specialKey = "up" OR specialKey = "down" OR specialKey = "home" OR specialKey = "end" OR specialKey = "escape" THEN
            IF m.CodeSelecting THEN
                ClearSelection(@m)
            ENDIF
        ENDIF

        ' Typing a character with active selection: delete selection first
        IF m.CodeSelecting THEN
            DIM isTyping AS BOOLEAN = FALSE
            IF Len(specialKey) = 1 THEN
                isTyping = TRUE
            ELSEIF specialKey = "enter" OR specialKey = "backspace" OR specialKey = "delete" THEN
                isTyping = TRUE
            ENDIF
            IF isTyping THEN
                ' Calculate where cursor should go after deletion
                ' (normalized start of selection - the earlier position)
                DIM delStartLine AS INTEGER = m.CodeSelStartY
                DIM delStartCol AS INTEGER = m.CodeSelStartX
                DIM delEndLine AS INTEGER = m.CodeSelEndY
                DIM delEndCol AS INTEGER = m.CodeSelEndX
                IF delStartLine > delEndLine OR (delStartLine = delEndLine AND delStartCol > delEndCol) THEN
                    delStartLine = m.CodeSelEndY
                    delStartCol = m.CodeSelEndX
                ENDIF

                DIM typeCode AS STRING = GetEditorCode(m.CodeEditor)
                typeCode = DeleteSelectedText(typeCode, m)
                m.CodeEditor.SetValue(typeCode)
                ClearSelection(@m)

                ' Reposition cursor to where the selection started
                m.CodeEditor = SetEditorCursor(m.CodeEditor, delStartLine, delStartCol)
                m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
                m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)

                m.Project.Forms[m.CurrentFormIdx].Code = typeCode
                m.Project.Modified = TRUE
                ' For backspace/delete with selection, the delete IS the action
                IF specialKey = "backspace" OR specialKey = "delete" THEN
                    RETURN m, NIL
                ENDIF
                ' For enter/chars, fall through to let textarea handle the insertion
            ENDIF
        ENDIF
    ENDIF

    ' Sync textarea cursor to our tracked position before passing input
    ' (mouse clicks update tracking vars without touching textarea for speed)
    m.CodeEditor = SyncEditorCursorPosition(m.CodeEditor, m.CodeCursorY, m.CodeCursorX)

    ' Get previous code to detect changes
    DIM prevCode AS STRING = GetEditorCode(m.CodeEditor)

    ' Pass raw message to textarea
    DIM cmd AS tea.Cmd
    m.CodeEditor, cmd = HandleEditorKeyInput(m.CodeEditor, msg)

    ' Check if code changed
    DIM newCode AS STRING = GetEditorCode(m.CodeEditor)
    IF newCode <> prevCode THEN
        ' Sync back to form
        m.Project.Forms[m.CurrentFormIdx].Code = newCode
        m.Project.Modified = TRUE
    ENDIF

    ' Update cursor position for status bar and rendering
    m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
    m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)

    RETURN m, cmd
END FUNCTION

FUNCTION HandlePropertiesInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF m.PropEditing THEN
        ' Handle editing mode
        IF key = "enter" OR key = "esc" THEN
            IF key = "enter" THEN
                m = ApplyPropertyEdit(m)
                m.Message = "Property updated"
            ENDIF
            m.PropEditing = FALSE
            m.PropEditValue = ""
            m.PropEditFresh = FALSE
        ELSEIF key = "backspace" THEN
            IF m.PropEditFresh THEN
                ' Backspace on fresh edit clears all
                m.PropEditValue = ""
                m.PropEditFresh = FALSE
            ELSEIF Len(m.PropEditValue) > 0 THEN
                m.PropEditValue = Left(m.PropEditValue, Len(m.PropEditValue) - 1)
            ENDIF
        ELSEIF key = "left" OR key = "right" OR key = "home" OR key = "end" THEN
            ' Arrow keys deselect (keep value, allow editing)
            m.PropEditFresh = FALSE
        ELSEIF Len(key) = 1 THEN
            ' On first keystroke, clear existing value (like selected text replacement)
            IF m.PropEditFresh THEN
                m.PropEditValue = key
                m.PropEditFresh = FALSE
            ELSE
                m.PropEditValue = m.PropEditValue & key
            ENDIF
        ENDIF
    ELSE
        ' Handle navigation mode
        IF key = "up" THEN
            IF m.PropIndex > 0 THEN
                m.PropIndex = m.PropIndex - 1
            ENDIF
        ELSEIF key = "down" THEN
            ' Limit to valid property range
            DIM maxIdx AS INTEGER = 5  ' Form has 6 properties (0-5)
            IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
                    DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
                    maxIdx = GetControlPropertyCount(ctrl) - 1
                ENDIF
            ENDIF
            IF m.PropIndex < maxIdx THEN
                m.PropIndex = m.PropIndex + 1
            ENDIF
        ELSEIF key = "enter" OR key = "f2" THEN
            ' Start editing - load current value (shown as selected)
            m.PropEditValue = GetCurrentPropertyValue(m)
            IF Len(m.PropEditValue) > 0 OR CanEditProperty(m) THEN
                m.PropEditing = TRUE
                m.PropEditFresh = TRUE
            ENDIF
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION GetCurrentPropertyValue(m AS VDBTermModel) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN ""
    ENDIF

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        ' Type property (index 1) is read-only
        IF m.PropIndex = 1 THEN
            RETURN ""
        ENDIF
        RETURN GetControlPropertyValue(ctrl, m.PropIndex)
    ELSE
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF m.PropIndex = 0 THEN
            RETURN form.Name
        ELSEIF m.PropIndex = 1 THEN
            RETURN form.Caption
        ELSEIF m.PropIndex = 2 THEN
            RETURN Str(form.X)
        ELSEIF m.PropIndex = 3 THEN
            RETURN Str(form.Y)
        ELSEIF m.PropIndex = 4 THEN
            RETURN Str(form.Width)
        ELSEIF m.PropIndex = 5 THEN
            RETURN Str(form.Height)
        ENDIF
    ENDIF
    RETURN ""
END FUNCTION

FUNCTION CanEditProperty(m AS VDBTermModel) AS BOOLEAN
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN FALSE
    ENDIF

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        ' Type property (index 1) is read-only
        IF m.PropIndex = 1 THEN
            RETURN FALSE
        ENDIF
        ' Check if property index is valid for this control type
        RETURN m.PropIndex < GetControlPropertyCount(ctrl)
    ENDIF
    ' Form properties (0-5 are valid)
    RETURN m.PropIndex <= 5
END FUNCTION

FUNCTION ApplyPropertyEdit(m AS VDBTermModel) AS VDBTermModel
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m
    ENDIF

    DIM val AS STRING = m.PropEditValue

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctlType AS INTEGER = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CtlType

        ' Adjust index for controls without Caption
        DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctlType)
        DIM adjIdx AS INTEGER = m.PropIndex
        IF NOT hasCaption AND m.PropIndex >= 2 THEN
            adjIdx = m.PropIndex + 1
        ENDIF

        ' Base properties
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CtlName = val
        ELSEIF hasCaption AND m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Caption = val
        ELSEIF adjIdx = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = ParseIntStr(val)
        ELSEIF adjIdx = 4 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = ParseIntStr(val)
        ELSEIF adjIdx = 5 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = ParseIntStr(val)
        ELSEIF adjIdx = 6 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Height = ParseIntStr(val)
        ELSEIF adjIdx = 7 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Enabled = (val = "True" OR val = "true" OR val = "1")
        ELSEIF adjIdx = 8 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Visible = (val = "True" OR val = "true" OR val = "1")
        ELSEIF adjIdx = 9 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ZOrder = ParseIntStr(val)
        ELSEIF adjIdx = 10 THEN
            DIM newTabIndex AS INTEGER = ParseIntStr(val)
            IF IsTabIndexUsed(m.Project.Forms[m.CurrentFormIdx], newTabIndex, m.SelectedCtrlIdx) THEN
                m.ErrorMsg = "TabIndex " & Str(newTabIndex) & " is already used by another control"
            ELSE
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].TabIndex = newTabIndex
            ENDIF
        ELSEIF adjIdx = 11 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].TabStop = (val = "True" OR val = "true" OR val = "1")
        ELSEIF adjIdx = 12 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ForeColor = ParseIntStr(val)
        ELSEIF adjIdx = 13 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].BackColor = ParseIntStr(val)
        ELSE
            ' Type-specific properties
            DIM typeStartIdx AS INTEGER = 14
            IF NOT hasCaption THEN
                typeStartIdx = 13
            ENDIF
            DIM typeIdx AS INTEGER = m.PropIndex - typeStartIdx
            IF ctlType = CTRL_TEXTBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Placeholder = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CharLimit = ParseIntStr(val)
                ELSEIF typeIdx = 3 THEN
                    IF val = "Normal" OR val = "normal" OR val = "0" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 0
                    ELSEIF val = "Password" OR val = "password" OR val = "1" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 1
                    ELSE
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 2
                    ENDIF
                ELSEIF typeIdx = 4 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Prompt = val
                ELSEIF typeIdx = 5 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CursorBlink = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_LISTBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Items = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Title = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowTitle = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowStatusBar = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 4 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowFilter = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 5 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].InfiniteScrolling = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_COMBOBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Items = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowFilter = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_TIMER THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Interval = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_LABEL THEN
                IF typeIdx = 0 THEN
                    IF val = "Left" OR val = "left" OR val = "0" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_LEFT
                    ELSEIF val = "Center" OR val = "center" OR val = "1" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_CENTER
                    ELSEIF val = "Right" OR val = "right" OR val = "2" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_RIGHT
                    ENDIF
                ENDIF
            ELSEIF ctlType = CTRL_BUTTON THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Border = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_OPTION THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].GroupName = val
                ENDIF
            ELSEIF ctlType = CTRL_HSCROLL OR ctlType = CTRL_VSCROLL THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].MinValue = ParseIntStr(val)
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].MaxValue = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_CHECKBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ENDIF
            ELSEIF ctlType = CTRL_TEXTAREA THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Placeholder = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CharLimit = ParseIntStr(val)
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowLineNumbers = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_PROGRESS THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Total = ParseIntStr(val)
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowPercentage = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_SPINNER THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].SpinnerStyle = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_TABLE THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Columns = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Rows = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowHeaders = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_DIRBROWSER THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].FilePath = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowHidden = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_PATH THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].FilePath = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].LinkedControl = val
                ENDIF
            ELSEIF ctlType = CTRL_DIRECTORIES THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].FilePath = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowHidden = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].LinkedControl = val
                ENDIF
            ELSEIF ctlType = CTRL_FILES THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].FilePath = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowHidden = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Pattern = val
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].LinkedControl = val
                ENDIF
            ELSEIF ctlType = CTRL_CURL THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].URL = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].HttpMethod = val
                ENDIF
            ELSEIF ctlType = CTRL_VIEWPORT THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].SoftWrap = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowLineNumbers = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].MouseWheel = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_CLIPBOARD THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].FallbackEnabled = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ENDIF
        ENDIF
        m.Project.Modified = TRUE
    ELSE
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Name = val
        ELSEIF m.PropIndex = 1 THEN
            m.Project.Forms[m.CurrentFormIdx].Caption = val
        ELSEIF m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].X = ParseIntStr(val)
        ELSEIF m.PropIndex = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Y = ParseIntStr(val)
        ELSEIF m.PropIndex = 4 THEN
            m.Project.Forms[m.CurrentFormIdx].Width = ParseIntStr(val)
        ELSEIF m.PropIndex = 5 THEN
            m.Project.Forms[m.CurrentFormIdx].Height = ParseIntStr(val)
        ELSEIF m.PropIndex = 6 THEN
            m.Project.Forms[m.CurrentFormIdx].ForeColor = ParseIntStr(val)
        ELSEIF m.PropIndex = 7 THEN
            m.Project.Forms[m.CurrentFormIdx].BackColor = ParseIntStr(val)
        ENDIF
        m.Project.Modified = TRUE
    ENDIF

    RETURN m
END FUNCTION

FUNCTION HandleProjectInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    DIM totalItems AS INTEGER = GetTreeItemCount(m)
    DIM visibleRows AS INTEGER = m.ProjectHeight - 1  ' Minus title row
    IF visibleRows < 1 THEN
        visibleRows = 1
    ENDIF

    IF key = "up" THEN
        IF m.TreeIndex > 0 THEN
            m.TreeIndex = m.TreeIndex - 1
            ' Scroll up if selection is above visible area
            IF m.TreeIndex < m.ProjectScroll THEN
                m.ProjectScroll = m.TreeIndex
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.TreeIndex < totalItems - 1 THEN
            m.TreeIndex = m.TreeIndex + 1
            ' Scroll down if selection is below visible area
            IF m.TreeIndex >= m.ProjectScroll + visibleRows THEN
                m.ProjectScroll = m.TreeIndex - visibleRows + 1
            ENDIF
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Get info about selected item
        DIM itemType AS INTEGER
        DIM formIdx AS INTEGER
        DIM ctrlIdx AS INTEGER
        itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, m.TreeIndex)

        IF itemType = 1 THEN
            ' Form: toggle expansion and select it
            IF formIdx < Len(m.TreeExpanded) THEN
                m.TreeExpanded[formIdx] = NOT m.TreeExpanded[formIdx]
            ENDIF
            m.CurrentFormIdx = formIdx
            m.SelectedCtrlIdx = -1
            m.FocusArea = FOCUS_FORM
        ELSEIF itemType = 2 THEN
            ' Control: select it in the form editor
            m.CurrentFormIdx = formIdx
            m.SelectedCtrlIdx = ctrlIdx
            m.FocusArea = FOCUS_FORM
        ENDIF
    ELSEIF key = "left" THEN
        ' Collapse form if on a form row
        DIM itemType2 AS INTEGER
        DIM formIdx2 AS INTEGER
        DIM unused2 AS INTEGER
        itemType2, formIdx2, unused2 = GetTreeItemInfo(m, m.TreeIndex)
        unused2 = unused2  ' Suppress unused warning
        IF itemType2 = 1 AND formIdx2 < Len(m.TreeExpanded) THEN
            m.TreeExpanded[formIdx2] = FALSE
        ENDIF
    ELSEIF key = "right" THEN
        ' Expand form if on a form row
        DIM itemType3 AS INTEGER
        DIM formIdx3 AS INTEGER
        DIM unused3 AS INTEGER
        itemType3, formIdx3, unused3 = GetTreeItemInfo(m, m.TreeIndex)
        unused3 = unused3  ' Suppress unused warning
        IF itemType3 = 1 AND formIdx3 < Len(m.TreeExpanded) THEN
            m.TreeExpanded[formIdx3] = TRUE
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

' ============================================================================
' MOUSE INPUT HANDLER
' ============================================================================

' HandleMouseClick - handles left-click and right-click (Bubble Tea v2 MouseClickMsg)
FUNCTION HandleMouseClick(m AS VDBTermModel, clickMsg AS tea.MouseClickMsg) AS (tea.Model, tea.Cmd)
    DIM x AS INTEGER = Int(clickMsg.X)
    DIM y AS INTEGER = Int(clickMsg.Y)
    ' Calculate layout dimensions (same as View())
    DIM leftPanelWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - leftPanelWidth - propertiesWidth
    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Panel boundaries (relative to content area, after menu bar row)
    DIM widgetsStart AS INTEGER = m.ProjectHeight
    DIM toolboxStart AS INTEGER = m.ProjectHeight + m.WidgetsHeight

    ' Handle left-click
    IF clickMsg.Button = tea.MouseLeft THEN
        ' Row 0 = Menu bar
        IF y = 0 THEN
            RETURN HandleMenuBarClick(m, x)
        ENDIF

        ' If dropdown menu is open, check for menu item click
        IF m.MenuOpen <> MENU_NONE THEN
            DIM dropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM dropWidth AS INTEGER = 20
            DIM dropRow AS INTEGER = y - 1

            IF x >= dropOffset AND x < dropOffset + dropWidth AND dropRow >= 0 THEN
                RETURN HandleDropdownClick(m, dropRow)
            ELSE
                ' Click outside dropdown closes it
                m.MenuOpen = MENU_NONE
                RETURN m, NIL
            ENDIF
        ENDIF

        ' If dialog is open, handle dialog clicks
        IF m.DialogMode <> DIALOG_NONE THEN
            RETURN HandleDialogClick(m, x, y, contentHeight)
        ENDIF

        ' If popup is open, handle popup clicks
        IF m.PopupMode <> POPUP_NONE THEN
            RETURN HandlePopupClick(m, x, y, contentHeight)
        ENDIF

        ' Adjust y for content area (subtract 1 for menu bar)
        DIM contentY AS INTEGER = y - 1

        ' Check which panel was clicked
        IF x < leftPanelWidth THEN
            ' Left column: Project (top) → Widgets (middle) → Toolbox (bottom)
            IF contentY < m.ProjectHeight THEN
                ' Project tree area
                RETURN HandleProjectClick(m, contentY)
            ELSEIF contentY < toolboxStart THEN
                ' Widgets panel area
                DIM widgetsLocalY AS INTEGER = contentY - widgetsStart
                ' Check if clicking on Widgets caption (first row of Widgets area)
                IF widgetsLocalY = 0 THEN
                    ' Start dragging Widgets caption to resize Project/Widgets
                    m.PanelDragging = PANEL_DRAG_WIDGETS
                    m.PanelDragStartY = y
                    m.PanelDragOrigHeight = m.ProjectHeight
                    RETURN m, NIL
                ENDIF
                RETURN HandleWidgetsClick(m, widgetsLocalY, TRUE)
            ELSE
                ' Toolbox panel area
                DIM toolboxLocalY AS INTEGER = contentY - toolboxStart
                ' Check if clicking on Toolbox caption (first row of Toolbox area)
                IF toolboxLocalY = 0 THEN
                    ' Start dragging Toolbox caption to resize Widgets/Toolbox
                    m.PanelDragging = PANEL_DRAG_TOOLBOX
                    m.PanelDragStartY = y
                    m.PanelDragOrigHeight = m.WidgetsHeight
                    RETURN m, NIL
                ENDIF
                RETURN HandleToolboxClick(m, toolboxLocalY)
            ENDIF
        ELSEIF x < leftPanelWidth + contentWidth THEN
            ' Main content area (full height)
            DIM localX AS INTEGER = x - leftPanelWidth
            IF m.ViewMode = VIEW_FORM THEN
                RETURN HandleFormClick(m, localX, contentY)
            ELSE
                ' Code editor: click handling
                m.FocusArea = FOCUS_CODE
                IF m.CodeEditorInited THEN
                    DIM lineNumWidth AS INTEGER = 0
                    IF m.ShowLineNumbers THEN
                        lineNumWidth = 5
                    ENDIF
                    DIM codeClickCol AS INTEGER = localX - lineNumWidth
                    DIM codeClickLine AS INTEGER = contentY

                    ' Adjust for scroll
                    DIM editorContentHeight AS INTEGER = m.Height - 4
                    IF m.CodeCursorY >= editorContentHeight THEN
                        codeClickLine = codeClickLine + (m.CodeCursorY - editorContentHeight + 1)
                    ENDIF

                    IF codeClickCol >= 0 THEN
                        ' Clamp
                        DIM maxLine AS INTEGER = m.CodeEditor.LineCount() - 1
                        IF maxLine < 0 THEN maxLine = 0
                        IF codeClickLine > maxLine THEN codeClickLine = maxLine
                        IF codeClickLine < 0 THEN codeClickLine = 0
                        IF codeClickCol < 0 THEN codeClickCol = 0
                        codeClickCol = ClampCol(codeClickLine, codeClickCol)

                        ' Check if clicking inside existing selection → start text drag
                        IF m.CodeSelecting AND IsInSelectionGlobal(codeClickLine, codeClickCol) THEN
                            m.CodeDraggingText = TRUE
                            m.CodeDropLine = codeClickLine
                            m.CodeDropCol = codeClickCol
                            RETURN m, NIL
                        ENDIF

                        ' Normal click: clear selection, set cursor
                        ClearSelection(@m)
                        m.CodeDraggingText = FALSE
                        m.CodeCursorY = codeClickLine
                        m.CodeCursorX = ClampCol(codeClickLine, codeClickCol)
                        m.CodeSelStartX = m.CodeCursorX
                        m.CodeSelStartY = m.CodeCursorY
                    ENDIF
                    RETURN m, NIL
                ENDIF
                RETURN m, NIL
            ENDIF
        ELSE
            ' Properties panel
            RETURN HandlePropertiesClick(m, contentY)
        ENDIF

    ' Handle right-click for context menus (events popup)
    ELSEIF clickMsg.Button = tea.MouseRight THEN
        ' Close any existing popup first
        m.PopupMode = POPUP_NONE

        ' Adjust y for content area (subtract 1 for menu bar)
        DIM rcContentY AS INTEGER = y - 1

        IF x < leftPanelWidth THEN
            ' Left column: Project tree, Widgets, or Toolbox
            IF rcContentY < m.ProjectHeight THEN
                ' Project tree - check if clicking on a control
                RETURN HandleProjectRightClick(m, rcContentY, x, y)
            ELSEIF rcContentY < toolboxStart THEN
                ' Widgets panel
                DIM rcWidgetsLocalY AS INTEGER = rcContentY - widgetsStart
                RETURN HandleWidgetsRightClick(m, rcWidgetsLocalY, x, y)
            ELSE
                ' Toolbox panel
                DIM rcToolboxLocalY AS INTEGER = rcContentY - toolboxStart
                RETURN HandleToolboxRightClick(m, rcToolboxLocalY, x, y)
            ENDIF
        ELSEIF x < leftPanelWidth + contentWidth THEN
            ' Main content area - form designer
            IF m.ViewMode = VIEW_FORM THEN
                DIM rcLocalX AS INTEGER = x - leftPanelWidth
                RETURN HandleFormRightClick(m, rcLocalX, rcContentY, x, y)
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' HandleMouseRelease - handles mouse release (Bubble Tea v2 MouseReleaseMsg)
FUNCTION HandleMouseRelease(m AS VDBTermModel, releaseMsg AS tea.MouseReleaseMsg) AS (tea.Model, tea.Cmd)
    ' Handle text drag-drop in code editor
    IF m.CodeDraggingText THEN
        m.CodeDraggingText = FALSE
        IF m.CodeSelecting AND m.CodeEditorInited THEN
            ' Check drop position is outside the selection
            IF NOT IsInSelectionGlobal(m.CodeDropLine, m.CodeDropCol) THEN
                DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
                DIM selText AS STRING = GetSelectedText(code, m)
                IF Len(selText) > 0 THEN
                    ' Normalize selection bounds
                    DIM sStartLine AS INTEGER = m.CodeSelStartY
                    DIM sStartCol AS INTEGER = m.CodeSelStartX
                    DIM sEndLine AS INTEGER = m.CodeSelEndY
                    DIM sEndCol AS INTEGER = m.CodeSelEndX
                    IF sStartLine > sEndLine OR (sStartLine = sEndLine AND sStartCol > sEndCol) THEN
                        DIM tmpL AS INTEGER = sStartLine
                        DIM tmpC AS INTEGER = sStartCol
                        sStartLine = sEndLine
                        sStartCol = sEndCol
                        sEndLine = tmpL
                        sEndCol = tmpC
                    ENDIF

                    ' Determine if drop is before or after the selection
                    DIM dropBeforeSel AS BOOLEAN = FALSE
                    IF m.CodeDropLine < sStartLine OR (m.CodeDropLine = sStartLine AND m.CodeDropCol < sStartCol) THEN
                        dropBeforeSel = TRUE
                    ENDIF

                    ' Delete selected text first
                    code = DeleteSelectedText(code, m)

                    ' Adjust drop position if the deletion shifted text
                    DIM adjDropLine AS INTEGER = m.CodeDropLine
                    DIM adjDropCol AS INTEGER = m.CodeDropCol
                    IF NOT dropBeforeSel THEN
                        ' Drop is after selection - adjust for deleted text
                        IF sStartLine = sEndLine THEN
                            ' Single line deletion
                            IF adjDropLine = sStartLine THEN
                                adjDropCol = adjDropCol - (sEndCol - sStartCol)
                            ENDIF
                        ELSE
                            ' Multi-line deletion
                            DIM deletedLines AS INTEGER = sEndLine - sStartLine
                            IF adjDropLine = sEndLine THEN
                                ' Drop was on the last line of selection
                                adjDropLine = sStartLine
                                adjDropCol = sStartCol + (adjDropCol - sEndCol)
                            ELSEIF adjDropLine > sEndLine THEN
                                adjDropLine = adjDropLine - deletedLines
                            ENDIF
                        ENDIF
                    ENDIF

                    ' Insert text at adjusted drop position
                    DIM codeLines AS []STRING = SplitStr(code, Chr(10))
                    IF adjDropLine < 0 THEN adjDropLine = 0
                    IF adjDropLine >= Len(codeLines) THEN adjDropLine = Len(codeLines) - 1
                    IF adjDropCol < 0 THEN adjDropCol = 0

                    DIM dropLineText AS STRING = ""
                    IF adjDropLine < Len(codeLines) THEN
                        dropLineText = codeLines[adjDropLine]
                    ENDIF
                    IF adjDropCol > Len(dropLineText) THEN
                        adjDropCol = Len(dropLineText)
                    ENDIF

                    DIM beforeDrop AS STRING = Left(dropLineText, adjDropCol)
                    DIM afterDrop AS STRING = ""
                    IF adjDropCol < Len(dropLineText) THEN
                        afterDrop = Mid(dropLineText, adjDropCol + 1, Len(dropLineText) - adjDropCol)
                    ENDIF
                    codeLines[adjDropLine] = beforeDrop & selText & afterDrop

                    DIM newCode AS STRING = strings.Join(codeLines, Chr(10))
                    m.CodeEditor.SetValue(newCode)
                    m.Project.Forms[m.CurrentFormIdx].Code = newCode
                    m.Project.Modified = TRUE

                    ' Position cursor at end of dropped text
                    DIM selLines AS []STRING = SplitStr(selText, Chr(10))
                    IF Len(selLines) = 1 THEN
                        m.CodeCursorY = adjDropLine
                        m.CodeCursorX = adjDropCol + Len(selText)
                    ELSE
                        m.CodeCursorY = adjDropLine + Len(selLines) - 1
                        m.CodeCursorX = Len(selLines[Len(selLines) - 1])
                    ENDIF

                    ClearSelection(@m)
                    m.Message = "Text moved"
                ENDIF
            ELSE
                ' Dropped inside selection - just clear drag state
                m.Message = ""
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    IF m.PanelDragging <> PANEL_DRAG_NONE THEN
        ' Apply final panel resize on release (motion events may not fire reliably)
        DIM relY AS INTEGER = Int(releaseMsg.Y)
        DIM relContentHeight AS INTEGER = m.Height - 4
        DIM relDragDelta AS INTEGER = relY - m.PanelDragStartY

        IF m.PanelDragging = PANEL_DRAG_WIDGETS THEN
            DIM relNewPH AS INTEGER = m.PanelDragOrigHeight + relDragDelta
            IF relNewPH < 3 THEN
                relNewPH = 3
            ENDIF
            DIM relMaxPH AS INTEGER = relContentHeight - 3 - m.ToolboxHeight
            IF relNewPH > relMaxPH THEN
                relNewPH = relMaxPH
            ENDIF
            DIM relDeltaPH AS INTEGER = relNewPH - m.ProjectHeight
            m.ProjectHeight = relNewPH
            m.WidgetsHeight = m.WidgetsHeight - relDeltaPH
            IF m.WidgetsHeight < 3 THEN
                m.WidgetsHeight = 3
            ENDIF
        ELSEIF m.PanelDragging = PANEL_DRAG_TOOLBOX THEN
            DIM relNewWH AS INTEGER = m.PanelDragOrigHeight + relDragDelta
            IF relNewWH < 3 THEN
                relNewWH = 3
            ENDIF
            DIM relMaxWH AS INTEGER = relContentHeight - m.ProjectHeight - 2
            IF relNewWH > relMaxWH THEN
                relNewWH = relMaxWH
            ENDIF
            m.WidgetsHeight = relNewWH
            m.ToolboxHeight = relContentHeight - m.ProjectHeight - m.WidgetsHeight
            IF m.ToolboxHeight < 2 THEN
                m.ToolboxHeight = 2
            ENDIF
        ENDIF

        m.PanelDragging = PANEL_DRAG_NONE
        RETURN m, NIL
    ELSEIF m.IsDragging THEN
        IF m.DraggingForm THEN
            ' Apply the final position to the form
            IF m.ViewMode = VIEW_FORM THEN
                m.Project.Forms[m.CurrentFormIdx].X = m.DragOutlineX
                m.Project.Forms[m.CurrentFormIdx].Y = m.DragOutlineY
                m.Project.Modified = TRUE
            ENDIF
            m.IsDragging = FALSE
            m.DraggingForm = FALSE
            m.Message = "Form moved"
        ELSE
            ' Apply the final outline position to the actual control
            IF m.ViewMode = VIEW_FORM AND m.SelectedCtrlIdx >= 0 THEN
                DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)
                IF m.SelectedCtrlIdx < ctrlCount THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.DragOutlineX
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.DragOutlineY
                    m.Project.Modified = TRUE
                ENDIF
            ENDIF
            m.IsDragging = FALSE
            m.Message = "Control moved"
        ENDIF
    ELSEIF m.IsResizing THEN
        IF m.ResizingForm THEN
            ' Apply the final size to the form
            IF m.ViewMode = VIEW_FORM THEN
                m.Project.Forms[m.CurrentFormIdx].Width = m.DragCtrlWidth
                m.Project.Forms[m.CurrentFormIdx].Height = m.DragCtrlHeight
                m.Project.Modified = TRUE
            ENDIF
            m.IsResizing = FALSE
            m.ResizingForm = FALSE
            m.Message = "Form resized"
        ELSE
            ' Apply the final size to the actual control
            IF m.ViewMode = VIEW_FORM AND m.SelectedCtrlIdx >= 0 THEN
                DIM ctrlCount2 AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)
                IF m.SelectedCtrlIdx < ctrlCount2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.DragOutlineX
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.DragOutlineY
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.DragCtrlWidth
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Height = m.DragCtrlHeight
                    m.Project.Modified = TRUE
                ENDIF
            ENDIF
            m.IsResizing = FALSE
            m.Message = "Control resized"
        ENDIF
    ELSEIF m.DraggingFromWidgets THEN
        ' Drop widget from toolbox onto form
        IF m.ViewMode = VIEW_FORM AND m.DragOutlineX >= 0 AND m.DragOutlineY >= 0 THEN
            DIM ctlType AS INTEGER = m.DragWidgetType
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM newCtrl AS VDBControl = NewControl(ctlType, ctlName, m.DragOutlineX, m.DragOutlineY)
            newCtrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            newCtrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            newCtrl.TabIndex = GetNextTabIndex(m.Project.Forms[m.CurrentFormIdx])
            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, newCtrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.FocusArea = FOCUS_FORM
            m.Message = "Added " & ctlName & " at (" & Str(m.DragOutlineX) & "," & Str(m.DragOutlineY) & ")"
        ELSE
            m.Message = "Drop cancelled - not over form"
        ENDIF
        m.DraggingFromWidgets = FALSE
        m.DragWidgetType = 0
        m.DragOutlineX = -1
        m.DragOutlineY = -1
    ENDIF

    RETURN m, NIL
END FUNCTION

' HandleMouseMotion - handles all mouse motion (Bubble Tea v2 MouseMotionMsg)
FUNCTION HandleMouseMotion(m AS VDBTermModel, motionMsg AS tea.MouseMotionMsg) AS (tea.Model, tea.Cmd)
    DIM x AS INTEGER = Int(motionMsg.X)
    DIM y AS INTEGER = Int(motionMsg.Y)

    ' Calculate layout dimensions (same as View())
    DIM leftPanelWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - leftPanelWidth - propertiesWidth
    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Handle menu hover when a dropdown is open
    IF m.MenuOpen <> MENU_NONE THEN
        IF y = 0 THEN
            ' Hovering over menu bar - switch to hovered menu (only if different)
            DIM newMenu AS INTEGER = m.MenuOpen
            IF x >= 0 AND x < 6 THEN
                newMenu = MENU_FILE
            ELSEIF x >= 6 AND x < 12 THEN
                newMenu = MENU_EDIT
            ELSEIF x >= 12 AND x < 18 THEN
                newMenu = MENU_VIEW
            ELSEIF x >= 18 AND x < 23 THEN
                newMenu = MENU_RUN
            ELSEIF x >= 23 AND x < 30 THEN
                newMenu = MENU_DEBUG
            ELSEIF x >= 30 AND x < 39 THEN
                newMenu = MENU_OPTIONS
            ELSEIF x >= 39 AND x < 46 THEN
                newMenu = MENU_HELP
            ENDIF
            IF newMenu <> m.MenuOpen THEN
                m.MenuOpen = newMenu
                m.MenuIndex = 0
            ENDIF
            RETURN m, NIL
        ELSE
            ' Hovering over dropdown area - highlight hovered item
            DIM hoverDropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM hoverDropWidth AS INTEGER = 20
            DIM hoverDropRow AS INTEGER = y - 1
            IF x >= hoverDropOffset AND x < hoverDropOffset + hoverDropWidth AND hoverDropRow >= 0 THEN
                ' Row 0 = top border, items start at row 1
                DIM hoverItemIdx AS INTEGER = hoverDropRow - 1
                IF hoverItemIdx >= 0 THEN
                    ' Check if this is a separator or border row
                    DIM isSeparator AS BOOLEAN = FALSE
                    DIM menuMaxItems AS INTEGER = GetMenuItemCount(m.MenuOpen)
                    IF hoverItemIdx >= menuMaxItems THEN
                        isSeparator = TRUE
                    ELSEIF m.MenuOpen = MENU_FILE THEN
                        IF hoverItemIdx = 4 OR hoverItemIdx = 7 THEN
                            isSeparator = TRUE
                        ENDIF
                    ELSEIF m.MenuOpen = MENU_EDIT THEN
                        IF hoverItemIdx = 3 OR hoverItemIdx = 6 THEN
                            isSeparator = TRUE
                        ENDIF
                    ELSEIF m.MenuOpen = MENU_VIEW THEN
                        IF hoverItemIdx = 2 OR hoverItemIdx = 5 THEN
                            isSeparator = TRUE
                        ENDIF
                    ELSEIF m.MenuOpen = MENU_RUN THEN
                        IF hoverItemIdx = 2 THEN
                            isSeparator = TRUE
                        ENDIF
                    ELSEIF m.MenuOpen = MENU_DEBUG THEN
                        IF hoverItemIdx = 3 THEN
                            isSeparator = TRUE
                        ENDIF
                    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
                        IF hoverItemIdx = 3 THEN
                            isSeparator = TRUE
                        ENDIF
                    ENDIF
                    IF NOT isSeparator AND hoverItemIdx <> m.MenuIndex THEN
                        m.MenuIndex = hoverItemIdx
                    ENDIF
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Handle mouse drag in code editor (selection drag or text drag-drop)
    IF m.FocusArea = FOCUS_CODE AND m.ViewMode = VIEW_CODE AND m.CodeEditorInited THEN
        IF NOT m.IsDragging AND NOT m.IsResizing AND m.PanelDragging = PANEL_DRAG_NONE AND NOT m.DraggingFromWidgets THEN
            DIM contentY AS INTEGER = y - 1
            DIM localX AS INTEGER = x - leftPanelWidth
            IF localX >= 0 AND localX < contentWidth THEN
                DIM lineNumWidth AS INTEGER = 0
                IF m.ShowLineNumbers THEN
                    lineNumWidth = 5
                ENDIF
                DIM dragCodeCol AS INTEGER = localX - lineNumWidth
                DIM dragCodeLine AS INTEGER = contentY

                ' Adjust for scroll
                DIM editorContentHeight AS INTEGER = m.Height - 4
                IF m.CodeSelStartY >= editorContentHeight THEN
                    dragCodeLine = dragCodeLine + (m.CodeSelStartY - editorContentHeight + 1)
                ENDIF

                IF dragCodeCol >= 0 THEN
                    DIM maxDragLine AS INTEGER = m.CodeEditor.LineCount() - 1
                    IF maxDragLine < 0 THEN maxDragLine = 0
                    IF dragCodeLine > maxDragLine THEN dragCodeLine = maxDragLine
                    IF dragCodeLine < 0 THEN dragCodeLine = 0
                    IF dragCodeCol < 0 THEN dragCodeCol = 0

                    IF m.CodeDraggingText THEN
                        ' Text drag-drop: update drop indicator position
                        m.CodeDropLine = dragCodeLine
                        m.CodeDropCol = ClampCol(dragCodeLine, dragCodeCol)
                    ELSE
                        ' Normal selection drag
                        m.CodeCursorY = dragCodeLine
                        m.CodeCursorX = ClampCol(dragCodeLine, dragCodeCol)
                        m.CodeSelecting = TRUE
                        m.CodeSelEndX = m.CodeCursorX
                        m.CodeSelEndY = m.CodeCursorY
                    ENDIF
                ENDIF
                RETURN m, NIL
            ENDIF
        ENDIF
    ENDIF

    ' Handle panel caption dragging
    IF m.PanelDragging <> PANEL_DRAG_NONE THEN
        DIM dragDelta AS INTEGER = y - m.PanelDragStartY

        IF m.PanelDragging = PANEL_DRAG_WIDGETS THEN
            ' Dragging Widgets caption - moves boundary between Project and Widgets
            ' Project grows/shrinks, Widgets shrinks/grows, Toolbox unchanged
            DIM newProjectHeight AS INTEGER = m.PanelDragOrigHeight + dragDelta
            ' Enforce minimum Project height
            IF newProjectHeight < 3 THEN
                newProjectHeight = 3
            ENDIF
            ' Maximum: leave at least 3 for Widgets and current Toolbox
            DIM maxProjectHeight AS INTEGER = contentHeight - 3 - m.ToolboxHeight
            IF newProjectHeight > maxProjectHeight THEN
                newProjectHeight = maxProjectHeight
            ENDIF
            ' Calculate how much Project changed and adjust Widgets to compensate
            DIM deltaProject AS INTEGER = newProjectHeight - m.ProjectHeight
            m.ProjectHeight = newProjectHeight
            m.WidgetsHeight = m.WidgetsHeight - deltaProject
            IF m.WidgetsHeight < 3 THEN
                m.WidgetsHeight = 3
            ENDIF
        ELSEIF m.PanelDragging = PANEL_DRAG_TOOLBOX THEN
            ' Dragging Toolbox caption - moves boundary between Widgets and Toolbox
            ' Widgets grows/shrinks, Toolbox shrinks/grows, Project unchanged
            DIM newWidgetsHeight AS INTEGER = m.PanelDragOrigHeight + dragDelta
            ' Enforce minimum Widgets height
            IF newWidgetsHeight < 3 THEN
                newWidgetsHeight = 3
            ENDIF
            ' Maximum: leave at least 2 for Toolbox
            DIM maxWidgetsHeight AS INTEGER = contentHeight - m.ProjectHeight - 2
            IF newWidgetsHeight > maxWidgetsHeight THEN
                newWidgetsHeight = maxWidgetsHeight
            ENDIF
            m.WidgetsHeight = newWidgetsHeight
            ' Recalculate Toolbox height to fill remaining space
            m.ToolboxHeight = contentHeight - m.ProjectHeight - m.WidgetsHeight
            IF m.ToolboxHeight < 2 THEN
                m.ToolboxHeight = 2
            ENDIF
        ENDIF
        RETURN m, NIL

    ' Handle mouse drag - only update outline position, not actual control/form
    ELSEIF m.IsDragging THEN
        ' Skip every other frame to reduce rendering overhead
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM dragContentY AS INTEGER = y - 1
            DIM dragLocalX AS INTEGER = x - leftPanelWidth

            IF m.DraggingForm THEN
                ' Form drag - position relative to canvas
                DIM newFormX AS INTEGER = dragLocalX - m.DragStartX
                DIM newFormY AS INTEGER = dragContentY - m.DragStartY

                IF newFormX < 0 THEN
                    newFormX = 0
                ENDIF
                IF newFormY < 0 THEN
                    newFormY = 0
                ENDIF

                m.DragOutlineX = newFormX
                m.DragOutlineY = newFormY
            ELSEIF m.SelectedCtrlIdx >= 0 THEN
                ' Control drag - position relative to form content area
                DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
                DIM ctrlFormX AS INTEGER = dragLocalX - form.X - 1
                DIM ctrlFormY AS INTEGER = dragContentY - form.Y - 1

                DIM newX AS INTEGER = ctrlFormX - m.DragStartX
                DIM newY AS INTEGER = ctrlFormY - m.DragStartY

                IF newX < 0 THEN
                    newX = 0
                ENDIF
                IF newY < 0 THEN
                    newY = 0
                ENDIF

                ' Only update outline position during drag
                m.DragOutlineX = newX
                m.DragOutlineY = newY
            ENDIF
        ENDIF

    ' Handle mouse resize - update outline size based on corner being dragged
    ELSEIF m.IsResizing THEN
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM resizeContentY AS INTEGER = y - 1
            DIM resizeLocalX AS INTEGER = x - leftPanelWidth

            DIM resizeForm AS VDBForm = m.Project.Forms[m.CurrentFormIdx]

            ' For form resize, use screen coordinates relative to form origin
            ' For control resize, adjust for form position and borders
            DIM resFormX AS INTEGER = resizeLocalX
            DIM resFormY AS INTEGER = resizeContentY
            IF NOT m.ResizingForm THEN
                resFormX = resizeLocalX - resizeForm.X - 1
                resFormY = resizeContentY - resizeForm.Y - 1
            ENDIF

            DIM resNewX AS INTEGER = m.ResizeOrigX
            DIM resNewY AS INTEGER = m.ResizeOrigY
            DIM resNewW AS INTEGER = m.ResizeOrigW
            DIM resNewH AS INTEGER = m.ResizeOrigH

            IF m.ResizingForm THEN
                ' Form resize - calculate new size based on mouse position relative to form origin
                IF m.ResizeCorner = HANDLE_TR OR m.ResizeCorner = HANDLE_BR OR m.ResizeCorner = HANDLE_RIGHT THEN
                    resNewW = resFormX - resizeForm.X + 1
                ENDIF
                IF m.ResizeCorner = HANDLE_BL OR m.ResizeCorner = HANDLE_BR OR m.ResizeCorner = HANDLE_BOTTOM THEN
                    resNewH = resFormY - resizeForm.Y + 1
                ENDIF
                ' Form doesn't support resizing from top/left (would need to move controls)
            ELSE
                ' Control resize
                IF m.SelectedCtrlIdx < 0 THEN
                    RETURN m, NIL
                ENDIF
                IF m.ResizeCorner = HANDLE_TL THEN
                    ' Top-left corner: move origin, shrink from top-left
                    resNewX = resFormX
                    resNewY = resFormY
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_TR THEN
                    ' Top-right corner: move Y, change width, shrink from top
                    resNewY = resFormY
                    resNewW = resFormX - m.ResizeOrigX + 1
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_BL THEN
                    ' Bottom-left corner: move X, change height, shrink from left
                    resNewX = resFormX
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_BR THEN
                    ' Bottom-right corner: just change width and height
                    resNewW = resFormX - m.ResizeOrigX + 1
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_TOP THEN
                    ' Top edge: move Y, change height (vertical only)
                    resNewY = resFormY
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_BOTTOM THEN
                    ' Bottom edge: change height only
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_LEFT THEN
                    ' Left edge: move X, change width (horizontal only)
                    resNewX = resFormX
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                ELSEIF m.ResizeCorner = HANDLE_RIGHT THEN
                    ' Right edge: change width only
                    resNewW = resFormX - m.ResizeOrigX + 1
                ENDIF
            ENDIF

            ' Enforce minimum size
            DIM minW AS INTEGER = 5
            DIM minH AS INTEGER = 3
            IF NOT m.ResizingForm THEN
                minW = 2
                minH = 1
            ENDIF
            IF resNewW < minW THEN
                resNewW = minW
                IF m.ResizeCorner = HANDLE_TL OR m.ResizeCorner = HANDLE_BL OR m.ResizeCorner = HANDLE_LEFT THEN
                    resNewX = m.ResizeOrigX + m.ResizeOrigW - minW
                ENDIF
            ENDIF
            IF resNewH < minH THEN
                resNewH = minH
                IF m.ResizeCorner = HANDLE_TL OR m.ResizeCorner = HANDLE_TR OR m.ResizeCorner = HANDLE_TOP THEN
                    resNewY = m.ResizeOrigY + m.ResizeOrigH - minH
                ENDIF
            ENDIF
            IF resNewX < 0 THEN
                resNewX = 0
            ENDIF
            IF resNewY < 0 THEN
                resNewY = 0
            ENDIF

            m.DragOutlineX = resNewX
            m.DragOutlineY = resNewY
            m.DragCtrlWidth = resNewW
            m.DragCtrlHeight = resNewH
        ENDIF

    ' Handle mouse drag for widget from toolbox
    ELSEIF m.DraggingFromWidgets THEN
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM widgetDragY AS INTEGER = y - 1
            DIM widgetDragX AS INTEGER = x - leftPanelWidth

            ' Check if mouse is over the form area
            IF widgetDragX >= 0 AND widgetDragX < contentWidth THEN
                DIM wdForm AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
                ' Calculate position relative to form content area (inside border)
                DIM formRelX AS INTEGER = widgetDragX - wdForm.X - 1
                DIM formRelY AS INTEGER = widgetDragY - wdForm.Y - 1

                ' Clamp to form bounds
                IF formRelX < 0 THEN
                    formRelX = 0
                ENDIF
                IF formRelY < 0 THEN
                    formRelY = 0
                ENDIF
                IF formRelX + m.DragCtrlWidth > wdForm.Width - 2 THEN
                    formRelX = wdForm.Width - 2 - m.DragCtrlWidth
                    IF formRelX < 0 THEN
                        formRelX = 0
                    ENDIF
                ENDIF
                IF formRelY + m.DragCtrlHeight > wdForm.Height - 2 THEN
                    formRelY = wdForm.Height - 2 - m.DragCtrlHeight
                    IF formRelY < 0 THEN
                        formRelY = 0
                    ENDIF
                ENDIF

                m.DragOutlineX = formRelX
                m.DragOutlineY = formRelY
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMouseWheel(m AS VDBTermModel, wheelMsg AS tea.MouseWheelMsg) AS (tea.Model, tea.Cmd)
    ' Mouse wheel scrolling in code editor
    IF m.ViewMode = VIEW_CODE AND m.CodeEditorInited THEN
        IF wheelMsg.Button = tea.MouseWheelUp THEN
            ' Scroll up: move cursor up 3 lines
            DIM wu AS INTEGER
            FOR wu = 0 TO 2
                m.CodeEditor.CursorUp()
            NEXT
            m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
            m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
        ELSEIF wheelMsg.Button = tea.MouseWheelDown THEN
            ' Scroll down: move cursor down 3 lines
            DIM wd AS INTEGER
            FOR wd = 0 TO 2
                m.CodeEditor.CursorDown()
            NEXT
            m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
            m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Mouse wheel scrolling in other panels
    DIM leftPanelWidth AS INTEGER = 16
    DIM wx AS INTEGER = Int(wheelMsg.X)
    IF wx < leftPanelWidth THEN
        ' Left panel scrolling
        DIM wy AS INTEGER = Int(wheelMsg.Y) - 1
        DIM toolboxStart AS INTEGER = m.ProjectHeight + m.WidgetsHeight
        IF wy < m.ProjectHeight THEN
            ' Project tree scroll
            IF wheelMsg.Button = tea.MouseWheelUp THEN
                IF m.ProjectScroll > 0 THEN
                    m.ProjectScroll = m.ProjectScroll - 1
                ENDIF
            ELSEIF wheelMsg.Button = tea.MouseWheelDown THEN
                m.ProjectScroll = m.ProjectScroll + 1
            ENDIF
        ELSEIF wy < toolboxStart THEN
            ' Widgets panel scroll
            IF wheelMsg.Button = tea.MouseWheelUp THEN
                IF m.WidgetsScroll > 0 THEN
                    m.WidgetsScroll = m.WidgetsScroll - 1
                ENDIF
            ELSEIF wheelMsg.Button = tea.MouseWheelDown THEN
                m.WidgetsScroll = m.WidgetsScroll + 1
            ENDIF
        ELSE
            ' Toolbox panel scroll
            IF wheelMsg.Button = tea.MouseWheelUp THEN
                IF m.ToolboxScroll > 0 THEN
                    m.ToolboxScroll = m.ToolboxScroll - 1
                ENDIF
            ELSEIF wheelMsg.Button = tea.MouseWheelDown THEN
                m.ToolboxScroll = m.ToolboxScroll + 1
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuBarClick(m AS VDBTermModel, x AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Menu positions: File(0-5), Edit(6-11), View(12-17), Run(18-22), Debug(23-29), Options(30-38), Help(39-45)
    IF x >= 0 AND x < 6 THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
    ELSEIF x >= 6 AND x < 12 THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
    ELSEIF x >= 12 AND x < 18 THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
    ELSEIF x >= 18 AND x < 23 THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
    ELSEIF x >= 23 AND x < 30 THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
    ELSEIF x >= 30 AND x < 39 THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
    ELSEIF x >= 39 AND x < 46 THEN
        m.MenuOpen = MENU_HELP
        m.MenuIndex = 0
    ELSE
        m.MenuOpen = MENU_NONE
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleDropdownClick(m AS VDBTermModel, row AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is the top border, so actual menu items start at row 1
    DIM itemIdx AS INTEGER = row - 1

    IF itemIdx < 0 THEN
        RETURN m, NIL
    ENDIF

    ' Determine valid menu item indices based on current menu
    DIM maxItems AS INTEGER

    IF m.MenuOpen = MENU_FILE THEN
        maxItems = 9
        ' Items: 0=New, 1=Open, 2=Save, 3=SaveAs, 4=sep, 5=NewForm, 6=NewModule, 7=sep, 8=Exit
        IF itemIdx = 4 OR itemIdx = 7 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_EDIT THEN
        maxItems = 8
        ' Items: 0=Cut, 1=Copy, 2=Paste, 3=sep, 4=SelectAll, 5=Delete, 6=sep, 7=MenuEditor
        IF itemIdx = 3 OR itemIdx = 6 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_VIEW THEN
        maxItems = 7
        ' Items: 0=FormView, 1=CodeView, 2=sep, 3=ShowGrid, 4=LineNums, 5=sep, 6=ObjBrowser
        IF itemIdx = 2 OR itemIdx = 5 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_RUN THEN
        maxItems = 4
        ' Items: 0=Run, 1=Build, 2=sep, 3=SetStartup
        IF itemIdx = 2 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_DEBUG THEN
        maxItems = 5
        ' Items: 0=Step, 1=Breakpoint, 2=Watch, 3=sep, 4=ClearAll
        IF itemIdx = 3 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
        maxItems = 5
        ' Items: 0=Environment, 1=Editor, 2=ThemeEditor, 3=sep, 4=Colors
        IF itemIdx = 3 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_HELP THEN
        maxItems = 2
        ' Items: 0=Help, 1=About
    ELSE
        RETURN m, NIL
    ENDIF

    IF itemIdx >= maxItems THEN
        RETURN m, NIL
    ENDIF

    ' Set menu index and simulate Enter key to execute menu action
    m.MenuIndex = itemIdx
    RETURN HandleMenuInput(m, "enter")
END FUNCTION

' Handle click on Widgets panel (visible widgets: Button, Label, TextBox, etc.)
FUNCTION HandleWidgetsClick(m AS VDBTermModel, y AS INTEGER, startDrag AS BOOLEAN) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_WIDGETS

    ' Row 0 is the title (handled in HandleMouseClick for dragging), items start at row 1
    ' Account for scroll offset to get the actual widget index
    DIM visibleRow AS INTEGER = y - 1
    DIM itemIdx AS INTEGER = visibleRow + m.WidgetsScroll
    IF visibleRow >= 0 AND itemIdx < VISIBLE_WIDGET_COUNT THEN
        m.WidgetsIndex = itemIdx

        ' Start drag operation if requested
        IF startDrag AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            m.DraggingFromWidgets = TRUE
            m.DragWidgetType = WidgetIndexToCtrlType(itemIdx)
            ' Set initial outline size based on widget defaults
            DIM tempCtrl AS VDBControl = NewControl(m.DragWidgetType, "temp", 0, 0)
            m.DragCtrlWidth = tempCtrl.Width
            m.DragCtrlHeight = tempCtrl.Height
            m.DragOutlineX = -1  ' Will be set when mouse enters form area
            m.DragOutlineY = -1
            m.Message = "Drag to form to place " & GetControlTypeName(m.DragWidgetType)
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle click on Toolbox panel (non-visible widgets: Timer)
FUNCTION HandleToolboxClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_TOOLBOX

    ' Row 0 is the title (handled in HandleMouseClick for dragging), items start at row 1
    ' Account for scroll offset to get the actual tool index
    DIM visibleRow AS INTEGER = y - 1
    DIM itemIdx AS INTEGER = visibleRow + m.ToolboxScroll
    IF visibleRow >= 0 AND itemIdx < NONVISIBLE_WIDGET_COUNT THEN
        m.ToolboxIndex = itemIdx
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_FORM

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
    DIM formX AS INTEGER = form.X
    DIM formY AS INTEGER = form.Y
    DIM formW AS INTEGER = form.Width
    DIM formH AS INTEGER = form.Height

    ' Check if click is outside form bounds
    IF x < formX OR x >= formX + formW OR y < formY OR y >= formY + formH THEN
        ' Click outside form - select form (deselect any control)
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    ' Coordinates relative to form
    DIM relX AS INTEGER = x - formX
    DIM relY AS INTEGER = y - formY

    ' Check if clicking on form border/handles when form is selected
    DIM formIsSelected AS BOOLEAN = (m.SelectedCtrlIdx < 0)
    DIM onFormBorder AS BOOLEAN = (relX = 0 OR relX = formW - 1 OR relY = 0 OR relY = formH - 1)

    IF formIsSelected AND onFormBorder THEN
        DIM centerCol AS INTEGER = formW / 2
        DIM centerRow AS INTEGER = formH / 2
        DIM formHandle AS INTEGER = HANDLE_NONE

        ' Check title bar (row 0)
        IF relY = 0 THEN
            IF relX = 0 THEN
                formHandle = HANDLE_TL
            ELSEIF relX = formW - 1 THEN
                formHandle = HANDLE_TR
            ELSEIF relX = centerCol AND formW >= 3 THEN
                formHandle = HANDLE_TOP
            ENDIF
        ' Check bottom border (row formH-1)
        ELSEIF relY = formH - 1 THEN
            IF relX = 0 THEN
                formHandle = HANDLE_BL
            ELSEIF relX = formW - 1 THEN
                formHandle = HANDLE_BR
            ELSEIF relX = centerCol AND formW >= 3 THEN
                formHandle = HANDLE_BOTTOM
            ENDIF
        ' Check left edge
        ELSEIF relX = 0 AND relY = centerRow AND formH >= 3 THEN
            formHandle = HANDLE_LEFT
        ' Check right edge
        ELSEIF relX = formW - 1 AND relY = centerRow AND formH >= 3 THEN
            formHandle = HANDLE_RIGHT
        ENDIF

        IF formHandle <> HANDLE_NONE THEN
            ' Start form resize operation
            m.IsResizing = TRUE
            m.ResizingForm = TRUE
            m.IsDragging = FALSE
            m.DraggingForm = FALSE
            m.DragSkipFrame = FALSE
            m.ResizeCorner = formHandle
            m.ResizeOrigX = formX
            m.ResizeOrigY = formY
            m.ResizeOrigW = formW
            m.ResizeOrigH = formH
            m.DragOutlineX = formX
            m.DragOutlineY = formY
            m.DragCtrlWidth = formW
            m.DragCtrlHeight = formH
            m.Message = "Resizing form"
            RETURN m, NIL
        ELSE
            ' Clicked on form border but not a handle - start form drag
            m.IsDragging = TRUE
            m.DraggingForm = TRUE
            m.IsResizing = FALSE
            m.DragSkipFrame = FALSE
            m.DragStartX = relX
            m.DragStartY = relY
            m.DragOutlineX = formX
            m.DragOutlineY = formY
            m.DragCtrlWidth = formW
            m.DragCtrlHeight = formH
            m.Message = "Moving form"
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Click on form border when form is not selected - select the form
    IF onFormBorder THEN
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    ' Coordinates relative to form content area (inside borders)
    DIM contentX AS INTEGER = relX - 1
    DIM contentY AS INTEGER = relY - 1

    IF contentX < 0 OR contentY < 0 THEN
        ' This shouldn't happen if we're past the border checks
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(form.Controls)

    ' Build list of control indices sorted by TabIndex descending (highest z-order first)
    DIM sortedIndices AS []INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO ctrlCount - 1
        sortedIndices = APPEND(sortedIndices, i)
    NEXT
    ' Sort by TabIndex descending (bubble sort - control count is typically small)
    DIM sortI AS INTEGER
    DIM sortJ AS INTEGER
    FOR sortI = 0 TO Len(sortedIndices) - 2
        FOR sortJ = sortI + 1 TO Len(sortedIndices) - 1
            DIM tabI AS INTEGER = form.Controls[sortedIndices[sortI]].TabIndex
            DIM tabJ AS INTEGER = form.Controls[sortedIndices[sortJ]].TabIndex
            IF tabJ > tabI THEN
                DIM tmp AS INTEGER = sortedIndices[sortI]
                sortedIndices[sortI] = sortedIndices[sortJ]
                sortedIndices[sortJ] = tmp
            ENDIF
        NEXT
    NEXT

    ' Check if click is on a control (highest TabIndex/z-order first)
    DIM si AS INTEGER
    FOR si = 0 TO Len(sortedIndices) - 1
        i = sortedIndices[si]
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[i]
        IF contentX >= ctrl.X AND contentX < ctrl.X + ctrl.Width AND contentY >= ctrl.Y AND contentY < ctrl.Y + ctrl.Height THEN
            DIM localX AS INTEGER = contentX - ctrl.X
            DIM localY AS INTEGER = contentY - ctrl.Y
            DIM isSelected AS BOOLEAN = (i = m.SelectedCtrlIdx)

            ' Check if clicking on a resize handle of already-selected control
            IF isSelected THEN
                DIM onTop AS BOOLEAN = (localY = 0)
                DIM onBottom AS BOOLEAN = (localY = ctrl.Height - 1)
                DIM onLeft AS BOOLEAN = (localX = 0)
                DIM onRight AS BOOLEAN = (localX = ctrl.Width - 1)
                DIM centerX AS INTEGER = ctrl.Width / 2
                DIM centerY AS INTEGER = ctrl.Height / 2
                DIM atCenterX AS BOOLEAN = (localX = centerX)
                DIM atCenterY AS BOOLEAN = (localY = centerY)

                DIM handle AS INTEGER = HANDLE_NONE

                ' Check corners first (they take priority)
                IF onTop AND onLeft THEN
                    handle = HANDLE_TL
                ELSEIF onTop AND onRight THEN
                    handle = HANDLE_TR
                ELSEIF onBottom AND onLeft THEN
                    handle = HANDLE_BL
                ELSEIF onBottom AND onRight THEN
                    handle = HANDLE_BR
                ' Check edge handles (only if control is large enough)
                ELSEIF onTop AND atCenterX AND ctrl.Width >= 3 THEN
                    handle = HANDLE_TOP
                ELSEIF onBottom AND atCenterX AND ctrl.Width >= 3 THEN
                    handle = HANDLE_BOTTOM
                ELSEIF onLeft AND atCenterY AND ctrl.Height >= 3 THEN
                    handle = HANDLE_LEFT
                ELSEIF onRight AND atCenterY AND ctrl.Height >= 3 THEN
                    handle = HANDLE_RIGHT
                ENDIF

                IF handle <> HANDLE_NONE THEN
                    ' Start resize operation for control
                    m.IsResizing = TRUE
                    m.ResizingForm = FALSE
                    m.IsDragging = FALSE
                    m.DragSkipFrame = FALSE
                    m.ResizeCorner = handle
                    m.ResizeOrigX = ctrl.X
                    m.ResizeOrigY = ctrl.Y
                    m.ResizeOrigW = ctrl.Width
                    m.ResizeOrigH = ctrl.Height
                    m.DragOutlineX = ctrl.X
                    m.DragOutlineY = ctrl.Y
                    m.DragCtrlWidth = ctrl.Width
                    m.DragCtrlHeight = ctrl.Height
                    m.Message = "Resizing: " & ctrl.CtlName
                    RETURN m, NIL
                ENDIF
            ENDIF

            ' Select the control and start drag operation
            m.SelectedCtrlIdx = i
            m.IsDragging = TRUE
            m.IsResizing = FALSE
            m.DragSkipFrame = FALSE
            m.DragStartX = localX
            m.DragStartY = localY
            m.DragOutlineX = ctrl.X
            m.DragOutlineY = ctrl.Y
            m.DragCtrlWidth = ctrl.Width
            m.DragCtrlHeight = ctrl.Height
            m.Message = "Dragging: " & ctrl.CtlName
            RETURN m, NIL
        ENDIF
    NEXT

    ' Clicked on empty area - deselect
    m.SelectedCtrlIdx = -1
    m.Message = ""

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, ctrlPressed AS BOOLEAN) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_CODE

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)

    ' Adjust for line numbers if shown
    DIM textX AS INTEGER = x
    IF m.ShowLineNumbers THEN
        textX = x - 5  ' Line number column width
        IF textX < 0 THEN
            textX = 0
        ENDIF
    ENDIF

    ' Set cursor position
    DIM targetLine AS INTEGER = y + m.CodeScrollY
    IF targetLine >= totalLines THEN
        targetLine = totalLines - 1
    ENDIF
    IF targetLine < 0 THEN
        targetLine = 0
    ENDIF

    DIM lineText AS STRING = GetLine(code, targetLine + 1)
    DIM targetCol AS INTEGER = textX + m.CodeScrollX
    IF targetCol > Len(lineText) THEN
        targetCol = Len(lineText)
    ENDIF
    IF targetCol < 0 THEN
        targetCol = 0
    ENDIF

    m.CodeCursorY = targetLine
    m.CodeCursorX = targetCol

    ' Position textarea cursor if using textarea editor
    IF m.CodeEditorInited THEN
        m.CodeEditor = SetEditorCursor(m.CodeEditor, targetLine, targetCol)
    ENDIF

    ' Handle Ctrl+click for go-to-definition
    IF ctrlPressed THEN
        DIM word AS STRING = GetWordAtColumn(lineText, targetCol)
        IF Len(word) > 0 THEN
            DIM defFormIdx AS INTEGER
            DIM defLineNum AS INTEGER
            DIM defColNum AS INTEGER
            defFormIdx, defLineNum, defColNum = FindDefinition(m.Project, word)

            IF defFormIdx >= 0 THEN
                ' Found definition in a form
                m.CurrentFormIdx = defFormIdx
                m.CodeCursorY = defLineNum
                m.CodeCursorX = defColNum
                m.CodeScrollY = defLineNum
                IF m.CodeScrollY > 0 THEN
                    m.CodeScrollY = m.CodeScrollY - 3
                    IF m.CodeScrollY < 0 THEN
                        m.CodeScrollY = 0
                    ENDIF
                ENDIF
                m.ViewMode = VIEW_CODE
                m.Message = "Found: " & word
            ELSEIF defFormIdx < -1 THEN
                ' Found in a module (encoded as -(modIdx + 1000))
                m.Message = "Definition in module (modules not editable in this view)"
            ELSE
                m.Message = "Definition not found: " & word
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePropertiesClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROPERTIES

    ' Row 0 is the title, properties start at row 1
    IF y >= 1 THEN
        DIM newPropIndex AS INTEGER = y - 1
        DIM now AS time.Time = time.Now()

        ' If clicking on a different property while editing, cancel current edit
        IF m.PropEditing AND newPropIndex <> m.PropIndex THEN
            m.PropEditing = FALSE
            m.PropEditValue = ""
        ENDIF

        ' Check for double-click on same property (within 500ms)
        DIM isDoubleClick AS BOOLEAN = FALSE
        IF newPropIndex = m.PropLastClickIdx THEN
            DIM elapsed AS time.Duration = now.Sub(m.PropLastClickTime)
            IF elapsed < time.Millisecond * 300 THEN
                isDoubleClick = TRUE
            ENDIF
        ENDIF

        ' Update last click tracking
        m.PropLastClickTime = now
        m.PropLastClickIdx = newPropIndex

        ' Handle double-click on boolean, enumerable, or color property
        IF isDoubleClick THEN
            IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                ' Check for Form color properties first (SelectedCtrlIdx = -1)
                IF m.SelectedCtrlIdx = -1 THEN
                    ' Form properties: Name(0), Caption(1), X(2), Y(3), W(4), H(5), ForeColor(6), BackColor(7)
                    IF newPropIndex = 6 OR newPropIndex = 7 THEN
                        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
                        m.PopupMode = POPUP_COLOR_PICKER
                        m.ColorPickerFocus = newPropIndex - 6  ' 0=ForeColor, 1=BackColor
                        m.ColorPickerFore = form.ForeColor
                        m.ColorPickerBack = form.BackColor
                        m.PopupX = (m.Width - 22) / 2
                        m.PopupY = (m.Height - 12) / 2
                        m.PropLastClickIdx = -1
                        RETURN m, NIL
                    ENDIF
                ELSEIF m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
                    ' Control properties
                    DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
                    ' If it's a boolean property, toggle it
                    IF IsPropertyBoolean(ctrl, newPropIndex) THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx] = ToggleBooleanProperty(ctrl, newPropIndex)
                        m.Project.Modified = TRUE
                        ' Reset click tracking to prevent triple-click toggle
                        m.PropLastClickIdx = -1
                        RETURN m, NIL
                    ENDIF
                    ' If it's an enumerable property, cycle it
                    IF IsPropertyEnumerable(ctrl, newPropIndex) THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx] = CycleEnumerableProperty(ctrl, newPropIndex)
                        m.Project.Modified = TRUE
                        ' Reset click tracking to prevent triple-click cycle
                        m.PropLastClickIdx = -1
                        RETURN m, NIL
                    ENDIF
                    ' If it's a color property, open color picker
                    DIM colorType AS INTEGER = IsPropertyColor(ctrl, newPropIndex)
                    IF colorType > 0 THEN
                        m.PopupMode = POPUP_COLOR_PICKER
                        m.ColorPickerFocus = colorType - 1  ' 0=ForeColor, 1=BackColor
                        m.ColorPickerFore = ctrl.ForeColor
                        m.ColorPickerBack = ctrl.BackColor
                        ' Position popup near center of screen
                        m.PopupX = (m.Width - 22) / 2
                        m.PopupY = (m.Height - 12) / 2
                        m.PropLastClickIdx = -1
                        RETURN m, NIL
                    ENDIF
                ENDIF
            ENDIF
        ENDIF

        m.PropIndex = newPropIndex
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleProjectClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROJECT

    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 THEN
        DIM totalItems AS INTEGER = GetTreeItemCount(m)
        IF itemIdx < totalItems THEN
            ' Check for double-click
            DIM now AS time.Time = time.Now()
            DIM elapsed AS time.Duration = now.Sub(m.TreeLastClickTime)
            DIM isDoubleClick AS BOOLEAN = (itemIdx = m.TreeLastClickIdx AND elapsed < 500 * time.Millisecond)

            m.TreeIndex = itemIdx
            m.TreeLastClickTime = now
            m.TreeLastClickIdx = itemIdx

            ' Get info about clicked item
            DIM itemType AS INTEGER
            DIM formIdx AS INTEGER
            DIM ctrlIdx AS INTEGER
            itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

            IF itemType = 1 THEN
                ' Clicked on a form - toggle expansion and select it
                IF formIdx < Len(m.TreeExpanded) THEN
                    m.TreeExpanded[formIdx] = NOT m.TreeExpanded[formIdx]
                ENDIF
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = -1
            ELSEIF itemType = 2 THEN
                ' Clicked on a control - select it in the form editor
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = ctrlIdx
                ' Only give focus to form editor on double-click
                IF isDoubleClick THEN
                    m.FocusArea = FOCUS_FORM
                ENDIF
                ' Single click keeps focus on project tree (already set above)
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' RIGHT-CLICK HANDLERS (Event Popup)
' ============================================================================

FUNCTION HandleProjectRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = localY - 1
    IF itemIdx >= 0 THEN
        DIM totalItems AS INTEGER = GetTreeItemCount(m)
        IF itemIdx < totalItems THEN
            ' Get info about clicked item
            DIM itemType AS INTEGER
            DIM formIdx AS INTEGER
            DIM ctrlIdx AS INTEGER
            itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

            IF itemType = 1 THEN
                ' Right-clicked on a form - show form events
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = -1
                m.PopupMode = POPUP_EVENTS
                m.PopupX = screenX
                m.PopupY = screenY
                m.PopupCtrlIdx = -1  ' -1 means form itself
                m.PopupCtrlType = CTRL_FORM
                m.PopupEvents = GetControlEvents(CTRL_FORM)
                m.PopupIndex = 0
            ELSEIF itemType = 2 THEN
                ' Right-clicked on a control - show control events
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = ctrlIdx
                DIM ctrl AS VDBControl = m.Project.Forms[formIdx].Controls[ctrlIdx]
                m.PopupMode = POPUP_EVENTS
                m.PopupX = screenX
                m.PopupY = screenY
                m.PopupCtrlIdx = ctrlIdx
                m.PopupCtrlType = ctrl.CtlType
                m.PopupEvents = GetControlEvents(ctrl.CtlType)
                m.PopupIndex = 0
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleWidgetsRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is title, widgets start at row 1
    IF localY >= 1 THEN
        DIM widgetIdx AS INTEGER = localY - 1
        IF widgetIdx < VISIBLE_WIDGET_COUNT THEN
            DIM ctlType AS INTEGER = WidgetIndexToCtrlType(widgetIdx)
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = -2  ' -2 means widget panel (not a real control)
            m.PopupCtrlType = ctlType
            m.PopupEvents = GetControlEvents(ctlType)
            m.PopupIndex = 0
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleToolboxRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is title, tools start at row 1
    IF localY >= 1 THEN
        DIM toolIdx AS INTEGER = localY - 1
        IF toolIdx < NONVISIBLE_WIDGET_COUNT THEN
            ' Timer is the only non-visible widget
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = -2  ' -2 means toolbox panel (not a real control)
            m.PopupCtrlType = CTRL_TIMER
            m.PopupEvents = GetControlEvents(CTRL_TIMER)
            m.PopupIndex = 0
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormRightClick(m AS VDBTermModel, localX AS INTEGER, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]

    ' Calculate position within form content
    DIM formStartX AS INTEGER = 1
    DIM formStartY AS INTEGER = 1
    DIM contentX AS INTEGER = localX - formStartX - form.X
    DIM contentY AS INTEGER = localY - formStartY - form.Y

    ' Check if click is on form or a control
    DIM ctrlCount AS INTEGER = Len(form.Controls)
    DIM i AS INTEGER

    ' Build list of control indices sorted by TabIndex descending (highest z-order first)
    DIM sortedIndices AS []INTEGER
    FOR i = 0 TO ctrlCount - 1
        sortedIndices = APPEND(sortedIndices, i)
    NEXT
    ' Sort by TabIndex descending (bubble sort - control count is typically small)
    DIM sortI AS INTEGER
    DIM sortJ AS INTEGER
    FOR sortI = 0 TO Len(sortedIndices) - 2
        FOR sortJ = sortI + 1 TO Len(sortedIndices) - 1
            DIM tabI AS INTEGER = form.Controls[sortedIndices[sortI]].TabIndex
            DIM tabJ AS INTEGER = form.Controls[sortedIndices[sortJ]].TabIndex
            IF tabJ > tabI THEN
                DIM tmp AS INTEGER = sortedIndices[sortI]
                sortedIndices[sortI] = sortedIndices[sortJ]
                sortedIndices[sortJ] = tmp
            ENDIF
        NEXT
    NEXT

    ' Iterate through controls by z-order (highest TabIndex first)
    DIM si AS INTEGER
    FOR si = 0 TO Len(sortedIndices) - 1
        i = sortedIndices[si]
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[i]
        IF contentX >= ctrl.X AND contentX < ctrl.X + ctrl.Width AND contentY >= ctrl.Y AND contentY < ctrl.Y + ctrl.Height THEN
            ' Found a control
            m.SelectedCtrlIdx = i
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = i
            m.PopupCtrlType = ctrl.CtlType
            m.PopupEvents = GetControlEvents(ctrl.CtlType)
            m.PopupIndex = 0
            RETURN m, NIL
        ENDIF
    NEXT

    ' No control found - right-clicked on form background
    m.SelectedCtrlIdx = -1
    m.PopupMode = POPUP_EVENTS
    m.PopupX = screenX
    m.PopupY = screenY
    m.PopupCtrlIdx = -1  ' -1 means form itself
    m.PopupCtrlType = CTRL_FORM
    m.PopupEvents = GetControlEvents(CTRL_FORM)
    m.PopupIndex = 0

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePopupClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, contentHeight AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Calculate popup position and size
    DIM popupWidth AS INTEGER = GetPopupWidth(m)
    DIM popupHeight AS INTEGER
    IF m.PopupMode = POPUP_COLOR_PICKER THEN
        popupHeight = 11  ' Top + title + sep + 2 ForeColor rows + sep + 2 BackColor rows + sep + help + bottom
    ELSE
        popupHeight = Len(m.PopupEvents) + 4  ' +4 for title bar and borders
    ENDIF

    DIM popupStartRow AS INTEGER = m.PopupY
    DIM popupStartCol AS INTEGER = m.PopupX

    ' Adjust if popup would go off screen
    IF popupStartRow + popupHeight > contentHeight + 1 THEN
        popupStartRow = contentHeight + 1 - popupHeight
    ENDIF
    IF popupStartCol + popupWidth > m.Width THEN
        popupStartCol = m.Width - popupWidth
    ENDIF
    IF popupStartRow < 1 THEN
        popupStartRow = 1
    ENDIF
    IF popupStartCol < 0 THEN
        popupStartCol = 0
    ENDIF

    ' Check if click is inside popup
    DIM relX AS INTEGER = x - popupStartCol
    DIM relY AS INTEGER = y - popupStartRow

    IF relX < 0 OR relX >= popupWidth OR relY < 0 OR relY >= popupHeight THEN
        ' Click outside popup - close it
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ENDIF

    IF m.PopupMode = POPUP_COLOR_PICKER THEN
        RETURN HandleColorPickerClick(m, relX, relY)
    ENDIF

    ' Check if clicking on an event item (rows 3+ are event items, 0-indexed: row 3 = first event)
    DIM eventRow AS INTEGER = relY - 3
    IF eventRow >= 0 AND eventRow < Len(m.PopupEvents) THEN
        m.PopupIndex = eventRow
        DIM eventName AS STRING = m.PopupEvents[eventRow]
        RETURN OpenOrCreateEventHandler(m, eventName)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleColorPickerClick(m AS VDBTermModel, relX AS INTEGER, relY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' relY: 0=top border, 1=title, 2=separator, 3=ForeColor row 1, 4=ForeColor row 2
    '       5=separator, 6=BackColor row 1, 7=BackColor row 2, 8=separator, 9=help, 10=bottom border

    ' Color blocks start at column 13 (after "│" + "►ForeColor: " = 1 + 12)
    ' Each color block is 1 char wide

    IF relY = 3 OR relY = 4 THEN
        ' ForeColor rows
        m.ColorPickerFocus = 0
        IF relX >= 13 AND relX < 21 THEN
            ' Colors 0-7 or 8-15, each color is 1 cell
            DIM colorIdx AS INTEGER = relX - 13
            IF relY = 3 THEN
                m.ColorPickerFore = colorIdx
            ELSE
                m.ColorPickerFore = colorIdx + 8
            ENDIF
        ENDIF
    ELSEIF relY = 6 OR relY = 7 THEN
        ' BackColor rows
        m.ColorPickerFocus = 1
        IF relX >= 13 AND relX < 21 THEN
            DIM bColorIdx AS INTEGER = relX - 13
            IF relY = 6 THEN
                m.ColorPickerBack = bColorIdx
            ELSE
                m.ColorPickerBack = bColorIdx + 8
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePopupInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF m.PopupMode = POPUP_COLOR_PICKER THEN
        RETURN HandleColorPickerInput(m, key)
    ENDIF

    IF key = "esc" THEN
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ELSEIF key = "up" THEN
        IF m.PopupIndex > 0 THEN
            m.PopupIndex = m.PopupIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.PopupIndex < Len(m.PopupEvents) - 1 THEN
            m.PopupIndex = m.PopupIndex + 1
        ENDIF
    ELSEIF key = "enter" THEN
        ' Select the event - open or create handler
        IF m.PopupIndex < Len(m.PopupEvents) THEN
            DIM eventName AS STRING = m.PopupEvents[m.PopupIndex]
            RETURN OpenOrCreateEventHandler(m, eventName)
        ENDIF
        m.PopupMode = POPUP_NONE
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleColorPickerInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ELSEIF key = "tab" THEN
        ' Switch between ForeColor and BackColor
        IF m.ColorPickerFocus = 0 THEN
            m.ColorPickerFocus = 1
        ELSE
            m.ColorPickerFocus = 0
        ENDIF
    ELSEIF key = "left" THEN
        IF m.ColorPickerFocus = 0 THEN
            IF m.ColorPickerFore > 0 THEN
                m.ColorPickerFore = m.ColorPickerFore - 1
            ENDIF
        ELSE
            IF m.ColorPickerBack > 0 THEN
                m.ColorPickerBack = m.ColorPickerBack - 1
            ENDIF
        ENDIF
    ELSEIF key = "right" THEN
        IF m.ColorPickerFocus = 0 THEN
            IF m.ColorPickerFore < 15 THEN
                m.ColorPickerFore = m.ColorPickerFore + 1
            ENDIF
        ELSE
            IF m.ColorPickerBack < 15 THEN
                m.ColorPickerBack = m.ColorPickerBack + 1
            ENDIF
        ENDIF
    ELSEIF key = "up" THEN
        ' Move up one row (subtract 8)
        IF m.ColorPickerFocus = 0 THEN
            IF m.ColorPickerFore >= 8 THEN
                m.ColorPickerFore = m.ColorPickerFore - 8
            ENDIF
        ELSE
            IF m.ColorPickerBack >= 8 THEN
                m.ColorPickerBack = m.ColorPickerBack - 8
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        ' Move down one row (add 8)
        IF m.ColorPickerFocus = 0 THEN
            IF m.ColorPickerFore < 8 THEN
                m.ColorPickerFore = m.ColorPickerFore + 8
            ENDIF
        ELSE
            IF m.ColorPickerBack < 8 THEN
                m.ColorPickerBack = m.ColorPickerBack + 8
            ENDIF
        ENDIF
    ELSEIF key = "enter" THEN
        ' Apply the selected colors and close
        RETURN ApplyColorPickerSelection(m)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION ApplyColorPickerSelection(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ENDIF

    IF m.SelectedCtrlIdx = -1 THEN
        ' Form colors
        m.Project.Forms[m.CurrentFormIdx].ForeColor = m.ColorPickerFore
        m.Project.Forms[m.CurrentFormIdx].BackColor = m.ColorPickerBack
    ELSEIF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        ' Control colors
        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ForeColor = m.ColorPickerFore
        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].BackColor = m.ColorPickerBack
    ENDIF

    m.Project.Modified = TRUE
    m.PopupMode = POPUP_NONE
    m.Message = "Colors applied"

    RETURN m, NIL
END FUNCTION

FUNCTION OpenOrCreateEventHandler(m AS VDBTermModel, eventName AS STRING) AS (tea.Model, tea.Cmd)
    m.PopupMode = POPUP_NONE

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    ' Get control name
    DIM ctrlName AS STRING
    IF m.PopupCtrlIdx = -1 THEN
        ' Form itself
        ctrlName = m.Project.Forms[m.CurrentFormIdx].Name
    ELSEIF m.PopupCtrlIdx = -2 THEN
        ' Widget/Toolbox panel - just show message, can't create handler
        m.Message = GetControlTypeName(m.PopupCtrlType) & " events: " & eventName
        RETURN m, NIL
    ELSE
        ' Control
        ctrlName = m.Project.Forms[m.CurrentFormIdx].Controls[m.PopupCtrlIdx].CtlName
    ENDIF

    ' Get form code
    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code

    ' Look for existing handler
    DIM lineNum AS INTEGER = FindEventHandler(code, ctrlName, eventName)

    IF lineNum > 0 THEN
        ' Found existing handler - navigate to it
        m.ViewMode = VIEW_CODE
        m.FocusArea = FOCUS_CODE
        m.CodeCursorY = lineNum - 1
        m.CodeCursorX = 0
        m.CodeScrollY = lineNum - 3
        IF m.CodeScrollY < 0 THEN
            m.CodeScrollY = 0
        ENDIF
        m.Message = "Opened: " & ctrlName & "_" & eventName
    ELSE
        ' Create new handler stub
        DIM stub AS STRING = GenerateEventStub(ctrlName, eventName)
        m.Project.Forms[m.CurrentFormIdx].Code = code & stub
        m.Project.Modified = TRUE

        ' Navigate to the new handler
        DIM newCode AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
        lineNum = FindEventHandler(newCode, ctrlName, eventName)
        m.ViewMode = VIEW_CODE
        m.FocusArea = FOCUS_CODE
        IF lineNum > 0 THEN
            m.CodeCursorY = lineNum - 1
            m.CodeCursorX = 0
            m.CodeScrollY = lineNum - 3
            IF m.CodeScrollY < 0 THEN
                m.CodeScrollY = 0
            ENDIF
        ENDIF
        m.Message = "Created: " & ctrlName & "_" & eventName
    ENDIF

    ' Update textarea if initialized
    IF m.CodeEditorInited THEN
        m.CodeEditor.SetValue(m.Project.Forms[m.CurrentFormIdx].Code)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleDialogClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, contentHeight AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Calculate dialog position and size
    DIM dialogWidth AS INTEGER
    DIM dialogHeight AS INTEGER
    dialogWidth, dialogHeight = GetDialogSize(m)

    DIM dialogStartRow AS INTEGER = (contentHeight - dialogHeight) / 2
    DIM dialogStartCol AS INTEGER = (m.Width - dialogWidth) / 2

    IF dialogStartRow < 1 THEN
        dialogStartRow = 1
    ENDIF
    IF dialogStartCol < 0 THEN
        dialogStartCol = 0
    ENDIF

    ' Check if click is inside dialog
    ' y is screen coordinate (menu bar at row 0), dialogStartRow is relative to content area
    ' So we subtract 1 from y to convert to content coordinate
    DIM relX AS INTEGER = x - dialogStartCol
    DIM relY AS INTEGER = (y - 1) - dialogStartRow

    IF relX < 0 OR relX >= dialogWidth OR relY < 0 OR relY >= dialogHeight THEN
        ' Click outside dialog - close it for simple dialogs
        IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Handle clicks based on dialog type
    IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
        ' Any click closes the dialog
        m.DialogMode = DIALOG_NONE
        RETURN m, NIL
    ENDIF

    IF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        ' Check for Yes/No button clicks
        ' "  < Yes (Y) >   < No (N) >" is on row 4 (0-indexed: content starts at row 1)
        IF relY = 5 THEN
            IF relX >= 2 AND relX < 14 THEN
                ' Yes button clicked
                RETURN m, tea.Quit
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' No button clicked
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' For input dialogs (New Project, Save Project, New Form, New Module, Open Project)
    IF m.DialogMode = DIALOG_NEW_PROJECT OR m.DialogMode = DIALOG_SAVE_PROJECT OR m.DialogMode = DIALOG_NEW_FORM OR m.DialogMode = DIALOG_NEW_MODULE OR m.DialogMode = DIALOG_OPEN_PROJECT THEN
        ' Check for OK/Cancel button clicks
        ' "  < OK >        < Cancel >" is on row 4 (content row 3)
        IF relY = 4 THEN
            IF relX >= 2 AND relX < 10 THEN
                ' OK button clicked - simulate Enter
                RETURN HandleDialogInput(m, "enter")
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' Cancel button clicked - simulate Escape
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Save As dialog with checkbox
    IF m.DialogMode = DIALOG_SAVE_AS THEN
        ' Row 4: Checkbox row "[X] Save as Widget..."
        ' Row 6: Buttons "< OK >         < Cancel >"
        IF relY = 4 THEN
            ' Checkbox click - toggle SaveAsWidget
            IF relX >= 3 AND relX < 40 THEN
                m.SaveAsWidget = NOT m.SaveAsWidget
            ENDIF
        ELSEIF relY = 6 THEN
            IF relX >= 3 AND relX < 11 THEN
                ' OK button clicked
                RETURN HandleDialogInput(m, "enter")
            ELSEIF relX >= 18 AND relX < 30 THEN
                ' Cancel button clicked
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' For options dialogs
    IF m.DialogMode = DIALOG_ENVIRONMENT OR m.DialogMode = DIALOG_EDITOR OR m.DialogMode = DIALOG_COLORS THEN
        ' Check for OK/Cancel button clicks on the last content row
        DIM btnRow AS INTEGER = dialogHeight - 2
        IF relY = btnRow THEN
            IF relX >= 2 AND relX < 10 THEN
                ' OK button clicked
                m.DialogMode = DIALOG_NONE
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' Cancel button clicked
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Theme Editor dialog
    IF m.DialogMode = DIALOG_THEME_EDITOR THEN
        DIM use256 AS BOOLEAN = m.ThemeEditingTheme.Use256Colors

        ' Dialog layout:
        ' Row 1: empty
        ' Row 2: Theme selector
        ' Row 3: empty
        ' Row 4: UseTheme checkbox
        ' Row 5: Use256Colors checkbox
        ' Row 6: empty
        ' Row 7: Column headers
        ' Row 8: Separator
        ' Row 9-16: Property list (8 rows)
        ' Row 17: Scroll info
        ' Row 18: empty
        ' Row 19: Help text line 1
        ' Row 20: Help text line 2
        ' Row 21: empty
        ' Row 22: Buttons (row 20 in content, +2 for border)

        ' UseTheme checkbox (row 4, col 2-4 for checkbox)
        IF relY = 4 AND relX >= 2 AND relX < 35 THEN
            m.Project.UseTheme = NOT m.Project.UseTheme
            RETURN m, NIL
        ENDIF

        ' Use256Colors checkbox (row 5, col 2-4 for checkbox)
        IF relY = 5 AND relX >= 2 AND relX < 30 THEN
            m.ThemeEditingTheme.Use256Colors = NOT m.ThemeEditingTheme.Use256Colors
            m.ThemeEditingTheme.Name = "Custom"
            RETURN m, NIL
        ENDIF

        ' Property list (rows 9-16)
        IF relY >= 9 AND relY < 17 THEN
            DIM propRow AS INTEGER = relY - 9
            DIM clickedPropIdx AS INTEGER = m.ThemeEditorScroll + propRow
            IF clickedPropIdx < 21 THEN
                m.ThemeEditorPropIdx = clickedPropIdx
                m.ThemeEditorFocus = THEME_FOCUS_PROPS

                ' Check if clicking on Fore or Back column
                ' Property starts at col 4, Fore at col 22, Back at col 28
                IF relX >= 22 AND relX < 28 THEN
                    ' Clicked on Fore column
                    m.ThemeEditorColIdx = 0
                    IF use256 THEN
                        ' Open 256-color picker popup
                        DIM clickFore AS INTEGER
                        DIM clickBack AS INTEGER
                        clickFore, clickBack = GetThemePropColors(m.ThemeEditingTheme, m.ThemeEditorPropIdx)
                        m.ThemeColorPickerY = clickFore / 16
                        m.ThemeColorPickerX = clickFore MOD 16
                        m.ThemeEditorIndex = 0  ' Reset to OK button
                        m.DialogMode = DIALOG_COLOR_PICKER_256
                        ' Use clickBack to suppress warning
                        IF clickBack < 0 THEN
                            clickBack = 0
                        ENDIF
                    ENDIF
                ELSEIF relX >= 28 AND relX < 34 THEN
                    ' Clicked on Back column (not for MenuShortcut)
                    IF clickedPropIdx <> 20 THEN
                        m.ThemeEditorColIdx = 1
                        IF use256 THEN
                            ' Open 256-color picker popup
                            DIM clickFore2 AS INTEGER
                            DIM clickBack2 AS INTEGER
                            clickFore2, clickBack2 = GetThemePropColors(m.ThemeEditingTheme, m.ThemeEditorPropIdx)
                            m.ThemeColorPickerY = clickBack2 / 16
                            m.ThemeColorPickerX = clickBack2 MOD 16
                            m.ThemeEditorIndex = 0  ' Reset to OK button
                            m.DialogMode = DIALOG_COLOR_PICKER_256
                            ' Use clickFore2 to suppress warning
                            IF clickFore2 < 0 THEN
                                clickFore2 = 0
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Buttons row (content[21], relY = 22)
        IF relY = 22 THEN
            m.ThemeEditorFocus = THEME_FOCUS_BUTTONS
            ' "   [Apply to All]  [ OK ]  [Cancel]"
            IF relX >= 3 AND relX < 19 THEN
                m.ThemeEditorIndex = 0
                m = ThemeEditorActivateButton(m)
            ELSEIF relX >= 21 AND relX < 29 THEN
                m.ThemeEditorIndex = 1
                m = ThemeEditorActivateButton(m)
            ELSEIF relX >= 31 AND relX < 41 THEN
                m.ThemeEditorIndex = 2
                m = ThemeEditorActivateButton(m)
            ENDIF
            RETURN m, NIL
        ENDIF

        RETURN m, NIL
    ENDIF

    ' 256-Color Picker popup dialog
    IF m.DialogMode = DIALOG_COLOR_PICKER_256 THEN
        ' Dialog layout (40 wide, 26 tall):
        ' Row 1: empty
        ' Row 2: instructions
        ' Row 3: empty
        ' Row 4-19: 16 rows of color grid
        ' Row 20: empty
        ' Row 21: selected color info
        ' Row 22: empty
        ' Row 23: buttons
        ' Row 24: empty

        ' Color grid (rows 4-19, cols 2-33 for 16x2=32 chars)
        IF relY >= 4 AND relY < 20 THEN
            DIM gridRow AS INTEGER = relY - 4
            IF relX >= 2 AND relX < 34 THEN
                DIM gridCol AS INTEGER = (relX - 2) / 2
                IF gridCol >= 0 AND gridCol < 16 THEN
                    ' Check if clicking on already-selected color (double-click effect)
                    IF m.ThemeColorPickerY = gridRow AND m.ThemeColorPickerX = gridCol THEN
                        ' Apply immediately (same as OK button)
                        DIM selectedColor AS INTEGER = gridRow * 16 + gridCol
                        m.ThemeEditingTheme = SetThemeColor(m.ThemeEditingTheme, m.ThemeEditorPropIdx, m.ThemeEditorColIdx, selectedColor)
                        m.ThemeEditingTheme.Name = "Custom"
                        m.DialogMode = DIALOG_THEME_EDITOR
                        m.ThemeEditorFocus = THEME_FOCUS_PROPS
                    ELSE
                        ' First click - just select the color
                        m.ThemeColorPickerY = gridRow
                        m.ThemeColorPickerX = gridCol
                    ENDIF
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF

        ' Buttons row (row 23)
        IF relY = 23 THEN
            ' "        [ OK ]    [Cancel]"
            IF relX >= 8 AND relX < 16 THEN
                ' OK - apply selected color
                DIM btnSelectedColor AS INTEGER = m.ThemeColorPickerY * 16 + m.ThemeColorPickerX
                m.ThemeEditingTheme = SetThemeColor(m.ThemeEditingTheme, m.ThemeEditorPropIdx, m.ThemeEditorColIdx, btnSelectedColor)
                m.ThemeEditingTheme.Name = "Custom"
                m.DialogMode = DIALOG_THEME_EDITOR
                m.ThemeEditorFocus = THEME_FOCUS_PROPS
            ELSEIF relX >= 20 AND relX < 30 THEN
                ' Cancel - return without applying
                m.DialogMode = DIALOG_THEME_EDITOR
                m.ThemeEditorFocus = THEME_FOCUS_PROPS
            ENDIF
            RETURN m, NIL
        ENDIF

        RETURN m, NIL
    ENDIF

    RETURN m, NIL
END FUNCTION
