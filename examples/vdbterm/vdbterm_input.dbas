' VDBTerm Input Handlers
' Keyboard, mouse, dialog, and menu input handling

FUNCTION HandleDialogInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.DialogMode = DIALOG_NONE
        RETURN m, NIL
    ENDIF

    ' Simple info dialogs
    IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
        IF key = "enter" OR key = " " THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Confirmation dialog
    IF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        IF key = "y" OR key = "Y" THEN
            RETURN m, tea.Quit
        ELSEIF key = "n" OR key = "N" THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Text input dialogs
    IF key = "enter" THEN
        IF m.DialogMode = DIALOG_NEW_PROJECT THEN
            m.Project = NewProject(m.DialogInput)
            m.ProjectLoaded = TRUE
            m.CurrentFormIdx = 0
            m.SelectedCtrlIdx = -1
            m.TreeIndex = 0
            ' Initialize tree expansion - all forms expanded by default
            m.TreeExpanded = []BOOLEAN{}
            m = EnsureTreeExpanded(m)
            m.Message = "New project: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_FORM THEN
            DIM addForm AS VDBForm
            addForm = NewForm(m.DialogInput)
            m.Project.Forms = APPEND(m.Project.Forms, addForm)
            m.CurrentFormIdx = Len(m.Project.Forms) - 1
            m.SelectedCtrlIdx = -1
            m.TreeExpanded = APPEND(m.TreeExpanded, TRUE)  ' Expand new form in tree
            m.Project.Modified = TRUE
            m.Message = "New form: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_MODULE THEN
            DIM addMod AS VDBModule
            addMod = NewModule(m.DialogInput)
            m.Project.Modules = APPEND(m.Project.Modules, addMod)
            m.Project.Modified = TRUE
            m.Message = "New module: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_SAVE_PROJECT THEN
            SaveProject(@m.Project, m.DialogInput)
            m.Message = "Project saved: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_OPEN_PROJECT THEN
            DIM loadedProj AS VDBProject
            DIM loadErr AS STRING
            loadedProj, loadErr = LoadProject(m.DialogInput)
            IF loadErr = "" THEN
                m.Project = loadedProj
                m.ProjectLoaded = TRUE
                m.CurrentFormIdx = 0
                m.SelectedCtrlIdx = -1
                m.TreeIndex = 0
                ' Initialize tree expansion - all forms expanded by default
                m.TreeExpanded = []BOOLEAN{}
                m = EnsureTreeExpanded(m)
                m.Message = "Project loaded: " & loadedProj.Name
            ELSE
                m.ErrorMsg = loadErr
                m.Message = "Failed to load project"
            ENDIF
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ELSEIF key = "backspace" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor - 1) & Mid(m.DialogInput, m.DialogCursor + 1, Len(m.DialogInput) - m.DialogCursor)
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "delete" THEN
        IF m.DialogCursor < Len(m.DialogInput) THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor) & Mid(m.DialogInput, m.DialogCursor + 2, Len(m.DialogInput) - m.DialogCursor - 1)
        ENDIF
    ELSEIF key = "left" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "right" THEN
        IF m.DialogCursor < Len(m.DialogInput) THEN
            m.DialogCursor = m.DialogCursor + 1
        ENDIF
    ELSEIF key = "home" THEN
        m.DialogCursor = 0
    ELSEIF key = "end" THEN
        m.DialogCursor = Len(m.DialogInput)
    ELSEIF Len(key) = 1 THEN
        m.DialogInput = Left(m.DialogInput, m.DialogCursor) & key & Mid(m.DialogInput, m.DialogCursor + 1, Len(m.DialogInput) - m.DialogCursor)
        m.DialogCursor = m.DialogCursor + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.MenuOpen = MENU_NONE
        RETURN m, NIL
    ELSEIF key = "left" THEN
        m.MenuOpen = m.MenuOpen - 1
        IF m.MenuOpen < MENU_FILE THEN
            m.MenuOpen = MENU_HELP
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "right" THEN
        m.MenuOpen = m.MenuOpen + 1
        IF m.MenuOpen > MENU_HELP THEN
            m.MenuOpen = MENU_FILE
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "up" THEN
        m.MenuIndex = m.MenuIndex - 1
        IF m.MenuIndex < 0 THEN
            m.MenuIndex = GetMenuItemCount(m.MenuOpen) - 1
        ENDIF
        RETURN m, NIL
    ELSEIF key = "down" THEN
        m.MenuIndex = m.MenuIndex + 1
        IF m.MenuIndex >= GetMenuItemCount(m.MenuOpen) THEN
            m.MenuIndex = 0
        ENDIF
        RETURN m, NIL
    ELSEIF key = "enter" THEN
        RETURN ExecuteMenuItem(m)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION GetMenuItemCount(menu AS INTEGER) AS INTEGER
    IF menu = MENU_FILE THEN
        RETURN 8
    ELSEIF menu = MENU_EDIT THEN
        RETURN 8
    ELSEIF menu = MENU_VIEW THEN
        RETURN 5
    ELSEIF menu = MENU_RUN THEN
        RETURN 4
    ELSEIF menu = MENU_DEBUG THEN
        RETURN 5
    ELSEIF menu = MENU_OPTIONS THEN
        RETURN 4
    ELSEIF menu = MENU_HELP THEN
        RETURN 2
    ENDIF
    RETURN 0
END FUNCTION

FUNCTION ExecuteMenuItem(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    DIM currentMenu AS INTEGER = m.MenuOpen
    m.MenuOpen = MENU_NONE

    IF currentMenu = MENU_FILE THEN
        IF m.MenuIndex = 0 THEN
            ' New Project
            m.DialogMode = DIALOG_NEW_PROJECT
            m.DialogInput = "Project1"
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 1 THEN
            ' Open Project
            m.DialogMode = DIALOG_OPEN_PROJECT
            m.DialogInput = ""
            m.DialogCursor = 0
        ELSEIF m.MenuIndex = 2 THEN
            ' Save Project
            IF Len(m.Project.Path) = 0 THEN
                m.DialogMode = DIALOG_SAVE_PROJECT
                m.DialogInput = m.Project.Name & ".vdb"
                m.DialogCursor = Len(m.DialogInput)
            ELSE
                SaveProject(@m.Project, m.Project.Path)
                m.Message = "Project saved"
            ENDIF
        ELSEIF m.MenuIndex = 4 THEN
            ' New Form
            m.DialogMode = DIALOG_NEW_FORM
            m.DialogInput = "Form" & Str(Len(m.Project.Forms) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 5 THEN
            ' New Module
            m.DialogMode = DIALOG_NEW_MODULE
            m.DialogInput = "Module" & Str(Len(m.Project.Modules) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 7 THEN
            ' Exit
            IF m.Project.Modified THEN
                m.DialogMode = DIALOG_CONFIRM_EXIT
            ELSE
                RETURN m, tea.Quit
            ENDIF
        ENDIF
    ELSEIF currentMenu = MENU_EDIT THEN
        IF m.MenuIndex = 7 THEN
            ' Menu Editor
            m.DialogMode = DIALOG_MENU_EDITOR
        ENDIF
    ELSEIF currentMenu = MENU_VIEW THEN
        IF m.MenuIndex = 0 THEN
            m.ViewMode = VIEW_FORM
        ELSEIF m.MenuIndex = 1 THEN
            m.ViewMode = VIEW_CODE
        ELSEIF m.MenuIndex = 3 THEN
            m.ShowGrid = NOT m.ShowGrid
        ENDIF
    ELSEIF currentMenu = MENU_RUN THEN
        IF m.MenuIndex = 0 THEN
            RETURN DoRun(m)
        ELSEIF m.MenuIndex = 1 THEN
            RETURN DoBuild(m)
        ENDIF
    ELSEIF currentMenu = MENU_OPTIONS THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_ENVIRONMENT
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_EDITOR
        ELSEIF m.MenuIndex = 3 THEN
            m.DialogMode = DIALOG_COLORS
        ENDIF
    ELSEIF currentMenu = MENU_HELP THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_HELP
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_ABOUT
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle input for Widgets panel (visible widgets: Button, Label, TextBox, etc.)
FUNCTION HandleWidgetsInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "up" THEN
        IF m.WidgetsIndex > 0 THEN
            m.WidgetsIndex = m.WidgetsIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.WidgetsIndex < VISIBLE_WIDGET_COUNT - 1 THEN
            m.WidgetsIndex = m.WidgetsIndex + 1
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Add visible control to form
        IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            ' Visible widgets are types 1-10 (CTRL_BUTTON to CTRL_VSCROLL)
            DIM ctlType AS INTEGER = m.WidgetsIndex + 1
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM ctrl AS VDBControl = NewControl(ctlType, ctlName, 5, 5)
            ctrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, ctrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.FocusArea = FOCUS_FORM
            m.Message = "Added " & ctlName
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

' Handle input for Toolbox panel (non-visible widgets: Timer)
FUNCTION HandleToolboxInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "up" THEN
        IF m.ToolboxIndex > 0 THEN
            m.ToolboxIndex = m.ToolboxIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.ToolboxIndex < NONVISIBLE_WIDGET_COUNT - 1 THEN
            m.ToolboxIndex = m.ToolboxIndex + 1
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Add non-visible control to form
        IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            ' Non-visible widgets start at CTRL_TIMER (11)
            DIM ctlType AS INTEGER = CTRL_TIMER + m.ToolboxIndex
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM ctrl AS VDBControl = NewControl(ctlType, ctlName, 0, 0)
            ctrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            ctrl.Width = 3
            ctrl.Height = 1
            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, ctrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.Message = "Added " & ctlName
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)

    IF key = "up" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "down" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "left" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "right" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "pgup" THEN
        ' Select previous control
        IF m.SelectedCtrlIdx > 0 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx - 1
        ENDIF
    ELSEIF key = "pgdown" THEN
        ' Select next control
        IF m.SelectedCtrlIdx < ctrlCount - 1 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx + 1
        ENDIF
    ELSEIF key = "delete" THEN
        ' Delete selected control
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            DIM newControls AS []VDBControl
            DIM i AS INTEGER
            FOR i = 0 TO ctrlCount - 1
                IF i <> m.SelectedCtrlIdx THEN
                    newControls = APPEND(newControls, m.Project.Forms[m.CurrentFormIdx].Controls[i])
                ENDIF
            NEXT
            m.Project.Forms[m.CurrentFormIdx].Controls = newControls
            IF m.SelectedCtrlIdx >= Len(newControls) THEN
                m.SelectedCtrlIdx = Len(newControls) - 1
            ENDIF
            m.Project.Modified = TRUE
            m.Message = "Control deleted"
        ENDIF
    ELSEIF key = "+" THEN
        ' Increase width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "-" THEN
        ' Decrease width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width > 1 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width - 1
                m.Project.Modified = TRUE
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    ' Legacy manual code handling (textarea handles input via HandleCodeInputMsg)
    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)
    DIM currentLine AS STRING = GetLine(code, m.CodeCursorY + 1)
    DIM lineLen AS INTEGER = Len(currentLine)

    IF key = "left" THEN
        IF m.CodeCursorX > 0 THEN
            m.CodeCursorX = m.CodeCursorX - 1
        ELSEIF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = Len(GetLine(code, m.CodeCursorY + 1))
        ENDIF
    ELSEIF key = "right" THEN
        IF m.CodeCursorX < lineLen THEN
            m.CodeCursorX = m.CodeCursorX + 1
        ELSEIF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            m.CodeCursorX = 0
        ENDIF
    ELSEIF key = "up" THEN
        IF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            DIM upLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > upLineLen THEN
                m.CodeCursorX = upLineLen
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            DIM downLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > downLineLen THEN
                m.CodeCursorX = downLineLen
            ENDIF
        ENDIF
    ELSEIF key = "home" THEN
        m.CodeCursorX = 0
    ELSEIF key = "end" THEN
        m.CodeCursorX = lineLen
    ELSEIF key = "enter" THEN
        ' Insert new line
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeNewLine(code, m.CodeCursorY + 1, m.CodeCursorX)
        m.CodeCursorY = m.CodeCursorY + 1
        m.CodeCursorX = 0
        m.Project.Modified = TRUE
    ELSEIF key = "backspace" THEN
        IF m.CodeCursorX > 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Code = DeleteCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX - 1)
            m.CodeCursorX = m.CodeCursorX - 1
            m.Project.Modified = TRUE
        ELSEIF m.CodeCursorY > 0 THEN
            DIM prevLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY))
            m.Project.Forms[m.CurrentFormIdx].Code = JoinCodeWithPrevLine(code, m.CodeCursorY + 1)
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = prevLineLen
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF Len(key) = 1 THEN
        ' Insert character
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX, key)
        m.CodeCursorX = m.CodeCursorX + 1
        m.Project.Modified = TRUE
    ENDIF

    ' Update scroll position
    DIM visibleLines AS INTEGER = m.Height - 6
    IF m.CodeCursorY < m.CodeScrollY THEN
        m.CodeScrollY = m.CodeCursorY
    ELSEIF m.CodeCursorY >= m.CodeScrollY + visibleLines THEN
        m.CodeScrollY = m.CodeCursorY - visibleLines + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle code input with raw message for textarea
FUNCTION HandleCodeInputMsg(m AS VDBTermModel, msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    IF NOT m.CodeEditorInited THEN
        ' Fall back to string-based handler
        DIM keyMsg AS tea.KeyMsg
        DIM ok AS BOOLEAN
        keyMsg, ok = msg.(tea.KeyMsg)
        IF ok THEN
            RETURN HandleCodeInput(m, keyMsg.String())
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Check for Tab key - insert spaces manually since textarea doesn't handle it
    DIM tabKeyMsg AS tea.KeyMsg
    DIM tabKeyOk AS BOOLEAN
    tabKeyMsg, tabKeyOk = msg.(tea.KeyMsg)
    IF tabKeyOk THEN
        DIM tabKey AS STRING = tabKeyMsg.String()
        IF tabKey = "tab" THEN
            ' Insert spaces based on TabSize setting
            DIM spaces AS STRING = RepeatStr(" ", m.TabSize)
            m.CodeEditor.InsertString(spaces)
            ' Sync to form
            m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            m.Project.Modified = TRUE
            ' Update cursor position
            m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
            m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Get previous code to detect changes
    DIM prevCode AS STRING = GetEditorCode(m.CodeEditor)

    ' Pass raw message to textarea
    DIM cmd AS tea.Cmd
    m.CodeEditor, cmd = HandleEditorKeyInput(m.CodeEditor, msg)

    ' Check if code changed
    DIM newCode AS STRING = GetEditorCode(m.CodeEditor)
    IF newCode <> prevCode THEN
        ' Sync back to form
        m.Project.Forms[m.CurrentFormIdx].Code = newCode
        m.Project.Modified = TRUE
    ENDIF

    ' Update legacy cursor position for status bar and rendering
    m.CodeCursorY = GetEditorCursorLine(m.CodeEditor)
    m.CodeCursorX = GetEditorCursorCol(m.CodeEditor)

    RETURN m, cmd
END FUNCTION

FUNCTION HandlePropertiesInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF m.PropEditing THEN
        ' Handle editing mode
        IF key = "enter" OR key = "esc" THEN
            IF key = "enter" THEN
                m = ApplyPropertyEdit(m)
                m.Message = "Property updated"
            ENDIF
            m.PropEditing = FALSE
            m.PropEditValue = ""
            m.PropEditFresh = FALSE
        ELSEIF key = "backspace" THEN
            IF m.PropEditFresh THEN
                ' Backspace on fresh edit clears all
                m.PropEditValue = ""
                m.PropEditFresh = FALSE
            ELSEIF Len(m.PropEditValue) > 0 THEN
                m.PropEditValue = Left(m.PropEditValue, Len(m.PropEditValue) - 1)
            ENDIF
        ELSEIF key = "left" OR key = "right" OR key = "home" OR key = "end" THEN
            ' Arrow keys deselect (keep value, allow editing)
            m.PropEditFresh = FALSE
        ELSEIF Len(key) = 1 THEN
            ' On first keystroke, clear existing value (like selected text replacement)
            IF m.PropEditFresh THEN
                m.PropEditValue = key
                m.PropEditFresh = FALSE
            ELSE
                m.PropEditValue = m.PropEditValue & key
            ENDIF
        ENDIF
    ELSE
        ' Handle navigation mode
        IF key = "up" THEN
            IF m.PropIndex > 0 THEN
                m.PropIndex = m.PropIndex - 1
            ENDIF
        ELSEIF key = "down" THEN
            ' Limit to valid property range
            DIM maxIdx AS INTEGER = 5  ' Form has 6 properties (0-5)
            IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
                    DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
                    maxIdx = GetControlPropertyCount(ctrl) - 1
                ENDIF
            ENDIF
            IF m.PropIndex < maxIdx THEN
                m.PropIndex = m.PropIndex + 1
            ENDIF
        ELSEIF key = "enter" OR key = "f2" THEN
            ' Start editing - load current value (shown as selected)
            m.PropEditValue = GetCurrentPropertyValue(m)
            IF Len(m.PropEditValue) > 0 OR CanEditProperty(m) THEN
                m.PropEditing = TRUE
                m.PropEditFresh = TRUE
            ENDIF
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION GetCurrentPropertyValue(m AS VDBTermModel) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN ""
    ENDIF

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        ' Type property (index 1) is read-only
        IF m.PropIndex = 1 THEN
            RETURN ""
        ENDIF
        RETURN GetControlPropertyValue(ctrl, m.PropIndex)
    ELSE
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF m.PropIndex = 0 THEN
            RETURN form.Name
        ELSEIF m.PropIndex = 1 THEN
            RETURN form.Caption
        ELSEIF m.PropIndex = 2 THEN
            RETURN Str(form.X)
        ELSEIF m.PropIndex = 3 THEN
            RETURN Str(form.Y)
        ELSEIF m.PropIndex = 4 THEN
            RETURN Str(form.Width)
        ELSEIF m.PropIndex = 5 THEN
            RETURN Str(form.Height)
        ENDIF
    ENDIF
    RETURN ""
END FUNCTION

FUNCTION CanEditProperty(m AS VDBTermModel) AS BOOLEAN
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN FALSE
    ENDIF

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        ' Type property (index 1) is read-only
        IF m.PropIndex = 1 THEN
            RETURN FALSE
        ENDIF
        ' Check if property index is valid for this control type
        RETURN m.PropIndex < GetControlPropertyCount(ctrl)
    ENDIF
    ' Form properties (0-5 are valid)
    RETURN m.PropIndex <= 5
END FUNCTION

FUNCTION ApplyPropertyEdit(m AS VDBTermModel) AS VDBTermModel
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m
    ENDIF

    DIM val AS STRING = m.PropEditValue

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctlType AS INTEGER = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CtlType

        ' Adjust index for controls without Caption
        DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctlType)
        DIM adjIdx AS INTEGER = m.PropIndex
        IF NOT hasCaption AND m.PropIndex >= 2 THEN
            adjIdx = m.PropIndex + 1
        ENDIF

        ' Base properties
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CtlName = val
        ELSEIF hasCaption AND m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Caption = val
        ELSEIF adjIdx = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = ParseIntStr(val)
        ELSEIF adjIdx = 4 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = ParseIntStr(val)
        ELSEIF adjIdx = 5 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = ParseIntStr(val)
        ELSEIF adjIdx = 6 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Height = ParseIntStr(val)
        ELSEIF adjIdx = 7 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Enabled = (val = "True" OR val = "true" OR val = "1")
        ELSEIF adjIdx = 8 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Visible = (val = "True" OR val = "true" OR val = "1")
        ELSEIF adjIdx = 9 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ZOrder = ParseIntStr(val)
        ELSE
            ' Type-specific properties
            DIM typeStartIdx AS INTEGER = 10
            IF NOT hasCaption THEN
                typeStartIdx = 9
            ENDIF
            DIM typeIdx AS INTEGER = m.PropIndex - typeStartIdx
            IF ctlType = CTRL_TEXTBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Placeholder = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CharLimit = ParseIntStr(val)
                ELSEIF typeIdx = 3 THEN
                    IF val = "Normal" OR val = "normal" OR val = "0" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 0
                    ELSEIF val = "Password" OR val = "password" OR val = "1" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 1
                    ELSE
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].EchoMode = 2
                    ENDIF
                ELSEIF typeIdx = 4 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Prompt = val
                ELSEIF typeIdx = 5 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CursorBlink = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_LISTBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Items = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Title = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowTitle = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowStatusBar = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 4 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowFilter = (val = "True" OR val = "true" OR val = "1")
                ELSEIF typeIdx = 5 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].InfiniteScrolling = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_COMBOBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Items = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowFilter = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_TIMER THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Interval = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_LABEL THEN
                IF typeIdx = 0 THEN
                    IF val = "Left" OR val = "left" OR val = "0" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_LEFT
                    ELSEIF val = "Center" OR val = "center" OR val = "1" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_CENTER
                    ELSEIF val = "Right" OR val = "right" OR val = "2" THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Justification = JUSTIFY_RIGHT
                    ENDIF
                ENDIF
            ELSEIF ctlType = CTRL_BUTTON THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Border = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_OPTION THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].GroupName = val
                ENDIF
            ELSEIF ctlType = CTRL_HSCROLL OR ctlType = CTRL_VSCROLL THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].MinValue = ParseIntStr(val)
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].MaxValue = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_CHECKBOX THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ENDIF
            ELSEIF ctlType = CTRL_TEXTAREA THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Placeholder = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CharLimit = ParseIntStr(val)
                ELSEIF typeIdx = 3 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowLineNumbers = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_PROGRESS THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Value = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Total = ParseIntStr(val)
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowPercentage = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ELSEIF ctlType = CTRL_SPINNER THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].SpinnerStyle = ParseIntStr(val)
                ENDIF
            ELSEIF ctlType = CTRL_TABLE THEN
                IF typeIdx = 0 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Columns = val
                ELSEIF typeIdx = 1 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Rows = val
                ELSEIF typeIdx = 2 THEN
                    m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ShowHeaders = (val = "True" OR val = "true" OR val = "1")
                ENDIF
            ENDIF
        ENDIF
        m.Project.Modified = TRUE
    ELSE
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Name = val
        ELSEIF m.PropIndex = 1 THEN
            m.Project.Forms[m.CurrentFormIdx].Caption = val
        ELSEIF m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].X = ParseIntStr(val)
        ELSEIF m.PropIndex = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Y = ParseIntStr(val)
        ELSEIF m.PropIndex = 4 THEN
            m.Project.Forms[m.CurrentFormIdx].Width = ParseIntStr(val)
        ELSEIF m.PropIndex = 5 THEN
            m.Project.Forms[m.CurrentFormIdx].Height = ParseIntStr(val)
        ENDIF
        m.Project.Modified = TRUE
    ENDIF

    RETURN m
END FUNCTION

FUNCTION HandleProjectInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    DIM totalItems AS INTEGER = GetTreeItemCount(m)

    IF key = "up" THEN
        IF m.TreeIndex > 0 THEN
            m.TreeIndex = m.TreeIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.TreeIndex < totalItems - 1 THEN
            m.TreeIndex = m.TreeIndex + 1
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Get info about selected item
        DIM itemType AS INTEGER
        DIM formIdx AS INTEGER
        DIM ctrlIdx AS INTEGER
        itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, m.TreeIndex)

        IF itemType = 1 THEN
            ' Form: toggle expansion and select it
            IF formIdx < Len(m.TreeExpanded) THEN
                m.TreeExpanded[formIdx] = NOT m.TreeExpanded[formIdx]
            ENDIF
            m.CurrentFormIdx = formIdx
            m.SelectedCtrlIdx = -1
            m.FocusArea = FOCUS_FORM
        ELSEIF itemType = 2 THEN
            ' Control: select it in the form editor
            m.CurrentFormIdx = formIdx
            m.SelectedCtrlIdx = ctrlIdx
            m.FocusArea = FOCUS_FORM
        ENDIF
    ELSEIF key = "left" THEN
        ' Collapse form if on a form row
        DIM itemType2 AS INTEGER
        DIM formIdx2 AS INTEGER
        DIM unused2 AS INTEGER
        itemType2, formIdx2, unused2 = GetTreeItemInfo(m, m.TreeIndex)
        unused2 = unused2  ' Suppress unused warning
        IF itemType2 = 1 AND formIdx2 < Len(m.TreeExpanded) THEN
            m.TreeExpanded[formIdx2] = FALSE
        ENDIF
    ELSEIF key = "right" THEN
        ' Expand form if on a form row
        DIM itemType3 AS INTEGER
        DIM formIdx3 AS INTEGER
        DIM unused3 AS INTEGER
        itemType3, formIdx3, unused3 = GetTreeItemInfo(m, m.TreeIndex)
        unused3 = unused3  ' Suppress unused warning
        IF itemType3 = 1 AND formIdx3 < Len(m.TreeExpanded) THEN
            m.TreeExpanded[formIdx3] = TRUE
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

' ============================================================================
' MOUSE INPUT HANDLER
' ============================================================================

FUNCTION HandleMouseInput(m AS VDBTermModel, mouseMsg AS tea.MouseMsg) AS (tea.Model, tea.Cmd)
    DIM x AS INTEGER = Int(mouseMsg.X)
    DIM y AS INTEGER = Int(mouseMsg.Y)
    DIM action AS tea.MouseAction = mouseMsg.Action
    DIM button AS tea.MouseButton = mouseMsg.Button

    ' Calculate layout dimensions (same as View())
    DIM leftPanelWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - leftPanelWidth - propertiesWidth
    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Panel boundaries (relative to content area, after menu bar row)
    DIM widgetsStart AS INTEGER = m.ProjectHeight
    DIM toolboxStart AS INTEGER = m.ProjectHeight + m.WidgetsHeight

    ' Handle mouse press events
    IF action = tea.MouseActionPress AND button = tea.MouseButtonLeft THEN
        ' Row 0 = Menu bar
        IF y = 0 THEN
            RETURN HandleMenuBarClick(m, x)
        ENDIF

        ' If dropdown menu is open, check for menu item click
        IF m.MenuOpen <> MENU_NONE THEN
            DIM dropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM dropWidth AS INTEGER = 20
            DIM dropRow AS INTEGER = y - 1

            IF x >= dropOffset AND x < dropOffset + dropWidth AND dropRow >= 0 THEN
                RETURN HandleDropdownClick(m, dropRow)
            ELSE
                ' Click outside dropdown closes it
                m.MenuOpen = MENU_NONE
                RETURN m, NIL
            ENDIF
        ENDIF

        ' If dialog is open, handle dialog clicks
        IF m.DialogMode <> DIALOG_NONE THEN
            RETURN HandleDialogClick(m, x, y, contentHeight)
        ENDIF

        ' If popup is open, handle popup clicks
        IF m.PopupMode <> POPUP_NONE THEN
            RETURN HandlePopupClick(m, x, y, contentHeight)
        ENDIF

        ' Adjust y for content area (subtract 1 for menu bar)
        DIM contentY AS INTEGER = y - 1

        ' Check which panel was clicked
        IF x < leftPanelWidth THEN
            ' Left column: Project (top) → Widgets (middle) → Toolbox (bottom)
            IF contentY < m.ProjectHeight THEN
                ' Project tree area
                RETURN HandleProjectClick(m, contentY)
            ELSEIF contentY < toolboxStart THEN
                ' Widgets panel area
                DIM widgetsLocalY AS INTEGER = contentY - widgetsStart
                ' Check if clicking on Widgets caption (first row of Widgets area)
                IF widgetsLocalY = 0 THEN
                    ' Start dragging Widgets caption to resize Project/Widgets
                    m.PanelDragging = PANEL_DRAG_WIDGETS
                    m.PanelDragStartY = y
                    m.PanelDragOrigHeight = m.ProjectHeight
                    RETURN m, NIL
                ENDIF
                RETURN HandleWidgetsClick(m, widgetsLocalY, TRUE)
            ELSE
                ' Toolbox panel area
                DIM toolboxLocalY AS INTEGER = contentY - toolboxStart
                ' Check if clicking on Toolbox caption (first row of Toolbox area)
                IF toolboxLocalY = 0 THEN
                    ' Start dragging Toolbox caption to resize Widgets/Toolbox
                    m.PanelDragging = PANEL_DRAG_TOOLBOX
                    m.PanelDragStartY = y
                    m.PanelDragOrigHeight = m.WidgetsHeight
                    RETURN m, NIL
                ENDIF
                RETURN HandleToolboxClick(m, toolboxLocalY)
            ENDIF
        ELSEIF x < leftPanelWidth + contentWidth THEN
            ' Main content area (full height)
            DIM localX AS INTEGER = x - leftPanelWidth
            IF m.ViewMode = VIEW_FORM THEN
                RETURN HandleFormClick(m, localX, contentY)
            ELSE
                ' Mouse positioning not supported in textarea v1
                ' Just set focus to code area
                m.FocusArea = FOCUS_CODE
                RETURN m, NIL
            ENDIF
        ELSE
            ' Properties panel
            RETURN HandlePropertiesClick(m, contentY)
        ENDIF

    ' Handle right-click for context menus (events popup)
    ELSEIF action = tea.MouseActionPress AND button = tea.MouseButtonRight THEN
        ' Close any existing popup first
        m.PopupMode = POPUP_NONE

        ' Adjust y for content area (subtract 1 for menu bar)
        DIM rcContentY AS INTEGER = y - 1

        IF x < leftPanelWidth THEN
            ' Left column: Project tree, Widgets, or Toolbox
            IF rcContentY < m.ProjectHeight THEN
                ' Project tree - check if clicking on a control
                RETURN HandleProjectRightClick(m, rcContentY, x, y)
            ELSEIF rcContentY < toolboxStart THEN
                ' Widgets panel
                DIM rcWidgetsLocalY AS INTEGER = rcContentY - widgetsStart
                RETURN HandleWidgetsRightClick(m, rcWidgetsLocalY, x, y)
            ELSE
                ' Toolbox panel
                DIM rcToolboxLocalY AS INTEGER = rcContentY - toolboxStart
                RETURN HandleToolboxRightClick(m, rcToolboxLocalY, x, y)
            ENDIF
        ELSEIF x < leftPanelWidth + contentWidth THEN
            ' Main content area - form designer
            IF m.ViewMode = VIEW_FORM THEN
                DIM rcLocalX AS INTEGER = x - leftPanelWidth
                RETURN HandleFormRightClick(m, rcLocalX, rcContentY, x, y)
            ENDIF
        ENDIF

    ' Handle panel caption dragging
    ELSEIF action = tea.MouseActionMotion AND m.PanelDragging <> PANEL_DRAG_NONE THEN
        DIM dragDelta AS INTEGER = y - m.PanelDragStartY

        IF m.PanelDragging = PANEL_DRAG_WIDGETS THEN
            ' Dragging Widgets caption - moves boundary between Project and Widgets
            ' Project grows/shrinks, Widgets shrinks/grows, Toolbox unchanged
            DIM newProjectHeight AS INTEGER = m.PanelDragOrigHeight + dragDelta
            ' Enforce minimum Project height
            IF newProjectHeight < 3 THEN
                newProjectHeight = 3
            ENDIF
            ' Maximum: leave at least 3 for Widgets and current Toolbox
            DIM maxProjectHeight AS INTEGER = contentHeight - 3 - m.ToolboxHeight
            IF newProjectHeight > maxProjectHeight THEN
                newProjectHeight = maxProjectHeight
            ENDIF
            ' Calculate how much Project changed and adjust Widgets to compensate
            DIM deltaProject AS INTEGER = newProjectHeight - m.ProjectHeight
            m.ProjectHeight = newProjectHeight
            m.WidgetsHeight = m.WidgetsHeight - deltaProject
            IF m.WidgetsHeight < 3 THEN
                m.WidgetsHeight = 3
            ENDIF
        ELSEIF m.PanelDragging = PANEL_DRAG_TOOLBOX THEN
            ' Dragging Toolbox caption - moves boundary between Widgets and Toolbox
            ' Widgets grows/shrinks, Toolbox shrinks/grows, Project unchanged
            DIM newWidgetsHeight AS INTEGER = m.PanelDragOrigHeight + dragDelta
            ' Enforce minimum Widgets height
            IF newWidgetsHeight < 3 THEN
                newWidgetsHeight = 3
            ENDIF
            ' Maximum: leave at least 2 for Toolbox
            DIM maxWidgetsHeight AS INTEGER = contentHeight - m.ProjectHeight - 2
            IF newWidgetsHeight > maxWidgetsHeight THEN
                newWidgetsHeight = maxWidgetsHeight
            ENDIF
            m.WidgetsHeight = newWidgetsHeight
            ' Recalculate Toolbox height to fill remaining space
            m.ToolboxHeight = contentHeight - m.ProjectHeight - m.WidgetsHeight
            IF m.ToolboxHeight < 2 THEN
                m.ToolboxHeight = 2
            ENDIF
        ENDIF
        RETURN m, NIL

    ' Handle mouse drag - only update outline position, not actual control/form
    ELSEIF action = tea.MouseActionMotion AND m.IsDragging THEN
        ' Skip every other frame to reduce rendering overhead
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM dragContentY AS INTEGER = y - 1
            DIM dragLocalX AS INTEGER = x - leftPanelWidth

            IF m.DraggingForm THEN
                ' Form drag - position relative to canvas
                DIM newFormX AS INTEGER = dragLocalX - m.DragStartX
                DIM newFormY AS INTEGER = dragContentY - m.DragStartY

                IF newFormX < 0 THEN
                    newFormX = 0
                ENDIF
                IF newFormY < 0 THEN
                    newFormY = 0
                ENDIF

                m.DragOutlineX = newFormX
                m.DragOutlineY = newFormY
            ELSEIF m.SelectedCtrlIdx >= 0 THEN
                ' Control drag - position relative to form content area
                DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
                DIM ctrlFormX AS INTEGER = dragLocalX - form.X - 1
                DIM ctrlFormY AS INTEGER = dragContentY - form.Y - 1

                DIM newX AS INTEGER = ctrlFormX - m.DragStartX
                DIM newY AS INTEGER = ctrlFormY - m.DragStartY

                IF newX < 0 THEN
                    newX = 0
                ENDIF
                IF newY < 0 THEN
                    newY = 0
                ENDIF

                ' Only update outline position during drag
                m.DragOutlineX = newX
                m.DragOutlineY = newY
            ENDIF
        ENDIF

    ' Handle mouse resize - update outline size based on corner being dragged
    ELSEIF action = tea.MouseActionMotion AND m.IsResizing THEN
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM resizeContentY AS INTEGER = y - 1
            DIM resizeLocalX AS INTEGER = x - leftPanelWidth

            DIM resizeForm AS VDBForm = m.Project.Forms[m.CurrentFormIdx]

            ' For form resize, use screen coordinates relative to form origin
            ' For control resize, adjust for form position and borders
            DIM resFormX AS INTEGER = resizeLocalX
            DIM resFormY AS INTEGER = resizeContentY
            IF NOT m.ResizingForm THEN
                resFormX = resizeLocalX - resizeForm.X - 1
                resFormY = resizeContentY - resizeForm.Y - 1
            ENDIF

            DIM resNewX AS INTEGER = m.ResizeOrigX
            DIM resNewY AS INTEGER = m.ResizeOrigY
            DIM resNewW AS INTEGER = m.ResizeOrigW
            DIM resNewH AS INTEGER = m.ResizeOrigH

            IF m.ResizingForm THEN
                ' Form resize - calculate new size based on mouse position relative to form origin
                IF m.ResizeCorner = HANDLE_TR OR m.ResizeCorner = HANDLE_BR OR m.ResizeCorner = HANDLE_RIGHT THEN
                    resNewW = resFormX - resizeForm.X + 1
                ENDIF
                IF m.ResizeCorner = HANDLE_BL OR m.ResizeCorner = HANDLE_BR OR m.ResizeCorner = HANDLE_BOTTOM THEN
                    resNewH = resFormY - resizeForm.Y + 1
                ENDIF
                ' Form doesn't support resizing from top/left (would need to move controls)
            ELSE
                ' Control resize
                IF m.SelectedCtrlIdx < 0 THEN
                    RETURN m, NIL
                ENDIF
                IF m.ResizeCorner = HANDLE_TL THEN
                    ' Top-left corner: move origin, shrink from top-left
                    resNewX = resFormX
                    resNewY = resFormY
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_TR THEN
                    ' Top-right corner: move Y, change width, shrink from top
                    resNewY = resFormY
                    resNewW = resFormX - m.ResizeOrigX + 1
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_BL THEN
                    ' Bottom-left corner: move X, change height, shrink from left
                    resNewX = resFormX
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_BR THEN
                    ' Bottom-right corner: just change width and height
                    resNewW = resFormX - m.ResizeOrigX + 1
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_TOP THEN
                    ' Top edge: move Y, change height (vertical only)
                    resNewY = resFormY
                    resNewH = m.ResizeOrigY + m.ResizeOrigH - resFormY
                ELSEIF m.ResizeCorner = HANDLE_BOTTOM THEN
                    ' Bottom edge: change height only
                    resNewH = resFormY - m.ResizeOrigY + 1
                ELSEIF m.ResizeCorner = HANDLE_LEFT THEN
                    ' Left edge: move X, change width (horizontal only)
                    resNewX = resFormX
                    resNewW = m.ResizeOrigX + m.ResizeOrigW - resFormX
                ELSEIF m.ResizeCorner = HANDLE_RIGHT THEN
                    ' Right edge: change width only
                    resNewW = resFormX - m.ResizeOrigX + 1
                ENDIF
            ENDIF

            ' Enforce minimum size
            DIM minW AS INTEGER = 5
            DIM minH AS INTEGER = 3
            IF NOT m.ResizingForm THEN
                minW = 2
                minH = 1
            ENDIF
            IF resNewW < minW THEN
                resNewW = minW
                IF m.ResizeCorner = HANDLE_TL OR m.ResizeCorner = HANDLE_BL OR m.ResizeCorner = HANDLE_LEFT THEN
                    resNewX = m.ResizeOrigX + m.ResizeOrigW - minW
                ENDIF
            ENDIF
            IF resNewH < minH THEN
                resNewH = minH
                IF m.ResizeCorner = HANDLE_TL OR m.ResizeCorner = HANDLE_TR OR m.ResizeCorner = HANDLE_TOP THEN
                    resNewY = m.ResizeOrigY + m.ResizeOrigH - minH
                ENDIF
            ENDIF
            IF resNewX < 0 THEN
                resNewX = 0
            ENDIF
            IF resNewY < 0 THEN
                resNewY = 0
            ENDIF

            m.DragOutlineX = resNewX
            m.DragOutlineY = resNewY
            m.DragCtrlWidth = resNewW
            m.DragCtrlHeight = resNewH
        ENDIF

    ' Handle mouse drag for widget from toolbox
    ELSEIF action = tea.MouseActionMotion AND m.DraggingFromWidgets THEN
        m.DragSkipFrame = NOT m.DragSkipFrame
        IF m.DragSkipFrame THEN
            RETURN m, NIL
        ENDIF
        IF m.ViewMode = VIEW_FORM THEN
            DIM widgetDragY AS INTEGER = y - 1
            DIM widgetDragX AS INTEGER = x - leftPanelWidth

            ' Check if mouse is over the form area
            IF widgetDragX >= 0 AND widgetDragX < contentWidth THEN
                DIM wdForm AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
                ' Calculate position relative to form content area (inside border)
                DIM formRelX AS INTEGER = widgetDragX - wdForm.X - 1
                DIM formRelY AS INTEGER = widgetDragY - wdForm.Y - 1

                ' Clamp to form bounds
                IF formRelX < 0 THEN
                    formRelX = 0
                ENDIF
                IF formRelY < 0 THEN
                    formRelY = 0
                ENDIF
                IF formRelX + m.DragCtrlWidth > wdForm.Width - 2 THEN
                    formRelX = wdForm.Width - 2 - m.DragCtrlWidth
                    IF formRelX < 0 THEN
                        formRelX = 0
                    ENDIF
                ENDIF
                IF formRelY + m.DragCtrlHeight > wdForm.Height - 2 THEN
                    formRelY = wdForm.Height - 2 - m.DragCtrlHeight
                    IF formRelY < 0 THEN
                        formRelY = 0
                    ENDIF
                ENDIF

                m.DragOutlineX = formRelX
                m.DragOutlineY = formRelY
            ENDIF
        ENDIF

    ' Handle mouse release - apply final position/size
    ELSEIF action = tea.MouseActionRelease THEN
        IF m.PanelDragging <> PANEL_DRAG_NONE THEN
            ' End panel caption dragging
            m.PanelDragging = PANEL_DRAG_NONE
            m.Message = "Panel resized"
            RETURN m, NIL
        ELSEIF m.IsDragging THEN
            IF m.DraggingForm THEN
                ' Apply the final position to the form
                IF m.ViewMode = VIEW_FORM THEN
                    m.Project.Forms[m.CurrentFormIdx].X = m.DragOutlineX
                    m.Project.Forms[m.CurrentFormIdx].Y = m.DragOutlineY
                    m.Project.Modified = TRUE
                ENDIF
                m.IsDragging = FALSE
                m.DraggingForm = FALSE
                m.Message = "Form moved"
            ELSE
                ' Apply the final outline position to the actual control
                IF m.ViewMode = VIEW_FORM AND m.SelectedCtrlIdx >= 0 THEN
                    DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)
                    IF m.SelectedCtrlIdx < ctrlCount THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.DragOutlineX
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.DragOutlineY
                        m.Project.Modified = TRUE
                    ENDIF
                ENDIF
                m.IsDragging = FALSE
                m.Message = "Control moved"
            ENDIF
        ELSEIF m.IsResizing THEN
            IF m.ResizingForm THEN
                ' Apply the final size to the form
                IF m.ViewMode = VIEW_FORM THEN
                    m.Project.Forms[m.CurrentFormIdx].Width = m.DragCtrlWidth
                    m.Project.Forms[m.CurrentFormIdx].Height = m.DragCtrlHeight
                    m.Project.Modified = TRUE
                ENDIF
                m.IsResizing = FALSE
                m.ResizingForm = FALSE
                m.Message = "Form resized"
            ELSE
                ' Apply the final size to the actual control
                IF m.ViewMode = VIEW_FORM AND m.SelectedCtrlIdx >= 0 THEN
                    DIM ctrlCount2 AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)
                    IF m.SelectedCtrlIdx < ctrlCount2 THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.DragOutlineX
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.DragOutlineY
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.DragCtrlWidth
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Height = m.DragCtrlHeight
                        m.Project.Modified = TRUE
                    ENDIF
                ENDIF
                m.IsResizing = FALSE
                m.Message = "Control resized"
            ENDIF
        ELSEIF m.DraggingFromWidgets THEN
            ' Drop widget from toolbox onto form
            IF m.ViewMode = VIEW_FORM AND m.DragOutlineX >= 0 AND m.DragOutlineY >= 0 THEN
                DIM ctlType AS INTEGER = m.DragWidgetType
                DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
                DIM newCtrl AS VDBControl = NewControl(ctlType, ctlName, m.DragOutlineX, m.DragOutlineY)
                newCtrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
                newCtrl.ZOrder = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
                m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
                m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, newCtrl)
                m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
                m.Project.Modified = TRUE
                m.FocusArea = FOCUS_FORM
                m.Message = "Added " & ctlName & " at (" & Str(m.DragOutlineX) & "," & Str(m.DragOutlineY) & ")"
            ELSE
                m.Message = "Drop cancelled - not over form"
            ENDIF
            m.DraggingFromWidgets = FALSE
            m.DragWidgetType = 0
            m.DragOutlineX = -1
            m.DragOutlineY = -1
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuBarClick(m AS VDBTermModel, x AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Menu positions: File(0-5), Edit(6-11), View(12-17), Run(18-22), Debug(23-29), Options(30-38), Help(39-45)
    IF x >= 0 AND x < 6 THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
    ELSEIF x >= 6 AND x < 12 THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
    ELSEIF x >= 12 AND x < 18 THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
    ELSEIF x >= 18 AND x < 23 THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
    ELSEIF x >= 23 AND x < 30 THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
    ELSEIF x >= 30 AND x < 39 THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
    ELSEIF x >= 39 AND x < 46 THEN
        m.MenuOpen = MENU_HELP
        m.MenuIndex = 0
    ELSE
        m.MenuOpen = MENU_NONE
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleDropdownClick(m AS VDBTermModel, row AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is the top border, so actual menu items start at row 1
    DIM itemIdx AS INTEGER = row - 1

    IF itemIdx < 0 THEN
        RETURN m, NIL
    ENDIF

    ' Determine valid menu item indices based on current menu
    DIM maxItems AS INTEGER

    IF m.MenuOpen = MENU_FILE THEN
        maxItems = 8
        ' Items: 0=New Project, 1=Open, 2=Save, 3=separator, 4=New Form, 5=New Module, 6=separator, 7=Exit
        IF itemIdx = 3 OR itemIdx = 6 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_EDIT THEN
        maxItems = 8
        ' Items: 0=Cut, 1=Copy, 2=Paste, 3=separator, 4=Select All, 5=Delete, 6=separator, 7=Menu Editor
        IF itemIdx = 3 OR itemIdx = 6 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_VIEW THEN
        maxItems = 5
        ' Items: 0=Form View, 1=Code View, 2=separator, 3=Show Grid, 4=Line Numbers
        IF itemIdx = 2 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_RUN THEN
        maxItems = 4
        ' Items: 0=Run, 1=Build, 2=separator, 3=Set Startup
        IF itemIdx = 2 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_DEBUG THEN
        maxItems = 5
        ' Items: 0=Step, 1=Breakpoint, 2=Watch, 3=separator, 4=Clear All
        IF itemIdx = 3 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
        maxItems = 4
        ' Items: 0=Environment, 1=Editor, 2=Colors, 3=Compiler
    ELSEIF m.MenuOpen = MENU_HELP THEN
        maxItems = 3
        ' Items: 0=Contents, 1=separator, 2=About
        IF itemIdx = 1 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSE
        RETURN m, NIL
    ENDIF

    IF itemIdx >= maxItems THEN
        RETURN m, NIL
    ENDIF

    ' Set menu index and simulate Enter key to execute menu action
    m.MenuIndex = itemIdx
    RETURN HandleMenuInput(m, "enter")
END FUNCTION

' Handle click on Widgets panel (visible widgets: Button, Label, TextBox, etc.)
FUNCTION HandleWidgetsClick(m AS VDBTermModel, y AS INTEGER, startDrag AS BOOLEAN) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_WIDGETS

    ' Row 0 is the title (handled in HandleMouseInput for dragging), items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 AND itemIdx < VISIBLE_WIDGET_COUNT THEN
        m.WidgetsIndex = itemIdx

        ' Start drag operation if requested
        IF startDrag AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            m.DraggingFromWidgets = TRUE
            m.DragWidgetType = WidgetIndexToCtrlType(itemIdx)
            ' Set initial outline size based on widget defaults
            DIM tempCtrl AS VDBControl = NewControl(m.DragWidgetType, "temp", 0, 0)
            m.DragCtrlWidth = tempCtrl.Width
            m.DragCtrlHeight = tempCtrl.Height
            m.DragOutlineX = -1  ' Will be set when mouse enters form area
            m.DragOutlineY = -1
            m.Message = "Drag to form to place " & GetControlTypeName(m.DragWidgetType)
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' Handle click on Toolbox panel (non-visible widgets: Timer)
FUNCTION HandleToolboxClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_TOOLBOX

    ' Row 0 is the title (handled in HandleMouseInput for dragging), items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 AND itemIdx < NONVISIBLE_WIDGET_COUNT THEN
        m.ToolboxIndex = itemIdx
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_FORM

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
    DIM formX AS INTEGER = form.X
    DIM formY AS INTEGER = form.Y
    DIM formW AS INTEGER = form.Width
    DIM formH AS INTEGER = form.Height

    ' Check if click is outside form bounds
    IF x < formX OR x >= formX + formW OR y < formY OR y >= formY + formH THEN
        ' Click outside form - select form (deselect any control)
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    ' Coordinates relative to form
    DIM relX AS INTEGER = x - formX
    DIM relY AS INTEGER = y - formY

    ' Check if clicking on form border/handles when form is selected
    DIM formIsSelected AS BOOLEAN = (m.SelectedCtrlIdx < 0)
    DIM onFormBorder AS BOOLEAN = (relX = 0 OR relX = formW - 1 OR relY = 0 OR relY = formH - 1)

    IF formIsSelected AND onFormBorder THEN
        DIM centerCol AS INTEGER = formW / 2
        DIM centerRow AS INTEGER = formH / 2
        DIM formHandle AS INTEGER = HANDLE_NONE

        ' Check title bar (row 0)
        IF relY = 0 THEN
            IF relX = 0 THEN
                formHandle = HANDLE_TL
            ELSEIF relX = formW - 1 THEN
                formHandle = HANDLE_TR
            ELSEIF relX = centerCol AND formW >= 3 THEN
                formHandle = HANDLE_TOP
            ENDIF
        ' Check bottom border (row formH-1)
        ELSEIF relY = formH - 1 THEN
            IF relX = 0 THEN
                formHandle = HANDLE_BL
            ELSEIF relX = formW - 1 THEN
                formHandle = HANDLE_BR
            ELSEIF relX = centerCol AND formW >= 3 THEN
                formHandle = HANDLE_BOTTOM
            ENDIF
        ' Check left edge
        ELSEIF relX = 0 AND relY = centerRow AND formH >= 3 THEN
            formHandle = HANDLE_LEFT
        ' Check right edge
        ELSEIF relX = formW - 1 AND relY = centerRow AND formH >= 3 THEN
            formHandle = HANDLE_RIGHT
        ENDIF

        IF formHandle <> HANDLE_NONE THEN
            ' Start form resize operation
            m.IsResizing = TRUE
            m.ResizingForm = TRUE
            m.IsDragging = FALSE
            m.DraggingForm = FALSE
            m.DragSkipFrame = FALSE
            m.ResizeCorner = formHandle
            m.ResizeOrigX = formX
            m.ResizeOrigY = formY
            m.ResizeOrigW = formW
            m.ResizeOrigH = formH
            m.DragOutlineX = formX
            m.DragOutlineY = formY
            m.DragCtrlWidth = formW
            m.DragCtrlHeight = formH
            m.Message = "Resizing form"
            RETURN m, NIL
        ELSE
            ' Clicked on form border but not a handle - start form drag
            m.IsDragging = TRUE
            m.DraggingForm = TRUE
            m.IsResizing = FALSE
            m.DragSkipFrame = FALSE
            m.DragStartX = relX
            m.DragStartY = relY
            m.DragOutlineX = formX
            m.DragOutlineY = formY
            m.DragCtrlWidth = formW
            m.DragCtrlHeight = formH
            m.Message = "Moving form"
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Click on form border when form is not selected - select the form
    IF onFormBorder THEN
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    ' Coordinates relative to form content area (inside borders)
    DIM contentX AS INTEGER = relX - 1
    DIM contentY AS INTEGER = relY - 1

    IF contentX < 0 OR contentY < 0 THEN
        ' This shouldn't happen if we're past the border checks
        m.SelectedCtrlIdx = -1
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(form.Controls)

    ' Check if click is on a control (iterate forward - first in array is topmost visually)
    DIM i AS INTEGER
    FOR i = 0 TO ctrlCount - 1
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[i]
        IF contentX >= ctrl.X AND contentX < ctrl.X + ctrl.Width AND contentY >= ctrl.Y AND contentY < ctrl.Y + ctrl.Height THEN
            DIM localX AS INTEGER = contentX - ctrl.X
            DIM localY AS INTEGER = contentY - ctrl.Y
            DIM isSelected AS BOOLEAN = (i = m.SelectedCtrlIdx)

            ' Check if clicking on a resize handle of already-selected control
            IF isSelected THEN
                DIM onTop AS BOOLEAN = (localY = 0)
                DIM onBottom AS BOOLEAN = (localY = ctrl.Height - 1)
                DIM onLeft AS BOOLEAN = (localX = 0)
                DIM onRight AS BOOLEAN = (localX = ctrl.Width - 1)
                DIM centerX AS INTEGER = ctrl.Width / 2
                DIM centerY AS INTEGER = ctrl.Height / 2
                DIM atCenterX AS BOOLEAN = (localX = centerX)
                DIM atCenterY AS BOOLEAN = (localY = centerY)

                DIM handle AS INTEGER = HANDLE_NONE

                ' Check corners first (they take priority)
                IF onTop AND onLeft THEN
                    handle = HANDLE_TL
                ELSEIF onTop AND onRight THEN
                    handle = HANDLE_TR
                ELSEIF onBottom AND onLeft THEN
                    handle = HANDLE_BL
                ELSEIF onBottom AND onRight THEN
                    handle = HANDLE_BR
                ' Check edge handles (only if control is large enough)
                ELSEIF onTop AND atCenterX AND ctrl.Width >= 3 THEN
                    handle = HANDLE_TOP
                ELSEIF onBottom AND atCenterX AND ctrl.Width >= 3 THEN
                    handle = HANDLE_BOTTOM
                ELSEIF onLeft AND atCenterY AND ctrl.Height >= 3 THEN
                    handle = HANDLE_LEFT
                ELSEIF onRight AND atCenterY AND ctrl.Height >= 3 THEN
                    handle = HANDLE_RIGHT
                ENDIF

                IF handle <> HANDLE_NONE THEN
                    ' Start resize operation for control
                    m.IsResizing = TRUE
                    m.ResizingForm = FALSE
                    m.IsDragging = FALSE
                    m.DragSkipFrame = FALSE
                    m.ResizeCorner = handle
                    m.ResizeOrigX = ctrl.X
                    m.ResizeOrigY = ctrl.Y
                    m.ResizeOrigW = ctrl.Width
                    m.ResizeOrigH = ctrl.Height
                    m.DragOutlineX = ctrl.X
                    m.DragOutlineY = ctrl.Y
                    m.DragCtrlWidth = ctrl.Width
                    m.DragCtrlHeight = ctrl.Height
                    m.Message = "Resizing: " & ctrl.CtlName
                    RETURN m, NIL
                ENDIF
            ENDIF

            ' Select the control and start drag operation
            m.SelectedCtrlIdx = i
            m.IsDragging = TRUE
            m.IsResizing = FALSE
            m.DragSkipFrame = FALSE
            m.DragStartX = localX
            m.DragStartY = localY
            m.DragOutlineX = ctrl.X
            m.DragOutlineY = ctrl.Y
            m.DragCtrlWidth = ctrl.Width
            m.DragCtrlHeight = ctrl.Height
            m.Message = "Dragging: " & ctrl.CtlName
            RETURN m, NIL
        ENDIF
    NEXT

    ' Clicked on empty area - deselect
    m.SelectedCtrlIdx = -1
    m.Message = ""

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, ctrlPressed AS BOOLEAN) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_CODE

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)

    ' Adjust for line numbers if shown
    DIM textX AS INTEGER = x
    IF m.ShowLineNumbers THEN
        textX = x - 5  ' Line number column width
        IF textX < 0 THEN
            textX = 0
        ENDIF
    ENDIF

    ' Set cursor position
    DIM targetLine AS INTEGER = y + m.CodeScrollY
    IF targetLine >= totalLines THEN
        targetLine = totalLines - 1
    ENDIF
    IF targetLine < 0 THEN
        targetLine = 0
    ENDIF

    DIM lineText AS STRING = GetLine(code, targetLine + 1)
    DIM targetCol AS INTEGER = textX + m.CodeScrollX
    IF targetCol > Len(lineText) THEN
        targetCol = Len(lineText)
    ENDIF
    IF targetCol < 0 THEN
        targetCol = 0
    ENDIF

    m.CodeCursorY = targetLine
    m.CodeCursorX = targetCol

    ' Position textarea cursor if using textarea editor
    IF m.CodeEditorInited THEN
        m.CodeEditor = SetEditorCursor(m.CodeEditor, targetLine, targetCol)
    ENDIF

    ' Handle Ctrl+click for go-to-definition
    IF ctrlPressed THEN
        DIM word AS STRING = GetWordAtColumn(lineText, targetCol)
        IF Len(word) > 0 THEN
            DIM defFormIdx AS INTEGER
            DIM defLineNum AS INTEGER
            DIM defColNum AS INTEGER
            defFormIdx, defLineNum, defColNum = FindDefinition(m.Project, word)

            IF defFormIdx >= 0 THEN
                ' Found definition in a form
                m.CurrentFormIdx = defFormIdx
                m.CodeCursorY = defLineNum
                m.CodeCursorX = defColNum
                m.CodeScrollY = defLineNum
                IF m.CodeScrollY > 0 THEN
                    m.CodeScrollY = m.CodeScrollY - 3
                    IF m.CodeScrollY < 0 THEN
                        m.CodeScrollY = 0
                    ENDIF
                ENDIF
                m.ViewMode = VIEW_CODE
                m.Message = "Found: " & word
            ELSEIF defFormIdx < -1 THEN
                ' Found in a module (encoded as -(modIdx + 1000))
                m.Message = "Definition in module (modules not editable in this view)"
            ELSE
                m.Message = "Definition not found: " & word
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePropertiesClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROPERTIES

    ' Row 0 is the title, properties start at row 1
    IF y >= 1 THEN
        DIM newPropIndex AS INTEGER = y - 1
        DIM now AS time.Time = time.Now()

        ' If clicking on a different property while editing, cancel current edit
        IF m.PropEditing AND newPropIndex <> m.PropIndex THEN
            m.PropEditing = FALSE
            m.PropEditValue = ""
        ENDIF

        ' Check for double-click on same property (within 500ms)
        DIM isDoubleClick AS BOOLEAN = FALSE
        IF newPropIndex = m.PropLastClickIdx THEN
            DIM elapsed AS time.Duration = now.Sub(m.PropLastClickTime)
            IF elapsed < time.Millisecond * 300 THEN
                isDoubleClick = TRUE
            ENDIF
        ENDIF

        ' Update last click tracking
        m.PropLastClickTime = now
        m.PropLastClickIdx = newPropIndex

        ' Handle double-click on boolean property
        IF isDoubleClick AND m.SelectedCtrlIdx >= 0 THEN
            ' Check if we have a valid control selected
            IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                IF m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
                    DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
                    ' If it's a boolean property, toggle it
                    IF IsPropertyBoolean(ctrl, newPropIndex) THEN
                        m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx] = ToggleBooleanProperty(ctrl, newPropIndex)
                        m.Project.Modified = TRUE
                        ' Reset click tracking to prevent triple-click toggle
                        m.PropLastClickIdx = -1
                        RETURN m, NIL
                    ENDIF
                ENDIF
            ENDIF
        ENDIF

        m.PropIndex = newPropIndex
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleProjectClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROJECT

    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 THEN
        DIM totalItems AS INTEGER = GetTreeItemCount(m)
        IF itemIdx < totalItems THEN
            m.TreeIndex = itemIdx

            ' Get info about clicked item
            DIM itemType AS INTEGER
            DIM formIdx AS INTEGER
            DIM ctrlIdx AS INTEGER
            itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

            IF itemType = 1 THEN
                ' Clicked on a form - toggle expansion and select it
                IF formIdx < Len(m.TreeExpanded) THEN
                    m.TreeExpanded[formIdx] = NOT m.TreeExpanded[formIdx]
                ENDIF
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = -1
            ELSEIF itemType = 2 THEN
                ' Clicked on a control - select it in the form editor
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = ctrlIdx
                m.FocusArea = FOCUS_FORM
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' RIGHT-CLICK HANDLERS (Event Popup)
' ============================================================================

FUNCTION HandleProjectRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Ensure tree expansion array is properly sized
    m = EnsureTreeExpanded(m)

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = localY - 1
    IF itemIdx >= 0 THEN
        DIM totalItems AS INTEGER = GetTreeItemCount(m)
        IF itemIdx < totalItems THEN
            ' Get info about clicked item
            DIM itemType AS INTEGER
            DIM formIdx AS INTEGER
            DIM ctrlIdx AS INTEGER
            itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

            IF itemType = 1 THEN
                ' Right-clicked on a form - show form events
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = -1
                m.PopupMode = POPUP_EVENTS
                m.PopupX = screenX
                m.PopupY = screenY
                m.PopupCtrlIdx = -1  ' -1 means form itself
                m.PopupCtrlType = CTRL_FORM
                m.PopupEvents = GetControlEvents(CTRL_FORM)
                m.PopupIndex = 0
            ELSEIF itemType = 2 THEN
                ' Right-clicked on a control - show control events
                m.CurrentFormIdx = formIdx
                m.SelectedCtrlIdx = ctrlIdx
                DIM ctrl AS VDBControl = m.Project.Forms[formIdx].Controls[ctrlIdx]
                m.PopupMode = POPUP_EVENTS
                m.PopupX = screenX
                m.PopupY = screenY
                m.PopupCtrlIdx = ctrlIdx
                m.PopupCtrlType = ctrl.CtlType
                m.PopupEvents = GetControlEvents(ctrl.CtlType)
                m.PopupIndex = 0
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleWidgetsRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is title, widgets start at row 1
    IF localY >= 1 THEN
        DIM widgetIdx AS INTEGER = localY - 1
        IF widgetIdx < VISIBLE_WIDGET_COUNT THEN
            DIM ctlType AS INTEGER = WidgetIndexToCtrlType(widgetIdx)
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = -2  ' -2 means widget panel (not a real control)
            m.PopupCtrlType = ctlType
            m.PopupEvents = GetControlEvents(ctlType)
            m.PopupIndex = 0
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleToolboxRightClick(m AS VDBTermModel, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is title, tools start at row 1
    IF localY >= 1 THEN
        DIM toolIdx AS INTEGER = localY - 1
        IF toolIdx < NONVISIBLE_WIDGET_COUNT THEN
            ' Timer is the only non-visible widget
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = -2  ' -2 means toolbox panel (not a real control)
            m.PopupCtrlType = CTRL_TIMER
            m.PopupEvents = GetControlEvents(CTRL_TIMER)
            m.PopupIndex = 0
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormRightClick(m AS VDBTermModel, localX AS INTEGER, localY AS INTEGER, screenX AS INTEGER, screenY AS INTEGER) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]

    ' Calculate position within form content
    DIM formStartX AS INTEGER = 1
    DIM formStartY AS INTEGER = 1
    DIM contentX AS INTEGER = localX - formStartX - form.X
    DIM contentY AS INTEGER = localY - formStartY - form.Y

    ' Check if click is on form or a control
    DIM ctrlCount AS INTEGER = Len(form.Controls)
    DIM i AS INTEGER

    ' Iterate forward to get topmost control (first in array is on top)
    FOR i = 0 TO ctrlCount - 1
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[i]
        IF contentX >= ctrl.X AND contentX < ctrl.X + ctrl.Width AND contentY >= ctrl.Y AND contentY < ctrl.Y + ctrl.Height THEN
            ' Found a control
            m.SelectedCtrlIdx = i
            m.PopupMode = POPUP_EVENTS
            m.PopupX = screenX
            m.PopupY = screenY
            m.PopupCtrlIdx = i
            m.PopupCtrlType = ctrl.CtlType
            m.PopupEvents = GetControlEvents(ctrl.CtlType)
            m.PopupIndex = 0
            RETURN m, NIL
        ENDIF
    NEXT

    ' No control found - right-clicked on form background
    m.SelectedCtrlIdx = -1
    m.PopupMode = POPUP_EVENTS
    m.PopupX = screenX
    m.PopupY = screenY
    m.PopupCtrlIdx = -1  ' -1 means form itself
    m.PopupCtrlType = CTRL_FORM
    m.PopupEvents = GetControlEvents(CTRL_FORM)
    m.PopupIndex = 0

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePopupClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, contentHeight AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Calculate popup position and size
    DIM popupWidth AS INTEGER = GetPopupWidth(m)
    DIM popupHeight AS INTEGER = Len(m.PopupEvents) + 4  ' +4 for title bar and borders

    DIM popupStartRow AS INTEGER = m.PopupY
    DIM popupStartCol AS INTEGER = m.PopupX

    ' Adjust if popup would go off screen
    IF popupStartRow + popupHeight > contentHeight + 1 THEN
        popupStartRow = contentHeight + 1 - popupHeight
    ENDIF
    IF popupStartCol + popupWidth > m.Width THEN
        popupStartCol = m.Width - popupWidth
    ENDIF
    IF popupStartRow < 1 THEN
        popupStartRow = 1
    ENDIF
    IF popupStartCol < 0 THEN
        popupStartCol = 0
    ENDIF

    ' Check if click is inside popup
    DIM relX AS INTEGER = x - popupStartCol
    DIM relY AS INTEGER = y - popupStartRow

    IF relX < 0 OR relX >= popupWidth OR relY < 0 OR relY >= popupHeight THEN
        ' Click outside popup - close it
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ENDIF

    ' Check if clicking on an event item (rows 3+ are event items, 0-indexed: row 3 = first event)
    DIM eventRow AS INTEGER = relY - 3
    IF eventRow >= 0 AND eventRow < Len(m.PopupEvents) THEN
        m.PopupIndex = eventRow
        DIM eventName AS STRING = m.PopupEvents[eventRow]
        RETURN OpenOrCreateEventHandler(m, eventName)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePopupInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.PopupMode = POPUP_NONE
        RETURN m, NIL
    ELSEIF key = "up" THEN
        IF m.PopupIndex > 0 THEN
            m.PopupIndex = m.PopupIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.PopupIndex < Len(m.PopupEvents) - 1 THEN
            m.PopupIndex = m.PopupIndex + 1
        ENDIF
    ELSEIF key = "enter" THEN
        ' Select the event - open or create handler
        IF m.PopupIndex < Len(m.PopupEvents) THEN
            DIM eventName AS STRING = m.PopupEvents[m.PopupIndex]
            RETURN OpenOrCreateEventHandler(m, eventName)
        ENDIF
        m.PopupMode = POPUP_NONE
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION OpenOrCreateEventHandler(m AS VDBTermModel, eventName AS STRING) AS (tea.Model, tea.Cmd)
    m.PopupMode = POPUP_NONE

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    ' Get control name
    DIM ctrlName AS STRING
    IF m.PopupCtrlIdx = -1 THEN
        ' Form itself
        ctrlName = m.Project.Forms[m.CurrentFormIdx].Name
    ELSEIF m.PopupCtrlIdx = -2 THEN
        ' Widget/Toolbox panel - just show message, can't create handler
        m.Message = GetControlTypeName(m.PopupCtrlType) & " events: " & eventName
        RETURN m, NIL
    ELSE
        ' Control
        ctrlName = m.Project.Forms[m.CurrentFormIdx].Controls[m.PopupCtrlIdx].CtlName
    ENDIF

    ' Get form code
    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code

    ' Look for existing handler
    DIM lineNum AS INTEGER = FindEventHandler(code, ctrlName, eventName)

    IF lineNum > 0 THEN
        ' Found existing handler - navigate to it
        m.ViewMode = VIEW_CODE
        m.FocusArea = FOCUS_CODE
        m.CodeCursorY = lineNum - 1
        m.CodeCursorX = 0
        m.CodeScrollY = lineNum - 3
        IF m.CodeScrollY < 0 THEN
            m.CodeScrollY = 0
        ENDIF
        m.Message = "Opened: " & ctrlName & "_" & eventName
    ELSE
        ' Create new handler stub
        DIM stub AS STRING = GenerateEventStub(ctrlName, eventName)
        m.Project.Forms[m.CurrentFormIdx].Code = code & stub
        m.Project.Modified = TRUE

        ' Navigate to the new handler
        DIM newCode AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
        lineNum = FindEventHandler(newCode, ctrlName, eventName)
        m.ViewMode = VIEW_CODE
        m.FocusArea = FOCUS_CODE
        IF lineNum > 0 THEN
            m.CodeCursorY = lineNum - 1
            m.CodeCursorX = 0
            m.CodeScrollY = lineNum - 3
            IF m.CodeScrollY < 0 THEN
                m.CodeScrollY = 0
            ENDIF
        ENDIF
        m.Message = "Created: " & ctrlName & "_" & eventName
    ENDIF

    ' Update textarea if initialized
    IF m.CodeEditorInited THEN
        m.CodeEditor.SetValue(m.Project.Forms[m.CurrentFormIdx].Code)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleDialogClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER, contentHeight AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Calculate dialog position and size
    DIM dialogWidth AS INTEGER
    DIM dialogHeight AS INTEGER
    dialogWidth, dialogHeight = GetDialogSize(m)

    DIM dialogStartRow AS INTEGER = (contentHeight - dialogHeight) / 2 + 1  ' +1 for menu bar
    DIM dialogStartCol AS INTEGER = (m.Width - dialogWidth) / 2

    IF dialogStartRow < 1 THEN
        dialogStartRow = 1
    ENDIF
    IF dialogStartCol < 0 THEN
        dialogStartCol = 0
    ENDIF

    ' Check if click is inside dialog
    DIM relX AS INTEGER = x - dialogStartCol
    DIM relY AS INTEGER = y - dialogStartRow

    IF relX < 0 OR relX >= dialogWidth OR relY < 0 OR relY >= dialogHeight THEN
        ' Click outside dialog - close it for simple dialogs
        IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Handle clicks based on dialog type
    IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
        ' Any click closes the dialog
        m.DialogMode = DIALOG_NONE
        RETURN m, NIL
    ENDIF

    IF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        ' Check for Yes/No button clicks
        ' "  < Yes (Y) >   < No (N) >" is on row 4 (0-indexed: content starts at row 1)
        IF relY = 5 THEN
            IF relX >= 2 AND relX < 14 THEN
                ' Yes button clicked
                RETURN m, tea.Quit
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' No button clicked
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' For input dialogs (New Project, Save Project, New Form, New Module, Open Project)
    IF m.DialogMode = DIALOG_NEW_PROJECT OR m.DialogMode = DIALOG_SAVE_PROJECT OR m.DialogMode = DIALOG_NEW_FORM OR m.DialogMode = DIALOG_NEW_MODULE OR m.DialogMode = DIALOG_OPEN_PROJECT THEN
        ' Check for OK/Cancel button clicks
        ' "  < OK >        < Cancel >" is on row 4 (content row 3)
        IF relY = 4 THEN
            IF relX >= 2 AND relX < 10 THEN
                ' OK button clicked - simulate Enter
                RETURN HandleDialogInput(m, "enter")
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' Cancel button clicked - simulate Escape
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    ' For options dialogs
    IF m.DialogMode = DIALOG_ENVIRONMENT OR m.DialogMode = DIALOG_EDITOR OR m.DialogMode = DIALOG_COLORS THEN
        ' Check for OK/Cancel button clicks on the last content row
        DIM btnRow AS INTEGER = dialogHeight - 2
        IF relY = btnRow THEN
            IF relX >= 2 AND relX < 10 THEN
                ' OK button clicked
                m.DialogMode = DIALOG_NONE
            ELSEIF relX >= 16 AND relX < 28 THEN
                ' Cancel button clicked
                m.DialogMode = DIALOG_NONE
            ENDIF
        ENDIF
        RETURN m, NIL
    ENDIF

    RETURN m, NIL
END FUNCTION
