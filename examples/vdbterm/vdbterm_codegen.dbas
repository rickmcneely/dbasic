' VDBTerm Code Generation
' BubbleTea application generation from VDBTerm forms

' Helper function to substitute {prop:X} placeholders with property values
FUNCTION SubstitutePluginPropPlaceholders(template AS STRING, ctrl AS VDBControl, plugin AS PluginWidgetDef) AS STRING
    DIM result AS STRING = template

    ' Replace {prop:PropName} with actual property value from ExtendedProps or default
    DIM i AS INTEGER
    FOR i = 0 TO Len(plugin.Properties) - 1
        DIM prop AS PluginProperty = plugin.Properties[i]
        DIM placeholder AS STRING = "{prop:" & prop.Name & "}"
        DIM value AS STRING = ""

        ' Try to get value from ExtendedProps
        IF ctrl.ExtendedProps <> "" THEN
            value = ExtractJSONString(ctrl.ExtendedProps, prop.Name)
        ENDIF

        ' Use default if not found
        IF value = "" THEN
            IF prop.PropType = "string" THEN
                value = Chr(34) & prop.DefaultStr & Chr(34)
            ELSEIF prop.PropType = "integer" THEN
                value = Str(prop.DefaultInt)
            ELSEIF prop.PropType = "boolean" THEN
                IF prop.DefaultBool THEN
                    value = "TRUE"
                ELSE
                    value = "FALSE"
                ENDIF
            ELSE
                value = Chr(34) & prop.DefaultStr & Chr(34)
            ENDIF
        ELSE
            ' Format value based on type
            IF prop.PropType = "string" THEN
                value = Chr(34) & value & Chr(34)
            ELSEIF prop.PropType = "boolean" THEN
                IF value = "true" OR value = "1" THEN
                    value = "TRUE"
                ELSE
                    value = "FALSE"
                ENDIF
            ENDIF
        ENDIF

        result = ReplaceAll(result, placeholder, value)
    NEXT

    ' Replace standard placeholders
    result = ReplaceAll(result, "{width}", Str(ctrl.Width))
    result = ReplaceAll(result, "{height}", Str(ctrl.Height))
    result = ReplaceAll(result, "{fgColor}", Str(ctrl.ForeColor))
    result = ReplaceAll(result, "{bgColor}", Str(ctrl.BackColor))

    RETURN result
END FUNCTION

' Generate theme type and global variable for runtime access
FUNCTION GenerateThemeConstants(theme AS VDBTheme) AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)

    code = code & "' ============================================" & Chr(10)
    code = code & "' Theme Constants (Runtime Access)" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate AppTheme type
    code = code & "TYPE AppTheme" & Chr(10)
    code = code & "    DIM Name AS STRING" & Chr(10)
    code = code & "    DIM FormForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM FormBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM ButtonForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM ButtonBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM LabelForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM LabelBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM TextBoxForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM TextBoxBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM CheckBoxForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM CheckBoxBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM OptionForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM OptionBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM ListBoxForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM ListBoxBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM ComboBoxForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM ComboBoxBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM FrameForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM FrameBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM TextAreaForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM TextAreaBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM ProgressForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM ProgressBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM SpinnerForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM SpinnerBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM PathForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM PathBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM DirectoriesForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM DirectoriesBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM FilesForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM FilesBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM DirBrowserForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM DirBrowserBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM FocusedForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM FocusedBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM SelectedForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM SelectedBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM MenuForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM MenuBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM MenuSelectedForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM MenuSelectedBackColor AS INTEGER" & Chr(10)
    code = code & "    DIM MenuShortcutForeColor AS INTEGER" & Chr(10)
    code = code & "    DIM Use256Colors AS BOOLEAN" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Generate global Theme variable
    code = code & "DIM Theme AS AppTheme" & Chr(10)
    code = code & Chr(10)

    ' Generate InitTheme function
    code = code & "SUB InitTheme()" & Chr(10)
    code = code & "    Theme.Name = " & q & theme.Name & q & Chr(10)
    code = code & "    Theme.FormForeColor = " & Str(theme.FormForeColor) & Chr(10)
    code = code & "    Theme.FormBackColor = " & Str(theme.FormBackColor) & Chr(10)
    code = code & "    Theme.ButtonForeColor = " & Str(theme.ButtonForeColor) & Chr(10)
    code = code & "    Theme.ButtonBackColor = " & Str(theme.ButtonBackColor) & Chr(10)
    code = code & "    Theme.LabelForeColor = " & Str(theme.LabelForeColor) & Chr(10)
    code = code & "    Theme.LabelBackColor = " & Str(theme.LabelBackColor) & Chr(10)
    code = code & "    Theme.TextBoxForeColor = " & Str(theme.TextBoxForeColor) & Chr(10)
    code = code & "    Theme.TextBoxBackColor = " & Str(theme.TextBoxBackColor) & Chr(10)
    code = code & "    Theme.CheckBoxForeColor = " & Str(theme.CheckBoxForeColor) & Chr(10)
    code = code & "    Theme.CheckBoxBackColor = " & Str(theme.CheckBoxBackColor) & Chr(10)
    code = code & "    Theme.OptionForeColor = " & Str(theme.OptionForeColor) & Chr(10)
    code = code & "    Theme.OptionBackColor = " & Str(theme.OptionBackColor) & Chr(10)
    code = code & "    Theme.ListBoxForeColor = " & Str(theme.ListBoxForeColor) & Chr(10)
    code = code & "    Theme.ListBoxBackColor = " & Str(theme.ListBoxBackColor) & Chr(10)
    code = code & "    Theme.ComboBoxForeColor = " & Str(theme.ComboBoxForeColor) & Chr(10)
    code = code & "    Theme.ComboBoxBackColor = " & Str(theme.ComboBoxBackColor) & Chr(10)
    code = code & "    Theme.FrameForeColor = " & Str(theme.FrameForeColor) & Chr(10)
    code = code & "    Theme.FrameBackColor = " & Str(theme.FrameBackColor) & Chr(10)
    code = code & "    Theme.TextAreaForeColor = " & Str(theme.TextAreaForeColor) & Chr(10)
    code = code & "    Theme.TextAreaBackColor = " & Str(theme.TextAreaBackColor) & Chr(10)
    code = code & "    Theme.ProgressForeColor = " & Str(theme.ProgressForeColor) & Chr(10)
    code = code & "    Theme.ProgressBackColor = " & Str(theme.ProgressBackColor) & Chr(10)
    code = code & "    Theme.SpinnerForeColor = " & Str(theme.SpinnerForeColor) & Chr(10)
    code = code & "    Theme.SpinnerBackColor = " & Str(theme.SpinnerBackColor) & Chr(10)
    code = code & "    Theme.PathForeColor = " & Str(theme.PathForeColor) & Chr(10)
    code = code & "    Theme.PathBackColor = " & Str(theme.PathBackColor) & Chr(10)
    code = code & "    Theme.DirectoriesForeColor = " & Str(theme.DirectoriesForeColor) & Chr(10)
    code = code & "    Theme.DirectoriesBackColor = " & Str(theme.DirectoriesBackColor) & Chr(10)
    code = code & "    Theme.FilesForeColor = " & Str(theme.FilesForeColor) & Chr(10)
    code = code & "    Theme.FilesBackColor = " & Str(theme.FilesBackColor) & Chr(10)
    code = code & "    Theme.DirBrowserForeColor = " & Str(theme.DirBrowserForeColor) & Chr(10)
    code = code & "    Theme.DirBrowserBackColor = " & Str(theme.DirBrowserBackColor) & Chr(10)
    code = code & "    Theme.FocusedForeColor = " & Str(theme.FocusedForeColor) & Chr(10)
    code = code & "    Theme.FocusedBackColor = " & Str(theme.FocusedBackColor) & Chr(10)
    code = code & "    Theme.SelectedForeColor = " & Str(theme.SelectedForeColor) & Chr(10)
    code = code & "    Theme.SelectedBackColor = " & Str(theme.SelectedBackColor) & Chr(10)
    code = code & "    Theme.MenuForeColor = " & Str(theme.MenuForeColor) & Chr(10)
    code = code & "    Theme.MenuBackColor = " & Str(theme.MenuBackColor) & Chr(10)
    code = code & "    Theme.MenuSelectedForeColor = " & Str(theme.MenuSelectedForeColor) & Chr(10)
    code = code & "    Theme.MenuSelectedBackColor = " & Str(theme.MenuSelectedBackColor) & Chr(10)
    code = code & "    Theme.MenuShortcutForeColor = " & Str(theme.MenuShortcutForeColor) & Chr(10)
    IF theme.Use256Colors THEN
        code = code & "    Theme.Use256Colors = TRUE" & Chr(10)
    ELSE
        code = code & "    Theme.Use256Colors = FALSE" & Chr(10)
    ENDIF
    code = code & "END SUB" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate MsgBox constants and support functions
FUNCTION GenerateMsgBoxSupport() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)

    code = code & "' ============================================" & Chr(10)
    code = code & "' MsgBox Constants and Support" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Global flag to trigger repaint after MsgBox
    code = code & "' Flag to trigger screen repaint after MsgBox returns" & Chr(10)
    code = code & "DIM _msgBoxNeedsRepaint AS BOOLEAN = FALSE" & Chr(10)
    code = code & Chr(10)
    code = code & "' Helper to check if MsgBox was shown and return appropriate command" & Chr(10)
    code = code & "FUNCTION _checkMsgBoxRepaint() AS tea.Cmd" & Chr(10)
    code = code & "    IF _msgBoxNeedsRepaint THEN" & Chr(10)
    code = code & "        _msgBoxNeedsRepaint = FALSE" & Chr(10)
    code = code & "        RETURN tea.ClearScreen" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Button style constants
    code = code & "' MsgBox button styles" & Chr(10)
    code = code & "CONST vbOKOnly AS INTEGER = 0" & Chr(10)
    code = code & "CONST vbOKCancel AS INTEGER = 1" & Chr(10)
    code = code & "CONST vbYesNo AS INTEGER = 4" & Chr(10)
    code = code & "CONST vbYesNoCancel AS INTEGER = 3" & Chr(10)
    code = code & "CONST vbRetryCancel AS INTEGER = 5" & Chr(10)
    code = code & Chr(10)

    ' Return value constants
    code = code & "' MsgBox return values" & Chr(10)
    code = code & "CONST vbOK AS INTEGER = 1" & Chr(10)
    code = code & "CONST vbCancel AS INTEGER = 2" & Chr(10)
    code = code & "CONST vbYes AS INTEGER = 6" & Chr(10)
    code = code & "CONST vbNo AS INTEGER = 7" & Chr(10)
    code = code & "CONST vbRetry AS INTEGER = 4" & Chr(10)
    code = code & Chr(10)

    ' MsgBox dialog model type for the temporary program
    code = code & "' MsgBox dialog model for blocking display with overlay" & Chr(10)
    code = code & "TYPE MsgBoxDialogModel" & Chr(10)
    code = code & "    DIM Title AS STRING" & Chr(10)
    code = code & "    DIM Message AS STRING" & Chr(10)
    code = code & "    DIM Buttons AS INTEGER" & Chr(10)
    code = code & "    DIM SelectedBtn AS INTEGER" & Chr(10)
    code = code & "    DIM Result AS INTEGER" & Chr(10)
    code = code & "    DIM Width AS INTEGER" & Chr(10)
    code = code & "    DIM Height AS INTEGER" & Chr(10)
    code = code & "    DIM Background AS STRING" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Init for MsgBoxDialogModel
    code = code & "FUNCTION (m AS MsgBoxDialogModel) Init() AS tea.Cmd" & Chr(10)
    code = code & "    RETURN NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Update for MsgBoxDialogModel
    code = code & "FUNCTION (m AS MsgBoxDialogModel) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)" & Chr(10)
    code = code & "    ' Handle window size" & Chr(10)
    code = code & "    DIM wsMsg AS tea.WindowSizeMsg" & Chr(10)
    code = code & "    DIM wsOk AS BOOLEAN" & Chr(10)
    code = code & "    wsMsg, wsOk = msg.(tea.WindowSizeMsg)" & Chr(10)
    code = code & "    IF wsOk THEN" & Chr(10)
    code = code & "        m.Width = Int(wsMsg.Width)" & Chr(10)
    code = code & "        m.Height = Int(wsMsg.Height)" & Chr(10)
    code = code & "        RETURN m, NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle mouse events" & Chr(10)
    code = code & "    DIM mouseMsg AS tea.MouseMsg" & Chr(10)
    code = code & "    DIM mouseOk AS BOOLEAN" & Chr(10)
    code = code & "    mouseMsg, mouseOk = msg.(tea.MouseMsg)" & Chr(10)
    code = code & "    IF mouseOk THEN" & Chr(10)
    code = code & "        ' Calculate dialog position (same logic as View)" & Chr(10)
    code = code & "        DIM msgLines AS []STRING = strings.Split(m.Message, Chr(10))" & Chr(10)
    code = code & "        DIM maxLineLen AS INTEGER = Len(m.Title) + 4" & Chr(10)
    code = code & "        DIM li AS INTEGER" & Chr(10)
    code = code & "        FOR li = 0 TO Len(msgLines) - 1" & Chr(10)
    code = code & "            IF Len(msgLines[li]) + 4 > maxLineLen THEN" & Chr(10)
    code = code & "                maxLineLen = Len(msgLines[li]) + 4" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        NEXT" & Chr(10)
    code = code & "        DIM btnWidth AS INTEGER = 20" & Chr(10)
    code = code & "        IF m.Buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "            btnWidth = 30" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        IF maxLineLen < btnWidth THEN" & Chr(10)
    code = code & "            maxLineLen = btnWidth" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        DIM dlgWidth AS INTEGER = maxLineLen + 2" & Chr(10)
    code = code & "        DIM dlgHeight AS INTEGER = Len(msgLines) + 6" & Chr(10)
    code = code & "        DIM startX AS INTEGER = (m.Width - dlgWidth) / 2" & Chr(10)
    code = code & "        DIM startY AS INTEGER = (m.Height - dlgHeight) / 2" & Chr(10)
    code = code & "        IF startX < 0 THEN" & Chr(10)
    code = code & "            startX = 0" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        IF startY < 0 THEN" & Chr(10)
    code = code & "            startY = 0" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "        ' Button row is at startY + dlgHeight - 3 (third from last line in dialog)" & Chr(10)
    code = code & "        DIM buttonRowY AS INTEGER = startY + dlgHeight - 3" & Chr(10)
    code = code & "        DIM innerWidth AS INTEGER = dlgWidth - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "        ' Check if click is on button row (left button press only)" & Chr(10)
    code = code & "        IF mouseMsg.Y = buttonRowY AND mouseMsg.Action = tea.MouseActionPress AND mouseMsg.Button = tea.MouseButtonLeft THEN" & Chr(10)
    code = code & "            DIM clickedBtn AS INTEGER = MsgBoxGetClickedButton(m.Buttons, mouseMsg.X, startX, innerWidth)" & Chr(10)
    code = code & "            IF clickedBtn >= 0 THEN" & Chr(10)
    code = code & "                m.SelectedBtn = clickedBtn" & Chr(10)
    code = code & "                m.Result = MsgBoxGetResult(m.Buttons, m.SelectedBtn)" & Chr(10)
    code = code & "                RETURN m, tea.Quit" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN m, NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM keyOk AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg, keyOk = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "    IF keyOk THEN" & Chr(10)
    code = code & "        DIM keyBtnCount AS INTEGER = MsgBoxBtnCount(m.Buttons)" & Chr(10)
    code = code & "        IF keyMsg.String() = " & q & "left" & q & " OR keyMsg.String() = " & q & "shift+tab" & q & " THEN" & Chr(10)
    code = code & "            IF m.SelectedBtn > 0 THEN" & Chr(10)
    code = code & "                m.SelectedBtn = m.SelectedBtn - 1" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                m.SelectedBtn = keyBtnCount - 1" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF keyMsg.String() = " & q & "right" & q & " OR keyMsg.String() = " & q & "tab" & q & " THEN" & Chr(10)
    code = code & "            IF m.SelectedBtn < keyBtnCount - 1 THEN" & Chr(10)
    code = code & "                m.SelectedBtn = m.SelectedBtn + 1" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                m.SelectedBtn = 0" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF keyMsg.String() = " & q & "enter" & q & " OR keyMsg.String() = " & q & " " & q & " THEN" & Chr(10)
    code = code & "            m.Result = MsgBoxGetResult(m.Buttons, m.SelectedBtn)" & Chr(10)
    code = code & "            RETURN m, tea.Quit" & Chr(10)
    code = code & "        ELSEIF keyMsg.String() = " & q & "escape" & q & " THEN" & Chr(10)
    code = code & "            IF m.Buttons = vbYesNo THEN" & Chr(10)
    code = code & "                m.Result = vbNo" & Chr(10)
    code = code & "            ELSEIF m.Buttons = vbOKOnly THEN" & Chr(10)
    code = code & "                m.Result = vbOK" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                m.Result = vbCancel" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            RETURN m, tea.Quit" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN m, NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' View for MsgBoxDialogModel - overlays dialog on background
    code = code & "FUNCTION (m AS MsgBoxDialogModel) View() AS STRING" & Chr(10)
    code = code & "    DIM msgLines AS []STRING = strings.Split(m.Message, Chr(10))" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Calculate dialog dimensions" & Chr(10)
    code = code & "    DIM maxLineLen AS INTEGER = Len(m.Title) + 4" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(msgLines) - 1" & Chr(10)
    code = code & "        IF Len(msgLines[i]) + 4 > maxLineLen THEN" & Chr(10)
    code = code & "            maxLineLen = Len(msgLines[i]) + 4" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Ensure minimum width for buttons" & Chr(10)
    code = code & "    DIM btnWidth AS INTEGER = 20" & Chr(10)
    code = code & "    IF m.Buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        btnWidth = 30" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    IF maxLineLen < btnWidth THEN" & Chr(10)
    code = code & "        maxLineLen = btnWidth" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM dlgWidth AS INTEGER = maxLineLen + 2" & Chr(10)
    code = code & "    DIM dlgHeight AS INTEGER = Len(msgLines) + 6" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Center dialog on screen" & Chr(10)
    code = code & "    DIM startX AS INTEGER = (m.Width - dlgWidth) / 2" & Chr(10)
    code = code & "    DIM startY AS INTEGER = (m.Height - dlgHeight) / 2" & Chr(10)
    code = code & "    IF startX < 0 THEN" & Chr(10)
    code = code & "        startX = 0" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    IF startY < 0 THEN" & Chr(10)
    code = code & "        startY = 0" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM innerWidth AS INTEGER = dlgWidth - 2" & Chr(10)
    code = code & "    DIM dlgStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(" & q & "15" & q & ")).Background(lipgloss.Color(" & q & "4" & q & "))" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Build dialog lines (plain text, we will style the whole dialog)" & Chr(10)
    code = code & "    DIM dlgLines AS []STRING" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Top border with title" & Chr(10)
    code = code & "    DIM titlePad AS INTEGER = (innerWidth - Len(m.Title) - 2) / 2" & Chr(10)
    code = code & "    DIM titleLine AS STRING = " & q & "╔" & q & " & strings.Repeat(" & q & "═" & q & ", titlePad) & " & q & " " & q & " & m.Title & " & q & " " & q & " & strings.Repeat(" & q & "═" & q & ", innerWidth - titlePad - Len(m.Title) - 2) & " & q & "╗" & q & Chr(10)
    code = code & "    dlgLines = APPEND(dlgLines, titleLine)" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Empty line" & Chr(10)
    code = code & "    dlgLines = APPEND(dlgLines, " & q & "║" & q & " & strings.Repeat(" & q & " " & q & ", innerWidth) & " & q & "║" & q & ")" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Message lines" & Chr(10)
    code = code & "    FOR i = 0 TO Len(msgLines) - 1" & Chr(10)
    code = code & "        DIM mLine AS STRING = msgLines[i]" & Chr(10)
    code = code & "        DIM padding AS INTEGER = innerWidth - Len(mLine) - 2" & Chr(10)
    code = code & "        IF padding < 0 THEN" & Chr(10)
    code = code & "            padding = 0" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        DIM leftPad AS INTEGER = padding / 2" & Chr(10)
    code = code & "        DIM rightPad AS INTEGER = padding - leftPad" & Chr(10)
    code = code & "        dlgLines = APPEND(dlgLines, " & q & "║ " & q & " & strings.Repeat(" & q & " " & q & ", leftPad) & mLine & strings.Repeat(" & q & " " & q & ", rightPad) & " & q & " ║" & q & ")" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Empty line" & Chr(10)
    code = code & "    dlgLines = APPEND(dlgLines, " & q & "║" & q & " & strings.Repeat(" & q & " " & q & ", innerWidth) & " & q & "║" & q & ")" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Buttons" & Chr(10)
    code = code & "    DIM btnLine AS STRING = MsgBoxRenderButtons(m.Buttons, m.SelectedBtn)" & Chr(10)
    code = code & "    DIM btnPadding AS INTEGER = innerWidth - Len(btnLine)" & Chr(10)
    code = code & "    IF btnPadding < 0 THEN" & Chr(10)
    code = code & "        btnPadding = 0" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM btnLeftPad AS INTEGER = btnPadding / 2" & Chr(10)
    code = code & "    DIM btnRightPad AS INTEGER = btnPadding - btnLeftPad" & Chr(10)
    code = code & "    dlgLines = APPEND(dlgLines, " & q & "║" & q & " & strings.Repeat(" & q & " " & q & ", btnLeftPad) & btnLine & strings.Repeat(" & q & " " & q & ", btnRightPad) & " & q & "║" & q & ")" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Bottom border" & Chr(10)
    code = code & "    dlgLines = APPEND(dlgLines, " & q & "╚" & q & " & strings.Repeat(" & q & "═" & q & ", innerWidth) & " & q & "╝" & q & ")" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Build complete dialog as single styled block" & Chr(10)
    code = code & "    DIM dlgText AS STRING = strings.Join(dlgLines, Chr(10))" & Chr(10)
    code = code & "    DIM styledDlg AS STRING = dlgStyle.Render(dlgText)" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Center dialog on blank screen" & Chr(10)
    code = code & "    RETURN lipgloss.Place(m.Width, m.Height, lipgloss.Center, lipgloss.Center, styledDlg)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Helper: get button count
    code = code & "FUNCTION MsgBoxBtnCount(buttons AS INTEGER) AS INTEGER" & Chr(10)
    code = code & "    IF buttons = vbOKOnly THEN" & Chr(10)
    code = code & "        RETURN 1" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        RETURN 3" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        RETURN 2" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Helper: render buttons
    code = code & "FUNCTION MsgBoxRenderButtons(buttons AS INTEGER, selected AS INTEGER) AS STRING" & Chr(10)
    code = code & "    IF buttons = vbOKOnly THEN" & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            RETURN " & q & "[ OK ]" & q & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            RETURN " & q & "< OK >" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbOKCancel THEN" & Chr(10)
    code = code & "        DIM okBtn AS STRING = " & q & "< OK >" & q & Chr(10)
    code = code & "        DIM cancelBtn AS STRING = " & q & "< Cancel >" & q & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            okBtn = " & q & "[ OK ]" & q & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            cancelBtn = " & q & "[ Cancel ]" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN okBtn & " & q & "  " & q & " & cancelBtn" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNo THEN" & Chr(10)
    code = code & "        DIM yesBtn AS STRING = " & q & "< Yes >" & q & Chr(10)
    code = code & "        DIM noBtn AS STRING = " & q & "< No >" & q & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            yesBtn = " & q & "[ Yes ]" & q & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            noBtn = " & q & "[ No ]" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN yesBtn & " & q & "  " & q & " & noBtn" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        DIM yBtn AS STRING = " & q & "< Yes >" & q & Chr(10)
    code = code & "        DIM nBtn AS STRING = " & q & "< No >" & q & Chr(10)
    code = code & "        DIM cBtn AS STRING = " & q & "< Cancel >" & q & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            yBtn = " & q & "[ Yes ]" & q & Chr(10)
    code = code & "        ELSEIF selected = 1 THEN" & Chr(10)
    code = code & "            nBtn = " & q & "[ No ]" & q & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            cBtn = " & q & "[ Cancel ]" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN yBtn & " & q & "  " & q & " & nBtn & " & q & "  " & q & " & cBtn" & Chr(10)
    code = code & "    ELSEIF buttons = vbRetryCancel THEN" & Chr(10)
    code = code & "        DIM retryBtn AS STRING = " & q & "< Retry >" & q & Chr(10)
    code = code & "        DIM cancBtn AS STRING = " & q & "< Cancel >" & q & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            retryBtn = " & q & "[ Retry ]" & q & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            cancBtn = " & q & "[ Cancel ]" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN retryBtn & " & q & "  " & q & " & cancBtn" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN " & q & q & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Helper: get result from button selection
    code = code & "FUNCTION MsgBoxGetResult(buttons AS INTEGER, selected AS INTEGER) AS INTEGER" & Chr(10)
    code = code & "    IF buttons = vbOKOnly THEN" & Chr(10)
    code = code & "        RETURN vbOK" & Chr(10)
    code = code & "    ELSEIF buttons = vbOKCancel THEN" & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            RETURN vbOK" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            RETURN vbCancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNo THEN" & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            RETURN vbYes" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            RETURN vbNo" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            RETURN vbYes" & Chr(10)
    code = code & "        ELSEIF selected = 1 THEN" & Chr(10)
    code = code & "            RETURN vbNo" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            RETURN vbCancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbRetryCancel THEN" & Chr(10)
    code = code & "        IF selected = 0 THEN" & Chr(10)
    code = code & "            RETURN vbRetry" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            RETURN vbCancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN vbCancel" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Helper: determine which button was clicked based on X position
    code = code & "' Returns button index (0, 1, 2) or -1 if no button was clicked" & Chr(10)
    code = code & "FUNCTION MsgBoxGetClickedButton(buttons AS INTEGER, mouseX AS INTEGER, startX AS INTEGER, innerWidth AS INTEGER) AS INTEGER" & Chr(10)
    code = code & "    ' Calculate button positions based on button type" & Chr(10)
    code = code & "    DIM btnLine AS STRING = MsgBoxRenderButtonsPlain(buttons)" & Chr(10)
    code = code & "    DIM btnLen AS INTEGER = Len(btnLine)" & Chr(10)
    code = code & "    DIM btnPadding AS INTEGER = innerWidth - btnLen" & Chr(10)
    code = code & "    DIM btnLeftPad AS INTEGER = btnPadding / 2" & Chr(10)
    code = code & "    DIM btnStartX AS INTEGER = startX + 1 + btnLeftPad" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Relative X position within button area" & Chr(10)
    code = code & "    DIM relX AS INTEGER = mouseX - btnStartX" & Chr(10)
    code = code & "    IF relX < 0 OR relX >= btnLen THEN" & Chr(10)
    code = code & "        RETURN -1" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Determine which button based on position" & Chr(10)
    code = code & "    IF buttons = vbOKOnly THEN" & Chr(10)
    code = code & "        IF relX >= 0 AND relX < 6 THEN" & Chr(10)
    code = code & "            RETURN 0" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbOKCancel THEN" & Chr(10)
    code = code & "        IF relX >= 0 AND relX < 6 THEN" & Chr(10)
    code = code & "            RETURN 0  ' OK" & Chr(10)
    code = code & "        ELSEIF relX >= 8 AND relX < 18 THEN" & Chr(10)
    code = code & "            RETURN 1  ' Cancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNo THEN" & Chr(10)
    code = code & "        IF relX >= 0 AND relX < 7 THEN" & Chr(10)
    code = code & "            RETURN 0  ' Yes" & Chr(10)
    code = code & "        ELSEIF relX >= 9 AND relX < 15 THEN" & Chr(10)
    code = code & "            RETURN 1  ' No" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        IF relX >= 0 AND relX < 7 THEN" & Chr(10)
    code = code & "            RETURN 0  ' Yes" & Chr(10)
    code = code & "        ELSEIF relX >= 9 AND relX < 15 THEN" & Chr(10)
    code = code & "            RETURN 1  ' No" & Chr(10)
    code = code & "        ELSEIF relX >= 17 AND relX < 27 THEN" & Chr(10)
    code = code & "            RETURN 2  ' Cancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ELSEIF buttons = vbRetryCancel THEN" & Chr(10)
    code = code & "        IF relX >= 0 AND relX < 9 THEN" & Chr(10)
    code = code & "            RETURN 0  ' Retry" & Chr(10)
    code = code & "        ELSEIF relX >= 11 AND relX < 21 THEN" & Chr(10)
    code = code & "            RETURN 1  ' Cancel" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN -1" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Helper: render buttons without styling (for position calculation)
    code = code & "' Returns plain button text without styling for position calculation" & Chr(10)
    code = code & "FUNCTION MsgBoxRenderButtonsPlain(buttons AS INTEGER) AS STRING" & Chr(10)
    code = code & "    IF buttons = vbOKOnly THEN" & Chr(10)
    code = code & "        RETURN " & q & "[ OK ]" & q & Chr(10)
    code = code & "    ELSEIF buttons = vbOKCancel THEN" & Chr(10)
    code = code & "        RETURN " & q & "[ OK ]  [ Cancel ]" & q & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNo THEN" & Chr(10)
    code = code & "        RETURN " & q & "[ Yes ]  [ No ]" & q & Chr(10)
    code = code & "    ELSEIF buttons = vbYesNoCancel THEN" & Chr(10)
    code = code & "        RETURN " & q & "[ Yes ]  [ No ]  [ Cancel ]" & q & Chr(10)
    code = code & "    ELSEIF buttons = vbRetryCancel THEN" & Chr(10)
    code = code & "        RETURN " & q & "[ Retry ]  [ Cancel ]" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN " & q & q & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Main MsgBox function - BLOCKING with overlay, returns result directly
    code = code & "' Show a message box overlaid on background and wait for user response (blocking)" & Chr(10)
    code = code & "' Usage: IF MsgBox(" & q & "Are you sure?" & q & ", vbYesNo, " & q & "Confirm" & q & ", m.View()) = vbYes THEN ..." & Chr(10)
    code = code & "FUNCTION MsgBox(message AS STRING, buttons AS INTEGER, title AS STRING, background AS STRING) AS INTEGER" & Chr(10)
    code = code & "    ' Get actual terminal size" & Chr(10)
    code = code & "    DIM termWidth AS INTEGER = 80" & Chr(10)
    code = code & "    DIM termHeight AS INTEGER = 24" & Chr(10)
    code = code & "    DIM fd AS INTEGER = Int(os.Stdout.Fd())" & Chr(10)
    code = code & "    IF term.IsTerminal(fd) THEN" & Chr(10)
    code = code & "        termWidth, termHeight, _ = term.GetSize(fd)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM dlgModel AS MsgBoxDialogModel" & Chr(10)
    code = code & "    dlgModel.Message = message" & Chr(10)
    code = code & "    dlgModel.Buttons = buttons" & Chr(10)
    code = code & "    dlgModel.Title = title" & Chr(10)
    code = code & "    dlgModel.Background = background" & Chr(10)
    code = code & "    dlgModel.SelectedBtn = 0" & Chr(10)
    code = code & "    dlgModel.Result = 0" & Chr(10)
    code = code & "    dlgModel.Width = termWidth" & Chr(10)
    code = code & "    dlgModel.Height = termHeight" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Run a temporary BubbleTea program for the dialog" & Chr(10)
    code = code & "    ' Use WithoutSignalHandler to avoid conflicts with parent program" & Chr(10)
    code = code & "    DIM p AS POINTER TO tea.Program = tea.NewProgram(dlgModel, tea.WithMouseCellMotion(), tea.WithoutSignalHandler())" & Chr(10)
    code = code & "    DIM finalModel AS tea.Model" & Chr(10)
    code = code & "    DIM err AS error" & Chr(10)
    code = code & "    finalModel, err = (^p).Run()" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Restore terminal state properly" & Chr(10)
    code = code & "    ' 1. Reset all terminal modes" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1000l" & q & ")  ' Disable mouse tracking" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1002l" & q & ")  ' Disable button event tracking" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1003l" & q & ")  ' Disable any movement tracking" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1006l" & q & ")  ' Disable SGR mouse mode" & Chr(10)
    code = code & "    " & Chr(10)
    code = code & "    ' 2. Re-enable mouse tracking (parent expects this)" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1002h" & q & ")  ' Enable button event tracking" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[?1006h" & q & ")  ' Enable SGR mouse mode" & Chr(10)
    code = code & "    " & Chr(10)
    code = code & "    ' 3. Clear screen and redraw background" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[2J" & q & ")      ' Clear entire screen" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[H" & q & ")       ' Move cursor to home" & Chr(10)
    code = code & "    fmt.Print(background)            ' Redraw the background" & Chr(10)
    code = code & "    fmt.Print(" & q & "\\033[H" & q & ")       ' Move cursor back to home" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Set flag to trigger repaint in parent program" & Chr(10)
    code = code & "    _msgBoxNeedsRepaint = TRUE" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF err <> NIL THEN" & Chr(10)
    code = code & "        RETURN vbCancel" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM resultModel AS MsgBoxDialogModel = finalModel.(MsgBoxDialogModel)" & Chr(10)
    code = code & "    RETURN resultModel.Result" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate standalone DirBrowser widget TYPE and methods
' This follows the bubbles pattern for reusable components
FUNCTION GenerateDirBrowserWidget() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)  ' Quote character

    code = code & "' ============================================" & Chr(10)
    code = code & "' DirBrowser Widget" & Chr(10)
    code = code & "' A reusable directory browser component" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate TYPE
    code = code & "TYPE DirBrowser" & Chr(10)
    code = code & "    DIM path AS STRING" & Chr(10)
    code = code & "    DIM dirs AS []STRING" & Chr(10)
    code = code & "    DIM selected AS INTEGER" & Chr(10)
    code = code & "    DIM scroll AS INTEGER" & Chr(10)
    code = code & "    DIM focused AS BOOLEAN" & Chr(10)
    code = code & "    DIM pathInput AS textinput.Model" & Chr(10)
    code = code & "    DIM width AS INTEGER" & Chr(10)
    code = code & "    DIM height AS INTEGER" & Chr(10)
    code = code & "    DIM fgColor AS INTEGER" & Chr(10)
    code = code & "    DIM bgColor AS INTEGER" & Chr(10)
    code = code & "    DIM showHidden AS BOOLEAN" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Generate NewDirBrowser constructor
    code = code & "' Create a new DirBrowser with specified dimensions" & Chr(10)
    code = code & "FUNCTION NewDirBrowser(width AS INTEGER, height AS INTEGER) AS DirBrowser" & Chr(10)
    code = code & "    DIM db AS DirBrowser" & Chr(10)
    code = code & "    db.width = width" & Chr(10)
    code = code & "    db.height = height" & Chr(10)
    code = code & "    db.fgColor = 15" & Chr(10)
    code = code & "    db.bgColor = 1" & Chr(10)
    code = code & "    db.selected = 0" & Chr(10)
    code = code & "    db.scroll = 0" & Chr(10)
    code = code & "    db.focused = FALSE" & Chr(10)
    code = code & "    db.showHidden = FALSE" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize path to current working directory" & Chr(10)
    code = code & "    DIM dbErr AS error" & Chr(10)
    code = code & "    db.path, dbErr = os.Getwd()" & Chr(10)
    code = code & "    IF dbErr <> NIL THEN" & Chr(10)
    code = code & "        db.path = " & q & "/" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize path input textbox" & Chr(10)
    code = code & "    db.pathInput = textinput.New()" & Chr(10)
    code = code & "    db.pathInput.SetValue(db.path)" & Chr(10)
    code = code & "    db.pathInput.CursorEnd()" & Chr(10)
    code = code & "    db.pathInput.Width = width - 5" & Chr(10)
    code = code & "    db.pathInput.CharLimit = 256" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate helper function to list directories
    code = code & "' List directories in a path" & Chr(10)
    code = code & "FUNCTION DirBrowserListDirs(path AS STRING, showHidden AS BOOLEAN) AS []STRING" & Chr(10)
    code = code & "    DIM result AS []STRING" & Chr(10)
    code = code & "    ' Add parent directory unless at root" & Chr(10)
    code = code & "    IF path <> " & q & "/" & q & " AND path <> " & q & q & " THEN" & Chr(10)
    code = code & "        result = APPEND(result, " & q & ".." & q & ")" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM entries AS []os.DirEntry" & Chr(10)
    code = code & "    DIM err AS error" & Chr(10)
    code = code & "    entries, err = os.ReadDir(path)" & Chr(10)
    code = code & "    IF err <> NIL THEN" & Chr(10)
    code = code & "        RETURN result" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(entries) - 1" & Chr(10)
    code = code & "        IF entries[i].IsDir() THEN" & Chr(10)
    code = code & "            DIM name AS STRING = entries[i].Name()" & Chr(10)
    code = code & "            IF showHidden OR Left(name, 1) <> " & q & "." & q & " THEN" & Chr(10)
    code = code & "                result = APPEND(result, name & " & q & "/" & q & ")" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    RETURN result" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Update method
    code = code & "' Handle input messages for DirBrowser" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) Update(msg AS tea.Msg) AS (DirBrowser, tea.Cmd)" & Chr(10)
    code = code & "    DIM cmd AS tea.Cmd" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle mouse messages" & Chr(10)
    code = code & "    DIM mouseMsg AS tea.MouseMsg" & Chr(10)
    code = code & "    DIM mouseOk AS BOOLEAN" & Chr(10)
    code = code & "    mouseMsg, mouseOk = msg.(tea.MouseMsg)" & Chr(10)
    code = code & "    IF mouseOk AND mouseMsg.Action = tea.MouseActionPress AND mouseMsg.Button = tea.MouseButtonLeft THEN" & Chr(10)
    code = code & "        DIM my AS INTEGER = Int(mouseMsg.Y)" & Chr(10)
    code = code & "        IF my = 1 THEN" & Chr(10)
    code = code & "            ' Clicked on path input" & Chr(10)
    code = code & "            db.pathInput.Focus()" & Chr(10)
    code = code & "            RETURN db, textinput.Blink" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            db.pathInput.Blur()" & Chr(10)
    code = code & "            IF my >= 3 AND my < db.height - 1 THEN" & Chr(10)
    code = code & "                ' Clicked on directory list" & Chr(10)
    code = code & "                DIM targetIdx AS INTEGER = my - 3 + db.scroll" & Chr(10)
    code = code & "                IF targetIdx >= 0 AND targetIdx < Len(db.dirs) THEN" & Chr(10)
    code = code & "                    db.selected = targetIdx" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN db, NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Route to path input if focused" & Chr(10)
    code = code & "    IF db.pathInput.Focused() THEN" & Chr(10)
    code = code & "        ' Check for Enter to apply path" & Chr(10)
    code = code & "        DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "        DIM keyOk AS BOOLEAN" & Chr(10)
    code = code & "        keyMsg, keyOk = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "        IF keyOk AND keyMsg.String() = " & q & "enter" & q & " THEN" & Chr(10)
    code = code & "            ' Apply path from input" & Chr(10)
    code = code & "            db.path = db.pathInput.Value()" & Chr(10)
    code = code & "            db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & "            db.selected = 0" & Chr(10)
    code = code & "            db.scroll = 0" & Chr(10)
    code = code & "            db.pathInput.Blur()" & Chr(10)
    code = code & "            RETURN db, NIL" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        db.pathInput, cmd = db.pathInput.Update(msg)" & Chr(10)
    code = code & "        ' Reset cursor to visible on cursor movement for immediate visibility" & Chr(10)
    code = code & "        IF keyOk THEN" & Chr(10)
    code = code & "            DIM pKey AS STRING = keyMsg.String()" & Chr(10)
    code = code & "            IF pKey = " & q & "left" & q & " OR pKey = " & q & "right" & q & " OR pKey = " & q & "home" & q & " OR pKey = " & q & "end" & q & " OR pKey = " & q & "ctrl+left" & q & " OR pKey = " & q & "ctrl+right" & q & " THEN" & Chr(10)
    code = code & "                db.pathInput.Cursor.Blink = TRUE" & Chr(10)
    code = code & "                RETURN db, cmd" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN db, cmd" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle keyboard for directory list" & Chr(10)
    code = code & "    DIM keyMsg2 AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM keyOk2 AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg2, keyOk2 = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "    IF keyOk2 AND db.focused THEN" & Chr(10)
    code = code & "        DIM key AS STRING = keyMsg2.String()" & Chr(10)
    code = code & "        DIM listH AS INTEGER = db.height - 4  ' Visible list rows" & Chr(10)
    code = code & Chr(10)
    code = code & "        IF key = " & q & "up" & q & " THEN" & Chr(10)
    code = code & "            IF db.selected > 0 THEN" & Chr(10)
    code = code & "                db.selected = db.selected - 1" & Chr(10)
    code = code & "                IF db.selected < db.scroll THEN" & Chr(10)
    code = code & "                    db.scroll = db.selected" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF key = " & q & "down" & q & " THEN" & Chr(10)
    code = code & "            IF db.selected < Len(db.dirs) - 1 THEN" & Chr(10)
    code = code & "                db.selected = db.selected + 1" & Chr(10)
    code = code & "                IF db.selected >= db.scroll + listH THEN" & Chr(10)
    code = code & "                    db.scroll = db.selected - listH + 1" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF key = " & q & "enter" & q & " THEN" & Chr(10)
    code = code & "            ' Navigate into selected directory" & Chr(10)
    code = code & "            IF db.selected >= 0 AND db.selected < Len(db.dirs) THEN" & Chr(10)
    code = code & "                DIM dirName AS STRING = db.dirs[db.selected]" & Chr(10)
    code = code & "                IF dirName = " & q & ".." & q & " THEN" & Chr(10)
    code = code & "                    db.path = filepath.Dir(db.path)" & Chr(10)
    code = code & "                ELSE" & Chr(10)
    code = code & "                    db.path = filepath.Join(db.path, Left(dirName, Len(dirName) - 1))" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & "                db.selected = 0" & Chr(10)
    code = code & "                db.scroll = 0" & Chr(10)
    code = code & "                db.pathInput.SetValue(db.path)" & Chr(10)
    code = code & "                db.pathInput.CursorEnd()" & Chr(10)
    code = code & "                db.pathInput.Blur()" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN db, NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Focus method
    code = code & "' Focus the DirBrowser" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) Focus() AS DirBrowser" & Chr(10)
    code = code & "    db.focused = TRUE" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Blur method
    code = code & "' Blur (unfocus) the DirBrowser" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) Blur() AS DirBrowser" & Chr(10)
    code = code & "    db.focused = FALSE" & Chr(10)
    code = code & "    db.pathInput.Blur()" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Focused method
    code = code & "' Check if DirBrowser is focused" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) Focused() AS BOOLEAN" & Chr(10)
    code = code & "    RETURN db.focused" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetPath method
    code = code & "' Set the current path" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) SetPath(path AS STRING) AS DirBrowser" & Chr(10)
    code = code & "    db.path = path" & Chr(10)
    code = code & "    db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & "    db.selected = 0" & Chr(10)
    code = code & "    db.scroll = 0" & Chr(10)
    code = code & "    db.pathInput.SetValue(db.path)" & Chr(10)
    code = code & "    db.pathInput.CursorEnd()" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate GetPath method
    code = code & "' Get the current path" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) GetPath() AS STRING" & Chr(10)
    code = code & "    RETURN db.path" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SelectedDir method
    code = code & "' Get the currently selected directory name" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) SelectedDir() AS STRING" & Chr(10)
    code = code & "    IF db.selected >= 0 AND db.selected < Len(db.dirs) THEN" & Chr(10)
    code = code & "        RETURN db.dirs[db.selected]" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN " & q & q & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetColors method
    code = code & "' Set foreground and background colors" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) SetColors(fg AS INTEGER, bg AS INTEGER) AS DirBrowser" & Chr(10)
    code = code & "    db.fgColor = fg" & Chr(10)
    code = code & "    db.bgColor = bg" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetShowHidden method
    code = code & "' Set whether to show hidden directories" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) SetShowHidden(show AS BOOLEAN) AS DirBrowser" & Chr(10)
    code = code & "    db.showHidden = show" & Chr(10)
    code = code & "    db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate View method - refresh the directory listing
    code = code & "' Refresh the directory listing" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) View() AS DirBrowser" & Chr(10)
    code = code & "    db.dirs = DirBrowserListDirs(db.path, db.showHidden)" & Chr(10)
    code = code & "    db.pathInput.SetValue(db.path)" & Chr(10)
    code = code & "    RETURN db" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate GetRow method for row-based rendering
    code = code & "' Get a specific row of the DirBrowser for rendering" & Chr(10)
    code = code & "FUNCTION (db AS DirBrowser) GetRow(rowIndex AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(db.fgColor))).Background(lipgloss.Color(Str(db.bgColor)))" & Chr(10)
    code = code & "    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(db.bgColor))).Background(lipgloss.Color(Str(db.fgColor)))" & Chr(10)
    code = code & "    DIM innerW AS INTEGER = db.width - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF rowIndex = 0 THEN" & Chr(10)
    code = code & "        ' Top border" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "┌" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┐" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = db.height - 1 THEN" & Chr(10)
    code = code & "        ' Bottom border" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "└" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┘" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = 1 THEN" & Chr(10)
    code = code & "        ' Path input line - constrain width to fit within borders" & Chr(10)
    code = code & "        DIM pathContent AS STRING = db.pathInput.View()" & Chr(10)
    code = code & "        DIM pathLen AS INTEGER = lipgloss.Width(pathContent)" & Chr(10)
    code = code & "        IF pathLen < innerW THEN" & Chr(10)
    code = code & "            pathContent = pathContent & strings.Repeat(" & q & " " & q & ", innerW - pathLen)" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "│" & q & ") & pathContent & style.Render(" & q & "│" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = 2 THEN" & Chr(10)
    code = code & "        ' Separator" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "├" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┤" & q & ")" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        ' Directory list area" & Chr(10)
    code = code & "        DIM dirIdx AS INTEGER = rowIndex - 3 + db.scroll" & Chr(10)
    code = code & "        DIM content AS STRING = " & q & "│ " & q & Chr(10)
    code = code & "        IF dirIdx >= 0 AND dirIdx < Len(db.dirs) THEN" & Chr(10)
    code = code & "            DIM dirName AS STRING = db.dirs[dirIdx]" & Chr(10)
    code = code & "            DIM isSelected AS BOOLEAN = (dirIdx = db.selected)" & Chr(10)
    code = code & "            DIM dirEntry AS STRING = " & q & q & Chr(10)
    code = code & "            IF dirName = " & q & ".." & q & " THEN" & Chr(10)
    code = code & "                dirEntry = " & q & "[..] Parent Directory" & q & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                dirEntry = " & q & "[D] " & q & " & dirName" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            IF Len(dirEntry) > innerW - 1 THEN" & Chr(10)
    code = code & "                dirEntry = Left(dirEntry, innerW - 1)" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                dirEntry = dirEntry & strings.Repeat(" & q & " " & q & ", innerW - 1 - Len(dirEntry))" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            IF isSelected AND db.focused THEN" & Chr(10)
    code = code & "                content = style.Render(" & q & "│ " & q & ") & selStyle.Render(dirEntry) & style.Render(" & q & "│" & q & ")" & Chr(10)
    code = code & "                RETURN content" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                content = content & dirEntry & " & q & "│" & q & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            content = content & strings.Repeat(" & q & " " & q & ", innerW - 1) & " & q & "│" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN style.Render(content)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate standalone Path widget TYPE and methods
' This is a path textbox that can be linked to a Directories widget
FUNCTION GeneratePathWidget() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)  ' Quote character

    code = code & "' ============================================" & Chr(10)
    code = code & "' Path Widget" & Chr(10)
    code = code & "' A reusable path textbox component" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate TYPE
    code = code & "TYPE PathWidget" & Chr(10)
    code = code & "    DIM path AS STRING" & Chr(10)
    code = code & "    DIM textInput AS textinput.Model" & Chr(10)
    code = code & "    DIM width AS INTEGER" & Chr(10)
    code = code & "    DIM height AS INTEGER" & Chr(10)
    code = code & "    DIM fgColor AS INTEGER" & Chr(10)
    code = code & "    DIM bgColor AS INTEGER" & Chr(10)
    code = code & "    DIM focused AS BOOLEAN" & Chr(10)
    code = code & "    DIM LinkedPath AS STRING" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Generate NewPathWidget constructor
    code = code & "' Create a new PathWidget with specified dimensions" & Chr(10)
    code = code & "FUNCTION NewPathWidget(width AS INTEGER, height AS INTEGER) AS PathWidget" & Chr(10)
    code = code & "    DIM pw AS PathWidget" & Chr(10)
    code = code & "    pw.width = width" & Chr(10)
    code = code & "    pw.height = height" & Chr(10)
    code = code & "    pw.fgColor = 15" & Chr(10)
    code = code & "    pw.bgColor = 1" & Chr(10)
    code = code & "    pw.focused = FALSE" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize path to current working directory" & Chr(10)
    code = code & "    DIM pwErr AS error" & Chr(10)
    code = code & "    pw.path, pwErr = os.Getwd()" & Chr(10)
    code = code & "    IF pwErr <> NIL THEN" & Chr(10)
    code = code & "        pw.path = " & q & "/" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize textinput" & Chr(10)
    code = code & "    pw.textInput = textinput.New()" & Chr(10)
    code = code & "    pw.textInput.SetValue(pw.path)" & Chr(10)
    code = code & "    pw.textInput.CursorEnd()" & Chr(10)
    code = code & "    pw.textInput.Prompt = " & q & "> " & q & Chr(10)
    code = code & "    pw.textInput.Width = width - 5" & Chr(10)
    code = code & "    pw.textInput.CharLimit = 256" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN pw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Update method
    code = code & "' Handle input messages for PathWidget" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) Update(msg AS tea.Msg) AS (PathWidget, tea.Cmd)" & Chr(10)
    code = code & "    DIM cmd AS tea.Cmd" & Chr(10)
    code = code & "    IF NOT pw.focused THEN" & Chr(10)
    code = code & "        RETURN pw, NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Check for Enter key" & Chr(10)
    code = code & "    DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM keyOk AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg, keyOk = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "    IF keyOk AND keyMsg.String() = " & q & "enter" & q & " THEN" & Chr(10)
    code = code & "        pw.path = pw.textInput.Value()" & Chr(10)
    code = code & "        RETURN pw, NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    pw.textInput, cmd = pw.textInput.Update(msg)" & Chr(10)
    code = code & "    RETURN pw, cmd" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Focus/Blur/Focused methods
    code = code & "' Focus the PathWidget" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) Focus() AS (PathWidget, tea.Cmd)" & Chr(10)
    code = code & "    pw.focused = TRUE" & Chr(10)
    code = code & "    DIM cmd AS tea.Cmd = pw.textInput.Focus()" & Chr(10)
    code = code & "    RETURN pw, cmd" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Blur (unfocus) the PathWidget" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) Blur() AS PathWidget" & Chr(10)
    code = code & "    pw.focused = FALSE" & Chr(10)
    code = code & "    pw.textInput.Blur()" & Chr(10)
    code = code & "    RETURN pw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Check if PathWidget is focused" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) Focused() AS BOOLEAN" & Chr(10)
    code = code & "    RETURN pw.focused" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetPath/GetPath methods
    code = code & "' Set the path value" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) SetPath(path AS STRING) AS PathWidget" & Chr(10)
    code = code & "    pw.path = path" & Chr(10)
    code = code & "    pw.textInput.SetValue(path)" & Chr(10)
    code = code & "    pw.textInput.CursorEnd()" & Chr(10)
    code = code & "    RETURN pw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the current path" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) GetPath() AS STRING" & Chr(10)
    code = code & "    RETURN pw.path" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the current input value (may differ from path before Enter)" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) Value() AS STRING" & Chr(10)
    code = code & "    RETURN pw.textInput.Value()" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetColors method
    code = code & "' Set foreground and background colors" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) SetColors(fg AS INTEGER, bg AS INTEGER) AS PathWidget" & Chr(10)
    code = code & "    pw.fgColor = fg" & Chr(10)
    code = code & "    pw.bgColor = bg" & Chr(10)
    code = code & "    RETURN pw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate GetRow method
    code = code & "' Get a specific row of the PathWidget for rendering" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) GetRow(rowIndex AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(pw.fgColor))).Background(lipgloss.Color(Str(pw.bgColor)))" & Chr(10)
    code = code & "    DIM innerW AS INTEGER = pw.width - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF rowIndex = 0 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "┌" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┐" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = pw.height - 1 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "└" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┘" & q & ")" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        DIM pathContent AS STRING = pw.textInput.View()" & Chr(10)
    code = code & "        DIM pathLen AS INTEGER = lipgloss.Width(pathContent)" & Chr(10)
    code = code & "        IF pathLen < innerW THEN" & Chr(10)
    code = code & "            pathContent = pathContent & style.Render(strings.Repeat(" & q & " " & q & ", innerW - pathLen))" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "│" & q & ") & pathContent & style.Render(" & q & "│" & q & ")" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate View method (syncs textInput with path)
    code = code & "' Refresh the path widget display" & Chr(10)
    code = code & "FUNCTION (pw AS PathWidget) View() AS PathWidget" & Chr(10)
    code = code & "    pw.textInput.SetValue(pw.path)" & Chr(10)
    code = code & "    RETURN pw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate standalone Directories widget TYPE and methods
' This is a directory listing that can be linked to a Path widget
FUNCTION GenerateDirectoriesWidget() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)  ' Quote character

    code = code & "' ============================================" & Chr(10)
    code = code & "' Directories Widget" & Chr(10)
    code = code & "' A reusable directory listing component" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate TYPE
    code = code & "TYPE DirectoriesWidget" & Chr(10)
    code = code & "    DIM path AS STRING" & Chr(10)
    code = code & "    DIM dirs AS []STRING" & Chr(10)
    code = code & "    DIM selected AS INTEGER" & Chr(10)
    code = code & "    DIM scroll AS INTEGER" & Chr(10)
    code = code & "    DIM focused AS BOOLEAN" & Chr(10)
    code = code & "    DIM width AS INTEGER" & Chr(10)
    code = code & "    DIM height AS INTEGER" & Chr(10)
    code = code & "    DIM fgColor AS INTEGER" & Chr(10)
    code = code & "    DIM bgColor AS INTEGER" & Chr(10)
    code = code & "    DIM showHidden AS BOOLEAN" & Chr(10)
    code = code & "    DIM LinkedPath AS STRING" & Chr(10)
    code = code & "    DIM SelectedDir AS STRING" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Generate NewDirectoriesWidget constructor
    code = code & "' Create a new DirectoriesWidget with specified dimensions" & Chr(10)
    code = code & "FUNCTION NewDirectoriesWidget(width AS INTEGER, height AS INTEGER) AS DirectoriesWidget" & Chr(10)
    code = code & "    DIM dw AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.width = width" & Chr(10)
    code = code & "    dw.height = height" & Chr(10)
    code = code & "    dw.fgColor = 15" & Chr(10)
    code = code & "    dw.bgColor = 1" & Chr(10)
    code = code & "    dw.selected = 0" & Chr(10)
    code = code & "    dw.scroll = 0" & Chr(10)
    code = code & "    dw.focused = FALSE" & Chr(10)
    code = code & "    dw.showHidden = FALSE" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize path to current working directory" & Chr(10)
    code = code & "    DIM dwErr AS error" & Chr(10)
    code = code & "    dw.path, dwErr = os.Getwd()" & Chr(10)
    code = code & "    IF dwErr <> NIL THEN" & Chr(10)
    code = code & "        dw.path = " & q & "/" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    dw.dirs = DirectoriesListDirs(dw.path, dw.showHidden)" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate helper function to list directories
    code = code & "' List directories in a path" & Chr(10)
    code = code & "FUNCTION DirectoriesListDirs(path AS STRING, showHidden AS BOOLEAN) AS []STRING" & Chr(10)
    code = code & "    DIM result AS []STRING" & Chr(10)
    code = code & "    ' Add parent directory unless at root" & Chr(10)
    code = code & "    IF path <> " & q & "/" & q & " AND path <> " & q & q & " THEN" & Chr(10)
    code = code & "        result = APPEND(result, " & q & ".." & q & ")" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM entries AS []os.DirEntry" & Chr(10)
    code = code & "    DIM err AS error" & Chr(10)
    code = code & "    entries, err = os.ReadDir(path)" & Chr(10)
    code = code & "    IF err <> NIL THEN" & Chr(10)
    code = code & "        RETURN result" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(entries) - 1" & Chr(10)
    code = code & "        IF entries[i].IsDir() THEN" & Chr(10)
    code = code & "            DIM name AS STRING = entries[i].Name()" & Chr(10)
    code = code & "            IF showHidden OR Left(name, 1) <> " & q & "." & q & " THEN" & Chr(10)
    code = code & "                result = APPEND(result, name & " & q & "/" & q & ")" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    RETURN result" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Update method
    code = code & "' Handle input messages for DirectoriesWidget" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) Update(msg AS tea.Msg) AS (DirectoriesWidget, tea.Cmd, BOOLEAN)" & Chr(10)
    code = code & "    DIM changed AS BOOLEAN = FALSE" & Chr(10)
    code = code & "    IF NOT dw.focused THEN" & Chr(10)
    code = code & "        RETURN dw, NIL, FALSE" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle mouse messages" & Chr(10)
    code = code & "    DIM mouseMsg AS tea.MouseMsg" & Chr(10)
    code = code & "    DIM mouseOk AS BOOLEAN" & Chr(10)
    code = code & "    mouseMsg, mouseOk = msg.(tea.MouseMsg)" & Chr(10)
    code = code & "    IF mouseOk AND mouseMsg.Action = tea.MouseActionPress AND mouseMsg.Button = tea.MouseButtonLeft THEN" & Chr(10)
    code = code & "        DIM my AS INTEGER = Int(mouseMsg.Y)" & Chr(10)
    code = code & "        IF my >= 1 AND my < dw.height - 1 THEN" & Chr(10)
    code = code & "            DIM targetIdx AS INTEGER = my - 1 + dw.scroll" & Chr(10)
    code = code & "            IF targetIdx >= 0 AND targetIdx < Len(dw.dirs) THEN" & Chr(10)
    code = code & "                dw.selected = targetIdx" & Chr(10)
    code = code & "                dw = dw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN dw, NIL, changed" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle keyboard" & Chr(10)
    code = code & "    DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM keyOk AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg, keyOk = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "    IF keyOk THEN" & Chr(10)
    code = code & "        DIM key AS STRING = keyMsg.String()" & Chr(10)
    code = code & "        DIM listH AS INTEGER = dw.height - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "        IF key = " & q & "up" & q & " THEN" & Chr(10)
    code = code & "            IF dw.selected > 0 THEN" & Chr(10)
    code = code & "                dw.selected = dw.selected - 1" & Chr(10)
    code = code & "                IF dw.selected < dw.scroll THEN" & Chr(10)
    code = code & "                    dw.scroll = dw.selected" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                dw = dw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF key = " & q & "down" & q & " THEN" & Chr(10)
    code = code & "            IF dw.selected < Len(dw.dirs) - 1 THEN" & Chr(10)
    code = code & "                dw.selected = dw.selected + 1" & Chr(10)
    code = code & "                IF dw.selected >= dw.scroll + listH THEN" & Chr(10)
    code = code & "                    dw.scroll = dw.selected - listH + 1" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                dw = dw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF key = " & q & "enter" & q & " THEN" & Chr(10)
    code = code & "            ' Navigate into selected directory" & Chr(10)
    code = code & "            IF dw.selected >= 0 AND dw.selected < Len(dw.dirs) THEN" & Chr(10)
    code = code & "                DIM dirName AS STRING = dw.dirs[dw.selected]" & Chr(10)
    code = code & "                IF dirName = " & q & ".." & q & " THEN" & Chr(10)
    code = code & "                    dw.path = filepath.Dir(dw.path)" & Chr(10)
    code = code & "                ELSE" & Chr(10)
    code = code & "                    dw.path = filepath.Join(dw.path, Left(dirName, Len(dirName) - 1))" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                dw.dirs = DirectoriesListDirs(dw.path, dw.showHidden)" & Chr(10)
    code = code & "                dw.selected = 0" & Chr(10)
    code = code & "                dw.scroll = 0" & Chr(10)
    code = code & "                dw = dw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN dw, NIL, changed" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Focus/Blur/Focused methods
    code = code & "' Focus the DirectoriesWidget" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) Focus() AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.focused = TRUE" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Blur (unfocus) the DirectoriesWidget" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) Blur() AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.focused = FALSE" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Check if DirectoriesWidget is focused" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) Focused() AS BOOLEAN" & Chr(10)
    code = code & "    RETURN dw.focused" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetPath/GetPath methods
    code = code & "' Set the current path and refresh directory listing" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) SetPath(path AS STRING) AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.path = path" & Chr(10)
    code = code & "    dw.dirs = DirectoriesListDirs(dw.path, dw.showHidden)" & Chr(10)
    code = code & "    dw.selected = 0" & Chr(10)
    code = code & "    dw.scroll = 0" & Chr(10)
    code = code & "    dw = dw._updateSelection()" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the current path" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) GetPath() AS STRING" & Chr(10)
    code = code & "    RETURN dw.path" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the currently selected directory name" & Chr(10)
    code = code & "' Update SelectedDir property based on current selection" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) _updateSelection() AS DirectoriesWidget" & Chr(10)
    code = code & "    IF dw.selected >= 0 AND dw.selected < Len(dw.dirs) THEN" & Chr(10)
    code = code & "        dw.SelectedDir = dw.dirs[dw.selected]" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        dw.SelectedDir = " & q & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetColors method
    code = code & "' Set foreground and background colors" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) SetColors(fg AS INTEGER, bg AS INTEGER) AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.fgColor = fg" & Chr(10)
    code = code & "    dw.bgColor = bg" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetShowHidden method
    code = code & "' Set whether to show hidden directories" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) SetShowHidden(show AS BOOLEAN) AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.showHidden = show" & Chr(10)
    code = code & "    dw.dirs = DirectoriesListDirs(dw.path, dw.showHidden)" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate GetRow method
    code = code & "' Get a specific row of the DirectoriesWidget for rendering" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) GetRow(rowIndex AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(dw.fgColor))).Background(lipgloss.Color(Str(dw.bgColor)))" & Chr(10)
    code = code & "    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(dw.bgColor))).Background(lipgloss.Color(Str(dw.fgColor)))" & Chr(10)
    code = code & "    DIM innerW AS INTEGER = dw.width - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF rowIndex = 0 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "┌" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┐" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = dw.height - 1 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "└" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┘" & q & ")" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        ' Directory list area" & Chr(10)
    code = code & "        DIM dirIdx AS INTEGER = rowIndex - 1 + dw.scroll" & Chr(10)
    code = code & "        DIM content AS STRING = " & q & "│ " & q & Chr(10)
    code = code & "        IF dirIdx >= 0 AND dirIdx < Len(dw.dirs) THEN" & Chr(10)
    code = code & "            DIM dirName AS STRING = dw.dirs[dirIdx]" & Chr(10)
    code = code & "            DIM isSelected AS BOOLEAN = (dirIdx = dw.selected)" & Chr(10)
    code = code & "            DIM dirEntry AS STRING = " & q & q & Chr(10)
    code = code & "            IF dirName = " & q & ".." & q & " THEN" & Chr(10)
    code = code & "                dirEntry = " & q & "[..] Parent Directory" & q & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                dirEntry = " & q & "[D] " & q & " & dirName" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            IF Len(dirEntry) > innerW - 1 THEN" & Chr(10)
    code = code & "                dirEntry = Left(dirEntry, innerW - 1)" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                dirEntry = dirEntry & strings.Repeat(" & q & " " & q & ", innerW - 1 - Len(dirEntry))" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            IF isSelected AND dw.focused THEN" & Chr(10)
    code = code & "                content = style.Render(" & q & "│ " & q & ") & selStyle.Render(dirEntry) & style.Render(" & q & "│" & q & ")" & Chr(10)
    code = code & "                RETURN content" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                content = content & dirEntry & " & q & "│" & q & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            content = content & strings.Repeat(" & q & " " & q & ", innerW - 1) & " & q & "│" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN style.Render(content)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate View method (refreshes directory listing)
    code = code & "' Refresh the directory listing" & Chr(10)
    code = code & "FUNCTION (dw AS DirectoriesWidget) View() AS DirectoriesWidget" & Chr(10)
    code = code & "    dw.dirs = DirectoriesListDirs(dw.path, dw.showHidden)" & Chr(10)
    code = code & "    RETURN dw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate Files widget code
FUNCTION GenerateFilesWidget() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)  ' Quote character

    code = code & "' ============================================" & Chr(10)
    code = code & "' Files Widget" & Chr(10)
    code = code & "' A reusable file listing component" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate TYPE
    code = code & "TYPE FilesWidget" & Chr(10)
    code = code & "    DIM path AS STRING" & Chr(10)
    code = code & "    DIM files AS []STRING" & Chr(10)
    code = code & "    DIM selected AS INTEGER" & Chr(10)
    code = code & "    DIM scroll AS INTEGER" & Chr(10)
    code = code & "    DIM focused AS BOOLEAN" & Chr(10)
    code = code & "    DIM width AS INTEGER" & Chr(10)
    code = code & "    DIM height AS INTEGER" & Chr(10)
    code = code & "    DIM fgColor AS INTEGER" & Chr(10)
    code = code & "    DIM bgColor AS INTEGER" & Chr(10)
    code = code & "    DIM showHidden AS BOOLEAN" & Chr(10)
    code = code & "    DIM pattern AS STRING" & Chr(10)
    code = code & "    DIM LinkedPath AS STRING" & Chr(10)
    code = code & "    DIM SelectedFile AS STRING" & Chr(10)
    code = code & "    DIM SelectedFilePath AS STRING" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' Generate NewFilesWidget constructor
    code = code & "' Create a new FilesWidget with specified dimensions" & Chr(10)
    code = code & "FUNCTION NewFilesWidget(width AS INTEGER, height AS INTEGER) AS FilesWidget" & Chr(10)
    code = code & "    DIM fw AS FilesWidget" & Chr(10)
    code = code & "    fw.width = width" & Chr(10)
    code = code & "    fw.height = height" & Chr(10)
    code = code & "    fw.fgColor = 15" & Chr(10)
    code = code & "    fw.bgColor = 1" & Chr(10)
    code = code & "    fw.selected = 0" & Chr(10)
    code = code & "    fw.scroll = 0" & Chr(10)
    code = code & "    fw.focused = FALSE" & Chr(10)
    code = code & "    fw.showHidden = FALSE" & Chr(10)
    code = code & "    fw.pattern = " & q & "*" & q & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize path to current working directory" & Chr(10)
    code = code & "    DIM fwErr AS error" & Chr(10)
    code = code & "    fw.path, fwErr = os.Getwd()" & Chr(10)
    code = code & "    IF fwErr <> NIL THEN" & Chr(10)
    code = code & "        fw.path = " & q & "/" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    fw.files = FilesListFiles(fw.path, fw.showHidden, fw.pattern)" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate helper function to list files
    code = code & "' List files in a path matching pattern" & Chr(10)
    code = code & "FUNCTION FilesListFiles(path AS STRING, showHidden AS BOOLEAN, pattern AS STRING) AS []STRING" & Chr(10)
    code = code & "    DIM result AS []STRING" & Chr(10)
    code = code & "    DIM entries AS []os.DirEntry" & Chr(10)
    code = code & "    DIM err AS error" & Chr(10)
    code = code & "    entries, err = os.ReadDir(path)" & Chr(10)
    code = code & "    IF err <> NIL THEN" & Chr(10)
    code = code & "        RETURN result" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(entries) - 1" & Chr(10)
    code = code & "        IF entries[i].IsDir() = FALSE THEN" & Chr(10)
    code = code & "            DIM name AS STRING = entries[i].Name()" & Chr(10)
    code = code & "            IF showHidden OR Left(name, 1) <> " & q & "." & q & " THEN" & Chr(10)
    code = code & "                ' Check pattern match" & Chr(10)
    code = code & "                DIM matched AS BOOLEAN" & Chr(10)
    code = code & "                DIM matchErr AS error" & Chr(10)
    code = code & "                matched, matchErr = filepath.Match(pattern, name)" & Chr(10)
    code = code & "                IF matchErr = NIL AND matched THEN" & Chr(10)
    code = code & "                    result = APPEND(result, name)" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    RETURN result" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Update method
    code = code & "' Handle input messages for FilesWidget" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) Update(msg AS tea.Msg) AS (FilesWidget, tea.Cmd, BOOLEAN)" & Chr(10)
    code = code & "    DIM changed AS BOOLEAN = FALSE" & Chr(10)
    code = code & "    IF NOT fw.focused THEN" & Chr(10)
    code = code & "        RETURN fw, NIL, FALSE" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle mouse messages" & Chr(10)
    code = code & "    DIM mouseMsg AS tea.MouseMsg" & Chr(10)
    code = code & "    DIM mouseOk AS BOOLEAN" & Chr(10)
    code = code & "    mouseMsg, mouseOk = msg.(tea.MouseMsg)" & Chr(10)
    code = code & "    IF mouseOk AND mouseMsg.Action = tea.MouseActionPress AND mouseMsg.Button = tea.MouseButtonLeft THEN" & Chr(10)
    code = code & "        DIM my AS INTEGER = Int(mouseMsg.Y)" & Chr(10)
    code = code & "        IF my >= 1 AND my < fw.height - 1 THEN" & Chr(10)
    code = code & "            DIM targetIdx AS INTEGER = my - 1 + fw.scroll" & Chr(10)
    code = code & "            IF targetIdx >= 0 AND targetIdx < Len(fw.files) THEN" & Chr(10)
    code = code & "                fw.selected = targetIdx" & Chr(10)
    code = code & "                fw = fw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN fw, NIL, changed" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Handle keyboard" & Chr(10)
    code = code & "    DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM keyOk AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg, keyOk = msg.(tea.KeyMsg)" & Chr(10)
    code = code & "    IF keyOk THEN" & Chr(10)
    code = code & "        DIM key AS STRING = keyMsg.String()" & Chr(10)
    code = code & "        DIM listH AS INTEGER = fw.height - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "        IF key = " & q & "up" & q & " THEN" & Chr(10)
    code = code & "            IF fw.selected > 0 THEN" & Chr(10)
    code = code & "                fw.selected = fw.selected - 1" & Chr(10)
    code = code & "                IF fw.selected < fw.scroll THEN" & Chr(10)
    code = code & "                    fw.scroll = fw.selected" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                fw = fw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSEIF key = " & q & "down" & q & " THEN" & Chr(10)
    code = code & "            IF fw.selected < Len(fw.files) - 1 THEN" & Chr(10)
    code = code & "                fw.selected = fw.selected + 1" & Chr(10)
    code = code & "                IF fw.selected >= fw.scroll + listH THEN" & Chr(10)
    code = code & "                    fw.scroll = fw.selected - listH + 1" & Chr(10)
    code = code & "                ENDIF" & Chr(10)
    code = code & "                fw = fw._updateSelection()" & Chr(10)
    code = code & "                changed = TRUE" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN fw, NIL, changed" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate Focus/Blur/Focused methods
    code = code & "' Focus the FilesWidget" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) Focus() AS FilesWidget" & Chr(10)
    code = code & "    fw.focused = TRUE" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Blur (unfocus) the FilesWidget" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) Blur() AS FilesWidget" & Chr(10)
    code = code & "    fw.focused = FALSE" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Check if FilesWidget is focused" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) Focused() AS BOOLEAN" & Chr(10)
    code = code & "    RETURN fw.focused" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetPath/GetPath methods
    code = code & "' Set the current path and refresh file listing" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) SetPath(path AS STRING) AS FilesWidget" & Chr(10)
    code = code & "    fw.path = path" & Chr(10)
    code = code & "    fw.files = FilesListFiles(fw.path, fw.showHidden, fw.pattern)" & Chr(10)
    code = code & "    fw.selected = 0" & Chr(10)
    code = code & "    fw.scroll = 0" & Chr(10)
    code = code & "    fw = fw._updateSelection()" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the current path" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) GetPath() AS STRING" & Chr(10)
    code = code & "    RETURN fw.path" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Update SelectedFile and SelectedFilePath properties based on current selection" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) _updateSelection() AS FilesWidget" & Chr(10)
    code = code & "    IF fw.selected >= 0 AND fw.selected < Len(fw.files) THEN" & Chr(10)
    code = code & "        fw.SelectedFile = fw.files[fw.selected]" & Chr(10)
    code = code & "        fw.SelectedFilePath = filepath.Join(fw.path, fw.files[fw.selected])" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        fw.SelectedFile = " & q & q & Chr(10)
    code = code & "        fw.SelectedFilePath = " & q & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetPattern method
    code = code & "' Set the file pattern filter (e.g., " & q & "*.txt" & q & ", " & q & "*.go" & q & ")" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) SetPattern(pattern AS STRING) AS FilesWidget" & Chr(10)
    code = code & "    fw.pattern = pattern" & Chr(10)
    code = code & "    fw.files = FilesListFiles(fw.path, fw.showHidden, fw.pattern)" & Chr(10)
    code = code & "    fw.selected = 0" & Chr(10)
    code = code & "    fw.scroll = 0" & Chr(10)
    code = code & "    fw = fw._updateSelection()" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    code = code & "' Get the current file pattern filter" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) GetPattern() AS STRING" & Chr(10)
    code = code & "    RETURN fw.pattern" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetColors method
    code = code & "' Set foreground and background colors" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) SetColors(fg AS INTEGER, bg AS INTEGER) AS FilesWidget" & Chr(10)
    code = code & "    fw.fgColor = fg" & Chr(10)
    code = code & "    fw.bgColor = bg" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate SetShowHidden method
    code = code & "' Set whether to show hidden files" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) SetShowHidden(show AS BOOLEAN) AS FilesWidget" & Chr(10)
    code = code & "    fw.showHidden = show" & Chr(10)
    code = code & "    fw.files = FilesListFiles(fw.path, fw.showHidden, fw.pattern)" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate GetRow method
    code = code & "' Get a specific row of the FilesWidget for rendering" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) GetRow(rowIndex AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fw.fgColor))).Background(lipgloss.Color(Str(fw.bgColor)))" & Chr(10)
    code = code & "    DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fw.bgColor))).Background(lipgloss.Color(Str(fw.fgColor)))" & Chr(10)
    code = code & "    DIM innerW AS INTEGER = fw.width - 2" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF rowIndex = 0 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "┌" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┐" & q & ")" & Chr(10)
    code = code & "    ELSEIF rowIndex = fw.height - 1 THEN" & Chr(10)
    code = code & "        RETURN style.Render(" & q & "└" & q & " & strings.Repeat(" & q & "─" & q & ", innerW) & " & q & "┘" & q & ")" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        ' File list area" & Chr(10)
    code = code & "        DIM fileIdx AS INTEGER = rowIndex - 1 + fw.scroll" & Chr(10)
    code = code & "        DIM content AS STRING = " & q & "│ " & q & Chr(10)
    code = code & "        IF fileIdx >= 0 AND fileIdx < Len(fw.files) THEN" & Chr(10)
    code = code & "            DIM fileName AS STRING = fw.files[fileIdx]" & Chr(10)
    code = code & "            DIM isSelected AS BOOLEAN = (fileIdx = fw.selected)" & Chr(10)
    code = code & "            DIM fileEntry AS STRING = fileName" & Chr(10)
    code = code & "            IF Len(fileEntry) > innerW - 1 THEN" & Chr(10)
    code = code & "                fileEntry = Left(fileEntry, innerW - 1)" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                fileEntry = fileEntry & strings.Repeat(" & q & " " & q & ", innerW - 1 - Len(fileEntry))" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "            IF isSelected AND fw.focused THEN" & Chr(10)
    code = code & "                content = style.Render(" & q & "│ " & q & ") & selStyle.Render(fileEntry) & style.Render(" & q & "│" & q & ")" & Chr(10)
    code = code & "                RETURN content" & Chr(10)
    code = code & "            ELSE" & Chr(10)
    code = code & "                content = content & fileEntry & " & q & "│" & q & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            content = content & strings.Repeat(" & q & " " & q & ", innerW - 1) & " & q & "│" & q & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        RETURN style.Render(content)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate View method (refreshes file listing)
    code = code & "' Refresh the file listing" & Chr(10)
    code = code & "FUNCTION (fw AS FilesWidget) View() AS FilesWidget" & Chr(10)
    code = code & "    fw.files = FilesListFiles(fw.path, fw.showHidden, fw.pattern)" & Chr(10)
    code = code & "    RETURN fw" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Check if project uses Files widget
FUNCTION ProjectHasFiles(proj AS VDBProject) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms[i].Controls) - 1
            IF proj.Forms[i].Controls[j].CtlType = CTRL_FILES THEN
                RETURN TRUE
            ENDIF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Check if project uses Curl widget
FUNCTION ProjectHasCurl(proj AS VDBProject) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms[i].Controls) - 1
            IF proj.Forms[i].Controls[j].CtlType = CTRL_CURL THEN
                RETURN TRUE
            ENDIF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Generate Curl helper functions
FUNCTION GenerateCurlHelpers() AS STRING
    DIM code AS STRING = ""
    DIM q AS STRING = Chr(34)

    code = code & "' ============================================" & Chr(10)
    code = code & "' Curl HTTP Helper Functions" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' BytesToString helper
    code = code & "' Convert bytes to string" & Chr(10)
    code = code & "FUNCTION CurlBytesToString(b AS BYTES) AS STRING" & Chr(10)
    code = code & "    RETURN fmt.Sprintf(" & q & "%s" & q & ", b)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' CurlFetch - perform HTTP request and return response, status code, error
    code = code & "' Perform an HTTP request and return response body, status code, and error" & Chr(10)
    code = code & "FUNCTION CurlFetch(urlStr AS STRING, method AS STRING, body AS STRING) AS (STRING, INTEGER, STRING)" & Chr(10)
    code = code & "    DIM respBody AS STRING = " & q & q & Chr(10)
    code = code & "    DIM statusCode AS INTEGER = 0" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF urlStr = " & q & q & " THEN" & Chr(10)
    code = code & "        RETURN " & q & q & ", 0, " & q & "URL is empty" & q & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM req AS POINTER TO http.Request" & Chr(10)
    code = code & "    DIM reqErr AS error" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF body <> " & q & q & " THEN" & Chr(10)
    code = code & "        req, reqErr = http.NewRequest(method, urlStr, bytes.NewBufferString(body))" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        req, reqErr = http.NewRequest(method, urlStr, NIL)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF reqErr <> NIL THEN" & Chr(10)
    code = code & "        RETURN " & q & q & ", 0, fmt.Sprintf(" & q & "%v" & q & ", reqErr)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM client AS http.Client" & Chr(10)
    code = code & "    DIM resp AS POINTER TO http.Response" & Chr(10)
    code = code & "    DIM respErr AS error" & Chr(10)
    code = code & "    resp, respErr = client.Do(req)" & Chr(10)
    code = code & "    IF respErr <> NIL THEN" & Chr(10)
    code = code & "        RETURN " & q & q & ", 0, fmt.Sprintf(" & q & "%v" & q & ", respErr)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    statusCode = (^resp).StatusCode" & Chr(10)
    code = code & Chr(10)
    code = code & "    DIM bodyBytes AS BYTES" & Chr(10)
    code = code & "    DIM readErr AS error" & Chr(10)
    code = code & "    bodyBytes, readErr = io.ReadAll((^resp).Body)" & Chr(10)
    code = code & "    (^resp).Body.Close()" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF readErr <> NIL THEN" & Chr(10)
    code = code & "        RETURN " & q & q & ", statusCode, fmt.Sprintf(" & q & "%v" & q & ", readErr)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    respBody = CurlBytesToString(bodyBytes)" & Chr(10)
    code = code & "    RETURN respBody, statusCode, " & q & q & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' CurlGet - simple GET request
    code = code & "' Perform a simple GET request" & Chr(10)
    code = code & "FUNCTION CurlGet(urlStr AS STRING) AS (STRING, INTEGER, STRING)" & Chr(10)
    code = code & "    RETURN CurlFetch(urlStr, " & q & "GET" & q & ", " & q & q & ")" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' CurlPost - simple POST request
    code = code & "' Perform a simple POST request" & Chr(10)
    code = code & "FUNCTION CurlPost(urlStr AS STRING, body AS STRING) AS (STRING, INTEGER, STRING)" & Chr(10)
    code = code & "    RETURN CurlFetch(urlStr, " & q & "POST" & q & ", body)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Check if project uses Path widget
FUNCTION ProjectHasPath(proj AS VDBProject) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms[i].Controls) - 1
            IF proj.Forms[i].Controls[j].CtlType = CTRL_PATH THEN
                RETURN TRUE
            ENDIF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Check if project uses Directories widget
FUNCTION ProjectHasDirectories(proj AS VDBProject) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms[i].Controls) - 1
            IF proj.Forms[i].Controls[j].CtlType = CTRL_DIRECTORIES THEN
                RETURN TRUE
            ENDIF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Check if project uses DirBrowser widget
FUNCTION ProjectHasDirBrowser(proj AS VDBProject) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms[i].Controls) - 1
            IF proj.Forms[i].Controls[j].CtlType = CTRL_DIRBROWSER THEN
                RETURN TRUE
            ENDIF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Check if form uses any widgets with LinkedPath property
FUNCTION FormHasLinkedPath(form AS VDBForm) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_PATH OR ctrl.CtlType = CTRL_DIRECTORIES OR ctrl.CtlType = CTRL_FILES THEN
            IF ctrl.LinkedControl <> "" THEN
                RETURN TRUE
            ENDIF
        ENDIF
    NEXT
    RETURN FALSE
END FUNCTION

' Get all unique LinkedPath names from a form
FUNCTION GetLinkedPathNames(form AS VDBForm) AS []STRING
    DIM result AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_PATH OR ctrl.CtlType = CTRL_DIRECTORIES OR ctrl.CtlType = CTRL_FILES THEN
            IF ctrl.LinkedControl <> "" THEN
                ' Check if already in result
                DIM found AS BOOLEAN = FALSE
                DIM j AS INTEGER
                FOR j = 0 TO Len(result) - 1
                    IF result[j] = ctrl.LinkedControl THEN
                        found = TRUE
                    ENDIF
                NEXT
                IF NOT found THEN
                    result = APPEND(result, ctrl.LinkedControl)
                ENDIF
            ENDIF
        ENDIF
    NEXT
    RETURN result
END FUNCTION

' Generate import statements based on controls used
FUNCTION GenerateImports(form AS VDBForm, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""
    DIM needTextInput AS BOOLEAN = FALSE
    DIM needTextarea AS BOOLEAN = FALSE
    DIM needList AS BOOLEAN = FALSE
    DIM needTimer AS BOOLEAN = FALSE
    DIM needFilepath AS BOOLEAN = FALSE
    DIM needTime AS BOOLEAN = FALSE
    DIM needHttp AS BOOLEAN = FALSE
    DIM pluginImports AS []STRING

    ' Scan controls to determine needed imports
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            needTextInput = TRUE
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            needTextarea = TRUE
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            needList = TRUE
        ELSEIF ctrl.CtlType = CTRL_TIMER THEN
            needTimer = TRUE
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            needTextInput = TRUE
            needFilepath = TRUE
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            needTextInput = TRUE
            needTime = TRUE
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            needFilepath = TRUE
            needTime = TRUE
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            needFilepath = TRUE
            needTime = TRUE
        ELSEIF ctrl.CtlType = CTRL_CURL THEN
            needHttp = TRUE
        ELSEIF ctrl.CtlType >= PLUGIN_TYPE_START THEN
            ' Plugin widget - collect imports from plugin definition
            DIM plugin AS PluginWidgetDef = GetPluginByCtrlType(ctrl.CtlType, registry)
            IF plugin.Meta.ID <> "" THEN
                DIM j AS INTEGER
                FOR j = 0 TO Len(plugin.Codegen.Imports) - 1
                    DIM imp AS STRING = plugin.Codegen.Imports[j]
                    ' Check if import already in list
                    DIM found AS BOOLEAN = FALSE
                    DIM k AS INTEGER
                    FOR k = 0 TO Len(pluginImports) - 1
                        IF pluginImports[k] = imp THEN
                            found = TRUE
                        ENDIF
                    NEXT
                    IF NOT found THEN
                        pluginImports = APPEND(pluginImports, imp)
                    ENDIF
                NEXT
            ENDIF
        ENDIF
    NEXT

    ' Core imports
    code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbletea" & Chr(34) & " AS tea" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/lipgloss" & Chr(34) & " AS lipgloss" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "fmt" & Chr(34) & " AS fmt" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "strings" & Chr(34) & " AS strings" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "os" & Chr(34) & " AS os" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "golang.org/x/term" & Chr(34) & " AS term" & Chr(10)

    ' Conditional imports
    IF needTextInput THEN
        code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbles/textinput" & Chr(34) & " AS textinput" & Chr(10)
    ENDIF
    IF needTextarea THEN
        code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbles/textarea" & Chr(34) & " AS textarea" & Chr(10)
        code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbles/key" & Chr(34) & " AS key" & Chr(10)
    ENDIF
    IF needList THEN
        code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbles/list" & Chr(34) & " AS list" & Chr(10)
    ENDIF
    IF needTimer THEN
        code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbles/timer" & Chr(34) & " AS timer" & Chr(10)
        code = code & "IMPORT " & Chr(34) & "time" & Chr(34) & " AS time" & Chr(10)
    ENDIF
    IF needFilepath THEN
        code = code & "IMPORT " & Chr(34) & "path/filepath" & Chr(34) & " AS filepath" & Chr(10)
    ENDIF
    IF needTime AND NOT needTimer THEN
        ' Import time for double-click detection (needTimer already imports time)
        code = code & "IMPORT " & Chr(34) & "time" & Chr(34) & " AS time" & Chr(10)
    ENDIF
    IF needHttp THEN
        code = code & "IMPORT " & Chr(34) & "net/http" & Chr(34) & " AS http" & Chr(10)
        code = code & "IMPORT " & Chr(34) & "io" & Chr(34) & " AS io" & Chr(10)
        code = code & "IMPORT " & Chr(34) & "bytes" & Chr(34) & " AS bytes" & Chr(10)
    ENDIF

    ' Plugin imports
    FOR i = 0 TO Len(pluginImports) - 1
        code = code & pluginImports[i] & Chr(10)
    NEXT

    code = code & Chr(10)
    RETURN code
END FUNCTION

' Generate form type definition
FUNCTION GenerateFormType(form AS VDBForm, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' Form model (implements tea.Model)" & Chr(10)
    code = code & "TYPE " & formTypeName & " IMPLEMENTS tea.Model" & Chr(10)

    ' Control components - generate field for each control
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            code = code & "    DIM " & ctrl.CtlName & " AS textinput.Model" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            code = code & "    DIM " & ctrl.CtlName & " AS textarea.Model" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            code = code & "    DIM " & ctrl.CtlName & " AS list.Model" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TIMER THEN
            code = code & "    DIM " & ctrl.CtlName & " AS timer.Model" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Running AS BOOLEAN" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
            code = code & "    DIM " & ctrl.CtlName & "_Focused AS BOOLEAN" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Pressed AS BOOLEAN" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LABEL THEN
            code = code & "    DIM " & ctrl.CtlName & "_Text AS STRING" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            code = code & "    DIM " & ctrl.CtlName & "_Checked AS BOOLEAN" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Focused AS BOOLEAN" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            code = code & "    DIM " & ctrl.CtlName & "_Selected AS BOOLEAN" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Focused AS BOOLEAN" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FRAME THEN
            code = code & "    DIM " & ctrl.CtlName & "_Caption AS STRING" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_HSCROLL OR ctrl.CtlType = CTRL_VSCROLL THEN
            code = code & "    DIM " & ctrl.CtlName & "_Value AS INTEGER" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Min AS INTEGER" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Max AS INTEGER" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
            code = code & "    DIM " & ctrl.CtlName & "_Value AS INTEGER" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Total AS INTEGER" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
            code = code & "    DIM " & ctrl.CtlName & "_Visible AS BOOLEAN" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Style AS INTEGER" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser now uses standalone widget type
            code = code & "    DIM " & ctrl.CtlName & " AS DirBrowser" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path uses standalone widget type
            code = code & "    DIM " & ctrl.CtlName & " AS PathWidget" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_LastClickTime AS time.Time" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories uses standalone widget type
            code = code & "    DIM " & ctrl.CtlName & " AS DirectoriesWidget" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_LastClickTime AS time.Time" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_LastClickIdx AS INTEGER" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files uses standalone widget type
            code = code & "    DIM " & ctrl.CtlName & " AS FilesWidget" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_LastClickTime AS time.Time" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_LastClickIdx AS INTEGER" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CURL THEN
            ' Curl widget state
            code = code & "    DIM " & ctrl.CtlName & "_URL AS STRING" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Method AS STRING" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Body AS STRING" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Response AS STRING" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_StatusCode AS INTEGER" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_Error AS STRING" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_IsLoading AS BOOLEAN" & Chr(10)
        ELSEIF ctrl.CtlType >= PLUGIN_TYPE_START THEN
            ' Plugin widget - generate state fields from plugin definition
            DIM plugin AS PluginWidgetDef = GetPluginByCtrlType(ctrl.CtlType, registry)
            IF plugin.Meta.ID <> "" THEN
                code = code & "    ' " & ctrl.CtlName & " (" & plugin.Meta.Name & ") state" & Chr(10)
                DIM j AS INTEGER
                FOR j = 0 TO Len(plugin.Codegen.StateFields) - 1
                    DIM field AS STRING = plugin.Codegen.StateFields[j]
                    ' Replace {name} placeholder with control name
                    field = ReplaceAll(field, "{name}", ctrl.CtlName)
                    code = code & "    DIM " & field & Chr(10)
                NEXT
            ENDIF
        ENDIF
    NEXT

    ' Extract and add module-level variables from form code
    DIM moduleVars AS []STRING = ExtractModuleVariables(form.Code, form)
    IF Len(moduleVars) > 0 THEN
        code = code & Chr(10)
        code = code & "    ' Module-level variables" & Chr(10)
        DIM v AS INTEGER
        FOR v = 0 TO Len(moduleVars) - 1
            code = code & "    DIM " & moduleVars[v] & " AS INTEGER" & Chr(10)
        NEXT
    ENDIF

    code = code & Chr(10)
    code = code & "    ' Focus management" & Chr(10)
    code = code & "    DIM FocusIndex AS INTEGER" & Chr(10)
    code = code & "    DIM FocusableControls AS []STRING" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Form dimensions" & Chr(10)
    code = code & "    DIM Width AS INTEGER" & Chr(10)
    code = code & "    DIM Height AS INTEGER" & Chr(10)
    code = code & "    DIM Caption AS STRING" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' LinkedPath support for Path/Directories/Files widget synchronization" & Chr(10)
    code = code & "    DIM LinkedPathNames AS []STRING" & Chr(10)
    code = code & "    DIM LinkedPathValues AS []STRING" & Chr(10)
    code = code & "END TYPE" & Chr(10) & Chr(10)

    RETURN code
END FUNCTION

' Get list of focusable controls sorted by TabIndex (respects TabStop property)
FUNCTION GetFocusableControls(form AS VDBForm) AS []STRING
    DIM focusable AS []STRING
    DIM tabIndices AS []INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER

    ' First, collect all focusable controls with TabStop = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        ' Only include controls that are focusable AND have TabStop = TRUE
        IF ctrl.TabStop THEN
            IF ctrl.CtlType = CTRL_TEXTBOX OR ctrl.CtlType = CTRL_TEXTAREA OR ctrl.CtlType = CTRL_BUTTON OR ctrl.CtlType = CTRL_CHECKBOX OR ctrl.CtlType = CTRL_OPTION OR ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX OR ctrl.CtlType = CTRL_DIRBROWSER OR ctrl.CtlType = CTRL_PATH OR ctrl.CtlType = CTRL_DIRECTORIES OR ctrl.CtlType = CTRL_FILES THEN
                focusable = APPEND(focusable, ctrl.CtlName)
                tabIndices = APPEND(tabIndices, ctrl.TabIndex)
            ENDIF
        ENDIF
    NEXT

    ' Sort by TabIndex using simple bubble sort
    DIM n AS INTEGER = Len(focusable)
    FOR i = 0 TO n - 2
        FOR j = 0 TO n - 2 - i
            IF tabIndices[j] > tabIndices[j + 1] THEN
                ' Swap names
                DIM tempName AS STRING = focusable[j]
                focusable[j] = focusable[j + 1]
                focusable[j + 1] = tempName
                ' Swap indices
                DIM tempIdx AS INTEGER = tabIndices[j]
                tabIndices[j] = tabIndices[j + 1]
                tabIndices[j + 1] = tempIdx
            ENDIF
        NEXT
    NEXT

    RETURN focusable
END FUNCTION

' Generate Init() method and InitModel() function
FUNCTION GenerateInit(form AS VDBForm, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"
    DIM focusable AS []STRING = GetFocusableControls(form)

    ' Generate InitModel function that returns an initialized model
    code = code & "' Create and initialize the form model" & Chr(10)
    code = code & "FUNCTION Init" & form.Name & "Model() AS " & formTypeName & Chr(10)
    code = code & "    DIM m AS " & formTypeName & Chr(10)
    code = code & "    ' Set form dimensions" & Chr(10)
    code = code & "    m.Width = " & Str(form.Width) & Chr(10)
    code = code & "    m.Height = " & Str(form.Height) & Chr(10)
    code = code & "    m.Caption = " & Chr(34) & form.Caption & Chr(34) & Chr(10)
    code = code & Chr(10)

    ' Initialize each control
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (TextBox)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = textinput.New()" & Chr(10)
            IF ctrl.Placeholder <> "" THEN
                code = code & "    m." & ctrl.CtlName & ".Placeholder = " & Chr(34) & ctrl.Placeholder & Chr(34) & Chr(10)
            ENDIF
            IF ctrl.Prompt <> "" THEN
                code = code & "    m." & ctrl.CtlName & ".Prompt = " & Chr(34) & ctrl.Prompt & Chr(34) & Chr(10)
            ENDIF
            code = code & "    m." & ctrl.CtlName & ".Width = " & Str(ctrl.Width) & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".CharLimit = " & Str(ctrl.CharLimit) & Chr(10)
            IF ctrl.EchoMode = 1 THEN
                code = code & "    m." & ctrl.CtlName & ".EchoMode = textinput.EchoPassword" & Chr(10)
            ELSEIF ctrl.EchoMode = 2 THEN
                code = code & "    m." & ctrl.CtlName & ".EchoMode = textinput.EchoNone" & Chr(10)
            ENDIF
            IF ctrl.Value <> "" THEN
                code = code & "    m." & ctrl.CtlName & ".SetValue(" & Chr(34) & ctrl.Value & Chr(34) & ")" & Chr(10)
            ENDIF
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (TextArea)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = textarea.New()" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".SetWidth(" & Str(ctrl.Width) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".SetHeight(" & Str(ctrl.Height) & ")" & Chr(10)
            IF ctrl.Placeholder <> "" THEN
                code = code & "    m." & ctrl.CtlName & ".Placeholder = " & Chr(34) & ctrl.Placeholder & Chr(34) & Chr(10)
            ENDIF
            IF ctrl.Value <> "" THEN
                code = code & "    m." & ctrl.CtlName & ".SetValue(" & Chr(34) & ctrl.Value & Chr(34) & ")" & Chr(10)
            ENDIF
            code = code & "    m." & ctrl.CtlName & ".ShowLineNumbers = FALSE" & Chr(10)
            ' Configure keybindings with Windows-style shortcuts (in addition to Emacs defaults)
            code = code & "    ' Add Windows-style keybindings (ctrl+arrows for word nav, ctrl+home/end for doc nav)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".KeyMap.WordForward = key.NewBinding(key.WithKeys(" & Chr(34) & "alt+right" & Chr(34) & ", " & Chr(34) & "alt+f" & Chr(34) & ", " & Chr(34) & "ctrl+right" & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".KeyMap.WordBackward = key.NewBinding(key.WithKeys(" & Chr(34) & "alt+left" & Chr(34) & ", " & Chr(34) & "alt+b" & Chr(34) & ", " & Chr(34) & "ctrl+left" & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".KeyMap.InputBegin = key.NewBinding(key.WithKeys(" & Chr(34) & "ctrl+home" & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".KeyMap.InputEnd = key.NewBinding(key.WithKeys(" & Chr(34) & "ctrl+end" & Chr(34) & "))" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (ListBox)" & Chr(10)
            code = code & "    DIM " & ctrl.CtlName & "_items AS []list.Item" & Chr(10)
            ' Parse Items string (semicolon-separated) and add items
            IF ctrl.Items <> "" THEN
                code = code & "    ' Items: " & ctrl.Items & Chr(10)
            ENDIF
            code = code & "    m." & ctrl.CtlName & " = list.New(" & ctrl.CtlName & "_items, list.NewDefaultDelegate(), " & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ")" & Chr(10)
            IF ctrl.ShowTitle THEN
                code = code & "    m." & ctrl.CtlName & ".SetShowTitle(TRUE)" & Chr(10)
            ELSE
                code = code & "    m." & ctrl.CtlName & ".SetShowTitle(FALSE)" & Chr(10)
            ENDIF
            IF ctrl.ShowStatusBar THEN
                code = code & "    m." & ctrl.CtlName & ".SetShowStatusBar(TRUE)" & Chr(10)
            ELSE
                code = code & "    m." & ctrl.CtlName & ".SetShowStatusBar(FALSE)" & Chr(10)
            ENDIF
            code = code & "    m." & ctrl.CtlName & ".SetShowHelp(FALSE)" & Chr(10)
            IF ctrl.ShowFilter THEN
                code = code & "    m." & ctrl.CtlName & ".SetFilteringEnabled(TRUE)" & Chr(10)
            ELSE
                code = code & "    m." & ctrl.CtlName & ".SetFilteringEnabled(FALSE)" & Chr(10)
            ENDIF
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TIMER THEN
            DIM interval AS INTEGER = ctrl.Interval
            IF interval <= 0 THEN
                interval = 1000
            ENDIF
            code = code & "    ' Initialize " & ctrl.CtlName & " (Timer)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = timer.New(time.Millisecond * " & Str(interval) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Running = FALSE" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LABEL THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Label)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Text = " & Chr(34) & ctrl.Caption & Chr(34) & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Button)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Focused = FALSE" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            DIM checked AS STRING = "FALSE"
            IF ctrl.Value = "1" THEN
                checked = "TRUE"
            ENDIF
            code = code & "    ' Initialize " & ctrl.CtlName & " (CheckBox)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Checked = " & checked & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Focused = FALSE" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            DIM selected AS STRING = "FALSE"
            IF ctrl.Value = "1" THEN
                selected = "TRUE"
            ENDIF
            code = code & "    ' Initialize " & ctrl.CtlName & " (Option)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Selected = " & selected & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Focused = FALSE" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FRAME THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Frame)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Caption = " & Chr(34) & ctrl.Caption & Chr(34) & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_HSCROLL OR ctrl.CtlType = CTRL_VSCROLL THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Scrollbar)" & Chr(10)
            DIM scrollVal AS INTEGER = 0
            IF ctrl.Value <> "" THEN
                scrollVal = ParseIntStr(ctrl.Value)
            ENDIF
            code = code & "    m." & ctrl.CtlName & "_Value = " & Str(scrollVal) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Min = " & Str(ctrl.MinValue) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Max = " & Str(ctrl.MaxValue) & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Progress)" & Chr(10)
            DIM progVal AS INTEGER = 0
            IF ctrl.Value <> "" THEN
                progVal = ParseIntStr(ctrl.Value)
            ENDIF
            code = code & "    m." & ctrl.CtlName & "_Value = " & Str(progVal) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Total = 100" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
            code = code & "    ' Initialize " & ctrl.CtlName & " (Spinner)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Visible = FALSE" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Style = 0" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            DIM initPath AS STRING = ctrl.FilePath
            code = code & "    ' Initialize " & ctrl.CtlName & " (DirBrowser widget)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = NewDirBrowser(" & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetColors(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")" & Chr(10)
            IF initPath <> "" THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & Chr(34) & initPath & Chr(34) & ")" & Chr(10)
            ENDIF
            ' Set textinput styles to match DirBrowser colors
            code = code & "    m." & ctrl.CtlName & ".pathInput.TextStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".pathInput.PromptStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".pathInput.Cursor.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & "))" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            DIM pathInitPath AS STRING = ctrl.FilePath
            code = code & "    ' Initialize " & ctrl.CtlName & " (Path widget)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = NewPathWidget(" & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetColors(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")" & Chr(10)
            IF pathInitPath <> "" THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & Chr(34) & pathInitPath & Chr(34) & ")" & Chr(10)
            ENDIF
            ' Set textinput styles
            code = code & "    m." & ctrl.CtlName & ".textInput.TextStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".textInput.PromptStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & "))" & Chr(10)
            code = code & "    m." & ctrl.CtlName & ".textInput.Cursor.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(ctrl.BackColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(ctrl.ForeColor) & Chr(34) & "))" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            DIM dirInitPath AS STRING = ctrl.FilePath
            code = code & "    ' Initialize " & ctrl.CtlName & " (Directories widget)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = NewDirectoriesWidget(" & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetColors(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")" & Chr(10)
            IF dirInitPath <> "" THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & Chr(34) & dirInitPath & Chr(34) & ")" & Chr(10)
            ENDIF
            IF ctrl.ShowHidden THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetShowHidden(TRUE)" & Chr(10)
            ENDIF
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            DIM filesInitPath AS STRING = ctrl.FilePath
            code = code & "    ' Initialize " & ctrl.CtlName & " (Files widget)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = NewFilesWidget(" & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ")" & Chr(10)
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetColors(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")" & Chr(10)
            IF filesInitPath <> "" THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & Chr(34) & filesInitPath & Chr(34) & ")" & Chr(10)
            ENDIF
            IF ctrl.ShowHidden THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetShowHidden(TRUE)" & Chr(10)
            ENDIF
            IF ctrl.Pattern <> "" AND ctrl.Pattern <> "*" THEN
                code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPattern(" & Chr(34) & ctrl.Pattern & Chr(34) & ")" & Chr(10)
            ENDIF
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CURL THEN
            DIM curlUrl AS STRING = ctrl.URL
            DIM curlMethod AS STRING = ctrl.HttpMethod
            IF curlMethod = "" THEN
                curlMethod = "GET"
            ENDIF
            code = code & "    ' Initialize " & ctrl.CtlName & " (Curl)" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_URL = " & Chr(34) & curlUrl & Chr(34) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Method = " & Chr(34) & curlMethod & Chr(34) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Body = " & Chr(34) & Chr(34) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Response = " & Chr(34) & Chr(34) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_StatusCode = 0" & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_Error = " & Chr(34) & Chr(34) & Chr(10)
            code = code & "    m." & ctrl.CtlName & "_IsLoading = FALSE" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType >= PLUGIN_TYPE_START THEN
            ' Plugin widget - generate init code from plugin definition
            DIM plugin AS PluginWidgetDef = GetPluginByCtrlType(ctrl.CtlType, registry)
            IF plugin.Meta.ID <> "" THEN
                code = code & "    ' Initialize " & ctrl.CtlName & " (" & plugin.Meta.Name & ")" & Chr(10)
                DIM j AS INTEGER
                FOR j = 0 TO Len(plugin.Codegen.InitCode) - 1
                    DIM initLine AS STRING = plugin.Codegen.InitCode[j]
                    ' Replace {name} placeholder with control name
                    initLine = ReplaceAll(initLine, "{name}", ctrl.CtlName)
                    ' Replace {prop:X} placeholders with property values
                    initLine = SubstitutePluginPropPlaceholders(initLine, ctrl, plugin)
                    code = code & "    " & initLine & Chr(10)
                NEXT
                code = code & Chr(10)
            ENDIF
        ENDIF
    NEXT

    ' Initialize focus order
    code = code & "    ' Initialize focus order" & Chr(10)
    code = code & "    m.FocusableControls = []STRING{"
    FOR i = 0 TO Len(focusable) - 1
        IF i > 0 THEN
            code = code & ", "
        ENDIF
        code = code & Chr(34) & focusable[i] & Chr(34)
    NEXT
    code = code & "}" & Chr(10)
    code = code & "    m.FocusIndex = 0" & Chr(10)

    ' Set initial focus and determine return command
    DIM returnCmd AS STRING = "NIL"
    IF Len(focusable) > 0 THEN
        DIM firstCtrl AS STRING = focusable[0]
        DIM ctrlType AS INTEGER = GetControlType(form, firstCtrl)
        IF ctrlType = CTRL_TEXTBOX THEN
            code = code & "    m." & firstCtrl & ".Focus()" & Chr(10)
            returnCmd = "textinput.Blink"
        ELSEIF ctrlType = CTRL_TEXTAREA THEN
            code = code & "    m." & firstCtrl & ".Focus()" & Chr(10)
            returnCmd = "textarea.Blink"
        ELSEIF ctrlType = CTRL_BUTTON OR ctrlType = CTRL_CHECKBOX OR ctrlType = CTRL_OPTION THEN
            code = code & "    m." & firstCtrl & "_Focused = TRUE" & Chr(10)
        ELSEIF ctrlType = CTRL_PATH THEN
            code = code & "    m." & firstCtrl & ", _ = m." & firstCtrl & ".Focus()" & Chr(10)
            returnCmd = "textinput.Blink"
        ELSEIF ctrlType = CTRL_DIRECTORIES THEN
            code = code & "    m." & firstCtrl & " = m." & firstCtrl & ".Focus()" & Chr(10)
        ELSEIF ctrlType = CTRL_FILES THEN
            code = code & "    m." & firstCtrl & " = m." & firstCtrl & ".Focus()" & Chr(10)
        ELSEIF ctrlType = CTRL_DIRBROWSER THEN
            code = code & "    m." & firstCtrl & " = m." & firstCtrl & ".Focus()" & Chr(10)
        ENDIF
    ENDIF

    code = code & Chr(10)
    code = code & "    ' Call user Form_Load" & Chr(10)
    code = code & "    m = " & form.Name & "_Load(m)" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10) & Chr(10)

    ' Generate the BubbleTea Init() method - returns initial commands
    ' Check if we have any timers that might need starting
    DIM hasTimer AS BOOLEAN = FALSE
    DIM timerName AS STRING = ""
    FOR i = 0 TO Len(form.Controls) - 1
        IF form.Controls[i].CtlType = CTRL_TIMER THEN
            hasTimer = TRUE
            timerName = form.Controls[i].CtlName
        ENDIF
    NEXT

    code = code & "' BubbleTea Init method - returns initial command" & Chr(10)
    code = code & "FUNCTION (m AS " & formTypeName & ") Init() AS tea.Cmd" & Chr(10)
    IF hasTimer THEN
        ' Need to check if timer is running and batch commands
        code = code & "    IF m." & timerName & "_Running THEN" & Chr(10)
        IF returnCmd = "NIL" THEN
            code = code & "        RETURN m." & timerName & ".Init()" & Chr(10)
        ELSE
            code = code & "        RETURN tea.Batch(" & returnCmd & ", m." & timerName & ".Init())" & Chr(10)
        ENDIF
        code = code & "    ENDIF" & Chr(10)
    ENDIF
    code = code & "    RETURN " & returnCmd & Chr(10)
    code = code & "END FUNCTION" & Chr(10) & Chr(10)

    RETURN code
END FUNCTION

' Helper to get control type by name
FUNCTION GetControlType(form AS VDBForm, name AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        IF form.Controls[i].CtlName = name THEN
            RETURN form.Controls[i].CtlType
        ENDIF
    NEXT
    RETURN -1
END FUNCTION

' Generate Update() method with event routing
FUNCTION GenerateUpdate(form AS VDBForm, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' Handle input messages" & Chr(10)
    code = code & "FUNCTION (m AS " & formTypeName & ") Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)" & Chr(10)
    code = code & "    DIM updateCmd AS tea.Cmd" & Chr(10)
    code = code & Chr(10)

    ' Handle mouse input
    code = code & "    ' Handle mouse clicks" & Chr(10)
    code = code & "    DIM mouseMsg AS tea.MouseMsg" & Chr(10)
    code = code & "    DIM mouseOk AS BOOLEAN" & Chr(10)
    code = code & "    mouseMsg, mouseOk = msg.(tea.MouseMsg)" & Chr(10)
    code = code & "    IF mouseOk AND mouseMsg.Action = tea.MouseActionPress AND mouseMsg.Button = tea.MouseButtonLeft THEN" & Chr(10)
    code = code & "        ' Adjust for form border (title embedded in top border)" & Chr(10)
    code = code & "        DIM mx AS INTEGER = Int(mouseMsg.X) - 1  ' left border" & Chr(10)
    code = code & "        DIM my AS INTEGER = Int(mouseMsg.Y) - 1  ' top border with title" & Chr(10)
    code = code & Chr(10)

    ' Generate click detection for each clickable control
    DIM i AS INTEGER
    DIM first AS BOOLEAN = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_BUTTON THEN
            DIM ctrlH AS INTEGER = 1
            IF ctrl.Border AND ctrl.Height >= 3 THEN
                ctrlH = ctrl.Height
            ENDIF
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrlH) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrlH) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Press on " & ctrl.CtlName & " (Button) - set pressed state, click on release" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Focused = TRUE" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Pressed = TRUE" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (CheckBox)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Focused = TRUE" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Checked = NOT m." & ctrl.CtlName & "_Checked" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            ' Check if any timer needs to be started
            DIM t AS INTEGER
            FOR t = 0 TO Len(form.Controls) - 1
                IF form.Controls[t].CtlType = CTRL_TIMER THEN
                    DIM tmrName AS STRING = form.Controls[t].CtlName
                    DIM tmrInterval AS INTEGER = form.Controls[t].Interval
                    IF tmrInterval <= 0 THEN
                        tmrInterval = 1000
                    ENDIF
                    code = code & "            IF m." & tmrName & "_Running THEN" & Chr(10)
                    code = code & "                m." & tmrName & " = timer.New(time.Millisecond * " & Str(tmrInterval) & ")" & Chr(10)
                    code = code & "                RETURN m, m." & tmrName & ".Init()" & Chr(10)
                    code = code & "            ENDIF" & Chr(10)
                ENDIF
            NEXT
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (Option)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Focused = TRUE" & Chr(10)
            code = code & "            m = SelectOption(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my = " & Str(ctrl.Y) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (TextBox)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            RETURN m, textinput.Blink" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
            ' Listbox spans multiple rows
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (ListBox)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            ' Calculate which item was clicked (relative row in list)" & Chr(10)
            code = code & "            DIM clickedRow AS INTEGER = my - " & Str(ctrl.Y) & Chr(10)
            code = code & "            DIM oldIdx AS INTEGER = m." & ctrl.CtlName & ".Index()" & Chr(10)
            code = code & "            DIM targetIdx AS INTEGER = clickedRow" & Chr(10)
            code = code & "            IF targetIdx >= 0 AND targetIdx < Len(m." & ctrl.CtlName & ".Items()) THEN" & Chr(10)
            code = code & "                m." & ctrl.CtlName & " = SetListIndex(m." & ctrl.CtlName & ", targetIdx)" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".Index() <> oldIdx THEN" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            ' TextArea spans multiple rows
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (TextArea)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            RETURN m, textarea.Blink" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser spans multiple rows - delegate to widget
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (DirBrowser widget)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            DIM dbClickRow AS INTEGER = my - " & Str(ctrl.Y) & Chr(10)
            code = code & "            IF dbClickRow = 1 THEN" & Chr(10)
            code = code & "                ' Clicked on path input" & Chr(10)
            code = code & "                m." & ctrl.CtlName & ".pathInput.Focus()" & Chr(10)
            code = code & "                RETURN m, textinput.Blink" & Chr(10)
            code = code & "            ELSE" & Chr(10)
            code = code & "                ' Clicked elsewhere (separator, list, or borders) - blur path input" & Chr(10)
            code = code & "                m." & ctrl.CtlName & ".pathInput.Blur()" & Chr(10)
            code = code & "                IF dbClickRow >= 3 THEN" & Chr(10)
            code = code & "                    ' Clicked on directory list - select the item" & Chr(10)
            code = code & "                    DIM dbTargetIdx AS INTEGER = dbClickRow - 3 + m." & ctrl.CtlName & ".scroll" & Chr(10)
            code = code & "                    IF dbTargetIdx >= 0 AND dbTargetIdx < Len(m." & ctrl.CtlName & ".dirs) THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".selected = dbTargetIdx" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path widget - click focuses the text input, double-click triggers Change/Enter/DblClick
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (Path widget)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            DIM " & ctrl.CtlName & "_focusCmd AS tea.Cmd" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ", " & ctrl.CtlName & "_focusCmd = m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            ' Check for double-click" & Chr(10)
            code = code & "            DIM pwNow AS time.Time = time.Now()" & Chr(10)
            code = code & "            DIM pwElapsed AS time.Duration = pwNow.Sub(m." & ctrl.CtlName & "_LastClickTime)" & Chr(10)
            code = code & "            IF pwElapsed < 500 * time.Millisecond THEN" & Chr(10)
            code = code & "                ' Double-click - apply path and trigger events" & Chr(10)
            code = code & "                m." & ctrl.CtlName & ".path = m." & ctrl.CtlName & ".textInput.Value()" & Chr(10)
            code = code & "                ' Auto-sync widgets with same LinkedPath (if set)" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".LinkedPath <> " & Chr(34) & Chr(34) & " THEN" & Chr(10)
            code = code & "                    m = _syncLinkedPath(m, m." & ctrl.CtlName & ".LinkedPath, m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_LastClickTime = pwNow" & Chr(10)
            code = code & "            RETURN m, " & ctrl.CtlName & "_focusCmd" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories widget - click focuses and selects item, double-click changes directory
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (Directories widget)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            DIM dwClickRow AS INTEGER = my - " & Str(ctrl.Y) & Chr(10)
            code = code & "            IF dwClickRow >= 1 AND dwClickRow < m." & ctrl.CtlName & ".height - 1 THEN" & Chr(10)
            code = code & "                DIM dwTargetIdx AS INTEGER = dwClickRow - 1 + m." & ctrl.CtlName & ".scroll" & Chr(10)
            code = code & "                IF dwTargetIdx >= 0 AND dwTargetIdx < Len(m." & ctrl.CtlName & ".dirs) THEN" & Chr(10)
            code = code & "                    ' Check for double-click" & Chr(10)
            code = code & "                    DIM dwNow AS time.Time = time.Now()" & Chr(10)
            code = code & "                    DIM dwElapsed AS time.Duration = dwNow.Sub(m." & ctrl.CtlName & "_LastClickTime)" & Chr(10)
            code = code & "                    IF dwTargetIdx = m." & ctrl.CtlName & "_LastClickIdx AND dwElapsed < 500 * time.Millisecond THEN" & Chr(10)
            code = code & "                        ' Double-click - change to selected directory" & Chr(10)
            code = code & "                        DIM dwSelectedDir AS STRING = m." & ctrl.CtlName & ".dirs[dwTargetIdx]" & Chr(10)
            code = code & "                        DIM dwNewPath AS STRING" & Chr(10)
            code = code & "                        IF dwSelectedDir = " & Chr(34) & ".." & Chr(34) & " THEN" & Chr(10)
            code = code & "                            dwNewPath = filepath.Dir(m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                        ELSE" & Chr(10)
            code = code & "                            dwNewPath = filepath.Join(m." & ctrl.CtlName & ".path, dwSelectedDir)" & Chr(10)
            code = code & "                        ENDIF" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(dwNewPath)" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & Chr(10)
            ' Auto-sync linked widgets if this control has a LinkedPath (checked at runtime)
            code = code & "                        IF m." & ctrl.CtlName & ".LinkedPath <> " & Chr(34) & Chr(34) & " THEN" & Chr(10)
            code = code & "                            m = _syncLinkedPath(m, m." & ctrl.CtlName & ".LinkedPath, dwNewPath)" & Chr(10)
            code = code & "                        ENDIF" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = dwTargetIdx" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & "_LastClickTime = dwNow" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & "_LastClickIdx = dwTargetIdx" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files widget - click focuses and selects item, double-click triggers DblClick event
            IF first THEN
                code = code & "        IF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "        ELSEIF mx >= " & Str(ctrl.X) & " AND mx < " & Str(ctrl.X + ctrl.Width) & " AND my >= " & Str(ctrl.Y) & " AND my < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            ENDIF
            code = code & "            ' Click on " & ctrl.CtlName & " (Files widget)" & Chr(10)
            code = code & "            m = ClearFocus(m)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
            code = code & "            m = SetFocusIndex(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            DIM fwClickRow AS INTEGER = my - " & Str(ctrl.Y) & Chr(10)
            code = code & "            IF fwClickRow >= 1 AND fwClickRow < m." & ctrl.CtlName & ".height - 1 THEN" & Chr(10)
            code = code & "                DIM fwTargetIdx AS INTEGER = fwClickRow - 1 + m." & ctrl.CtlName & ".scroll" & Chr(10)
            code = code & "                IF fwTargetIdx >= 0 AND fwTargetIdx < Len(m." & ctrl.CtlName & ".files) THEN" & Chr(10)
            code = code & "                    ' Check for double-click" & Chr(10)
            code = code & "                    DIM fwNow AS time.Time = time.Now()" & Chr(10)
            code = code & "                    DIM fwElapsed AS time.Duration = fwNow.Sub(m." & ctrl.CtlName & "_LastClickTime)" & Chr(10)
            code = code & "                    IF fwTargetIdx = m." & ctrl.CtlName & "_LastClickIdx AND fwElapsed < 500 * time.Millisecond THEN" & Chr(10)
            code = code & "                        ' Double-click - trigger Change, Enter, and DblClick events" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".selected = fwTargetIdx" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                        m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = fwTargetIdx" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & "_LastClickTime = fwNow" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & "_LastClickIdx = fwTargetIdx" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
        ENDIF
    NEXT

    IF NOT first THEN
        code = code & "        ENDIF" & Chr(10)
    ENDIF

    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)

    ' Handle mouse release for buttons (trigger click on release)
    code = code & "    ' Handle mouse release for button clicks" & Chr(10)
    code = code & "    IF mouseOk AND mouseMsg.Action = tea.MouseActionRelease THEN" & Chr(10)
    code = code & "        DIM rmx AS INTEGER = Int(mouseMsg.X) - 1" & Chr(10)
    code = code & "        DIM rmy AS INTEGER = Int(mouseMsg.Y) - 1" & Chr(10)
    ' Generate release handling for each button
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_BUTTON THEN
            DIM ctrlH AS INTEGER = 1
            IF ctrl.Border AND ctrl.Height >= 3 THEN
                ctrlH = ctrl.Height
            ENDIF
            code = code & "        IF m." & ctrl.CtlName & "_Pressed THEN" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Pressed = FALSE" & Chr(10)
            code = code & "            ' Check if release is within button bounds" & Chr(10)
            code = code & "            IF rmx >= " & Str(ctrl.X) & " AND rmx < " & Str(ctrl.X + ctrl.Width) & " AND rmy >= " & Str(ctrl.Y) & " AND rmy < " & Str(ctrl.Y + ctrlH) & " THEN" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
        ENDIF
    NEXT
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)

    ' Check for quit
    code = code & "    ' Handle quit" & Chr(10)
    code = code & "    DIM keyMsg AS tea.KeyMsg" & Chr(10)
    code = code & "    DIM ok AS BOOLEAN" & Chr(10)
    code = code & "    keyMsg, ok = msg.(tea.KeyMsg)" & Chr(10)
    code = code & Chr(10)
    code = code & "    IF ok THEN" & Chr(10)
    code = code & "        DIM key AS STRING = keyMsg.String()" & Chr(10)
    code = code & Chr(10)
    code = code & "        ' Quit on Ctrl+C or Escape" & Chr(10)
    code = code & "        IF key = " & Chr(34) & "ctrl+c" & Chr(34) & " OR key = " & Chr(34) & "esc" & Chr(34) & " THEN" & Chr(10)
    code = code & "            RETURN m, tea.Quit" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & Chr(10)

    ' Tab cycling
    code = code & "        ' Tab cycles focus" & Chr(10)
    code = code & "        IF key = " & Chr(34) & "tab" & Chr(34) & " THEN" & Chr(10)
    code = code & "            m = CycleFocus(m, 1)" & Chr(10)
    code = code & "            RETURN m, GetFocusCmd(m)" & Chr(10)
    code = code & "        ELSEIF key = " & Chr(34) & "shift+tab" & Chr(34) & " THEN" & Chr(10)
    code = code & "            m = CycleFocus(m, -1)" & Chr(10)
    code = code & "            RETURN m, GetFocusCmd(m)" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & Chr(10)

    ' Handle events for focusable controls
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_BUTTON THEN
            code = code & "        ' Enter on " & ctrl.CtlName & " triggers click" & Chr(10)
            code = code & "        IF key = " & Chr(34) & "enter" & Chr(34) & " AND m." & ctrl.CtlName & "_Focused THEN" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            code = code & "        ' Space toggles " & ctrl.CtlName & Chr(10)
            code = code & "        IF (key = " & Chr(34) & "enter" & Chr(34) & " OR key = " & Chr(34) & " " & Chr(34) & ") AND m." & ctrl.CtlName & "_Focused THEN" & Chr(10)
            code = code & "            m." & ctrl.CtlName & "_Checked = NOT m." & ctrl.CtlName & "_Checked" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            ' Check if any timer needs to be started
            DIM t AS INTEGER
            FOR t = 0 TO Len(form.Controls) - 1
                IF form.Controls[t].CtlType = CTRL_TIMER THEN
                    DIM tmrName AS STRING = form.Controls[t].CtlName
                    DIM tmrInterval AS INTEGER = form.Controls[t].Interval
                    IF tmrInterval <= 0 THEN
                        tmrInterval = 1000
                    ENDIF
                    code = code & "            IF m." & tmrName & "_Running THEN" & Chr(10)
                    code = code & "                m." & tmrName & " = timer.New(time.Millisecond * " & Str(tmrInterval) & ")" & Chr(10)
                    code = code & "                RETURN m, m." & tmrName & ".Init()" & Chr(10)
                    code = code & "            ENDIF" & Chr(10)
                ENDIF
            NEXT
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            code = code & "        ' Space selects " & ctrl.CtlName & Chr(10)
            code = code & "        IF (key = " & Chr(34) & "enter" & Chr(34) & " OR key = " & Chr(34) & " " & Chr(34) & ") AND m." & ctrl.CtlName & "_Focused THEN" & Chr(10)
            code = code & "            m = SelectOption(m, " & Chr(34) & ctrl.CtlName & Chr(34) & ")" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            DIM listH AS INTEGER = ctrl.Height - 4  ' Subtract borders (2) + path row (1) + separator (1)
            code = code & "        ' DirBrowser " & ctrl.CtlName & " keyboard handling (widget)" & Chr(10)
            code = code & "        DIM " & ctrl.CtlName & "_dbFocused AS BOOLEAN = m." & ctrl.CtlName & ".Focused()" & Chr(10)
            code = code & "        DIM " & ctrl.CtlName & "_pathFocused AS BOOLEAN = m." & ctrl.CtlName & ".pathInput.Focused()" & Chr(10)
            code = code & "        IF " & ctrl.CtlName & "_dbFocused AND (NOT " & ctrl.CtlName & "_pathFocused) THEN" & Chr(10)
            code = code & "            ' Directory list navigation (only when path input is NOT focused)" & Chr(10)
            code = code & "            IF key = " & Chr(34) & "up" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected > 0 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected - 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected < m." & ctrl.CtlName & ".scroll THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "down" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".dirs) - 1 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected + 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected >= m." & ctrl.CtlName & ".scroll + " & Str(listH) & " THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected - " & Str(listH - 1) & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "enter" & Chr(34) & " THEN" & Chr(10)
            code = code & "                ' Enter selected directory" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected >= 0 AND m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".dirs) THEN" & Chr(10)
            code = code & "                    DIM dbSelDir AS STRING = m." & ctrl.CtlName & ".dirs[m." & ctrl.CtlName & ".selected]" & Chr(10)
            code = code & "                    IF dbSelDir = " & Chr(34) & ".." & Chr(34) & " THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".path = filepath.Dir(m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                    ELSE" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".path = filepath.Join(m." & ctrl.CtlName & ".path, strings.TrimSuffix(dbSelDir, " & Chr(34) & "/" & Chr(34) & "))" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".pathInput.SetValue(m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".pathInput.CursorEnd()" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".pathInput.Blur()  ' Ensure path input stays unfocused" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".dirs = DirBrowserListDirs(m." & ctrl.CtlName & ".path, m." & ctrl.CtlName & ".showHidden)" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = 0" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".scroll = 0" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_DirChange(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "        ELSEIF " & ctrl.CtlName & "_dbFocused AND " & ctrl.CtlName & "_pathFocused AND key = " & Chr(34) & "enter" & Chr(34) & " THEN" & Chr(10)
            code = code & "            ' Path input: Enter applies typed path" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".path = m." & ctrl.CtlName & ".pathInput.Value()" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".dirs = DirBrowserListDirs(m." & ctrl.CtlName & ".path, m." & ctrl.CtlName & ".showHidden)" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".selected = 0" & Chr(10)
            code = code & "            m." & ctrl.CtlName & ".scroll = 0" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_PathChange(m)" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)

        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            code = code & "        ' Path " & ctrl.CtlName & " keyboard handling" & Chr(10)
            code = code & "        IF m." & ctrl.CtlName & ".Focused() THEN" & Chr(10)
            code = code & "            IF key = " & Chr(34) & "enter" & Chr(34) & " THEN" & Chr(10)
            code = code & "                ' Apply the typed path and trigger Change, Enter, DblClick events" & Chr(10)
            code = code & "                m." & ctrl.CtlName & ".path = m." & ctrl.CtlName & ".textInput.Value()" & Chr(10)
            ' Auto-sync linked widgets if this control has a LinkedPath (checked at runtime)
            code = code & "                IF m." & ctrl.CtlName & ".LinkedPath <> " & Chr(34) & Chr(34) & " THEN" & Chr(10)
            code = code & "                    m = _syncLinkedPath(m, m." & ctrl.CtlName & ".LinkedPath, m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)

        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            DIM dirListH AS INTEGER = ctrl.Height - 2  ' Subtract borders
            code = code & "        ' Directories " & ctrl.CtlName & " keyboard handling" & Chr(10)
            code = code & "        IF m." & ctrl.CtlName & ".Focused() THEN" & Chr(10)
            code = code & "            IF key = " & Chr(34) & "up" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected > 0 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected - 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected < m." & ctrl.CtlName & ".scroll THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "down" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".dirs) - 1 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected + 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected >= m." & ctrl.CtlName & ".scroll + " & Str(dirListH) & " THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected - " & Str(dirListH - 1) & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "enter" & Chr(34) & " THEN" & Chr(10)
            code = code & "                ' Enter selected directory - trigger Change, Enter, DblClick events" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected >= 0 AND m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".dirs) THEN" & Chr(10)
            code = code & "                    DIM dwSelDir AS STRING = m." & ctrl.CtlName & ".dirs[m." & ctrl.CtlName & ".selected]" & Chr(10)
            code = code & "                    IF dwSelDir = " & Chr(34) & ".." & Chr(34) & " THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".path = filepath.Dir(m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                    ELSE" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".path = filepath.Join(m." & ctrl.CtlName & ".path, strings.TrimSuffix(dwSelDir, " & Chr(34) & "/" & Chr(34) & "))" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".dirs = DirectoriesListDirs(m." & ctrl.CtlName & ".path, m." & ctrl.CtlName & ".showHidden)" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = 0" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".scroll = 0" & Chr(10)
            ' Auto-sync linked widgets if this control has a LinkedPath (checked at runtime)
            code = code & "                    IF m." & ctrl.CtlName & ".LinkedPath <> " & Chr(34) & Chr(34) & " THEN" & Chr(10)
            code = code & "                        m = _syncLinkedPath(m, m." & ctrl.CtlName & ".LinkedPath, m." & ctrl.CtlName & ".path)" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)

        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            DIM fileListH AS INTEGER = ctrl.Height - 2  ' Subtract borders
            code = code & "        ' Files " & ctrl.CtlName & " keyboard handling" & Chr(10)
            code = code & "        IF m." & ctrl.CtlName & ".Focused() THEN" & Chr(10)
            code = code & "            IF key = " & Chr(34) & "up" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected > 0 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected - 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected < m." & ctrl.CtlName & ".scroll THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected" & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "down" & Chr(34) & " THEN" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".files) - 1 THEN" & Chr(10)
            code = code & "                    m." & ctrl.CtlName & ".selected = m." & ctrl.CtlName & ".selected + 1" & Chr(10)
            code = code & "                    IF m." & ctrl.CtlName & ".selected >= m." & ctrl.CtlName & ".scroll + " & Str(fileListH) & " THEN" & Chr(10)
            code = code & "                        m." & ctrl.CtlName & ".scroll = m." & ctrl.CtlName & ".selected - " & Str(fileListH - 1) & Chr(10)
            code = code & "                    ENDIF" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ELSEIF key = " & Chr(34) & "enter" & Chr(34) & " THEN" & Chr(10)
            code = code & "                ' Select the file - trigger Change, Enter, DblClick events" & Chr(10)
            code = code & "                IF m." & ctrl.CtlName & ".selected >= 0 AND m." & ctrl.CtlName & ".selected < Len(m." & ctrl.CtlName & ".files) THEN" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Change(m)" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_Enter(m)" & Chr(10)
            code = code & "                    m = " & ctrl.CtlName & "_DblClick(m)" & Chr(10)
            code = code & "                ENDIF" & Chr(10)
            code = code & "                RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & Chr(10)

        ENDIF
    NEXT

    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)

    ' Handle timer messages BEFORE routing to focused controls
    ' (Timer messages must be processed regardless of which control is focused)
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TIMER THEN
            DIM interval AS INTEGER = ctrl.Interval
            IF interval <= 0 THEN
                interval = 1000
            ENDIF
            code = code & "    ' Handle timer for " & ctrl.CtlName & Chr(10)
            code = code & "    IF m." & ctrl.CtlName & "_Running THEN" & Chr(10)
            code = code & "        m." & ctrl.CtlName & ", updateCmd = m." & ctrl.CtlName & ".Update(msg)" & Chr(10)
            code = code & "        IF m." & ctrl.CtlName & ".Timedout() THEN" & Chr(10)
            code = code & "            m = " & ctrl.CtlName & "_Timer(m)" & Chr(10)
            code = code & "            ' Restart timer if still running" & Chr(10)
            code = code & "            IF m." & ctrl.CtlName & "_Running THEN" & Chr(10)
            code = code & "                m." & ctrl.CtlName & " = timer.New(time.Millisecond * " & Str(interval) & ")" & Chr(10)
            code = code & "                RETURN m, m." & ctrl.CtlName & ".Init()" & Chr(10)
            code = code & "            ENDIF" & Chr(10)
            code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & "        ' Non-timer messages fall through to other handlers" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
            code = code & Chr(10)
        ENDIF
    NEXT

    ' Route messages to focused control - only if there are controls that need routing
    ' Check if there are any TextBox or ListBox controls
    DIM hasRoutableControls AS BOOLEAN = FALSE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TEXTBOX OR ctrl.CtlType = CTRL_TEXTAREA OR ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX OR ctrl.CtlType = CTRL_DIRBROWSER OR ctrl.CtlType = CTRL_PATH OR ctrl.CtlType = CTRL_DIRECTORIES OR ctrl.CtlType = CTRL_FILES THEN
            hasRoutableControls = TRUE
        ENDIF
    NEXT

    IF hasRoutableControls THEN
        code = code & "    ' Route to focused control" & Chr(10)
        code = code & "    IF Len(m.FocusableControls) > 0 AND m.FocusIndex >= 0 AND m.FocusIndex < Len(m.FocusableControls) THEN" & Chr(10)
        code = code & "        DIM focused AS STRING = m.FocusableControls[m.FocusIndex]" & Chr(10)
        code = code & Chr(10)

        ' Generate routing for each focusable control type
        first = TRUE
        FOR i = 0 TO Len(form.Controls) - 1
            DIM ctrl AS VDBControl = form.Controls[i]

            IF ctrl.CtlType = CTRL_TEXTBOX THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            m." & ctrl.CtlName & ", updateCmd = m." & ctrl.CtlName & ".Update(msg)" & Chr(10)
                code = code & "            ' Reset cursor to visible on cursor movement for immediate visibility" & Chr(10)
                code = code & "            DIM tiKeyMsg AS tea.KeyMsg" & Chr(10)
                code = code & "            DIM tiKeyOk AS BOOLEAN" & Chr(10)
                code = code & "            tiKeyMsg, tiKeyOk = msg.(tea.KeyMsg)" & Chr(10)
                code = code & "            IF tiKeyOk THEN" & Chr(10)
                code = code & "                DIM tiKey AS STRING = tiKeyMsg.String()" & Chr(10)
                code = code & "                IF tiKey = " & Chr(34) & "left" & Chr(34) & " OR tiKey = " & Chr(34) & "right" & Chr(34) & " OR tiKey = " & Chr(34) & "home" & Chr(34) & " OR tiKey = " & Chr(34) & "end" & Chr(34) & " OR tiKey = " & Chr(34) & "ctrl+left" & Chr(34) & " OR tiKey = " & Chr(34) & "ctrl+right" & Chr(34) & " THEN" & Chr(10)
                code = code & "                    DIM tiFocusCmd AS tea.Cmd = m." & ctrl.CtlName & ".Focus()" & Chr(10)
                code = code & "                    RETURN m, tiFocusCmd" & Chr(10)
                code = code & "                ENDIF" & Chr(10)
                code = code & "            ENDIF" & Chr(10)
                code = code & "            RETURN m, updateCmd" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            DIM " & ctrl.CtlName & "_prevIdx AS INTEGER = m." & ctrl.CtlName & ".Index()" & Chr(10)
                code = code & "            m." & ctrl.CtlName & ", updateCmd = m." & ctrl.CtlName & ".Update(msg)" & Chr(10)
                code = code & "            ' Call click handler if selection changed or Enter pressed" & Chr(10)
                code = code & "            IF m." & ctrl.CtlName & ".Index() <> " & ctrl.CtlName & "_prevIdx THEN" & Chr(10)
                code = code & "                m = " & ctrl.CtlName & "_Click(m)" & Chr(10)
                code = code & "            ENDIF" & Chr(10)
                code = code & "            RETURN m, updateCmd" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            m." & ctrl.CtlName & ", updateCmd = m." & ctrl.CtlName & ".Update(msg)" & Chr(10)
                code = code & "            ' Reset cursor to visible on cursor movement for immediate visibility" & Chr(10)
                code = code & "            DIM taKeyMsg AS tea.KeyMsg" & Chr(10)
                code = code & "            DIM taKeyOk AS BOOLEAN" & Chr(10)
                code = code & "            taKeyMsg, taKeyOk = msg.(tea.KeyMsg)" & Chr(10)
                code = code & "            IF taKeyOk THEN" & Chr(10)
                code = code & "                DIM taKey AS STRING = taKeyMsg.String()" & Chr(10)
                code = code & "                IF taKey = " & Chr(34) & "left" & Chr(34) & " OR taKey = " & Chr(34) & "right" & Chr(34) & " OR taKey = " & Chr(34) & "up" & Chr(34) & " OR taKey = " & Chr(34) & "down" & Chr(34) & " OR taKey = " & Chr(34) & "home" & Chr(34) & " OR taKey = " & Chr(34) & "end" & Chr(34) & " OR taKey = " & Chr(34) & "ctrl+left" & Chr(34) & " OR taKey = " & Chr(34) & "ctrl+right" & Chr(34) & " OR taKey = " & Chr(34) & "ctrl+up" & Chr(34) & " OR taKey = " & Chr(34) & "ctrl+down" & Chr(34) & " THEN" & Chr(10)
                code = code & "                    DIM taFocusCmd AS tea.Cmd = m." & ctrl.CtlName & ".Focus()" & Chr(10)
                code = code & "                    RETURN m, taFocusCmd" & Chr(10)
                code = code & "                ENDIF" & Chr(10)
                code = code & "            ENDIF" & Chr(10)
                code = code & "            RETURN m, updateCmd" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            ' Only route to path input when it is focused (widget)" & Chr(10)
                code = code & "            IF m." & ctrl.CtlName & ".pathInput.Focused() THEN" & Chr(10)
                code = code & "                m." & ctrl.CtlName & ".pathInput, updateCmd = m." & ctrl.CtlName & ".pathInput.Update(msg)" & Chr(10)
                code = code & "                ' Reset cursor to visible on cursor movement for immediate visibility" & Chr(10)
                code = code & "                DIM dbKeyMsg AS tea.KeyMsg" & Chr(10)
                code = code & "                DIM dbKeyOk AS BOOLEAN" & Chr(10)
                code = code & "                dbKeyMsg, dbKeyOk = msg.(tea.KeyMsg)" & Chr(10)
                code = code & "                IF dbKeyOk THEN" & Chr(10)
                code = code & "                    DIM dbKey AS STRING = dbKeyMsg.String()" & Chr(10)
                code = code & "                    IF dbKey = " & Chr(34) & "left" & Chr(34) & " OR dbKey = " & Chr(34) & "right" & Chr(34) & " OR dbKey = " & Chr(34) & "home" & Chr(34) & " OR dbKey = " & Chr(34) & "end" & Chr(34) & " OR dbKey = " & Chr(34) & "ctrl+left" & Chr(34) & " OR dbKey = " & Chr(34) & "ctrl+right" & Chr(34) & " THEN" & Chr(10)
                code = code & "                        DIM dbFocusCmd AS tea.Cmd = m." & ctrl.CtlName & ".pathInput.Focus()" & Chr(10)
                code = code & "                        RETURN m, dbFocusCmd" & Chr(10)
                code = code & "                    ENDIF" & Chr(10)
                code = code & "                ENDIF" & Chr(10)
                code = code & "                RETURN m, updateCmd" & Chr(10)
                code = code & "            ENDIF" & Chr(10)
                code = code & "            ' If path input not focused, just return (directory list handled by keyboard section)" & Chr(10)
                code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_PATH THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            m." & ctrl.CtlName & ".textInput, updateCmd = m." & ctrl.CtlName & ".textInput.Update(msg)" & Chr(10)
                code = code & "            ' Reset cursor to visible on cursor movement for immediate visibility" & Chr(10)
                code = code & "            DIM pwKeyMsg AS tea.KeyMsg" & Chr(10)
                code = code & "            DIM pwKeyOk AS BOOLEAN" & Chr(10)
                code = code & "            pwKeyMsg, pwKeyOk = msg.(tea.KeyMsg)" & Chr(10)
                code = code & "            IF pwKeyOk THEN" & Chr(10)
                code = code & "                DIM pwKey AS STRING = pwKeyMsg.String()" & Chr(10)
                code = code & "                IF pwKey = " & Chr(34) & "left" & Chr(34) & " OR pwKey = " & Chr(34) & "right" & Chr(34) & " OR pwKey = " & Chr(34) & "home" & Chr(34) & " OR pwKey = " & Chr(34) & "end" & Chr(34) & " OR pwKey = " & Chr(34) & "ctrl+left" & Chr(34) & " OR pwKey = " & Chr(34) & "ctrl+right" & Chr(34) & " THEN" & Chr(10)
                code = code & "                    DIM pwFocusCmd AS tea.Cmd = m." & ctrl.CtlName & ".textInput.Focus()" & Chr(10)
                code = code & "                    RETURN m, pwFocusCmd" & Chr(10)
                code = code & "                ENDIF" & Chr(10)
                code = code & "            ENDIF" & Chr(10)
                code = code & "            RETURN m, updateCmd" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            ' Directories list is handled by keyboard section, just return" & Chr(10)
                code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            ELSEIF ctrl.CtlType = CTRL_FILES THEN
                IF first THEN
                    code = code & "        IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                    first = FALSE
                ELSE
                    code = code & "        ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                ENDIF
                code = code & "            ' Files list is handled by keyboard section, just return" & Chr(10)
                code = code & "            RETURN m, _checkMsgBoxRepaint()" & Chr(10)
            ENDIF
        NEXT

        IF NOT first THEN
            code = code & "        ENDIF" & Chr(10)
        ENDIF

        code = code & "    ENDIF" & Chr(10)
        code = code & Chr(10)
    ENDIF

    code = code & "    RETURN m, _checkMsgBoxRepaint()" & Chr(10)
    code = code & "END FUNCTION" & Chr(10) & Chr(10)

    RETURN code
END FUNCTION

' Generate View() method with proper absolute positioning
' Builds each row by composing all controls at their X positions
FUNCTION GenerateView(form AS VDBForm, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' Render the form" & Chr(10)
    code = code & "FUNCTION (m AS " & formTypeName & ") View() AS STRING" & Chr(10)
    code = code & Chr(10)

    ' Build content row by row, composing all controls at their positions
    ' Interior content is (m.Width - 2) x (m.Height - 2) - borders included in form dimensions
    code = code & "    ' Build each row by composing controls at their X positions" & Chr(10)
    code = code & "    ' Interior content area (form dimensions include border)" & Chr(10)
    code = code & "    DIM interiorWidth AS INTEGER = m.Width - 2" & Chr(10)
    code = code & "    DIM interiorHeight AS INTEGER = m.Height - 2" & Chr(10)
    code = code & "    DIM formBgColor AS INTEGER = " & Str(form.BackColor) & Chr(10)
    code = code & "    DIM contentRows AS []STRING" & Chr(10)
    code = code & "    DIM y AS INTEGER" & Chr(10)
    code = code & "    FOR y = 0 TO interiorHeight - 1" & Chr(10)
    code = code & "        DIM row AS STRING = BuildRow(m, y, interiorWidth, formBgColor)" & Chr(10)
    code = code & "        contentRows = APPEND(contentRows, row)" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & Chr(10)

    ' Build form border manually with title embedded in top border
    code = code & "    ' Build border with title embedded in top row" & Chr(10)
    code = code & "    ' Use form colors: ForeColor=" & Str(form.ForeColor) & ", BackColor=" & Str(form.BackColor) & Chr(10)
    code = code & "    DIM borderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(" & Chr(34) & Str(form.ForeColor) & Chr(34) & ")).Background(lipgloss.Color(" & Chr(34) & Str(form.BackColor) & Chr(34) & "))" & Chr(10)
    code = code & "    DIM formWidth AS INTEGER = m.Width  ' form dimensions include border" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Build top border with embedded title" & Chr(10)
    code = code & "    DIM titleText AS STRING = " & Chr(34) & " " & Chr(34) & " & m.Caption & " & Chr(34) & " " & Chr(34) & Chr(10)
    code = code & "    DIM topBorder AS STRING = " & Chr(34) & "╭" & Chr(34) & Chr(10)
    code = code & "    DIM col AS INTEGER" & Chr(10)
    code = code & "    FOR col = 1 TO formWidth - 2" & Chr(10)
    code = code & "        IF col <= Len(titleText) THEN" & Chr(10)
    code = code & "            topBorder = topBorder & Mid(titleText, col, 1)" & Chr(10)
    code = code & "        ELSE" & Chr(10)
    code = code & "            topBorder = topBorder & " & Chr(34) & "─" & Chr(34) & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    topBorder = topBorder & " & Chr(34) & "╮" & Chr(34) & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Build bottom border" & Chr(10)
    code = code & "    DIM bottomBorder AS STRING = " & Chr(34) & "╰" & Chr(34) & " & strings.Repeat(" & Chr(34) & "─" & Chr(34) & ", formWidth - 2) & " & Chr(34) & "╯" & Chr(34) & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Wrap content rows with side borders and apply background" & Chr(10)
    code = code & "    DIM wrappedRows AS []STRING" & Chr(10)
    code = code & "    wrappedRows = APPEND(wrappedRows, borderStyle.Render(topBorder))" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(contentRows) - 1" & Chr(10)
    code = code & "        wrappedRows = APPEND(wrappedRows, borderStyle.Render(" & Chr(34) & "│" & Chr(34) & ") & contentRows[i] & borderStyle.Render(" & Chr(34) & "│" & Chr(34) & "))" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    wrappedRows = APPEND(wrappedRows, borderStyle.Render(bottomBorder))" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN strings.Join(wrappedRows, " & Chr(34) & Chr(10) & Chr(34) & ")" & Chr(10)
    code = code & "END FUNCTION" & Chr(10) & Chr(10)

    ' Generate BuildRow function that composes all controls for a given row
    code = code & GenerateBuildRowFunction(form)

    RETURN code
END FUNCTION

' Generate the BuildRow function that composes controls for each row
FUNCTION GenerateBuildRowFunction(form AS VDBForm) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' Build a single row by placing all controls at their X positions" & Chr(10)
    code = code & "FUNCTION BuildRow(m AS " & formTypeName & ", y AS INTEGER, rowWidth AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
    code = code & "    ' Collect all control segments for this row with their X positions" & Chr(10)
    code = code & "    DIM segments AS []RowSegment" & Chr(10)
    code = code & Chr(10)

    ' Generate segment collection for each control
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_FRAME THEN
            ' Frame spans multiple rows - use separate left/right borders for middle rows to allow interior controls
            code = code & "    ' " & ctrl.CtlName & " (Frame) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        ' Top border" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetFrameTopRow(m." & ctrl.CtlName & "_Caption, " & Str(ctrl.Width) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ELSEIF y = " & Str(ctrl.Y + ctrl.Height - 1) & " THEN" & Chr(10)
            code = code & "        ' Bottom border" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetFrameBottomRow(" & Str(ctrl.Width) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ELSEIF y > " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height - 1) & " THEN" & Chr(10)
            code = code & "        ' Middle rows - left and right borders separately with colors" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetFrameLeftBorder(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X + ctrl.Width - 1) & ", Content: GetFrameRightBorder(" & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LABEL THEN
            code = code & "    ' " & ctrl.CtlName & " (Label) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderLabel(m." & ctrl.CtlName & "_Text, " & Str(ctrl.Width) & ", " & Str(ctrl.Justification) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
            code = code & "    ' " & ctrl.CtlName & " (TextBox) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderTextInput(m." & ctrl.CtlName & ", " & Str(ctrl.Width) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
            IF ctrl.Border AND ctrl.Height >= 3 THEN
                ' Bordered button spans multiple rows - use _Pressed for color inversion
                code = code & "    ' " & ctrl.CtlName & " (Bordered Button) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
                code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
                code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetButtonTopRow(" & Str(ctrl.Width) & ", m." & ctrl.CtlName & "_Pressed, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
                code = code & "    ELSEIF y = " & Str(ctrl.Y + ctrl.Height - 1) & " THEN" & Chr(10)
                code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetButtonBottomRow(" & Str(ctrl.Width) & ", m." & ctrl.CtlName & "_Pressed, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
                code = code & "    ELSEIF y > " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height - 1) & " THEN" & Chr(10)
                code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetButtonMiddleRow(" & Chr(34) & ctrl.Caption & Chr(34) & ", " & Str(ctrl.Width) & ", m." & ctrl.CtlName & "_Pressed, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
                code = code & "    ENDIF" & Chr(10)
            ELSE
                ' Flat button (single row, centered text) - use _Pressed for color inversion
                code = code & "    ' " & ctrl.CtlName & " (Flat Button) at y=" & Str(ctrl.Y) & Chr(10)
                code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
                code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderFlatButton(" & Chr(34) & ctrl.Caption & Chr(34) & ", " & Str(ctrl.Width) & ", m." & ctrl.CtlName & "_Pressed, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
                code = code & "    ENDIF" & Chr(10)
            ENDIF
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            code = code & "    ' " & ctrl.CtlName & " (CheckBox) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderCheckBox(" & Chr(34) & ctrl.Caption & Chr(34) & ", m." & ctrl.CtlName & "_Checked, m." & ctrl.CtlName & "_Focused, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            code = code & "    ' " & ctrl.CtlName & " (Option) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderOption(" & Chr(34) & ctrl.Caption & Chr(34) & ", m." & ctrl.CtlName & "_Selected, m." & ctrl.CtlName & "_Focused, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            code = code & "    ' " & ctrl.CtlName & " (ListBox) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetListBoxRow(m." & ctrl.CtlName & ", " & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ", y - " & Str(ctrl.Y) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_HSCROLL THEN
            code = code & "    ' " & ctrl.CtlName & " (HScrollBar) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderHScroll(m." & ctrl.CtlName & "_Value, m." & ctrl.CtlName & "_Min, m." & ctrl.CtlName & "_Max, " & Str(ctrl.Width) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_VSCROLL THEN
            code = code & "    ' " & ctrl.CtlName & " (VScrollBar) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetVScrollRow(m." & ctrl.CtlName & "_Value, m." & ctrl.CtlName & "_Min, m." & ctrl.CtlName & "_Max, " & Str(ctrl.Height) & ", y - " & Str(ctrl.Y) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
            code = code & "    ' " & ctrl.CtlName & " (Progress) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderProgress(m." & ctrl.CtlName & "_Value, m." & ctrl.CtlName & "_Total, " & Str(ctrl.Width) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
            code = code & "    ' " & ctrl.CtlName & " (Spinner) at y=" & Str(ctrl.Y) & Chr(10)
            code = code & "    IF y = " & Str(ctrl.Y) & " AND m." & ctrl.CtlName & "_Visible THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: RenderSpinner(m." & ctrl.CtlName & "_Style, " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            code = code & "    ' " & ctrl.CtlName & " (TextArea) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: GetTextAreaRow(m." & ctrl.CtlName & ", " & Str(ctrl.Width) & ", " & Str(ctrl.Height) & ", y - " & Str(ctrl.Y) & ", " & Str(ctrl.ForeColor) & ", " & Str(ctrl.BackColor) & ")})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser uses widget's GetRow method
            code = code & "    ' " & ctrl.CtlName & " (DirBrowser widget) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        DIM dbLocalRow AS INTEGER = y - " & Str(ctrl.Y) & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: m." & ctrl.CtlName & ".GetRow(dbLocalRow)})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path uses widget's GetRow method
            code = code & "    ' " & ctrl.CtlName & " (Path widget) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        DIM pathLocalRow AS INTEGER = y - " & Str(ctrl.Y) & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: m." & ctrl.CtlName & ".GetRow(pathLocalRow)})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories uses widget's GetRow method
            code = code & "    ' " & ctrl.CtlName & " (Directories widget) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        DIM dirLocalRow AS INTEGER = y - " & Str(ctrl.Y) & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: m." & ctrl.CtlName & ".GetRow(dirLocalRow)})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files uses widget's GetRow method
            code = code & "    ' " & ctrl.CtlName & " (Files widget) at y=" & Str(ctrl.Y) & "-" & Str(ctrl.Y + ctrl.Height - 1) & Chr(10)
            code = code & "    IF y >= " & Str(ctrl.Y) & " AND y < " & Str(ctrl.Y + ctrl.Height) & " THEN" & Chr(10)
            code = code & "        DIM filesLocalRow AS INTEGER = y - " & Str(ctrl.Y) & Chr(10)
            code = code & "        segments = APPEND(segments, RowSegment{X: " & Str(ctrl.X) & ", Content: m." & ctrl.CtlName & ".GetRow(filesLocalRow)})" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ENDIF
    NEXT

    code = code & Chr(10)
    code = code & "    ' Compose the row from segments sorted by X position" & Chr(10)
    code = code & "    RETURN ComposeRow(segments, rowWidth, bgColor)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10) & Chr(10)

    RETURN code
END FUNCTION

' Generate control render helper functions for row-based composition
FUNCTION GenerateRenderHelpers(proj AS VDBProject) AS STRING
    DIM code AS STRING = ""

    ' Scan all forms to determine what control types are used
    DIM hasTextBox AS BOOLEAN = FALSE
    DIM hasListBox AS BOOLEAN = FALSE
    DIM hasButton AS BOOLEAN = FALSE
    DIM hasCheckBox AS BOOLEAN = FALSE
    DIM hasOption AS BOOLEAN = FALSE
    DIM hasFrame AS BOOLEAN = FALSE
    DIM hasHScroll AS BOOLEAN = FALSE
    DIM hasVScroll AS BOOLEAN = FALSE
    DIM hasProgress AS BOOLEAN = FALSE
    DIM hasSpinner AS BOOLEAN = FALSE
    DIM hasTextArea AS BOOLEAN = FALSE

    DIM fi AS INTEGER
    FOR fi = 0 TO Len(proj.Forms) - 1
        DIM form AS VDBForm = proj.Forms[fi]
        DIM ci AS INTEGER
        FOR ci = 0 TO Len(form.Controls) - 1
            DIM ctrl AS VDBControl = form.Controls[ci]
            IF ctrl.CtlType = CTRL_TEXTBOX THEN
                hasTextBox = TRUE
            ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
                hasListBox = TRUE
            ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
                hasButton = TRUE
            ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
                hasCheckBox = TRUE
            ELSEIF ctrl.CtlType = CTRL_OPTION THEN
                hasOption = TRUE
            ELSEIF ctrl.CtlType = CTRL_FRAME THEN
                hasFrame = TRUE
            ELSEIF ctrl.CtlType = CTRL_HSCROLL THEN
                hasHScroll = TRUE
            ELSEIF ctrl.CtlType = CTRL_VSCROLL THEN
                hasVScroll = TRUE
            ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
                hasProgress = TRUE
            ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
                hasSpinner = TRUE
            ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
                hasTextArea = TRUE
            ENDIF
        NEXT
    NEXT

    code = code & "' ============================================" & Chr(10)
    code = code & "' Row Composition System" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' RowSegment type for tracking content at positions
    code = code & "' Segment of content at a specific X position in a row" & Chr(10)
    code = code & "TYPE RowSegment" & Chr(10)
    code = code & "    DIM X AS INTEGER       ' X position in the row" & Chr(10)
    code = code & "    DIM Content AS STRING  ' The content (may contain ANSI codes)" & Chr(10)
    code = code & "END TYPE" & Chr(10)
    code = code & Chr(10)

    ' ComposeRow - builds a row from segments sorted by X position
    code = code & "' Compose a row from segments, filling gaps with styled spaces" & Chr(10)
    code = code & "FUNCTION ComposeRow(segments AS []RowSegment, rowWidth AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM gapStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
    code = code & "    IF Len(segments) = 0 THEN" & Chr(10)
    code = code & "        RETURN gapStyle.Render(strings.Repeat(" & Chr(34) & " " & Chr(34) & ", rowWidth))" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Sort segments by X position (simple bubble sort)" & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    DIM j AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(segments) - 2" & Chr(10)
    code = code & "        FOR j = 0 TO Len(segments) - 2 - i" & Chr(10)
    code = code & "            IF segments[j].X > segments[j + 1].X THEN" & Chr(10)
    code = code & "                DIM temp AS RowSegment = segments[j]" & Chr(10)
    code = code & "                segments[j] = segments[j + 1]" & Chr(10)
    code = code & "                segments[j + 1] = temp" & Chr(10)
    code = code & "            ENDIF" & Chr(10)
    code = code & "        NEXT" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Build the row by placing segments at their positions" & Chr(10)
    code = code & "    DIM row AS STRING = " & Chr(34) & Chr(34) & Chr(10)
    code = code & "    DIM currentX AS INTEGER = 0" & Chr(10)
    code = code & Chr(10)
    code = code & "    FOR i = 0 TO Len(segments) - 1" & Chr(10)
    code = code & "        DIM seg AS RowSegment = segments[i]" & Chr(10)
    code = code & "        ' Add styled spaces to reach segment position" & Chr(10)
    code = code & "        IF seg.X > currentX THEN" & Chr(10)
    code = code & "            row = row & gapStyle.Render(strings.Repeat(" & Chr(34) & " " & Chr(34) & ", seg.X - currentX))" & Chr(10)
    code = code & "            currentX = seg.X" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "        ' Add the segment content" & Chr(10)
    code = code & "        row = row & seg.Content" & Chr(10)
    code = code & "        ' Update currentX using visual width (handles ANSI codes)" & Chr(10)
    code = code & "        currentX = currentX + lipgloss.Width(seg.Content)" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Pad to row width if needed with styled spaces" & Chr(10)
    code = code & "    IF currentX < rowWidth THEN" & Chr(10)
    code = code & "        row = row & gapStyle.Render(strings.Repeat(" & Chr(34) & " " & Chr(34) & ", rowWidth - currentX))" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN row" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' TruncateToWidth helper
    code = code & "' Truncate text to specified width" & Chr(10)
    code = code & "FUNCTION TruncateToWidth(text AS STRING, width AS INTEGER) AS STRING" & Chr(10)
    code = code & "    IF Len(text) <= width THEN" & Chr(10)
    code = code & "        RETURN text" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    RETURN Left(text, width)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' CenterText helper
    code = code & "' Center text within specified width" & Chr(10)
    code = code & "FUNCTION CenterText(text AS STRING, width AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM textLen AS INTEGER = Len(text)" & Chr(10)
    code = code & "    IF textLen >= width THEN" & Chr(10)
    code = code & "        RETURN Left(text, width)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM padding AS INTEGER = (width - textLen) / 2" & Chr(10)
    code = code & "    DIM rightPad AS INTEGER = width - textLen - padding" & Chr(10)
    code = code & "    RETURN strings.Repeat(" & Chr(34) & " " & Chr(34) & ", padding) & text & strings.Repeat(" & Chr(34) & " " & Chr(34) & ", rightPad)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' RenderLabel - render label with justification and colors
    code = code & "' Render label with justification (0=left, 1=center, 2=right) and colors" & Chr(10)
    code = code & "FUNCTION RenderLabel(text AS STRING, width AS INTEGER, justify AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
    code = code & "    DIM textLen AS INTEGER = Len(text)" & Chr(10)
    code = code & "    IF textLen > width THEN" & Chr(10)
    code = code & "        text = Left(text, width)" & Chr(10)
    code = code & "        textLen = width" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    DIM result AS STRING" & Chr(10)
    code = code & "    IF justify = 1 THEN" & Chr(10)
    code = code & "        ' Center" & Chr(10)
    code = code & "        result = CenterText(text, width)" & Chr(10)
    code = code & "    ELSEIF justify = 2 THEN" & Chr(10)
    code = code & "        ' Right" & Chr(10)
    code = code & "        result = strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width - textLen) & text" & Chr(10)
    code = code & "    ELSE" & Chr(10)
    code = code & "        ' Left (default)" & Chr(10)
    code = code & "        result = text & strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width - textLen)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    ' Apply colors" & Chr(10)
    code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
    code = code & "    RETURN style.Render(result)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' ============================================
    ' Single-row render functions
    ' ============================================
    code = code & "' ============================================" & Chr(10)
    code = code & "' Control Render Functions" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' RenderTextInput
    IF hasTextBox THEN
        code = code & "' Render text input with colors (returns styled string constrained to width)" & Chr(10)
        code = code & "FUNCTION RenderTextInput(ti AS textinput.Model, width AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM view AS STRING = ti.View()" & Chr(10)
        code = code & "    DIM lines AS []STRING = strings.Split(view, " & Chr(34) & Chr(10) & Chr(34) & ")" & Chr(10)
        code = code & "    IF Len(lines) > 0 THEN" & Chr(10)
        code = code & "        DIM line AS STRING = lines[0]" & Chr(10)
        code = code & "        ' Constrain to width and apply colors" & Chr(10)
        code = code & "        DIM style AS lipgloss.Style = lipgloss.NewStyle().MaxWidth(width).Width(width).Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "        RETURN style.Render(line)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM emptyStyle AS lipgloss.Style = lipgloss.NewStyle().Width(width).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN emptyStyle.Render(" & Chr(34) & Chr(34) & ")" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' Button rendering functions
    IF hasButton THEN
        ' Flat button (single row, centered text with background)
        code = code & "' Render flat button with centered text and colors" & Chr(10)
        code = code & "FUNCTION RenderFlatButton(caption AS STRING, width AS INTEGER, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM btnText AS STRING = CenterText(caption, width)" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        ' Invert colors when focused" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Background(lipgloss.Color(Str(fgColor))).Foreground(lipgloss.Color(Str(bgColor))).Bold(TRUE)" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Background(lipgloss.Color(Str(bgColor))).Foreground(lipgloss.Color(Str(fgColor)))" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN style.Render(btnText)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' Bordered button - top row
        code = code & "' Get top row of bordered button with colors" & Chr(10)
        code = code & "FUNCTION GetButtonTopRow(width AS INTEGER, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM border AS STRING = " & Chr(34) & "┌" & Chr(34) & " & strings.Repeat(" & Chr(34) & "─" & Chr(34) & ", width - 2) & " & Chr(34) & "┐" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(bgColor))).Background(lipgloss.Color(Str(fgColor))).Bold(TRUE)" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN style.Render(border)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' Bordered button - middle row with caption
        code = code & "' Get middle row of bordered button with centered caption and colors" & Chr(10)
        code = code & "FUNCTION GetButtonMiddleRow(caption AS STRING, width AS INTEGER, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM innerWidth AS INTEGER = width - 2" & Chr(10)
        code = code & "    DIM centeredText AS STRING = CenterText(caption, innerWidth)" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style" & Chr(10)
        code = code & "    DIM borderStyle AS lipgloss.Style" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        ' Invert colors when focused" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Background(lipgloss.Color(Str(fgColor))).Foreground(lipgloss.Color(Str(bgColor))).Bold(TRUE)" & Chr(10)
        code = code & "        borderStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(bgColor))).Background(lipgloss.Color(Str(fgColor))).Bold(TRUE)" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Background(lipgloss.Color(Str(bgColor))).Foreground(lipgloss.Color(Str(fgColor)))" & Chr(10)
        code = code & "        borderStyle = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN borderStyle.Render(" & Chr(34) & "│" & Chr(34) & ") & style.Render(centeredText) & borderStyle.Render(" & Chr(34) & "│" & Chr(34) & ")" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' Bordered button - bottom row
        code = code & "' Get bottom row of bordered button with colors" & Chr(10)
        code = code & "FUNCTION GetButtonBottomRow(width AS INTEGER, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM border AS STRING = " & Chr(34) & "└" & Chr(34) & " & strings.Repeat(" & Chr(34) & "─" & Chr(34) & ", width - 2) & " & Chr(34) & "┘" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(bgColor))).Background(lipgloss.Color(Str(fgColor))).Bold(TRUE)" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN style.Render(border)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' RenderCheckBox
    IF hasCheckBox THEN
        code = code & "' Render checkbox with colors (returns styled string)" & Chr(10)
        code = code & "FUNCTION RenderCheckBox(caption AS STRING, checked AS BOOLEAN, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM checkMark AS STRING" & Chr(10)
        code = code & "    IF checked THEN" & Chr(10)
        code = code & "        checkMark = " & Chr(34) & "[X] " & Chr(34) & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        checkMark = " & Chr(34) & "[ ] " & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM text AS STRING = checkMark & caption" & Chr(10)
        code = code & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        style = style.Bold(TRUE)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN style.Render(text)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' RenderOption
    IF hasOption THEN
        code = code & "' Render radio option with colors (returns styled string)" & Chr(10)
        code = code & "FUNCTION RenderOption(caption AS STRING, selected AS BOOLEAN, focused AS BOOLEAN, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM indicator AS STRING" & Chr(10)
        code = code & "    IF selected THEN" & Chr(10)
        code = code & "        indicator = " & Chr(34) & "(o) " & Chr(34) & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        indicator = " & Chr(34) & "( ) " & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM text AS STRING = indicator & caption" & Chr(10)
        code = code & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    IF focused THEN" & Chr(10)
        code = code & "        style = style.Bold(TRUE)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN style.Render(text)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' RenderHScroll
    IF hasHScroll THEN
        code = code & "' Render horizontal scrollbar with colors" & Chr(10)
        code = code & "FUNCTION RenderHScroll(value AS INTEGER, minVal AS INTEGER, maxVal AS INTEGER, width AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    IF width < 3 THEN" & Chr(10)
        code = code & "        RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM range AS INTEGER = maxVal - minVal" & Chr(10)
        code = code & "    IF range <= 0 THEN" & Chr(10)
        code = code & "        range = 1" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM trackWidth AS INTEGER = width - 2" & Chr(10)
        code = code & "    DIM pos AS INTEGER = ((value - minVal) * trackWidth) / range" & Chr(10)
        code = code & "    IF pos < 0 THEN" & Chr(10)
        code = code & "        pos = 0" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    IF pos >= trackWidth THEN" & Chr(10)
        code = code & "        pos = trackWidth - 1" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & Chr(10)
        code = code & "    DIM bar AS STRING = " & Chr(34) & "<" & Chr(34) & Chr(10)
        code = code & "    DIM i AS INTEGER" & Chr(10)
        code = code & "    FOR i = 0 TO trackWidth - 1" & Chr(10)
        code = code & "        IF i = pos THEN" & Chr(10)
        code = code & "            bar = bar & " & Chr(34) & "#" & Chr(34) & Chr(10)
        code = code & "        ELSE" & Chr(10)
        code = code & "            bar = bar & " & Chr(34) & "-" & Chr(34) & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "    NEXT" & Chr(10)
        code = code & "    bar = bar & " & Chr(34) & ">" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(bar)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' RenderProgress
    IF hasProgress THEN
        code = code & "' Render progress bar with colors" & Chr(10)
        code = code & "FUNCTION RenderProgress(value AS INTEGER, total AS INTEGER, width AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    IF width < 3 THEN" & Chr(10)
        code = code & "        RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    IF total <= 0 THEN" & Chr(10)
        code = code & "        total = 100" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM barWidth AS INTEGER = width - 2" & Chr(10)
        code = code & "    DIM filled AS INTEGER = (value * barWidth) / total" & Chr(10)
        code = code & "    IF filled > barWidth THEN" & Chr(10)
        code = code & "        filled = barWidth" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    IF filled < 0 THEN" & Chr(10)
        code = code & "        filled = 0" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM bar AS STRING = " & Chr(34) & "[" & Chr(34) & " & strings.Repeat(" & Chr(34) & "=" & Chr(34) & ", filled) & strings.Repeat(" & Chr(34) & " " & Chr(34) & ", barWidth - filled) & " & Chr(34) & "]" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(bar)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' RenderSpinner
    IF hasSpinner THEN
        code = code & "' Render spinner character with colors" & Chr(10)
        code = code & "FUNCTION RenderSpinner(spinStyle AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM frames AS []STRING = []STRING{" & Chr(34) & "|" & Chr(34) & ", " & Chr(34) & "/" & Chr(34) & ", " & Chr(34) & "-" & Chr(34) & ", " & Chr(34) & "\\\\" & Chr(34) & "}" & Chr(10)
        code = code & "    DIM idx AS INTEGER = spinStyle MOD 4" & Chr(10)
        code = code & "    IF idx < 0 THEN" & Chr(10)
        code = code & "        idx = 0" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(frames[idx])" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' ============================================
    ' Multi-row render functions (return content for specific row)
    ' ============================================
    code = code & "' ============================================" & Chr(10)
    code = code & "' Multi-Row Control Functions" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Frame border functions
    IF hasFrame THEN
        code = code & "' Get top border row of a frame with colors" & Chr(10)
        code = code & "FUNCTION GetFrameTopRow(caption AS STRING, width AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    IF width < 2 THEN" & Chr(10)
        code = code & "        RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM hLine AS STRING = " & Chr(34) & "─" & Chr(34) & Chr(10)
        code = code & "    DIM topLine AS STRING = " & Chr(34) & "┌" & Chr(34) & Chr(10)
        code = code & "    IF caption <> " & Chr(34) & Chr(34) & " THEN" & Chr(10)
        code = code & "        topLine = topLine & " & Chr(34) & " " & Chr(34) & " & caption & " & Chr(34) & " " & Chr(34) & Chr(10)
        code = code & "        DIM remaining AS INTEGER = width - 2 - Len(caption) - 2" & Chr(10)
        code = code & "        IF remaining > 0 THEN" & Chr(10)
        code = code & "            topLine = topLine & strings.Repeat(hLine, remaining)" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        topLine = topLine & strings.Repeat(hLine, width - 2)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    topLine = topLine & " & Chr(34) & "┐" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(topLine)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
        code = code & "' Get bottom border row of a frame with colors" & Chr(10)
        code = code & "FUNCTION GetFrameBottomRow(width AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    IF width < 2 THEN" & Chr(10)
        code = code & "        RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM hLine AS STRING = " & Chr(34) & "─" & Chr(34) & Chr(10)
        code = code & "    DIM border AS STRING = " & Chr(34) & "└" & Chr(34) & " & strings.Repeat(hLine, width - 2) & " & Chr(34) & "┘" & Chr(34) & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(border)" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
        code = code & "' Get middle row borders of a frame (left and right separately) with colors" & Chr(10)
        code = code & "FUNCTION GetFrameLeftBorder(fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(" & Chr(34) & "│" & Chr(34) & ")" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
        code = code & "' Get right border of a frame with colors" & Chr(10)
        code = code & "FUNCTION GetFrameRightBorder(fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN style.Render(" & Chr(34) & "│" & Chr(34) & ")" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' GetListBoxRow - render list items directly without using View()
    IF hasListBox THEN
        code = code & "' Get a specific row of a listbox with colors - renders items directly" & Chr(10)
        code = code & "FUNCTION GetListBoxRow(lst AS list.Model, width AS INTEGER, height AS INTEGER, rowIndex AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM normalStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    DIM selectedStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(bgColor))).Background(lipgloss.Color(Str(fgColor))).Bold(TRUE)" & Chr(10)
        code = code & "    DIM items AS []list.Item = lst.Items()" & Chr(10)
        code = code & "    DIM selectedIdx AS INTEGER = lst.Index()" & Chr(10)
        code = code & "    IF Len(items) = 0 THEN" & Chr(10)
        code = code & "        ' Empty list - show message on first row only" & Chr(10)
        code = code & "        IF rowIndex = 0 THEN" & Chr(10)
        code = code & "            DIM emptyMsg AS STRING = " & Chr(34) & "(empty)" & Chr(34) & Chr(10)
        code = code & "            IF lipgloss.Width(emptyMsg) < width THEN" & Chr(10)
        code = code & "                emptyMsg = emptyMsg & strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width - lipgloss.Width(emptyMsg))" & Chr(10)
        code = code & "            ENDIF" & Chr(10)
        code = code & "            RETURN normalStyle.Render(emptyMsg)" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "        RETURN normalStyle.Render(strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width))" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    IF rowIndex >= 0 AND rowIndex < Len(items) THEN" & Chr(10)
        code = code & "        DIM item AS list.Item = items[rowIndex]" & Chr(10)
        code = code & "        DIM title AS STRING = item.FilterValue()" & Chr(10)
        code = code & "        ' Highlight selected item" & Chr(10)
        code = code & "        IF rowIndex = selectedIdx THEN" & Chr(10)
        code = code & "            title = " & Chr(34) & "> " & Chr(34) & " & title" & Chr(10)
        code = code & "        ELSE" & Chr(10)
        code = code & "            title = " & Chr(34) & "  " & Chr(34) & " & title" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "        ' Pad or truncate to fit width" & Chr(10)
        code = code & "        DIM visWidth AS INTEGER = lipgloss.Width(title)" & Chr(10)
        code = code & "        IF visWidth < width THEN" & Chr(10)
        code = code & "            title = title & strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width - visWidth)" & Chr(10)
        code = code & "        ELSEIF visWidth > width THEN" & Chr(10)
        code = code & "            title = Left(title, width)" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "        IF rowIndex = selectedIdx THEN" & Chr(10)
        code = code & "            RETURN selectedStyle.Render(title)" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "        RETURN normalStyle.Render(title)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN normalStyle.Render(strings.Repeat(" & Chr(34) & " " & Chr(34) & ", width))" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' ListItem type for list.Model
        code = code & "' ListItem implements list.Item interface" & Chr(10)
        code = code & "TYPE ListItem IMPLEMENTS list.Item" & Chr(10)
        code = code & "    DIM name AS STRING" & Chr(10)
        code = code & "    DIM desc AS STRING" & Chr(10)
        code = code & "END TYPE" & Chr(10)
        code = code & Chr(10)
        code = code & "FUNCTION (i AS ListItem) Title() AS STRING" & Chr(10)
        code = code & "    RETURN i.name" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
        code = code & "FUNCTION (i AS ListItem) Description() AS STRING" & Chr(10)
        code = code & "    RETURN i.desc" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
        code = code & "FUNCTION (i AS ListItem) FilterValue() AS STRING" & Chr(10)
        code = code & "    RETURN i.name" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' AddListItem helper
        code = code & "' Add an item to a listbox" & Chr(10)
        code = code & "FUNCTION AddListItem(lst AS list.Model, text AS STRING) AS list.Model" & Chr(10)
        code = code & "    DIM item AS ListItem" & Chr(10)
        code = code & "    item.name = text" & Chr(10)
        code = code & "    item.desc = " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    lst.InsertItem(Len(lst.Items()), item)" & Chr(10)
        code = code & "    RETURN lst" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' GetSelectedListItem helper
        code = code & "' Get the text of the selected listbox item" & Chr(10)
        code = code & "FUNCTION GetSelectedListItem(lst AS list.Model) AS STRING" & Chr(10)
        code = code & "    DIM idx AS INTEGER = lst.Index()" & Chr(10)
        code = code & "    DIM items AS []list.Item = lst.Items()" & Chr(10)
        code = code & "    IF idx >= 0 AND idx < Len(items) THEN" & Chr(10)
        code = code & "        RETURN items[idx].FilterValue()" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)

        ' SetListIndex helper - moves cursor to target index
        code = code & "' Set list selection to target index using cursor movement" & Chr(10)
        code = code & "FUNCTION SetListIndex(lst AS list.Model, targetIdx AS INTEGER) AS list.Model" & Chr(10)
        code = code & "    DIM currentIdx AS INTEGER = lst.Index()" & Chr(10)
        code = code & "    DIM diff AS INTEGER = targetIdx - currentIdx" & Chr(10)
        code = code & "    DIM i AS INTEGER" & Chr(10)
        code = code & "    IF diff > 0 THEN" & Chr(10)
        code = code & "        FOR i = 0 TO diff - 1" & Chr(10)
        code = code & "            lst.CursorDown()" & Chr(10)
        code = code & "        NEXT" & Chr(10)
        code = code & "    ELSEIF diff < 0 THEN" & Chr(10)
        code = code & "        FOR i = 0 TO (-diff) - 1" & Chr(10)
        code = code & "            lst.CursorUp()" & Chr(10)
        code = code & "        NEXT" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    RETURN lst" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' GetTextAreaRow - render specific row of textarea
    IF hasTextArea THEN
        code = code & "' Get a specific row of a textarea with colors" & Chr(10)
        code = code & "FUNCTION GetTextAreaRow(ta AS textarea.Model, width AS INTEGER, height AS INTEGER, rowIndex AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    ' Get the full view and split by lines" & Chr(10)
        code = code & "    DIM view AS STRING = ta.View()" & Chr(10)
        code = code & "    DIM lines AS []STRING = strings.Split(view, " & Chr(34) & Chr(10) & Chr(34) & ")" & Chr(10)
        code = code & "    IF rowIndex >= 0 AND rowIndex < Len(lines) THEN" & Chr(10)
        code = code & "        DIM line AS STRING = lines[rowIndex]" & Chr(10)
        code = code & "        ' Constrain to width and apply colors" & Chr(10)
        code = code & "        DIM style AS lipgloss.Style = lipgloss.NewStyle().MaxWidth(width).Width(width).Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "        RETURN style.Render(line)" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM emptyStyle AS lipgloss.Style = lipgloss.NewStyle().Width(width).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    RETURN emptyStyle.Render(" & Chr(34) & Chr(34) & ")" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' NOTE: DirBrowser helpers are now generated by GenerateDirBrowserWidget()
    ' which creates the standalone DirBrowser TYPE with GetRow() method
    ' and DirBrowserListDirs() function

    ' GetVScrollRow
    IF hasVScroll THEN
        code = code & "' Get a specific row of a vertical scrollbar with colors" & Chr(10)
        code = code & "FUNCTION GetVScrollRow(value AS INTEGER, minVal AS INTEGER, maxVal AS INTEGER, height AS INTEGER, rowIndex AS INTEGER, fgColor AS INTEGER, bgColor AS INTEGER) AS STRING" & Chr(10)
        code = code & "    DIM style AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(fgColor))).Background(lipgloss.Color(Str(bgColor)))" & Chr(10)
        code = code & "    IF height < 3 THEN" & Chr(10)
        code = code & "        RETURN " & Chr(34) & Chr(34) & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & Chr(10)
        code = code & "    DIM range AS INTEGER = maxVal - minVal" & Chr(10)
        code = code & "    IF range <= 0 THEN" & Chr(10)
        code = code & "        range = 1" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    DIM trackHeight AS INTEGER = height - 2" & Chr(10)
        code = code & "    DIM thumbPos AS INTEGER = ((value - minVal) * trackHeight) / range" & Chr(10)
        code = code & "    IF thumbPos < 0 THEN" & Chr(10)
        code = code & "        thumbPos = 0" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "    IF thumbPos >= trackHeight THEN" & Chr(10)
        code = code & "        thumbPos = trackHeight - 1" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & Chr(10)
        code = code & "    IF rowIndex = 0 THEN" & Chr(10)
        code = code & "        RETURN style.Render(" & Chr(34) & "^" & Chr(34) & ")" & Chr(10)
        code = code & "    ELSEIF rowIndex = height - 1 THEN" & Chr(10)
        code = code & "        RETURN style.Render(" & Chr(34) & "v" & Chr(34) & ")" & Chr(10)
        code = code & "    ELSE" & Chr(10)
        code = code & "        DIM trackRow AS INTEGER = rowIndex - 1" & Chr(10)
        code = code & "        IF trackRow = thumbPos THEN" & Chr(10)
        code = code & "            RETURN style.Render(" & Chr(34) & "#" & Chr(34) & ")" & Chr(10)
        code = code & "        ELSE" & Chr(10)
        code = code & "            RETURN style.Render(" & Chr(34) & "|" & Chr(34) & ")" & Chr(10)
        code = code & "        ENDIF" & Chr(10)
        code = code & "    ENDIF" & Chr(10)
        code = code & "END FUNCTION" & Chr(10)
        code = code & Chr(10)
    ENDIF

    ' FormatInt helper
    code = code & "' Helper to use fmt package (avoids unused import)" & Chr(10)
    code = code & "FUNCTION FormatInt(n AS INTEGER) AS STRING" & Chr(10)
    code = code & "    RETURN fmt.Sprintf(" & Chr(34) & "%d" & Chr(34) & ", n)" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Generate focus management helpers
FUNCTION GenerateFocusHelpers(form AS VDBForm) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' ============================================" & Chr(10)
    code = code & "' Focus Management" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' CycleFocus
    code = code & "FUNCTION CycleFocus(m AS " & formTypeName & ", direction AS INTEGER) AS " & formTypeName & Chr(10)
    code = code & "    IF Len(m.FocusableControls) = 0 THEN" & Chr(10)
    code = code & "        RETURN m" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Clear current focus" & Chr(10)
    code = code & "    m = ClearFocus(m)" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Move to next/prev control" & Chr(10)
    code = code & "    m.FocusIndex = m.FocusIndex + direction" & Chr(10)
    code = code & "    IF m.FocusIndex >= Len(m.FocusableControls) THEN" & Chr(10)
    code = code & "        m.FocusIndex = 0" & Chr(10)
    code = code & "    ELSEIF m.FocusIndex < 0 THEN" & Chr(10)
    code = code & "        m.FocusIndex = Len(m.FocusableControls) - 1" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Set new focus" & Chr(10)
    code = code & "    m = SetFocus(m, m.FocusableControls[m.FocusIndex])" & Chr(10)
    code = code & Chr(10)
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' ClearFocus
    code = code & "FUNCTION ClearFocus(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            code = code & "    m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            code = code & "    m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_BUTTON OR ctrl.CtlType = CTRL_CHECKBOX OR ctrl.CtlType = CTRL_OPTION THEN
            code = code & "    m." & ctrl.CtlName & "_Focused = FALSE" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser uses widget Blur method
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path uses widget Blur method
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories uses widget Blur method
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files uses widget Blur method
            code = code & "    m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Blur()" & Chr(10)
        ENDIF
    NEXT
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' SetFocus
    code = code & "FUNCTION SetFocus(m AS " & formTypeName & ", name AS STRING) AS " & formTypeName & Chr(10)
    DIM first AS BOOLEAN = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            ' Listbox/combobox don't need special focus handling - they just get selected via FocusIndex
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        ' Listbox focus handled via FocusIndex" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_BUTTON OR ctrl.CtlType = CTRL_CHECKBOX OR ctrl.CtlType = CTRL_OPTION THEN
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & "_Focused = TRUE" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser uses widget Focus method
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path uses widget Focus method (returns 2 values)
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & ", _ = m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories uses widget Focus method
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files uses widget Focus method
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".Focus()" & Chr(10)
        ENDIF
    NEXT
    IF NOT first THEN
        code = code & "    ENDIF" & Chr(10)
    ENDIF
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' SetFocusIndex - set FocusIndex to match a control name
    code = code & "FUNCTION SetFocusIndex(m AS " & formTypeName & ", name AS STRING) AS " & formTypeName & Chr(10)
    code = code & "    DIM i AS INTEGER" & Chr(10)
    code = code & "    FOR i = 0 TO Len(m.FocusableControls) - 1" & Chr(10)
    code = code & "        IF m.FocusableControls[i] = name THEN" & Chr(10)
    code = code & "            m.FocusIndex = i" & Chr(10)
    code = code & "            RETURN m" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' GetFocusCmd - return the appropriate Blink command for the focused control
    code = code & "FUNCTION GetFocusCmd(m AS " & formTypeName & ") AS tea.Cmd" & Chr(10)
    code = code & "    IF Len(m.FocusableControls) = 0 OR m.FocusIndex < 0 OR m.FocusIndex >= Len(m.FocusableControls) THEN" & Chr(10)
    code = code & "        RETURN NIL" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    ' Check if we have any controls that need Blink command
    DIM hasFocusable AS BOOLEAN = FALSE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM chkCtrl AS VDBControl = form.Controls[i]
        IF chkCtrl.CtlType = CTRL_TEXTBOX OR chkCtrl.CtlType = CTRL_TEXTAREA OR chkCtrl.CtlType = CTRL_DIRBROWSER OR chkCtrl.CtlType = CTRL_PATH THEN
            hasFocusable = TRUE
        ENDIF
    NEXT
    IF hasFocusable THEN
        code = code & "    DIM focused AS STRING = m.FocusableControls[m.FocusIndex]" & Chr(10)
    ENDIF
    first = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TEXTBOX THEN
            IF first THEN
                code = code & "    IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        RETURN textinput.Blink" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
            IF first THEN
                code = code & "    IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        RETURN textarea.Blink" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser uses widget's pathInput field
            IF first THEN
                code = code & "    IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        ' Return Blink if path input is focused" & Chr(10)
            code = code & "        IF m." & ctrl.CtlName & ".pathInput.Focused() THEN" & Chr(10)
            code = code & "            RETURN textinput.Blink" & Chr(10)
            code = code & "        ENDIF" & Chr(10)
            code = code & "        RETURN NIL" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path uses widget's input field
            IF first THEN
                code = code & "    IF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF focused = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        RETURN textinput.Blink" & Chr(10)
        ENDIF
    NEXT
    IF NOT first THEN
        code = code & "    ENDIF" & Chr(10)
    ENDIF
    code = code & "    RETURN NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' GetTimerStartCmd - return timer.Init() if a timer was just started
    code = code & "FUNCTION GetTimerStartCmd(m AS " & formTypeName & ") AS tea.Cmd" & Chr(10)
    first = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_TIMER THEN
            IF first THEN
                code = code & "    IF m." & ctrl.CtlName & "_Running THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF m." & ctrl.CtlName & "_Running THEN" & Chr(10)
            ENDIF
            code = code & "        RETURN m." & ctrl.CtlName & ".Init()" & Chr(10)
        ENDIF
    NEXT
    IF NOT first THEN
        code = code & "    ENDIF" & Chr(10)
    ENDIF
    code = code & "    RETURN NIL" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' SelectOption - for radio button groups
    code = code & "FUNCTION SelectOption(m AS " & formTypeName & ", name AS STRING) AS " & formTypeName & Chr(10)
    code = code & "    ' Deselect all options, select the specified one" & Chr(10)
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_OPTION THEN
            code = code & "    m." & ctrl.CtlName & "_Selected = FALSE" & Chr(10)
        ENDIF
    NEXT
    first = TRUE
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_OPTION THEN
            IF first THEN
                code = code & "    IF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
                first = FALSE
            ELSE
                code = code & "    ELSEIF name = " & Chr(34) & ctrl.CtlName & Chr(34) & " THEN" & Chr(10)
            ENDIF
            code = code & "        m." & ctrl.CtlName & "_Selected = TRUE" & Chr(10)
        ENDIF
    NEXT
    IF NOT first THEN
        code = code & "    ENDIF" & Chr(10)
    ENDIF
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' linkedPath - set path for all widgets with a specific LinkedPath name
    code = code & "' linkedPath sets path for all widgets with the specified LinkedPath name" & Chr(10)
    code = code & "FUNCTION linkedPath(m AS " & formTypeName & ", name AS STRING, path AS STRING) AS " & formTypeName & Chr(10)
    code = code & "    ' Store in LinkedPaths arrays (find or add)" & Chr(10)
    code = code & "    DIM lpFound AS BOOLEAN = FALSE" & Chr(10)
    code = code & "    DIM lpIdx AS INTEGER" & Chr(10)
    code = code & "    FOR lpIdx = 0 TO Len(m.LinkedPathNames) - 1" & Chr(10)
    code = code & "        IF m.LinkedPathNames[lpIdx] = name THEN" & Chr(10)
    code = code & "            m.LinkedPathValues[lpIdx] = path" & Chr(10)
    code = code & "            lpFound = TRUE" & Chr(10)
    code = code & "        ENDIF" & Chr(10)
    code = code & "    NEXT" & Chr(10)
    code = code & "    IF NOT lpFound THEN" & Chr(10)
    code = code & "        m.LinkedPathNames = APPEND(m.LinkedPathNames, name)" & Chr(10)
    code = code & "        m.LinkedPathValues = APPEND(m.LinkedPathValues, path)" & Chr(10)
    code = code & "    ENDIF" & Chr(10)
    code = code & "    ' Sync all widgets with this LinkedPath" & Chr(10)
    code = code & "    m = _syncLinkedPath(m, name, path)" & Chr(10)
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' _syncLinkedPath - internal helper to update all widgets with a LinkedPath
    code = code & "' _syncLinkedPath updates all widgets with matching LinkedPath (checked at runtime)" & Chr(10)
    code = code & "FUNCTION _syncLinkedPath(m AS " & formTypeName & ", name AS STRING, path AS STRING) AS " & formTypeName & Chr(10)
    ' Generate code to check each Path/Directories/Files widget's LinkedPath at runtime
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF ctrl.CtlType = CTRL_PATH THEN
            code = code & "    IF m." & ctrl.CtlName & ".LinkedPath = name THEN" & Chr(10)
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(path)" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            code = code & "    IF m." & ctrl.CtlName & ".LinkedPath = name THEN" & Chr(10)
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(path)" & Chr(10)
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            code = code & "    IF m." & ctrl.CtlName & ".LinkedPath = name THEN" & Chr(10)
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(path)" & Chr(10)
            code = code & "        m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & Chr(10)
            code = code & "    ENDIF" & Chr(10)
        ENDIF
    NEXT
    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    RETURN code
END FUNCTION

' Extract and transform event handlers from form code
FUNCTION ExtractEventHandlers(form AS VDBForm) AS STRING
    DIM code AS STRING = ""
    DIM formTypeName AS STRING = form.Name & "Model"

    code = code & "' ============================================" & Chr(10)
    code = code & "' Event Handlers" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)

    ' Generate Form_Load handler (always present)
    code = code & "' Form_Load event" & Chr(10)
    code = code & "FUNCTION " & form.Name & "_Load(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

    ' Extract Form_Load content from form.Code
    ' Try formName_Load first (e.g., frmFileDialog_Load), then fall back to Form_Load
    DIM loadCode AS STRING = ExtractSubContent(form.Code, form.Name & "_Load")
    IF loadCode = "" THEN
        loadCode = ExtractSubContent(form.Code, "Form_Load")
    ENDIF
    IF loadCode <> "" THEN
        code = code & TransformEventCode(loadCode, form)
    ELSE
        code = code & "    ' Add initialization code here" & Chr(10)
    ENDIF

    code = code & "    RETURN m" & Chr(10)
    code = code & "END FUNCTION" & Chr(10)
    code = code & Chr(10)

    ' Generate handlers for each control that needs one
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]

        IF ctrl.CtlType = CTRL_BUTTON THEN
            ' Button_Click handler
            code = code & "' " & ctrl.CtlName & "_Click event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Click(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM clickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Click")
            IF clickCode <> "" THEN
                code = code & TransformEventCode(clickCode, form)
            ELSE
                code = code & "    ' Add click handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
            ' CheckBox_Click handler (also check for _Change for compatibility)
            code = code & "' " & ctrl.CtlName & "_Click event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Click(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM clickCodeChk AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Click")
            IF clickCodeChk = "" THEN
                clickCodeChk = ExtractSubContent(form.Code, ctrl.CtlName & "_Change")
            ENDIF
            IF clickCodeChk <> "" THEN
                code = code & TransformEventCode(clickCodeChk, form)
            ELSE
                code = code & "    ' Add click handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
            ' ListBox_Click handler
            code = code & "' " & ctrl.CtlName & "_Click event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Click(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM lstClickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Click")
            IF lstClickCode <> "" THEN
                code = code & TransformEventCode(lstClickCode, form)
            ELSE
                code = code & "    ' Add click handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_OPTION THEN
            ' Option_Click handler
            code = code & "' " & ctrl.CtlName & "_Click event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Click(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM optClickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Click")
            IF optClickCode <> "" THEN
                code = code & TransformEventCode(optClickCode, form)
            ELSE
                code = code & "    ' Add click handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_TIMER THEN
            ' Timer_Timer handler
            code = code & "' " & ctrl.CtlName & "_Timer event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Timer(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM timerCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Timer")
            IF timerCode <> "" THEN
                code = code & TransformEventCode(timerCode, form)
            ELSE
                code = code & "    ' Add timer handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
            ' DirBrowser_DirChange handler
            code = code & "' " & ctrl.CtlName & "_DirChange event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_DirChange(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM dirChangeCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_DirChange")
            IF dirChangeCode <> "" THEN
                code = code & TransformEventCode(dirChangeCode, form)
            ELSE
                code = code & "    ' Add DirChange handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' DirBrowser_PathChange handler
            code = code & "' " & ctrl.CtlName & "_PathChange event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_PathChange(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM pathChangeCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_PathChange")
            IF pathChangeCode <> "" THEN
                code = code & TransformEventCode(pathChangeCode, form)
            ELSE
                code = code & "    ' Add PathChange handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_PATH THEN
            ' Path_Change handler
            code = code & "' " & ctrl.CtlName & "_Change event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Change(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM pwChangeCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Change")
            IF pwChangeCode <> "" THEN
                code = code & TransformEventCode(pwChangeCode, form)
            ELSE
                code = code & "    ' Add Change handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Path_Enter handler
            code = code & "' " & ctrl.CtlName & "_Enter event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Enter(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM pwEnterCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Enter")
            IF pwEnterCode <> "" THEN
                code = code & TransformEventCode(pwEnterCode, form)
            ELSE
                code = code & "    ' Add Enter handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Path_DblClick handler
            code = code & "' " & ctrl.CtlName & "_DblClick event (fired when path is double-clicked or Enter pressed)" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_DblClick(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM pwDblClickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_DblClick")
            IF pwDblClickCode <> "" THEN
                code = code & TransformEventCode(pwDblClickCode, form)
            ELSE
                code = code & "    ' Add DblClick handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
            ' Directories_Change handler
            code = code & "' " & ctrl.CtlName & "_Change event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Change(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM dwChangeCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Change")
            IF dwChangeCode <> "" THEN
                code = code & TransformEventCode(dwChangeCode, form)
            ELSE
                code = code & "    ' Add Change handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Directories_Enter handler
            code = code & "' " & ctrl.CtlName & "_Enter event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Enter(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM dwEnterCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Enter")
            IF dwEnterCode <> "" THEN
                code = code & TransformEventCode(dwEnterCode, form)
            ELSE
                code = code & "    ' Add Enter handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Directories_DblClick handler
            code = code & "' " & ctrl.CtlName & "_DblClick event (fired when directory is double-clicked)" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_DblClick(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM dwDblClickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_DblClick")
            IF dwDblClickCode <> "" THEN
                code = code & TransformEventCode(dwDblClickCode, form)
            ELSE
                code = code & "    ' Add DblClick handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ELSEIF ctrl.CtlType = CTRL_FILES THEN
            ' Files_Change handler
            code = code & "' " & ctrl.CtlName & "_Change event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Change(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM fwChangeCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Change")
            IF fwChangeCode <> "" THEN
                code = code & TransformEventCode(fwChangeCode, form)
            ELSE
                code = code & "    ' Add Change handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Files_Enter handler
            code = code & "' " & ctrl.CtlName & "_Enter event" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_Enter(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM fwEnterCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_Enter")
            IF fwEnterCode <> "" THEN
                code = code & TransformEventCode(fwEnterCode, form)
            ELSE
                code = code & "    ' Add Enter handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)

            ' Files_DblClick handler
            code = code & "' " & ctrl.CtlName & "_DblClick event (fired when file is double-clicked)" & Chr(10)
            code = code & "FUNCTION " & ctrl.CtlName & "_DblClick(m AS " & formTypeName & ") AS " & formTypeName & Chr(10)

            DIM fwDblClickCode AS STRING = ExtractSubContent(form.Code, ctrl.CtlName & "_DblClick")
            IF fwDblClickCode <> "" THEN
                code = code & TransformEventCode(fwDblClickCode, form)
            ELSE
                code = code & "    ' Add DblClick handler code here" & Chr(10)
            ENDIF

            code = code & "    RETURN m" & Chr(10)
            code = code & "END FUNCTION" & Chr(10)
            code = code & Chr(10)
        ENDIF
    NEXT

    RETURN code
END FUNCTION

' Extract content between SUB name() and END SUB
FUNCTION ExtractSubContent(code AS STRING, subName AS STRING) AS STRING
    ' Find SUB subName()
    DIM startMarker AS STRING = "SUB " & subName & "()"
    DIM startPos AS INTEGER = InStrPos(1, code, startMarker)
    IF startPos = 0 THEN
        RETURN ""
    ENDIF

    ' Skip past the SUB line
    DIM afterStart AS INTEGER = InStrPos(startPos, code, Chr(10))
    IF afterStart = 0 THEN
        RETURN ""
    ENDIF

    ' Find END SUB
    DIM endPos AS INTEGER = InStrPos(afterStart, code, "END SUB")
    IF endPos = 0 THEN
        RETURN ""
    ENDIF

    ' Extract content between
    DIM content AS STRING = Mid(code, afterStart + 1, endPos - afterStart - 1)
    RETURN content
END FUNCTION

' Transform VB-style event code to BubbleTea model-passing style
FUNCTION TransformEventCode(code AS STRING, form AS VDBForm) AS STRING
    ' Get module-level variables for this form
    DIM moduleVars AS []STRING = ExtractModuleVariables(form.Code, form)

    ' Process line by line to handle assignment patterns
    DIM lines AS []STRING = SplitStr(code, Chr(10))
    DIM result AS STRING = ""
    DIM i AS INTEGER

    FOR i = 0 TO Len(lines) - 1
        DIM line AS STRING = lines[i]
        DIM trimmedLine AS STRING = TrimStr(line)

        IF trimmedLine <> "" THEN
        ' Transform each control reference in the line
        DIM j AS INTEGER
        FOR j = 0 TO Len(form.Controls) - 1
            DIM ctrl AS VDBControl = form.Controls[j]

            IF ctrl.CtlType = CTRL_TEXTBOX THEN
                ' Handle SetText method call: txtName.SetText(x) -> m.txtName.SetValue(x)
                DIM setTextPattern AS STRING = ctrl.CtlName & ".SetText("
                DIM setTextPos AS INTEGER = InStrPos(1, line, setTextPattern)
                IF setTextPos > 0 THEN
                    ' Transform txtName.SetText(...) -> m.txtName.SetValue(...)
                    line = ReplaceAll(line, ctrl.CtlName & ".SetText(", "m." & ctrl.CtlName & ".SetValue(")
                ENDIF
                ' Handle Text property assignment: txtName.Text = "x" -> m.txtName.SetValue("x")
                DIM setPattern2 AS STRING = ctrl.CtlName & ".Text = "
                DIM pos2 AS INTEGER = InStrPos(1, line, setPattern2)
                IF pos2 > 0 THEN
                    DIM beforeSet2 AS STRING = Left(line, pos2 - 1)
                    DIM afterSet2 AS STRING = Mid(line, pos2 + Len(setPattern2), Len(line))
                    line = beforeSet2 & "m." & ctrl.CtlName & ".SetValue(" & afterSet2 & ")"
                ELSE
                    ' Read access: txtName.Text -> m.txtName.Value()
                    line = ReplaceAll(line, ctrl.CtlName & ".Text", "m." & ctrl.CtlName & ".Value()")
                ENDIF
            ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
                ' Handle SetText method call: txtName.SetText(x) -> m.txtName.SetValue(x)
                DIM taSetTextPattern AS STRING = ctrl.CtlName & ".SetText("
                DIM taSetTextPos AS INTEGER = InStrPos(1, line, taSetTextPattern)
                IF taSetTextPos > 0 THEN
                    ' Transform txtName.SetText(...) -> m.txtName.SetValue(...)
                    line = ReplaceAll(line, ctrl.CtlName & ".SetText(", "m." & ctrl.CtlName & ".SetValue(")
                ENDIF
                ' Handle Text property assignment: txtName.Text = "x" -> m.txtName.SetValue("x")
                DIM taSetPattern AS STRING = ctrl.CtlName & ".Text = "
                DIM taSetPos AS INTEGER = InStrPos(1, line, taSetPattern)
                IF taSetPos > 0 THEN
                    DIM beforeTaSet AS STRING = Left(line, taSetPos - 1)
                    DIM afterTaSet AS STRING = Mid(line, taSetPos + Len(taSetPattern), Len(line))
                    line = beforeTaSet & "m." & ctrl.CtlName & ".SetValue(" & afterTaSet & ")"
                ELSE
                    ' Read access: txtName.Text -> m.txtName.Value()
                    line = ReplaceAll(line, ctrl.CtlName & ".Text", "m." & ctrl.CtlName & ".Value()")
                ENDIF
            ELSEIF ctrl.CtlType = CTRL_LABEL THEN
                ' lblName.Caption -> m.lblName_Text
                line = ReplaceAll(line, ctrl.CtlName & ".Caption", "m." & ctrl.CtlName & "_Text")
            ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
                ' chkName.Value -> m.chkName_Checked
                line = ReplaceAll(line, ctrl.CtlName & ".Value", "m." & ctrl.CtlName & "_Checked")
                ' chkName.Checked -> m.chkName_Checked
                line = ReplaceAll(line, ctrl.CtlName & ".Checked", "m." & ctrl.CtlName & "_Checked")
            ELSEIF ctrl.CtlType = CTRL_OPTION THEN
                ' optName.Value -> m.optName_Selected
                line = ReplaceAll(line, ctrl.CtlName & ".Value", "m." & ctrl.CtlName & "_Selected")
                ' optName.Selected -> m.optName_Selected
                line = ReplaceAll(line, ctrl.CtlName & ".Selected", "m." & ctrl.CtlName & "_Selected")
            ELSEIF ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX THEN
                ' Handle AddItem: lstName.AddItem("text") -> m.lstName = AddListItem(m.lstName, "text")
                DIM addItemPattern AS STRING = ctrl.CtlName & ".AddItem("
                DIM addItemPos AS INTEGER = InStrPos(1, line, addItemPattern)
                IF addItemPos > 0 THEN
                    DIM beforeAdd AS STRING = Left(line, addItemPos - 1)
                    DIM afterAdd AS STRING = Mid(line, addItemPos + Len(addItemPattern), Len(line))
                    ' Find the closing paren
                    DIM closeParen AS INTEGER = InStrPos(1, afterAdd, ")")
                    IF closeParen > 0 THEN
                        DIM itemArg AS STRING = Left(afterAdd, closeParen - 1)
                        line = beforeAdd & "m." & ctrl.CtlName & " = AddListItem(m." & ctrl.CtlName & ", " & itemArg & ")"
                    ENDIF
                ENDIF
                ' Handle lstName.SelectedIndex assignment specially
                ' lstName.SelectedIndex = -1 or 0 -> m.lstName.ResetSelected()
                ' Note: SELECT is a reserved word in BASIC so we can't call Select() directly
                DIM selIdxSetPattern AS STRING = ctrl.CtlName & ".SelectedIndex = "
                DIM selIdxSetPos AS INTEGER = InStrPos(1, line, selIdxSetPattern)
                IF selIdxSetPos > 0 THEN
                    DIM beforeSelIdx AS STRING = Left(line, selIdxSetPos - 1)
                    DIM afterSelIdx AS STRING = TrimStr(Mid(line, selIdxSetPos + Len(selIdxSetPattern), Len(line)))
                    ' Use ResetSelected() for -1 or 0 (most common reset cases)
                    IF afterSelIdx = "-1" OR afterSelIdx = "0" THEN
                        line = beforeSelIdx & "m." & ctrl.CtlName & ".ResetSelected()"
                    ELSE
                        ' For other values, also use ResetSelected (best available workaround)
                        line = beforeSelIdx & "m." & ctrl.CtlName & ".ResetSelected() ' Note: setting to " & afterSelIdx & " not supported"
                    ENDIF
                ELSE
                    ' lstName.SelectedIndex -> m.lstName.Index() (for reading)
                    line = ReplaceAll(line, ctrl.CtlName & ".SelectedIndex", "m." & ctrl.CtlName & ".Index()")
                ENDIF
                ' lstName.SelectedItem -> GetSelectedListItem(m.lstName)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedItem", "GetSelectedListItem(m." & ctrl.CtlName & ")")
            ELSEIF ctrl.CtlType = CTRL_TIMER THEN
                ' timerName.Enabled -> m.timerName_Running
                line = ReplaceAll(line, ctrl.CtlName & ".Enabled", "m." & ctrl.CtlName & "_Running")
                ' timerName.Interval assignments are skipped (set at initialization)
                IF InStrPos(1, line, ctrl.CtlName & ".Interval") > 0 THEN
                    line = "' Timer interval set at initialization"
                ENDIF
            ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
                ' Handle progress value assignment with string-to-int conversion
                DIM progSetPattern AS STRING = ctrl.CtlName & ".Value = "
                DIM progSetPos AS INTEGER = InStrPos(1, line, progSetPattern)
                IF progSetPos > 0 THEN
                    DIM beforeProgSet AS STRING = Left(line, progSetPos - 1)
                    DIM afterProgSet AS STRING = TrimStr(Mid(line, progSetPos + Len(progSetPattern), Len(line)))
                    ' Convert string literal to integer if needed
                    IF Left(afterProgSet, 1) = Chr(34) THEN
                        ' String literal like "0" -> just extract the number
                        DIM endQuote AS INTEGER = InStrPos(2, afterProgSet, Chr(34))
                        IF endQuote > 0 THEN
                            DIM strVal AS STRING = Mid(afterProgSet, 2, endQuote - 2)
                            line = beforeProgSet & "m." & ctrl.CtlName & "_Value = " & strVal
                        ENDIF
                    ELSEIF Left(afterProgSet, 4) = "Str(" THEN
                        ' Str(x) -> just x (already an integer)
                        DIM endParen AS INTEGER = InStrPos(1, afterProgSet, ")")
                        IF endParen > 0 THEN
                            DIM intExpr AS STRING = Mid(afterProgSet, 5, endParen - 5)
                            line = beforeProgSet & "m." & ctrl.CtlName & "_Value = " & intExpr
                        ENDIF
                    ELSE
                        ' Direct integer assignment - also transform any RHS references
                        afterProgSet = ReplaceAll(afterProgSet, ctrl.CtlName & ".Value", "m." & ctrl.CtlName & "_Value")
                        line = beforeProgSet & "m." & ctrl.CtlName & "_Value = " & afterProgSet
                    ENDIF
                ELSE
                    ' Read access or other patterns
                    line = ReplaceAll(line, ctrl.CtlName & ".Value", "m." & ctrl.CtlName & "_Value")
                ENDIF
                ' prgName.Total -> m.prgName_Total
                line = ReplaceAll(line, ctrl.CtlName & ".Total", "m." & ctrl.CtlName & "_Total")
            ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
                ' spnName.Visible -> m.spnName_Visible
                line = ReplaceAll(line, ctrl.CtlName & ".Visible", "m." & ctrl.CtlName & "_Visible")
                ' spnName.SpinnerStyle -> m.spnName_Style
                line = ReplaceAll(line, ctrl.CtlName & ".SpinnerStyle", "m." & ctrl.CtlName & "_Style")
                ' spnName.Style -> m.spnName_Style
                line = ReplaceAll(line, ctrl.CtlName & ".Style", "m." & ctrl.CtlName & "_Style")
            ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
                ' DirBrowser widget property transformations
                ' Handle Path assignment: uses widget SetPath() method
                DIM dbPathSetPattern AS STRING = ctrl.CtlName & ".Path = "
                DIM dbPathSetPos AS INTEGER = InStrPos(1, line, dbPathSetPattern)
                IF dbPathSetPos > 0 THEN
                    ' This is a Path assignment - use widget SetPath method
                    DIM beforeDbSet AS STRING = Left(line, dbPathSetPos - 1)
                    DIM afterDbSet AS STRING = TrimStr(Mid(line, dbPathSetPos + Len(dbPathSetPattern), Len(line)))
                    ' Transform any control references in the RHS
                    afterDbSet = ReplaceAll(afterDbSet, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                    line = beforeDbSet & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & afterDbSet & ")"
                ELSE
                    ' Read access - use GetPath() method
                    line = ReplaceAll(line, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                ENDIF
                ' dbName.Dirs -> m.dbName.dirs
                line = ReplaceAll(line, ctrl.CtlName & ".Dirs", "m." & ctrl.CtlName & ".dirs")
                ' dbName.Selected -> m.dbName.selected
                line = ReplaceAll(line, ctrl.CtlName & ".Selected", "m." & ctrl.CtlName & ".selected")
                ' dbName.SelectedDir() -> m.dbName.SelectedDir (property, remove parens)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedDir()", "m." & ctrl.CtlName & ".SelectedDir")
                ' dbName.SelectedDir -> m.dbName.SelectedDir (property)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedDir", "m." & ctrl.CtlName & ".SelectedDir")
                ' Handle SetPath method call: xDirBrowser.SetPath(...) -> m.xDirBrowser = m.xDirBrowser.SetPath(...)
                DIM dbSetPathPattern AS STRING = ctrl.CtlName & ".SetPath("
                DIM dbSetPathPos AS INTEGER = InStrPos(1, line, dbSetPathPattern)
                IF dbSetPathPos > 0 THEN
                    DIM beforeDbSP AS STRING = Left(line, dbSetPathPos - 1)
                    DIM afterDbSP AS STRING = Mid(line, dbSetPathPos + Len(dbSetPathPattern), Len(line))
                    DIM dbCloseParen AS INTEGER = InStrPos(1, afterDbSP, ")")
                    IF dbCloseParen > 0 THEN
                        DIM dbSPArg AS STRING = Left(afterDbSP, dbCloseParen - 1)
                        DIM dbSPRest AS STRING = Mid(afterDbSP, dbCloseParen + 1, Len(afterDbSP))
                        line = beforeDbSP & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & dbSPArg & ")" & dbSPRest
                    ENDIF
                ENDIF
                ' Handle View method call: xDirBrowser.View() -> m.xDirBrowser = m.xDirBrowser.View()
                DIM dbViewPattern AS STRING = ctrl.CtlName & ".View()"
                DIM dbViewPos AS INTEGER = InStrPos(1, line, dbViewPattern)
                IF dbViewPos > 0 THEN
                    DIM beforeDbView AS STRING = Left(line, dbViewPos - 1)
                    DIM afterDbView AS STRING = Mid(line, dbViewPos + Len(dbViewPattern), Len(line))
                    line = beforeDbView & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & afterDbView
                ENDIF
            ELSEIF ctrl.CtlType = CTRL_PATH THEN
                ' Path widget property and method transformations
                ' Handle LinkedPath assignment: xPath.LinkedPath = "name" -> m.xPath.LinkedPath = "name"
                DIM pwLPSetPattern AS STRING = ctrl.CtlName & ".LinkedPath = "
                DIM pwLPSetPos AS INTEGER = InStrPos(1, line, pwLPSetPattern)
                IF pwLPSetPos > 0 THEN
                    DIM beforePwLP AS STRING = Left(line, pwLPSetPos - 1)
                    DIM afterPwLP AS STRING = Mid(line, pwLPSetPos + Len(pwLPSetPattern), Len(line))
                    line = beforePwLP & "m." & ctrl.CtlName & ".LinkedPath = " & afterPwLP
                ELSE
                    ' Read access
                    line = ReplaceAll(line, ctrl.CtlName & ".LinkedPath", "m." & ctrl.CtlName & ".LinkedPath")
                ENDIF
                ' Handle SetPath method call: xPath.SetPath(...) -> m.xPath = m.xPath.SetPath(...)
                DIM pwSetPathPattern AS STRING = ctrl.CtlName & ".SetPath("
                DIM pwSetPathPos AS INTEGER = InStrPos(1, line, pwSetPathPattern)
                IF pwSetPathPos > 0 THEN
                    DIM beforePwSP AS STRING = Left(line, pwSetPathPos - 1)
                    DIM afterPwSP AS STRING = Mid(line, pwSetPathPos + Len(pwSetPathPattern), Len(line))
                    ' Find closing paren to get the argument
                    DIM pwCloseParen AS INTEGER = InStrPos(1, afterPwSP, ")")
                    IF pwCloseParen > 0 THEN
                        DIM pwSPArg AS STRING = Left(afterPwSP, pwCloseParen - 1)
                        DIM pwSPRest AS STRING = Mid(afterPwSP, pwCloseParen + 1, Len(afterPwSP))
                        line = beforePwSP & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & pwSPArg & ")" & pwSPRest
                    ENDIF
                ENDIF
                ' Handle View method call: xPath.View() -> m.xPath = m.xPath.View()
                DIM pwViewPattern AS STRING = ctrl.CtlName & ".View()"
                DIM pwViewPos AS INTEGER = InStrPos(1, line, pwViewPattern)
                IF pwViewPos > 0 THEN
                    DIM beforePwView AS STRING = Left(line, pwViewPos - 1)
                    DIM afterPwView AS STRING = Mid(line, pwViewPos + Len(pwViewPattern), Len(line))
                    line = beforePwView & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & afterPwView
                ENDIF
                ' Handle Path assignment: uses widget SetPath() method
                DIM pwPathSetPattern AS STRING = ctrl.CtlName & ".Path = "
                DIM pwPathSetPos AS INTEGER = InStrPos(1, line, pwPathSetPattern)
                IF pwPathSetPos > 0 THEN
                    ' This is a Path assignment - use widget SetPath method
                    DIM beforePwSet AS STRING = Left(line, pwPathSetPos - 1)
                    DIM afterPwSet AS STRING = TrimStr(Mid(line, pwPathSetPos + Len(pwPathSetPattern), Len(line)))
                    ' Transform any control references in the RHS
                    afterPwSet = ReplaceAll(afterPwSet, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                    line = beforePwSet & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & afterPwSet & ")"
                ELSE
                    ' Read access - use GetPath() method
                    line = ReplaceAll(line, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                ENDIF
            ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
                ' Directories widget property and method transformations
                ' Handle LinkedPath assignment: xDir.LinkedPath = "name" -> m.xDir.LinkedPath = "name"
                DIM dwLPSetPattern AS STRING = ctrl.CtlName & ".LinkedPath = "
                DIM dwLPSetPos AS INTEGER = InStrPos(1, line, dwLPSetPattern)
                IF dwLPSetPos > 0 THEN
                    DIM beforeDwLP AS STRING = Left(line, dwLPSetPos - 1)
                    DIM afterDwLP AS STRING = Mid(line, dwLPSetPos + Len(dwLPSetPattern), Len(line))
                    line = beforeDwLP & "m." & ctrl.CtlName & ".LinkedPath = " & afterDwLP
                ELSE
                    ' Read access
                    line = ReplaceAll(line, ctrl.CtlName & ".LinkedPath", "m." & ctrl.CtlName & ".LinkedPath")
                ENDIF
                ' Handle SetPath method call: xDir.SetPath(...) -> m.xDir = m.xDir.SetPath(...)
                DIM dwSetPathPattern AS STRING = ctrl.CtlName & ".SetPath("
                DIM dwSetPathPos AS INTEGER = InStrPos(1, line, dwSetPathPattern)
                IF dwSetPathPos > 0 THEN
                    DIM beforeDwSP AS STRING = Left(line, dwSetPathPos - 1)
                    DIM afterDwSP AS STRING = Mid(line, dwSetPathPos + Len(dwSetPathPattern), Len(line))
                    ' Find closing paren to get the argument
                    DIM dwCloseParen AS INTEGER = InStrPos(1, afterDwSP, ")")
                    IF dwCloseParen > 0 THEN
                        DIM dwSPArg AS STRING = Left(afterDwSP, dwCloseParen - 1)
                        DIM dwSPRest AS STRING = Mid(afterDwSP, dwCloseParen + 1, Len(afterDwSP))
                        line = beforeDwSP & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & dwSPArg & ")" & dwSPRest
                    ENDIF
                ENDIF
                ' Handle View method call: xDir.View() -> m.xDir = m.xDir.View()
                DIM dwViewPattern AS STRING = ctrl.CtlName & ".View()"
                DIM dwViewPos AS INTEGER = InStrPos(1, line, dwViewPattern)
                IF dwViewPos > 0 THEN
                    DIM beforeDwView AS STRING = Left(line, dwViewPos - 1)
                    DIM afterDwView AS STRING = Mid(line, dwViewPos + Len(dwViewPattern), Len(line))
                    line = beforeDwView & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & afterDwView
                ENDIF
                ' Handle Path assignment: uses widget SetPath() method
                DIM dwPathSetPattern AS STRING = ctrl.CtlName & ".Path = "
                DIM dwPathSetPos AS INTEGER = InStrPos(1, line, dwPathSetPattern)
                IF dwPathSetPos > 0 THEN
                    ' This is a Path assignment - use widget SetPath method
                    DIM beforeDwSet AS STRING = Left(line, dwPathSetPos - 1)
                    DIM afterDwSet AS STRING = TrimStr(Mid(line, dwPathSetPos + Len(dwPathSetPattern), Len(line)))
                    ' Transform any control references in the RHS
                    afterDwSet = ReplaceAll(afterDwSet, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                    line = beforeDwSet & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & afterDwSet & ")"
                ELSE
                    ' Read access - use GetPath() method
                    line = ReplaceAll(line, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                ENDIF
                ' dirName.Dirs -> m.dirName.dirs
                line = ReplaceAll(line, ctrl.CtlName & ".Dirs", "m." & ctrl.CtlName & ".dirs")
                ' dirName.SelectedDir() -> m.dirName.SelectedDir (property, remove parens)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedDir()", "m." & ctrl.CtlName & ".SelectedDir")
                ' dirName.SelectedDir -> m.dirName.SelectedDir (property, must be before .Selected)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedDir", "m." & ctrl.CtlName & ".SelectedDir")
                ' dirName.Selected -> m.dirName.selected
                line = ReplaceAll(line, ctrl.CtlName & ".Selected", "m." & ctrl.CtlName & ".selected")
            ELSEIF ctrl.CtlType = CTRL_FILES THEN
                ' Files widget property and method transformations
                ' Handle LinkedPath assignment: xFiles.LinkedPath = "name" -> m.xFiles.LinkedPath = "name"
                DIM fwLPSetPattern AS STRING = ctrl.CtlName & ".LinkedPath = "
                DIM fwLPSetPos AS INTEGER = InStrPos(1, line, fwLPSetPattern)
                IF fwLPSetPos > 0 THEN
                    DIM beforeFwLP AS STRING = Left(line, fwLPSetPos - 1)
                    DIM afterFwLP AS STRING = Mid(line, fwLPSetPos + Len(fwLPSetPattern), Len(line))
                    line = beforeFwLP & "m." & ctrl.CtlName & ".LinkedPath = " & afterFwLP
                ELSE
                    ' Read access
                    line = ReplaceAll(line, ctrl.CtlName & ".LinkedPath", "m." & ctrl.CtlName & ".LinkedPath")
                ENDIF
                ' Handle SetPath method call: xFiles.SetPath(...) -> m.xFiles = m.xFiles.SetPath(...)
                DIM fwSetPathPattern AS STRING = ctrl.CtlName & ".SetPath("
                DIM fwSetPathPos AS INTEGER = InStrPos(1, line, fwSetPathPattern)
                IF fwSetPathPos > 0 THEN
                    DIM beforeFwSP AS STRING = Left(line, fwSetPathPos - 1)
                    DIM afterFwSP AS STRING = Mid(line, fwSetPathPos + Len(fwSetPathPattern), Len(line))
                    DIM fwCloseParen AS INTEGER = InStrPos(1, afterFwSP, ")")
                    IF fwCloseParen > 0 THEN
                        DIM fwSPArg AS STRING = Left(afterFwSP, fwCloseParen - 1)
                        DIM fwSPRest AS STRING = Mid(afterFwSP, fwCloseParen + 1, Len(afterFwSP))
                        line = beforeFwSP & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & fwSPArg & ")" & fwSPRest
                    ENDIF
                ENDIF
                ' Handle SetPattern method call: xFiles.SetPattern(...) -> m.xFiles = m.xFiles.SetPattern(...)
                DIM fwSetPatternPattern AS STRING = ctrl.CtlName & ".SetPattern("
                DIM fwSetPatternPos AS INTEGER = InStrPos(1, line, fwSetPatternPattern)
                IF fwSetPatternPos > 0 THEN
                    DIM beforeFwPat AS STRING = Left(line, fwSetPatternPos - 1)
                    DIM afterFwPat AS STRING = Mid(line, fwSetPatternPos + Len(fwSetPatternPattern), Len(line))
                    DIM fwPatCloseParen AS INTEGER = InStrPos(1, afterFwPat, ")")
                    IF fwPatCloseParen > 0 THEN
                        DIM fwPatArg AS STRING = Left(afterFwPat, fwPatCloseParen - 1)
                        DIM fwPatRest AS STRING = Mid(afterFwPat, fwPatCloseParen + 1, Len(afterFwPat))
                        line = beforeFwPat & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPattern(" & fwPatArg & ")" & fwPatRest
                    ENDIF
                ENDIF
                ' Handle View method call: xFiles.View() -> m.xFiles = m.xFiles.View()
                DIM fwViewPattern AS STRING = ctrl.CtlName & ".View()"
                DIM fwViewPos AS INTEGER = InStrPos(1, line, fwViewPattern)
                IF fwViewPos > 0 THEN
                    DIM beforeFwView AS STRING = Left(line, fwViewPos - 1)
                    DIM afterFwView AS STRING = Mid(line, fwViewPos + Len(fwViewPattern), Len(line))
                    line = beforeFwView & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".View()" & afterFwView
                ENDIF
                ' Handle Path assignment: uses widget SetPath() method
                DIM fwPathSetPattern AS STRING = ctrl.CtlName & ".Path = "
                DIM fwPathSetPos AS INTEGER = InStrPos(1, line, fwPathSetPattern)
                IF fwPathSetPos > 0 THEN
                    DIM beforeFwSet AS STRING = Left(line, fwPathSetPos - 1)
                    DIM afterFwSet AS STRING = TrimStr(Mid(line, fwPathSetPos + Len(fwPathSetPattern), Len(line)))
                    afterFwSet = ReplaceAll(afterFwSet, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                    line = beforeFwSet & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPath(" & afterFwSet & ")"
                ELSE
                    ' Read access - use GetPath() method
                    line = ReplaceAll(line, ctrl.CtlName & ".Path", "m." & ctrl.CtlName & ".GetPath()")
                ENDIF
                ' fileName.Files -> m.fileName.files
                line = ReplaceAll(line, ctrl.CtlName & ".Files", "m." & ctrl.CtlName & ".files")
                ' fileName.SelectedFile() -> m.fileName.SelectedFile (property, remove parens)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedFile()", "m." & ctrl.CtlName & ".SelectedFile")
                ' fileName.SelectedFile -> m.fileName.SelectedFile (property, must be before .Selected)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedFile", "m." & ctrl.CtlName & ".SelectedFile")
                ' fileName.SelectedFilePath() -> m.fileName.SelectedFilePath (property, remove parens)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedFilePath()", "m." & ctrl.CtlName & ".SelectedFilePath")
                ' fileName.SelectedFilePath -> m.fileName.SelectedFilePath (property)
                line = ReplaceAll(line, ctrl.CtlName & ".SelectedFilePath", "m." & ctrl.CtlName & ".SelectedFilePath")
                ' fileName.Text -> m.fileName.SelectedFile (alias for SelectedFile property)
                line = ReplaceAll(line, ctrl.CtlName & ".Text", "m." & ctrl.CtlName & ".SelectedFile")
                ' fileName.Selected -> m.fileName.selected (but not SelectedFile or SelectedFilePath)
                ' Check that we're not matching SelectedFile or SelectedFilePath (with or without m. prefix)
                IF InStrPos(1, line, ".SelectedFile") = 0 AND InStrPos(1, line, ".SelectedFilePath") = 0 THEN
                    line = ReplaceAll(line, ctrl.CtlName & ".Selected", "m." & ctrl.CtlName & ".selected")
                ENDIF
                ' fileName.Pattern -> m.fileName.pattern or GetPattern()
                DIM fwPatternSetPattern AS STRING = ctrl.CtlName & ".Pattern = "
                DIM fwPatternSetPos AS INTEGER = InStrPos(1, line, fwPatternSetPattern)
                IF fwPatternSetPos > 0 THEN
                    DIM beforeFwPatSet AS STRING = Left(line, fwPatternSetPos - 1)
                    DIM afterFwPatSet AS STRING = TrimStr(Mid(line, fwPatternSetPos + Len(fwPatternSetPattern), Len(line)))
                    line = beforeFwPatSet & "m." & ctrl.CtlName & " = m." & ctrl.CtlName & ".SetPattern(" & afterFwPatSet & ")"
                ELSE
                    line = ReplaceAll(line, ctrl.CtlName & ".Pattern", "m." & ctrl.CtlName & ".GetPattern()")
                ENDIF
            ENDIF

            ' CATCH-ALL: Transform any remaining controlName.property to m.controlName.property
            ' This catches properties/methods that weren't explicitly handled above
            DIM ctrlDotPattern AS STRING = ctrl.CtlName & "."
            DIM ctrlDotPos AS INTEGER = InStrPos(1, line, ctrlDotPattern)
            IF ctrlDotPos > 0 THEN
                ' Check if already prefixed with "m."
                DIM alreadyPrefixed AS BOOLEAN = FALSE
                IF ctrlDotPos >= 3 THEN
                    DIM beforeCtrl AS STRING = Mid(line, ctrlDotPos - 2, 2)
                    IF beforeCtrl = "m." THEN
                        alreadyPrefixed = TRUE
                    ENDIF
                ENDIF
                IF NOT alreadyPrefixed THEN
                    ' Also check the character before isn't alphanumeric (part of another identifier)
                    DIM charBeforeCtrl AS STRING = ""
                    IF ctrlDotPos > 1 THEN
                        charBeforeCtrl = Mid(line, ctrlDotPos - 1, 1)
                    ENDIF
                    IF NOT IsIdentChar(charBeforeCtrl) THEN
                        line = ReplaceAll(line, ctrl.CtlName & ".", "m." & ctrl.CtlName & ".")
                    ENDIF
                ENDIF
            ENDIF
        NEXT

        ' Transform MsgBox calls to include m.View() as the background parameter
        ' MsgBox("msg", btns, "title") -> MsgBox("msg", btns, "title", m.View())
        line = TransformMsgBoxCall(line)

        ' linkedPath("name", "/path") -> m = linkedPath(m, "name", "/path")
        line = TransformLinkedPathCall(line)

        ' Transform module-level variables to model fields
        DIM v AS INTEGER
        FOR v = 0 TO Len(moduleVars) - 1
            DIM varName AS STRING = moduleVars[v]
            ' Transform simple variable references to m.varName
            ' Be careful not to transform if already prefixed with m.
            line = TransformModuleVar(line, varName)
        NEXT

        ' Add indentation
        result = result & "    " & TrimStr(line) & Chr(10)
        ENDIF
    NEXT

    RETURN result
END FUNCTION

' Transform a module-level variable reference to use m. prefix
FUNCTION TransformModuleVar(line AS STRING, varName AS STRING) AS STRING
    ' Skip if this is a DIM statement declaring the variable
    IF InStrPos(1, line, "DIM " & varName) > 0 THEN
        RETURN line
    ENDIF

    ' Skip if already prefixed with m.
    IF InStrPos(1, line, "m." & varName) > 0 THEN
        RETURN line
    ENDIF

    ' Find standalone variable references (not part of another identifier)
    ' Replace varName with m.varName where it appears as a standalone token
    DIM result AS STRING = ""
    DIM pos AS INTEGER = 1
    DIM lineLen AS INTEGER = Len(line)

    WHILE pos <= lineLen
        DIM foundPos AS INTEGER = InStrPos(pos, line, varName)
        IF foundPos = 0 THEN
            ' No more occurrences, append rest of line
            result = result & Mid(line, pos, lineLen - pos + 1)
            pos = lineLen + 1
        ELSE
            ' Check if this is a standalone occurrence
            DIM charBefore AS STRING = ""
            DIM charAfter AS STRING = ""
            IF foundPos > 1 THEN
                charBefore = Mid(line, foundPos - 1, 1)
            ENDIF
            DIM afterPos AS INTEGER = foundPos + Len(varName)
            IF afterPos <= lineLen THEN
                charAfter = Mid(line, afterPos, 1)
            ENDIF

            ' Check if char before/after is alphanumeric, underscore, or dot
            ' A dot after means it's part of a property access (e.g., m.xDir)
            DIM beforeIsIdent AS BOOLEAN = IsIdentChar(charBefore)
            DIM afterIsIdent AS BOOLEAN = IsIdentChar(charAfter) OR charAfter = "."

            IF NOT beforeIsIdent AND NOT afterIsIdent THEN
                ' This is a standalone occurrence, transform it
                result = result & Mid(line, pos, foundPos - pos) & "m." & varName
                pos = afterPos
            ELSE
                ' Part of another identifier, don't transform
                result = result & Mid(line, pos, foundPos - pos + Len(varName))
                pos = afterPos
            ENDIF
        ENDIF
    WEND

    RETURN result
END FUNCTION

' Check if character is valid identifier character (letter, digit, or underscore)
FUNCTION IsIdentChar(ch AS STRING) AS BOOLEAN
    IF ch = "" THEN
        RETURN FALSE
    ENDIF
    DIM code AS INTEGER = Asc(ch)
    ' A-Z: 65-90, a-z: 97-122, 0-9: 48-57, _: 95
    IF code >= 65 AND code <= 90 THEN
        RETURN TRUE
    ELSEIF code >= 97 AND code <= 122 THEN
        RETURN TRUE
    ELSEIF code >= 48 AND code <= 57 THEN
        RETURN TRUE
    ELSEIF code = 95 THEN
        RETURN TRUE
    ENDIF
    RETURN FALSE
END FUNCTION

' Transform MsgBox calls to include m.View() as the 4th argument (background)
' Converts: MsgBox("msg", btns, "title") -> MsgBox("msg", btns, "title", m.View())
FUNCTION TransformMsgBoxCall(line AS STRING) AS STRING
    DIM msgBoxPos AS INTEGER = InStrPos(1, line, "MsgBox(")
    IF msgBoxPos = 0 THEN
        RETURN line
    ENDIF

    ' Find the opening paren position (msgBoxPos + 6 = after "MsgBox(")
    DIM openParen AS INTEGER = msgBoxPos + 6

    ' Count parentheses to find the matching close paren
    DIM parenCount AS INTEGER = 1
    DIM pos AS INTEGER = openParen + 1
    DIM lineLen AS INTEGER = Len(line)
    DIM inString AS BOOLEAN = FALSE

    WHILE pos <= lineLen AND parenCount > 0
        DIM ch AS STRING = Mid(line, pos, 1)
        IF ch = Chr(34) THEN
            inString = NOT inString
        ELSEIF NOT inString THEN
            IF ch = "(" THEN
                parenCount = parenCount + 1
            ELSEIF ch = ")" THEN
                parenCount = parenCount - 1
            ENDIF
        ENDIF
        pos = pos + 1
    WEND

    IF parenCount <> 0 THEN
        ' Unbalanced parens, return unchanged
        RETURN line
    ENDIF

    ' pos is now one past the closing paren
    DIM closeParen AS INTEGER = pos - 1

    ' Extract the arguments between the parens
    DIM args AS STRING = Mid(line, openParen + 1, closeParen - openParen - 1)

    ' Count commas to determine number of arguments (outside of strings and nested parens)
    DIM commaCount AS INTEGER = 0
    DIM argPos AS INTEGER = 1
    DIM argLen AS INTEGER = Len(args)
    DIM argParenCount AS INTEGER = 0
    DIM argInString AS BOOLEAN = FALSE

    WHILE argPos <= argLen
        DIM argCh AS STRING = Mid(args, argPos, 1)
        IF argCh = Chr(34) THEN
            argInString = NOT argInString
        ELSEIF NOT argInString THEN
            IF argCh = "(" THEN
                argParenCount = argParenCount + 1
            ELSEIF argCh = ")" THEN
                argParenCount = argParenCount - 1
            ELSEIF argCh = "," AND argParenCount = 0 THEN
                commaCount = commaCount + 1
            ENDIF
        ENDIF
        argPos = argPos + 1
    WEND

    ' If we have exactly 2 commas (3 arguments), add the 4th argument
    IF commaCount = 2 THEN
        DIM beforeMsgBox AS STRING = Left(line, openParen)
        DIM afterMsgBox AS STRING = Mid(line, closeParen, lineLen - closeParen + 1)
        RETURN beforeMsgBox & args & ", m.View()" & afterMsgBox
    ENDIF

    RETURN line
END FUNCTION

' Transform linkedPath("name", "/path") to m = linkedPath(m, "name", "/path")
FUNCTION TransformLinkedPathCall(line AS STRING) AS STRING
    DIM lpPos AS INTEGER = InStrPos(1, line, "linkedPath(")
    IF lpPos = 0 THEN
        RETURN line
    ENDIF

    ' Check if already transformed (has "m, " after the opening paren)
    DIM afterOpen AS STRING = Mid(line, lpPos + 11, 3)
    IF afterOpen = "m, " THEN
        RETURN line
    ENDIF

    ' Find the opening paren position (lpPos + 10 = after "linkedPath(")
    DIM openParen AS INTEGER = lpPos + 10

    ' Count parentheses to find the matching close paren
    DIM parenCount AS INTEGER = 1
    DIM pos AS INTEGER = openParen + 1
    DIM lineLen AS INTEGER = Len(line)
    DIM inString AS BOOLEAN = FALSE

    WHILE pos <= lineLen AND parenCount > 0
        DIM ch AS STRING = Mid(line, pos, 1)
        IF ch = Chr(34) THEN
            inString = NOT inString
        ELSEIF NOT inString THEN
            IF ch = "(" THEN
                parenCount = parenCount + 1
            ELSEIF ch = ")" THEN
                parenCount = parenCount - 1
            ENDIF
        ENDIF
        pos = pos + 1
    WEND

    IF parenCount <> 0 THEN
        ' Unbalanced parens, return unchanged
        RETURN line
    ENDIF

    ' pos is now one past the closing paren
    DIM closeParen AS INTEGER = pos - 1

    ' Extract the arguments between the parens
    DIM args AS STRING = Mid(line, openParen + 1, closeParen - openParen - 1)

    ' Build the transformed line: m = linkedPath(m, args)
    DIM beforeLP AS STRING = Left(line, lpPos - 1)
    DIM afterLP AS STRING = Mid(line, closeParen + 1, lineLen - closeParen)

    ' Handle leading whitespace - preserve indentation
    DIM indent AS STRING = ""
    DIM indentLen AS INTEGER = 0
    WHILE indentLen < Len(beforeLP) AND (Mid(beforeLP, indentLen + 1, 1) = " " OR Mid(beforeLP, indentLen + 1, 1) = Chr(9))
        indent = indent & Mid(beforeLP, indentLen + 1, 1)
        indentLen = indentLen + 1
    WEND

    RETURN indent & "m = linkedPath(m, " & args & ")" & afterLP
END FUNCTION

' Extract module-level variables from form code
' Includes both explicit DIM declarations before SUBs and undeclared assigned variables
FUNCTION ExtractModuleVariables(code AS STRING, form AS VDBForm) AS []STRING
    DIM vars AS []STRING
    DIM localDeclaredVars AS []STRING
    DIM lines AS []STRING = SplitStr(code, Chr(10))
    DIM i AS INTEGER
    DIM inSub AS BOOLEAN = FALSE

    ' First pass: collect module-level DIM declarations (before any SUB)
    ' and local DIM declarations (inside SUBs)
    FOR i = 0 TO Len(lines) - 1
        DIM line AS STRING = TrimStr(lines[i])

        IF Left(line, 4) = "SUB " THEN
            inSub = TRUE
        ELSEIF Left(line, 7) = "END SUB" THEN
            inSub = FALSE
        ELSEIF Left(line, 4) = "DIM " THEN
            ' Extract variable name from DIM varName AS TYPE
            DIM afterDim AS STRING = Mid(line, 5, Len(line))
            DIM varEnd AS INTEGER = InStrPos(1, afterDim, " ")
            IF varEnd > 0 THEN
                DIM varName AS STRING = Left(afterDim, varEnd - 1)
                IF inSub THEN
                    ' Local declaration - add to exclusion list
                    IF NOT StringInArray(varName, localDeclaredVars) THEN
                        localDeclaredVars = APPEND(localDeclaredVars, varName)
                    ENDIF
                ELSE
                    ' Module-level declaration - add to vars list
                    IF NOT StringInArray(varName, vars) THEN
                        vars = APPEND(vars, varName)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT

    ' Second pass: collect assigned variables that weren't declared locally
    inSub = FALSE
    FOR i = 0 TO Len(lines) - 1
        DIM line AS STRING = TrimStr(lines[i])

        IF Left(line, 4) = "SUB " THEN
            inSub = TRUE
        ELSEIF Left(line, 7) = "END SUB" THEN
            inSub = FALSE
        ELSEIF inSub THEN
            ' Skip empty lines, comments, and control structures
            ' Use uppercase for case-insensitive comparison
            DIM upperLine AS STRING = UCase(line)
            IF line = "" OR Left(line, 1) = "'" THEN
                ' Skip
            ELSEIF Left(upperLine, 4) = "DIM " OR Left(upperLine, 3) = "IF " OR Left(upperLine, 6) = "ELSEIF" OR Left(upperLine, 5) = "ELSE " OR upperLine = "ELSE" OR Left(upperLine, 4) = "FOR " OR Left(upperLine, 4) = "END " OR Left(upperLine, 5) = "NEXT " OR upperLine = "NEXT" OR Left(upperLine, 6) = "RETURN" OR Left(upperLine, 5) = "ENDIF" OR Left(upperLine, 5) = "WHILE" OR Left(upperLine, 4) = "WEND" THEN
                ' Skip control structures and declarations
            ELSE
                ' Look for simple assignment pattern: varName = value
                DIM eqPos AS INTEGER = InStrPos(1, line, " = ")
                IF eqPos > 0 THEN
                    DIM lhs AS STRING = TrimStr(Left(line, eqPos - 1))

                    ' Skip if it's a control property (contains .)
                    IF InStrPos(1, lhs, ".") = 0 THEN
                        ' Skip if it starts with m.
                        IF Left(lhs, 2) <> "m." THEN
                            ' Check if it's not a control name
                            IF NOT IsControlName(lhs, form) THEN
                                ' Check if it's a valid identifier (must start with letter and contain no spaces)
                                IF Len(lhs) > 0 AND IsLetter(Left(lhs, 1)) AND InStrPos(1, lhs, " ") = 0 THEN
                                    ' Check if not declared locally
                                    IF NOT StringInArray(lhs, localDeclaredVars) THEN
                                        ' Check if not already in vars list
                                        IF NOT StringInArray(lhs, vars) THEN
                                            vars = APPEND(vars, lhs)
                                        ENDIF
                                    ENDIF
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    NEXT

    RETURN vars
END FUNCTION

' Check if a name is a control name
FUNCTION IsControlName(name AS STRING, form AS VDBForm) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        IF form.Controls[i].CtlName = name THEN
            RETURN TRUE
        ENDIF
    NEXT
    RETURN FALSE
END FUNCTION

' Check if character is a letter
FUNCTION IsLetter(ch AS STRING) AS BOOLEAN
    IF ch = "" THEN
        RETURN FALSE
    ENDIF
    DIM code AS INTEGER = Asc(ch)
    IF code >= 65 AND code <= 90 THEN
        RETURN TRUE
    ELSEIF code >= 97 AND code <= 122 THEN
        RETURN TRUE
    ENDIF
    RETURN FALSE
END FUNCTION

' Check if string is in array
FUNCTION StringInArray(s AS STRING, arr AS []STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(arr) - 1
        IF arr[i] = s THEN
            RETURN TRUE
        ENDIF
    NEXT
    RETURN FALSE
END FUNCTION

' Generate main entry point
FUNCTION GenerateMain(startupForm AS STRING) AS STRING
    DIM code AS STRING = ""

    code = code & "' ============================================" & Chr(10)
    code = code & "' Main Entry Point" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)
    code = code & "SUB Main()" & Chr(10)
    code = code & "    ' Initialize theme constants" & Chr(10)
    code = code & "    InitTheme()" & Chr(10)
    code = code & Chr(10)
    code = code & "    ' Initialize the model before passing to NewProgram" & Chr(10)
    code = code & "    DIM model AS " & startupForm & "Model = Init" & startupForm & "Model()" & Chr(10)
    code = code & "    tea.NewProgram(model, tea.WithAltScreen(), tea.WithMouseCellMotion()).Run()" & Chr(10)
    code = code & "END SUB" & Chr(10)

    RETURN code
END FUNCTION
