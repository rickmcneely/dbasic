' VDBTerm Type Definitions
' Data structures for controls, forms, modules, projects, and the main model

IMPORT "charm.land/bubbles/v2/textarea" AS textarea
IMPORT "charm.land/bubbles/v2/textinput" AS textinput
IMPORT "time" AS time

' Syntax highlighting token
TYPE SyntaxToken
    DIM TokenType AS INTEGER
    DIM StartCol AS INTEGER
    DIM Length AS INTEGER
END TYPE

' Control definition
TYPE VDBControl
    DIM ID AS INTEGER
    DIM CtlType AS INTEGER
    DIM CtlName AS STRING
    DIM Caption AS STRING
    DIM X AS INTEGER
    DIM Y AS INTEGER
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    ' Expression strings for variable-based positioning/sizing
    DIM XExpr AS STRING
    DIM YExpr AS STRING
    DIM WidthExpr AS STRING
    DIM HeightExpr AS STRING
    DIM Enabled AS BOOLEAN
    DIM Visible AS BOOLEAN
    DIM TabIndex AS INTEGER
    DIM TabStop AS BOOLEAN
    DIM ZOrder AS INTEGER
    DIM Value AS STRING
    DIM ForeColor AS INTEGER
    DIM BackColor AS INTEGER

    ' TextBox (textinput.Model) properties
    DIM Placeholder AS STRING
    DIM CharLimit AS INTEGER
    DIM EchoMode AS INTEGER      ' 0=Normal, 1=Password, 2=None
    DIM Prompt AS STRING
    DIM CursorBlink AS BOOLEAN   ' Enable cursor blinking

    ' ListBox (list.Model) properties
    DIM ShowTitle AS BOOLEAN
    DIM ShowStatusBar AS BOOLEAN
    DIM ShowFilter AS BOOLEAN
    DIM Items AS STRING          ' Semicolon-separated list items
    DIM Title AS STRING          ' Title text when ShowTitle is true
    DIM InfiniteScrolling AS BOOLEAN

    ' Timer properties
    DIM Interval AS INTEGER      ' Milliseconds

    ' Label properties
    DIM Justification AS INTEGER ' 0=Left, 1=Center, 2=Right

    ' Button properties
    DIM Border AS BOOLEAN        ' Show border around button (3-row style)

    ' Option (radio) properties
    DIM GroupName AS STRING      ' Groups radio buttons together

    ' Scrollbar properties
    DIM MinValue AS INTEGER
    DIM MaxValue AS INTEGER

    ' TextArea (textarea.Model) properties
    DIM ShowLineNumbers AS BOOLEAN

    ' Progress (progress.Model) properties
    DIM Total AS INTEGER         ' Total value for progress (Value is current)
    DIM ShowPercentage AS BOOLEAN

    ' Spinner (spinner.Model) properties
    DIM SpinnerStyle AS INTEGER  ' 0=Line, 1=Dot, 2=MiniDot, 3=Jump, 4=Pulse, 5=Points

    ' Table (table.Model) properties
    DIM Columns AS STRING        ' Semicolon-separated column headers
    DIM Rows AS STRING           ' Pipe-separated rows, semicolon-separated cells
    DIM ShowHeaders AS BOOLEAN

    ' DirBrowser properties
    DIM FilePath AS STRING       ' Current directory path
    DIM ShowHidden AS BOOLEAN    ' Show hidden files/directories

    ' Files widget properties
    DIM Pattern AS STRING        ' File pattern filter (e.g., "*.txt", "*.go")

    ' Path/Directories linking
    DIM LinkedControl AS STRING  ' Name of linked control (Path<->Directories)

    ' Curl widget properties
    DIM URL AS STRING            ' URL for HTTP request
    DIM HttpMethod AS STRING     ' GET, POST, PUT, DELETE, etc.

    ' Viewport widget properties
    DIM SoftWrap AS BOOLEAN
    DIM MouseWheel AS BOOLEAN

    ' Clipboard widget properties
    DIM FallbackEnabled AS BOOLEAN

    ' Plugin widget properties
    DIM PluginTypeID AS STRING   ' Plugin ID (e.g., "gauge") for plugin widgets
    DIM ExtendedProps AS STRING  ' JSON map for plugin-specific properties
END TYPE

' Form definition
TYPE VDBForm
    DIM Name AS STRING
    DIM Caption AS STRING
    DIM X AS INTEGER
    DIM Y AS INTEGER
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    DIM ForeColor AS INTEGER
    DIM BackColor AS INTEGER
    DIM Controls AS []VDBControl
    DIM Code AS STRING
    DIM NextCtrlID AS INTEGER
END TYPE

' Module definition (code-only file)
TYPE VDBModule
    DIM Name AS STRING
    DIM Code AS STRING
END TYPE

' Theme definition for consistent styling across forms and controls
TYPE VDBTheme
    DIM Name AS STRING               ' Theme name (e.g., "Dark", "Light", "Classic")

    ' Form defaults
    DIM FormForeColor AS INTEGER
    DIM FormBackColor AS INTEGER

    ' Control type defaults (ForeColor/BackColor pairs)
    DIM ButtonForeColor AS INTEGER
    DIM ButtonBackColor AS INTEGER
    DIM LabelForeColor AS INTEGER
    DIM LabelBackColor AS INTEGER
    DIM TextBoxForeColor AS INTEGER
    DIM TextBoxBackColor AS INTEGER
    DIM CheckBoxForeColor AS INTEGER
    DIM CheckBoxBackColor AS INTEGER
    DIM OptionForeColor AS INTEGER
    DIM OptionBackColor AS INTEGER
    DIM ListBoxForeColor AS INTEGER
    DIM ListBoxBackColor AS INTEGER
    DIM ComboBoxForeColor AS INTEGER
    DIM ComboBoxBackColor AS INTEGER
    DIM FrameForeColor AS INTEGER
    DIM FrameBackColor AS INTEGER
    DIM TextAreaForeColor AS INTEGER
    DIM TextAreaBackColor AS INTEGER
    DIM ProgressForeColor AS INTEGER
    DIM ProgressBackColor AS INTEGER
    DIM SpinnerForeColor AS INTEGER
    DIM SpinnerBackColor AS INTEGER
    DIM PathForeColor AS INTEGER
    DIM PathBackColor AS INTEGER
    DIM DirectoriesForeColor AS INTEGER
    DIM DirectoriesBackColor AS INTEGER
    DIM FilesForeColor AS INTEGER
    DIM FilesBackColor AS INTEGER
    DIM DirBrowserForeColor AS INTEGER
    DIM DirBrowserBackColor AS INTEGER

    ' Focus/selection state colors
    DIM FocusedForeColor AS INTEGER
    DIM FocusedBackColor AS INTEGER
    DIM SelectedForeColor AS INTEGER
    DIM SelectedBackColor AS INTEGER

    ' Menu colors
    DIM MenuForeColor AS INTEGER
    DIM MenuBackColor AS INTEGER
    DIM MenuSelectedForeColor AS INTEGER
    DIM MenuSelectedBackColor AS INTEGER
    DIM MenuShortcutForeColor AS INTEGER     ' Shortcut key fore color (back matches menu)

    ' Extended color mode
    DIM Use256Colors AS BOOLEAN              ' When TRUE, colors range 0-255; when FALSE, 0-15
END TYPE

' Project definition
TYPE VDBProject
    DIM Name AS STRING
    DIM Path AS STRING
    DIM StartupForm AS STRING
    DIM Forms AS []VDBForm
    DIM Modules AS []VDBModule
    DIM Modified AS BOOLEAN

    ' Theme settings
    DIM Theme AS VDBTheme
    DIM UseTheme AS BOOLEAN          ' When TRUE, new controls use theme colors
END TYPE

' Plugin type definitions
' Widget metadata stored in .vdbp file
TYPE WidgetMeta
    DIM ID AS STRING            ' Unique widget identifier
    DIM Name AS STRING          ' Display name
    DIM Icon AS STRING          ' Toolbox icon (e.g., "[G] ")
    DIM Description AS STRING   ' Widget description
    DIM Category AS STRING      ' "visible" or "nonvisible"
    DIM Author AS STRING        ' Widget author
    DIM Version AS STRING       ' Version string
END TYPE

' Plugin property definition
TYPE PluginProperty
    DIM Name AS STRING
    DIM PropType AS STRING      ' "string", "boolean", "integer", "enum", "color"
    DIM DefaultStr AS STRING
    DIM DefaultInt AS INTEGER
    DIM DefaultBool AS BOOLEAN
    DIM EnumValues AS []STRING
    DIM Description AS STRING
    DIM MinValue AS INTEGER
    DIM MaxValue AS INTEGER
END TYPE

' Plugin event definition
TYPE PluginEvent
    DIM Name AS STRING
    DIM Description AS STRING
END TYPE

' Code generation templates
TYPE PluginCodegen
    DIM Imports AS []STRING
    DIM StateFields AS []STRING
    DIM InitCode AS []STRING
    DIM ClickHandler AS []STRING
    DIM RenderFunction AS STRING
END TYPE

' Complete plugin widget definition
TYPE PluginWidgetDef
    DIM Meta AS WidgetMeta
    DIM Properties AS []PluginProperty
    DIM Events AS []PluginEvent
    DIM Codegen AS PluginCodegen
    DIM TemplateForm AS VDBForm
    DIM CtrlTypeID AS INTEGER
    DIM FilePath AS STRING
    DIM Modified AS BOOLEAN
END TYPE

' Plugin registry
TYPE PluginRegistry
    DIM Widgets AS []PluginWidgetDef
    DIM NextCtrlTypeID AS INTEGER
    DIM PluginDir AS STRING
END TYPE

' Main application model
TYPE VDBTermModel IMPLEMENTS tea.Model
    ' Screen dimensions
    DIM Width AS INTEGER
    DIM Height AS INTEGER

    ' Current project
    DIM Project AS VDBProject
    DIM ProjectLoaded AS BOOLEAN

    ' View state
    DIM ViewMode AS INTEGER
    DIM FocusArea AS INTEGER

    ' Form designer state
    DIM CurrentFormIdx AS INTEGER
    DIM SelectedCtrlIdx AS INTEGER
    DIM ToolboxIndex AS INTEGER
    DIM WidgetsIndex AS INTEGER
    DIM FormScrollX AS INTEGER
    DIM FormScrollY AS INTEGER
    DIM WidgetsScroll AS INTEGER
    DIM ToolboxScroll AS INTEGER
    DIM ProjectScroll AS INTEGER

    ' Left panel layout (heights are user-adjustable)
    DIM ProjectHeight AS INTEGER
    DIM WidgetsHeight AS INTEGER
    DIM ToolboxHeight AS INTEGER
    DIM PanelDragging AS INTEGER
    DIM PanelDragStartY AS INTEGER
    DIM PanelDragOrigHeight AS INTEGER
    DIM IsDragging AS BOOLEAN
    DIM DraggingForm AS BOOLEAN
    DIM DragStartX AS INTEGER
    DIM DragStartY AS INTEGER
    DIM DragSkipFrame AS BOOLEAN
    DIM DragOutlineX AS INTEGER
    DIM DragOutlineY AS INTEGER
    DIM DragCtrlWidth AS INTEGER
    DIM DragCtrlHeight AS INTEGER
    DIM IsResizing AS BOOLEAN
    DIM ResizingForm AS BOOLEAN
    DIM ResizeCorner AS INTEGER
    DIM ResizeOrigX AS INTEGER
    DIM ResizeOrigY AS INTEGER
    DIM ResizeOrigW AS INTEGER
    DIM ResizeOrigH AS INTEGER
    DIM DraggingFromWidgets AS BOOLEAN
    DIM DragWidgetType AS INTEGER

    ' Code editor state (textarea component)
    DIM CodeEditor AS textarea.Model
    DIM CodeEditorInited AS BOOLEAN
    ' Legacy cursor position for status bar display
    DIM CodeCursorX AS INTEGER
    DIM CodeCursorY AS INTEGER
    DIM CodeScrollX AS INTEGER
    DIM CodeScrollY AS INTEGER
    DIM CodeSelecting AS BOOLEAN
    DIM CodeSelStartX AS INTEGER
    DIM CodeSelStartY AS INTEGER
    DIM CodeSelEndX AS INTEGER
    DIM CodeSelEndY AS INTEGER
    DIM CodeClipboard AS STRING
    DIM CodeDraggingText AS BOOLEAN
    DIM CodeDropLine AS INTEGER
    DIM CodeDropCol AS INTEGER

    ' Find/Replace state
    DIM FindText AS STRING
    DIM ReplaceText AS STRING
    DIM FindMatches AS [][]INTEGER
    DIM FindMatchIdx AS INTEGER
    DIM FindActive AS BOOLEAN

    ' Property inspector state
    DIM PropIndex AS INTEGER
    DIM PropEditing AS BOOLEAN
    DIM PropEditValue AS STRING
    DIM PropEditFresh AS BOOLEAN
    DIM PropLastClickTime AS time.Time
    DIM PropLastClickIdx AS INTEGER

    ' Project tree state
    DIM TreeIndex AS INTEGER
    DIM TreeExpanded AS []BOOLEAN
    DIM TreeLastClickTime AS time.Time
    DIM TreeLastClickIdx AS INTEGER

    ' Menu state
    DIM MenuOpen AS INTEGER
    DIM MenuIndex AS INTEGER

    ' Dialog state
    DIM DialogMode AS INTEGER
    DIM DialogInput AS STRING
    DIM DialogInput2 AS STRING
    DIM DialogCursor AS INTEGER
    DIM DialogField AS INTEGER
    DIM DialogTextInput AS textinput.Model
    DIM DialogTextInput2 AS textinput.Model

    ' Status
    DIM Message AS STRING
    DIM ErrorMsg AS STRING

    ' Compile error dialog state
    DIM CompileErrors AS STRING          ' Full error output from compiler
    DIM CompileErrorScroll AS INTEGER    ' Scroll position for viewing errors
    DIM CompileErrorBtnIdx AS INTEGER    ' 0=OK, 1=Copy

    ' Options
    DIM ShowGrid AS BOOLEAN
    DIM GridSize AS INTEGER
    DIM SnapToGrid AS BOOLEAN
    DIM ShowLineNumbers AS BOOLEAN
    DIM TabSize AS INTEGER
    DIM AutoIndent AS BOOLEAN
    DIM SyntaxHighlight AS BOOLEAN

    ' Event popup state
    DIM PopupMode AS INTEGER
    DIM PopupX AS INTEGER
    DIM PopupY AS INTEGER
    DIM PopupCtrlIdx AS INTEGER      ' Control index for events popup (-1 for form)
    DIM PopupCtrlType AS INTEGER     ' Control type (for Widgets/Toolbox popups)
    DIM PopupEvents AS []STRING      ' Available events for the control
    DIM PopupIndex AS INTEGER        ' Selected event index

    ' Color picker state
    DIM ColorPickerFocus AS INTEGER  ' 0=ForeColor, 1=BackColor
    DIM ColorPickerFore AS INTEGER   ' Current ForeColor value (0-15)
    DIM ColorPickerBack AS INTEGER   ' Current BackColor value (0-15)

    ' Run state - track when returning from external process
    DIM WasRunning AS BOOLEAN

    ' Object Browser state
    DIM ObjectBrowserScroll AS INTEGER    ' Current scroll position
    DIM ObjectBrowserTab AS INTEGER       ' 0=Widgets, 1=Properties, 2=Events, 3=Functions
    DIM ObjectBrowserWidgetIdx AS INTEGER ' Currently selected widget in browser

    ' Plugin system
    DIM PluginRegistry AS PluginRegistry

    ' Plugin Designer state
    DIM ShowPluginDesigner AS BOOLEAN
    DIM PluginDesignerMode AS INTEGER     ' 0=list, 1=metadata, 2=properties, 3=events, 4=rendering, 5=codegen
    DIM EditingPlugin AS PluginWidgetDef
    DIM EditingPluginIdx AS INTEGER       ' Index in registry (-1 for new plugin)
    DIM PluginListIndex AS INTEGER        ' Selected plugin in list
    DIM PluginPropertyIndex AS INTEGER    ' Selected property index
    DIM PluginEventIndex AS INTEGER       ' Selected event index
    DIM PluginRenderIndex AS INTEGER      ' Selected render row index
    DIM PluginFieldFocus AS INTEGER       ' Which field has focus in editor
    DIM PluginEditBuffer AS STRING        ' Current edit buffer
    DIM PluginEditCursor AS INTEGER       ' Cursor position in edit buffer

    ' Save As dialog state
    DIM SaveAsWidget AS BOOLEAN           ' Checkbox: "Save as Widget" in Save As dialog

    ' Theme Editor state
    DIM ThemeEditorIndex AS INTEGER       ' Currently selected button (0=Apply, 1=OK, 2=Cancel)
    DIM ThemeEditorPropIdx AS INTEGER     ' Currently selected property in editor
    DIM ThemeEditorScroll AS INTEGER      ' Scroll position in property list
    DIM ThemeEditorColIdx AS INTEGER      ' Currently selected column (0=Fore, 1=Back)
    DIM ThemeEditingTheme AS VDBTheme     ' Theme being edited
    DIM ThemeEditorFocus AS INTEGER       ' Focus area: THEME_FOCUS_PROPS, THEME_FOCUS_BUTTONS, THEME_FOCUS_PICKER
    DIM ThemeColorPickerX AS INTEGER      ' Color picker X position (0-15 for 16x16 grid)
    DIM ThemeColorPickerY AS INTEGER      ' Color picker Y position (0-15 for 16x16 grid)
    DIM ThemeColorPickerOpen AS BOOLEAN   ' Whether 256-color picker is open

    ' File Browser state
    DIM FileBrowserPath AS STRING         ' Current directory path
    DIM FileBrowserDirs AS []STRING       ' List of directories in current path
    DIM FileBrowserFiles AS []STRING      ' List of files in current path
    DIM FileBrowserDirIdx AS INTEGER      ' Selected directory index
    DIM FileBrowserFileIdx AS INTEGER     ' Selected file index
    DIM FileBrowserDirScroll AS INTEGER   ' Scroll offset for directory list
    DIM FileBrowserFileScroll AS INTEGER  ' Scroll offset for file list
    DIM FileBrowserFocus AS INTEGER       ' Current focus: path, dirs, files, or buttons
    DIM FileBrowserPattern AS STRING      ' File filter pattern (e.g., "*.vdbp")
    DIM FileBrowserBtnIdx AS INTEGER      ' Selected button (0=Open, 1=Cancel)
    DIM FileBrowserMode AS INTEGER        ' 0=Open, 1=Save (for future use)
    DIM FileBrowserTitle AS STRING        ' Dialog title

    ' Build spinner state
    DIM BuildInProgress AS BOOLEAN
    DIM BuildSpinnerFrame AS INTEGER

    ' Terminal focus state
    DIM TerminalFocused AS BOOLEAN
END TYPE
