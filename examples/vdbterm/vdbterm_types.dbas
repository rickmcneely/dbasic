' VDBTerm Type Definitions
' Data structures for controls, forms, modules, projects, and the main model

IMPORT "github.com/charmbracelet/bubbles/textarea" AS textarea
IMPORT "github.com/charmbracelet/bubbles/textinput" AS textinput
IMPORT "time" AS time

' Syntax highlighting token
TYPE SyntaxToken
    DIM TokenType AS INTEGER
    DIM StartCol AS INTEGER
    DIM Length AS INTEGER
END TYPE

' Control definition
TYPE VDBControl
    DIM ID AS INTEGER
    DIM CtlType AS INTEGER
    DIM CtlName AS STRING
    DIM Caption AS STRING
    DIM X AS INTEGER
    DIM Y AS INTEGER
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    ' Expression strings for variable-based positioning/sizing
    DIM XExpr AS STRING
    DIM YExpr AS STRING
    DIM WidthExpr AS STRING
    DIM HeightExpr AS STRING
    DIM Enabled AS BOOLEAN
    DIM Visible AS BOOLEAN
    DIM TabIndex AS INTEGER
    DIM ZOrder AS INTEGER
    DIM Value AS STRING
    DIM ForeColor AS INTEGER
    DIM BackColor AS INTEGER

    ' TextBox (textinput.Model) properties
    DIM Placeholder AS STRING
    DIM CharLimit AS INTEGER
    DIM EchoMode AS INTEGER      ' 0=Normal, 1=Password, 2=None
    DIM Prompt AS STRING
    DIM CursorBlink AS BOOLEAN   ' Enable cursor blinking

    ' ListBox (list.Model) properties
    DIM ShowTitle AS BOOLEAN
    DIM ShowStatusBar AS BOOLEAN
    DIM ShowFilter AS BOOLEAN
    DIM Items AS STRING          ' Semicolon-separated list items
    DIM Title AS STRING          ' Title text when ShowTitle is true
    DIM InfiniteScrolling AS BOOLEAN

    ' Timer properties
    DIM Interval AS INTEGER      ' Milliseconds

    ' Label properties
    DIM Justification AS INTEGER ' 0=Left, 1=Center, 2=Right

    ' Button properties
    DIM Border AS BOOLEAN        ' Show border around button (3-row style)

    ' Option (radio) properties
    DIM GroupName AS STRING      ' Groups radio buttons together

    ' Scrollbar properties
    DIM MinValue AS INTEGER
    DIM MaxValue AS INTEGER

    ' TextArea (textarea.Model) properties
    DIM ShowLineNumbers AS BOOLEAN

    ' Progress (progress.Model) properties
    DIM Total AS INTEGER         ' Total value for progress (Value is current)
    DIM ShowPercentage AS BOOLEAN

    ' Spinner (spinner.Model) properties
    DIM SpinnerStyle AS INTEGER  ' 0=Line, 1=Dot, 2=MiniDot, 3=Jump, 4=Pulse, 5=Points

    ' Table (table.Model) properties
    DIM Columns AS STRING        ' Semicolon-separated column headers
    DIM Rows AS STRING           ' Pipe-separated rows, semicolon-separated cells
    DIM ShowHeaders AS BOOLEAN
END TYPE

' Form definition
TYPE VDBForm
    DIM Name AS STRING
    DIM Caption AS STRING
    DIM X AS INTEGER
    DIM Y AS INTEGER
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    DIM BackColor AS INTEGER
    DIM Controls AS []VDBControl
    DIM Code AS STRING
    DIM NextCtrlID AS INTEGER
END TYPE

' Module definition (code-only file)
TYPE VDBModule
    DIM Name AS STRING
    DIM Code AS STRING
END TYPE

' Project definition
TYPE VDBProject
    DIM Name AS STRING
    DIM Path AS STRING
    DIM StartupForm AS STRING
    DIM Forms AS []VDBForm
    DIM Modules AS []VDBModule
    DIM Modified AS BOOLEAN
END TYPE

' Main application model
TYPE VDBTermModel IMPLEMENTS tea.Model
    ' Screen dimensions
    DIM Width AS INTEGER
    DIM Height AS INTEGER

    ' Current project
    DIM Project AS VDBProject
    DIM ProjectLoaded AS BOOLEAN

    ' View state
    DIM ViewMode AS INTEGER
    DIM FocusArea AS INTEGER

    ' Form designer state
    DIM CurrentFormIdx AS INTEGER
    DIM SelectedCtrlIdx AS INTEGER
    DIM ToolboxIndex AS INTEGER
    DIM WidgetsIndex AS INTEGER
    DIM FormScrollX AS INTEGER
    DIM FormScrollY AS INTEGER

    ' Left panel layout (heights are user-adjustable)
    DIM ProjectHeight AS INTEGER
    DIM WidgetsHeight AS INTEGER
    DIM ToolboxHeight AS INTEGER
    DIM PanelDragging AS INTEGER
    DIM PanelDragStartY AS INTEGER
    DIM PanelDragOrigHeight AS INTEGER
    DIM IsDragging AS BOOLEAN
    DIM DraggingForm AS BOOLEAN
    DIM DragStartX AS INTEGER
    DIM DragStartY AS INTEGER
    DIM DragSkipFrame AS BOOLEAN
    DIM DragOutlineX AS INTEGER
    DIM DragOutlineY AS INTEGER
    DIM DragCtrlWidth AS INTEGER
    DIM DragCtrlHeight AS INTEGER
    DIM IsResizing AS BOOLEAN
    DIM ResizingForm AS BOOLEAN
    DIM ResizeCorner AS INTEGER
    DIM ResizeOrigX AS INTEGER
    DIM ResizeOrigY AS INTEGER
    DIM ResizeOrigW AS INTEGER
    DIM ResizeOrigH AS INTEGER
    DIM DraggingFromWidgets AS BOOLEAN
    DIM DragWidgetType AS INTEGER

    ' Code editor state (textarea component)
    DIM CodeEditor AS textarea.Model
    DIM CodeEditorInited AS BOOLEAN
    ' Legacy cursor position for status bar display
    DIM CodeCursorX AS INTEGER
    DIM CodeCursorY AS INTEGER
    DIM CodeScrollX AS INTEGER
    DIM CodeScrollY AS INTEGER
    DIM CodeSelecting AS BOOLEAN
    DIM CodeSelStartX AS INTEGER
    DIM CodeSelStartY AS INTEGER
    DIM CodeClipboard AS STRING

    ' Property inspector state
    DIM PropIndex AS INTEGER
    DIM PropEditing AS BOOLEAN
    DIM PropEditValue AS STRING
    DIM PropEditFresh AS BOOLEAN
    DIM PropLastClickTime AS time.Time
    DIM PropLastClickIdx AS INTEGER

    ' Project tree state
    DIM TreeIndex AS INTEGER
    DIM TreeExpanded AS []BOOLEAN

    ' Menu state
    DIM MenuOpen AS INTEGER
    DIM MenuIndex AS INTEGER

    ' Dialog state
    DIM DialogMode AS INTEGER
    DIM DialogInput AS STRING
    DIM DialogInput2 AS STRING
    DIM DialogCursor AS INTEGER
    DIM DialogField AS INTEGER
    DIM DialogTextInput AS textinput.Model
    DIM DialogTextInput2 AS textinput.Model

    ' Status
    DIM Message AS STRING
    DIM ErrorMsg AS STRING

    ' Options
    DIM ShowGrid AS BOOLEAN
    DIM GridSize AS INTEGER
    DIM SnapToGrid AS BOOLEAN
    DIM ShowLineNumbers AS BOOLEAN
    DIM TabSize AS INTEGER
    DIM AutoIndent AS BOOLEAN
    DIM SyntaxHighlight AS BOOLEAN

    ' Event popup state
    DIM PopupMode AS INTEGER
    DIM PopupX AS INTEGER
    DIM PopupY AS INTEGER
    DIM PopupCtrlIdx AS INTEGER      ' Control index for events popup (-1 for form)
    DIM PopupCtrlType AS INTEGER     ' Control type (for Widgets/Toolbox popups)
    DIM PopupEvents AS []STRING      ' Available events for the control
    DIM PopupIndex AS INTEGER        ' Selected event index

    ' Run state - track when returning from external process
    DIM WasRunning AS BOOLEAN

    ' Object Browser state
    DIM ObjectBrowserScroll AS INTEGER    ' Current scroll position
    DIM ObjectBrowserTab AS INTEGER       ' 0=Widgets, 1=Properties, 2=Events, 3=Functions
    DIM ObjectBrowserWidgetIdx AS INTEGER ' Currently selected widget in browser
END TYPE
