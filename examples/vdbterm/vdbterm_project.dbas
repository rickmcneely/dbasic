' VDBTerm Project Operations
' Project, form, module, and control creation, serialization, and code generation

IMPORT "os" AS os

FUNCTION NewProject(name AS STRING) AS VDBProject
    DIM proj AS VDBProject
    proj.Name = name
    proj.Path = ""
    proj.StartupForm = "Form1"
    proj.Modified = FALSE

    ' Initialize theme with default values
    proj.Theme = NewDefaultTheme()
    proj.UseTheme = FALSE

    ' Create default form with sample controls
    DIM form AS VDBForm
    form.Name = "Form1"
    form.Caption = "VDBTerm Demo Form"
    form.X = 0
    form.Y = 0
    form.Width = 60
    form.Height = 20
    form.ForeColor = 0
    form.BackColor = 7
    form.Code = "' Form1 Code - VDBTerm Demo" & Chr(10) & Chr(10)
    form.Code = form.Code & "' This form demonstrates various VDBTerm controls" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB Form_Load()" & Chr(10)
    form.Code = form.Code & "    ' Initialize the title" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Welcome to VDBTerm!" & Chr(34) & Chr(10) & Chr(10)
    form.Code = form.Code & "    ' Add items to the listbox" & Chr(10)
    form.Code = form.Code & "    lstItems.AddItem(" & Chr(34) & "Apple" & Chr(34) & ")" & Chr(10)
    form.Code = form.Code & "    lstItems.AddItem(" & Chr(34) & "Banana" & Chr(34) & ")" & Chr(10)
    form.Code = form.Code & "    lstItems.AddItem(" & Chr(34) & "Cherry" & Chr(34) & ")" & Chr(10)
    form.Code = form.Code & "    lstItems.AddItem(" & Chr(34) & "Date" & Chr(34) & ")" & Chr(10)
    form.Code = form.Code & "    lstItems.AddItem(" & Chr(34) & "Elderberry" & Chr(34) & ")" & Chr(10) & Chr(10)
    form.Code = form.Code & "    ' Set default option" & Chr(10)
    form.Code = form.Code & "    optChoice1.Selected = TRUE" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB btnOK_Click()" & Chr(10)
    form.Code = form.Code & "    ' Show current form state" & Chr(10)
    form.Code = form.Code & "    DIM msg AS STRING = " & Chr(34) & "Input: " & Chr(34) & " & txtInput.Text" & Chr(10)
    form.Code = form.Code & "    IF chkOption.Checked THEN" & Chr(10)
    form.Code = form.Code & "        msg = msg & " & Chr(34) & " [Feature ON]" & Chr(34) & Chr(10)
    form.Code = form.Code & "    ENDIF" & Chr(10)
    form.Code = form.Code & "    IF optChoice1.Selected THEN" & Chr(10)
    form.Code = form.Code & "        msg = msg & " & Chr(34) & " (Option A)" & Chr(34) & Chr(10)
    form.Code = form.Code & "    ELSE" & Chr(10)
    form.Code = form.Code & "        msg = msg & " & Chr(34) & " (Option B)" & Chr(34) & Chr(10)
    form.Code = form.Code & "    ENDIF" & Chr(10)
    form.Code = form.Code & "    IF lstItems.SelectedIndex >= 0 THEN" & Chr(10)
    form.Code = form.Code & "        msg = msg & " & Chr(34) & " Fruit: " & Chr(34) & " & lstItems.SelectedItem" & Chr(10)
    form.Code = form.Code & "    ENDIF" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = msg" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB btnCancel_Click()" & Chr(10)
    form.Code = form.Code & "    ' Reset the form" & Chr(10)
    form.Code = form.Code & "    txtInput.Text = " & Chr(34) & Chr(34) & Chr(10)
    form.Code = form.Code & "    chkOption.Checked = FALSE" & Chr(10)
    form.Code = form.Code & "    optChoice1.Selected = TRUE" & Chr(10)
    form.Code = form.Code & "    optChoice2.Selected = FALSE" & Chr(10)
    form.Code = form.Code & "    lstItems.SelectedIndex = 0" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Form Reset!" & Chr(34) & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB chkOption_Click()" & Chr(10)
    form.Code = form.Code & "    ' Toggle feedback" & Chr(10)
    form.Code = form.Code & "    IF chkOption.Checked THEN" & Chr(10)
    form.Code = form.Code & "        lblTitle.Caption = " & Chr(34) & "Feature Enabled!" & Chr(34) & Chr(10)
    form.Code = form.Code & "    ELSE" & Chr(10)
    form.Code = form.Code & "        lblTitle.Caption = " & Chr(34) & "Feature Disabled" & Chr(34) & Chr(10)
    form.Code = form.Code & "    ENDIF" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB optChoice1_Click()" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Option A selected" & Chr(34) & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB optChoice2_Click()" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Option B selected" & Chr(34) & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB lstItems_Click()" & Chr(10)
    form.Code = form.Code & "    ' Show selected item" & Chr(10)
    form.Code = form.Code & "    IF lstItems.SelectedIndex >= 0 THEN" & Chr(10)
    form.Code = form.Code & "        lblTitle.Caption = " & Chr(34) & "Selected: " & Chr(34) & " & lstItems.SelectedItem" & Chr(10)
    form.Code = form.Code & "    ENDIF" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB xPath_Change()" & Chr(10)
    form.Code = form.Code & "    ' Sync directories widget when path changes" & Chr(10)
    form.Code = form.Code & "    xDir.Path = xPath.Path" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Path: " & Chr(34) & " & xPath.Path" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB xPath_Enter()" & Chr(10)
    form.Code = form.Code & "    ' Navigate to path when Enter pressed" & Chr(10)
    form.Code = form.Code & "    xDir.Path = xPath.Path" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB xDir_Change()" & Chr(10)
    form.Code = form.Code & "    ' Update path widget when directory changes" & Chr(10)
    form.Code = form.Code & "    xPath.Path = xDir.Path" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Dir: " & Chr(34) & " & xDir.Path" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB xDir_Enter()" & Chr(10)
    form.Code = form.Code & "    ' Show selected directory" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Selected: " & Chr(34) & " & xDir.SelectedDir" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10)
    form.NextCtrlID = 1

    ' Add sample controls to demonstrate features
    DIM ctrl AS VDBControl

    ' Title label at top
    ctrl = NewControl(CTRL_LABEL, "lblTitle", 2, 1)
    ctrl.Caption = "VDBTerm Demo"
    ctrl.Width = 20
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Text input field
    ctrl = NewControl(CTRL_TEXTBOX, "txtInput", 2, 3)
    ctrl.Width = 25
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Buttons
    ctrl = NewControl(CTRL_BUTTON, "btnOK", 2, 5)
    ctrl.Caption = "OK"
    ctrl.Width = 10
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ctrl = NewControl(CTRL_BUTTON, "btnCancel", 14, 5)
    ctrl.Caption = "Cancel"
    ctrl.Width = 10
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Checkbox
    ctrl = NewControl(CTRL_CHECKBOX, "chkOption", 2, 8)
    ctrl.Caption = "Enable feature"
    ctrl.Width = 18
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Option buttons
    ctrl = NewControl(CTRL_OPTION, "optChoice1", 2, 10)
    ctrl.Caption = "Option A"
    ctrl.Width = 12
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ctrl = NewControl(CTRL_OPTION, "optChoice2", 2, 11)
    ctrl.Caption = "Option B"
    ctrl.Width = 12
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' ListBox
    ctrl = NewControl(CTRL_LISTBOX, "lstItems", 30, 3)
    ctrl.Width = 18
    ctrl.Height = 6
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Frame to group controls
    ctrl = NewControl(CTRL_FRAME, "fraGroup", 28, 1)
    ctrl.Caption = "Options"
    ctrl.Width = 22
    ctrl.Height = 10
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Path widget for directory navigation
    ctrl = NewControl(CTRL_PATH, "xPath", 2, 13)
    ctrl.Width = 56
    ctrl.Height = 1
    ctrl.Value = "/"
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Directories widget
    ctrl = NewControl(CTRL_DIRECTORIES, "xDir", 2, 14)
    ctrl.Width = 56
    ctrl.Height = 5
    ctrl.Value = "/"
    ctrl.ZOrder = form.NextCtrlID
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    proj.Forms = APPEND(proj.Forms, form)
    RETURN proj
END FUNCTION

FUNCTION NewForm(name AS STRING) AS VDBForm
    DIM form AS VDBForm
    form.Name = name
    form.Caption = name
    form.X = 0
    form.Y = 0
    form.Width = 60
    form.Height = 20
    form.ForeColor = 0
    form.BackColor = 7
    form.Code = "' " & name & " Code" & Chr(10) & Chr(10) & "SUB Form_Load()" & Chr(10) & "    ' Initialization code here" & Chr(10) & "END SUB" & Chr(10)
    form.NextCtrlID = 1
    RETURN form
END FUNCTION

FUNCTION NewModule(name AS STRING) AS VDBModule
    DIM newMod AS VDBModule
    newMod.Name = name
    newMod.Code = "' " & name & " Module" & Chr(10) & Chr(10) & "' Shared functions and subroutines" & Chr(10)
    RETURN newMod
END FUNCTION

FUNCTION NewControl(ctlType AS INTEGER, name AS STRING, x AS INTEGER, y AS INTEGER) AS VDBControl
    DIM ctrl AS VDBControl
    ctrl.CtlType = ctlType
    ctrl.CtlName = name
    ctrl.X = x
    ctrl.Y = y
    ctrl.Enabled = TRUE
    ctrl.Visible = TRUE
    ctrl.ForeColor = 0
    ctrl.BackColor = 7

    ' Set TabStop based on whether control is focusable
    ' Focusable: Button, TextBox, TextArea, CheckBox, Option, ListBox, ComboBox, DirBrowser, Path, Directories, Files
    IF ctlType = CTRL_BUTTON OR ctlType = CTRL_TEXTBOX OR ctlType = CTRL_TEXTAREA OR ctlType = CTRL_CHECKBOX OR ctlType = CTRL_OPTION OR ctlType = CTRL_LISTBOX OR ctlType = CTRL_COMBOBOX OR ctlType = CTRL_DIRBROWSER OR ctlType = CTRL_PATH OR ctlType = CTRL_DIRECTORIES OR ctlType = CTRL_FILES THEN
        ctrl.TabStop = TRUE
    ELSE
        ctrl.TabStop = FALSE
    ENDIF

    ' Set default sizes and bubbles properties based on type
    IF ctlType = CTRL_BUTTON THEN
        ctrl.Width = 10
        ctrl.Height = 3
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_LABEL THEN
        ctrl.Width = 8
        ctrl.Height = 1
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        ctrl.Width = 15
        ctrl.Height = 1
        ctrl.Value = ""
        ' textinput.Model properties
        ctrl.Placeholder = ""
        ctrl.CharLimit = 256
        ctrl.EchoMode = 0       ' 0=Normal, 1=Password, 2=None
        ctrl.Prompt = "> "
        ctrl.CursorBlink = TRUE
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        ctrl.Width = 12
        ctrl.Height = 1
        ctrl.Caption = name
        ctrl.Value = "0"
    ELSEIF ctlType = CTRL_OPTION THEN
        ctrl.Width = 12
        ctrl.Height = 1
        ctrl.Caption = name
        ctrl.Value = "0"
        ctrl.GroupName = "default"
    ELSEIF ctlType = CTRL_LISTBOX THEN
        ctrl.Width = 15
        ctrl.Height = 5
        ' list.Model properties
        ctrl.ShowTitle = FALSE
        ctrl.ShowStatusBar = FALSE
        ctrl.ShowFilter = FALSE
        ctrl.Items = ""
        ctrl.Title = ""
        ctrl.InfiniteScrolling = FALSE
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        ctrl.Width = 15
        ctrl.Height = 1
        ctrl.ShowFilter = TRUE
        ctrl.Items = ""
    ELSEIF ctlType = CTRL_FRAME THEN
        ctrl.Width = 20
        ctrl.Height = 8
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_HSCROLL THEN
        ctrl.Width = 15
        ctrl.Height = 1
        ctrl.Value = "0"
        ctrl.MinValue = 0
        ctrl.MaxValue = 100
    ELSEIF ctlType = CTRL_VSCROLL THEN
        ctrl.Width = 1
        ctrl.Height = 8
        ctrl.Value = "0"
        ctrl.MinValue = 0
        ctrl.MaxValue = 100
    ELSEIF ctlType = CTRL_TIMER THEN
        ctrl.Width = 3
        ctrl.Height = 1
        ctrl.Interval = 1000
        ctrl.Enabled = FALSE
        ctrl.Visible = FALSE
    ELSEIF ctlType = CTRL_TEXTAREA THEN
        ctrl.Width = 30
        ctrl.Height = 8
        ctrl.Value = ""
        ctrl.Placeholder = ""
        ctrl.CharLimit = 0      ' 0 = no limit
        ctrl.ShowLineNumbers = FALSE
    ELSEIF ctlType = CTRL_PROGRESS THEN
        ctrl.Width = 20
        ctrl.Height = 1
        ctrl.Value = "0"
        ctrl.Total = 100
        ctrl.ShowPercentage = TRUE
    ELSEIF ctlType = CTRL_SPINNER THEN
        ctrl.Width = 3
        ctrl.Height = 1
        ctrl.SpinnerStyle = 0   ' 0=Line, 1=Dot, 2=MiniDot, 3=Jump, 4=Pulse, 5=Points
    ELSEIF ctlType = CTRL_TABLE THEN
        ctrl.Width = 40
        ctrl.Height = 8
        ctrl.Columns = "Column1;Column2;Column3"
        ctrl.Rows = ""
        ctrl.ShowHeaders = TRUE
    ELSEIF ctlType = CTRL_DIRBROWSER THEN
        ctrl.Width = 30
        ctrl.Height = 10
        ctrl.FilePath = "."
        ctrl.ShowHidden = FALSE
    ELSEIF ctlType = CTRL_PATH THEN
        ctrl.Width = 30
        ctrl.Height = 3
        ctrl.FilePath = "."
        ctrl.LinkedControl = ""
    ELSEIF ctlType = CTRL_DIRECTORIES THEN
        ctrl.Width = 30
        ctrl.Height = 10
        ctrl.FilePath = "."
        ctrl.ShowHidden = FALSE
        ctrl.LinkedControl = ""
    ELSEIF ctlType = CTRL_FILES THEN
        ctrl.Width = 30
        ctrl.Height = 10
        ctrl.FilePath = "."
        ctrl.ShowHidden = FALSE
        ctrl.Pattern = "*"
        ctrl.LinkedControl = ""
    ELSEIF ctlType = CTRL_CURL THEN
        ctrl.Width = 3
        ctrl.Height = 1
        ctrl.URL = ""
        ctrl.HttpMethod = "GET"
        ctrl.Visible = FALSE
    ENDIF

    RETURN ctrl
END FUNCTION

' Serialize theme to JSON
FUNCTION SerializeTheme(theme AS VDBTheme) AS STRING
    DIM result AS STRING = ""
    DIM q AS STRING = Chr(34)
    result = result & "    " & q & "name" & q & ": " & q & theme.Name & q & "," & Chr(10)
    result = result & "    " & q & "formForeColor" & q & ": " & Str(theme.FormForeColor) & "," & Chr(10)
    result = result & "    " & q & "formBackColor" & q & ": " & Str(theme.FormBackColor) & "," & Chr(10)
    result = result & "    " & q & "buttonForeColor" & q & ": " & Str(theme.ButtonForeColor) & "," & Chr(10)
    result = result & "    " & q & "buttonBackColor" & q & ": " & Str(theme.ButtonBackColor) & "," & Chr(10)
    result = result & "    " & q & "labelForeColor" & q & ": " & Str(theme.LabelForeColor) & "," & Chr(10)
    result = result & "    " & q & "labelBackColor" & q & ": " & Str(theme.LabelBackColor) & "," & Chr(10)
    result = result & "    " & q & "textBoxForeColor" & q & ": " & Str(theme.TextBoxForeColor) & "," & Chr(10)
    result = result & "    " & q & "textBoxBackColor" & q & ": " & Str(theme.TextBoxBackColor) & "," & Chr(10)
    result = result & "    " & q & "checkBoxForeColor" & q & ": " & Str(theme.CheckBoxForeColor) & "," & Chr(10)
    result = result & "    " & q & "checkBoxBackColor" & q & ": " & Str(theme.CheckBoxBackColor) & "," & Chr(10)
    result = result & "    " & q & "optionForeColor" & q & ": " & Str(theme.OptionForeColor) & "," & Chr(10)
    result = result & "    " & q & "optionBackColor" & q & ": " & Str(theme.OptionBackColor) & "," & Chr(10)
    result = result & "    " & q & "listBoxForeColor" & q & ": " & Str(theme.ListBoxForeColor) & "," & Chr(10)
    result = result & "    " & q & "listBoxBackColor" & q & ": " & Str(theme.ListBoxBackColor) & "," & Chr(10)
    result = result & "    " & q & "comboBoxForeColor" & q & ": " & Str(theme.ComboBoxForeColor) & "," & Chr(10)
    result = result & "    " & q & "comboBoxBackColor" & q & ": " & Str(theme.ComboBoxBackColor) & "," & Chr(10)
    result = result & "    " & q & "frameForeColor" & q & ": " & Str(theme.FrameForeColor) & "," & Chr(10)
    result = result & "    " & q & "frameBackColor" & q & ": " & Str(theme.FrameBackColor) & "," & Chr(10)
    result = result & "    " & q & "textAreaForeColor" & q & ": " & Str(theme.TextAreaForeColor) & "," & Chr(10)
    result = result & "    " & q & "textAreaBackColor" & q & ": " & Str(theme.TextAreaBackColor) & "," & Chr(10)
    result = result & "    " & q & "progressForeColor" & q & ": " & Str(theme.ProgressForeColor) & "," & Chr(10)
    result = result & "    " & q & "progressBackColor" & q & ": " & Str(theme.ProgressBackColor) & "," & Chr(10)
    result = result & "    " & q & "spinnerForeColor" & q & ": " & Str(theme.SpinnerForeColor) & "," & Chr(10)
    result = result & "    " & q & "spinnerBackColor" & q & ": " & Str(theme.SpinnerBackColor) & "," & Chr(10)
    result = result & "    " & q & "pathForeColor" & q & ": " & Str(theme.PathForeColor) & "," & Chr(10)
    result = result & "    " & q & "pathBackColor" & q & ": " & Str(theme.PathBackColor) & "," & Chr(10)
    result = result & "    " & q & "directoriesForeColor" & q & ": " & Str(theme.DirectoriesForeColor) & "," & Chr(10)
    result = result & "    " & q & "directoriesBackColor" & q & ": " & Str(theme.DirectoriesBackColor) & "," & Chr(10)
    result = result & "    " & q & "filesForeColor" & q & ": " & Str(theme.FilesForeColor) & "," & Chr(10)
    result = result & "    " & q & "filesBackColor" & q & ": " & Str(theme.FilesBackColor) & "," & Chr(10)
    result = result & "    " & q & "dirBrowserForeColor" & q & ": " & Str(theme.DirBrowserForeColor) & "," & Chr(10)
    result = result & "    " & q & "dirBrowserBackColor" & q & ": " & Str(theme.DirBrowserBackColor) & "," & Chr(10)
    result = result & "    " & q & "focusedForeColor" & q & ": " & Str(theme.FocusedForeColor) & "," & Chr(10)
    result = result & "    " & q & "focusedBackColor" & q & ": " & Str(theme.FocusedBackColor) & "," & Chr(10)
    result = result & "    " & q & "selectedForeColor" & q & ": " & Str(theme.SelectedForeColor) & "," & Chr(10)
    result = result & "    " & q & "selectedBackColor" & q & ": " & Str(theme.SelectedBackColor) & "," & Chr(10)
    result = result & "    " & q & "menuForeColor" & q & ": " & Str(theme.MenuForeColor) & "," & Chr(10)
    result = result & "    " & q & "menuBackColor" & q & ": " & Str(theme.MenuBackColor) & "," & Chr(10)
    result = result & "    " & q & "menuSelectedForeColor" & q & ": " & Str(theme.MenuSelectedForeColor) & "," & Chr(10)
    result = result & "    " & q & "menuSelectedBackColor" & q & ": " & Str(theme.MenuSelectedBackColor) & "," & Chr(10)
    result = result & "    " & q & "menuShortcutForeColor" & q & ": " & Str(theme.MenuShortcutForeColor) & "," & Chr(10)
    IF theme.Use256Colors THEN
        result = result & "    " & q & "use256Colors" & q & ": true" & Chr(10)
    ELSE
        result = result & "    " & q & "use256Colors" & q & ": false" & Chr(10)
    ENDIF
    RETURN result
END FUNCTION

' Serialize project to JSON string (new format: form names only)
FUNCTION SerializeProject(proj AS VDBProject) AS STRING
    DIM result AS STRING = "{" & Chr(10)
    DIM q AS STRING = Chr(34)
    result = result & "  " & q & "name" & q & ": " & q & proj.Name & q & "," & Chr(10)
    result = result & "  " & q & "startupForm" & q & ": " & q & proj.StartupForm & q & "," & Chr(10)

    ' Theme settings
    IF proj.UseTheme THEN
        result = result & "  " & q & "useTheme" & q & ": true," & Chr(10)
    ELSE
        result = result & "  " & q & "useTheme" & q & ": false," & Chr(10)
    ENDIF
    result = result & "  " & q & "theme" & q & ": {" & Chr(10)
    result = result & SerializeTheme(proj.Theme)
    result = result & "  }," & Chr(10)

    ' Forms array - just form names (new format)
    result = result & "  " & q & "forms" & q & ": [" & Chr(10)
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        result = result & "    " & q & proj.Forms[i].Name & q
        IF i < Len(proj.Forms) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]," & Chr(10)

    ' Modules array - just module names
    result = result & "  " & q & "modules" & q & ": [" & Chr(10)
    FOR i = 0 TO Len(proj.Modules) - 1
        result = result & "    " & q & proj.Modules[i].Name & q
        IF i < Len(proj.Modules) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]" & Chr(10)

    result = result & "}"
    RETURN result
END FUNCTION

' Serialize a single form to JSON (full definition with controls and code)
FUNCTION SerializeForm(f AS VDBForm) AS STRING
    DIM result AS STRING = "{" & Chr(10)
    DIM q AS STRING = Chr(34)

    result = result & "  " & q & "name" & q & ": " & q & f.Name & q & "," & Chr(10)
    result = result & "  " & q & "caption" & q & ": " & q & EscapeJSONString(f.Caption) & q & "," & Chr(10)
    result = result & "  " & q & "width" & q & ": " & Str(f.Width) & "," & Chr(10)
    result = result & "  " & q & "height" & q & ": " & Str(f.Height) & "," & Chr(10)
    result = result & "  " & q & "foreColor" & q & ": " & Str(f.ForeColor) & "," & Chr(10)
    result = result & "  " & q & "backColor" & q & ": " & Str(f.BackColor) & "," & Chr(10)
    result = result & "  " & q & "controls" & q & ": [" & Chr(10)

    DIM j AS INTEGER
    FOR j = 0 TO Len(f.Controls) - 1
        DIM c AS VDBControl = f.Controls[j]
        result = result & "    {" & Chr(10)
        result = result & "      " & q & "id" & q & ": " & Str(c.ID) & "," & Chr(10)
        result = result & "      " & q & "type" & q & ": " & Str(c.CtlType) & "," & Chr(10)
        result = result & "      " & q & "name" & q & ": " & q & c.CtlName & q & "," & Chr(10)
        result = result & "      " & q & "caption" & q & ": " & q & EscapeJSONString(c.Caption) & q & "," & Chr(10)
        result = result & "      " & q & "x" & q & ": " & Str(c.X) & "," & Chr(10)
        result = result & "      " & q & "y" & q & ": " & Str(c.Y) & "," & Chr(10)
        result = result & "      " & q & "width" & q & ": " & Str(c.Width) & "," & Chr(10)
        result = result & "      " & q & "height" & q & ": " & Str(c.Height) & "," & Chr(10)
        result = result & "      " & q & "foreColor" & q & ": " & Str(c.ForeColor) & "," & Chr(10)
        result = result & "      " & q & "backColor" & q & ": " & Str(c.BackColor) & "," & Chr(10)
        result = result & "      " & q & "tabIndex" & q & ": " & Str(c.TabIndex) & "," & Chr(10)
        IF c.TabStop THEN
            result = result & "      " & q & "tabStop" & q & ": true," & Chr(10)
        ELSE
            result = result & "      " & q & "tabStop" & q & ": false," & Chr(10)
        ENDIF
        IF c.Enabled THEN
            result = result & "      " & q & "enabled" & q & ": true," & Chr(10)
        ELSE
            result = result & "      " & q & "enabled" & q & ": false," & Chr(10)
        ENDIF
        IF c.Visible THEN
            result = result & "      " & q & "visible" & q & ": true"
        ELSE
            result = result & "      " & q & "visible" & q & ": false"
        ENDIF
        ' Add type-specific properties
        IF c.CtlType = CTRL_TIMER THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "interval" & q & ": " & Str(c.Interval) & Chr(10)
        ELSEIF c.CtlType = CTRL_DIRBROWSER THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "path" & q & ": " & q & c.FilePath & q & "," & Chr(10)
            IF c.ShowHidden THEN
                result = result & "      " & q & "showHidden" & q & ": true" & Chr(10)
            ELSE
                result = result & "      " & q & "showHidden" & q & ": false" & Chr(10)
            ENDIF
        ELSEIF c.CtlType = CTRL_PATH THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "path" & q & ": " & q & c.FilePath & q & "," & Chr(10)
            result = result & "      " & q & "linkedPath" & q & ": " & q & c.LinkedControl & q & Chr(10)
        ELSEIF c.CtlType = CTRL_DIRECTORIES THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "path" & q & ": " & q & c.FilePath & q & "," & Chr(10)
            IF c.ShowHidden THEN
                result = result & "      " & q & "showHidden" & q & ": true," & Chr(10)
            ELSE
                result = result & "      " & q & "showHidden" & q & ": false," & Chr(10)
            ENDIF
            result = result & "      " & q & "linkedPath" & q & ": " & q & c.LinkedControl & q & Chr(10)
        ELSEIF c.CtlType = CTRL_FILES THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "path" & q & ": " & q & c.FilePath & q & "," & Chr(10)
            IF c.ShowHidden THEN
                result = result & "      " & q & "showHidden" & q & ": true," & Chr(10)
            ELSE
                result = result & "      " & q & "showHidden" & q & ": false," & Chr(10)
            ENDIF
            result = result & "      " & q & "pattern" & q & ": " & q & c.Pattern & q & "," & Chr(10)
            result = result & "      " & q & "linkedPath" & q & ": " & q & c.LinkedControl & q & Chr(10)
        ELSEIF c.CtlType = CTRL_CURL THEN
            result = result & "," & Chr(10)
            result = result & "      " & q & "url" & q & ": " & q & EscapeJSONString(c.URL) & q & "," & Chr(10)
            result = result & "      " & q & "httpMethod" & q & ": " & q & c.HttpMethod & q & Chr(10)
        ELSEIF c.CtlType >= PLUGIN_TYPE_START THEN
            ' Plugin widget - save plugin type ID and extended properties
            result = result & "," & Chr(10)
            result = result & "      " & q & "pluginTypeID" & q & ": " & q & c.PluginTypeID & q
            IF c.ExtendedProps <> "" THEN
                result = result & "," & Chr(10)
                result = result & "      " & q & "extendedProps" & q & ": " & c.ExtendedProps & Chr(10)
            ELSE
                result = result & Chr(10)
            ENDIF
        ELSE
            result = result & Chr(10)
        ENDIF
        result = result & "    }"
        IF j < Len(f.Controls) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT

    result = result & "  ]," & Chr(10)

    ' Code field - escaped for JSON
    result = result & "  " & q & "code" & q & ": " & q & EscapeJSONString(f.Code) & q & Chr(10)

    result = result & "}"
    RETURN result
END FUNCTION

' Save project to file (new format: forms in separate .frm files with full definition)
SUB SaveProject(proj AS POINTER TO VDBProject, path AS STRING)
    ' Get directory from path
    DIM dir AS STRING = GetDirectory(path)

    ' Ensure directory exists
    EnsureDirectory(dir)

    ' Save main project file (just form names, not definitions)
    DIM projJson AS STRING = SerializeProject(^proj)
    WriteFile(path, projJson)

    ' Save form files with full JSON definition + code
    DIM i AS INTEGER
    FOR i = 0 TO Len((^proj).Forms) - 1
        DIM f AS VDBForm = (^proj).Forms[i]
        DIM formPath AS STRING = dir & f.Name & ".frm"
        DIM formJson AS STRING = SerializeForm(f)
        WriteFile(formPath, formJson)
    NEXT

    ' Save module code files
    FOR i = 0 TO Len((^proj).Modules) - 1
        DIM modFile AS VDBModule = (^proj).Modules[i]
        DIM modPath AS STRING = dir & modFile.Name & ".bas"
        WriteFile(modPath, modFile.Code)
    NEXT

    (^proj).Path = path
    (^proj).Modified = FALSE
END SUB

' Save project as a widget plugin (new format: forms in separate .frm files)
SUB SaveProjectAsWidget(proj AS POINTER TO VDBProject, path AS STRING)
    ' Ensure plugins/widgets directory exists
    EnsureDirectory("plugins")
    EnsureDirectory("plugins/widgets")

    ' Get widget directory from path
    DIM dir AS STRING = GetDirectory(path)
    EnsureDirectory(dir)

    ' Serialize with widgetMeta section (just form names)
    DIM projJson AS STRING = SerializeProjectAsWidget(^proj)
    WriteFile(path, projJson)

    ' Save form files with full JSON definition + code
    DIM i AS INTEGER
    FOR i = 0 TO Len((^proj).Forms) - 1
        DIM f AS VDBForm = (^proj).Forms[i]
        DIM formPath AS STRING = dir & f.Name & ".frm"
        DIM formJson AS STRING = SerializeForm(f)
        WriteFile(formPath, formJson)
    NEXT

    ' Save module code files
    FOR i = 0 TO Len((^proj).Modules) - 1
        DIM modFile AS VDBModule = (^proj).Modules[i]
        DIM modPath AS STRING = dir & modFile.Name & ".bas"
        WriteFile(modPath, modFile.Code)
    NEXT

    (^proj).Modified = FALSE
END SUB

' Serialize project as widget with widgetMeta section (new format: form names only)
FUNCTION SerializeProjectAsWidget(proj AS VDBProject) AS STRING
    DIM result AS STRING = "{" & Chr(10)
    DIM q AS STRING = Chr(34)

    ' Widget metadata section
    result = result & "  " & q & "widgetMeta" & q & ": {" & Chr(10)
    result = result & "    " & q & "id" & q & ": " & q & LCase(proj.Name) & q & "," & Chr(10)
    result = result & "    " & q & "name" & q & ": " & q & proj.Name & q & "," & Chr(10)
    result = result & "    " & q & "icon" & q & ": " & q & "[" & UCase(Left(proj.Name, 1)) & "] " & q & "," & Chr(10)
    result = result & "    " & q & "category" & q & ": " & q & "visible" & q & "," & Chr(10)
    result = result & "    " & q & "description" & q & ": " & q & "Custom widget: " & proj.Name & q & Chr(10)
    result = result & "  }," & Chr(10)

    ' Standard project fields
    result = result & "  " & q & "name" & q & ": " & q & proj.Name & q & "," & Chr(10)
    result = result & "  " & q & "startupForm" & q & ": " & q & proj.StartupForm & q & "," & Chr(10)

    ' Forms array - just form names (new format)
    result = result & "  " & q & "forms" & q & ": [" & Chr(10)
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        result = result & "    " & q & proj.Forms[i].Name & q
        IF i < Len(proj.Forms) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]," & Chr(10)

    ' Modules array - just module names
    result = result & "  " & q & "modules" & q & ": [" & Chr(10)
    FOR i = 0 TO Len(proj.Modules) - 1
        result = result & "    " & q & proj.Modules[i].Name & q
        IF i < Len(proj.Modules) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]" & Chr(10)

    result = result & "}"
    RETURN result
END FUNCTION

' Ensure directory exists
SUB EnsureDirectory(path AS STRING)
    ' Use os.MkdirAll to create directory if not exists
    DIM _ AS error = os.MkdirAll(path, 493)
    ' Ignore error if directory already exists
END SUB

' Load project from file (supports both old and new format)
FUNCTION LoadProject(path AS STRING) AS (VDBProject, STRING)
    DIM proj AS VDBProject

    ' Read the project JSON file
    DIM content AS STRING = ReadFile(path)
    IF content = "" THEN
        RETURN proj, "Failed to read file: " & path
    ENDIF

    ' Get directory from path for loading files
    DIM dir AS STRING = GetDirectory(path)

    ' Detect format: new format has forms as strings, old format has forms as objects
    DIM isNewFormat AS BOOLEAN = IsNewProjectFormat(content)

    IF isNewFormat THEN
        ' New format: parse project, then load each .frm file with full definition
        proj = ParseProjectJSONNewFormat(content)
        proj.Path = path
        proj.Modified = FALSE

        ' Load form files (JSON with full definition + code)
        DIM i AS INTEGER
        FOR i = 0 TO Len(proj.Forms) - 1
            DIM formName AS STRING = proj.Forms[i].Name
            DIM frmPath AS STRING = dir & formName & ".frm"
            DIM frmContent AS STRING = ReadFile(frmPath)
            IF frmContent <> "" THEN
                ' Parse .frm JSON file with full definition
                proj.Forms[i] = ParseFormFile(frmContent)
            ENDIF
        NEXT

        ' Load module code files
        FOR i = 0 TO Len(proj.Modules) - 1
            DIM modPath AS STRING = dir & proj.Modules[i].Name & ".bas"
            DIM modContent AS STRING = ReadFile(modPath)
            IF modContent <> "" THEN
                proj.Modules[i].Code = modContent
            ENDIF
        NEXT
    ELSE
        ' Old format: parse embedded form definitions, then load .frm code files
        proj = ParseProjectJSON(content)
        proj.Path = path
        proj.Modified = FALSE

        ' Load form code files (old format: .frm contains just code)
        DIM j AS INTEGER
        FOR j = 0 TO Len(proj.Forms) - 1
            DIM frmPath2 AS STRING = dir & proj.Forms[j].Name & ".frm"
            DIM frmContent2 AS STRING = ReadFile(frmPath2)
            IF frmContent2 <> "" THEN
                proj.Forms[j].Code = frmContent2
            ELSE
                proj.Forms[j].Code = "' " & proj.Forms[j].Name & " Code" & Chr(10)
            ENDIF
        NEXT

        ' Load module code files
        FOR j = 0 TO Len(proj.Modules) - 1
            DIM modPath2 AS STRING = dir & proj.Modules[j].Name & ".bas"
            DIM modContent2 AS STRING = ReadFile(modPath2)
            IF modContent2 <> "" THEN
                proj.Modules[j].Code = modContent2
            ENDIF
        NEXT
    ENDIF

    RETURN proj, ""
END FUNCTION

' Detect if project file uses new format (forms as strings) or old format (forms as objects)
FUNCTION IsNewProjectFormat(js AS STRING) AS BOOLEAN
    ' Find the forms array start
    DIM formsStart AS INTEGER = InStrPos(1, js, Chr(34) & "forms" & Chr(34))
    IF formsStart = 0 THEN
        RETURN FALSE
    ENDIF

    ' Find the opening bracket
    DIM bracketPos AS INTEGER = InStrPos(formsStart, js, "[")
    IF bracketPos = 0 THEN
        RETURN FALSE
    ENDIF

    ' Skip whitespace after bracket
    DIM pos AS INTEGER = bracketPos + 1
    WHILE pos <= Len(js) AND (Mid(js, pos, 1) = " " OR Mid(js, pos, 1) = Chr(10) OR Mid(js, pos, 1) = Chr(9))
        pos = pos + 1
    WEND

    ' Check first non-whitespace character after [
    ' New format: starts with " (string)
    ' Old format: starts with { (object)
    DIM ch AS STRING = Mid(js, pos, 1)
    IF ch = Chr(34) THEN
        RETURN TRUE  ' New format: form names as strings
    ELSEIF ch = "{" THEN
        RETURN FALSE ' Old format: forms as objects
    ELSEIF ch = "]" THEN
        RETURN TRUE  ' Empty array - treat as new format
    ENDIF

    RETURN FALSE
END FUNCTION

' Parse theme from JSON object string
FUNCTION ParseTheme(js AS STRING) AS VDBTheme
    DIM theme AS VDBTheme
    theme.Name = ExtractJSONString(js, "name")
    IF theme.Name = "" THEN
        theme.Name = "Custom"
    ENDIF
    theme.FormForeColor = ExtractJSONInt(js, "formForeColor")
    theme.FormBackColor = ExtractJSONInt(js, "formBackColor")
    theme.ButtonForeColor = ExtractJSONInt(js, "buttonForeColor")
    theme.ButtonBackColor = ExtractJSONInt(js, "buttonBackColor")
    theme.LabelForeColor = ExtractJSONInt(js, "labelForeColor")
    theme.LabelBackColor = ExtractJSONInt(js, "labelBackColor")
    theme.TextBoxForeColor = ExtractJSONInt(js, "textBoxForeColor")
    theme.TextBoxBackColor = ExtractJSONInt(js, "textBoxBackColor")
    theme.CheckBoxForeColor = ExtractJSONInt(js, "checkBoxForeColor")
    theme.CheckBoxBackColor = ExtractJSONInt(js, "checkBoxBackColor")
    theme.OptionForeColor = ExtractJSONInt(js, "optionForeColor")
    theme.OptionBackColor = ExtractJSONInt(js, "optionBackColor")
    theme.ListBoxForeColor = ExtractJSONInt(js, "listBoxForeColor")
    theme.ListBoxBackColor = ExtractJSONInt(js, "listBoxBackColor")
    theme.ComboBoxForeColor = ExtractJSONInt(js, "comboBoxForeColor")
    theme.ComboBoxBackColor = ExtractJSONInt(js, "comboBoxBackColor")
    theme.FrameForeColor = ExtractJSONInt(js, "frameForeColor")
    theme.FrameBackColor = ExtractJSONInt(js, "frameBackColor")
    theme.TextAreaForeColor = ExtractJSONInt(js, "textAreaForeColor")
    theme.TextAreaBackColor = ExtractJSONInt(js, "textAreaBackColor")
    theme.ProgressForeColor = ExtractJSONInt(js, "progressForeColor")
    theme.ProgressBackColor = ExtractJSONInt(js, "progressBackColor")
    theme.SpinnerForeColor = ExtractJSONInt(js, "spinnerForeColor")
    theme.SpinnerBackColor = ExtractJSONInt(js, "spinnerBackColor")
    theme.PathForeColor = ExtractJSONInt(js, "pathForeColor")
    theme.PathBackColor = ExtractJSONInt(js, "pathBackColor")
    theme.DirectoriesForeColor = ExtractJSONInt(js, "directoriesForeColor")
    theme.DirectoriesBackColor = ExtractJSONInt(js, "directoriesBackColor")
    theme.FilesForeColor = ExtractJSONInt(js, "filesForeColor")
    theme.FilesBackColor = ExtractJSONInt(js, "filesBackColor")
    theme.DirBrowserForeColor = ExtractJSONInt(js, "dirBrowserForeColor")
    theme.DirBrowserBackColor = ExtractJSONInt(js, "dirBrowserBackColor")
    theme.FocusedForeColor = ExtractJSONInt(js, "focusedForeColor")
    theme.FocusedBackColor = ExtractJSONInt(js, "focusedBackColor")
    theme.SelectedForeColor = ExtractJSONInt(js, "selectedForeColor")
    theme.SelectedBackColor = ExtractJSONInt(js, "selectedBackColor")
    theme.MenuForeColor = ExtractJSONInt(js, "menuForeColor")
    theme.MenuBackColor = ExtractJSONInt(js, "menuBackColor")
    theme.MenuSelectedForeColor = ExtractJSONInt(js, "menuSelectedForeColor")
    theme.MenuSelectedBackColor = ExtractJSONInt(js, "menuSelectedBackColor")
    theme.MenuShortcutForeColor = ExtractJSONInt(js, "menuShortcutForeColor")
    theme.Use256Colors = ExtractJSONBool(js, "use256Colors")
    RETURN theme
END FUNCTION

' Parse project JSON in new format (forms and modules as name strings)
FUNCTION ParseProjectJSONNewFormat(js AS STRING) AS VDBProject
    DIM proj AS VDBProject

    ' Extract project name
    proj.Name = ExtractJSONString(js, "name")
    proj.StartupForm = ExtractJSONString(js, "startupForm")

    ' Parse theme settings
    proj.UseTheme = ExtractJSONBool(js, "useTheme")
    DIM themeJs AS STRING = ExtractJSONObject(js, "theme")
    IF themeJs <> "" THEN
        proj.Theme = ParseTheme(themeJs)
    ELSE
        proj.Theme = NewDefaultTheme()
    ENDIF

    ' Parse forms array (array of strings)
    DIM formNames AS []STRING = ParseStringArray(js, "forms")
    DIM i AS INTEGER
    FOR i = 0 TO Len(formNames) - 1
        DIM form AS VDBForm
        form.Name = formNames[i]
        form.Caption = formNames[i]
        form.Width = 60
        form.Height = 20
        form.ForeColor = 0
        form.BackColor = 7
        form.Code = "' " & formNames[i] & " Code" & Chr(10)
        form.NextCtrlID = 1
        proj.Forms = APPEND(proj.Forms, form)
    NEXT

    ' Parse modules array (array of strings)
    DIM moduleNames AS []STRING = ParseStringArray(js, "modules")
    FOR i = 0 TO Len(moduleNames) - 1
        DIM newMod AS VDBModule
        newMod.Name = moduleNames[i]
        newMod.Code = "' " & moduleNames[i] & " Module" & Chr(10)
        proj.Modules = APPEND(proj.Modules, newMod)
    NEXT

    RETURN proj
END FUNCTION

' Parse an array of strings from JSON
FUNCTION ParseStringArray(js AS STRING, key AS STRING) AS []STRING
    DIM result AS []STRING
    DIM searchKey AS STRING = Chr(34) & key & Chr(34)
    DIM pos AS INTEGER = InStrPos(1, js, searchKey)
    IF pos = 0 THEN
        RETURN result
    ENDIF

    ' Find opening bracket
    DIM bracketPos AS INTEGER = InStrPos(pos, js, "[")
    IF bracketPos = 0 THEN
        RETURN result
    ENDIF

    ' Parse strings until closing bracket
    pos = bracketPos + 1
    DIM bslash AS STRING = Chr(92)
    WHILE pos <= Len(js)
        DIM ch AS STRING = Mid(js, pos, 1)
        IF ch = "]" THEN
            EXIT WHILE
        ELSEIF ch = Chr(34) THEN
            ' Found start of string, parse until closing quote
            DIM strStart AS INTEGER = pos + 1
            DIM strEnd AS INTEGER = strStart
            WHILE strEnd <= Len(js)
                DIM sch AS STRING = Mid(js, strEnd, 1)
                IF sch = Chr(34) THEN
                    ' Check if escaped
                    IF strEnd > 1 AND Mid(js, strEnd - 1, 1) = bslash THEN
                        strEnd = strEnd + 1
                    ELSE
                        EXIT WHILE
                    ENDIF
                ELSE
                    strEnd = strEnd + 1
                ENDIF
            WEND
            DIM strVal AS STRING = Mid(js, strStart, strEnd - strStart)
            result = APPEND(result, strVal)
            pos = strEnd + 1
        ELSE
            pos = pos + 1
        ENDIF
    WEND

    RETURN result
END FUNCTION

' Parse a .frm file (JSON with full form definition and code)
FUNCTION ParseFormFile(js AS STRING) AS VDBForm
    DIM form AS VDBForm
    form.Name = ExtractJSONString(js, "name")
    form.Caption = UnescapeJSONString(ExtractJSONString(js, "caption"))
    form.Width = ExtractJSONInt(js, "width")
    form.Height = ExtractJSONInt(js, "height")
    form.NextCtrlID = 1

    ' Read colors from JSON, default to standard colors if not present
    DIM hasForeColor AS BOOLEAN = InStrPos(1, js, Chr(34) & "foreColor" & Chr(34)) > 0
    DIM hasBackColor AS BOOLEAN = InStrPos(1, js, Chr(34) & "backColor" & Chr(34)) > 0
    IF hasForeColor THEN
        form.ForeColor = ExtractJSONInt(js, "foreColor")
    ELSE
        form.ForeColor = 0  ' Default: black
    ENDIF
    IF hasBackColor THEN
        form.BackColor = ExtractJSONInt(js, "backColor")
    ELSE
        form.BackColor = 7  ' Default: white/light gray
    ENDIF

    ' Parse controls array
    DIM ctrlStart AS INTEGER = InStrPos(1, js, Chr(34) & "controls" & Chr(34))
    IF ctrlStart > 0 THEN
        DIM ctrlArrayStart AS INTEGER = InStrPos(ctrlStart, js, "[")
        IF ctrlArrayStart > 0 THEN
            form.Controls = ParseControlsArray(js, ctrlArrayStart)
            form.NextCtrlID = Len(form.Controls) + 1
        ENDIF
    ENDIF

    ' Parse code field (escaped JSON string)
    DIM codeStr AS STRING = ExtractJSONCodeString(js)
    form.Code = UnescapeJSONString(codeStr)

    RETURN form
END FUNCTION

' Extract the code string from JSON (handles escaped characters)
FUNCTION ExtractJSONCodeString(js AS STRING) AS STRING
    DIM searchKey AS STRING = Chr(34) & "code" & Chr(34) & ":"
    DIM pos AS INTEGER = InStrPos(1, js, searchKey)
    IF pos = 0 THEN
        RETURN ""
    ENDIF

    ' Find the opening quote of the value
    pos = pos + Len(searchKey)
    WHILE pos <= Len(js) AND (Mid(js, pos, 1) = " " OR Mid(js, pos, 1) = Chr(10) OR Mid(js, pos, 1) = Chr(9))
        pos = pos + 1
    WEND

    IF Mid(js, pos, 1) <> Chr(34) THEN
        RETURN ""
    ENDIF

    ' Parse string value with escape handling
    DIM strStart AS INTEGER = pos + 1
    DIM strEnd AS INTEGER = strStart
    DIM bslash AS STRING = Chr(92)

    WHILE strEnd <= Len(js)
        DIM ch AS STRING = Mid(js, strEnd, 1)
        IF ch = Chr(34) THEN
            ' Check if escaped (preceded by odd number of backslashes)
            DIM bsCount AS INTEGER = 0
            DIM checkPos AS INTEGER = strEnd - 1
            WHILE checkPos >= strStart AND Mid(js, checkPos, 1) = bslash
                bsCount = bsCount + 1
                checkPos = checkPos - 1
            WEND
            IF bsCount MOD 2 = 0 THEN
                ' Even number of backslashes means quote is not escaped
                EXIT WHILE
            ENDIF
        ENDIF
        strEnd = strEnd + 1
    WEND

    RETURN Mid(js, strStart, strEnd - strStart)
END FUNCTION

' Get directory from path
FUNCTION GetDirectory(path AS STRING) AS STRING
    DIM lastSlash AS INTEGER = 0
    DIM i AS INTEGER
    FOR i = 1 TO Len(path)
        IF Mid(path, i, 1) = "/" THEN
            lastSlash = i
        ENDIF
    NEXT
    IF lastSlash > 0 THEN
        RETURN Left(path, lastSlash)
    ENDIF
    RETURN "./"
END FUNCTION

' Simple JSON parser for project files
FUNCTION ParseProjectJSON(js AS STRING) AS VDBProject
    DIM proj AS VDBProject

    ' Extract project name
    proj.Name = ExtractJSONString(js, "name")
    proj.StartupForm = ExtractJSONString(js, "startupForm")

    ' Parse forms array
    DIM formsStart AS INTEGER = InStrPos(1,js, "\"forms\"")
    IF formsStart > 0 THEN
        DIM formsArrayStart AS INTEGER = InStrPos(1,Mid(js, formsStart, Len(js)), "[")
        IF formsArrayStart > 0 THEN
            formsArrayStart = formsStart + formsArrayStart - 1
            proj.Forms = ParseFormsArray(js, formsArrayStart)
        ENDIF
    ENDIF

    RETURN proj
END FUNCTION

' Extract a string value from JSON (handles escaped quotes)
FUNCTION ExtractJSONString(js AS STRING, key AS STRING) AS STRING
    DIM searchKey AS STRING = Chr(34) & key & Chr(34) & ":"
    DIM pos AS INTEGER = InStrPos(1, js, searchKey)
    IF pos = 0 THEN
        RETURN ""
    ENDIF

    ' Find the opening quote of the value
    DIM valueStart AS INTEGER = pos + Len(searchKey)
    WHILE valueStart <= Len(js) AND (Mid(js, valueStart, 1) = " " OR Mid(js, valueStart, 1) = Chr(10) OR Mid(js, valueStart, 1) = Chr(9))
        valueStart = valueStart + 1
    WEND

    IF Mid(js, valueStart, 1) <> Chr(34) THEN
        RETURN ""
    ENDIF

    ' Find the closing quote (handle escaped quotes)
    DIM strStart AS INTEGER = valueStart + 1
    DIM strEnd AS INTEGER = strStart
    DIM bslash AS STRING = Chr(92)

    WHILE strEnd <= Len(js)
        DIM ch AS STRING = Mid(js, strEnd, 1)
        IF ch = Chr(34) THEN
            ' Check if escaped (preceded by odd number of backslashes)
            DIM bsCount AS INTEGER = 0
            DIM checkPos AS INTEGER = strEnd - 1
            WHILE checkPos >= strStart AND Mid(js, checkPos, 1) = bslash
                bsCount = bsCount + 1
                checkPos = checkPos - 1
            WEND
            IF bsCount MOD 2 = 0 THEN
                ' Even number of backslashes means quote is not escaped
                EXIT WHILE
            ENDIF
        ENDIF
        strEnd = strEnd + 1
    WEND

    RETURN Mid(js, strStart, strEnd - strStart)
END FUNCTION

' Extract an integer value from JSON
FUNCTION ExtractJSONInt(js AS STRING, key AS STRING) AS INTEGER
    DIM searchKey AS STRING = Chr(34) & key & Chr(34) & ":"
    DIM pos AS INTEGER = InStrPos(1,js, searchKey)
    IF pos = 0 THEN
        RETURN 0
    ENDIF

    ' Skip whitespace and get the number
    DIM numStart AS INTEGER = pos + Len(searchKey)
    WHILE numStart <= Len(js) AND (Mid(js, numStart, 1) = " " OR Mid(js, numStart, 1) = Chr(10))
        numStart = numStart + 1
    WEND

    ' Extract digits
    DIM numStr AS STRING = ""
    DIM ch AS STRING
    WHILE numStart <= Len(js)
        ch = Mid(js, numStart, 1)
        IF ch >= "0" AND ch <= "9" THEN
            numStr = numStr & ch
            numStart = numStart + 1
        ELSEIF ch = "-" AND numStr = "" THEN
            numStr = "-"
            numStart = numStart + 1
        ELSE
            EXIT WHILE
        ENDIF
    WEND

    RETURN ParseIntStr(numStr)
END FUNCTION

' Extract a boolean value from JSON
FUNCTION ExtractJSONBool(js AS STRING, key AS STRING) AS BOOLEAN
    DIM searchKey AS STRING = Chr(34) & key & Chr(34) & ":"
    DIM pos AS INTEGER = InStrPos(1, js, searchKey)
    IF pos = 0 THEN
        RETURN FALSE
    ENDIF

    ' Skip whitespace and get the value
    DIM valStart AS INTEGER = pos + Len(searchKey)
    WHILE valStart <= Len(js) AND (Mid(js, valStart, 1) = " " OR Mid(js, valStart, 1) = Chr(10))
        valStart = valStart + 1
    WEND

    ' Check for true/false
    IF Mid(js, valStart, 4) = "true" THEN
        RETURN TRUE
    ENDIF
    RETURN FALSE
END FUNCTION

' Parse forms array from JSON
FUNCTION ParseFormsArray(js AS STRING, startPos AS INTEGER) AS []VDBForm
    DIM forms AS []VDBForm
    DIM pos AS INTEGER = startPos + 1
    DIM depth AS INTEGER = 1
    DIM objectStart AS INTEGER = 0

    WHILE pos <= Len(js) AND depth > 0
        DIM ch AS STRING = Mid(js, pos, 1)
        IF ch = "{" THEN
            IF depth = 1 THEN
                objectStart = pos
            ENDIF
            depth = depth + 1
        ELSEIF ch = "}" THEN
            depth = depth - 1
            IF depth = 1 AND objectStart > 0 THEN
                DIM formJs AS STRING = Mid(js, objectStart, pos - objectStart + 1)
                DIM form AS VDBForm = ParseFormObject(formJs)
                forms = APPEND(forms, form)
                objectStart = 0
            ENDIF
        ELSEIF ch = "]" AND depth = 1 THEN
            depth = 0
        ENDIF
        pos = pos + 1
    WEND

    RETURN forms
END FUNCTION

' Parse a single form object from JSON
FUNCTION ParseFormObject(js AS STRING) AS VDBForm
    DIM form AS VDBForm
    form.Name = ExtractJSONString(js, "name")
    form.Caption = ExtractJSONString(js, "caption")
    form.Width = ExtractJSONInt(js, "width")
    form.Height = ExtractJSONInt(js, "height")
    form.NextCtrlID = 1

    ' Read colors from JSON, default to standard colors if not present
    DIM hasForeColor AS BOOLEAN = InStrPos(1, js, "\"foreColor\"") > 0
    DIM hasBackColor AS BOOLEAN = InStrPos(1, js, "\"backColor\"") > 0
    IF hasForeColor THEN
        form.ForeColor = ExtractJSONInt(js, "foreColor")
    ELSE
        form.ForeColor = 0  ' Default: black
    ENDIF
    IF hasBackColor THEN
        form.BackColor = ExtractJSONInt(js, "backColor")
    ELSE
        form.BackColor = 7  ' Default: white/light gray
    ENDIF

    ' Parse controls array
    DIM ctrlStart AS INTEGER = InStrPos(1,js, "\"controls\"")
    IF ctrlStart > 0 THEN
        DIM ctrlArrayStart AS INTEGER = InStrPos(1,Mid(js, ctrlStart, Len(js)), "[")
        IF ctrlArrayStart > 0 THEN
            ctrlArrayStart = ctrlStart + ctrlArrayStart - 1
            form.Controls = ParseControlsArray(js, ctrlArrayStart)
            form.NextCtrlID = Len(form.Controls) + 1
        ENDIF
    ENDIF

    RETURN form
END FUNCTION

' Parse controls array from JSON
FUNCTION ParseControlsArray(js AS STRING, startPos AS INTEGER) AS []VDBControl
    DIM controls AS []VDBControl
    DIM pos AS INTEGER = startPos + 1
    DIM depth AS INTEGER = 1
    DIM objectStart AS INTEGER = 0

    WHILE pos <= Len(js) AND depth > 0
        DIM ch AS STRING = Mid(js, pos, 1)
        IF ch = "{" THEN
            IF depth = 1 THEN
                objectStart = pos
            ENDIF
            depth = depth + 1
        ELSEIF ch = "}" THEN
            depth = depth - 1
            IF depth = 1 AND objectStart > 0 THEN
                DIM ctrlJs AS STRING = Mid(js, objectStart, pos - objectStart + 1)
                DIM ctrl AS VDBControl = ParseControlObject(ctrlJs)
                controls = APPEND(controls, ctrl)
                objectStart = 0
            ENDIF
        ELSEIF ch = "]" AND depth = 1 THEN
            depth = 0
        ENDIF
        pos = pos + 1
    WEND

    RETURN controls
END FUNCTION

' Parse a single control object from JSON
FUNCTION ParseControlObject(js AS STRING) AS VDBControl
    DIM ctrl AS VDBControl
    ctrl.ID = ExtractJSONInt(js, "id")
    ctrl.CtlType = ExtractJSONInt(js, "type")
    ctrl.CtlName = ExtractJSONString(js, "name")
    ctrl.Caption = ExtractJSONString(js, "caption")
    ctrl.X = ExtractJSONInt(js, "x")
    ctrl.Y = ExtractJSONInt(js, "y")
    ctrl.Width = ExtractJSONInt(js, "width")
    ctrl.Height = ExtractJSONInt(js, "height")
    ctrl.ZOrder = ctrl.ID

    ' Read TabIndex, TabStop, Enabled, Visible from JSON with defaults
    DIM hasTabIndex AS BOOLEAN = InStrPos(1, js, "\"tabIndex\"") > 0
    IF hasTabIndex THEN
        ctrl.TabIndex = ExtractJSONInt(js, "tabIndex")
    ELSE
        ctrl.TabIndex = ctrl.ID  ' Default to control ID
    ENDIF

    DIM hasTabStop AS BOOLEAN = InStrPos(1, js, "\"tabStop\"") > 0
    IF hasTabStop THEN
        ctrl.TabStop = ExtractJSONBool(js, "tabStop")
    ELSE
        ' Default TabStop based on whether control is focusable
        IF ctrl.CtlType = CTRL_BUTTON OR ctrl.CtlType = CTRL_TEXTBOX OR ctrl.CtlType = CTRL_TEXTAREA OR ctrl.CtlType = CTRL_CHECKBOX OR ctrl.CtlType = CTRL_OPTION OR ctrl.CtlType = CTRL_LISTBOX OR ctrl.CtlType = CTRL_COMBOBOX OR ctrl.CtlType = CTRL_DIRBROWSER OR ctrl.CtlType = CTRL_PATH OR ctrl.CtlType = CTRL_DIRECTORIES OR ctrl.CtlType = CTRL_FILES THEN
            ctrl.TabStop = TRUE
        ELSE
            ctrl.TabStop = FALSE
        ENDIF
    ENDIF

    DIM hasEnabled AS BOOLEAN = InStrPos(1, js, "\"enabled\"") > 0
    IF hasEnabled THEN
        ctrl.Enabled = ExtractJSONBool(js, "enabled")
    ELSE
        ctrl.Enabled = TRUE
    ENDIF

    DIM hasVisible AS BOOLEAN = InStrPos(1, js, "\"visible\"") > 0
    IF hasVisible THEN
        ctrl.Visible = ExtractJSONBool(js, "visible")
    ELSE
        ctrl.Visible = TRUE
    ENDIF

    ' Read colors from JSON, default to standard colors if not present
    DIM hasForeColor AS BOOLEAN = InStrPos(1, js, "\"foreColor\"") > 0
    DIM hasBackColor AS BOOLEAN = InStrPos(1, js, "\"backColor\"") > 0
    IF hasForeColor THEN
        ctrl.ForeColor = ExtractJSONInt(js, "foreColor")
    ELSE
        ctrl.ForeColor = 0  ' Default: black
    ENDIF
    IF hasBackColor THEN
        ctrl.BackColor = ExtractJSONInt(js, "backColor")
    ELSE
        ctrl.BackColor = 7  ' Default: white/light gray
    ENDIF

    ' Set type-specific defaults
    IF ctrl.CtlType = CTRL_LABEL THEN
        ctrl.Justification = JUSTIFY_LEFT
    ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
        ctrl.Border = FALSE
    ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
        ctrl.CharLimit = 256
        ctrl.CursorBlink = TRUE
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        ctrl.ShowTitle = FALSE
        ctrl.ShowStatusBar = FALSE
        ctrl.ShowFilter = FALSE
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        ctrl.Total = 100
        ctrl.ShowPercentage = TRUE
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        ctrl.ShowHeaders = TRUE
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        ctrl.Interval = ExtractJSONInt(js, "interval")
        IF ctrl.Interval <= 0 THEN
            ctrl.Interval = 1000
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        ctrl.FilePath = ExtractJSONString(js, "path")
        IF ctrl.FilePath = "" THEN
            ctrl.FilePath = "."
        ENDIF
        ctrl.ShowHidden = ExtractJSONBool(js, "showHidden")
    ELSEIF ctrl.CtlType = CTRL_PATH THEN
        ctrl.FilePath = ExtractJSONString(js, "path")
        IF ctrl.FilePath = "" THEN
            ctrl.FilePath = "."
        ENDIF
        ' Support both linkedPath (new) and linkedControl (backward compat)
        ctrl.LinkedControl = ExtractJSONString(js, "linkedPath")
        IF ctrl.LinkedControl = "" THEN
            ctrl.LinkedControl = ExtractJSONString(js, "linkedControl")
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        ctrl.FilePath = ExtractJSONString(js, "path")
        IF ctrl.FilePath = "" THEN
            ctrl.FilePath = "."
        ENDIF
        ctrl.ShowHidden = ExtractJSONBool(js, "showHidden")
        ' Support both linkedPath (new) and linkedControl (backward compat)
        ctrl.LinkedControl = ExtractJSONString(js, "linkedPath")
        IF ctrl.LinkedControl = "" THEN
            ctrl.LinkedControl = ExtractJSONString(js, "linkedControl")
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        ctrl.FilePath = ExtractJSONString(js, "path")
        IF ctrl.FilePath = "" THEN
            ctrl.FilePath = "."
        ENDIF
        ctrl.ShowHidden = ExtractJSONBool(js, "showHidden")
        ctrl.Pattern = ExtractJSONString(js, "pattern")
        IF ctrl.Pattern = "" THEN
            ctrl.Pattern = "*"
        ENDIF
        ' Support both linkedPath (new) and linkedControl (backward compat)
        ctrl.LinkedControl = ExtractJSONString(js, "linkedPath")
        IF ctrl.LinkedControl = "" THEN
            ctrl.LinkedControl = ExtractJSONString(js, "linkedControl")
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CURL THEN
        ctrl.URL = ExtractJSONString(js, "url")
        ctrl.HttpMethod = ExtractJSONString(js, "httpMethod")
        IF ctrl.HttpMethod = "" THEN
            ctrl.HttpMethod = "GET"
        ENDIF
    ELSEIF ctrl.CtlType >= PLUGIN_TYPE_START THEN
        ' Plugin widget - load plugin type ID and extended properties
        ctrl.PluginTypeID = ExtractJSONString(js, "pluginTypeID")
        ctrl.ExtendedProps = ExtractJSONObject(js, "extendedProps")
    ENDIF

    RETURN ctrl
END FUNCTION

' Generate DBasic code from project - BubbleTea application
FUNCTION GenerateCode(proj AS VDBProject, registry AS PluginRegistry) AS STRING
    DIM code AS STRING = ""

    ' Header
    code = code & "' Generated by VDBTerm - Visual DBasic Terminal IDE" & Chr(10)
    code = code & "' Project: " & proj.Name & Chr(10)
    code = code & "' BubbleTea Application" & Chr(10)
    code = code & Chr(10)

    ' Generate each form as a complete BubbleTea component
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM form AS VDBForm = proj.Forms[i]

        code = code & "' ============================================" & Chr(10)
        code = code & "' Form: " & form.Name & Chr(10)
        code = code & "' ============================================" & Chr(10)
        code = code & Chr(10)

        ' Generate imports (only for first form to avoid duplicates)
        IF i = 0 THEN
            code = code & GenerateImports(form, registry)

            ' Generate theme constants for runtime access
            code = code & GenerateThemeConstants(proj.Theme)

            ' Generate MsgBox support (constants, state, rendering, functions)
            code = code & GenerateMsgBoxSupport()

            ' Generate DirBrowser widget type and methods if needed
            IF ProjectHasDirBrowser(proj) THEN
                code = code & GenerateDirBrowserWidget()
            ENDIF

            ' Generate Path widget type and methods if needed
            IF ProjectHasPath(proj) THEN
                code = code & GeneratePathWidget()
            ENDIF

            ' Generate Directories widget type and methods if needed
            IF ProjectHasDirectories(proj) THEN
                code = code & GenerateDirectoriesWidget()
            ENDIF

            ' Generate Files widget type and methods if needed
            IF ProjectHasFiles(proj) THEN
                code = code & GenerateFilesWidget()
            ENDIF

            ' Generate Curl helper functions if needed
            IF ProjectHasCurl(proj) THEN
                code = code & GenerateCurlHelpers()
            ENDIF
        ENDIF

        ' Generate form type definition
        code = code & GenerateFormType(form, registry)

        ' Generate Init() method
        code = code & GenerateInit(form, registry)

        ' Generate Update() method with event routing
        code = code & GenerateUpdate(form, registry)

        ' Generate View() method with layout
        code = code & GenerateView(form, registry)

        ' Generate focus management helpers (form-specific)
        code = code & GenerateFocusHelpers(form)

        ' Extract and transform event handlers from form code
        code = code & ExtractEventHandlers(form)
    NEXT

    ' Generate render helpers (shared across all forms)
    code = code & GenerateRenderHelpers(proj)

    ' Generate module code
    FOR i = 0 TO Len(proj.Modules) - 1
        DIM m AS VDBModule = proj.Modules[i]
        code = code & "' ============================================" & Chr(10)
        code = code & "' Module: " & m.Name & Chr(10)
        code = code & "' ============================================" & Chr(10)
        code = code & Chr(10)
        code = code & m.Code & Chr(10)
        code = code & Chr(10)
    NEXT

    ' Generate main entry point (startup form)
    code = code & GenerateMain(proj.StartupForm)

    RETURN code
END FUNCTION
