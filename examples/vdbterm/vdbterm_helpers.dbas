' Get theme colors for a specific control type
' Returns ForeColor, BackColor pair
FUNCTION GetThemeColorsForControl(theme AS VDBTheme, ctlType AS INTEGER) AS (INTEGER, INTEGER)
    IF ctlType = CTRL_FORM THEN
        RETURN theme.FormForeColor, theme.FormBackColor
    ELSEIF ctlType = CTRL_BUTTON THEN
        RETURN theme.ButtonForeColor, theme.ButtonBackColor
    ELSEIF ctlType = CTRL_LABEL THEN
        RETURN theme.LabelForeColor, theme.LabelBackColor
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        RETURN theme.TextBoxForeColor, theme.TextBoxBackColor
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        RETURN theme.CheckBoxForeColor, theme.CheckBoxBackColor
    ELSEIF ctlType = CTRL_OPTION THEN
        RETURN theme.OptionForeColor, theme.OptionBackColor
    ELSEIF ctlType = CTRL_LISTBOX THEN
        RETURN theme.ListBoxForeColor, theme.ListBoxBackColor
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        RETURN theme.ComboBoxForeColor, theme.ComboBoxBackColor
    ELSEIF ctlType = CTRL_FRAME THEN
        RETURN theme.FrameForeColor, theme.FrameBackColor
    ELSEIF ctlType = CTRL_TEXTAREA THEN
        RETURN theme.TextAreaForeColor, theme.TextAreaBackColor
    ELSEIF ctlType = CTRL_PROGRESS THEN
        RETURN theme.ProgressForeColor, theme.ProgressBackColor
    ELSEIF ctlType = CTRL_SPINNER THEN
        RETURN theme.SpinnerForeColor, theme.SpinnerBackColor
    ELSEIF ctlType = CTRL_PATH THEN
        RETURN theme.PathForeColor, theme.PathBackColor
    ELSEIF ctlType = CTRL_DIRECTORIES THEN
        RETURN theme.DirectoriesForeColor, theme.DirectoriesBackColor
    ELSEIF ctlType = CTRL_FILES THEN
        RETURN theme.FilesForeColor, theme.FilesBackColor
    ELSEIF ctlType = CTRL_DIRBROWSER THEN
        RETURN theme.DirBrowserForeColor, theme.DirBrowserBackColor
    ENDIF
    ' Default fallback
    RETURN theme.FormForeColor, theme.FormBackColor
END FUNCTION

' Apply theme to all controls on a form
SUB ApplyThemeToForm(form AS POINTER TO VDBForm, theme AS VDBTheme)
    ' Apply theme to form itself
    (^form).ForeColor = theme.FormForeColor
    (^form).BackColor = theme.FormBackColor

    ' Apply theme to each control
    DIM i AS INTEGER
    FOR i = 0 TO Len((^form).Controls) - 1
        DIM foreColor AS INTEGER
        DIM backColor AS INTEGER
        foreColor, backColor = GetThemeColorsForControl(theme, (^form).Controls[i].CtlType)
        (^form).Controls[i].ForeColor = foreColor
        (^form).Controls[i].BackColor = backColor
    NEXT
END SUB

' Apply theme to all forms in a project
SUB ApplyThemeToProject(proj AS POINTER TO VDBProject)
    DIM i AS INTEGER
    FOR i = 0 TO Len((^proj).Forms) - 1
        ApplyThemeToForm(@(^proj).Forms[i], (^proj).Theme)
    NEXT
    (^proj).Modified = TRUE
END SUB

' Adjust a theme color by property index, column (0=fore, 1=back), and delta (+1 or -1)
FUNCTION AdjustThemeColor(theme AS VDBTheme, propIdx AS INTEGER, colIdx AS INTEGER, delta AS INTEGER) AS VDBTheme
    ' Determine max color value based on Use256Colors setting
    DIM maxColor AS INTEGER = 16
    IF theme.Use256Colors THEN
        maxColor = 256
    ENDIF

    IF propIdx = 0 THEN
        IF colIdx = 0 THEN
            theme.FormForeColor = (theme.FormForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.FormBackColor = (theme.FormBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 1 THEN
        IF colIdx = 0 THEN
            theme.ButtonForeColor = (theme.ButtonForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.ButtonBackColor = (theme.ButtonBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 2 THEN
        IF colIdx = 0 THEN
            theme.LabelForeColor = (theme.LabelForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.LabelBackColor = (theme.LabelBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 3 THEN
        IF colIdx = 0 THEN
            theme.TextBoxForeColor = (theme.TextBoxForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.TextBoxBackColor = (theme.TextBoxBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 4 THEN
        IF colIdx = 0 THEN
            theme.CheckBoxForeColor = (theme.CheckBoxForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.CheckBoxBackColor = (theme.CheckBoxBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 5 THEN
        IF colIdx = 0 THEN
            theme.OptionForeColor = (theme.OptionForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.OptionBackColor = (theme.OptionBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 6 THEN
        IF colIdx = 0 THEN
            theme.ListBoxForeColor = (theme.ListBoxForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.ListBoxBackColor = (theme.ListBoxBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 7 THEN
        IF colIdx = 0 THEN
            theme.ComboBoxForeColor = (theme.ComboBoxForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.ComboBoxBackColor = (theme.ComboBoxBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 8 THEN
        IF colIdx = 0 THEN
            theme.FrameForeColor = (theme.FrameForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.FrameBackColor = (theme.FrameBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 9 THEN
        IF colIdx = 0 THEN
            theme.TextAreaForeColor = (theme.TextAreaForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.TextAreaBackColor = (theme.TextAreaBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 10 THEN
        IF colIdx = 0 THEN
            theme.ProgressForeColor = (theme.ProgressForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.ProgressBackColor = (theme.ProgressBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 11 THEN
        IF colIdx = 0 THEN
            theme.SpinnerForeColor = (theme.SpinnerForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.SpinnerBackColor = (theme.SpinnerBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 12 THEN
        IF colIdx = 0 THEN
            theme.PathForeColor = (theme.PathForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.PathBackColor = (theme.PathBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 13 THEN
        IF colIdx = 0 THEN
            theme.DirectoriesForeColor = (theme.DirectoriesForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.DirectoriesBackColor = (theme.DirectoriesBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 14 THEN
        IF colIdx = 0 THEN
            theme.FilesForeColor = (theme.FilesForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.FilesBackColor = (theme.FilesBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 15 THEN
        IF colIdx = 0 THEN
            theme.DirBrowserForeColor = (theme.DirBrowserForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.DirBrowserBackColor = (theme.DirBrowserBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 16 THEN
        IF colIdx = 0 THEN
            theme.FocusedForeColor = (theme.FocusedForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.FocusedBackColor = (theme.FocusedBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 17 THEN
        IF colIdx = 0 THEN
            theme.SelectedForeColor = (theme.SelectedForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.SelectedBackColor = (theme.SelectedBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 18 THEN
        IF colIdx = 0 THEN
            theme.MenuForeColor = (theme.MenuForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.MenuBackColor = (theme.MenuBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 19 THEN
        IF colIdx = 0 THEN
            theme.MenuSelectedForeColor = (theme.MenuSelectedForeColor + delta + maxColor) MOD maxColor
        ELSE
            theme.MenuSelectedBackColor = (theme.MenuSelectedBackColor + delta + maxColor) MOD maxColor
        ENDIF
    ELSEIF propIdx = 20 THEN
        ' MenuShortcut only has ForeColor (BackColor follows Menu)
        IF colIdx = 0 THEN
            theme.MenuShortcutForeColor = (theme.MenuShortcutForeColor + delta + maxColor) MOD maxColor
        ENDIF
        ' colIdx = 1 is ignored - no separate BackColor
    ENDIF
    RETURN theme
END FUNCTION

' Get theme name by index
FUNCTION GetThemeNameByIndex(idx AS INTEGER) AS STRING
    IF idx = 0 THEN
        RETURN "Default"
    ELSEIF idx = 1 THEN
        RETURN "Dark"
    ELSEIF idx = 2 THEN
        RETURN "Light"
    ELSEIF idx = 3 THEN
        RETURN "Green Terminal"
    ENDIF
    RETURN "Custom"
END FUNCTION

' Get theme by index
FUNCTION GetThemeByIndex(idx AS INTEGER) AS VDBTheme
    IF idx = 0 THEN
        RETURN NewDefaultTheme()
    ELSEIF idx = 1 THEN
        RETURN NewDarkTheme()
    ELSEIF idx = 2 THEN
        RETURN NewLightTheme()
    ELSEIF idx = 3 THEN
        RETURN NewGreenTerminalTheme()
    ENDIF
    RETURN NewDefaultTheme()
END FUNCTION

