        ENDIF
    ELSEIF propIdx = 15 THEN
        IF colIdx = 0 THEN
            theme.DirBrowserForeColor = colorVal
        ELSE
            theme.DirBrowserBackColor = colorVal
        ENDIF
    ELSEIF propIdx = 16 THEN
        IF colIdx = 0 THEN
            theme.FocusedForeColor = colorVal
        ELSE
