' Create default theme - Classic VB6 gray (black on light gray)
FUNCTION NewDefaultTheme() AS VDBTheme
    DIM theme AS VDBTheme
    theme.Name = "Default"

    ' Form colors
    theme.FormForeColor = 0      ' Black
    theme.FormBackColor = 7      ' Light gray

    ' Control colors (all black on light gray for classic look)
    theme.ButtonForeColor = 0
    theme.ButtonBackColor = 7
