' VDBTerm Helper Functions
' String utilities, expression evaluation, and other helper functions

IMPORT "github.com/atotto/clipboard" AS clipboard

' Copy text to system clipboard
SUB CopyToClipboard(text AS STRING)
    clipboard.WriteAll(text)
END SUB

FUNCTION RepeatStr(ch AS STRING, count AS INTEGER) AS STRING
    DIM result AS STRING = ""
    DIM i AS INTEGER
    FOR i = 1 TO count
        result = result & ch
    NEXT
    RETURN result
END FUNCTION

FUNCTION PadRight(s AS STRING, width AS INTEGER) AS STRING
    IF Len(s) >= width THEN
        RETURN Left(s, width)
    ENDIF
    RETURN s & RepeatStr(" ", width - Len(s))
END FUNCTION

' PadRight using display width (handles ANSI escape codes correctly)
FUNCTION PadRightDisplay(s AS STRING, width AS INTEGER) AS STRING
    DIM displayWidth AS INTEGER = lipgloss.Width(s)
    IF displayWidth >= width THEN
        RETURN s
    ENDIF
    RETURN s & RepeatStr(" ", width - displayWidth)
END FUNCTION

FUNCTION IIFStr(cond AS BOOLEAN, trueVal AS STRING, falseVal AS STRING) AS STRING
    IF cond THEN
        RETURN trueVal
    ENDIF
    RETURN falseVal
END FUNCTION

FUNCTION PadCenter(s AS STRING, width AS INTEGER) AS STRING
    IF Len(s) >= width THEN
        RETURN Left(s, width)
    ENDIF
    DIM padding AS INTEGER = (width - Len(s)) / 2
    RETURN RepeatStr(" ", padding) & s & RepeatStr(" ", width - Len(s) - padding)
END FUNCTION

FUNCTION MinInt(a AS INTEGER, b AS INTEGER) AS INTEGER
    IF a < b THEN
        RETURN a
    ENDIF
    RETURN b
END FUNCTION

FUNCTION MaxInt(a AS INTEGER, b AS INTEGER) AS INTEGER
    IF a > b THEN
        RETURN a
    ENDIF
    RETURN b
END FUNCTION

' Map widget panel index to control type
' Visible widgets: Button(1), Label(2), TextBox(3), CheckBox(4), Option(5),
'                  ListBox(6), ComboBox(7), Frame(8), HScroll(9), VScroll(10),
'                  TextArea(12), Progress(13), Spinner(14), Table(15), DirBrowser(19), Path(20), Directories(21)
' Timer(11) is non-visible (in Toolbox)
FUNCTION WidgetIndexToCtrlType(widgetIdx AS INTEGER) AS INTEGER
    IF widgetIdx < 10 THEN
        ' First 10 visible widgets map directly
        RETURN widgetIdx + 1
    ELSEIF widgetIdx = 14 THEN
        ' widgetIdx 14 -> CTRL_DIRBROWSER (19)
        RETURN CTRL_DIRBROWSER
    ELSEIF widgetIdx = 15 THEN
        ' widgetIdx 15 -> CTRL_PATH (20)
        RETURN CTRL_PATH
    ELSEIF widgetIdx = 16 THEN
        ' widgetIdx 16 -> CTRL_DIRECTORIES (21)
        RETURN CTRL_DIRECTORIES
    ELSEIF widgetIdx = 17 THEN
        ' widgetIdx 17 -> CTRL_FILES (22)
        RETURN CTRL_FILES
    ELSE
        ' New widgets skip Timer (11)
        ' widgetIdx 10 -> CTRL_TEXTAREA (12)
        ' widgetIdx 11 -> CTRL_PROGRESS (13)
        ' widgetIdx 12 -> CTRL_SPINNER (14)
        ' widgetIdx 13 -> CTRL_TABLE (15)
        RETURN widgetIdx + 2
    ENDIF
END FUNCTION

' Map toolbox panel index to control type
' Non-visible tools: Timer(11), Serial(16), TCP/IP(17), UDP/IP(18)
FUNCTION ToolboxIndexToCtrlType(toolIdx AS INTEGER) AS INTEGER
    IF toolIdx = 0 THEN
        RETURN CTRL_TIMER
    ELSEIF toolIdx = 1 THEN
        RETURN CTRL_SERIAL
    ELSEIF toolIdx = 2 THEN
        RETURN CTRL_TCPIP
    ELSEIF toolIdx = 3 THEN
        RETURN CTRL_UDPIP
    ELSEIF toolIdx = 4 THEN
        RETURN CTRL_CURL
    ENDIF
    RETURN CTRL_TIMER
END FUNCTION

' Count lines in a string
FUNCTION CountLines(content AS STRING) AS INTEGER
    IF Len(content) = 0 THEN
        RETURN 1
    ENDIF
    DIM count AS INTEGER = 1
    DIM i AS INTEGER
    FOR i = 1 TO Len(content)
        IF Mid(content, i, 1) = Chr(10) THEN
            count = count + 1
        ENDIF
    NEXT
    RETURN count
END FUNCTION

' Get a specific line (1-indexed)
FUNCTION GetLine(content AS STRING, lineNum AS INTEGER) AS STRING
    IF Len(content) = 0 THEN
        RETURN ""
    ENDIF
    DIM currentLine AS INTEGER = 1
    DIM startPos AS INTEGER = 1
    DIM i AS INTEGER

    FOR i = 1 TO Len(content)
        IF currentLine = lineNum THEN
            startPos = i
            EXIT FOR
        ENDIF
        IF Mid(content, i, 1) = Chr(10) THEN
            currentLine = currentLine + 1
        ENDIF
    NEXT

    IF currentLine < lineNum THEN
        RETURN ""
    ENDIF

    DIM result AS STRING = ""
    FOR i = startPos TO Len(content)
        DIM ch AS STRING = Mid(content, i, 1)
        IF ch = Chr(10) THEN
            EXIT FOR
        ENDIF
        result = result & ch
    NEXT
    RETURN result
END FUNCTION

' Get control type name (base version without plugin support)
FUNCTION GetControlTypeName(ctlType AS INTEGER) AS STRING
    IF ctlType = CTRL_FORM THEN
        RETURN "Form"
    ELSEIF ctlType = CTRL_BUTTON THEN
        RETURN "Button"
    ELSEIF ctlType = CTRL_LABEL THEN
        RETURN "Label"
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        RETURN "TextBox"
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        RETURN "CheckBox"
    ELSEIF ctlType = CTRL_OPTION THEN
        RETURN "Option"
    ELSEIF ctlType = CTRL_LISTBOX THEN
        RETURN "ListBox"
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        RETURN "ComboBox"
    ELSEIF ctlType = CTRL_FRAME THEN
        RETURN "Frame"
    ELSEIF ctlType = CTRL_HSCROLL THEN
        RETURN "HScrollBar"
    ELSEIF ctlType = CTRL_VSCROLL THEN
        RETURN "VScrollBar"
    ELSEIF ctlType = CTRL_TIMER THEN
        RETURN "Timer"
    ELSEIF ctlType = CTRL_TEXTAREA THEN
        RETURN "TextArea"
    ELSEIF ctlType = CTRL_PROGRESS THEN
        RETURN "Progress"
    ELSEIF ctlType = CTRL_SPINNER THEN
        RETURN "Spinner"
    ELSEIF ctlType = CTRL_TABLE THEN
        RETURN "Table"
    ELSEIF ctlType = CTRL_SERIAL THEN
        RETURN "Serial"
    ELSEIF ctlType = CTRL_TCPIP THEN
        RETURN "TCP/IP"
    ELSEIF ctlType = CTRL_UDPIP THEN
        RETURN "UDP/IP"
    ELSEIF ctlType = CTRL_DIRBROWSER THEN
        RETURN "DirBrowser"
    ELSEIF ctlType = CTRL_PATH THEN
        RETURN "Path"
    ELSEIF ctlType = CTRL_DIRECTORIES THEN
        RETURN "Directories"
    ELSEIF ctlType = CTRL_FILES THEN
        RETURN "Files"
    ELSEIF ctlType = CTRL_CURL THEN
        RETURN "Curl"
    ENDIF
    RETURN "Unknown"
END FUNCTION

' Get control type name with plugin support
FUNCTION GetControlTypeNameWithRegistry(ctlType AS INTEGER, registry AS PluginRegistry) AS STRING
    ' Check built-in types first
    IF ctlType < PLUGIN_TYPE_START THEN
        RETURN GetControlTypeName(ctlType)
    ENDIF

    ' Check plugin types
    DIM plugin AS PluginWidgetDef = GetPluginByCtrlType(ctlType, registry)
    IF plugin.Meta.ID <> "" THEN
        RETURN plugin.Meta.Name
    ENDIF

    RETURN "Unknown"
END FUNCTION

' Get toolbox icon for control type
FUNCTION GetToolboxIcon(ctlType AS INTEGER) AS STRING
    IF ctlType = CTRL_BUTTON THEN
        RETURN "[Btn]"
    ELSEIF ctlType = CTRL_LABEL THEN
        RETURN " Lbl "
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        RETURN "[___]"
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        RETURN "[X] "
    ELSEIF ctlType = CTRL_OPTION THEN
        RETURN "(o) "
    ELSEIF ctlType = CTRL_LISTBOX THEN
        RETURN "[=] "
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        RETURN "[v] "
    ELSEIF ctlType = CTRL_FRAME THEN
        RETURN "[-] "
    ELSEIF ctlType = CTRL_HSCROLL THEN
        RETURN "<=> "
    ELSEIF ctlType = CTRL_VSCROLL THEN
        RETURN "[|] "
    ELSEIF ctlType = CTRL_TIMER THEN
        RETURN " T  "
    ELSEIF ctlType = CTRL_TEXTAREA THEN
        RETURN "[~~]"
    ELSEIF ctlType = CTRL_PROGRESS THEN
        RETURN "[=>]"
    ELSEIF ctlType = CTRL_SPINNER THEN
        RETURN "[*] "
    ELSEIF ctlType = CTRL_TABLE THEN
        RETURN "[#] "
    ELSEIF ctlType = CTRL_SERIAL THEN
        RETURN "SER "
    ELSEIF ctlType = CTRL_TCPIP THEN
        RETURN "TCP "
    ELSEIF ctlType = CTRL_UDPIP THEN
        RETURN "UDP "
    ELSEIF ctlType = CTRL_DIRBROWSER THEN
        RETURN "[D] "
    ELSEIF ctlType = CTRL_PATH THEN
        RETURN "[/] "
    ELSEIF ctlType = CTRL_DIRECTORIES THEN
        RETURN "[d] "
    ELSEIF ctlType = CTRL_FILES THEN
        RETURN "[f] "
    ELSEIF ctlType = CTRL_CURL THEN
        RETURN "[~] "
    ENDIF
    RETURN "??? "
END FUNCTION

' Replace all occurrences of a substring
FUNCTION ReplaceAll(s AS STRING, old AS STRING, new AS STRING) AS STRING
    DIM result AS STRING = ""
    DIM i AS INTEGER = 1
    DIM oldLen AS INTEGER = Len(old)

    WHILE i <= Len(s)
        IF Mid(s, i, oldLen) = old THEN
            result = result & new
            i = i + oldLen
        ELSE
            result = result & Mid(s, i, 1)
            i = i + 1
        ENDIF
    WEND

    RETURN result
END FUNCTION

' Trim whitespace from both ends of a string
FUNCTION TrimStr(s AS STRING) AS STRING
    DIM startIdx AS INTEGER = 1
    DIM endIdx AS INTEGER = Len(s)

    WHILE startIdx <= endIdx AND Mid(s, startIdx, 1) = " "
        startIdx = startIdx + 1
    WEND

    WHILE endIdx >= startIdx AND Mid(s, endIdx, 1) = " "
        endIdx = endIdx - 1
    WEND

    IF startIdx > endIdx THEN
        RETURN ""
    ENDIF

    RETURN Mid(s, startIdx, endIdx - startIdx + 1)
END FUNCTION

' Parse an integer from a string
FUNCTION ParseIntStr(s AS STRING) AS INTEGER
    DIM result AS INTEGER = 0
    DIM negative AS BOOLEAN = FALSE
    DIM i AS INTEGER = 1

    IF Len(s) = 0 THEN
        RETURN 0
    ENDIF

    IF Mid(s, 1, 1) = "-" THEN
        negative = TRUE
        i = 2
    ELSEIF Mid(s, 1, 1) = "+" THEN
        i = 2
    ENDIF

    WHILE i <= Len(s)
        DIM ch AS STRING = Mid(s, i, 1)
        DIM digit AS INTEGER = Asc(ch) - 48
        IF digit >= 0 AND digit <= 9 THEN
            result = result * 10 + digit
        ELSE
            EXIT WHILE
        ENDIF
        i = i + 1
    WEND

    IF negative THEN
        result = -result
    ENDIF

    RETURN result
END FUNCTION

' Check if a string is a valid integer
FUNCTION IsNumericStr(s AS STRING) AS BOOLEAN
    IF Len(s) = 0 THEN
        RETURN FALSE
    ENDIF

    DIM startIdx AS INTEGER = 1
    IF Mid(s, 1, 1) = "-" OR Mid(s, 1, 1) = "+" THEN
        startIdx = 2
    ENDIF

    IF startIdx > Len(s) THEN
        RETURN FALSE
    ENDIF

    DIM i AS INTEGER
    FOR i = startIdx TO Len(s)
        DIM ch AS STRING = Mid(s, i, 1)
        DIM code AS INTEGER = Asc(ch)
        IF code < 48 OR code > 57 THEN
            RETURN FALSE
        ENDIF
    NEXT

    RETURN TRUE
END FUNCTION

' Split a string by delimiter into an array
FUNCTION SplitStr(s AS STRING, delim AS STRING) AS []STRING
    DIM result AS []STRING
    DIM current AS STRING = ""
    DIM i AS INTEGER
    DIM delimLen AS INTEGER = Len(delim)

    IF delimLen = 0 THEN
        result = APPEND(result, s)
        RETURN result
    ENDIF

    FOR i = 1 TO Len(s)
        IF Mid(s, i, delimLen) = delim THEN
            result = APPEND(result, current)
            current = ""
            i = i + delimLen - 1
        ELSE
            current = current & Mid(s, i, 1)
        ENDIF
    NEXT

    result = APPEND(result, current)
    RETURN result
END FUNCTION

' Find position of substring in string (1-indexed, returns 0 if not found)
FUNCTION InStrPos(start AS INTEGER, s AS STRING, search AS STRING) AS INTEGER
    DIM searchLen AS INTEGER = Len(search)
    IF searchLen = 0 OR start > Len(s) THEN
        RETURN 0
    ENDIF

    DIM i AS INTEGER
    FOR i = start TO Len(s) - searchLen + 1
        IF Mid(s, i, searchLen) = search THEN
            RETURN i
        ENDIF
    NEXT

    RETURN 0
END FUNCTION

' Evaluate a numeric expression that may contain reserved variables
' Returns the evaluated integer value, or the fallback if expression is empty or invalid
FUNCTION EvalExpr(expr AS STRING, m AS VDBTermModel, fallback AS INTEGER) AS INTEGER
    IF Len(expr) = 0 THEN
        RETURN fallback
    ENDIF

    ' Calculate layout dimensions for variable substitution
    DIM toolboxW AS INTEGER = 16
    DIM propertiesW AS INTEGER = 22
    DIM projectH AS INTEGER = 8
    DIM contentW AS INTEGER = m.Width - toolboxW - propertiesW
    DIM contentH AS INTEGER = m.Height - 4
    DIM formW AS INTEGER = 80
    DIM formH AS INTEGER = 25

    IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
        formW = m.Project.Forms[m.CurrentFormIdx].Width
        formH = m.Project.Forms[m.CurrentFormIdx].Height
    ENDIF

    ' Replace reserved variables with their values
    DIM result AS STRING = expr

    ' Screen/Window variables
    result = ReplaceAll(result, "$SCREEN_WIDTH", Str(m.Width))
    result = ReplaceAll(result, "$SCREEN_HEIGHT", Str(m.Height))
    result = ReplaceAll(result, "$FORM_WIDTH", Str(formW))
    result = ReplaceAll(result, "$FORM_HEIGHT", Str(formH))
    result = ReplaceAll(result, "$CONTENT_WIDTH", Str(contentW))
    result = ReplaceAll(result, "$CONTENT_HEIGHT", Str(contentH))

    ' Layout constants
    result = ReplaceAll(result, "$TOOLBOX_WIDTH", Str(toolboxW))
    result = ReplaceAll(result, "$PROPERTIES_WIDTH", Str(propertiesW))
    result = ReplaceAll(result, "$PROJECT_HEIGHT", Str(projectH))

    ' Try to evaluate as simple expression
    RETURN EvalSimpleExpr(result, fallback)
END FUNCTION

' Evaluate a simple arithmetic expression (supports +, -, *, /)
' This is a basic evaluator for expressions like "100 - 20" or "50 / 2"
FUNCTION EvalSimpleExpr(expr AS STRING, fallback AS INTEGER) AS INTEGER
    DIM trimmed AS STRING = TrimStr(expr)

    ' Try to parse as plain integer first
    IF IsNumericStr(trimmed) THEN
        RETURN ParseIntStr(trimmed)
    ENDIF

    ' Look for operators (process in order of precedence, right to left for +/-)
    DIM i AS INTEGER
    DIM depth AS INTEGER = 0

    ' Find + or - (lowest precedence, scan right to left)
    FOR i = Len(trimmed) TO 1 STEP -1
        DIM ch AS STRING = Mid(trimmed, i, 1)
        IF ch = "(" THEN
            depth = depth + 1
        ELSEIF ch = ")" THEN
            depth = depth - 1
        ELSEIF depth = 0 AND (ch = "+" OR ch = "-") AND i > 1 THEN
            DIM lhs AS STRING = TrimStr(Left(trimmed, i - 1))
            DIM rhs AS STRING = TrimStr(Mid(trimmed, i + 1, Len(trimmed) - i))
            DIM lhsVal AS INTEGER = EvalSimpleExpr(lhs, 0)
            DIM rhsVal AS INTEGER = EvalSimpleExpr(rhs, 0)
            IF ch = "+" THEN
                RETURN lhsVal + rhsVal
            ELSE
                RETURN lhsVal - rhsVal
            ENDIF
        ENDIF
    NEXT

    ' Find * or / (higher precedence, scan right to left)
    depth = 0
    FOR i = Len(trimmed) TO 1 STEP -1
        DIM ch2 AS STRING = Mid(trimmed, i, 1)
        IF ch2 = "(" THEN
            depth = depth + 1
        ELSEIF ch2 = ")" THEN
            depth = depth - 1
        ELSEIF depth = 0 AND (ch2 = "*" OR ch2 = "/") THEN
            DIM lhs2 AS STRING = TrimStr(Left(trimmed, i - 1))
            DIM rhs2 AS STRING = TrimStr(Mid(trimmed, i + 1, Len(trimmed) - i))
            DIM lhsVal2 AS INTEGER = EvalSimpleExpr(lhs2, 0)
            DIM rhsVal2 AS INTEGER = EvalSimpleExpr(rhs2, 0)
            IF ch2 = "*" THEN
                RETURN lhsVal2 * rhsVal2
            ELSEIF rhsVal2 <> 0 THEN
                RETURN lhsVal2 / rhsVal2
            ELSE
                RETURN fallback
            ENDIF
        ENDIF
    NEXT

    ' Handle parentheses
    IF Left(trimmed, 1) = "(" AND Right(trimmed, 1) = ")" THEN
        RETURN EvalSimpleExpr(Mid(trimmed, 2, Len(trimmed) - 2), fallback)
    ENDIF

    RETURN fallback
END FUNCTION

' Project tree helper: Get total items in tree (with expansion state)
' Returns total number of visible rows in project tree
FUNCTION GetTreeItemCount(m AS VDBTermModel) AS INTEGER
    IF NOT m.ProjectLoaded THEN
        RETURN 0
    ENDIF

    ' Row 0: Project name
    DIM count AS INTEGER = 1

    ' Forms and their controls
    DIM i AS INTEGER
    FOR i = 0 TO Len(m.Project.Forms) - 1
        count = count + 1  ' The form itself
        ' If form is expanded, add its controls
        IF i < Len(m.TreeExpanded) AND m.TreeExpanded[i] THEN
            count = count + Len(m.Project.Forms[i].Controls)
        ENDIF
    NEXT

    ' Modules
    count = count + Len(m.Project.Modules)

    RETURN count
END FUNCTION

' Project tree helper: Get info about a tree row
' Returns: itemType (0=project, 1=form, 2=control, 3=module), formIdx, ctrlIdx
FUNCTION GetTreeItemInfo(m AS VDBTermModel, rowIdx AS INTEGER) AS (INTEGER, INTEGER, INTEGER)
    IF NOT m.ProjectLoaded THEN
        RETURN 0, -1, -1
    ENDIF

    ' Row 0: Project name
    IF rowIdx = 0 THEN
        RETURN 0, -1, -1
    ENDIF

    DIM currentRow AS INTEGER = 1
    DIM i AS INTEGER

    ' Forms and their controls
    FOR i = 0 TO Len(m.Project.Forms) - 1
        IF currentRow = rowIdx THEN
            ' This is a form row
            RETURN 1, i, -1
        ENDIF
        currentRow = currentRow + 1

        ' If form is expanded, check controls
        IF i < Len(m.TreeExpanded) AND m.TreeExpanded[i] THEN
            DIM ctrlCount AS INTEGER = Len(m.Project.Forms[i].Controls)
            IF rowIdx < currentRow + ctrlCount THEN
                ' This is a control row
                DIM ctrlIdx AS INTEGER = rowIdx - currentRow
                RETURN 2, i, ctrlIdx
            ENDIF
            currentRow = currentRow + ctrlCount
        ENDIF
    NEXT

    ' Modules
    DIM modIdx AS INTEGER = rowIdx - currentRow
    IF modIdx >= 0 AND modIdx < Len(m.Project.Modules) THEN
        RETURN 3, modIdx, -1
    ENDIF

    RETURN 0, -1, -1
END FUNCTION

' Project tree helper: Ensure TreeExpanded array is properly sized
FUNCTION EnsureTreeExpanded(m AS VDBTermModel) AS VDBTermModel
    DIM formCount AS INTEGER = Len(m.Project.Forms)
    WHILE Len(m.TreeExpanded) < formCount
        m.TreeExpanded = APPEND(m.TreeExpanded, TRUE)  ' Default to expanded
    WEND
    RETURN m
END FUNCTION

' Get available events for a control type
FUNCTION GetControlEvents(ctlType AS INTEGER) AS []STRING
    DIM events AS []STRING

    IF ctlType = CTRL_FORM THEN
        events = APPEND(events, "Load")
        events = APPEND(events, "Unload")
        events = APPEND(events, "Activate")
        events = APPEND(events, "Deactivate")
        events = APPEND(events, "Resize")
        events = APPEND(events, "KeyPress")
    ELSEIF ctlType = CTRL_BUTTON THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "MouseDown")
        events = APPEND(events, "MouseUp")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_LABEL THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "DblClick")
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "KeyPress")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
        events = APPEND(events, "Validate")
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "Change")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_OPTION THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "Change")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_LISTBOX THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "DblClick")
        events = APPEND(events, "Change")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "Change")
        events = APPEND(events, "DropDown")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_FRAME THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "DblClick")
    ELSEIF ctlType = CTRL_HSCROLL OR ctlType = CTRL_VSCROLL THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "Scroll")
    ELSEIF ctlType = CTRL_TIMER THEN
        events = APPEND(events, "Timer")
    ELSEIF ctlType = CTRL_TEXTAREA THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "KeyPress")
        events = APPEND(events, "GotFocus")
        events = APPEND(events, "LostFocus")
    ELSEIF ctlType = CTRL_PROGRESS THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "Complete")
    ELSEIF ctlType = CTRL_SPINNER THEN
        events = APPEND(events, "Spin")
    ELSEIF ctlType = CTRL_TABLE THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "DblClick")
        events = APPEND(events, "CellSelect")
        events = APPEND(events, "RowSelect")
    ELSEIF ctlType = CTRL_SERIAL THEN
        events = APPEND(events, "DataReceived")
        events = APPEND(events, "Error")
        events = APPEND(events, "Connect")
        events = APPEND(events, "Disconnect")
    ELSEIF ctlType = CTRL_TCPIP THEN
        events = APPEND(events, "DataReceived")
        events = APPEND(events, "Error")
        events = APPEND(events, "Connect")
        events = APPEND(events, "Disconnect")
        events = APPEND(events, "Accept")
    ELSEIF ctlType = CTRL_UDPIP THEN
        events = APPEND(events, "DataReceived")
        events = APPEND(events, "Error")
    ELSEIF ctlType = CTRL_DIRBROWSER THEN
        events = APPEND(events, "DirChange")
        events = APPEND(events, "PathChange")
    ELSEIF ctlType = CTRL_PATH THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "Enter")
    ELSEIF ctlType = CTRL_DIRECTORIES THEN
        events = APPEND(events, "Change")
        events = APPEND(events, "Enter")
    ELSEIF ctlType = CTRL_FILES THEN
        events = APPEND(events, "Click")
        events = APPEND(events, "DblClick")
        events = APPEND(events, "Change")
        events = APPEND(events, "PatternChange")
    ELSEIF ctlType = CTRL_CURL THEN
        events = APPEND(events, "Complete")
        events = APPEND(events, "Error")
        events = APPEND(events, "Progress")
    ENDIF

    RETURN events
END FUNCTION

' Find an event handler in code and return its line number (1-indexed), or 0 if not found
FUNCTION FindEventHandler(code AS STRING, ctrlName AS STRING, eventName AS STRING) AS INTEGER
    ' Look for SUB ctrlName_eventName() or FUNCTION ctrlName_eventName(
    DIM searchSub AS STRING = "SUB " & ctrlName & "_" & eventName
    DIM searchFunc AS STRING = "FUNCTION " & ctrlName & "_" & eventName

    DIM lineNum AS INTEGER = 1
    DIM i AS INTEGER = 1
    DIM lineStart AS INTEGER = 1

    WHILE i <= Len(code)
        DIM ch AS STRING = Mid(code, i, 1)
        IF ch = Chr(10) THEN
            ' Check this line
            DIM lineText AS STRING = Mid(code, lineStart, i - lineStart)
            DIM upperLine AS STRING = UCase(lineText)

            ' Check for SUB or FUNCTION definition
            DIM subPos AS INTEGER = InStrPos(1, upperLine, UCase(searchSub))
            DIM funcPos AS INTEGER = InStrPos(1, upperLine, UCase(searchFunc))

            IF subPos > 0 OR funcPos > 0 THEN
                RETURN lineNum
            ENDIF

            lineNum = lineNum + 1
            lineStart = i + 1
        ENDIF
        i = i + 1
    WEND

    ' Check last line (if no trailing newline)
    IF lineStart <= Len(code) THEN
        DIM lineText AS STRING = Mid(code, lineStart, Len(code) - lineStart + 1)
        DIM upperLine AS STRING = UCase(lineText)
        DIM subPos AS INTEGER = InStrPos(1, upperLine, UCase(searchSub))
        DIM funcPos AS INTEGER = InStrPos(1, upperLine, UCase(searchFunc))
        IF subPos > 0 OR funcPos > 0 THEN
            RETURN lineNum
        ENDIF
    ENDIF

    RETURN 0
END FUNCTION

' Generate event handler stub code
FUNCTION GenerateEventStub(ctrlName AS STRING, eventName AS STRING) AS STRING
    DIM stub AS STRING = ""
    stub = stub & Chr(10)
    stub = stub & "SUB " & ctrlName & "_" & eventName & "()" & Chr(10)
    stub = stub & "    ' TODO: Add event handler code" & Chr(10)
    stub = stub & "END SUB" & Chr(10)
    RETURN stub
END FUNCTION

' Check if a control type uses the Caption property
FUNCTION ControlUsesCaption(ctlType AS INTEGER) AS BOOLEAN
    ' Controls that display Caption: Button, Label, Checkbox, Option, Frame
    IF ctlType = CTRL_BUTTON OR ctlType = CTRL_LABEL OR ctlType = CTRL_CHECKBOX OR ctlType = CTRL_OPTION OR ctlType = CTRL_FRAME THEN
        RETURN TRUE
    ENDIF
    ' Controls that don't use Caption: TextBox, ListBox, ComboBox, HScroll, VScroll, Timer
    RETURN FALSE
END FUNCTION

' Get the next available TabIndex for a form (avoids duplicates)
FUNCTION GetNextTabIndex(form AS VDBForm) AS INTEGER
    DIM maxTabIndex AS INTEGER = -1
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        IF form.Controls[i].TabIndex > maxTabIndex THEN
            maxTabIndex = form.Controls[i].TabIndex
        ENDIF
    NEXT
    RETURN maxTabIndex + 1
END FUNCTION

' Check if a TabIndex is already used by another control on the form
FUNCTION IsTabIndexUsed(form AS VDBForm, tabIndex AS INTEGER, excludeIdx AS INTEGER) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        IF i <> excludeIdx AND form.Controls[i].TabIndex = tabIndex THEN
            RETURN TRUE
        ENDIF
    NEXT
    RETURN FALSE
END FUNCTION

' Fix duplicate TabIndex values on a form
SUB FixDuplicateTabIndexes(form AS VDBForm)
    DIM used AS []INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER

    FOR i = 0 TO Len(form.Controls) - 1
        DIM tabIdx AS INTEGER = form.Controls[i].TabIndex
        ' Check if this TabIndex is already used
        DIM isDup AS BOOLEAN = FALSE
        FOR j = 0 TO Len(used) - 1
            IF used[j] = tabIdx THEN
                isDup = TRUE
                EXIT FOR
            ENDIF
        NEXT

        IF isDup THEN
            ' Find next available TabIndex
            DIM nextIdx AS INTEGER = 0
            DIM found AS BOOLEAN = FALSE
            WHILE NOT found
                DIM isUsed AS BOOLEAN = FALSE
                FOR j = 0 TO Len(used) - 1
                    IF used[j] = nextIdx THEN
                        isUsed = TRUE
                        EXIT FOR
                    ENDIF
                NEXT
                IF NOT isUsed THEN
                    found = TRUE
                ELSE
                    nextIdx = nextIdx + 1
                ENDIF
            WEND
            form.Controls[i].TabIndex = nextIdx
            used = APPEND(used, nextIdx)
        ELSE
            used = APPEND(used, tabIdx)
        ENDIF
    NEXT
END SUB

' Get the total number of properties for a control (including type-specific)
FUNCTION GetControlPropertyCount(ctrl AS VDBControl) AS INTEGER
    ' Base properties: Name, Type, [Caption], X, Y, Width, Height, Enabled, Visible, ZOrder, TabIndex, TabStop, ForeColor, BackColor
    ' Caption is only included for controls that use it
    DIM baseCount AS INTEGER = 13
    IF ControlUsesCaption(ctrl.CtlType) THEN
        baseCount = 14
    ENDIF

    ' Add type-specific property count
    IF ctrl.CtlType = CTRL_TEXTBOX THEN
        ' Value, Placeholder, CharLimit, EchoMode, Prompt, CursorBlink
        RETURN baseCount + 6
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        ' Items, Title, ShowTitle, ShowStatusBar, ShowFilter, InfiniteScrolling
        RETURN baseCount + 6
    ELSEIF ctrl.CtlType = CTRL_COMBOBOX THEN
        ' Items, ShowFilter
        RETURN baseCount + 2
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        ' Interval
        RETURN baseCount + 1
    ELSEIF ctrl.CtlType = CTRL_OPTION THEN
        ' GroupName
        RETURN baseCount + 1
    ELSEIF ctrl.CtlType = CTRL_HSCROLL OR ctrl.CtlType = CTRL_VSCROLL THEN
        ' Value, MinValue, MaxValue
        RETURN baseCount + 3
    ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
        ' Value
        RETURN baseCount + 1
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        ' Value, Placeholder, CharLimit, ShowLineNumbers
        RETURN baseCount + 4
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        ' Value, Total, ShowPercentage
        RETURN baseCount + 3
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        ' SpinnerStyle
        RETURN baseCount + 1
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        ' Columns, Rows, ShowHeaders
        RETURN baseCount + 3
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        ' Path, ShowHidden
        RETURN baseCount + 2
    ELSEIF ctrl.CtlType = CTRL_PATH THEN
        ' InitialPath, LinkedDirs
        RETURN baseCount + 2
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        ' Path, ShowHidden, LinkedPath
        RETURN baseCount + 3
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        ' Path, ShowHidden, Pattern, LinkedPath
        RETURN baseCount + 4
    ELSEIF ctrl.CtlType = CTRL_CURL THEN
        ' URL, HttpMethod
        RETURN baseCount + 2
    ENDIF

    RETURN baseCount
END FUNCTION

' Get property name for a control at given index
FUNCTION GetControlPropertyName(ctrl AS VDBControl, propIdx AS INTEGER) AS STRING
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)
    DIM adjIdx AS INTEGER = propIdx

    ' For controls without Caption, indices 2+ are shifted down by 1
    ' So we need to shift them back up to map to the standard property positions
    IF NOT hasCaption AND propIdx >= 2 THEN
        adjIdx = propIdx + 1
    ENDIF

    ' Base properties
    IF propIdx = 0 THEN
        RETURN "Name"
    ELSEIF propIdx = 1 THEN
        RETURN "Type"
    ELSEIF hasCaption AND propIdx = 2 THEN
        RETURN "Caption"
    ELSEIF adjIdx = 3 THEN
        RETURN "X"
    ELSEIF adjIdx = 4 THEN
        RETURN "Y"
    ELSEIF adjIdx = 5 THEN
        RETURN "Width"
    ELSEIF adjIdx = 6 THEN
        RETURN "Height"
    ELSEIF adjIdx = 7 THEN
        RETURN "Enabled"
    ELSEIF adjIdx = 8 THEN
        RETURN "Visible"
    ELSEIF adjIdx = 9 THEN
        RETURN "ZOrder"
    ELSEIF adjIdx = 10 THEN
        RETURN "TabIndex"
    ELSEIF adjIdx = 11 THEN
        RETURN "TabStop"
    ELSEIF adjIdx = 12 THEN
        RETURN "ForeColor"
    ELSEIF adjIdx = 13 THEN
        RETURN "BackColor"
    ENDIF

    ' Type-specific properties
    DIM typeStartIdx AS INTEGER = 14
    IF NOT hasCaption THEN
        typeStartIdx = 13
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_TEXTBOX THEN
        IF typeIdx = 0 THEN
            RETURN "Value"
        ELSEIF typeIdx = 1 THEN
            RETURN "Placeholder"
        ELSEIF typeIdx = 2 THEN
            RETURN "CharLimit"
        ELSEIF typeIdx = 3 THEN
            RETURN "EchoMode"
        ELSEIF typeIdx = 4 THEN
            RETURN "Prompt"
        ELSEIF typeIdx = 5 THEN
            RETURN "CursorBlink"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        IF typeIdx = 0 THEN
            RETURN "Items"
        ELSEIF typeIdx = 1 THEN
            RETURN "Title"
        ELSEIF typeIdx = 2 THEN
            RETURN "ShowTitle"
        ELSEIF typeIdx = 3 THEN
            RETURN "ShowStatus"
        ELSEIF typeIdx = 4 THEN
            RETURN "ShowFilter"
        ELSEIF typeIdx = 5 THEN
            RETURN "InfiniteScroll"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_COMBOBOX THEN
        IF typeIdx = 0 THEN
            RETURN "Items"
        ELSEIF typeIdx = 1 THEN
            RETURN "ShowFilter"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        IF typeIdx = 0 THEN
            RETURN "Interval"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LABEL THEN
        IF typeIdx = 0 THEN
            RETURN "Justify"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
        IF typeIdx = 0 THEN
            RETURN "Border"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_OPTION THEN
        IF typeIdx = 0 THEN
            RETURN "GroupName"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_HSCROLL OR ctrl.CtlType = CTRL_VSCROLL THEN
        IF typeIdx = 0 THEN
            RETURN "Value"
        ELSEIF typeIdx = 1 THEN
            RETURN "MinValue"
        ELSEIF typeIdx = 2 THEN
            RETURN "MaxValue"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
        IF typeIdx = 0 THEN
            RETURN "Value"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        IF typeIdx = 0 THEN
            RETURN "Value"
        ELSEIF typeIdx = 1 THEN
            RETURN "Placeholder"
        ELSEIF typeIdx = 2 THEN
            RETURN "CharLimit"
        ELSEIF typeIdx = 3 THEN
            RETURN "ShowLineNums"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        IF typeIdx = 0 THEN
            RETURN "Value"
        ELSEIF typeIdx = 1 THEN
            RETURN "Total"
        ELSEIF typeIdx = 2 THEN
            RETURN "ShowPercent"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        IF typeIdx = 0 THEN
            RETURN "SpinnerStyle"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        IF typeIdx = 0 THEN
            RETURN "Columns"
        ELSEIF typeIdx = 1 THEN
            RETURN "Rows"
        ELSEIF typeIdx = 2 THEN
            RETURN "ShowHeaders"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        IF typeIdx = 0 THEN
            RETURN "Path"
        ELSEIF typeIdx = 1 THEN
            RETURN "ShowHidden"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PATH THEN
        IF typeIdx = 0 THEN
            RETURN "InitialPath"
        ELSEIF typeIdx = 1 THEN
            RETURN "LinkedDirs"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        IF typeIdx = 0 THEN
            RETURN "Path"
        ELSEIF typeIdx = 1 THEN
            RETURN "ShowHidden"
        ELSEIF typeIdx = 2 THEN
            RETURN "LinkedPath"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        IF typeIdx = 0 THEN
            RETURN "Path"
        ELSEIF typeIdx = 1 THEN
            RETURN "ShowHidden"
        ELSEIF typeIdx = 2 THEN
            RETURN "Pattern"
        ELSEIF typeIdx = 3 THEN
            RETURN "LinkedPath"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CURL THEN
        IF typeIdx = 0 THEN
            RETURN "URL"
        ELSEIF typeIdx = 1 THEN
            RETURN "HttpMethod"
        ENDIF
    ENDIF

    RETURN ""
END FUNCTION

' Check if a property at given index is a boolean type
FUNCTION IsPropertyBoolean(ctrl AS VDBControl, propIdx AS INTEGER) AS BOOLEAN
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)
    DIM adjIdx AS INTEGER = propIdx
    IF NOT hasCaption AND propIdx >= 2 THEN
        adjIdx = propIdx + 1
    ENDIF

    ' Base boolean properties: Enabled (7), Visible (8), TabStop (11)
    IF adjIdx = 7 OR adjIdx = 8 OR adjIdx = 11 THEN
        RETURN TRUE
    ENDIF

    ' Type-specific boolean properties
    DIM typeStartIdx AS INTEGER = 14
    IF NOT hasCaption THEN
        typeStartIdx = 13
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_TEXTBOX THEN
        ' CursorBlink (typeIdx = 5)
        IF typeIdx = 5 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        ' ShowTitle (2), ShowStatus (3), ShowFilter (4), InfiniteScroll (5)
        IF typeIdx >= 2 AND typeIdx <= 5 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_COMBOBOX THEN
        ' ShowFilter (1)
        IF typeIdx = 1 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        ' ShowLineNums (3)
        IF typeIdx = 3 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        ' ShowPercent (2)
        IF typeIdx = 2 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        ' ShowHeaders (2)
        IF typeIdx = 2 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
        ' Border (0)
        IF typeIdx = 0 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        ' ShowHidden (1)
        IF typeIdx = 1 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        ' ShowHidden (1)
        IF typeIdx = 1 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        ' ShowHidden (1)
        IF typeIdx = 1 THEN
            RETURN TRUE
        ENDIF
    ENDIF

    RETURN FALSE
END FUNCTION

' Toggle a boolean property and return the modified control
FUNCTION ToggleBooleanProperty(ctrl AS VDBControl, propIdx AS INTEGER) AS VDBControl
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)
    DIM adjIdx AS INTEGER = propIdx
    IF NOT hasCaption AND propIdx >= 2 THEN
        adjIdx = propIdx + 1
    ENDIF

    ' Base boolean properties
    IF adjIdx = 7 THEN
        ctrl.Enabled = NOT ctrl.Enabled
        RETURN ctrl
    ELSEIF adjIdx = 8 THEN
        ctrl.Visible = NOT ctrl.Visible
        RETURN ctrl
    ELSEIF adjIdx = 11 THEN
        ctrl.TabStop = NOT ctrl.TabStop
        RETURN ctrl
    ENDIF

    ' Type-specific boolean properties
    DIM typeStartIdx AS INTEGER = 14
    IF NOT hasCaption THEN
        typeStartIdx = 13
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_TEXTBOX THEN
        IF typeIdx = 5 THEN
            ctrl.CursorBlink = NOT ctrl.CursorBlink
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        IF typeIdx = 2 THEN
            ctrl.ShowTitle = NOT ctrl.ShowTitle
        ELSEIF typeIdx = 3 THEN
            ctrl.ShowStatusBar = NOT ctrl.ShowStatusBar
        ELSEIF typeIdx = 4 THEN
            ctrl.ShowFilter = NOT ctrl.ShowFilter
        ELSEIF typeIdx = 5 THEN
            ctrl.InfiniteScrolling = NOT ctrl.InfiniteScrolling
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_COMBOBOX THEN
        IF typeIdx = 1 THEN
            ctrl.ShowFilter = NOT ctrl.ShowFilter
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        IF typeIdx = 3 THEN
            ctrl.ShowLineNumbers = NOT ctrl.ShowLineNumbers
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        IF typeIdx = 2 THEN
            ctrl.ShowPercentage = NOT ctrl.ShowPercentage
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        IF typeIdx = 2 THEN
            ctrl.ShowHeaders = NOT ctrl.ShowHeaders
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
        IF typeIdx = 0 THEN
            ctrl.Border = NOT ctrl.Border
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        IF typeIdx = 1 THEN
            ctrl.ShowHidden = NOT ctrl.ShowHidden
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        IF typeIdx = 1 THEN
            ctrl.ShowHidden = NOT ctrl.ShowHidden
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        IF typeIdx = 1 THEN
            ctrl.ShowHidden = NOT ctrl.ShowHidden
        ENDIF
    ENDIF

    RETURN ctrl
END FUNCTION

' Check if a property at given index is an enumerable type (can be cycled)
FUNCTION IsPropertyEnumerable(ctrl AS VDBControl, propIdx AS INTEGER) AS BOOLEAN
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)

    ' Type-specific enumerable properties
    DIM typeStartIdx AS INTEGER = 13
    IF NOT hasCaption THEN
        typeStartIdx = 12
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_LABEL THEN
        ' Justification (typeIdx = 0): Left(0), Center(1), Right(2)
        IF typeIdx = 0 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
        ' EchoMode (typeIdx = 3): Normal(0), Password(1), None(2)
        IF typeIdx = 3 THEN
            RETURN TRUE
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        ' SpinnerStyle (typeIdx = 0): Line(0), Dot(1), MiniDot(2), Jump(3), Pulse(4), Points(5)
        IF typeIdx = 0 THEN
            RETURN TRUE
        ENDIF
    ENDIF

    RETURN FALSE
END FUNCTION

' Cycle an enumerable property to its next value and return the modified control
FUNCTION CycleEnumerableProperty(ctrl AS VDBControl, propIdx AS INTEGER) AS VDBControl
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)

    ' Type-specific enumerable properties
    DIM typeStartIdx AS INTEGER = 13
    IF NOT hasCaption THEN
        typeStartIdx = 12
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_LABEL THEN
        ' Justification: Left(0) -> Center(1) -> Right(2) -> Left(0)
        IF typeIdx = 0 THEN
            ctrl.Justification = (ctrl.Justification + 1) MOD 3
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
        ' EchoMode: Normal(0) -> Password(1) -> None(2) -> Normal(0)
        IF typeIdx = 3 THEN
            ctrl.EchoMode = (ctrl.EchoMode + 1) MOD 3
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        ' SpinnerStyle: Line(0) -> Dot(1) -> MiniDot(2) -> Jump(3) -> Pulse(4) -> Points(5) -> Line(0)
        IF typeIdx = 0 THEN
            ctrl.SpinnerStyle = (ctrl.SpinnerStyle + 1) MOD 6
        ENDIF
    ENDIF

    RETURN ctrl
END FUNCTION

' Check if a property is a color property (ForeColor or BackColor)
' Returns: 0=not color, 1=ForeColor, 2=BackColor
FUNCTION IsPropertyColor(ctrl AS VDBControl, propIdx AS INTEGER) AS INTEGER
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)
    DIM adjIdx AS INTEGER = propIdx
    IF NOT hasCaption AND propIdx >= 2 THEN
        adjIdx = propIdx + 1
    ENDIF

    IF adjIdx = 11 THEN
        RETURN 1  ' ForeColor
    ELSEIF adjIdx = 12 THEN
        RETURN 2  ' BackColor
    ENDIF

    RETURN 0  ' Not a color property
END FUNCTION

' Get property value for a control at given index
FUNCTION GetControlPropertyValue(ctrl AS VDBControl, propIdx AS INTEGER) AS STRING
    ' Adjust index for controls without Caption
    DIM hasCaption AS BOOLEAN = ControlUsesCaption(ctrl.CtlType)
    DIM adjIdx AS INTEGER = propIdx
    IF NOT hasCaption AND propIdx >= 2 THEN
        adjIdx = propIdx + 1
    ENDIF

    ' Base properties
    IF propIdx = 0 THEN
        RETURN ctrl.CtlName
    ELSEIF propIdx = 1 THEN
        RETURN GetControlTypeName(ctrl.CtlType)
    ELSEIF hasCaption AND propIdx = 2 THEN
        RETURN ctrl.Caption
    ELSEIF adjIdx = 3 THEN
        RETURN Str(ctrl.X)
    ELSEIF adjIdx = 4 THEN
        RETURN Str(ctrl.Y)
    ELSEIF adjIdx = 5 THEN
        RETURN Str(ctrl.Width)
    ELSEIF adjIdx = 6 THEN
        RETURN Str(ctrl.Height)
    ELSEIF adjIdx = 7 THEN
        IF ctrl.Enabled THEN
            RETURN "True"
        ELSE
            RETURN "False"
        ENDIF
    ELSEIF adjIdx = 8 THEN
        IF ctrl.Visible THEN
            RETURN "True"
        ELSE
            RETURN "False"
        ENDIF
    ELSEIF adjIdx = 9 THEN
        RETURN Str(ctrl.ZOrder)
    ELSEIF adjIdx = 10 THEN
        RETURN Str(ctrl.TabIndex)
    ELSEIF adjIdx = 11 THEN
        IF ctrl.TabStop THEN
            RETURN "True"
        ELSE
            RETURN "False"
        ENDIF
    ELSEIF adjIdx = 12 THEN
        RETURN Str(ctrl.ForeColor)
    ELSEIF adjIdx = 13 THEN
        RETURN Str(ctrl.BackColor)
    ENDIF

    ' Type-specific properties
    DIM typeStartIdx AS INTEGER = 14
    IF NOT hasCaption THEN
        typeStartIdx = 13
    ENDIF
    DIM typeIdx AS INTEGER = propIdx - typeStartIdx

    IF ctrl.CtlType = CTRL_TEXTBOX THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Value
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.Placeholder
        ELSEIF typeIdx = 2 THEN
            RETURN Str(ctrl.CharLimit)
        ELSEIF typeIdx = 3 THEN
            IF ctrl.EchoMode = 0 THEN
                RETURN "Normal"
            ELSEIF ctrl.EchoMode = 1 THEN
                RETURN "Password"
            ELSE
                RETURN "None"
            ENDIF
        ELSEIF typeIdx = 4 THEN
            RETURN ctrl.Prompt
        ELSEIF typeIdx = 5 THEN
            IF ctrl.CursorBlink THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Items
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.Title
        ELSEIF typeIdx = 2 THEN
            IF ctrl.ShowTitle THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ELSEIF typeIdx = 3 THEN
            IF ctrl.ShowStatusBar THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ELSEIF typeIdx = 4 THEN
            IF ctrl.ShowFilter THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ELSEIF typeIdx = 5 THEN
            IF ctrl.InfiniteScrolling THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_COMBOBOX THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Items
        ELSEIF typeIdx = 1 THEN
            IF ctrl.ShowFilter THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        IF typeIdx = 0 THEN
            RETURN Str(ctrl.Interval)
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LABEL THEN
        IF typeIdx = 0 THEN
            IF ctrl.Justification = JUSTIFY_LEFT THEN
                RETURN "Left"
            ELSEIF ctrl.Justification = JUSTIFY_CENTER THEN
                RETURN "Center"
            ELSE
                RETURN "Right"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_BUTTON THEN
        IF typeIdx = 0 THEN
            IF ctrl.Border THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_OPTION THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.GroupName
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_HSCROLL OR ctrl.CtlType = CTRL_VSCROLL THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Value
        ELSEIF typeIdx = 1 THEN
            RETURN Str(ctrl.MinValue)
        ELSEIF typeIdx = 2 THEN
            RETURN Str(ctrl.MaxValue)
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Value
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Value
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.Placeholder
        ELSEIF typeIdx = 2 THEN
            RETURN Str(ctrl.CharLimit)
        ELSEIF typeIdx = 3 THEN
            IF ctrl.ShowLineNumbers THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Value
        ELSEIF typeIdx = 1 THEN
            RETURN Str(ctrl.Total)
        ELSEIF typeIdx = 2 THEN
            IF ctrl.ShowPercentage THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        IF typeIdx = 0 THEN
            RETURN Str(ctrl.SpinnerStyle)
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.Columns
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.Rows
        ELSEIF typeIdx = 2 THEN
            IF ctrl.ShowHeaders THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.FilePath
        ELSEIF typeIdx = 1 THEN
            IF ctrl.ShowHidden THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PATH THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.FilePath
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.LinkedControl
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.FilePath
        ELSEIF typeIdx = 1 THEN
            IF ctrl.ShowHidden THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ELSEIF typeIdx = 2 THEN
            RETURN ctrl.LinkedControl
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.FilePath
        ELSEIF typeIdx = 1 THEN
            IF ctrl.ShowHidden THEN
                RETURN "True"
            ELSE
                RETURN "False"
            ENDIF
        ELSEIF typeIdx = 2 THEN
            RETURN ctrl.Pattern
        ELSEIF typeIdx = 3 THEN
            RETURN ctrl.LinkedControl
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CURL THEN
        IF typeIdx = 0 THEN
            RETURN ctrl.URL
        ELSEIF typeIdx = 1 THEN
            RETURN ctrl.HttpMethod
        ENDIF
    ENDIF

    RETURN ""
END FUNCTION

' Unescape a JSON string value
' Handles: \\ -> \, \" -> ", \n -> newline, \r -> CR, \t -> tab
FUNCTION UnescapeJSONString(s AS STRING) AS STRING
    DIM result AS STRING = ""
    DIM i AS INTEGER = 1
    DIM bslash AS STRING = Chr(92)  ' Backslash

    WHILE i <= Len(s)
        DIM ch AS STRING = Mid(s, i, 1)
        IF ch = bslash AND i < Len(s) THEN
            DIM nextCh AS STRING = Mid(s, i + 1, 1)
            IF nextCh = bslash THEN
                result = result & bslash
                i = i + 2
            ELSEIF nextCh = Chr(34) THEN
                result = result & Chr(34)
                i = i + 2
            ELSEIF nextCh = "n" THEN
                result = result & Chr(10)
                i = i + 2
            ELSEIF nextCh = "r" THEN
                result = result & Chr(13)
                i = i + 2
            ELSEIF nextCh = "t" THEN
                result = result & Chr(9)
                i = i + 2
            ELSE
                result = result & ch
                i = i + 1
            ENDIF
        ELSE
            result = result & ch
            i = i + 1
        ENDIF
    WEND
    RETURN result
END FUNCTION

