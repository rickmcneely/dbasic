' VDBTerm Constants
' View modes, menu constants, dialog constants, control types, focus areas

' View modes
CONST VIEW_FORM AS INTEGER = 0
CONST VIEW_CODE AS INTEGER = 1

' Menu constants
CONST MENU_NONE AS INTEGER = 0
CONST MENU_FILE AS INTEGER = 1
CONST MENU_EDIT AS INTEGER = 2
CONST MENU_VIEW AS INTEGER = 3
CONST MENU_RUN AS INTEGER = 4
CONST MENU_DEBUG AS INTEGER = 5
CONST MENU_OPTIONS AS INTEGER = 6
CONST MENU_HELP AS INTEGER = 7

' Dialog constants
CONST DIALOG_NONE AS INTEGER = 0
CONST DIALOG_NEW_PROJECT AS INTEGER = 1
CONST DIALOG_OPEN_PROJECT AS INTEGER = 2
CONST DIALOG_SAVE_PROJECT AS INTEGER = 3
CONST DIALOG_NEW_FORM AS INTEGER = 4
CONST DIALOG_NEW_MODULE AS INTEGER = 5
CONST DIALOG_PROPERTIES AS INTEGER = 6
CONST DIALOG_HELP AS INTEGER = 7
CONST DIALOG_ABOUT AS INTEGER = 8
CONST DIALOG_CONFIRM_EXIT AS INTEGER = 9
CONST DIALOG_RUN_OPTIONS AS INTEGER = 10
CONST DIALOG_BUILD AS INTEGER = 11
CONST DIALOG_ERROR AS INTEGER = 12
CONST DIALOG_ENVIRONMENT AS INTEGER = 13
CONST DIALOG_EDITOR AS INTEGER = 14
CONST DIALOG_COLORS AS INTEGER = 15
CONST DIALOG_MENU_EDITOR AS INTEGER = 16
CONST DIALOG_OBJECT_BROWSER AS INTEGER = 17
CONST DIALOG_PLUGIN_DESIGNER AS INTEGER = 18
CONST DIALOG_PLUGIN_PROPERTY AS INTEGER = 19
CONST DIALOG_PLUGIN_EVENT AS INTEGER = 20
CONST DIALOG_SAVE_AS AS INTEGER = 21
CONST DIALOG_COMPILE_ERROR AS INTEGER = 22
CONST DIALOG_THEME_EDITOR AS INTEGER = 23
CONST DIALOG_COLOR_PICKER_256 AS INTEGER = 24
CONST DIALOG_FILE_BROWSER AS INTEGER = 25

' File browser focus areas
CONST FILEBROWSER_FOCUS_PATH AS INTEGER = 0
CONST FILEBROWSER_FOCUS_DIRS AS INTEGER = 1
CONST FILEBROWSER_FOCUS_FILES AS INTEGER = 2
CONST FILEBROWSER_FOCUS_BUTTONS AS INTEGER = 3

' Control types for form designer
CONST CTRL_FORM AS INTEGER = 0
CONST CTRL_BUTTON AS INTEGER = 1
CONST CTRL_LABEL AS INTEGER = 2
CONST CTRL_TEXTBOX AS INTEGER = 3
CONST CTRL_CHECKBOX AS INTEGER = 4
CONST CTRL_OPTION AS INTEGER = 5
CONST CTRL_LISTBOX AS INTEGER = 6
CONST CTRL_COMBOBOX AS INTEGER = 7
CONST CTRL_FRAME AS INTEGER = 8
CONST CTRL_HSCROLL AS INTEGER = 9
CONST CTRL_VSCROLL AS INTEGER = 10
CONST CTRL_TIMER AS INTEGER = 11
CONST CTRL_TEXTAREA AS INTEGER = 12
CONST CTRL_PROGRESS AS INTEGER = 13
CONST CTRL_SPINNER AS INTEGER = 14
CONST CTRL_TABLE AS INTEGER = 15
CONST CTRL_SERIAL AS INTEGER = 16
CONST CTRL_TCPIP AS INTEGER = 17
CONST CTRL_UDPIP AS INTEGER = 18
CONST CTRL_DIRBROWSER AS INTEGER = 19
CONST CTRL_PATH AS INTEGER = 20
CONST CTRL_DIRECTORIES AS INTEGER = 21
CONST CTRL_FILES AS INTEGER = 22
CONST CTRL_CURL AS INTEGER = 23

' Text justification
CONST JUSTIFY_LEFT AS INTEGER = 0
CONST JUSTIFY_CENTER AS INTEGER = 1
CONST JUSTIFY_RIGHT AS INTEGER = 2

' Focus areas
CONST FOCUS_PROJECT AS INTEGER = 0
CONST FOCUS_WIDGETS AS INTEGER = 1
CONST FOCUS_TOOLBOX AS INTEGER = 2
CONST FOCUS_FORM AS INTEGER = 3
CONST FOCUS_CODE AS INTEGER = 4
CONST FOCUS_PROPERTIES AS INTEGER = 5

' Panel drag types
CONST PANEL_DRAG_NONE AS INTEGER = 0
CONST PANEL_DRAG_WIDGETS AS INTEGER = 1
CONST PANEL_DRAG_TOOLBOX AS INTEGER = 2

' Visible widget types (for Widgets panel)
' Button, Label, TextBox, CheckBox, Option, ListBox, ComboBox, Frame, HScrollBar, VScrollBar, TextArea, Progress, Spinner, Table, DirBrowser, Path, Directories, Files
' Note: Plugin widgets are added dynamically via the plugin registry
CONST VISIBLE_WIDGET_COUNT AS INTEGER = 18

' Non-visible widget types (for Toolbox panel)
' Timer, Serial, TCP/IP, UDP/IP, Curl
' Note: Plugin widgets are added dynamically via the plugin registry
CONST NONVISIBLE_WIDGET_COUNT AS INTEGER = 5

' Plugin widget type IDs start at 100 (built-in are 0-99)
CONST PLUGIN_TYPE_START AS INTEGER = 100

' Resize handles (corners and edges)
CONST HANDLE_NONE AS INTEGER = 0
CONST HANDLE_TL AS INTEGER = 1
CONST HANDLE_TR AS INTEGER = 2
CONST HANDLE_BL AS INTEGER = 3
CONST HANDLE_BR AS INTEGER = 4
CONST HANDLE_TOP AS INTEGER = 5
CONST HANDLE_BOTTOM AS INTEGER = 6
CONST HANDLE_LEFT AS INTEGER = 7
CONST HANDLE_RIGHT AS INTEGER = 8

' Syntax highlighting token types
CONST TOKEN_DEFAULT AS INTEGER = 0
CONST TOKEN_KEYWORD AS INTEGER = 1
CONST TOKEN_TYPE AS INTEGER = 2
CONST TOKEN_STRING AS INTEGER = 3
CONST TOKEN_COMMENT AS INTEGER = 4
CONST TOKEN_NUMBER AS INTEGER = 5

' Event popup constants
CONST POPUP_NONE AS INTEGER = 0
CONST POPUP_EVENTS AS INTEGER = 1
CONST POPUP_COLOR_PICKER AS INTEGER = 2

' Maximum events per control type
CONST MAX_EVENTS AS INTEGER = 8

' Theme editor focus areas
CONST THEME_FOCUS_PROPS AS INTEGER = 0      ' Property list
CONST THEME_FOCUS_BUTTONS AS INTEGER = 1    ' Bottom buttons
CONST THEME_FOCUS_PICKER AS INTEGER = 2     ' Color picker (256-color mode)

' Plugin Designer modes
CONST PLUGIN_MODE_LIST AS INTEGER = 0
CONST PLUGIN_MODE_METADATA AS INTEGER = 1
CONST PLUGIN_MODE_PROPERTIES AS INTEGER = 2
CONST PLUGIN_MODE_EVENTS AS INTEGER = 3
CONST PLUGIN_MODE_RENDERING AS INTEGER = 4
CONST PLUGIN_MODE_CODEGEN AS INTEGER = 5
