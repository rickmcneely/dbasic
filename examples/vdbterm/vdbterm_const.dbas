' VDBTerm Constants
' View modes, menu constants, dialog constants, control types, focus areas

' View modes
CONST VIEW_FORM AS INTEGER = 0
CONST VIEW_CODE AS INTEGER = 1

' Menu constants
CONST MENU_NONE AS INTEGER = 0
CONST MENU_FILE AS INTEGER = 1
CONST MENU_EDIT AS INTEGER = 2
CONST MENU_VIEW AS INTEGER = 3
CONST MENU_RUN AS INTEGER = 4
CONST MENU_DEBUG AS INTEGER = 5
CONST MENU_OPTIONS AS INTEGER = 6
CONST MENU_HELP AS INTEGER = 7

' Dialog constants
CONST DIALOG_NONE AS INTEGER = 0
CONST DIALOG_NEW_PROJECT AS INTEGER = 1
CONST DIALOG_OPEN_PROJECT AS INTEGER = 2
CONST DIALOG_SAVE_PROJECT AS INTEGER = 3
CONST DIALOG_NEW_FORM AS INTEGER = 4
CONST DIALOG_NEW_MODULE AS INTEGER = 5
CONST DIALOG_PROPERTIES AS INTEGER = 6
CONST DIALOG_HELP AS INTEGER = 7
CONST DIALOG_ABOUT AS INTEGER = 8
CONST DIALOG_CONFIRM_EXIT AS INTEGER = 9
CONST DIALOG_RUN_OPTIONS AS INTEGER = 10
CONST DIALOG_BUILD AS INTEGER = 11
CONST DIALOG_ERROR AS INTEGER = 12
CONST DIALOG_ENVIRONMENT AS INTEGER = 13
CONST DIALOG_EDITOR AS INTEGER = 14
CONST DIALOG_COLORS AS INTEGER = 15
CONST DIALOG_MENU_EDITOR AS INTEGER = 16

' Control types for form designer
CONST CTRL_FORM AS INTEGER = 0
CONST CTRL_BUTTON AS INTEGER = 1
CONST CTRL_LABEL AS INTEGER = 2
CONST CTRL_TEXTBOX AS INTEGER = 3
CONST CTRL_CHECKBOX AS INTEGER = 4
CONST CTRL_OPTION AS INTEGER = 5
