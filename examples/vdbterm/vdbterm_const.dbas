CONST FOCUS_CODE AS INTEGER = 2
CONST FOCUS_PROPERTIES AS INTEGER = 3
CONST FOCUS_PROJECT AS INTEGER = 4

' Resize corners
CONST CORNER_NONE AS INTEGER = 0
