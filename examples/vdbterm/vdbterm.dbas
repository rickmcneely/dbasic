' VDBTerm - Visual DBasic Terminal IDE
' A modern clone of VBDos Pro for terminal environments
' Written in DBasic for DBasic development

IMPORT "github.com/charmbracelet/bubbletea" AS tea
IMPORT "github.com/charmbracelet/lipgloss" AS lipgloss
IMPORT "fmt" AS fmt
IMPORT "os" AS os

' ============================================================================
' CONSTANTS
' ============================================================================

' View modes
CONST VIEW_FORM AS INTEGER = 0
CONST VIEW_CODE AS INTEGER = 1

' Menu constants
CONST MENU_NONE AS INTEGER = 0
CONST MENU_FILE AS INTEGER = 1
CONST MENU_EDIT AS INTEGER = 2
CONST MENU_VIEW AS INTEGER = 3
CONST MENU_RUN AS INTEGER = 4
CONST MENU_DEBUG AS INTEGER = 5
CONST MENU_OPTIONS AS INTEGER = 6
CONST MENU_HELP AS INTEGER = 7

' Dialog constants
CONST DIALOG_NONE AS INTEGER = 0
CONST DIALOG_NEW_PROJECT AS INTEGER = 1
CONST DIALOG_OPEN_PROJECT AS INTEGER = 2
CONST DIALOG_SAVE_PROJECT AS INTEGER = 3
CONST DIALOG_NEW_FORM AS INTEGER = 4
CONST DIALOG_NEW_MODULE AS INTEGER = 5
CONST DIALOG_PROPERTIES AS INTEGER = 6
CONST DIALOG_HELP AS INTEGER = 7
CONST DIALOG_ABOUT AS INTEGER = 8
CONST DIALOG_CONFIRM_EXIT AS INTEGER = 9
CONST DIALOG_RUN_OPTIONS AS INTEGER = 10
CONST DIALOG_BUILD AS INTEGER = 11
CONST DIALOG_ERROR AS INTEGER = 12
CONST DIALOG_ENVIRONMENT AS INTEGER = 13
CONST DIALOG_EDITOR AS INTEGER = 14
CONST DIALOG_COLORS AS INTEGER = 15
CONST DIALOG_MENU_EDITOR AS INTEGER = 16

' Control types for form designer
CONST CTRL_FORM AS INTEGER = 0
CONST CTRL_BUTTON AS INTEGER = 1
CONST CTRL_LABEL AS INTEGER = 2
CONST CTRL_TEXTBOX AS INTEGER = 3
CONST CTRL_CHECKBOX AS INTEGER = 4
CONST CTRL_OPTION AS INTEGER = 5
CONST CTRL_LISTBOX AS INTEGER = 6
CONST CTRL_COMBOBOX AS INTEGER = 7
CONST CTRL_FRAME AS INTEGER = 8
CONST CTRL_HSCROLL AS INTEGER = 9
CONST CTRL_VSCROLL AS INTEGER = 10
CONST CTRL_TIMER AS INTEGER = 11

' Focus areas
CONST FOCUS_TOOLBOX AS INTEGER = 0
CONST FOCUS_FORM AS INTEGER = 1
CONST FOCUS_CODE AS INTEGER = 2
CONST FOCUS_PROPERTIES AS INTEGER = 3
CONST FOCUS_PROJECT AS INTEGER = 4

' ============================================================================
' RESERVED SYSTEM VARIABLES
' ============================================================================
' These variables are available for use in control property expressions.
' They are prefixed with $ to distinguish them from user variables.
'
' Screen/Window variables:
'   $SCREEN_WIDTH   - Current terminal width in characters
'   $SCREEN_HEIGHT  - Current terminal height in characters
'   $FORM_WIDTH     - Current form design width
'   $FORM_HEIGHT    - Current form design height
'   $CONTENT_WIDTH  - Width of the form canvas area
'   $CONTENT_HEIGHT - Height of the form canvas area
'
' Layout constants:
'   $TOOLBOX_WIDTH    - Width of the toolbox panel
'   $PROPERTIES_WIDTH - Width of the properties panel
'   $PROJECT_HEIGHT   - Height of the project tree panel
'
' Example usage in expressions:
'   XExpr = "$CONTENT_WIDTH - 20"   (position 20 chars from right edge)
'   WidthExpr = "$CONTENT_WIDTH / 2" (half the content width)

' ============================================================================
' DATA STRUCTURES
' ============================================================================

' Control definition
TYPE VDBControl
    DIM ID AS INTEGER
    DIM CtlType AS INTEGER
    DIM CtlName AS STRING
    DIM Caption AS STRING
    DIM X AS INTEGER
    DIM Y AS INTEGER
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    ' Expression strings for variable-based positioning/sizing
    DIM XExpr AS STRING
    DIM YExpr AS STRING
    DIM WidthExpr AS STRING
    DIM HeightExpr AS STRING
    DIM Enabled AS BOOLEAN
    DIM Visible AS BOOLEAN
    DIM TabIndex AS INTEGER
    DIM ZOrder AS INTEGER
    DIM Value AS STRING
    DIM ForeColor AS INTEGER
    DIM BackColor AS INTEGER
END TYPE

' Form definition
TYPE VDBForm
    DIM Name AS STRING
    DIM Caption AS STRING
    DIM Width AS INTEGER
    DIM Height AS INTEGER
    DIM BackColor AS INTEGER
    DIM Controls AS []VDBControl
    DIM Code AS STRING
    DIM NextCtrlID AS INTEGER
END TYPE

' Module definition (code-only file)
TYPE VDBModule
    DIM Name AS STRING
    DIM Code AS STRING
END TYPE

' Project definition
TYPE VDBProject
    DIM Name AS STRING
    DIM Path AS STRING
    DIM StartupForm AS STRING
    DIM Forms AS []VDBForm
    DIM Modules AS []VDBModule
    DIM Modified AS BOOLEAN
END TYPE

' ============================================================================
' MAIN APPLICATION MODEL
' ============================================================================

TYPE VDBTermModel IMPLEMENTS tea.Model
    ' Screen dimensions
    DIM Width AS INTEGER
    DIM Height AS INTEGER

    ' Current project
    DIM Project AS VDBProject
    DIM ProjectLoaded AS BOOLEAN

    ' View state
    DIM ViewMode AS INTEGER
    DIM FocusArea AS INTEGER

    ' Form designer state
    DIM CurrentFormIdx AS INTEGER
    DIM SelectedCtrlIdx AS INTEGER
    DIM ToolboxIndex AS INTEGER
    DIM FormScrollX AS INTEGER
    DIM FormScrollY AS INTEGER
    DIM IsDragging AS BOOLEAN
    DIM DragStartX AS INTEGER
    DIM DragStartY AS INTEGER

    ' Code editor state
    DIM CodeCursorX AS INTEGER
    DIM CodeCursorY AS INTEGER
    DIM CodeScrollX AS INTEGER
    DIM CodeScrollY AS INTEGER
    DIM CodeSelecting AS BOOLEAN
    DIM CodeSelStartX AS INTEGER
    DIM CodeSelStartY AS INTEGER
    DIM CodeClipboard AS STRING

    ' Property inspector state
    DIM PropIndex AS INTEGER
    DIM PropEditing AS BOOLEAN
    DIM PropEditValue AS STRING

    ' Project tree state
    DIM TreeIndex AS INTEGER
    DIM TreeExpanded AS []BOOLEAN

    ' Menu state
    DIM MenuOpen AS INTEGER
    DIM MenuIndex AS INTEGER

    ' Dialog state
    DIM DialogMode AS INTEGER
    DIM DialogInput AS STRING
    DIM DialogInput2 AS STRING
    DIM DialogCursor AS INTEGER
    DIM DialogField AS INTEGER

    ' Status
    DIM Message AS STRING
    DIM ErrorMsg AS STRING

    ' Options
    DIM ShowGrid AS BOOLEAN
    DIM GridSize AS INTEGER
    DIM SnapToGrid AS BOOLEAN
    DIM ShowLineNumbers AS BOOLEAN
    DIM TabSize AS INTEGER
    DIM AutoIndent AS BOOLEAN
END TYPE

' ============================================================================
' STYLES
' ============================================================================

DIM styleMenuBar AS lipgloss.Style
DIM styleMenuSelected AS lipgloss.Style
DIM styleMenuHotkey AS lipgloss.Style
DIM styleMenuHotkeySelected AS lipgloss.Style
DIM styleDropdown AS lipgloss.Style
DIM styleDropdownSelected AS lipgloss.Style
DIM styleDropdownHotkey AS lipgloss.Style
DIM styleDropdownHotkeySelected AS lipgloss.Style
DIM styleToolbox AS lipgloss.Style
DIM styleToolboxSelected AS lipgloss.Style
DIM styleFormCanvas AS lipgloss.Style
DIM styleFormGrid AS lipgloss.Style
DIM styleControl AS lipgloss.Style
DIM styleControlSelected AS lipgloss.Style
DIM styleCodeEditor AS lipgloss.Style
DIM styleCodeLineNum AS lipgloss.Style
DIM styleCodeCursor AS lipgloss.Style
DIM styleCodeKeyword AS lipgloss.Style
DIM styleCodeString AS lipgloss.Style
DIM styleCodeComment AS lipgloss.Style
DIM styleCodeNumber AS lipgloss.Style
DIM styleProperties AS lipgloss.Style
DIM stylePropName AS lipgloss.Style
DIM stylePropValue AS lipgloss.Style
DIM stylePropSelected AS lipgloss.Style
DIM styleProjectTree AS lipgloss.Style
DIM styleTreeItem AS lipgloss.Style
DIM styleTreeSelected AS lipgloss.Style
DIM styleStatusBar AS lipgloss.Style
DIM styleDialog AS lipgloss.Style
DIM styleDialogTitle AS lipgloss.Style
DIM styleDialogButton AS lipgloss.Style
DIM styleDialogButtonSelected AS lipgloss.Style

SUB InitStyles()
    ' Modern dark theme with blue accents

    ' Menu bar - dark gray with white text
    styleMenuBar = lipgloss.NewStyle().Background(lipgloss.Color("236")).Foreground(lipgloss.Color("252"))
    styleMenuSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255"))
    styleMenuHotkey = lipgloss.NewStyle().Background(lipgloss.Color("236")).Foreground(lipgloss.Color("214"))
    styleMenuHotkeySelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("214"))

    ' Dropdown menus
    styleDropdown = lipgloss.NewStyle().Background(lipgloss.Color("237")).Foreground(lipgloss.Color("252"))
    styleDropdownSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255"))
    styleDropdownHotkey = lipgloss.NewStyle().Background(lipgloss.Color("237")).Foreground(lipgloss.Color("214"))
    styleDropdownHotkeySelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("214"))

    ' Toolbox panel
    styleToolbox = lipgloss.NewStyle().Background(lipgloss.Color("235")).Foreground(lipgloss.Color("250"))
    styleToolboxSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255"))

    ' Form canvas
    styleFormCanvas = lipgloss.NewStyle().Background(lipgloss.Color("236")).Foreground(lipgloss.Color("252"))
    styleFormGrid = lipgloss.NewStyle().Background(lipgloss.Color("236")).Foreground(lipgloss.Color("238"))

    ' Controls
    styleControl = lipgloss.NewStyle().Background(lipgloss.Color("240")).Foreground(lipgloss.Color("232"))
    styleControlSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255")).Bold(TRUE)

    ' Code editor
    styleCodeEditor = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("252"))
    styleCodeLineNum = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("241"))
    styleCodeCursor = lipgloss.NewStyle().Background(lipgloss.Color("252")).Foreground(lipgloss.Color("234"))
    styleCodeKeyword = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("33")).Bold(TRUE)
    styleCodeString = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("113"))
    styleCodeComment = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("242"))
    styleCodeNumber = lipgloss.NewStyle().Background(lipgloss.Color("234")).Foreground(lipgloss.Color("141"))

    ' Properties panel
    styleProperties = lipgloss.NewStyle().Background(lipgloss.Color("235")).Foreground(lipgloss.Color("252"))
    stylePropName = lipgloss.NewStyle().Background(lipgloss.Color("235")).Foreground(lipgloss.Color("250"))
    stylePropValue = lipgloss.NewStyle().Background(lipgloss.Color("237")).Foreground(lipgloss.Color("252"))
    stylePropSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255"))

    ' Project tree
    styleProjectTree = lipgloss.NewStyle().Background(lipgloss.Color("235")).Foreground(lipgloss.Color("252"))
    styleTreeItem = lipgloss.NewStyle().Background(lipgloss.Color("235")).Foreground(lipgloss.Color("250"))
    styleTreeSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255"))

    ' Status bar
    styleStatusBar = lipgloss.NewStyle().Background(lipgloss.Color("24")).Foreground(lipgloss.Color("255"))

    ' Dialogs
    styleDialog = lipgloss.NewStyle().Background(lipgloss.Color("237")).Foreground(lipgloss.Color("252"))
    styleDialogTitle = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255")).Padding(0, 1)
    styleDialogButton = lipgloss.NewStyle().Background(lipgloss.Color("240")).Foreground(lipgloss.Color("232")).Padding(0, 2)
    styleDialogButtonSelected = lipgloss.NewStyle().Background(lipgloss.Color("33")).Foreground(lipgloss.Color("255")).Padding(0, 2)
END SUB

' ============================================================================
' HELPER FUNCTIONS
' ============================================================================

FUNCTION RepeatStr(ch AS STRING, count AS INTEGER) AS STRING
    DIM result AS STRING = ""
    DIM i AS INTEGER
    FOR i = 1 TO count
        result = result & ch
    NEXT
    RETURN result
END FUNCTION

FUNCTION PadRight(s AS STRING, width AS INTEGER) AS STRING
    IF Len(s) >= width THEN
        RETURN Left(s, width)
    ENDIF
    RETURN s & RepeatStr(" ", width - Len(s))
END FUNCTION

FUNCTION IIFStr(cond AS BOOLEAN, trueVal AS STRING, falseVal AS STRING) AS STRING
    IF cond THEN
        RETURN trueVal
    ENDIF
    RETURN falseVal
END FUNCTION

FUNCTION PadCenter(s AS STRING, width AS INTEGER) AS STRING
    IF Len(s) >= width THEN
        RETURN Left(s, width)
    ENDIF
    DIM padding AS INTEGER = (width - Len(s)) / 2
    RETURN RepeatStr(" ", padding) & s & RepeatStr(" ", width - Len(s) - padding)
END FUNCTION

FUNCTION MinInt(a AS INTEGER, b AS INTEGER) AS INTEGER
    IF a < b THEN
        RETURN a
    ENDIF
    RETURN b
END FUNCTION

FUNCTION MaxInt(a AS INTEGER, b AS INTEGER) AS INTEGER
    IF a > b THEN
        RETURN a
    ENDIF
    RETURN b
END FUNCTION

' Count lines in a string
FUNCTION CountLines(content AS STRING) AS INTEGER
    IF Len(content) = 0 THEN
        RETURN 1
    ENDIF
    DIM count AS INTEGER = 1
    DIM i AS INTEGER
    FOR i = 1 TO Len(content)
        IF Mid(content, i, 1) = Chr(10) THEN
            count = count + 1
        ENDIF
    NEXT
    RETURN count
END FUNCTION

' Get a specific line (1-indexed)
FUNCTION GetLine(content AS STRING, lineNum AS INTEGER) AS STRING
    IF Len(content) = 0 THEN
        RETURN ""
    ENDIF
    DIM currentLine AS INTEGER = 1
    DIM startPos AS INTEGER = 1
    DIM i AS INTEGER

    FOR i = 1 TO Len(content)
        IF currentLine = lineNum THEN
            startPos = i
            EXIT FOR
        ENDIF
        IF Mid(content, i, 1) = Chr(10) THEN
            currentLine = currentLine + 1
        ENDIF
    NEXT

    IF currentLine < lineNum THEN
        RETURN ""
    ENDIF

    DIM result AS STRING = ""
    FOR i = startPos TO Len(content)
        DIM ch AS STRING = Mid(content, i, 1)
        IF ch = Chr(10) THEN
            EXIT FOR
        ENDIF
        result = result & ch
    NEXT
    RETURN result
END FUNCTION

' Get control type name
FUNCTION GetControlTypeName(ctlType AS INTEGER) AS STRING
    IF ctlType = CTRL_FORM THEN
        RETURN "Form"
    ELSEIF ctlType = CTRL_BUTTON THEN
        RETURN "Button"
    ELSEIF ctlType = CTRL_LABEL THEN
        RETURN "Label"
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        RETURN "TextBox"
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        RETURN "CheckBox"
    ELSEIF ctlType = CTRL_OPTION THEN
        RETURN "Option"
    ELSEIF ctlType = CTRL_LISTBOX THEN
        RETURN "ListBox"
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        RETURN "ComboBox"
    ELSEIF ctlType = CTRL_FRAME THEN
        RETURN "Frame"
    ELSEIF ctlType = CTRL_HSCROLL THEN
        RETURN "HScrollBar"
    ELSEIF ctlType = CTRL_VSCROLL THEN
        RETURN "VScrollBar"
    ELSEIF ctlType = CTRL_TIMER THEN
        RETURN "Timer"
    ENDIF
    RETURN "Unknown"
END FUNCTION

' Get toolbox icon for control type
FUNCTION GetToolboxIcon(ctlType AS INTEGER) AS STRING
    IF ctlType = CTRL_BUTTON THEN
        RETURN "[Btn]"
    ELSEIF ctlType = CTRL_LABEL THEN
        RETURN " Lbl "
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        RETURN "[___]"
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        RETURN "[X] "
    ELSEIF ctlType = CTRL_OPTION THEN
        RETURN "(o) "
    ELSEIF ctlType = CTRL_LISTBOX THEN
        RETURN "[=] "
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        RETURN "[v] "
    ELSEIF ctlType = CTRL_FRAME THEN
        RETURN "[-] "
    ELSEIF ctlType = CTRL_HSCROLL THEN
        RETURN "<=> "
    ELSEIF ctlType = CTRL_VSCROLL THEN
        RETURN "[|] "
    ELSEIF ctlType = CTRL_TIMER THEN
        RETURN " T  "
    ENDIF
    RETURN "??? "
END FUNCTION

' ============================================================================
' EXPRESSION EVALUATION
' ============================================================================

' Evaluate a numeric expression that may contain reserved variables
' Returns the evaluated integer value, or the fallback if expression is empty or invalid
FUNCTION EvalExpr(expr AS STRING, m AS VDBTermModel, fallback AS INTEGER) AS INTEGER
    IF Len(expr) = 0 THEN
        RETURN fallback
    ENDIF

    ' Calculate layout dimensions for variable substitution
    DIM toolboxW AS INTEGER = 16
    DIM propertiesW AS INTEGER = 22
    DIM projectH AS INTEGER = 8
    DIM contentW AS INTEGER = m.Width - toolboxW - propertiesW
    DIM contentH AS INTEGER = m.Height - 4
    DIM formW AS INTEGER = 80
    DIM formH AS INTEGER = 25

    IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
        formW = m.Project.Forms[m.CurrentFormIdx].Width
        formH = m.Project.Forms[m.CurrentFormIdx].Height
    ENDIF

    ' Replace reserved variables with their values
    DIM result AS STRING = expr

    ' Screen/Window variables
    result = ReplaceAll(result, "$SCREEN_WIDTH", Str(m.Width))
    result = ReplaceAll(result, "$SCREEN_HEIGHT", Str(m.Height))
    result = ReplaceAll(result, "$FORM_WIDTH", Str(formW))
    result = ReplaceAll(result, "$FORM_HEIGHT", Str(formH))
    result = ReplaceAll(result, "$CONTENT_WIDTH", Str(contentW))
    result = ReplaceAll(result, "$CONTENT_HEIGHT", Str(contentH))

    ' Layout constants
    result = ReplaceAll(result, "$TOOLBOX_WIDTH", Str(toolboxW))
    result = ReplaceAll(result, "$PROPERTIES_WIDTH", Str(propertiesW))
    result = ReplaceAll(result, "$PROJECT_HEIGHT", Str(projectH))

    ' Try to evaluate as simple expression
    RETURN EvalSimpleExpr(result, fallback)
END FUNCTION

' Evaluate a simple arithmetic expression (supports +, -, *, /)
' This is a basic evaluator for expressions like "100 - 20" or "50 / 2"
FUNCTION EvalSimpleExpr(expr AS STRING, fallback AS INTEGER) AS INTEGER
    DIM trimmed AS STRING = TrimStr(expr)

    ' Try to parse as plain integer first
    IF IsNumericStr(trimmed) THEN
        RETURN ParseIntStr(trimmed)
    ENDIF

    ' Look for operators (process in order of precedence, right to left for +/-)
    DIM i AS INTEGER
    DIM depth AS INTEGER = 0

    ' Find + or - (lowest precedence, scan right to left)
    FOR i = Len(trimmed) TO 1 STEP -1
        DIM ch AS STRING = Mid(trimmed, i, 1)
        IF ch = "(" THEN
            depth = depth + 1
        ELSEIF ch = ")" THEN
            depth = depth - 1
        ELSEIF depth = 0 AND (ch = "+" OR ch = "-") AND i > 1 THEN
            DIM lhs AS STRING = TrimStr(Left(trimmed, i - 1))
            DIM rhs AS STRING = TrimStr(Mid(trimmed, i + 1, Len(trimmed) - i))
            DIM lhsVal AS INTEGER = EvalSimpleExpr(lhs, 0)
            DIM rhsVal AS INTEGER = EvalSimpleExpr(rhs, 0)
            IF ch = "+" THEN
                RETURN lhsVal + rhsVal
            ELSE
                RETURN lhsVal - rhsVal
            ENDIF
        ENDIF
    NEXT

    ' Find * or / (higher precedence, scan right to left)
    depth = 0
    FOR i = Len(trimmed) TO 1 STEP -1
        DIM ch2 AS STRING = Mid(trimmed, i, 1)
        IF ch2 = "(" THEN
            depth = depth + 1
        ELSEIF ch2 = ")" THEN
            depth = depth - 1
        ELSEIF depth = 0 AND (ch2 = "*" OR ch2 = "/") THEN
            DIM lhs2 AS STRING = TrimStr(Left(trimmed, i - 1))
            DIM rhs2 AS STRING = TrimStr(Mid(trimmed, i + 1, Len(trimmed) - i))
            DIM lhsVal2 AS INTEGER = EvalSimpleExpr(lhs2, 0)
            DIM rhsVal2 AS INTEGER = EvalSimpleExpr(rhs2, 0)
            IF ch2 = "*" THEN
                RETURN lhsVal2 * rhsVal2
            ELSEIF rhsVal2 <> 0 THEN
                RETURN lhsVal2 / rhsVal2
            ELSE
                RETURN fallback
            ENDIF
        ENDIF
    NEXT

    ' Handle parentheses
    IF Left(trimmed, 1) = "(" AND Right(trimmed, 1) = ")" THEN
        RETURN EvalSimpleExpr(Mid(trimmed, 2, Len(trimmed) - 2), fallback)
    ENDIF

    RETURN fallback
END FUNCTION

' Parse an integer from a string
FUNCTION ParseIntStr(s AS STRING) AS INTEGER
    DIM result AS INTEGER = 0
    DIM negative AS BOOLEAN = FALSE
    DIM i AS INTEGER = 1

    IF Len(s) = 0 THEN
        RETURN 0
    ENDIF

    IF Mid(s, 1, 1) = "-" THEN
        negative = TRUE
        i = 2
    ELSEIF Mid(s, 1, 1) = "+" THEN
        i = 2
    ENDIF

    WHILE i <= Len(s)
        DIM ch AS STRING = Mid(s, i, 1)
        DIM digit AS INTEGER = Asc(ch) - 48
        IF digit >= 0 AND digit <= 9 THEN
            result = result * 10 + digit
        ELSE
            EXIT WHILE
        ENDIF
        i = i + 1
    WEND

    IF negative THEN
        result = -result
    ENDIF

    RETURN result
END FUNCTION

' Check if a string is a valid integer
FUNCTION IsNumericStr(s AS STRING) AS BOOLEAN
    IF Len(s) = 0 THEN
        RETURN FALSE
    ENDIF

    DIM startIdx AS INTEGER = 1
    IF Mid(s, 1, 1) = "-" OR Mid(s, 1, 1) = "+" THEN
        startIdx = 2
    ENDIF

    IF startIdx > Len(s) THEN
        RETURN FALSE
    ENDIF

    DIM i AS INTEGER
    FOR i = startIdx TO Len(s)
        DIM ch AS STRING = Mid(s, i, 1)
        DIM code AS INTEGER = Asc(ch)
        IF code < 48 OR code > 57 THEN
            RETURN FALSE
        ENDIF
    NEXT

    RETURN TRUE
END FUNCTION

' Replace all occurrences of a substring
FUNCTION ReplaceAll(s AS STRING, old AS STRING, new AS STRING) AS STRING
    DIM result AS STRING = ""
    DIM i AS INTEGER = 1
    DIM oldLen AS INTEGER = Len(old)

    WHILE i <= Len(s)
        IF Mid(s, i, oldLen) = old THEN
            result = result & new
            i = i + oldLen
        ELSE
            result = result & Mid(s, i, 1)
            i = i + 1
        ENDIF
    WEND

    RETURN result
END FUNCTION

' Trim whitespace from both ends of a string
FUNCTION TrimStr(s AS STRING) AS STRING
    DIM startIdx AS INTEGER = 1
    DIM endIdx AS INTEGER = Len(s)

    WHILE startIdx <= endIdx AND Mid(s, startIdx, 1) = " "
        startIdx = startIdx + 1
    WEND

    WHILE endIdx >= startIdx AND Mid(s, endIdx, 1) = " "
        endIdx = endIdx - 1
    WEND

    IF startIdx > endIdx THEN
        RETURN ""
    ENDIF

    RETURN Mid(s, startIdx, endIdx - startIdx + 1)
END FUNCTION

' ============================================================================
' PROJECT OPERATIONS
' ============================================================================

FUNCTION NewProject(name AS STRING) AS VDBProject
    DIM proj AS VDBProject
    proj.Name = name
    proj.Path = ""
    proj.StartupForm = "Form1"
    proj.Modified = FALSE

    ' Create default form with sample controls
    DIM form AS VDBForm
    form.Name = "Form1"
    form.Caption = "VDBTerm Demo Form"
    form.Width = 60
    form.Height = 20
    form.BackColor = 7
    form.Code = "' Form1 Code - VDBTerm Demo" & Chr(10) & Chr(10)
    form.Code = form.Code & "' This form demonstrates various VDBTerm controls" & Chr(10)
    form.Code = form.Code & "' Use arrow keys to move controls, +/- to resize" & Chr(10)
    form.Code = form.Code & "' Click with mouse to select and drag controls" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB Form_Load()" & Chr(10)
    form.Code = form.Code & "    ' Initialize form controls" & Chr(10)
    form.Code = form.Code & "    lblTitle.Caption = " & Chr(34) & "Welcome to VDBTerm!" & Chr(34) & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10) & Chr(10)
    form.Code = form.Code & "SUB btnOK_Click()" & Chr(10)
    form.Code = form.Code & "    ' Handle OK button click" & Chr(10)
    form.Code = form.Code & "END SUB" & Chr(10)
    form.NextCtrlID = 1

    ' Add sample controls to demonstrate features
    DIM ctrl AS VDBControl

    ' Title label at top
    ctrl = NewControl(CTRL_LABEL, "lblTitle", 2, 1)
    ctrl.Caption = "VDBTerm Demo"
    ctrl.Width = 20
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Text input field
    ctrl = NewControl(CTRL_TEXTBOX, "txtInput", 2, 3)
    ctrl.Width = 25
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Buttons
    ctrl = NewControl(CTRL_BUTTON, "btnOK", 2, 5)
    ctrl.Caption = "OK"
    ctrl.Width = 10
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ctrl = NewControl(CTRL_BUTTON, "btnCancel", 14, 5)
    ctrl.Caption = "Cancel"
    ctrl.Width = 10
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Checkbox
    ctrl = NewControl(CTRL_CHECKBOX, "chkOption", 2, 8)
    ctrl.Caption = "Enable feature"
    ctrl.Width = 18
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Option buttons
    ctrl = NewControl(CTRL_OPTION, "optChoice1", 2, 10)
    ctrl.Caption = "Option A"
    ctrl.Width = 12
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ctrl = NewControl(CTRL_OPTION, "optChoice2", 2, 11)
    ctrl.Caption = "Option B"
    ctrl.Width = 12
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' ListBox
    ctrl = NewControl(CTRL_LISTBOX, "lstItems", 30, 3)
    ctrl.Width = 18
    ctrl.Height = 6
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    ' Frame to group controls
    ctrl = NewControl(CTRL_FRAME, "fraGroup", 28, 1)
    ctrl.Caption = "Options"
    ctrl.Width = 22
    ctrl.Height = 10
    form.Controls = APPEND(form.Controls, ctrl)
    form.NextCtrlID = form.NextCtrlID + 1

    proj.Forms = APPEND(proj.Forms, form)
    RETURN proj
END FUNCTION

FUNCTION NewForm(name AS STRING) AS VDBForm
    DIM form AS VDBForm
    form.Name = name
    form.Caption = name
    form.Width = 60
    form.Height = 20
    form.BackColor = 7
    form.Code = "' " & name & " Code" & Chr(10) & Chr(10) & "SUB Form_Load()" & Chr(10) & "    ' Initialization code here" & Chr(10) & "END SUB" & Chr(10)
    form.NextCtrlID = 1
    RETURN form
END FUNCTION

FUNCTION NewModule(name AS STRING) AS VDBModule
    DIM newMod AS VDBModule
    newMod.Name = name
    newMod.Code = "' " & name & " Module" & Chr(10) & Chr(10) & "' Shared functions and subroutines" & Chr(10)
    RETURN newMod
END FUNCTION

FUNCTION NewControl(ctlType AS INTEGER, name AS STRING, x AS INTEGER, y AS INTEGER) AS VDBControl
    DIM ctrl AS VDBControl
    ctrl.CtlType = ctlType
    ctrl.CtlName = name
    ctrl.X = x
    ctrl.Y = y
    ctrl.Enabled = TRUE
    ctrl.Visible = TRUE
    ctrl.ForeColor = 0
    ctrl.BackColor = 7

    ' Set default sizes based on type
    IF ctlType = CTRL_BUTTON THEN
        ctrl.Width = 10
        ctrl.Height = 3
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_LABEL THEN
        ctrl.Width = 8
        ctrl.Height = 1
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_TEXTBOX THEN
        ctrl.Width = 15
        ctrl.Height = 1
        ctrl.Value = ""
    ELSEIF ctlType = CTRL_CHECKBOX THEN
        ctrl.Width = 12
        ctrl.Height = 1
        ctrl.Caption = name
        ctrl.Value = "0"
    ELSEIF ctlType = CTRL_OPTION THEN
        ctrl.Width = 12
        ctrl.Height = 1
        ctrl.Caption = name
        ctrl.Value = "0"
    ELSEIF ctlType = CTRL_LISTBOX THEN
        ctrl.Width = 15
        ctrl.Height = 5
    ELSEIF ctlType = CTRL_COMBOBOX THEN
        ctrl.Width = 15
        ctrl.Height = 1
    ELSEIF ctlType = CTRL_FRAME THEN
        ctrl.Width = 20
        ctrl.Height = 8
        ctrl.Caption = name
    ELSEIF ctlType = CTRL_HSCROLL THEN
        ctrl.Width = 15
        ctrl.Height = 1
        ctrl.Value = "0"
    ELSEIF ctlType = CTRL_VSCROLL THEN
        ctrl.Width = 1
        ctrl.Height = 8
        ctrl.Value = "0"
    ELSEIF ctlType = CTRL_TIMER THEN
        ctrl.Width = 3
        ctrl.Height = 1
        ctrl.Value = "1000"
        ctrl.Visible = FALSE
    ENDIF

    RETURN ctrl
END FUNCTION

' Serialize project to JSON string
FUNCTION SerializeProject(proj AS VDBProject) AS STRING
    DIM result AS STRING = "{" & Chr(10)
    result = result & "  " & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & proj.Name & Chr(34) & "," & Chr(10)
    result = result & "  " & Chr(34) & "startupForm" & Chr(34) & ": " & Chr(34) & proj.StartupForm & Chr(34) & "," & Chr(10)

    ' Forms array
    result = result & "  " & Chr(34) & "forms" & Chr(34) & ": [" & Chr(10)
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM f AS VDBForm = proj.Forms[i]
        result = result & "    {" & Chr(10)
        result = result & "      " & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & f.Name & Chr(34) & "," & Chr(10)
        result = result & "      " & Chr(34) & "caption" & Chr(34) & ": " & Chr(34) & f.Caption & Chr(34) & "," & Chr(10)
        result = result & "      " & Chr(34) & "width" & Chr(34) & ": " & Str(f.Width) & "," & Chr(10)
        result = result & "      " & Chr(34) & "height" & Chr(34) & ": " & Str(f.Height) & "," & Chr(10)
        result = result & "      " & Chr(34) & "controls" & Chr(34) & ": [" & Chr(10)

        DIM j AS INTEGER
        FOR j = 0 TO Len(f.Controls) - 1
            DIM c AS VDBControl = f.Controls[j]
            result = result & "        {" & Chr(10)
            result = result & "          " & Chr(34) & "id" & Chr(34) & ": " & Str(c.ID) & "," & Chr(10)
            result = result & "          " & Chr(34) & "type" & Chr(34) & ": " & Str(c.CtlType) & "," & Chr(10)
            result = result & "          " & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & c.CtlName & Chr(34) & "," & Chr(10)
            result = result & "          " & Chr(34) & "caption" & Chr(34) & ": " & Chr(34) & c.Caption & Chr(34) & "," & Chr(10)
            result = result & "          " & Chr(34) & "x" & Chr(34) & ": " & Str(c.X) & "," & Chr(10)
            result = result & "          " & Chr(34) & "y" & Chr(34) & ": " & Str(c.Y) & "," & Chr(10)
            result = result & "          " & Chr(34) & "width" & Chr(34) & ": " & Str(c.Width) & "," & Chr(10)
            result = result & "          " & Chr(34) & "height" & Chr(34) & ": " & Str(c.Height) & Chr(10)
            result = result & "        }"
            IF j < Len(f.Controls) - 1 THEN
                result = result & ","
            ENDIF
            result = result & Chr(10)
        NEXT

        result = result & "      ]" & Chr(10)
        result = result & "    }"
        IF i < Len(proj.Forms) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]," & Chr(10)

    ' Modules array
    result = result & "  " & Chr(34) & "modules" & Chr(34) & ": [" & Chr(10)
    FOR i = 0 TO Len(proj.Modules) - 1
        DIM m AS VDBModule = proj.Modules[i]
        result = result & "    {" & Chr(10)
        result = result & "      " & Chr(34) & "name" & Chr(34) & ": " & Chr(34) & m.Name & Chr(34) & Chr(10)
        result = result & "    }"
        IF i < Len(proj.Modules) - 1 THEN
            result = result & ","
        ENDIF
        result = result & Chr(10)
    NEXT
    result = result & "  ]" & Chr(10)

    result = result & "}"
    RETURN result
END FUNCTION

' Save project to file
SUB SaveProject(proj AS POINTER TO VDBProject, path AS STRING)
    ' Save main project file
    DIM projJson AS STRING = SerializeProject(^proj)
    WriteFile(path, projJson)

    ' Save form code files in same directory
    DIM i AS INTEGER
    FOR i = 0 TO Len((^proj).Forms) - 1
        DIM f AS VDBForm = (^proj).Forms[i]
        DIM formPath AS STRING = f.Name & ".frm"
        WriteFile(formPath, f.Code)
    NEXT

    ' Save module code files
    FOR i = 0 TO Len((^proj).Modules) - 1
        DIM modFile AS VDBModule = (^proj).Modules[i]
        DIM modPath AS STRING = modFile.Name & ".bas"
        WriteFile(modPath, modFile.Code)
    NEXT

    (^proj).Path = path
    (^proj).Modified = FALSE
END SUB

' Generate DBasic code from project
FUNCTION GenerateCode(proj AS VDBProject) AS STRING
    DIM code AS STRING = "' Generated by VDBTerm - Visual DBasic Terminal IDE" & Chr(10)
    code = code & "' Project: " & proj.Name & Chr(10)
    code = code & Chr(10)
    code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/bubbletea" & Chr(34) & " AS tea" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "github.com/charmbracelet/lipgloss" & Chr(34) & " AS lipgloss" & Chr(10)
    code = code & "IMPORT " & Chr(34) & "fmt" & Chr(34) & " AS fmt" & Chr(10)
    code = code & Chr(10)

    ' Generate control structures for each form
    DIM i AS INTEGER
    FOR i = 0 TO Len(proj.Forms) - 1
        DIM f AS VDBForm = proj.Forms[i]
        code = code & "' ============================================" & Chr(10)
        code = code & "' Form: " & f.Name & Chr(10)
        code = code & "' ============================================" & Chr(10)
        code = code & Chr(10)

        ' Form type definition
        code = code & "TYPE " & f.Name & "Form" & Chr(10)
        code = code & "    DIM Visible AS BOOLEAN" & Chr(10)
        code = code & "    DIM Caption AS STRING" & Chr(10)

        DIM j AS INTEGER
        FOR j = 0 TO Len(f.Controls) - 1
            DIM c AS VDBControl = f.Controls[j]
            code = code & "    DIM " & c.CtlName & "_Value AS STRING" & Chr(10)
            code = code & "    DIM " & c.CtlName & "_Enabled AS BOOLEAN" & Chr(10)
        NEXT
        code = code & "END TYPE" & Chr(10)
        code = code & Chr(10)

        ' Form code
        code = code & f.Code & Chr(10)
        code = code & Chr(10)
    NEXT

    ' Generate module code
    FOR i = 0 TO Len(proj.Modules) - 1
        DIM m AS VDBModule = proj.Modules[i]
        code = code & "' ============================================" & Chr(10)
        code = code & "' Module: " & m.Name & Chr(10)
        code = code & "' ============================================" & Chr(10)
        code = code & Chr(10)
        code = code & m.Code & Chr(10)
        code = code & Chr(10)
    NEXT

    ' Generate main entry point
    code = code & "' ============================================" & Chr(10)
    code = code & "' Main Entry Point" & Chr(10)
    code = code & "' ============================================" & Chr(10)
    code = code & Chr(10)
    code = code & "SUB Main()" & Chr(10)
    code = code & "    ' Initialize startup form" & Chr(10)
    code = code & "    " & proj.StartupForm & "_Load()" & Chr(10)
    code = code & "END SUB" & Chr(10)

    RETURN code
END FUNCTION

' ============================================================================
' BUBBLE TEA MODEL IMPLEMENTATION
' ============================================================================

FUNCTION (m AS VDBTermModel) Init() AS tea.Cmd
    InitStyles()
    RETURN NIL
END FUNCTION

FUNCTION (m AS VDBTermModel) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' Handle window resize
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = Int(sizeMsg.Width)
        m.Height = Int(sizeMsg.Height)
        RETURN m, NIL
    ENDIF

    ' Handle mouse messages
    DIM mouseMsg AS tea.MouseMsg
    DIM mouseOk AS BOOLEAN
    mouseMsg, mouseOk = msg.(tea.MouseMsg)
    IF mouseOk THEN
        RETURN HandleMouseInput(m, mouseMsg)
    ENDIF

    ' Handle key messages
    DIM keyMsg AS tea.KeyMsg
    DIM ok AS BOOLEAN
    keyMsg, ok = msg.(tea.KeyMsg)

    IF NOT ok THEN
        RETURN m, NIL
    ENDIF

    DIM key AS STRING = keyMsg.String()

    ' Dialog input takes priority
    IF m.DialogMode <> DIALOG_NONE THEN
        RETURN HandleDialogInput(m, key)
    ENDIF

    ' Menu input
    IF m.MenuOpen <> MENU_NONE THEN
        RETURN HandleMenuInput(m, key)
    ENDIF

    ' Global shortcuts
    IF key = "f10" OR key = "alt+f" THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+e" THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+v" THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+r" THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+d" THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+o" THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+h" OR key = "f1" THEN
        m.DialogMode = DIALOG_HELP
        RETURN m, NIL
    ELSEIF key = "ctrl+q" OR key = "alt+x" THEN
        IF m.Project.Modified THEN
            m.DialogMode = DIALOG_CONFIRM_EXIT
        ELSE
            RETURN m, tea.Quit
        ENDIF
        RETURN m, NIL
    ELSEIF key = "f5" THEN
        RETURN DoRun(m)
    ELSEIF key = "f7" THEN
        ' Toggle between Form and Code view
        IF m.ViewMode = VIEW_FORM THEN
            m.ViewMode = VIEW_CODE
        ELSE
            m.ViewMode = VIEW_FORM
        ENDIF
        RETURN m, NIL
    ELSEIF key = "tab" THEN
        ' Cycle focus areas
        m.FocusArea = m.FocusArea + 1
        IF m.FocusArea > FOCUS_PROJECT THEN
            m.FocusArea = FOCUS_TOOLBOX
        ENDIF
        RETURN m, NIL
    ELSEIF key = "shift+tab" THEN
        ' Cycle focus backwards
        m.FocusArea = m.FocusArea - 1
        IF m.FocusArea < FOCUS_TOOLBOX THEN
            m.FocusArea = FOCUS_PROJECT
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Route input based on focus area
    IF m.FocusArea = FOCUS_TOOLBOX THEN
        RETURN HandleToolboxInput(m, key)
    ELSEIF m.FocusArea = FOCUS_FORM THEN
        RETURN HandleFormInput(m, key)
    ELSEIF m.FocusArea = FOCUS_CODE THEN
        RETURN HandleCodeInput(m, key)
    ELSEIF m.FocusArea = FOCUS_PROPERTIES THEN
        RETURN HandlePropertiesInput(m, key)
    ELSEIF m.FocusArea = FOCUS_PROJECT THEN
        RETURN HandleProjectInput(m, key)
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' INPUT HANDLERS
' ============================================================================

FUNCTION HandleDialogInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.DialogMode = DIALOG_NONE
        RETURN m, NIL
    ENDIF

    ' Simple info dialogs
    IF m.DialogMode = DIALOG_HELP OR m.DialogMode = DIALOG_ABOUT THEN
        IF key = "enter" OR key = " " THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Confirmation dialog
    IF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        IF key = "y" OR key = "Y" THEN
            RETURN m, tea.Quit
        ELSEIF key = "n" OR key = "N" THEN
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Text input dialogs
    IF key = "enter" THEN
        IF m.DialogMode = DIALOG_NEW_PROJECT THEN
            m.Project = NewProject(m.DialogInput)
            m.ProjectLoaded = TRUE
            m.CurrentFormIdx = 0
            m.Message = "New project: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_FORM THEN
            DIM addForm AS VDBForm
            addForm = NewForm(m.DialogInput)
            m.Project.Forms = APPEND(m.Project.Forms, addForm)
            m.CurrentFormIdx = Len(m.Project.Forms) - 1
            m.Project.Modified = TRUE
            m.Message = "New form: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_NEW_MODULE THEN
            DIM addMod AS VDBModule
            addMod = NewModule(m.DialogInput)
            m.Project.Modules = APPEND(m.Project.Modules, addMod)
            m.Project.Modified = TRUE
            m.Message = "New module: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ELSEIF m.DialogMode = DIALOG_SAVE_PROJECT THEN
            SaveProject(@m.Project, m.DialogInput)
            m.Message = "Project saved: " & m.DialogInput
            m.DialogMode = DIALOG_NONE
        ENDIF
        RETURN m, NIL
    ELSEIF key = "backspace" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor - 1) & Mid(m.DialogInput, m.DialogCursor + 1, Len(m.DialogInput) - m.DialogCursor)
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "delete" THEN
        IF m.DialogCursor < Len(m.DialogInput) THEN
            m.DialogInput = Left(m.DialogInput, m.DialogCursor) & Mid(m.DialogInput, m.DialogCursor + 2, Len(m.DialogInput) - m.DialogCursor - 1)
        ENDIF
    ELSEIF key = "left" THEN
        IF m.DialogCursor > 0 THEN
            m.DialogCursor = m.DialogCursor - 1
        ENDIF
    ELSEIF key = "right" THEN
        IF m.DialogCursor < Len(m.DialogInput) THEN
            m.DialogCursor = m.DialogCursor + 1
        ENDIF
    ELSEIF key = "home" THEN
        m.DialogCursor = 0
    ELSEIF key = "end" THEN
        m.DialogCursor = Len(m.DialogInput)
    ELSEIF Len(key) = 1 THEN
        m.DialogInput = Left(m.DialogInput, m.DialogCursor) & key & Mid(m.DialogInput, m.DialogCursor + 1, Len(m.DialogInput) - m.DialogCursor)
        m.DialogCursor = m.DialogCursor + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "esc" THEN
        m.MenuOpen = MENU_NONE
        RETURN m, NIL
    ELSEIF key = "left" THEN
        m.MenuOpen = m.MenuOpen - 1
        IF m.MenuOpen < MENU_FILE THEN
            m.MenuOpen = MENU_HELP
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "right" THEN
        m.MenuOpen = m.MenuOpen + 1
        IF m.MenuOpen > MENU_HELP THEN
            m.MenuOpen = MENU_FILE
        ENDIF
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "up" THEN
        m.MenuIndex = m.MenuIndex - 1
        IF m.MenuIndex < 0 THEN
            m.MenuIndex = GetMenuItemCount(m.MenuOpen) - 1
        ENDIF
        RETURN m, NIL
    ELSEIF key = "down" THEN
        m.MenuIndex = m.MenuIndex + 1
        IF m.MenuIndex >= GetMenuItemCount(m.MenuOpen) THEN
            m.MenuIndex = 0
        ENDIF
        RETURN m, NIL
    ELSEIF key = "enter" THEN
        RETURN ExecuteMenuItem(m)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION GetMenuItemCount(menu AS INTEGER) AS INTEGER
    IF menu = MENU_FILE THEN
        RETURN 8
    ELSEIF menu = MENU_EDIT THEN
        RETURN 8
    ELSEIF menu = MENU_VIEW THEN
        RETURN 5
    ELSEIF menu = MENU_RUN THEN
        RETURN 4
    ELSEIF menu = MENU_DEBUG THEN
        RETURN 5
    ELSEIF menu = MENU_OPTIONS THEN
        RETURN 4
    ELSEIF menu = MENU_HELP THEN
        RETURN 2
    ENDIF
    RETURN 0
END FUNCTION

FUNCTION ExecuteMenuItem(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    DIM currentMenu AS INTEGER = m.MenuOpen
    m.MenuOpen = MENU_NONE

    IF currentMenu = MENU_FILE THEN
        IF m.MenuIndex = 0 THEN
            ' New Project
            m.DialogMode = DIALOG_NEW_PROJECT
            m.DialogInput = "Project1"
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 1 THEN
            ' Open Project
            m.DialogMode = DIALOG_OPEN_PROJECT
            m.DialogInput = ""
            m.DialogCursor = 0
        ELSEIF m.MenuIndex = 2 THEN
            ' Save Project
            IF Len(m.Project.Path) = 0 THEN
                m.DialogMode = DIALOG_SAVE_PROJECT
                m.DialogInput = m.Project.Name & ".vdb"
                m.DialogCursor = Len(m.DialogInput)
            ELSE
                SaveProject(@m.Project, m.Project.Path)
                m.Message = "Project saved"
            ENDIF
        ELSEIF m.MenuIndex = 4 THEN
            ' New Form
            m.DialogMode = DIALOG_NEW_FORM
            m.DialogInput = "Form" & Str(Len(m.Project.Forms) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 5 THEN
            ' New Module
            m.DialogMode = DIALOG_NEW_MODULE
            m.DialogInput = "Module" & Str(Len(m.Project.Modules) + 1)
            m.DialogCursor = Len(m.DialogInput)
        ELSEIF m.MenuIndex = 7 THEN
            ' Exit
            IF m.Project.Modified THEN
                m.DialogMode = DIALOG_CONFIRM_EXIT
            ELSE
                RETURN m, tea.Quit
            ENDIF
        ENDIF
    ELSEIF currentMenu = MENU_EDIT THEN
        IF m.MenuIndex = 7 THEN
            ' Menu Editor
            m.DialogMode = DIALOG_MENU_EDITOR
        ENDIF
    ELSEIF currentMenu = MENU_VIEW THEN
        IF m.MenuIndex = 0 THEN
            m.ViewMode = VIEW_FORM
        ELSEIF m.MenuIndex = 1 THEN
            m.ViewMode = VIEW_CODE
        ELSEIF m.MenuIndex = 3 THEN
            m.ShowGrid = NOT m.ShowGrid
        ENDIF
    ELSEIF currentMenu = MENU_RUN THEN
        IF m.MenuIndex = 0 THEN
            RETURN DoRun(m)
        ELSEIF m.MenuIndex = 1 THEN
            RETURN DoBuild(m)
        ENDIF
    ELSEIF currentMenu = MENU_OPTIONS THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_ENVIRONMENT
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_EDITOR
        ELSEIF m.MenuIndex = 3 THEN
            m.DialogMode = DIALOG_COLORS
        ENDIF
    ELSEIF currentMenu = MENU_HELP THEN
        IF m.MenuIndex = 0 THEN
            m.DialogMode = DIALOG_HELP
        ELSEIF m.MenuIndex = 1 THEN
            m.DialogMode = DIALOG_ABOUT
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleToolboxInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "up" THEN
        IF m.ToolboxIndex > 0 THEN
            m.ToolboxIndex = m.ToolboxIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        IF m.ToolboxIndex < 10 THEN
            m.ToolboxIndex = m.ToolboxIndex + 1
        ENDIF
    ELSEIF key = "enter" OR key = " " THEN
        ' Add control to form
        IF m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
            DIM ctlType AS INTEGER = m.ToolboxIndex + 1
            DIM ctlName AS STRING = GetControlTypeName(ctlType) & Str(m.Project.Forms[m.CurrentFormIdx].NextCtrlID)
            DIM ctrl AS VDBControl = NewControl(ctlType, ctlName, 5, 5)
            ctrl.ID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID
            m.Project.Forms[m.CurrentFormIdx].NextCtrlID = m.Project.Forms[m.CurrentFormIdx].NextCtrlID + 1
            m.Project.Forms[m.CurrentFormIdx].Controls = APPEND(m.Project.Forms[m.CurrentFormIdx].Controls, ctrl)
            m.SelectedCtrlIdx = Len(m.Project.Forms[m.CurrentFormIdx].Controls) - 1
            m.Project.Modified = TRUE
            m.FocusArea = FOCUS_FORM
            m.Message = "Added " & ctlName
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)

    IF key = "up" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "down" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "left" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X - 1
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X < 0 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = 0
            ENDIF
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "right" THEN
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "pgup" THEN
        ' Select previous control
        IF m.SelectedCtrlIdx > 0 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx - 1
        ENDIF
    ELSEIF key = "pgdown" THEN
        ' Select next control
        IF m.SelectedCtrlIdx < ctrlCount - 1 THEN
            m.SelectedCtrlIdx = m.SelectedCtrlIdx + 1
        ENDIF
    ELSEIF key = "delete" THEN
        ' Delete selected control
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            DIM newControls AS []VDBControl
            DIM i AS INTEGER
            FOR i = 0 TO ctrlCount - 1
                IF i <> m.SelectedCtrlIdx THEN
                    newControls = APPEND(newControls, m.Project.Forms[m.CurrentFormIdx].Controls[i])
                ENDIF
            NEXT
            m.Project.Forms[m.CurrentFormIdx].Controls = newControls
            IF m.SelectedCtrlIdx >= Len(newControls) THEN
                m.SelectedCtrlIdx = Len(newControls) - 1
            ENDIF
            m.Project.Modified = TRUE
            m.Message = "Control deleted"
        ENDIF
    ELSEIF key = "+" THEN
        ' Increase width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width + 1
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF key = "-" THEN
        ' Decrease width
        IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < ctrlCount THEN
            IF m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width > 1 THEN
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width - 1
                m.Project.Modified = TRUE
            ENDIF
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)
    DIM currentLine AS STRING = GetLine(code, m.CodeCursorY + 1)
    DIM lineLen AS INTEGER = Len(currentLine)

    IF key = "left" THEN
        IF m.CodeCursorX > 0 THEN
            m.CodeCursorX = m.CodeCursorX - 1
        ELSEIF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = Len(GetLine(code, m.CodeCursorY + 1))
        ENDIF
    ELSEIF key = "right" THEN
        IF m.CodeCursorX < lineLen THEN
            m.CodeCursorX = m.CodeCursorX + 1
        ELSEIF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            m.CodeCursorX = 0
        ENDIF
    ELSEIF key = "up" THEN
        IF m.CodeCursorY > 0 THEN
            m.CodeCursorY = m.CodeCursorY - 1
            DIM upLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > upLineLen THEN
                m.CodeCursorX = upLineLen
            ENDIF
        ENDIF
    ELSEIF key = "down" THEN
        IF m.CodeCursorY < totalLines - 1 THEN
            m.CodeCursorY = m.CodeCursorY + 1
            DIM downLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY + 1))
            IF m.CodeCursorX > downLineLen THEN
                m.CodeCursorX = downLineLen
            ENDIF
        ENDIF
    ELSEIF key = "home" THEN
        m.CodeCursorX = 0
    ELSEIF key = "end" THEN
        m.CodeCursorX = lineLen
    ELSEIF key = "enter" THEN
        ' Insert new line
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeNewLine(code, m.CodeCursorY + 1, m.CodeCursorX)
        m.CodeCursorY = m.CodeCursorY + 1
        m.CodeCursorX = 0
        m.Project.Modified = TRUE
    ELSEIF key = "backspace" THEN
        IF m.CodeCursorX > 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Code = DeleteCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX - 1)
            m.CodeCursorX = m.CodeCursorX - 1
            m.Project.Modified = TRUE
        ELSEIF m.CodeCursorY > 0 THEN
            DIM prevLineLen AS INTEGER = Len(GetLine(code, m.CodeCursorY))
            m.Project.Forms[m.CurrentFormIdx].Code = JoinCodeWithPrevLine(code, m.CodeCursorY + 1)
            m.CodeCursorY = m.CodeCursorY - 1
            m.CodeCursorX = prevLineLen
            m.Project.Modified = TRUE
        ENDIF
    ELSEIF Len(key) = 1 THEN
        ' Insert character
        m.Project.Forms[m.CurrentFormIdx].Code = InsertCodeCharAt(code, m.CodeCursorY + 1, m.CodeCursorX, key)
        m.CodeCursorX = m.CodeCursorX + 1
        m.Project.Modified = TRUE
    ENDIF

    ' Update scroll position
    DIM visibleLines AS INTEGER = m.Height - 6
    IF m.CodeCursorY < m.CodeScrollY THEN
        m.CodeScrollY = m.CodeCursorY
    ELSEIF m.CodeCursorY >= m.CodeScrollY + visibleLines THEN
        m.CodeScrollY = m.CodeCursorY - visibleLines + 1
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePropertiesInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF m.PropEditing THEN
        ' Handle editing mode
        IF key = "enter" OR key = "esc" THEN
            IF key = "enter" THEN
                ' Apply the edited value
                m = ApplyPropertyEdit(m)
            ENDIF
            m.PropEditing = FALSE
            m.PropEditValue = ""
        ELSEIF key = "backspace" THEN
            IF Len(m.PropEditValue) > 0 THEN
                m.PropEditValue = Left(m.PropEditValue, Len(m.PropEditValue) - 1)
            ENDIF
        ELSEIF Len(key) = 1 THEN
            ' Add character to edit value
            m.PropEditValue = m.PropEditValue & key
        ENDIF
    ELSE
        ' Handle navigation mode
        IF key = "up" THEN
            IF m.PropIndex > 0 THEN
                m.PropIndex = m.PropIndex - 1
            ENDIF
        ELSEIF key = "down" THEN
            m.PropIndex = m.PropIndex + 1
        ELSEIF key = "enter" OR key = "f2" THEN
            ' Start editing - load current value
            m.PropEditValue = GetCurrentPropertyValue(m)
            IF Len(m.PropEditValue) > 0 OR CanEditProperty(m) THEN
                m.PropEditing = TRUE
            ENDIF
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION GetCurrentPropertyValue(m AS VDBTermModel) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN ""
    ENDIF

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        IF m.PropIndex = 0 THEN
            RETURN ctrl.CtlName
        ELSEIF m.PropIndex = 1 THEN
            RETURN "" ' Type is read-only
        ELSEIF m.PropIndex = 2 THEN
            RETURN ctrl.Caption
        ELSEIF m.PropIndex = 3 THEN
            RETURN Str(ctrl.X)
        ELSEIF m.PropIndex = 4 THEN
            RETURN Str(ctrl.Y)
        ELSEIF m.PropIndex = 5 THEN
            RETURN Str(ctrl.Width)
        ELSEIF m.PropIndex = 6 THEN
            RETURN Str(ctrl.Height)
        ELSEIF m.PropIndex = 7 THEN
            RETURN IIFStr(ctrl.Enabled, "True", "False")
        ELSEIF m.PropIndex = 8 THEN
            RETURN IIFStr(ctrl.Visible, "True", "False")
        ELSEIF m.PropIndex = 9 THEN
            RETURN Str(ctrl.ZOrder)
        ENDIF
    ELSE
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF m.PropIndex = 0 THEN
            RETURN form.Name
        ELSEIF m.PropIndex = 1 THEN
            RETURN form.Caption
        ELSEIF m.PropIndex = 2 THEN
            RETURN Str(form.Width)
        ELSEIF m.PropIndex = 3 THEN
            RETURN Str(form.Height)
        ENDIF
    ENDIF
    RETURN ""
END FUNCTION

FUNCTION CanEditProperty(m AS VDBTermModel) AS BOOLEAN
    IF m.SelectedCtrlIdx >= 0 THEN
        ' Type property (index 1) is read-only
        RETURN m.PropIndex <> 1
    ENDIF
    RETURN TRUE
END FUNCTION

FUNCTION ApplyPropertyEdit(m AS VDBTermModel) AS VDBTermModel
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m
    ENDIF

    DIM val AS STRING = m.PropEditValue

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].CtlName = val
        ELSEIF m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Caption = val
        ELSEIF m.PropIndex = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = ParseIntStr(val)
        ELSEIF m.PropIndex = 4 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = ParseIntStr(val)
        ELSEIF m.PropIndex = 5 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Width = ParseIntStr(val)
        ELSEIF m.PropIndex = 6 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Height = ParseIntStr(val)
        ELSEIF m.PropIndex = 7 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Enabled = (val = "True" OR val = "true" OR val = "1")
        ELSEIF m.PropIndex = 8 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Visible = (val = "True" OR val = "true" OR val = "1")
        ELSEIF m.PropIndex = 9 THEN
            m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].ZOrder = ParseIntStr(val)
        ENDIF
        m.Project.Modified = TRUE
    ELSE
        IF m.PropIndex = 0 THEN
            m.Project.Forms[m.CurrentFormIdx].Name = val
        ELSEIF m.PropIndex = 1 THEN
            m.Project.Forms[m.CurrentFormIdx].Caption = val
        ELSEIF m.PropIndex = 2 THEN
            m.Project.Forms[m.CurrentFormIdx].Width = ParseIntStr(val)
        ELSEIF m.PropIndex = 3 THEN
            m.Project.Forms[m.CurrentFormIdx].Height = ParseIntStr(val)
        ENDIF
        m.Project.Modified = TRUE
    ENDIF

    RETURN m
END FUNCTION

FUNCTION HandleProjectInput(m AS VDBTermModel, key AS STRING) AS (tea.Model, tea.Cmd)
    IF key = "up" THEN
        IF m.TreeIndex > 0 THEN
            m.TreeIndex = m.TreeIndex - 1
        ENDIF
    ELSEIF key = "down" THEN
        m.TreeIndex = m.TreeIndex + 1
    ELSEIF key = "enter" THEN
        ' Select form/module
        IF m.TreeIndex < Len(m.Project.Forms) THEN
            m.CurrentFormIdx = m.TreeIndex
            m.SelectedCtrlIdx = -1
        ENDIF
    ENDIF
    RETURN m, NIL
END FUNCTION

' ============================================================================
' MOUSE INPUT HANDLER
' ============================================================================

FUNCTION HandleMouseInput(m AS VDBTermModel, mouseMsg AS tea.MouseMsg) AS (tea.Model, tea.Cmd)
    DIM x AS INTEGER = Int(mouseMsg.X)
    DIM y AS INTEGER = Int(mouseMsg.Y)
    DIM action AS tea.MouseAction = mouseMsg.Action
    DIM button AS tea.MouseButton = mouseMsg.Button

    ' Calculate layout dimensions (same as View())
    DIM toolboxWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM projectHeight AS INTEGER = 8
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - toolboxWidth - propertiesWidth
    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Handle mouse press events
    IF action = tea.MouseActionPress AND button = tea.MouseButtonLeft THEN
        ' Row 0 = Menu bar
        IF y = 0 THEN
            RETURN HandleMenuBarClick(m, x)
        ENDIF

        ' If dropdown menu is open, check for menu item click
        IF m.MenuOpen <> MENU_NONE THEN
            DIM dropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM dropWidth AS INTEGER = 20
            DIM dropRow AS INTEGER = y - 1

            IF x >= dropOffset AND x < dropOffset + dropWidth AND dropRow >= 0 THEN
                RETURN HandleDropdownClick(m, dropRow)
            ELSE
                ' Click outside dropdown closes it
                m.MenuOpen = MENU_NONE
                RETURN m, NIL
            ENDIF
        ENDIF

        ' If dialog is open, handle dialog clicks
        IF m.DialogMode <> DIALOG_NONE THEN
            ' For now, just allow Escape to close (no mouse handling in dialogs)
            RETURN m, NIL
        ENDIF

        ' Adjust y for content area (subtract 1 for menu bar)
        DIM contentY AS INTEGER = y - 1

        ' Check which panel was clicked
        IF x < toolboxWidth THEN
            ' Left column: Toolbox (top) or Project Tree (bottom)
            IF contentY < contentHeight - projectHeight THEN
                ' Toolbox panel
                RETURN HandleToolboxClick(m, contentY)
            ELSE
                ' Project tree
                DIM localY AS INTEGER = contentY - (contentHeight - projectHeight)
                RETURN HandleProjectClick(m, localY)
            ENDIF
        ELSEIF x < toolboxWidth + contentWidth THEN
            ' Main content area (full height)
            DIM localX AS INTEGER = x - toolboxWidth
            IF m.ViewMode = VIEW_FORM THEN
                RETURN HandleFormClick(m, localX, contentY)
            ELSE
                RETURN HandleCodeClick(m, localX, contentY)
            ENDIF
        ELSE
            ' Properties panel
            RETURN HandlePropertiesClick(m, contentY)
        ENDIF

    ' Handle mouse drag for moving controls in form view
    ELSEIF action = tea.MouseActionMotion AND m.IsDragging THEN
        IF m.ViewMode = VIEW_FORM AND m.SelectedCtrlIdx >= 0 THEN
            DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)
            IF m.SelectedCtrlIdx < ctrlCount THEN
                DIM dragContentY AS INTEGER = y - 1
                DIM dragLocalX AS INTEGER = x - toolboxWidth

                DIM newX AS INTEGER = dragLocalX - m.DragStartX
                DIM newY AS INTEGER = dragContentY - m.DragStartY

                IF newX < 0 THEN
                    newX = 0
                ENDIF
                IF newY < 0 THEN
                    newY = 0
                ENDIF

                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].X = newX
                m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx].Y = newY
                m.Project.Modified = TRUE
            ENDIF
        ENDIF

    ' Handle mouse release
    ELSEIF action = tea.MouseActionRelease THEN
        IF m.IsDragging THEN
            m.IsDragging = FALSE
            m.Message = "Control moved"
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleMenuBarClick(m AS VDBTermModel, x AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Menu positions: File(0-5), Edit(6-11), View(12-17), Run(18-22), Debug(23-29), Options(30-38), Help(39-45)
    IF x >= 0 AND x < 6 THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
    ELSEIF x >= 6 AND x < 12 THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
    ELSEIF x >= 12 AND x < 18 THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
    ELSEIF x >= 18 AND x < 23 THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
    ELSEIF x >= 23 AND x < 30 THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
    ELSEIF x >= 30 AND x < 39 THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
    ELSEIF x >= 39 AND x < 46 THEN
        m.MenuOpen = MENU_HELP
        m.MenuIndex = 0
    ELSE
        m.MenuOpen = MENU_NONE
    ENDIF
    RETURN m, NIL
END FUNCTION

FUNCTION HandleDropdownClick(m AS VDBTermModel, row AS INTEGER) AS (tea.Model, tea.Cmd)
    ' Row 0 is the top border, so actual menu items start at row 1
    DIM itemIdx AS INTEGER = row - 1

    IF itemIdx < 0 THEN
        RETURN m, NIL
    ENDIF

    ' Determine valid menu item indices based on current menu
    DIM maxItems AS INTEGER

    IF m.MenuOpen = MENU_FILE THEN
        maxItems = 8
        ' Items: 0=New Project, 1=Open, 2=Save, 3=separator, 4=New Form, 5=New Module, 6=separator, 7=Exit
        IF itemIdx = 3 OR itemIdx = 6 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_EDIT THEN
        maxItems = 8
        ' Items: 0=Cut, 1=Copy, 2=Paste, 3=separator, 4=Select All, 5=Delete, 6=separator, 7=Menu Editor
        IF itemIdx = 3 OR itemIdx = 6 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_VIEW THEN
        maxItems = 5
        ' Items: 0=Form View, 1=Code View, 2=separator, 3=Show Grid, 4=Line Numbers
        IF itemIdx = 2 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_RUN THEN
        maxItems = 4
        ' Items: 0=Run, 1=Build, 2=separator, 3=Set Startup
        IF itemIdx = 2 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_DEBUG THEN
        maxItems = 5
        ' Items: 0=Step, 1=Breakpoint, 2=Watch, 3=separator, 4=Clear All
        IF itemIdx = 3 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
        maxItems = 4
        ' Items: 0=Environment, 1=Editor, 2=Colors, 3=Compiler
    ELSEIF m.MenuOpen = MENU_HELP THEN
        maxItems = 3
        ' Items: 0=Contents, 1=separator, 2=About
        IF itemIdx = 1 THEN
            RETURN m, NIL ' Separator clicked
        ENDIF
    ELSE
        RETURN m, NIL
    ENDIF

    IF itemIdx >= maxItems THEN
        RETURN m, NIL
    ENDIF

    ' Set menu index and simulate Enter key to execute menu action
    m.MenuIndex = itemIdx
    RETURN HandleMenuInput(m, "enter")
END FUNCTION

FUNCTION HandleToolboxClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_TOOLBOX

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 AND itemIdx <= 10 THEN
        m.ToolboxIndex = itemIdx
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleFormClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_FORM

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM ctrlCount AS INTEGER = Len(m.Project.Forms[m.CurrentFormIdx].Controls)

    ' Check if click is on a control (iterate in reverse to get topmost first)
    DIM i AS INTEGER
    FOR i = ctrlCount - 1 TO 0 STEP -1
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[i]
        IF x >= ctrl.X AND x < ctrl.X + ctrl.Width AND y >= ctrl.Y AND y < ctrl.Y + ctrl.Height THEN
            m.SelectedCtrlIdx = i
            ' Start drag operation
            m.IsDragging = TRUE
            m.DragStartX = x - ctrl.X
            m.DragStartY = y - ctrl.Y
            m.Message = "Selected: " & ctrl.CtlName
            RETURN m, NIL
        ENDIF
    NEXT

    ' Clicked on empty area - deselect
    m.SelectedCtrlIdx = -1
    m.Message = ""

    RETURN m, NIL
END FUNCTION

FUNCTION HandleCodeClick(m AS VDBTermModel, x AS INTEGER, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_CODE

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)

    ' Adjust for line numbers if shown
    DIM textX AS INTEGER = x
    IF m.ShowLineNumbers THEN
        textX = x - 5  ' Line number column width
        IF textX < 0 THEN
            textX = 0
        ENDIF
    ENDIF

    ' Set cursor position
    DIM targetLine AS INTEGER = y + m.CodeScrollY
    IF targetLine >= totalLines THEN
        targetLine = totalLines - 1
    ENDIF
    IF targetLine < 0 THEN
        targetLine = 0
    ENDIF

    DIM lineText AS STRING = GetLine(code, targetLine + 1)
    DIM targetCol AS INTEGER = textX + m.CodeScrollX
    IF targetCol > Len(lineText) THEN
        targetCol = Len(lineText)
    ENDIF
    IF targetCol < 0 THEN
        targetCol = 0
    ENDIF

    m.CodeCursorY = targetLine
    m.CodeCursorX = targetCol

    RETURN m, NIL
END FUNCTION

FUNCTION HandlePropertiesClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROPERTIES

    ' Row 0 is the title, properties start at row 1
    IF y >= 1 THEN
        DIM newPropIndex AS INTEGER = y - 1

        ' If clicking on a different property while editing, cancel current edit
        IF m.PropEditing AND newPropIndex <> m.PropIndex THEN
            m.PropEditing = FALSE
            m.PropEditValue = ""
        ENDIF

        m.PropIndex = newPropIndex
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION HandleProjectClick(m AS VDBTermModel, y AS INTEGER) AS (tea.Model, tea.Cmd)
    m.FocusArea = FOCUS_PROJECT

    ' Row 0 is the title, items start at row 1
    DIM itemIdx AS INTEGER = y - 1
    IF itemIdx >= 0 THEN
        m.TreeIndex = itemIdx
        ' If clicking on a form, select it
        IF itemIdx < Len(m.Project.Forms) THEN
            m.CurrentFormIdx = itemIdx
            m.SelectedCtrlIdx = -1
        ENDIF
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' CODE EDITING HELPERS
' ============================================================================

FUNCTION SetCodeLine(content AS STRING, lineNum AS INTEGER, newLine AS STRING) AS STRING
    DIM lines AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum THEN
                lines = lines & newLine
            ELSE
                lines = lines & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) THEN
                lines = lines & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN lines
END FUNCTION

FUNCTION InsertCodeCharAt(content AS STRING, lineNum AS INTEGER, col AS INTEGER, ch AS STRING) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)
    DIM newLine AS STRING

    IF col <= 0 THEN
        newLine = ch & line
    ELSEIF col >= Len(line) THEN
        newLine = line & ch
    ELSE
        newLine = Left(line, col) & ch & Mid(line, col + 1, Len(line) - col)
    ENDIF

    RETURN SetCodeLine(content, lineNum, newLine)
END FUNCTION

FUNCTION DeleteCodeCharAt(content AS STRING, lineNum AS INTEGER, col AS INTEGER) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)

    IF col < 0 OR col >= Len(line) THEN
        RETURN content
    ENDIF

    DIM newLine AS STRING
    IF col = 0 THEN
        newLine = Mid(line, 2, Len(line) - 1)
    ELSE
        newLine = Left(line, col) & Mid(line, col + 2, Len(line) - col - 1)
    ENDIF

    RETURN SetCodeLine(content, lineNum, newLine)
END FUNCTION

FUNCTION InsertCodeNewLine(content AS STRING, lineNum AS INTEGER, col AS INTEGER) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)
    DIM beforeCursor AS STRING = Left(line, col)
    DIM afterCursor AS STRING = Mid(line, col + 1, Len(line) - col)

    DIM result AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum THEN
                result = result & beforeCursor & Chr(10) & afterCursor
            ELSE
                result = result & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) AND currentLine <> lineNum THEN
                result = result & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN result
END FUNCTION

FUNCTION JoinCodeWithPrevLine(content AS STRING, lineNum AS INTEGER) AS STRING
    IF lineNum <= 1 THEN
        RETURN content
    ENDIF

    DIM prevLine AS STRING = GetLine(content, lineNum - 1)
    DIM currLine AS STRING = GetLine(content, lineNum)
    DIM joinedLine AS STRING = prevLine & currLine

    DIM result AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum - 1 THEN
                result = result & joinedLine
            ELSEIF currentLine <> lineNum THEN
                result = result & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) AND currentLine <> lineNum - 1 AND currentLine <> lineNum THEN
                result = result & Chr(10)
            ELSEIF ch = Chr(10) AND currentLine < lineNum - 1 THEN
                result = result & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN result
END FUNCTION

' ============================================================================
' RUN AND BUILD
' ============================================================================

FUNCTION DoRun(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded THEN
        m.Message = "No project loaded"
        RETURN m, NIL
    ENDIF

    ' Generate code and save to temp file
    DIM code AS STRING = GenerateCode(m.Project)
    DIM tempPath AS STRING = "/tmp/" & m.Project.Name & "_run.dbas"
    WriteFile(tempPath, code)
    m.Message = "Generated: " & tempPath & " - Use 'dbasic run' to execute"
    RETURN m, NIL
END FUNCTION

FUNCTION DoBuild(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded THEN
        m.Message = "No project loaded"
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = GenerateCode(m.Project)
    DIM outPath AS STRING = m.Project.Name & ".dbas"
    WriteFile(outPath, code)
    m.Message = "Built: " & outPath
    RETURN m, NIL
END FUNCTION

' ============================================================================
' VIEW RENDERING
' ============================================================================

FUNCTION (m AS VDBTermModel) View() AS STRING
    DIM view AS STRING = ""

    ' Menu bar
    view = RenderMenuBar(m) & Chr(10)

    ' Calculate layout dimensions
    DIM toolboxWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM projectHeight AS INTEGER = 8
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - toolboxWidth - propertiesWidth

    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Get dropdown/dialog overlays
    DIM dropdownLines AS []STRING
    IF m.MenuOpen <> MENU_NONE THEN
        dropdownLines = GetDropdownLines(m)
    ENDIF

    DIM dialogLines AS []STRING
    DIM dialogWidth AS INTEGER = 0
    DIM dialogHeight AS INTEGER = 0
    DIM dialogStartRow AS INTEGER = 0
    DIM dialogStartCol AS INTEGER = 0
    IF m.DialogMode <> DIALOG_NONE THEN
        dialogLines = GetDialogLines(m)
        dialogWidth, dialogHeight = GetDialogSize(m)
        dialogHeight = Len(dialogLines)
        dialogStartRow = (contentHeight - dialogHeight) / 2
        dialogStartCol = (m.Width - dialogWidth) / 2
        IF dialogStartRow < 0 THEN
            dialogStartRow = 0
        ENDIF
        IF dialogStartCol < 0 THEN
            dialogStartCol = 0
        ENDIF
    ENDIF

    ' Render main content area row by row
    DIM row AS INTEGER
    FOR row = 0 TO contentHeight - 1
        DIM rowContent AS STRING = ""

        ' Check for dialog overlay
        DIM dialogRowIdx AS INTEGER = row - dialogStartRow
        IF m.DialogMode <> DIALOG_NONE AND dialogRowIdx >= 0 AND dialogRowIdx < Len(dialogLines) THEN
            ' Render with dialog overlay
            DIM col AS INTEGER
            FOR col = 0 TO dialogStartCol - 1
                rowContent = rowContent & RenderCellAt(m, row, col, toolboxWidth, contentWidth, propertiesWidth, contentHeight, projectHeight)
            NEXT
            rowContent = rowContent & dialogLines[dialogRowIdx]
            FOR col = dialogStartCol + dialogWidth TO m.Width - 1
                rowContent = rowContent & RenderCellAt(m, row, col, toolboxWidth, contentWidth, propertiesWidth, contentHeight, projectHeight)
            NEXT
        ' Check for dropdown overlay
        ELSEIF m.MenuOpen <> MENU_NONE AND row < Len(dropdownLines) THEN
            DIM dropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM dropWidth AS INTEGER = 20
            DIM col2 AS INTEGER
            FOR col2 = 0 TO dropOffset - 1
                rowContent = rowContent & RenderCellAt(m, row, col2, toolboxWidth, contentWidth, propertiesWidth, contentHeight, projectHeight)
            NEXT
            rowContent = rowContent & dropdownLines[row]
            FOR col2 = dropOffset + dropWidth TO m.Width - 1
                rowContent = rowContent & RenderCellAt(m, row, col2, toolboxWidth, contentWidth, propertiesWidth, contentHeight, projectHeight)
            NEXT
        ELSE
            ' Normal rendering
            rowContent = RenderRow(m, row, toolboxWidth, contentWidth, propertiesWidth, contentHeight, projectHeight)
        ENDIF

        view = view & rowContent & Chr(10)
    NEXT

    ' Status bar
    view = view & RenderStatusBar(m)

    RETURN view
END FUNCTION

FUNCTION RenderCellAt(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, toolboxWidth AS INTEGER, contentWidth AS INTEGER, propertiesWidth AS INTEGER, contentHeight AS INTEGER, projectHeight AS INTEGER) AS STRING
    ' Determine which panel this cell belongs to
    IF col < toolboxWidth THEN
        ' Left column: Toolbox (top) or Project Tree (bottom)
        IF row < contentHeight - projectHeight THEN
            RETURN RenderToolboxCell(m, row, col, toolboxWidth)
        ELSE
            DIM localRow AS INTEGER = row - (contentHeight - projectHeight)
            RETURN RenderProjectCell(m, localRow, col, toolboxWidth)
        ENDIF
    ELSEIF col < toolboxWidth + contentWidth THEN
        ' Middle: Form/Code (full height)
        DIM localCol AS INTEGER = col - toolboxWidth
        IF m.ViewMode = VIEW_FORM THEN
            RETURN RenderFormCell(m, row, localCol, contentWidth)
        ELSE
            RETURN RenderCodeCell(m, row, localCol, contentWidth)
        ENDIF
    ELSE
        DIM propCol AS INTEGER = col - toolboxWidth - contentWidth
        RETURN RenderPropertiesCell(m, row, propCol, propertiesWidth)
    ENDIF
END FUNCTION

FUNCTION RenderRow(m AS VDBTermModel, row AS INTEGER, toolboxWidth AS INTEGER, contentWidth AS INTEGER, propertiesWidth AS INTEGER, contentHeight AS INTEGER, projectHeight AS INTEGER) AS STRING
    DIM result AS STRING = ""

    ' Left column: Toolbox (top) or Project Tree (bottom)
    IF row < contentHeight - projectHeight THEN
        ' Toolbox area
        result = result & RenderToolboxRow(m, row, toolboxWidth)
    ELSE
        ' Project tree area
        DIM localRow AS INTEGER = row - (contentHeight - projectHeight)
        result = result & RenderProjectRow(m, localRow, toolboxWidth)
    ENDIF

    ' Main content (full height)
    IF m.ViewMode = VIEW_FORM THEN
        result = result & RenderFormRow(m, row, contentWidth)
    ELSE
        result = result & RenderCodeRow(m, row, contentWidth)
    ENDIF

    ' Properties
    result = result & RenderPropertiesRow(m, row, propertiesWidth)

    RETURN result
END FUNCTION

' Toolbox rendering
FUNCTION RenderToolboxRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - always highlighted blue
        content = styleToolboxSelected.Render(PadCenter("Toolbox", width))
        RETURN content
    ENDIF

    DIM toolIdx AS INTEGER = row - 1
    IF toolIdx >= 0 AND toolIdx <= 10 THEN
        DIM ctlType AS INTEGER = toolIdx + 1
        DIM icon AS STRING = GetToolboxIcon(ctlType)
        DIM name AS STRING = GetControlTypeName(ctlType)
        DIM item AS STRING = icon & " " & name
        item = PadRight(item, width)

        IF toolIdx = m.ToolboxIndex AND m.FocusArea = FOCUS_TOOLBOX THEN
            content = styleToolboxSelected.Render(item)
        ELSE
            content = styleToolbox.Render(item)
        ENDIF
    ELSE
        content = styleToolbox.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderToolboxCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "
    DIM selected AS BOOLEAN = FALSE

    IF row = 0 THEN
        ' Title row - always highlighted blue
        DIM title AS STRING = PadCenter("Toolbox", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN styleToolboxSelected.Render(ch)
    ELSE
        DIM toolIdx AS INTEGER = row - 1
        IF toolIdx >= 0 AND toolIdx <= 10 THEN
            DIM ctlType AS INTEGER = toolIdx + 1
            DIM icon AS STRING = GetToolboxIcon(ctlType)
            DIM name AS STRING = GetControlTypeName(ctlType)
            DIM item AS STRING = PadRight(icon & " " & name, width)
            IF col < Len(item) THEN
                ch = Mid(item, col + 1, 1)
            ENDIF
            selected = (toolIdx = m.ToolboxIndex AND m.FocusArea = FOCUS_TOOLBOX)
        ENDIF
    ENDIF

    IF selected THEN
        RETURN styleToolboxSelected.Render(ch)
    ELSE
        RETURN styleToolbox.Render(ch)
    ENDIF
END FUNCTION

' Form canvas rendering
FUNCTION RenderFormRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        ' No form loaded
        content = styleFormCanvas.Render(PadRight(" No form loaded", width))
        RETURN content
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]

    ' Row 0: Form title bar
    IF row = 0 THEN
        DIM titleBar AS STRING = "┌"
        DIM titleText AS STRING = " " & form.Caption & " "
        DIM innerWidth AS INTEGER = width - 2
        DIM titleStart AS INTEGER = 1
        DIM col AS INTEGER
        FOR col = 0 TO innerWidth - 1
            IF col >= titleStart AND col < titleStart + Len(titleText) THEN
                titleBar = titleBar & Mid(titleText, col - titleStart + 1, 1)
            ELSE
                titleBar = titleBar & "─"
            ENDIF
        NEXT
        titleBar = titleBar & "┐"
        IF m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM THEN
            RETURN styleControlSelected.Render(titleBar)
        ELSE
            RETURN styleMenuBar.Render(titleBar)
        ENDIF
    ENDIF

    ' Row 1+: Form content with left and right borders
    DIM formRow AS INTEGER = row - 1
    DIM formCol AS INTEGER
    DIM formCh AS STRING

    ' Left border
    IF m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM THEN
        content = content & styleControlSelected.Render("│")
    ELSE
        content = content & styleMenuBar.Render("│")
    ENDIF

    ' Form content area (width - 2 for borders)
    FOR formCol = 0 TO width - 3
        formCh = " "

        ' Show grid dots
        IF m.ShowGrid AND formRow MOD 2 = 0 AND formCol MOD 4 = 0 THEN
            formCh = "."
        ENDIF

        ' Check if any control occupies this position
        DIM i AS INTEGER
        DIM foundCtrl AS BOOLEAN = FALSE
        FOR i = 0 TO Len(form.Controls) - 1
            DIM ctrl AS VDBControl = form.Controls[i]
            IF formRow >= ctrl.Y AND formRow < ctrl.Y + ctrl.Height AND formCol >= ctrl.X AND formCol < ctrl.X + ctrl.Width THEN
                DIM localRow AS INTEGER = formRow - ctrl.Y
                DIM localCol AS INTEGER = formCol - ctrl.X
                DIM isSelected AS BOOLEAN = (i = m.SelectedCtrlIdx)

                ' Check for selection handles at corners
                IF isSelected THEN
                    IF (localRow = 0 OR localRow = ctrl.Height - 1) AND (localCol = 0 OR localCol = ctrl.Width - 1) THEN
                        formCh = "■"
                        content = content & styleControlSelected.Render(formCh)
                        foundCtrl = TRUE
                        EXIT FOR
                    ENDIF
                ENDIF

                formCh = RenderControlChar(ctrl, localRow, localCol, isSelected)
                IF isSelected THEN
                    content = content & styleControlSelected.Render(formCh)
                ELSE
                    content = content & styleControl.Render(formCh)
                ENDIF
                foundCtrl = TRUE
                EXIT FOR
            ENDIF
        NEXT

        IF NOT foundCtrl THEN
            IF m.ShowGrid AND formCh = "." THEN
                content = content & styleFormGrid.Render(formCh)
            ELSE
                content = content & styleFormCanvas.Render(formCh)
            ENDIF
        ENDIF
    NEXT

    ' Right border
    IF m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM THEN
        content = content & styleControlSelected.Render("│")
    ELSE
        content = content & styleMenuBar.Render("│")
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderFormCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleFormCanvas.Render(" ")
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
    DIM formSelected AS BOOLEAN = (m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM)

    ' Row 0: Title bar
    IF row = 0 THEN
        DIM titleText AS STRING = " " & form.Caption & " "
        DIM titleCh AS STRING = "─"
        IF col = 0 THEN
            titleCh = "┌"
        ELSEIF col = width - 1 THEN
            titleCh = "┐"
        ELSEIF col >= 1 AND col <= Len(titleText) THEN
            titleCh = Mid(titleText, col, 1)
        ENDIF
        IF formSelected THEN
            RETURN styleControlSelected.Render(titleCh)
        ELSE
            RETURN styleMenuBar.Render(titleCh)
        ENDIF
    ENDIF

    ' Left and right borders
    IF col = 0 OR col = width - 1 THEN
        IF formSelected THEN
            RETURN styleControlSelected.Render("│")
        ELSE
            RETURN styleMenuBar.Render("│")
        ENDIF
    ENDIF

    ' Form content area
    DIM formRow AS INTEGER = row - 1
    DIM formCol AS INTEGER = col - 1
    DIM ch AS STRING = " "

    IF m.ShowGrid AND formRow MOD 2 = 0 AND formCol MOD 4 = 0 THEN
        ch = "."
    ENDIF

    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF formRow >= ctrl.Y AND formRow < ctrl.Y + ctrl.Height AND formCol >= ctrl.X AND formCol < ctrl.X + ctrl.Width THEN
            DIM localRow AS INTEGER = formRow - ctrl.Y
            DIM localCol AS INTEGER = formCol - ctrl.X
            DIM isSelected AS BOOLEAN = (i = m.SelectedCtrlIdx)

            ' Check for selection handles at corners
            IF isSelected THEN
                IF (localRow = 0 OR localRow = ctrl.Height - 1) AND (localCol = 0 OR localCol = ctrl.Width - 1) THEN
                    RETURN styleControlSelected.Render("■")
                ENDIF
            ENDIF

            ch = RenderControlChar(ctrl, localRow, localCol, isSelected)
            IF isSelected THEN
                RETURN styleControlSelected.Render(ch)
            ELSE
                RETURN styleControl.Render(ch)
            ENDIF
        ENDIF
    NEXT

    IF m.ShowGrid AND ch = "." THEN
        RETURN styleFormGrid.Render(ch)
    ENDIF
    RETURN styleFormCanvas.Render(ch)
END FUNCTION

' Render a single character of a control
FUNCTION RenderControlChar(ctrl AS VDBControl, localRow AS INTEGER, localCol AS INTEGER, selected AS BOOLEAN) AS STRING
    IF ctrl.CtlType = CTRL_BUTTON THEN
        ' Button with border
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "["
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "]"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "["
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "]"
            ELSE
                RETURN " "
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "|"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LABEL THEN
        IF localCol < Len(ctrl.Caption) THEN
            RETURN Mid(ctrl.Caption, localCol + 1, 1)
        ENDIF
        RETURN " "
    ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = ctrl.Width - 1 THEN
            RETURN "]"
        ELSEIF localCol - 1 < Len(ctrl.Value) THEN
            RETURN Mid(ctrl.Value, localCol, 1)
        ELSE
            RETURN "_"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = 1 THEN
            IF ctrl.Value = "1" THEN
                RETURN "X"
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localCol = 2 THEN
            RETURN "]"
        ELSEIF localCol = 3 THEN
            RETURN " "
        ELSEIF localCol - 4 < Len(ctrl.Caption) THEN
            RETURN Mid(ctrl.Caption, localCol - 3, 1)
        ELSE
            RETURN " "
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_OPTION THEN
        IF localCol = 0 THEN
            RETURN "("
        ELSEIF localCol = 1 THEN
            IF ctrl.Value = "1" THEN
                RETURN "o"
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localCol = 2 THEN
            RETURN ")"
        ELSEIF localCol = 3 THEN
            RETURN " "
        ELSEIF localCol - 4 < Len(ctrl.Caption) THEN
            RETURN Mid(ctrl.Caption, localCol - 3, 1)
        ELSE
            RETURN " "
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FRAME THEN
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = 1 THEN
            RETURN "T"
        ELSEIF localCol = 2 THEN
            RETURN "]"
        ENDIF
        RETURN " "
    ENDIF

    RETURN " "
END FUNCTION

' Code editor rendering
FUNCTION RenderCodeRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        content = styleCodeEditor.Render(PadRight(" No code loaded", width))
        RETURN content
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)
    DIM lineIdx AS INTEGER = m.CodeScrollY + row

    ' Line number
    IF m.ShowLineNumbers THEN
        IF lineIdx < totalLines THEN
            content = content & styleCodeLineNum.Render(fmt.Sprintf("%4d ", lineIdx + 1))
        ELSE
            content = content & styleCodeLineNum.Render("     ")
        ENDIF
        width = width - 5
    ENDIF

    IF lineIdx >= totalLines THEN
        content = content & styleCodeEditor.Render(RepeatStr(" ", width))
        RETURN content
    ENDIF

    DIM lineText AS STRING = GetLine(code, lineIdx + 1)

    ' Render line with syntax highlighting
    DIM col AS INTEGER
    FOR col = 0 TO width - 1
        DIM actualCol AS INTEGER = m.CodeScrollX + col
        DIM ch AS STRING = " "

        IF actualCol < Len(lineText) THEN
            ch = Mid(lineText, actualCol + 1, 1)
        ENDIF

        ' Cursor
        IF lineIdx = m.CodeCursorY AND actualCol = m.CodeCursorX AND m.FocusArea = FOCUS_CODE THEN
            content = content & styleCodeCursor.Render(ch)
        ELSE
            content = content & styleCodeEditor.Render(ch)
        ENDIF
    NEXT

    RETURN content
END FUNCTION

FUNCTION RenderCodeCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleCodeEditor.Render(" ")
    ENDIF

    DIM code AS STRING = m.Project.Forms[m.CurrentFormIdx].Code
    DIM totalLines AS INTEGER = CountLines(code)
    DIM lineIdx AS INTEGER = m.CodeScrollY + row

    IF lineIdx >= totalLines THEN
        RETURN styleCodeEditor.Render(" ")
    ENDIF

    DIM lineText AS STRING = GetLine(code, lineIdx + 1)
    DIM actualCol AS INTEGER = m.CodeScrollX + col
    DIM ch AS STRING = " "

    IF actualCol < Len(lineText) THEN
        ch = Mid(lineText, actualCol + 1, 1)
    ENDIF

    IF lineIdx = m.CodeCursorY AND actualCol = m.CodeCursorX AND m.FocusArea = FOCUS_CODE THEN
        RETURN styleCodeCursor.Render(ch)
    ENDIF
    RETURN styleCodeEditor.Render(ch)
END FUNCTION

' Project tree rendering
FUNCTION RenderProjectRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - always highlighted blue
        content = styleTreeSelected.Render(PadRight(" Project", width))
        RETURN content
    ENDIF

    DIM itemIdx AS INTEGER = row - 1
    DIM totalItems AS INTEGER = 0

    IF m.ProjectLoaded THEN
        totalItems = Len(m.Project.Forms) + Len(m.Project.Modules) + 2
    ENDIF

    IF itemIdx < totalItems AND m.ProjectLoaded THEN
        DIM itemText AS STRING = ""

        IF itemIdx = 0 THEN
            itemText = "+ " & m.Project.Name
        ELSEIF itemIdx <= Len(m.Project.Forms) THEN
            DIM formIdx AS INTEGER = itemIdx - 1
            IF formIdx < Len(m.Project.Forms) THEN
                IF formIdx = m.CurrentFormIdx THEN
                    itemText = "  > " & m.Project.Forms[formIdx].Name & ".frm"
                ELSE
                    itemText = "    " & m.Project.Forms[formIdx].Name & ".frm"
                ENDIF
            ENDIF
        ELSE
            DIM modIdx AS INTEGER = itemIdx - Len(m.Project.Forms) - 1
            IF modIdx < Len(m.Project.Modules) THEN
                itemText = "    " & m.Project.Modules[modIdx].Name & ".bas"
            ENDIF
        ENDIF

        itemText = PadRight(itemText, width)
        IF itemIdx = m.TreeIndex AND m.FocusArea = FOCUS_PROJECT THEN
            content = styleTreeSelected.Render(itemText)
        ELSE
            content = styleTreeItem.Render(itemText)
        ENDIF
    ELSE
        content = styleProjectTree.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderProjectCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "
    DIM selected AS BOOLEAN = FALSE
    DIM isTreeItem AS BOOLEAN = FALSE

    IF row = 0 THEN
        ' Title row - always highlighted blue
        DIM title AS STRING = PadRight(" Project", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN styleTreeSelected.Render(ch)
    ELSE
        DIM itemIdx AS INTEGER = row - 1
        DIM totalItems AS INTEGER = 0

        IF m.ProjectLoaded THEN
            totalItems = Len(m.Project.Forms) + Len(m.Project.Modules) + 2
        ENDIF

        IF itemIdx < totalItems AND m.ProjectLoaded THEN
            DIM itemText AS STRING = ""

            IF itemIdx = 0 THEN
                itemText = "+ " & m.Project.Name
            ELSEIF itemIdx <= Len(m.Project.Forms) THEN
                DIM formIdx AS INTEGER = itemIdx - 1
                IF formIdx < Len(m.Project.Forms) THEN
                    IF formIdx = m.CurrentFormIdx THEN
                        itemText = "  > " & m.Project.Forms[formIdx].Name & ".frm"
                    ELSE
                        itemText = "    " & m.Project.Forms[formIdx].Name & ".frm"
                    ENDIF
                ENDIF
            ELSE
                DIM modIdx AS INTEGER = itemIdx - Len(m.Project.Forms) - 1
                IF modIdx < Len(m.Project.Modules) THEN
                    itemText = "    " & m.Project.Modules[modIdx].Name & ".bas"
                ENDIF
            ENDIF

            itemText = PadRight(itemText, width)
            IF col < Len(itemText) THEN
                ch = Mid(itemText, col + 1, 1)
            ENDIF
            selected = (itemIdx = m.TreeIndex AND m.FocusArea = FOCUS_PROJECT)
            isTreeItem = TRUE
        ENDIF
    ENDIF

    IF selected THEN
        RETURN styleTreeSelected.Render(ch)
    ELSEIF isTreeItem THEN
        RETURN styleTreeItem.Render(ch)
    ELSE
        RETURN styleProjectTree.Render(ch)
    ENDIF
END FUNCTION

' Properties panel rendering
FUNCTION RenderPropertiesRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - always highlighted blue
        content = stylePropSelected.Render(PadCenter("Properties", width))
        RETURN content
    ENDIF

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        content = styleProperties.Render(RepeatStr(" ", width))
        RETURN content
    ENDIF

    ' Show properties of selected control or form
    DIM propIdx AS INTEGER = row - 1
    DIM propName AS STRING = ""
    DIM propValue AS STRING = ""

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = ctrl.CtlName
        ELSEIF propIdx = 1 THEN
            propName = "Type"
            propValue = GetControlTypeName(ctrl.CtlType)
        ELSEIF propIdx = 2 THEN
            propName = "Caption"
            propValue = ctrl.Caption
        ELSEIF propIdx = 3 THEN
            propName = "X"
            propValue = Str(ctrl.X)
        ELSEIF propIdx = 4 THEN
            propName = "Y"
            propValue = Str(ctrl.Y)
        ELSEIF propIdx = 5 THEN
            propName = "Width"
            propValue = Str(ctrl.Width)
        ELSEIF propIdx = 6 THEN
            propName = "Height"
            propValue = Str(ctrl.Height)
        ELSEIF propIdx = 7 THEN
            propName = "Enabled"
            IF ctrl.Enabled THEN
                propValue = "True"
            ELSE
                propValue = "False"
            ENDIF
        ELSEIF propIdx = 8 THEN
            propName = "Visible"
            IF ctrl.Visible THEN
                propValue = "True"
            ELSE
                propValue = "False"
            ENDIF
        ELSEIF propIdx = 9 THEN
            propName = "ZOrder"
            propValue = Str(ctrl.ZOrder)
        ENDIF
    ELSE
        ' Form properties
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = form.Name
        ELSEIF propIdx = 1 THEN
            propName = "Caption"
            propValue = form.Caption
        ELSEIF propIdx = 2 THEN
            propName = "Width"
            propValue = Str(form.Width)
        ELSEIF propIdx = 3 THEN
            propName = "Height"
            propValue = Str(form.Height)
        ENDIF
    ENDIF

    IF Len(propName) > 0 THEN
        DIM half AS INTEGER = width / 2
        DIM displayValue AS STRING = propValue

        ' Show edit value when editing this property
        IF propIdx = m.PropIndex AND m.PropEditing AND m.FocusArea = FOCUS_PROPERTIES THEN
            displayValue = m.PropEditValue & "_"
        ENDIF

        DIM line AS STRING = PadRight(propName, half) & PadRight(displayValue, width - half)
        IF propIdx = m.PropIndex AND m.FocusArea = FOCUS_PROPERTIES THEN
            IF m.PropEditing THEN
                ' Highlight edit mode differently
                content = stylePropName.Render(PadRight(propName, half)) & styleCodeCursor.Render(PadRight(displayValue, width - half))
            ELSE
                content = stylePropSelected.Render(line)
            ENDIF
        ELSE
            content = stylePropName.Render(PadRight(propName, half)) & stylePropValue.Render(PadRight(propValue, width - half))
        ENDIF
    ELSE
        content = styleProperties.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderPropertiesCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "

    IF row = 0 THEN
        ' Title row - always highlighted blue
        DIM title AS STRING = PadCenter("Properties", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN stylePropSelected.Render(ch)
    ENDIF

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleProperties.Render(ch)
    ENDIF

    ' Show properties of selected control or form
    DIM propIdx AS INTEGER = row - 1
    DIM propName AS STRING = ""
    DIM propValue AS STRING = ""

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = ctrl.CtlName
        ELSEIF propIdx = 1 THEN
            propName = "Type"
            propValue = GetControlTypeName(ctrl.CtlType)
        ELSEIF propIdx = 2 THEN
            propName = "Caption"
            propValue = ctrl.Caption
        ELSEIF propIdx = 3 THEN
            propName = "X"
            propValue = Str(ctrl.X)
        ELSEIF propIdx = 4 THEN
            propName = "Y"
            propValue = Str(ctrl.Y)
        ELSEIF propIdx = 5 THEN
            propName = "Width"
            propValue = Str(ctrl.Width)
        ELSEIF propIdx = 6 THEN
            propName = "Height"
            propValue = Str(ctrl.Height)
        ELSEIF propIdx = 7 THEN
            propName = "Enabled"
            IF ctrl.Enabled THEN
                propValue = "True"
            ELSE
                propValue = "False"
            ENDIF
        ELSEIF propIdx = 8 THEN
            propName = "Visible"
            IF ctrl.Visible THEN
                propValue = "True"
            ELSE
                propValue = "False"
            ENDIF
        ELSEIF propIdx = 9 THEN
            propName = "ZOrder"
            propValue = Str(ctrl.ZOrder)
        ENDIF
    ELSE
        ' Form properties
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = form.Name
        ELSEIF propIdx = 1 THEN
            propName = "Caption"
            propValue = form.Caption
        ELSEIF propIdx = 2 THEN
            propName = "Width"
            propValue = Str(form.Width)
        ELSEIF propIdx = 3 THEN
            propName = "Height"
            propValue = Str(form.Height)
        ENDIF
    ENDIF

    IF Len(propName) > 0 THEN
        DIM half AS INTEGER = width / 2
        DIM line AS STRING = PadRight(propName, half) & PadRight(propValue, width - half)
        IF col < Len(line) THEN
            ch = Mid(line, col + 1, 1)
        ENDIF
        IF propIdx = m.PropIndex AND m.FocusArea = FOCUS_PROPERTIES THEN
            RETURN stylePropSelected.Render(ch)
        ELSEIF col < half THEN
            RETURN stylePropName.Render(ch)
        ELSE
            RETURN stylePropValue.Render(ch)
        ENDIF
    ENDIF

    RETURN styleProperties.Render(ch)
END FUNCTION

' Menu bar rendering
FUNCTION RenderMenuBar(m AS VDBTermModel) AS STRING
    DIM bar AS STRING = ""

    bar = bar & RenderMenuItemHL("File", 1, m.MenuOpen = MENU_FILE)
    bar = bar & RenderMenuItemHL("Edit", 1, m.MenuOpen = MENU_EDIT)
    bar = bar & RenderMenuItemHL("View", 1, m.MenuOpen = MENU_VIEW)
    bar = bar & RenderMenuItemHL("Run", 1, m.MenuOpen = MENU_RUN)
    bar = bar & RenderMenuItemHL("Debug", 1, m.MenuOpen = MENU_DEBUG)
    bar = bar & RenderMenuItemHL("Options", 1, m.MenuOpen = MENU_OPTIONS)
    bar = bar & RenderMenuItemHL("Help", 1, m.MenuOpen = MENU_HELP)

    DIM used AS INTEGER = 52
    IF m.Width > used THEN
        bar = bar & styleMenuBar.Render(RepeatStr(" ", m.Width - used))
    ENDIF

    RETURN bar
END FUNCTION

FUNCTION RenderMenuItemHL(name AS STRING, hotkeyPos AS INTEGER, selected AS BOOLEAN) AS STRING
    DIM before AS STRING = Left(name, hotkeyPos - 1)
    DIM hotkey AS STRING = Mid(name, hotkeyPos, 1)
    DIM after AS STRING = Mid(name, hotkeyPos + 1, Len(name) - hotkeyPos)

    IF selected THEN
        RETURN styleMenuSelected.Render(" " & before) & styleMenuHotkeySelected.Render(hotkey) & styleMenuSelected.Render(after & " ")
    ELSE
        RETURN styleMenuBar.Render(" " & before) & styleMenuHotkey.Render(hotkey) & styleMenuBar.Render(after & " ")
    ENDIF
END FUNCTION

FUNCTION GetMenuOffset(menu AS INTEGER) AS INTEGER
    IF menu = MENU_FILE THEN
        RETURN 0
    ELSEIF menu = MENU_EDIT THEN
        RETURN 6
    ELSEIF menu = MENU_VIEW THEN
        RETURN 12
    ELSEIF menu = MENU_RUN THEN
        RETURN 18
    ELSEIF menu = MENU_DEBUG THEN
        RETURN 23
    ELSEIF menu = MENU_OPTIONS THEN
        RETURN 30
    ELSEIF menu = MENU_HELP THEN
        RETURN 39
    ENDIF
    RETURN 0
END FUNCTION

FUNCTION GetDropdownLines(m AS VDBTermModel) AS []STRING
    DIM lines AS []STRING
    ' All menu items must be exactly 18 characters to fit in 20-char box (1 border + 18 content + 1 border)

    IF m.MenuOpen = MENU_FILE THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Project       ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Open Project      ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Save Project      ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Form          ", 5, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Module        ", 5, m.MenuIndex = 5) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Exit        Alt+X ", 2, m.MenuIndex = 7) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_EDIT THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Cut        Ctrl+X ", 3, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Copy       Ctrl+C ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Paste      Ctrl+V ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Select All Ctrl+A ", 8, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Delete            ", 1, m.MenuIndex = 5) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Menu Editor...    ", 1, m.MenuIndex = 7) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_VIEW THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Form View      F7 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Code View      F7 ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Show Grid         ", 6, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Line Numbers      ", 1, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_RUN THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Run            F5 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Build             ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Set Startup       ", 5, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_DEBUG THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Step           F8 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Breakpoint     F9 ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Watch             ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Clear All         ", 1, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Environment       ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Editor            ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Colors            ", 1, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_HELP THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Help           F1 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("About             ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ENDIF

    RETURN lines
END FUNCTION

FUNCTION RenderDropdownItemHL(text AS STRING, hotkeyPos AS INTEGER, selected AS BOOLEAN) AS STRING
    DIM before AS STRING = Left(text, hotkeyPos - 1)
    DIM hotkey AS STRING = Mid(text, hotkeyPos, 1)
    DIM after AS STRING = Mid(text, hotkeyPos + 1, Len(text) - hotkeyPos)

    IF selected THEN
        RETURN styleDropdownSelected.Render(before) & styleDropdownHotkeySelected.Render(hotkey) & styleDropdownSelected.Render(after)
    ELSE
        RETURN styleDropdown.Render(before) & styleDropdownHotkey.Render(hotkey) & styleDropdown.Render(after)
    ENDIF
END FUNCTION

' Status bar rendering
FUNCTION RenderStatusBar(m AS VDBTermModel) AS STRING
    DIM status AS STRING = " "

    IF m.ProjectLoaded THEN
        status = status & m.Project.Name
        IF m.Project.Modified THEN
            status = status & " *"
        ENDIF
        status = status & " | "
        IF m.CurrentFormIdx < Len(m.Project.Forms) THEN
            status = status & m.Project.Forms[m.CurrentFormIdx].Name
        ENDIF
    ELSE
        status = status & "[No Project]"
    ENDIF

    status = status & " | "
    IF m.ViewMode = VIEW_FORM THEN
        status = status & "Form"
    ELSE
        status = status & "Code Ln " & Str(m.CodeCursorY + 1) & " Col " & Str(m.CodeCursorX + 1)
    ENDIF

    IF Len(m.Message) > 0 THEN
        status = status & " | " & m.Message
    ENDIF

    status = status & " | F1=Help F5=Run F7=View F10=Menu"

    RETURN styleStatusBar.Render(PadRight(status, m.Width))
END FUNCTION

' Dialog rendering
FUNCTION GetDialogLines(m AS VDBTermModel) AS []STRING
    DIM lines AS []STRING
    DIM title AS STRING = ""
    DIM width AS INTEGER = 40
    DIM contentLines AS []STRING

    IF m.DialogMode = DIALOG_HELP THEN
        title = " VDBTerm Help "
        width = 50
        contentLines = APPEND(contentLines, "  VDBTerm - Visual DBasic Terminal IDE")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Keyboard Shortcuts:")
        contentLines = APPEND(contentLines, "    F1     - Help")
        contentLines = APPEND(contentLines, "    F5     - Run project")
        contentLines = APPEND(contentLines, "    F7     - Toggle Form/Code view")
        contentLines = APPEND(contentLines, "    F10    - Open menu")
        contentLines = APPEND(contentLines, "    Tab    - Cycle focus areas")
        contentLines = APPEND(contentLines, "    Arrows - Navigate/Move controls")
        contentLines = APPEND(contentLines, "    +/-    - Resize selected control")
        contentLines = APPEND(contentLines, "    Delete - Delete selected control")
        contentLines = APPEND(contentLines, "    Enter  - Add control from toolbox")
        contentLines = APPEND(contentLines, "    Ctrl+Q - Exit")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Mouse Controls:")
        contentLines = APPEND(contentLines, "    Click  - Select panels/controls/menu")
        contentLines = APPEND(contentLines, "    Drag   - Move controls on form")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Press Enter or Esc to close")
    ELSEIF m.DialogMode = DIALOG_ABOUT THEN
        title = " About VDBTerm "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "      VDBTerm v1.0")
        contentLines = APPEND(contentLines, "      Visual DBasic Terminal IDE")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   A modern clone of VBDos Pro")
        contentLines = APPEND(contentLines, "   Written in DBasic for DBasic")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   Create visual terminal applications")
        contentLines = APPEND(contentLines, "   with forms, controls, and events.")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Press Enter or Esc to close")
    ELSEIF m.DialogMode = DIALOG_OPEN_PROJECT THEN
        title = " Open Project "
        width = 40
        contentLines = APPEND(contentLines, "  File Name:")
        contentLines = APPEND(contentLines, "  [" & PadRight(m.DialogInput, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_PROJECT THEN
        title = " New Project "
        width = 40
        contentLines = APPEND(contentLines, "  Project Name:")
        contentLines = APPEND(contentLines, "  [" & PadRight(m.DialogInput, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_SAVE_PROJECT THEN
        title = " Save Project "
        width = 40
        contentLines = APPEND(contentLines, "  File Name:")
        contentLines = APPEND(contentLines, "  [" & PadRight(m.DialogInput, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_FORM THEN
        title = " New Form "
        width = 40
        contentLines = APPEND(contentLines, "  Form Name:")
        contentLines = APPEND(contentLines, "  [" & PadRight(m.DialogInput, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_MODULE THEN
        title = " New Module "
        width = 40
        contentLines = APPEND(contentLines, "  Module Name:")
        contentLines = APPEND(contentLines, "  [" & PadRight(m.DialogInput, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        title = " Exit "
        width = 36
        contentLines = APPEND(contentLines, "  Project has been modified.")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Exit without saving?")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < Yes (Y) >   < No (N) >")
    ELSEIF m.DialogMode = DIALOG_ENVIRONMENT THEN
        title = " Environment Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Snap to Grid:    [" & IIFStr(m.SnapToGrid, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Grid Size:       [" & PadRight(Str(m.GridSize), 3) & "]")
        contentLines = APPEND(contentLines, "  Auto Save:       [ ]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_EDITOR THEN
        title = " Editor Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Tab Size:        [" & PadRight(Str(m.TabSize), 3) & "]")
        contentLines = APPEND(contentLines, "  Auto Indent:     [" & IIFStr(m.AutoIndent, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Line Numbers:    [" & IIFStr(m.ShowLineNumbers, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Syntax Highlight:[ ]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_COLORS THEN
        title = " Color Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Color Scheme:")
        contentLines = APPEND(contentLines, "    ( ) Classic Blue")
        contentLines = APPEND(contentLines, "    (o) Dark Mode")
        contentLines = APPEND(contentLines, "    ( ) Light Mode")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_MENU_EDITOR THEN
        title = " Menu Editor "
        width = 50
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Menu Items:                        ")
        contentLines = APPEND(contentLines, "  ┌────────────────────────────────┐ ")
        contentLines = APPEND(contentLines, "  │ &File                          │ ")
        contentLines = APPEND(contentLines, "  │   &New                         │ ")
        contentLines = APPEND(contentLines, "  │   &Open                        │ ")
        contentLines = APPEND(contentLines, "  │   &Save                        │ ")
        contentLines = APPEND(contentLines, "  │   -                            │ ")
        contentLines = APPEND(contentLines, "  │   E&xit                        │ ")
        contentLines = APPEND(contentLines, "  └────────────────────────────────┘ ")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Caption: [" & PadRight(m.DialogInput, 20) & "]")
        contentLines = APPEND(contentLines, "  Name:    [" & PadRight(m.DialogInput2, 20) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  [Insert] [Delete] [Up] [Down]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >            < Cancel >")
    ENDIF

    ' Build dialog box
    DIM innerWidth AS INTEGER = width - 2
    DIM i AS INTEGER

    ' Top border with title
    DIM titleStart AS INTEGER = (innerWidth - Len(title)) / 2
    DIM borderTop AS STRING = "╔"
    FOR i = 0 TO innerWidth - 1
        IF i >= titleStart AND i < titleStart + Len(title) THEN
            borderTop = borderTop & Mid(title, i - titleStart + 1, 1)
        ELSE
            borderTop = borderTop & "═"
        ENDIF
    NEXT
    borderTop = borderTop & "╗"
    lines = APPEND(lines, styleDialog.Render(borderTop))

    ' Content lines
    FOR i = 0 TO Len(contentLines) - 1
        DIM lineContent AS STRING = PadRight(contentLines[i], innerWidth)
        lines = APPEND(lines, styleDialog.Render("║" & lineContent & "║"))
    NEXT

    ' Bottom border
    DIM borderBottom AS STRING = "╚"
    FOR i = 1 TO innerWidth
        borderBottom = borderBottom & "═"
    NEXT
    borderBottom = borderBottom & "╝"
    lines = APPEND(lines, styleDialog.Render(borderBottom))

    RETURN lines
END FUNCTION

FUNCTION GetDialogSize(m AS VDBTermModel) AS (INTEGER, INTEGER)
    IF m.DialogMode = DIALOG_HELP THEN
        RETURN 50, 21
    ELSEIF m.DialogMode = DIALOG_ABOUT THEN
        RETURN 44, 13
    ELSEIF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        RETURN 36, 7
    ELSEIF m.DialogMode = DIALOG_NEW_PROJECT OR m.DialogMode = DIALOG_SAVE_PROJECT OR m.DialogMode = DIALOG_NEW_FORM OR m.DialogMode = DIALOG_NEW_MODULE OR m.DialogMode = DIALOG_OPEN_PROJECT THEN
        RETURN 40, 6
    ELSEIF m.DialogMode = DIALOG_ENVIRONMENT THEN
        RETURN 44, 8
    ELSEIF m.DialogMode = DIALOG_EDITOR THEN
        RETURN 44, 9
    ELSEIF m.DialogMode = DIALOG_COLORS THEN
        RETURN 44, 10
    ELSEIF m.DialogMode = DIALOG_MENU_EDITOR THEN
        RETURN 50, 20
    ENDIF
    RETURN 40, 8
END FUNCTION

' ============================================================================
' MAIN ENTRY POINT
' ============================================================================

SUB Main()
    DIM model AS VDBTermModel

    ' Initialize defaults
    model.Width = 100
    model.Height = 30
    model.ViewMode = VIEW_FORM
    model.FocusArea = FOCUS_TOOLBOX
    model.CurrentFormIdx = 0
    model.SelectedCtrlIdx = -1
    model.ToolboxIndex = 0
    model.MenuOpen = MENU_NONE
    model.MenuIndex = 0
    model.DialogMode = DIALOG_NONE
    model.ShowGrid = TRUE
    model.GridSize = 4
    model.SnapToGrid = TRUE
    model.ShowLineNumbers = TRUE
    model.TabSize = 4
    model.AutoIndent = TRUE
    model.Message = "Welcome to VDBTerm! F10=menu, F1=help. Mouse enabled."

    ' Check command line args
    DIM args AS []STRING = os.Args
    IF Len(args) > 1 THEN
        ' Load project file
        model.Message = "Loading: " & args[1]
    ELSE
        ' Create new project
        model.Project = NewProject("Project1")
        model.ProjectLoaded = TRUE
    ENDIF

    tea.NewProgram(model, tea.WithAltScreen(), tea.WithMouseCellMotion()).Run()
END SUB
