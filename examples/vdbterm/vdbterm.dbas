' VDBTerm - Visual DBasic Terminal IDE
' A modern clone of VBDos Pro for terminal environments
' Written in DBasic for DBasic development

IMPORT "github.com/charmbracelet/bubbletea" AS tea
IMPORT "github.com/charmbracelet/lipgloss" AS lipgloss
IMPORT "github.com/charmbracelet/bubbles/textarea" AS textarea
IMPORT "fmt" AS fmt
IMPORT "os" AS os

' Include all modules
INCLUDE "vdbterm_const.dbas"
INCLUDE "vdbterm_types.dbas"
INCLUDE "vdbterm_styles.dbas"
INCLUDE "vdbterm_helpers.dbas"
INCLUDE "vdbterm_codegen.dbas"
INCLUDE "vdbterm_project.dbas"
INCLUDE "vdbterm_syntax.dbas"
INCLUDE "vdbterm_highlight.dbas"
INCLUDE "vdbterm_editor.dbas"
INCLUDE "vdbterm_input.dbas"
INCLUDE "vdbterm_codeedit.dbas"
INCLUDE "vdbterm_render.dbas"

' ============================================================================
' BUBBLE TEA MODEL IMPLEMENTATION
' ============================================================================

FUNCTION (m AS VDBTermModel) Init() AS tea.Cmd
    InitStyles()
    InitChromaHighlighting()
    RETURN NIL
END FUNCTION

FUNCTION (m AS VDBTermModel) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' Handle window resize
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = Int(sizeMsg.Width)
        m.Height = Int(sizeMsg.Height)
        ' Update textarea size
        IF m.CodeEditorInited THEN
            DIM editorWidth AS INTEGER = m.Width - 16 - 22  ' toolbox - properties
            DIM editorHeight AS INTEGER = m.Height - 4
            IF editorWidth < 20 THEN
                editorWidth = 20
            ENDIF
            IF editorHeight < 5 THEN
                editorHeight = 5
            ENDIF
            m.CodeEditor = UpdateEditorSize(m.CodeEditor, editorWidth, editorHeight)
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Handle mouse messages
    DIM mouseMsg AS tea.MouseMsg
    DIM mouseOk AS BOOLEAN
    mouseMsg, mouseOk = msg.(tea.MouseMsg)
    IF mouseOk THEN
        RETURN HandleMouseInput(m, mouseMsg)
    ENDIF

    ' Handle key messages
    DIM keyMsg AS tea.KeyMsg
    DIM ok AS BOOLEAN
    keyMsg, ok = msg.(tea.KeyMsg)

    IF NOT ok THEN
        ' Unknown message type - check if returning from ExecProcess
        IF m.WasRunning THEN
            m.WasRunning = FALSE
            m.Message = "Returned from run"
            ' Re-enable mouse tracking after returning from external process
            RETURN m, tea.EnableMouseCellMotion
        ENDIF
        RETURN m, NIL
    ENDIF

    DIM key AS STRING = keyMsg.String()

    ' Dialog input takes priority
    IF m.DialogMode <> DIALOG_NONE THEN
        RETURN HandleDialogInput(m, key)
    ENDIF

    ' Menu input
    IF m.MenuOpen <> MENU_NONE THEN
        RETURN HandleMenuInput(m, key)
    ENDIF

    ' Popup input (event context menu)
    IF m.PopupMode <> POPUP_NONE THEN
        RETURN HandlePopupInput(m, key)
    ENDIF

    ' Global shortcuts
    IF key = "f10" OR key = "alt+f" THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+e" THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+v" THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+r" THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+d" THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+o" THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+h" OR key = "f1" THEN
        m.DialogMode = DIALOG_HELP
        RETURN m, NIL
    ELSEIF key = "ctrl+q" OR key = "alt+x" THEN
        IF m.Project.Modified THEN
            m.DialogMode = DIALOG_CONFIRM_EXIT
        ELSE
            RETURN m, tea.Quit
        ENDIF
        RETURN m, NIL
    ELSEIF key = "f5" THEN
        RETURN DoRun(m)
    ELSEIF key = "f7" THEN
        ' Toggle between Form and Code view
        IF m.ViewMode = VIEW_FORM THEN
            m.ViewMode = VIEW_CODE
            ' Sync code to textarea when switching to code view
            IF m.CodeEditorInited AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                m.CodeEditor = SyncCodeToEditor(m.CodeEditor, m.Project.Forms[m.CurrentFormIdx].Code)
            ENDIF
        ELSE
            ' Save code from textarea when switching away from code view
            IF m.CodeEditorInited AND m.ProjectLoaded AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
                m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
            ENDIF
            m.ViewMode = VIEW_FORM
        ENDIF
        RETURN m, NIL
    ELSEIF key = "tab" OR key = "shift+tab" THEN
        ' In code editor, let Tab pass through to insert tab character
        IF m.FocusArea = FOCUS_CODE THEN
            ' Don't cycle focus - let it be handled by code editor input
        ELSE
            ' Cycle focus areas
            DIM prevFocus AS INTEGER = m.FocusArea
            IF key = "tab" THEN
                m.FocusArea = m.FocusArea + 1
                IF m.FocusArea > FOCUS_PROPERTIES THEN
                    m.FocusArea = FOCUS_PROJECT
                ENDIF
            ELSE
                m.FocusArea = m.FocusArea - 1
                IF m.FocusArea < FOCUS_PROJECT THEN
                    m.FocusArea = FOCUS_PROPERTIES
                ENDIF
            ENDIF
            ' Manage textarea focus
            IF m.CodeEditorInited THEN
                IF prevFocus = FOCUS_CODE AND m.FocusArea <> FOCUS_CODE THEN
                    m.CodeEditor = BlurEditor(m.CodeEditor)
                ELSEIF prevFocus <> FOCUS_CODE AND m.FocusArea = FOCUS_CODE THEN
                    m.CodeEditor = FocusEditor(m.CodeEditor)
                ENDIF
            ENDIF
            RETURN m, NIL
        ENDIF
    ENDIF

    ' Route input based on focus area
    IF m.FocusArea = FOCUS_PROJECT THEN
        RETURN HandleProjectInput(m, key)
    ELSEIF m.FocusArea = FOCUS_WIDGETS THEN
        RETURN HandleWidgetsInput(m, key)
    ELSEIF m.FocusArea = FOCUS_TOOLBOX THEN
        RETURN HandleToolboxInput(m, key)
    ELSEIF m.FocusArea = FOCUS_FORM THEN
        RETURN HandleFormInput(m, key)
    ELSEIF m.FocusArea = FOCUS_CODE THEN
        ' Use raw message handler for textarea support
        RETURN HandleCodeInputMsg(m, msg)
    ELSEIF m.FocusArea = FOCUS_PROPERTIES THEN
        RETURN HandlePropertiesInput(m, key)
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' MAIN ENTRY POINT
' ============================================================================

SUB Main()
    DIM model AS VDBTermModel

    ' Initialize defaults
    model.Width = 100
    model.Height = 30
    model.ViewMode = VIEW_FORM
    model.FocusArea = FOCUS_PROJECT
    model.CurrentFormIdx = 0
    model.SelectedCtrlIdx = -1
    model.ToolboxIndex = 0
    model.WidgetsIndex = 0
    model.MenuOpen = MENU_NONE
    model.MenuIndex = 0
    model.DialogMode = DIALOG_NONE
    model.ShowGrid = TRUE
    model.GridSize = 4
    model.SnapToGrid = TRUE
    model.ShowLineNumbers = TRUE
    model.TabSize = 4
    model.AutoIndent = TRUE
    model.SyntaxHighlight = TRUE
    model.Message = "Welcome to VDBTerm! F10=menu, F1=help. Mouse enabled."

    ' Left panel layout (heights are adjustable by dragging captions)
    model.ProjectHeight = 8
    model.WidgetsHeight = 12
    model.ToolboxHeight = 4
    model.PanelDragging = PANEL_DRAG_NONE

    ' Initialize code editor (textarea)
    model.CodeEditor = InitCodeEditor(60, 20)
    model.CodeEditorInited = TRUE

    ' Check command line args
    DIM args AS []STRING = os.Args
    IF Len(args) > 1 THEN
        ' Load project file
        model.Message = "Loading: " & args[1]
    ELSE
        ' Create new project
        model.Project = NewProject("Project1")
        model.ProjectLoaded = TRUE
        ' Sync initial code to editor
        IF Len(model.Project.Forms) > 0 THEN
            model.CodeEditor = SyncCodeToEditor(model.CodeEditor, model.Project.Forms[0].Code)
        ENDIF
    ENDIF

    tea.NewProgram(model, tea.WithAltScreen(), tea.WithMouseCellMotion()).Run()
END SUB
