' VDBTerm - Visual DBasic Terminal IDE
' A modern clone of VBDos Pro for terminal environments
' Written in DBasic for DBasic development

IMPORT "github.com/charmbracelet/bubbletea" AS tea
IMPORT "github.com/charmbracelet/lipgloss" AS lipgloss
IMPORT "fmt" AS fmt
IMPORT "os" AS os

' Include all modules
INCLUDE "vdbterm_const.dbas"
INCLUDE "vdbterm_types.dbas"
INCLUDE "vdbterm_styles.dbas"
INCLUDE "vdbterm_helpers.dbas"
INCLUDE "vdbterm_project.dbas"
INCLUDE "vdbterm_input.dbas"
INCLUDE "vdbterm_codeedit.dbas"
INCLUDE "vdbterm_render.dbas"

' ============================================================================
' BUBBLE TEA MODEL IMPLEMENTATION
' ============================================================================

FUNCTION (m AS VDBTermModel) Init() AS tea.Cmd
    InitStyles()
    RETURN NIL
END FUNCTION

FUNCTION (m AS VDBTermModel) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    ' Handle window resize
    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.Width = Int(sizeMsg.Width)
        m.Height = Int(sizeMsg.Height)
        RETURN m, NIL
    ENDIF

    ' Handle mouse messages
    DIM mouseMsg AS tea.MouseMsg
    DIM mouseOk AS BOOLEAN
    mouseMsg, mouseOk = msg.(tea.MouseMsg)
    IF mouseOk THEN
        RETURN HandleMouseInput(m, mouseMsg)
    ENDIF

    ' Handle key messages
    DIM keyMsg AS tea.KeyMsg
    DIM ok AS BOOLEAN
    keyMsg, ok = msg.(tea.KeyMsg)

    IF NOT ok THEN
        RETURN m, NIL
    ENDIF

    DIM key AS STRING = keyMsg.String()

    ' Dialog input takes priority
    IF m.DialogMode <> DIALOG_NONE THEN
        RETURN HandleDialogInput(m, key)
    ENDIF

    ' Menu input
    IF m.MenuOpen <> MENU_NONE THEN
        RETURN HandleMenuInput(m, key)
    ENDIF

    ' Global shortcuts
    IF key = "f10" OR key = "alt+f" THEN
        m.MenuOpen = MENU_FILE
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+e" THEN
        m.MenuOpen = MENU_EDIT
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+v" THEN
        m.MenuOpen = MENU_VIEW
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+r" THEN
        m.MenuOpen = MENU_RUN
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+d" THEN
        m.MenuOpen = MENU_DEBUG
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+o" THEN
        m.MenuOpen = MENU_OPTIONS
        m.MenuIndex = 0
        RETURN m, NIL
    ELSEIF key = "alt+h" OR key = "f1" THEN
        m.DialogMode = DIALOG_HELP
        RETURN m, NIL
    ELSEIF key = "ctrl+q" OR key = "alt+x" THEN
        IF m.Project.Modified THEN
            m.DialogMode = DIALOG_CONFIRM_EXIT
        ELSE
            RETURN m, tea.Quit
        ENDIF
        RETURN m, NIL
    ELSEIF key = "f5" THEN
        RETURN DoRun(m)
    ELSEIF key = "f7" THEN
        ' Toggle between Form and Code view
        IF m.ViewMode = VIEW_FORM THEN
            m.ViewMode = VIEW_CODE
        ELSE
            m.ViewMode = VIEW_FORM
        ENDIF
        RETURN m, NIL
    ELSEIF key = "tab" THEN
        ' Cycle focus areas
        m.FocusArea = m.FocusArea + 1
        IF m.FocusArea > FOCUS_PROJECT THEN
            m.FocusArea = FOCUS_TOOLBOX
        ENDIF
        RETURN m, NIL
    ELSEIF key = "shift+tab" THEN
        ' Cycle focus backwards
        m.FocusArea = m.FocusArea - 1
        IF m.FocusArea < FOCUS_TOOLBOX THEN
            m.FocusArea = FOCUS_PROJECT
        ENDIF
        RETURN m, NIL
    ENDIF

    ' Route input based on focus area
    IF m.FocusArea = FOCUS_TOOLBOX THEN
        RETURN HandleToolboxInput(m, key)
    ELSEIF m.FocusArea = FOCUS_FORM THEN
        RETURN HandleFormInput(m, key)
    ELSEIF m.FocusArea = FOCUS_CODE THEN
        RETURN HandleCodeInput(m, key)
    ELSEIF m.FocusArea = FOCUS_PROPERTIES THEN
        RETURN HandlePropertiesInput(m, key)
    ELSEIF m.FocusArea = FOCUS_PROJECT THEN
        RETURN HandleProjectInput(m, key)
    ENDIF

    RETURN m, NIL
END FUNCTION

' ============================================================================
' MAIN ENTRY POINT
' ============================================================================

SUB Main()
    DIM model AS VDBTermModel

    ' Initialize defaults
    model.Width = 100
    model.Height = 30
    model.ViewMode = VIEW_FORM
    model.FocusArea = FOCUS_TOOLBOX
    model.CurrentFormIdx = 0
    model.SelectedCtrlIdx = -1
    model.ToolboxIndex = 0
    model.MenuOpen = MENU_NONE
    model.MenuIndex = 0
    model.DialogMode = DIALOG_NONE
    model.ShowGrid = TRUE
    model.GridSize = 4
    model.SnapToGrid = TRUE
    model.ShowLineNumbers = TRUE
    model.TabSize = 4
    model.AutoIndent = TRUE
    model.Message = "Welcome to VDBTerm! F10=menu, F1=help. Mouse enabled."

    ' Check command line args
    DIM args AS []STRING = os.Args
    IF Len(args) > 1 THEN
        ' Load project file
        model.Message = "Loading: " & args[1]
    ELSE
        ' Create new project
        model.Project = NewProject("Project1")
        model.ProjectLoaded = TRUE
    ENDIF

    tea.NewProgram(model, tea.WithAltScreen(), tea.WithMouseCellMotion()).Run()
END SUB
