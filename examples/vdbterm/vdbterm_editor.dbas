' VDBTerm Code Editor
' Textarea component integration for code editing

IMPORT "github.com/charmbracelet/bubbles/textarea" AS textarea
IMPORT "github.com/charmbracelet/bubbles/key" AS key
IMPORT "github.com/charmbracelet/bubbletea" AS tea

' Initialize the textarea component with Windows-style key bindings
FUNCTION InitCodeEditor(width AS INTEGER, height AS INTEGER) AS textarea.Model
    DIM ta AS textarea.Model = textarea.New()
    ta.SetWidth(width)
    ta.SetHeight(height)
    ta.Placeholder = "' Enter code here..."
    ta.ShowLineNumbers = TRUE

    ' Set up Windows-style key bindings (Notepad-like)
    ta.KeyMap.WordForward = key.NewBinding(key.WithKeys("ctrl+right"))
    ta.KeyMap.WordBackward = key.NewBinding(key.WithKeys("ctrl+left"))
    ta.KeyMap.DeleteWordForward = key.NewBinding(key.WithKeys("ctrl+delete"))
    ta.KeyMap.DeleteWordBackward = key.NewBinding(key.WithKeys("ctrl+backspace"))
    ta.KeyMap.InputBegin = key.NewBinding(key.WithKeys("ctrl+home"))
    ta.KeyMap.InputEnd = key.NewBinding(key.WithKeys("ctrl+end"))
    ta.KeyMap.LineStart = key.NewBinding(key.WithKeys("home"))
    ta.KeyMap.LineEnd = key.NewBinding(key.WithKeys("end"))
    ta.KeyMap.CharacterForward = key.NewBinding(key.WithKeys("right"))
    ta.KeyMap.CharacterBackward = key.NewBinding(key.WithKeys("left"))
    ta.KeyMap.LineNext = key.NewBinding(key.WithKeys("down"))
    ta.KeyMap.LinePrevious = key.NewBinding(key.WithKeys("up"))
    ta.KeyMap.DeleteCharacterBackward = key.NewBinding(key.WithKeys("backspace"))
    ta.KeyMap.DeleteCharacterForward = key.NewBinding(key.WithKeys("delete"))
    ta.KeyMap.InsertNewline = key.NewBinding(key.WithKeys("enter"))
    ta.KeyMap.Paste = key.NewBinding(key.WithKeys("ctrl+v"))
    ' Disable Emacs-style bindings we don't want
    ta.KeyMap.DeleteAfterCursor = key.NewBinding(key.WithKeys())
    ta.KeyMap.DeleteBeforeCursor = key.NewBinding(key.WithKeys())
    ta.KeyMap.UppercaseWordForward = key.NewBinding(key.WithKeys())
    ta.KeyMap.LowercaseWordForward = key.NewBinding(key.WithKeys())
    ta.KeyMap.CapitalizeWordForward = key.NewBinding(key.WithKeys())
    ta.KeyMap.TransposeCharacterBackward = key.NewBinding(key.WithKeys())

    ta.Focus()
    RETURN ta
END FUNCTION

' Sync code from form to textarea
FUNCTION SyncCodeToEditor(editor AS textarea.Model, code AS STRING) AS textarea.Model
    editor.SetValue(code)
    editor.Focus()
    RETURN editor
END FUNCTION

' Focus the editor
FUNCTION FocusEditor(editor AS textarea.Model) AS textarea.Model
    editor.Focus()
    RETURN editor
END FUNCTION

' Blur the editor
FUNCTION BlurEditor(editor AS textarea.Model) AS textarea.Model
    editor.Blur()
    RETURN editor
END FUNCTION

' Get code from textarea
FUNCTION GetEditorCode(editor AS textarea.Model) AS STRING
    RETURN editor.Value()
END FUNCTION

' Update editor dimensions
FUNCTION UpdateEditorSize(editor AS textarea.Model, width AS INTEGER, height AS INTEGER) AS textarea.Model
    editor.SetWidth(width)
    editor.SetHeight(height)
    RETURN editor
END FUNCTION

' Handle key input for the editor - returns updated editor and whether it was handled
FUNCTION HandleEditorKeyInput(editor AS textarea.Model, msg AS tea.Msg) AS (textarea.Model, tea.Cmd)
    DIM newEditor AS textarea.Model
    DIM cmd AS tea.Cmd
    newEditor, cmd = editor.Update(msg)
    RETURN newEditor, cmd
END FUNCTION

' Get cursor line position from editor
FUNCTION GetEditorCursorLine(editor AS textarea.Model) AS INTEGER
    RETURN editor.Line()
END FUNCTION

' Get cursor column position from editor
FUNCTION GetEditorCursorCol(editor AS textarea.Model) AS INTEGER
    DIM info AS textarea.LineInfo = editor.LineInfo()
    RETURN info.ColumnOffset
END FUNCTION

' Set cursor to specific line and column
' Note: This uses textarea methods but mouse positioning may have limitations
FUNCTION SetEditorCursor(editor AS textarea.Model, line AS INTEGER, col AS INTEGER) AS textarea.Model
    ' Move to start first
    editor.CursorStart()

    ' Move down to target line
    DIM i AS INTEGER
    FOR i = 0 TO line - 1
        editor.CursorDown()
    NEXT

    ' Set column position within current line
    editor.SetCursor(col)

    RETURN editor
END FUNCTION

' Render the editor
FUNCTION RenderEditor(editor AS textarea.Model) AS STRING
    RETURN editor.View()
END FUNCTION

' Get the editor view split into lines for row-based rendering
FUNCTION GetEditorViewLines(editor AS textarea.Model) AS []STRING
    DIM view AS STRING = editor.View()
    DIM lines AS []STRING
    DIM line AS STRING = ""
    DIM i AS INTEGER

    FOR i = 1 TO Len(view)
        DIM ch AS STRING = Mid(view, i, 1)
        IF ch = Chr(10) THEN
            lines = APPEND(lines, line)
            line = ""
        ELSE
            line = line & ch
        ENDIF
    NEXT

    ' Add last line if non-empty
    IF Len(line) > 0 THEN
        lines = APPEND(lines, line)
    ENDIF

    RETURN lines
END FUNCTION
