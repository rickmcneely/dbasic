' VDBTerm Rendering
' All view rendering functions

FUNCTION (m AS VDBTermModel) View() AS STRING
    DIM view AS STRING = ""

    ' Menu bar
    view = RenderMenuBar(m) & Chr(10)

    ' Calculate layout dimensions
    DIM leftPanelWidth AS INTEGER = 16
    DIM propertiesWidth AS INTEGER = 22
    DIM contentHeight AS INTEGER = m.Height - 4
    DIM contentWidth AS INTEGER = m.Width - leftPanelWidth - propertiesWidth

    IF contentWidth < 20 THEN
        contentWidth = 20
    ENDIF

    ' Get dropdown/dialog overlays
    DIM dropdownLines AS []STRING
    IF m.MenuOpen <> MENU_NONE THEN
        dropdownLines = GetDropdownLines(m)
    ENDIF

    DIM dialogLines AS []STRING
    DIM dialogWidth AS INTEGER = 0
    DIM dialogHeight AS INTEGER = 0
    DIM dialogStartRow AS INTEGER = 0
    DIM dialogStartCol AS INTEGER = 0
    IF m.DialogMode <> DIALOG_NONE THEN
        dialogLines = GetDialogLines(m)
        dialogWidth, dialogHeight = GetDialogSize(m)
        dialogHeight = Len(dialogLines)
        dialogStartRow = (contentHeight - dialogHeight) / 2
        dialogStartCol = (m.Width - dialogWidth) / 2
        IF dialogStartRow < 0 THEN
            dialogStartRow = 0
        ENDIF
        IF dialogStartCol < 0 THEN
            dialogStartCol = 0
        ENDIF
    ENDIF

    ' Get popup overlay (events context menu)
    DIM popupLines AS []STRING
    DIM popupWidth AS INTEGER = 0
    DIM popupStartRow AS INTEGER = 0
    DIM popupStartCol AS INTEGER = 0
    IF m.PopupMode <> POPUP_NONE THEN
        popupLines = GetPopupLines(m)
        popupWidth = GetPopupWidth(m)
        popupStartRow = m.PopupY - 1  ' -1 for menu bar offset
        popupStartCol = m.PopupX
        ' Adjust if popup would go off screen
        IF popupStartRow + Len(popupLines) > contentHeight THEN
            popupStartRow = contentHeight - Len(popupLines)
        ENDIF
        IF popupStartCol + popupWidth > m.Width THEN
            popupStartCol = m.Width - popupWidth
        ENDIF
        IF popupStartRow < 0 THEN
            popupStartRow = 0
        ENDIF
        IF popupStartCol < 0 THEN
            popupStartCol = 0
        ENDIF
    ENDIF

    ' Render main content area row by row
    DIM row AS INTEGER
    FOR row = 0 TO contentHeight - 1
        DIM rowContent AS STRING = ""

        ' Check for dialog overlay (highest priority)
        DIM dialogRowIdx AS INTEGER = row - dialogStartRow
        IF m.DialogMode <> DIALOG_NONE AND dialogRowIdx >= 0 AND dialogRowIdx < Len(dialogLines) THEN
            ' Render with dialog overlay
            DIM col AS INTEGER
            FOR col = 0 TO dialogStartCol - 1
                rowContent = rowContent & RenderCellAt(m, row, col, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
            rowContent = rowContent & dialogLines[dialogRowIdx]
            FOR col = dialogStartCol + dialogWidth TO m.Width - 1
                rowContent = rowContent & RenderCellAt(m, row, col, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
        ' Check for popup overlay (events context menu)
        ELSEIF m.PopupMode <> POPUP_NONE AND row >= popupStartRow AND row < popupStartRow + Len(popupLines) THEN
            DIM popupRowIdx AS INTEGER = row - popupStartRow
            DIM col3 AS INTEGER
            FOR col3 = 0 TO popupStartCol - 1
                rowContent = rowContent & RenderCellAt(m, row, col3, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
            rowContent = rowContent & popupLines[popupRowIdx]
            FOR col3 = popupStartCol + popupWidth TO m.Width - 1
                rowContent = rowContent & RenderCellAt(m, row, col3, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
        ' Check for dropdown overlay
        ELSEIF m.MenuOpen <> MENU_NONE AND row < Len(dropdownLines) THEN
            DIM dropOffset AS INTEGER = GetMenuOffset(m.MenuOpen)
            DIM dropWidth AS INTEGER = 20
            DIM col2 AS INTEGER
            FOR col2 = 0 TO dropOffset - 1
                rowContent = rowContent & RenderCellAt(m, row, col2, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
            rowContent = rowContent & dropdownLines[row]
            FOR col2 = dropOffset + dropWidth TO m.Width - 1
                rowContent = rowContent & RenderCellAt(m, row, col2, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
            NEXT
        ELSE
            ' Normal rendering
            rowContent = RenderRow(m, row, leftPanelWidth, contentWidth, propertiesWidth, contentHeight)
        ENDIF

        view = view & rowContent & Chr(10)
    NEXT

    ' Status bar
    view = view & RenderStatusBar(m)

    RETURN view
END FUNCTION

FUNCTION RenderCellAt(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, leftPanelWidth AS INTEGER, contentWidth AS INTEGER, propertiesWidth AS INTEGER, contentHeight AS INTEGER) AS STRING
    ' Determine which panel this cell belongs to
    IF col < leftPanelWidth THEN
        ' Left column: Project (top) → Widgets (middle) → Toolbox (bottom)
        DIM widgetsStart AS INTEGER = m.ProjectHeight
        DIM toolboxStart AS INTEGER = m.ProjectHeight + m.WidgetsHeight

        IF row < m.ProjectHeight THEN
            ' Project tree area
            RETURN RenderProjectCell(m, row, col, leftPanelWidth)
        ELSEIF row < toolboxStart THEN
            ' Widgets area
            DIM localRow AS INTEGER = row - widgetsStart
            RETURN RenderWidgetsCell(m, localRow, col, leftPanelWidth)
        ELSE
            ' Toolbox area
            DIM localRow2 AS INTEGER = row - toolboxStart
            RETURN RenderToolboxCell(m, localRow2, col, leftPanelWidth)
        ENDIF
    ELSEIF col < leftPanelWidth + contentWidth THEN
        ' Middle: Form/Code (full height)
        DIM localCol AS INTEGER = col - leftPanelWidth
        IF m.ViewMode = VIEW_FORM THEN
            RETURN RenderFormCell(m, row, localCol, contentWidth)
        ELSE
            RETURN RenderCodeCell(m, row, localCol, contentWidth)
        ENDIF
    ELSE
        DIM propCol AS INTEGER = col - leftPanelWidth - contentWidth
        RETURN RenderPropertiesCell(m, row, propCol, propertiesWidth)
    ENDIF
END FUNCTION

FUNCTION RenderRow(m AS VDBTermModel, row AS INTEGER, leftPanelWidth AS INTEGER, contentWidth AS INTEGER, propertiesWidth AS INTEGER, contentHeight AS INTEGER) AS STRING
    DIM result AS STRING = ""

    ' Left column: Project (top) → Widgets (middle) → Toolbox (bottom)
    DIM widgetsStart AS INTEGER = m.ProjectHeight
    DIM toolboxStart AS INTEGER = m.ProjectHeight + m.WidgetsHeight

    IF row < m.ProjectHeight THEN
        ' Project tree area
        result = result & RenderProjectRow(m, row, leftPanelWidth)
    ELSEIF row < toolboxStart THEN
        ' Widgets area
        DIM localRow AS INTEGER = row - widgetsStart
        result = result & RenderWidgetsRow(m, localRow, leftPanelWidth)
    ELSE
        ' Toolbox area
        DIM localRow2 AS INTEGER = row - toolboxStart
        result = result & RenderToolboxRow(m, localRow2, leftPanelWidth)
    ENDIF

    ' Main content (full height)
    IF m.ViewMode = VIEW_FORM THEN
        result = result & RenderFormRow(m, row, contentWidth)
    ELSE
        result = result & RenderCodeRow(m, row, contentWidth)
    ENDIF

    ' Properties
    result = result & RenderPropertiesRow(m, row, propertiesWidth)

    RETURN result
END FUNCTION

' Widgets panel rendering (visible widgets: Button, Label, TextBox, etc.)
FUNCTION RenderWidgetsRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - draggable caption (highlighted blue)
        content = stylePanelTitle.Render(PadCenter("= Widgets", width))
        RETURN content
    ENDIF

    ' Visible widgets: Button(1), Label(2), TextBox(3), CheckBox(4), Option(5),
    '                  ListBox(6), ComboBox(7), Frame(8), HScroll(9), VScroll(10),
    '                  TextArea(12), Progress(13), Spinner(14), Table(15)
    DIM widgetIdx AS INTEGER = row - 1 + m.WidgetsScroll
    IF widgetIdx >= 0 AND widgetIdx < VISIBLE_WIDGET_COUNT THEN
        DIM ctlType AS INTEGER = WidgetIndexToCtrlType(widgetIdx)
        DIM icon AS STRING = GetToolboxIcon(ctlType)
        DIM name AS STRING = GetControlTypeName(ctlType)
        DIM item AS STRING = icon & " " & name
        item = PadRight(item, width)

        IF widgetIdx = m.WidgetsIndex AND m.FocusArea = FOCUS_WIDGETS THEN
            content = styleToolboxSelected.Render(item)
        ELSE
            content = styleToolbox.Render(item)
        ENDIF
    ELSE
        content = styleToolbox.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderWidgetsCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering
    DIM ch AS STRING = " "
    DIM selected AS BOOLEAN = FALSE

    IF row = 0 THEN
        ' Title row - draggable caption
        DIM title AS STRING = PadCenter("= Widgets", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN stylePanelTitle.Render(ch)
    ELSE
        DIM widgetIdx AS INTEGER = row - 1 + m.WidgetsScroll
        IF widgetIdx >= 0 AND widgetIdx < VISIBLE_WIDGET_COUNT THEN
            DIM ctlType AS INTEGER = WidgetIndexToCtrlType(widgetIdx)
            DIM icon AS STRING = GetToolboxIcon(ctlType)
            DIM name AS STRING = GetControlTypeName(ctlType)
            DIM item AS STRING = PadRight(icon & " " & name, width)
            IF col < Len(item) THEN
                ch = Mid(item, col + 1, 1)
            ENDIF
            selected = (widgetIdx = m.WidgetsIndex AND m.FocusArea = FOCUS_WIDGETS)
        ENDIF
    ENDIF

    IF selected THEN
        RETURN styleToolboxSelected.Render(ch)
    ELSE
        RETURN styleToolbox.Render(ch)
    ENDIF
END FUNCTION

' Toolbox panel rendering (non-visible widgets: Timer, Serial, TCP/IP, UDP/IP)
FUNCTION RenderToolboxRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - draggable caption (highlighted blue)
        content = stylePanelTitle.Render(PadCenter("= Toolbox", width))
        RETURN content
    ENDIF

    ' Non-visible widgets
    DIM toolIdx AS INTEGER = row - 1 + m.ToolboxScroll
    IF toolIdx >= 0 AND toolIdx < NONVISIBLE_WIDGET_COUNT THEN
        DIM ctlType AS INTEGER = ToolboxIndexToCtrlType(toolIdx)
        DIM icon AS STRING = GetToolboxIcon(ctlType)
        DIM name AS STRING = GetControlTypeName(ctlType)
        DIM item AS STRING = icon & " " & name
        item = PadRight(item, width)

        IF toolIdx = m.ToolboxIndex AND m.FocusArea = FOCUS_TOOLBOX THEN
            content = styleToolboxSelected.Render(item)
        ELSE
            content = styleToolbox.Render(item)
        ENDIF
    ELSE
        content = styleToolbox.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderToolboxCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "
    DIM selected AS BOOLEAN = FALSE

    IF row = 0 THEN
        ' Title row - draggable caption
        DIM title AS STRING = PadCenter("= Toolbox", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN stylePanelTitle.Render(ch)
    ELSE
        DIM toolIdx AS INTEGER = row - 1 + m.ToolboxScroll
        IF toolIdx >= 0 AND toolIdx < NONVISIBLE_WIDGET_COUNT THEN
            DIM ctlType AS INTEGER = ToolboxIndexToCtrlType(toolIdx)
            DIM icon AS STRING = GetToolboxIcon(ctlType)
            DIM name AS STRING = GetControlTypeName(ctlType)
            DIM item AS STRING = PadRight(icon & " " & name, width)
            IF col < Len(item) THEN
                ch = Mid(item, col + 1, 1)
            ENDIF
            selected = (toolIdx = m.ToolboxIndex AND m.FocusArea = FOCUS_TOOLBOX)
        ENDIF
    ENDIF

    IF selected THEN
        RETURN styleToolboxSelected.Render(ch)
    ELSE
        RETURN styleToolbox.Render(ch)
    ENDIF
END FUNCTION

' Form canvas rendering
FUNCTION RenderFormRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        ' No form loaded
        content = styleFormCanvas.Render(PadRight(" No form loaded", width))
        RETURN content
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
    DIM formSelected AS BOOLEAN = (m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM)

    ' Create dynamic styles using the form's actual colors
    DIM formBorderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(form.ForeColor))).Background(lipgloss.Color(Str(form.BackColor)))
    DIM formCanvasStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(Str(form.BackColor)))

    ' Form position and dimensions
    ' Use drag position/dimensions during form drag/resize for live preview
    DIM formX AS INTEGER = form.X
    DIM formY AS INTEGER = form.Y
    DIM formW AS INTEGER = form.Width
    DIM formH AS INTEGER = form.Height
    IF m.IsDragging AND m.DraggingForm THEN
        formX = m.DragOutlineX
        formY = m.DragOutlineY
    ENDIF
    IF m.IsResizing AND m.ResizingForm THEN
        formW = m.DragCtrlWidth
        formH = m.DragCtrlHeight
    ENDIF

    ' Handle positions for form resize
    DIM centerCol AS INTEGER = formW / 2
    DIM centerRow AS INTEGER = formH / 2

    ' Check if row is outside form bounds
    IF row < formY OR row >= formY + formH THEN
        ' Row is outside form - render canvas
        content = styleFormCanvas.Render(RepeatStr(" ", width))
        RETURN content
    ENDIF

    ' Row relative to form
    DIM formRow AS INTEGER = row - formY

    ' Canvas before the form
    IF formX > 0 THEN
        content = content & styleFormCanvas.Render(RepeatStr(" ", formX))
    ENDIF

    ' Row 0 of form: Title bar
    IF formRow = 0 THEN
        DIM titleText AS STRING = " " & form.Caption & " "
        DIM titleStart AS INTEGER = 1
        DIM col AS INTEGER
        FOR col = 0 TO formW - 1
            DIM titleCh AS STRING = "─"
            DIM isHandle AS BOOLEAN = FALSE
            IF col = 0 THEN
                titleCh = "┌"
                IF formSelected THEN
                    isHandle = TRUE
                ENDIF
            ELSEIF col = formW - 1 THEN
                titleCh = "┐"
                IF formSelected THEN
                    isHandle = TRUE
                ENDIF
            ELSEIF col = centerCol AND formW >= 3 AND formSelected THEN
                isHandle = TRUE
            ELSEIF col >= titleStart AND col < titleStart + Len(titleText) THEN
                titleCh = Mid(titleText, col - titleStart + 1, 1)
            ENDIF
            IF isHandle THEN
                content = content & styleControlSelected.Render("■")
            ELSEIF formSelected THEN
                content = content & styleControlSelected.Render(titleCh)
            ELSE
                content = content & formBorderStyle.Render(titleCh)
            ENDIF
        NEXT
        ' Fill rest of row with canvas (after form)
        DIM remainW AS INTEGER = width - formX - formW
        IF remainW > 0 THEN
            content = content & styleFormCanvas.Render(RepeatStr(" ", remainW))
        ENDIF
        RETURN content
    ENDIF

    ' Bottom border row of form
    IF formRow = formH - 1 THEN
        DIM bCol AS INTEGER
        FOR bCol = 0 TO formW - 1
            DIM bottomCh AS STRING = "─"
            DIM isBHandle AS BOOLEAN = FALSE
            IF bCol = 0 THEN
                bottomCh = "└"
                IF formSelected THEN
                    isBHandle = TRUE
                ENDIF
            ELSEIF bCol = formW - 1 THEN
                bottomCh = "┘"
                IF formSelected THEN
                    isBHandle = TRUE
                ENDIF
            ELSEIF bCol = centerCol AND formW >= 3 AND formSelected THEN
                isBHandle = TRUE
            ENDIF
            IF isBHandle THEN
                content = content & styleControlSelected.Render("■")
            ELSEIF formSelected THEN
                content = content & styleControlSelected.Render(bottomCh)
            ELSE
                content = content & formBorderStyle.Render(bottomCh)
            ENDIF
        NEXT
        ' Fill rest of row with canvas (after form)
        DIM remainW2 AS INTEGER = width - formX - formW
        IF remainW2 > 0 THEN
            content = content & styleFormCanvas.Render(RepeatStr(" ", remainW2))
        ENDIF
        RETURN content
    ENDIF

    ' Row 1 to formH-2: Form content with left and right borders
    DIM contentRow AS INTEGER = formRow - 1

    ' Left border (with handle at center row if selected)
    DIM isLeftHandle AS BOOLEAN = (formSelected AND formRow = centerRow AND formH >= 3)
    IF isLeftHandle THEN
        content = content & styleControlSelected.Render("■")
    ELSEIF formSelected THEN
        content = content & styleControlSelected.Render("│")
    ELSE
        content = content & formBorderStyle.Render("│")
    ENDIF

    ' Pre-filter: collect only controls that intersect this content row
    DIM rowCtrlIndices AS []INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM c AS VDBControl = form.Controls[i]
        IF contentRow >= c.Y AND contentRow < c.Y + c.Height THEN
            rowCtrlIndices = APPEND(rowCtrlIndices, i)
        ENDIF
    NEXT
    ' Sort by TabIndex descending so higher z-order controls are checked first
    ' (Simple bubble sort - control count per row is typically small)
    DIM sortI AS INTEGER
    DIM sortJ AS INTEGER
    FOR sortI = 0 TO Len(rowCtrlIndices) - 2
        FOR sortJ = sortI + 1 TO Len(rowCtrlIndices) - 1
            DIM tabI AS INTEGER = form.Controls[rowCtrlIndices[sortI]].TabIndex
            DIM tabJ AS INTEGER = form.Controls[rowCtrlIndices[sortJ]].TabIndex
            IF tabJ > tabI THEN
                ' Swap - higher TabIndex should come first
                DIM tmp AS INTEGER = rowCtrlIndices[sortI]
                rowCtrlIndices[sortI] = rowCtrlIndices[sortJ]
                rowCtrlIndices[sortJ] = tmp
            ENDIF
        NEXT
    NEXT
    DIM numRowCtrls AS INTEGER = Len(rowCtrlIndices)

    ' Check if drag/resize outline intersects this row
    DIM outlineOnRow AS BOOLEAN = FALSE
    DIM outlineY1 AS INTEGER = 0
    DIM outlineY2 AS INTEGER = 0
    DIM outlineX1 AS INTEGER = 0
    DIM outlineX2 AS INTEGER = 0
    DIM showControlOutline AS BOOLEAN = ((m.IsDragging OR m.IsResizing) AND m.SelectedCtrlIdx >= 0 AND NOT m.ResizingForm AND NOT m.DraggingForm) OR (m.DraggingFromWidgets AND m.DragOutlineX >= 0)
    IF showControlOutline THEN
        outlineY1 = m.DragOutlineY
        outlineY2 = m.DragOutlineY + m.DragCtrlHeight - 1
        outlineX1 = m.DragOutlineX
        outlineX2 = m.DragOutlineX + m.DragCtrlWidth - 1
        IF contentRow >= outlineY1 AND contentRow <= outlineY2 THEN
            outlineOnRow = TRUE
        ENDIF
    ENDIF

    ' Build row content - use chunks for better performance
    DIM gridChunk AS STRING = ""
    DIM canvasChunk AS STRING = ""
    DIM formCol AS INTEGER
    DIM formCh AS STRING

    ' Content area is formW - 2 (minus left and right borders)
    FOR formCol = 0 TO formW - 3
        formCh = " "

        ' Show grid dots
        IF m.ShowGrid AND contentRow MOD 2 = 0 AND formCol MOD 4 = 0 THEN
            formCh = "."
        ENDIF

        ' Check for drag outline first (drawn on top)
        DIM isOutline AS BOOLEAN = FALSE
        IF outlineOnRow AND formCol >= outlineX1 AND formCol <= outlineX2 THEN
            ' Check if on outline border
            DIM onTopBottom AS BOOLEAN = (contentRow = outlineY1 OR contentRow = outlineY2)
            DIM onLeftRight AS BOOLEAN = (formCol = outlineX1 OR formCol = outlineX2)
            IF onTopBottom OR onLeftRight THEN
                ' Flush pending chunks
                IF Len(canvasChunk) > 0 THEN
                    content = content & formCanvasStyle.Render(canvasChunk)
                    canvasChunk = ""
                ENDIF
                IF Len(gridChunk) > 0 THEN
                    content = content & formCanvasStyle.Render(gridChunk)
                    gridChunk = ""
                ENDIF
                ' Draw outline character
                DIM outlineCh AS STRING = "+"
                IF onTopBottom AND NOT onLeftRight THEN
                    outlineCh = "-"
                ELSEIF onLeftRight AND NOT onTopBottom THEN
                    outlineCh = "|"
                ENDIF
                content = content & styleControlSelected.Render(outlineCh)
                isOutline = TRUE
            ENDIF
        ENDIF

        IF NOT isOutline THEN
            ' Check only controls that intersect this row
            DIM foundCtrl AS BOOLEAN = FALSE
            DIM j AS INTEGER
            FOR j = 0 TO numRowCtrls - 1
                DIM ctrlIdx AS INTEGER = rowCtrlIndices[j]
                ' Skip the dragged/resized control - it's represented by outline
                DIM skipCtrl AS BOOLEAN = ((m.IsDragging OR m.IsResizing) AND ctrlIdx = m.SelectedCtrlIdx AND NOT m.DraggingForm)
                IF NOT skipCtrl THEN
                    DIM ctrl AS VDBControl = form.Controls[ctrlIdx]
                    IF formCol >= ctrl.X AND formCol < ctrl.X + ctrl.Width THEN
                        ' Flush any pending canvas/grid content
                        IF Len(canvasChunk) > 0 THEN
                            content = content & formCanvasStyle.Render(canvasChunk)
                            canvasChunk = ""
                        ENDIF
                        IF Len(gridChunk) > 0 THEN
                            content = content & formCanvasStyle.Render(gridChunk)
                            gridChunk = ""
                        ENDIF

                        DIM localRow AS INTEGER = contentRow - ctrl.Y
                        DIM localCol AS INTEGER = formCol - ctrl.X
                        DIM isSelected AS BOOLEAN = (ctrlIdx = m.SelectedCtrlIdx)

                        ' Check for selection handles (corners and edges)
                        IF isSelected THEN
                            DIM isCorner AS BOOLEAN = (localRow = 0 OR localRow = ctrl.Height - 1) AND (localCol = 0 OR localCol = ctrl.Width - 1)
                            DIM centerCol AS INTEGER = ctrl.Width / 2
                            DIM centerRow AS INTEGER = ctrl.Height / 2
                            DIM isTopEdge AS BOOLEAN = (localRow = 0 AND localCol = centerCol AND ctrl.Width >= 3)
                            DIM isBottomEdge AS BOOLEAN = (localRow = ctrl.Height - 1 AND localCol = centerCol AND ctrl.Width >= 3)
                            DIM isLeftEdge AS BOOLEAN = (localCol = 0 AND localRow = centerRow AND ctrl.Height >= 3)
                            DIM isRightEdge AS BOOLEAN = (localCol = ctrl.Width - 1 AND localRow = centerRow AND ctrl.Height >= 3)

                            IF isCorner OR isTopEdge OR isBottomEdge OR isLeftEdge OR isRightEdge THEN
                                content = content & styleControlSelected.Render("■")
                                foundCtrl = TRUE
                                EXIT FOR
                            ENDIF
                        ENDIF

                        formCh = RenderControlChar(ctrl, localRow, localCol, isSelected)
                        IF isSelected THEN
                            content = content & styleControlSelected.Render(formCh)
                        ELSE
                            ' Use the control's actual ForeColor and BackColor
                            DIM ctrlStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(ctrl.ForeColor))).Background(lipgloss.Color(Str(ctrl.BackColor)))
                            content = content & ctrlStyle.Render(formCh)
                        ENDIF
                        foundCtrl = TRUE
                        EXIT FOR
                    ENDIF
                ENDIF
            NEXT

            IF NOT foundCtrl THEN
                ' Batch similar characters together
                IF m.ShowGrid AND formCh = "." THEN
                    IF Len(canvasChunk) > 0 THEN
                        content = content & formCanvasStyle.Render(canvasChunk)
                        canvasChunk = ""
                    ENDIF
                    gridChunk = gridChunk & formCh
                ELSE
                    IF Len(gridChunk) > 0 THEN
                        content = content & formCanvasStyle.Render(gridChunk)
                        gridChunk = ""
                    ENDIF
                    canvasChunk = canvasChunk & formCh
                ENDIF
            ENDIF
        ENDIF
    NEXT

    ' Flush remaining chunks
    IF Len(canvasChunk) > 0 THEN
        content = content & formCanvasStyle.Render(canvasChunk)
    ENDIF
    IF Len(gridChunk) > 0 THEN
        content = content & formCanvasStyle.Render(gridChunk)
    ENDIF

    ' Right border (with handle at center row if selected)
    DIM isRightHandle AS BOOLEAN = (formSelected AND formRow = centerRow AND formH >= 3)
    IF isRightHandle THEN
        content = content & styleControlSelected.Render("■")
    ELSEIF formSelected THEN
        content = content & styleControlSelected.Render("│")
    ELSE
        content = content & formBorderStyle.Render("│")
    ENDIF

    ' Fill rest of row with canvas (after form)
    DIM remainW3 AS INTEGER = width - formX - formW
    IF remainW3 > 0 THEN
        content = content & styleFormCanvas.Render(RepeatStr(" ", remainW3))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderFormCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleFormCanvas.Render(" ")
    ENDIF

    DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
    DIM formSelected AS BOOLEAN = (m.SelectedCtrlIdx < 0 AND m.FocusArea = FOCUS_FORM)

    ' Create dynamic styles using the form's actual colors
    DIM formBorderStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(form.ForeColor))).Background(lipgloss.Color(Str(form.BackColor)))
    DIM formCanvasStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(Str(form.BackColor)))

    ' Form position and dimensions (with drag/resize preview)
    DIM formX AS INTEGER = form.X
    DIM formY AS INTEGER = form.Y
    DIM formW AS INTEGER = form.Width
    DIM formH AS INTEGER = form.Height
    IF m.IsDragging AND m.DraggingForm THEN
        formX = m.DragOutlineX
        formY = m.DragOutlineY
    ENDIF
    IF m.IsResizing AND m.ResizingForm THEN
        formW = m.DragCtrlWidth
        formH = m.DragCtrlHeight
    ENDIF
    DIM centerCol AS INTEGER = formW / 2
    DIM centerRow AS INTEGER = formH / 2

    ' Outside form bounds - just canvas
    IF col < formX OR col >= formX + formW OR row < formY OR row >= formY + formH THEN
        RETURN styleFormCanvas.Render(" ")
    ENDIF

    ' Coordinates relative to form
    DIM relCol AS INTEGER = col - formX
    DIM relRow AS INTEGER = row - formY

    ' Row 0 of form: Title bar
    IF relRow = 0 THEN
        DIM titleText AS STRING = " " & form.Caption & " "
        DIM titleCh AS STRING = "─"
        DIM isTopHandle AS BOOLEAN = FALSE
        IF relCol = 0 THEN
            titleCh = "┌"
            isTopHandle = formSelected
        ELSEIF relCol = formW - 1 THEN
            titleCh = "┐"
            isTopHandle = formSelected
        ELSEIF relCol = centerCol AND formW >= 3 AND formSelected THEN
            isTopHandle = TRUE
        ELSEIF relCol >= 1 AND relCol <= Len(titleText) THEN
            titleCh = Mid(titleText, relCol, 1)
        ENDIF
        IF isTopHandle THEN
            RETURN styleControlSelected.Render("■")
        ELSEIF formSelected THEN
            RETURN styleControlSelected.Render(titleCh)
        ELSE
            RETURN formBorderStyle.Render(titleCh)
        ENDIF
    ENDIF

    ' Bottom border row of form
    IF relRow = formH - 1 THEN
        DIM bottomCh AS STRING = "─"
        DIM isBottomHandle AS BOOLEAN = FALSE
        IF relCol = 0 THEN
            bottomCh = "└"
            isBottomHandle = formSelected
        ELSEIF relCol = formW - 1 THEN
            bottomCh = "┘"
            isBottomHandle = formSelected
        ELSEIF relCol = centerCol AND formW >= 3 AND formSelected THEN
            isBottomHandle = TRUE
        ENDIF
        IF isBottomHandle THEN
            RETURN styleControlSelected.Render("■")
        ELSEIF formSelected THEN
            RETURN styleControlSelected.Render(bottomCh)
        ELSE
            RETURN formBorderStyle.Render(bottomCh)
        ENDIF
    ENDIF

    ' Left and right borders
    IF relCol = 0 OR relCol = formW - 1 THEN
        DIM isSideHandle AS BOOLEAN = (formSelected AND relRow = centerRow AND formH >= 3)
        IF isSideHandle THEN
            RETURN styleControlSelected.Render("■")
        ELSEIF formSelected THEN
            RETURN styleControlSelected.Render("│")
        ELSE
            RETURN formBorderStyle.Render("│")
        ENDIF
    ENDIF

    ' Form content area (relative to form interior)
    DIM contentRow AS INTEGER = relRow - 1
    DIM contentCol AS INTEGER = relCol - 1
    DIM ch AS STRING = " "

    IF m.ShowGrid AND contentRow MOD 2 = 0 AND contentCol MOD 4 = 0 THEN
        ch = "."
    ENDIF

    DIM i AS INTEGER
    FOR i = 0 TO Len(form.Controls) - 1
        DIM ctrl AS VDBControl = form.Controls[i]
        IF contentRow >= ctrl.Y AND contentRow < ctrl.Y + ctrl.Height AND contentCol >= ctrl.X AND contentCol < ctrl.X + ctrl.Width THEN
            DIM localRow AS INTEGER = contentRow - ctrl.Y
            DIM localCol AS INTEGER = contentCol - ctrl.X
            DIM isSelected AS BOOLEAN = (i = m.SelectedCtrlIdx)

            ' Check for selection handles (corners and edges)
            IF isSelected THEN
                DIM isCorner AS BOOLEAN = (localRow = 0 OR localRow = ctrl.Height - 1) AND (localCol = 0 OR localCol = ctrl.Width - 1)
                DIM ctrlCenterCol AS INTEGER = ctrl.Width / 2
                DIM ctrlCenterRow AS INTEGER = ctrl.Height / 2
                DIM isTopEdge AS BOOLEAN = (localRow = 0 AND localCol = ctrlCenterCol AND ctrl.Width >= 3)
                DIM isBottomEdge AS BOOLEAN = (localRow = ctrl.Height - 1 AND localCol = ctrlCenterCol AND ctrl.Width >= 3)
                DIM isLeftEdge AS BOOLEAN = (localCol = 0 AND localRow = ctrlCenterRow AND ctrl.Height >= 3)
                DIM isRightEdge AS BOOLEAN = (localCol = ctrl.Width - 1 AND localRow = ctrlCenterRow AND ctrl.Height >= 3)

                IF isCorner OR isTopEdge OR isBottomEdge OR isLeftEdge OR isRightEdge THEN
                    RETURN styleControlSelected.Render("■")
                ENDIF
            ENDIF

            ch = RenderControlChar(ctrl, localRow, localCol, isSelected)
            IF isSelected THEN
                RETURN styleControlSelected.Render(ch)
            ELSE
                ' Use the control's actual ForeColor and BackColor
                DIM ctrlStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color(Str(ctrl.ForeColor))).Background(lipgloss.Color(Str(ctrl.BackColor)))
                RETURN ctrlStyle.Render(ch)
            ENDIF
        ENDIF
    NEXT

    IF m.ShowGrid AND ch = "." THEN
        RETURN formCanvasStyle.Render(ch)
    ENDIF
    RETURN formCanvasStyle.Render(ch)
END FUNCTION

' Render a single character of a control
FUNCTION RenderControlChar(ctrl AS VDBControl, localRow AS INTEGER, localCol AS INTEGER, selected AS BOOLEAN) AS STRING
    IF ctrl.CtlType = CTRL_BUTTON THEN
        ' Button with border
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "["
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "]"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "["
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "]"
            ELSE
                RETURN " "
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "|"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LABEL THEN
        DIM labelLen AS INTEGER = Len(ctrl.Caption)
        DIM textStart AS INTEGER = 0
        IF ctrl.Justification = JUSTIFY_CENTER THEN
            textStart = (ctrl.Width - labelLen) / 2
        ELSEIF ctrl.Justification = JUSTIFY_RIGHT THEN
            textStart = ctrl.Width - labelLen
        ENDIF
        DIM textCol AS INTEGER = localCol - textStart
        IF textCol >= 0 AND textCol < labelLen THEN
            RETURN Mid(ctrl.Caption, textCol + 1, 1)
        ENDIF
        RETURN " "
    ELSEIF ctrl.CtlType = CTRL_TEXTBOX THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = ctrl.Width - 1 THEN
            RETURN "]"
        ELSEIF localCol - 1 < Len(ctrl.Value) THEN
            RETURN Mid(ctrl.Value, localCol, 1)
        ELSE
            RETURN "_"
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_CHECKBOX THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = 1 THEN
            IF ctrl.Value = "1" THEN
                RETURN "X"
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localCol = 2 THEN
            RETURN "]"
        ELSEIF localCol = 3 THEN
            RETURN " "
        ELSEIF localCol - 4 < Len(ctrl.Caption) THEN
            RETURN Mid(ctrl.Caption, localCol - 3, 1)
        ELSE
            RETURN " "
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_OPTION THEN
        IF localCol = 0 THEN
            RETURN "("
        ELSEIF localCol = 1 THEN
            IF ctrl.Value = "1" THEN
                RETURN "o"
            ELSE
                RETURN " "
            ENDIF
        ELSEIF localCol = 2 THEN
            RETURN ")"
        ELSEIF localCol = 3 THEN
            RETURN " "
        ELSEIF localCol - 4 < Len(ctrl.Caption) THEN
            RETURN Mid(ctrl.Caption, localCol - 3, 1)
        ELSE
            RETURN " "
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_LISTBOX THEN
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FRAME THEN
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSEIF localCol <= Len(ctrl.Caption) THEN
                RETURN Mid(ctrl.Caption, localCol, 1)
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_TIMER THEN
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = 1 THEN
            RETURN "T"
        ELSEIF localCol = 2 THEN
            RETURN "]"
        ENDIF
        RETURN " "
    ELSEIF ctrl.CtlType = CTRL_TEXTAREA THEN
        ' Multi-line text area with border
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PROGRESS THEN
        ' Progress bar [=====>    ]
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = ctrl.Width - 1 THEN
            RETURN "]"
        ELSE
            DIM progressVal AS INTEGER = ParseIntStr(ctrl.Value)
            DIM total AS INTEGER = ctrl.Total
            IF total <= 0 THEN
                total = 100
            ENDIF
            DIM innerWidth AS INTEGER = ctrl.Width - 2
            DIM filled AS INTEGER = (progressVal * innerWidth) / total
            DIM innerCol AS INTEGER = localCol - 1
            IF innerCol < filled THEN
                RETURN "="
            ELSEIF innerCol = filled AND progressVal < total THEN
                RETURN ">"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_SPINNER THEN
        ' Spinner [*]
        IF localCol = 0 THEN
            RETURN "["
        ELSEIF localCol = 1 THEN
            RETURN "*"
        ELSEIF localCol = 2 THEN
            RETURN "]"
        ENDIF
        RETURN " "
    ELSEIF ctrl.CtlType = CTRL_TABLE THEN
        ' Table with borders
        IF localRow = 0 THEN
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = ctrl.Height - 1 THEN
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = ctrl.Width - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = 1 AND ctrl.ShowHeaders THEN
            ' Header row
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN "═"
            ENDIF
        ELSE
            IF localCol = 0 OR localCol = ctrl.Width - 1 THEN
                RETURN "│"
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRBROWSER THEN
        ' DirBrowser layout:
        ' Row 0: ┌─────────────────────────────┐
        ' Row 1: │ /current/path               │  <- Path text input
        ' Row 2: ├─────────────────────────────┤
        ' Row 3: │ > ..                        │  <- Parent dir
        ' Row 4: │   subdirectory/             │
        ' Row 5: │   another_dir/              │
        ' ...
        ' Row H-1: └─────────────────────────────┘

        DIM dbW AS INTEGER = ctrl.Width
        DIM dbH AS INTEGER = ctrl.Height

        IF localRow = 0 THEN
            ' Top border
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = dbW - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = 1 THEN
            ' Path text area
            IF localCol = 0 OR localCol = dbW - 1 THEN
                RETURN "│"
            ELSE
                DIM dbPathText AS STRING = ctrl.FilePath
                IF localCol - 1 < Len(dbPathText) THEN
                    RETURN Mid(dbPathText, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ENDIF
        ELSEIF localRow = 2 THEN
            ' Separator
            IF localCol = 0 THEN
                RETURN "├"
            ELSEIF localCol = dbW - 1 THEN
                RETURN "┤"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = dbH - 1 THEN
            ' Bottom border
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = dbW - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            ' Directory list area
            IF localCol = 0 OR localCol = dbW - 1 THEN
                RETURN "│"
            ELSEIF localRow = 3 THEN
                ' Parent dir entry
                DIM dbParentLine AS STRING = " > .."
                IF localCol - 1 < Len(dbParentLine) THEN
                    RETURN Mid(dbParentLine, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 4 THEN
                ' Sample dir entry
                DIM dbDirLine AS STRING = "   subdir/"
                IF localCol - 1 < Len(dbDirLine) THEN
                    RETURN Mid(dbDirLine, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 5 THEN
                ' Sample dir entry
                DIM dbDir2Line AS STRING = "   another/"
                IF localCol - 1 < Len(dbDir2Line) THEN
                    RETURN Mid(dbDir2Line, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_PATH THEN
        ' Path widget: single-row text input with border
        ' ┌──────────────┐
        ' │ /path/here   │
        ' └──────────────┘
        DIM pathW AS INTEGER = ctrl.Width

        IF localRow = 0 THEN
            ' Top border
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = pathW - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = 1 THEN
            ' Path text
            IF localCol = 0 OR localCol = pathW - 1 THEN
                RETURN "│"
            ELSE
                DIM pathText AS STRING = ctrl.FilePath
                IF pathText = "" THEN
                    pathText = "/home/user"
                ENDIF
                IF localCol - 1 < Len(pathText) THEN
                    RETURN Mid(pathText, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ENDIF
        ELSEIF localRow = 2 THEN
            ' Bottom border
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = pathW - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_DIRECTORIES THEN
        ' Directories widget: bordered list of directories
        ' ┌──────────────┐
        ' │ > ..         │
        ' │   subdir/    │
        ' │   another/   │
        ' └──────────────┘
        DIM dirW AS INTEGER = ctrl.Width
        DIM dirH AS INTEGER = ctrl.Height

        IF localRow = 0 THEN
            ' Top border
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = dirW - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = dirH - 1 THEN
            ' Bottom border
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = dirW - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            ' Directory list area
            IF localCol = 0 OR localCol = dirW - 1 THEN
                RETURN "│"
            ELSEIF localRow = 1 THEN
                ' Parent dir entry
                DIM parentLine AS STRING = " > .."
                IF localCol - 1 < Len(parentLine) THEN
                    RETURN Mid(parentLine, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 2 THEN
                ' Sample dir entry
                DIM dirLine AS STRING = "   subdir/"
                IF localCol - 1 < Len(dirLine) THEN
                    RETURN Mid(dirLine, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 3 THEN
                ' Another sample
                DIM dir2Line AS STRING = "   another/"
                IF localCol - 1 < Len(dir2Line) THEN
                    RETURN Mid(dir2Line, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ELSEIF ctrl.CtlType = CTRL_FILES THEN
        ' Files widget: bordered list of files
        ' ┌──────────────┐
        ' │ > file1.txt  │
        ' │   file2.go   │
        ' │   image.png  │
        ' └──────────────┘
        DIM fileW AS INTEGER = ctrl.Width
        DIM fileH AS INTEGER = ctrl.Height

        IF localRow = 0 THEN
            ' Top border
            IF localCol = 0 THEN
                RETURN "┌"
            ELSEIF localCol = fileW - 1 THEN
                RETURN "┐"
            ELSE
                RETURN "─"
            ENDIF
        ELSEIF localRow = fileH - 1 THEN
            ' Bottom border
            IF localCol = 0 THEN
                RETURN "└"
            ELSEIF localCol = fileW - 1 THEN
                RETURN "┘"
            ELSE
                RETURN "─"
            ENDIF
        ELSE
            ' File list area
            IF localCol = 0 OR localCol = fileW - 1 THEN
                RETURN "│"
            ELSEIF localRow = 1 THEN
                ' First file entry
                DIM file1Line AS STRING = " > file1.txt"
                IF localCol - 1 < Len(file1Line) THEN
                    RETURN Mid(file1Line, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 2 THEN
                ' Second file entry
                DIM file2Line AS STRING = "   file2.go"
                IF localCol - 1 < Len(file2Line) THEN
                    RETURN Mid(file2Line, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSEIF localRow = 3 THEN
                ' Third file entry
                DIM file3Line AS STRING = "   image.png"
                IF localCol - 1 < Len(file3Line) THEN
                    RETURN Mid(file3Line, localCol, 1)
                ELSE
                    RETURN " "
                ENDIF
            ELSE
                RETURN " "
            ENDIF
        ENDIF
    ENDIF

    RETURN " "
END FUNCTION

' Code editor rendering
' Render a single line of code with syntax highlighting
FUNCTION RenderHighlightedLine(lineText AS STRING, width AS INTEGER, cursorCol AS INTEGER, showCursor AS BOOLEAN) AS STRING
    DIM result AS STRING = ""
    DIM lineLen AS INTEGER = Len(lineText)

    ' Tokenize the line for syntax highlighting
    DIM tokens AS []SyntaxToken = TokenizeLine(lineText)

    ' Render character by character with appropriate styling
    DIM col AS INTEGER
    FOR col = 0 TO width - 1
        DIM ch AS STRING = " "
        IF col < lineLen THEN
            ch = Mid(lineText, col + 1, 1)
        ENDIF

        ' Check if this is cursor position
        IF showCursor AND col = cursorCol THEN
            result = result & styleCodeCursor.Render(ch)
        ELSE
            ' Get token type for this column
            DIM tokType AS INTEGER = GetTokenTypeForColumn(tokens, col)
            IF tokType = TOKEN_KEYWORD THEN
                result = result & styleCodeKeyword.Render(ch)
            ELSEIF tokType = TOKEN_TYPE THEN
                result = result & styleCodeKeyword.Render(ch)
            ELSEIF tokType = TOKEN_STRING THEN
                result = result & styleCodeString.Render(ch)
            ELSEIF tokType = TOKEN_COMMENT THEN
                result = result & styleCodeComment.Render(ch)
            ELSEIF tokType = TOKEN_NUMBER THEN
                result = result & styleCodeNumber.Render(ch)
            ELSE
                result = result & styleCodeEditor.Render(ch)
            ENDIF
        ENDIF
    NEXT

    RETURN result
END FUNCTION

FUNCTION RenderCodeRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        content = styleCodeEditor.Render(PadRight(" No code loaded", width))
        RETURN content
    ENDIF

    ' Get code from form (or from textarea if initialized)
    DIM code AS STRING
    IF m.CodeEditorInited THEN
        code = GetEditorCode(m.CodeEditor)
    ELSE
        code = m.Project.Forms[m.CurrentFormIdx].Code
    ENDIF

    DIM totalLines AS INTEGER = CountLines(code)

    ' Get cursor position from textarea
    DIM cursorLine AS INTEGER = 0
    DIM cursorCol AS INTEGER = 0
    IF m.CodeEditorInited THEN
        cursorLine = GetEditorCursorLine(m.CodeEditor)
        cursorCol = GetEditorCursorCol(m.CodeEditor)
    ELSE
        cursorLine = m.CodeCursorY
        cursorCol = m.CodeCursorX
    ENDIF

    ' Calculate scroll position to keep cursor visible
    ' Use row as the display line, calculate what code line it represents
    DIM contentHeight AS INTEGER = m.Height - 4  ' approximate visible rows
    DIM scrollY AS INTEGER = 0
    IF cursorLine >= contentHeight THEN
        scrollY = cursorLine - contentHeight + 1
    ENDIF
    ' For now, use simple scrolling: row maps to code line
    ' More sophisticated scrolling can keep cursor centered
    DIM lineIdx AS INTEGER = row

    ' Adjust for scroll if cursor would be off screen
    IF cursorLine >= contentHeight THEN
        lineIdx = scrollY + row
    ENDIF

    ' Line number column
    DIM lineNumWidth AS INTEGER = 0
    IF m.ShowLineNumbers THEN
        lineNumWidth = 5
        IF lineIdx < totalLines THEN
            content = content & styleCodeLineNum.Render(fmt.Sprintf("%4d ", lineIdx + 1))
        ELSE
            content = content & styleCodeLineNum.Render("     ")
        ENDIF
        width = width - lineNumWidth
    ENDIF

    ' Empty line beyond code
    IF lineIdx >= totalLines THEN
        content = content & styleCodeEditor.Render(RepeatStr(" ", width))
        RETURN content
    ENDIF

    ' Get the line text
    DIM lineText AS STRING = GetLine(code, lineIdx + 1)

    ' Determine if cursor is on this line
    DIM showCursor AS BOOLEAN = (lineIdx = cursorLine AND m.FocusArea = FOCUS_CODE)

    ' Render with syntax highlighting
    IF m.SyntaxHighlight THEN
        content = content & RenderHighlightedLine(lineText, width, cursorCol, showCursor)
    ELSE
        ' No syntax highlighting - just render plain text with cursor
        DIM col AS INTEGER
        FOR col = 0 TO width - 1
            DIM ch AS STRING = " "
            IF col < Len(lineText) THEN
                ch = Mid(lineText, col + 1, 1)
            ENDIF
            IF showCursor AND col = cursorCol THEN
                content = content & styleCodeCursor.Render(ch)
            ELSE
                content = content & styleCodeEditor.Render(ch)
            ENDIF
        NEXT
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderCodeCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleCodeEditor.Render(" ")
    ENDIF

    ' Get code from form (or from textarea if initialized)
    DIM code AS STRING
    IF m.CodeEditorInited THEN
        code = GetEditorCode(m.CodeEditor)
    ELSE
        code = m.Project.Forms[m.CurrentFormIdx].Code
    ENDIF

    DIM totalLines AS INTEGER = CountLines(code)

    ' Get cursor position from textarea
    DIM cursorLine AS INTEGER = 0
    DIM cursorCol AS INTEGER = 0
    IF m.CodeEditorInited THEN
        cursorLine = GetEditorCursorLine(m.CodeEditor)
        cursorCol = GetEditorCursorCol(m.CodeEditor)
    ELSE
        cursorLine = m.CodeCursorY
        cursorCol = m.CodeCursorX
    ENDIF

    ' Account for line numbers
    DIM lineNumWidth AS INTEGER = 0
    IF m.ShowLineNumbers THEN
        lineNumWidth = 5
    ENDIF

    DIM lineIdx AS INTEGER = row

    ' Handle line number column
    IF m.ShowLineNumbers AND col < lineNumWidth THEN
        IF lineIdx < totalLines THEN
            DIM lineNumStr AS STRING = fmt.Sprintf("%4d ", lineIdx + 1)
            IF col < Len(lineNumStr) THEN
                RETURN styleCodeLineNum.Render(Mid(lineNumStr, col + 1, 1))
            ENDIF
        ENDIF
        RETURN styleCodeLineNum.Render(" ")
    ENDIF

    ' Adjust column for line number offset
    DIM codeCol AS INTEGER = col - lineNumWidth

    IF lineIdx >= totalLines THEN
        RETURN styleCodeEditor.Render(" ")
    ENDIF

    DIM lineText AS STRING = GetLine(code, lineIdx + 1)
    DIM ch AS STRING = " "

    IF codeCol < Len(lineText) THEN
        ch = Mid(lineText, codeCol + 1, 1)
    ENDIF

    ' Cursor takes priority
    IF lineIdx = cursorLine AND codeCol = cursorCol AND m.FocusArea = FOCUS_CODE THEN
        RETURN styleCodeCursor.Render(ch)
    ENDIF

    ' Apply syntax highlighting
    IF m.SyntaxHighlight THEN
        DIM tokens AS []SyntaxToken = TokenizeLine(lineText)
        DIM tokType AS INTEGER = GetTokenTypeForColumn(tokens, codeCol)
        IF tokType = TOKEN_KEYWORD OR tokType = TOKEN_TYPE THEN
            RETURN styleCodeKeyword.Render(ch)
        ELSEIF tokType = TOKEN_STRING THEN
            RETURN styleCodeString.Render(ch)
        ELSEIF tokType = TOKEN_COMMENT THEN
            RETURN styleCodeComment.Render(ch)
        ELSEIF tokType = TOKEN_NUMBER THEN
            RETURN styleCodeNumber.Render(ch)
        ENDIF
    ENDIF

    RETURN styleCodeEditor.Render(ch)
END FUNCTION

' Project tree rendering
FUNCTION RenderProjectRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - always highlighted blue, centered with symbol
        content = stylePanelTitle.Render(PadCenter("= Project", width))
        RETURN content
    ENDIF

    DIM itemIdx AS INTEGER = row - 1 + m.ProjectScroll
    DIM totalItems AS INTEGER = GetTreeItemCount(m)

    IF itemIdx < totalItems AND m.ProjectLoaded THEN
        DIM itemText AS STRING = ""
        DIM itemType AS INTEGER
        DIM formIdx AS INTEGER
        DIM ctrlIdx AS INTEGER
        itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

        IF itemType = 0 THEN
            ' Project name
            itemText = "+ " & m.Project.Name
        ELSEIF itemType = 1 THEN
            ' Form - show +/- based on expansion state
            DIM expanded AS BOOLEAN = FALSE
            IF formIdx < Len(m.TreeExpanded) THEN
                expanded = m.TreeExpanded[formIdx]
            ENDIF
            DIM expandChar AS STRING = "+"
            IF expanded THEN
                expandChar = "-"
            ENDIF
            DIM formMarker AS STRING = " "
            IF formIdx = m.CurrentFormIdx THEN
                formMarker = ">"
            ENDIF
            itemText = " " & expandChar & formMarker & m.Project.Forms[formIdx].Name & ".frm"
        ELSEIF itemType = 2 THEN
            ' Control under a form
            DIM ctrl AS VDBControl = m.Project.Forms[formIdx].Controls[ctrlIdx]
            DIM ctrlMarker AS STRING = " "
            IF formIdx = m.CurrentFormIdx AND ctrlIdx = m.SelectedCtrlIdx THEN
                ctrlMarker = ">"
            ENDIF
            itemText = "   " & ctrlMarker & ctrl.CtlName
        ELSEIF itemType = 3 THEN
            ' Module
            itemText = "    " & m.Project.Modules[formIdx].Name & ".bas"
        ENDIF

        itemText = PadRight(itemText, width)
        IF itemIdx = m.TreeIndex AND m.FocusArea = FOCUS_PROJECT THEN
            content = styleTreeSelected.Render(itemText)
        ELSE
            content = styleTreeItem.Render(itemText)
        ENDIF
    ELSE
        content = styleProjectTree.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderProjectCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "
    DIM selected AS BOOLEAN = FALSE
    DIM isTreeItem AS BOOLEAN = FALSE

    IF row = 0 THEN
        ' Title row - always highlighted blue, centered with symbol
        DIM title AS STRING = PadCenter("= Project", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN stylePanelTitle.Render(ch)
    ELSE
        DIM itemIdx AS INTEGER = row - 1 + m.ProjectScroll
        DIM totalItems AS INTEGER = GetTreeItemCount(m)

        IF itemIdx < totalItems AND m.ProjectLoaded THEN
            DIM itemText AS STRING = ""
            DIM itemType AS INTEGER
            DIM formIdx AS INTEGER
            DIM ctrlIdx AS INTEGER
            itemType, formIdx, ctrlIdx = GetTreeItemInfo(m, itemIdx)

            IF itemType = 0 THEN
                itemText = "+ " & m.Project.Name
            ELSEIF itemType = 1 THEN
                DIM expanded AS BOOLEAN = FALSE
                IF formIdx < Len(m.TreeExpanded) THEN
                    expanded = m.TreeExpanded[formIdx]
                ENDIF
                DIM expandChar AS STRING = "+"
                IF expanded THEN
                    expandChar = "-"
                ENDIF
                DIM formMarker AS STRING = " "
                IF formIdx = m.CurrentFormIdx THEN
                    formMarker = ">"
                ENDIF
                itemText = " " & expandChar & formMarker & m.Project.Forms[formIdx].Name & ".frm"
            ELSEIF itemType = 2 THEN
                DIM ctrl AS VDBControl = m.Project.Forms[formIdx].Controls[ctrlIdx]
                DIM ctrlMarker AS STRING = " "
                IF formIdx = m.CurrentFormIdx AND ctrlIdx = m.SelectedCtrlIdx THEN
                    ctrlMarker = ">"
                ENDIF
                itemText = "   " & ctrlMarker & ctrl.CtlName
            ELSEIF itemType = 3 THEN
                itemText = "    " & m.Project.Modules[formIdx].Name & ".bas"
            ENDIF

            itemText = PadRight(itemText, width)
            IF col < Len(itemText) THEN
                ch = Mid(itemText, col + 1, 1)
            ENDIF
            selected = (itemIdx = m.TreeIndex AND m.FocusArea = FOCUS_PROJECT)
            isTreeItem = TRUE
        ENDIF
    ENDIF

    IF selected THEN
        RETURN styleTreeSelected.Render(ch)
    ELSEIF isTreeItem THEN
        RETURN styleTreeItem.Render(ch)
    ELSE
        RETURN styleProjectTree.Render(ch)
    ENDIF
END FUNCTION

' Properties panel rendering
FUNCTION RenderPropertiesRow(m AS VDBTermModel, row AS INTEGER, width AS INTEGER) AS STRING
    DIM content AS STRING = ""

    IF row = 0 THEN
        ' Title - always highlighted blue, centered with symbol
        content = stylePanelTitle.Render(PadCenter("= Properties", width))
        RETURN content
    ENDIF

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        content = styleProperties.Render(RepeatStr(" ", width))
        RETURN content
    ENDIF

    ' Show properties of selected control or form
    DIM propIdx AS INTEGER = row - 1
    DIM propName AS STRING = ""
    DIM propValue AS STRING = ""

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        propName = GetControlPropertyName(ctrl, propIdx)
        propValue = GetControlPropertyValue(ctrl, propIdx)
    ELSE
        ' Form properties
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = form.Name
        ELSEIF propIdx = 1 THEN
            propName = "Caption"
            propValue = form.Caption
        ELSEIF propIdx = 2 THEN
            propName = "X"
            propValue = Str(form.X)
        ELSEIF propIdx = 3 THEN
            propName = "Y"
            propValue = Str(form.Y)
        ELSEIF propIdx = 4 THEN
            propName = "Width"
            propValue = Str(form.Width)
        ELSEIF propIdx = 5 THEN
            propName = "Height"
            propValue = Str(form.Height)
        ELSEIF propIdx = 6 THEN
            propName = "ForeColor"
            propValue = Str(form.ForeColor)
        ELSEIF propIdx = 7 THEN
            propName = "BackColor"
            propValue = Str(form.BackColor)
        ENDIF
    ENDIF

    IF Len(propName) > 0 THEN
        DIM half AS INTEGER = width / 2
        DIM displayValue AS STRING = propValue

        ' Show edit value when editing this property
        IF propIdx = m.PropIndex AND m.PropEditing AND m.FocusArea = FOCUS_PROPERTIES THEN
            displayValue = m.PropEditValue & "_"
        ENDIF

        DIM line AS STRING = PadRight(propName, half) & PadRight(displayValue, width - half)
        IF propIdx = m.PropIndex AND m.FocusArea = FOCUS_PROPERTIES THEN
            IF m.PropEditing THEN
                ' Highlight edit mode differently
                content = stylePropName.Render(PadRight(propName, half)) & styleCodeCursor.Render(PadRight(displayValue, width - half))
            ELSE
                content = stylePropSelected.Render(line)
            ENDIF
        ELSE
            content = stylePropName.Render(PadRight(propName, half)) & stylePropValue.Render(PadRight(propValue, width - half))
        ENDIF
    ELSE
        content = styleProperties.Render(RepeatStr(" ", width))
    ENDIF

    RETURN content
END FUNCTION

FUNCTION RenderPropertiesCell(m AS VDBTermModel, row AS INTEGER, col AS INTEGER, width AS INTEGER) AS STRING
    ' Single cell version for overlay rendering - compute character at position
    DIM ch AS STRING = " "

    IF row = 0 THEN
        ' Title row - always highlighted blue, centered with symbol
        DIM title AS STRING = PadCenter("= Properties", width)
        IF col < Len(title) THEN
            ch = Mid(title, col + 1, 1)
        ENDIF
        RETURN stylePanelTitle.Render(ch)
    ENDIF

    IF NOT m.ProjectLoaded OR m.CurrentFormIdx >= Len(m.Project.Forms) THEN
        RETURN styleProperties.Render(ch)
    ENDIF

    ' Show properties of selected control or form
    DIM propIdx AS INTEGER = row - 1
    DIM propName AS STRING = ""
    DIM propValue AS STRING = ""

    IF m.SelectedCtrlIdx >= 0 AND m.SelectedCtrlIdx < Len(m.Project.Forms[m.CurrentFormIdx].Controls) THEN
        DIM ctrl AS VDBControl = m.Project.Forms[m.CurrentFormIdx].Controls[m.SelectedCtrlIdx]
        propName = GetControlPropertyName(ctrl, propIdx)
        propValue = GetControlPropertyValue(ctrl, propIdx)
    ELSE
        ' Form properties
        DIM form AS VDBForm = m.Project.Forms[m.CurrentFormIdx]
        IF propIdx = 0 THEN
            propName = "Name"
            propValue = form.Name
        ELSEIF propIdx = 1 THEN
            propName = "Caption"
            propValue = form.Caption
        ELSEIF propIdx = 2 THEN
            propName = "X"
            propValue = Str(form.X)
        ELSEIF propIdx = 3 THEN
            propName = "Y"
            propValue = Str(form.Y)
        ELSEIF propIdx = 4 THEN
            propName = "Width"
            propValue = Str(form.Width)
        ELSEIF propIdx = 5 THEN
            propName = "Height"
            propValue = Str(form.Height)
        ELSEIF propIdx = 6 THEN
            propName = "ForeColor"
            propValue = Str(form.ForeColor)
        ELSEIF propIdx = 7 THEN
            propName = "BackColor"
            propValue = Str(form.BackColor)
        ENDIF
    ENDIF

    IF Len(propName) > 0 THEN
        DIM half AS INTEGER = width / 2
        DIM line AS STRING = PadRight(propName, half) & PadRight(propValue, width - half)
        IF col < Len(line) THEN
            ch = Mid(line, col + 1, 1)
        ENDIF
        IF propIdx = m.PropIndex AND m.FocusArea = FOCUS_PROPERTIES THEN
            RETURN stylePropSelected.Render(ch)
        ELSEIF col < half THEN
            RETURN stylePropName.Render(ch)
        ELSE
            RETURN stylePropValue.Render(ch)
        ENDIF
    ENDIF

    RETURN styleProperties.Render(ch)
END FUNCTION

' Menu bar rendering
FUNCTION RenderMenuBar(m AS VDBTermModel) AS STRING
    DIM bar AS STRING = ""

    bar = bar & RenderMenuItemHL("File", 1, m.MenuOpen = MENU_FILE)
    bar = bar & RenderMenuItemHL("Edit", 1, m.MenuOpen = MENU_EDIT)
    bar = bar & RenderMenuItemHL("View", 1, m.MenuOpen = MENU_VIEW)
    bar = bar & RenderMenuItemHL("Run", 1, m.MenuOpen = MENU_RUN)
    bar = bar & RenderMenuItemHL("Debug", 1, m.MenuOpen = MENU_DEBUG)
    bar = bar & RenderMenuItemHL("Options", 1, m.MenuOpen = MENU_OPTIONS)
    bar = bar & RenderMenuItemHL("Help", 1, m.MenuOpen = MENU_HELP)

    DIM used AS INTEGER = 52
    IF m.Width > used THEN
        bar = bar & styleMenuBar.Render(RepeatStr(" ", m.Width - used))
    ENDIF

    RETURN bar
END FUNCTION

FUNCTION RenderMenuItemHL(name AS STRING, hotkeyPos AS INTEGER, selected AS BOOLEAN) AS STRING
    DIM before AS STRING = Left(name, hotkeyPos - 1)
    DIM hotkey AS STRING = Mid(name, hotkeyPos, 1)
    DIM after AS STRING = Mid(name, hotkeyPos + 1, Len(name) - hotkeyPos)

    IF selected THEN
        RETURN styleMenuSelected.Render(" " & before) & styleMenuHotkeySelected.Render(hotkey) & styleMenuSelected.Render(after & " ")
    ELSE
        RETURN styleMenuBar.Render(" " & before) & styleMenuHotkey.Render(hotkey) & styleMenuBar.Render(after & " ")
    ENDIF
END FUNCTION

FUNCTION GetMenuOffset(menu AS INTEGER) AS INTEGER
    IF menu = MENU_FILE THEN
        RETURN 0
    ELSEIF menu = MENU_EDIT THEN
        RETURN 6
    ELSEIF menu = MENU_VIEW THEN
        RETURN 12
    ELSEIF menu = MENU_RUN THEN
        RETURN 18
    ELSEIF menu = MENU_DEBUG THEN
        RETURN 23
    ELSEIF menu = MENU_OPTIONS THEN
        RETURN 30
    ELSEIF menu = MENU_HELP THEN
        RETURN 39
    ENDIF
    RETURN 0
END FUNCTION

FUNCTION GetDropdownLines(m AS VDBTermModel) AS []STRING
    DIM lines AS []STRING
    ' All menu items must be exactly 18 characters to fit in 20-char box (1 border + 18 content + 1 border)

    IF m.MenuOpen = MENU_FILE THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Project       ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Open Project      ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Save Project      ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Save As...        ", 6, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Form          ", 5, m.MenuIndex = 5) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("New Module        ", 5, m.MenuIndex = 6) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Exit        Alt+X ", 2, m.MenuIndex = 8) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_EDIT THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Cut        Ctrl+X ", 3, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Copy       Ctrl+C ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Paste      Ctrl+V ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Select All Ctrl+A ", 8, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Delete            ", 1, m.MenuIndex = 5) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Menu Editor...    ", 1, m.MenuIndex = 7) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_VIEW THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Form View      F7 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Code View      F7 ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Show Grid         ", 6, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Line Numbers      ", 1, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Object Browser F2 ", 1, m.MenuIndex = 6) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_RUN THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Run            F5 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Build             ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Set Startup       ", 5, m.MenuIndex = 3) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_DEBUG THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Step           F8 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Breakpoint     F9 ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Watch             ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Clear All         ", 1, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_OPTIONS THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Environment       ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Editor            ", 2, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Theme Editor      ", 1, m.MenuIndex = 2) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("├──────────────────┤"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Colors            ", 1, m.MenuIndex = 4) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ELSEIF m.MenuOpen = MENU_HELP THEN
        lines = APPEND(lines, styleDropdown.Render("┌──────────────────┐"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("Help           F1 ", 1, m.MenuIndex = 0) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("│") & RenderDropdownItemHL("About             ", 1, m.MenuIndex = 1) & styleDropdown.Render("│"))
        lines = APPEND(lines, styleDropdown.Render("└──────────────────┘"))
    ENDIF

    RETURN lines
END FUNCTION

FUNCTION RenderDropdownItemHL(text AS STRING, hotkeyPos AS INTEGER, selected AS BOOLEAN) AS STRING
    DIM before AS STRING = Left(text, hotkeyPos - 1)
    DIM hotkey AS STRING = Mid(text, hotkeyPos, 1)
    DIM after AS STRING = Mid(text, hotkeyPos + 1, Len(text) - hotkeyPos)

    IF selected THEN
        RETURN styleDropdownSelected.Render(before) & styleDropdownHotkeySelected.Render(hotkey) & styleDropdownSelected.Render(after)
    ELSE
        RETURN styleDropdown.Render(before) & styleDropdownHotkey.Render(hotkey) & styleDropdown.Render(after)
    ENDIF
END FUNCTION

' Status bar rendering
FUNCTION RenderStatusBar(m AS VDBTermModel) AS STRING
    DIM status AS STRING = " "

    IF m.ProjectLoaded THEN
        status = status & m.Project.Name
        IF m.Project.Modified THEN
            status = status & " *"
        ENDIF
        status = status & " | "
        IF m.CurrentFormIdx < Len(m.Project.Forms) THEN
            status = status & m.Project.Forms[m.CurrentFormIdx].Name
        ENDIF
    ELSE
        status = status & "[No Project]"
    ENDIF

    status = status & " | "
    IF m.ViewMode = VIEW_FORM THEN
        status = status & "Form"
    ELSE
        ' Get cursor position from textarea if initialized
        DIM cursorLine AS INTEGER = m.CodeCursorY
        DIM cursorCol AS INTEGER = m.CodeCursorX
        IF m.CodeEditorInited THEN
            cursorLine = GetEditorCursorLine(m.CodeEditor)
            cursorCol = GetEditorCursorCol(m.CodeEditor)
        ENDIF
        status = status & "Code Ln " & Str(cursorLine + 1) & " Col " & Str(cursorCol + 1)
    ENDIF

    IF Len(m.Message) > 0 THEN
        status = status & " | " & m.Message
    ENDIF

    status = status & " | F1=Help F5=Run F7=View F10=Menu"

    RETURN styleStatusBar.Render(PadRight(status, m.Width))
END FUNCTION

' Popup rendering (events context menu and color picker)
FUNCTION GetPopupWidth(m AS VDBTermModel) AS INTEGER
    IF m.PopupMode = POPUP_COLOR_PICKER THEN
        ' Color picker: 2 columns x 8 colors each = 16 cells, plus borders and labels
        RETURN 22
    ENDIF
    ' Fixed width for events popup
    RETURN 16
END FUNCTION

FUNCTION GetPopupLines(m AS VDBTermModel) AS []STRING
    DIM lines AS []STRING
    DIM width AS INTEGER = GetPopupWidth(m)

    IF m.PopupMode = POPUP_COLOR_PICKER THEN
        RETURN GetColorPickerLines(m, width)
    ENDIF

    ' Title bar (using Unicode box-drawing characters like dropdown menus)
    DIM titlePadded AS STRING = PadCenter(" Events ", width - 2)
    lines = APPEND(lines, styleDropdown.Render("┌" & RepeatStr("─", width - 2) & "┐"))
    lines = APPEND(lines, styleDropdownSelected.Render("│" & titlePadded & "│"))
    lines = APPEND(lines, styleDropdown.Render("├" & RepeatStr("─", width - 2) & "┤"))

    ' Event items
    DIM i AS INTEGER
    FOR i = 0 TO Len(m.PopupEvents) - 1
        DIM eventName AS STRING = m.PopupEvents[i]
        DIM itemText AS STRING = " " & PadRight(eventName, width - 4) & " "
        IF i = m.PopupIndex THEN
            lines = APPEND(lines, styleDropdown.Render("│") & styleDropdownSelected.Render(itemText) & styleDropdown.Render("│"))
        ELSE
            lines = APPEND(lines, styleDropdown.Render("│") & styleDropdown.Render(itemText) & styleDropdown.Render("│"))
        ENDIF
    NEXT

    ' Bottom border
    lines = APPEND(lines, styleDropdown.Render("└" & RepeatStr("─", width - 2) & "┘"))

    RETURN lines
END FUNCTION

FUNCTION GetColorPickerLines(m AS VDBTermModel, width AS INTEGER) AS []STRING
    DIM lines AS []STRING
    DIM i AS INTEGER

    ' Title bar
    DIM titlePadded AS STRING = PadCenter(" Color Picker ", width - 2)
    lines = APPEND(lines, styleDropdown.Render("┌" & RepeatStr("─", width - 2) & "┐"))
    lines = APPEND(lines, styleDropdownSelected.Render("│" & titlePadded & "│"))
    lines = APPEND(lines, styleDropdown.Render("├" & RepeatStr("─", width - 2) & "┤"))

    ' ForeColor row with label
    DIM foreLabel AS STRING
    IF m.ColorPickerFocus = 0 THEN
        foreLabel = "►ForeColor: "
    ELSE
        foreLabel = " ForeColor: "
    ENDIF
    DIM foreLine AS STRING = styleDropdown.Render("│" & foreLabel)
    FOR i = 0 TO 7
        IF i = m.ColorPickerFore THEN
            foreLine = foreLine & GetColorBlock(i, TRUE)
        ELSE
            foreLine = foreLine & GetColorBlock(i, FALSE)
        ENDIF
    NEXT
    foreLine = foreLine & styleDropdown.Render("│")
    lines = APPEND(lines, foreLine)

    ' Second row of ForeColor (colors 8-15)
    DIM foreLine2 AS STRING = styleDropdown.Render("│" & "            ")
    FOR i = 8 TO 15
        IF i = m.ColorPickerFore THEN
            foreLine2 = foreLine2 & GetColorBlock(i, TRUE)
        ELSE
            foreLine2 = foreLine2 & GetColorBlock(i, FALSE)
        ENDIF
    NEXT
    foreLine2 = foreLine2 & styleDropdown.Render("│")
    lines = APPEND(lines, foreLine2)

    ' Separator
    lines = APPEND(lines, styleDropdown.Render("├" & RepeatStr("─", width - 2) & "┤"))

    ' BackColor row with label
    DIM backLabel AS STRING
    IF m.ColorPickerFocus = 1 THEN
        backLabel = "►BackColor: "
    ELSE
        backLabel = " BackColor: "
    ENDIF
    DIM backLine AS STRING = styleDropdown.Render("│" & backLabel)
    FOR i = 0 TO 7
        IF i = m.ColorPickerBack THEN
            backLine = backLine & GetColorBlock(i, TRUE)
        ELSE
            backLine = backLine & GetColorBlock(i, FALSE)
        ENDIF
    NEXT
    backLine = backLine & styleDropdown.Render("│")
    lines = APPEND(lines, backLine)

    ' Second row of BackColor (colors 8-15)
    DIM backLine2 AS STRING = styleDropdown.Render("│" & "            ")
    FOR i = 8 TO 15
        IF i = m.ColorPickerBack THEN
            backLine2 = backLine2 & GetColorBlock(i, TRUE)
        ELSE
            backLine2 = backLine2 & GetColorBlock(i, FALSE)
        ENDIF
    NEXT
    backLine2 = backLine2 & styleDropdown.Render("│")
    lines = APPEND(lines, backLine2)

    ' Help text
    lines = APPEND(lines, styleDropdown.Render("├" & RepeatStr("─", width - 2) & "┤"))
    lines = APPEND(lines, styleDropdown.Render("│" & PadCenter("Tab:Switch Enter:OK", width - 2) & "│"))

    ' Bottom border
    lines = APPEND(lines, styleDropdown.Render("└" & RepeatStr("─", width - 2) & "┘"))

    RETURN lines
END FUNCTION

FUNCTION GetColorBlock(colorNum AS INTEGER, selected AS BOOLEAN) AS STRING
    ' Create a colored block representing the color
    ' Each block is 1 character wide, selection shown via contrasting marker
    DIM style AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(Str(colorNum)))
    IF selected THEN
        ' Show selection marker on the color - use contrasting foreground
        DIM fgColor AS INTEGER
        IF colorNum < 8 THEN
            fgColor = 15  ' White on dark colors
        ELSE
            fgColor = 0   ' Black on light colors
        ENDIF
        DIM selStyle AS lipgloss.Style = lipgloss.NewStyle().Background(lipgloss.Color(Str(colorNum))).Foreground(lipgloss.Color(Str(fgColor)))
        RETURN selStyle.Render("●")
    ELSE
        RETURN style.Render(" ")
    ENDIF
END FUNCTION

' Get widget list for Object Browser
FUNCTION GetObjectBrowserWidgets() AS []STRING
    DIM widgets AS []STRING
    widgets = APPEND(widgets, "Form")
    widgets = APPEND(widgets, "Button")
    widgets = APPEND(widgets, "Label")
    widgets = APPEND(widgets, "TextBox")
    widgets = APPEND(widgets, "CheckBox")
    widgets = APPEND(widgets, "Option")
    widgets = APPEND(widgets, "ListBox")
    widgets = APPEND(widgets, "ComboBox")
    widgets = APPEND(widgets, "HScroll")
    widgets = APPEND(widgets, "VScroll")
    widgets = APPEND(widgets, "Timer")
    widgets = APPEND(widgets, "TextArea")
    widgets = APPEND(widgets, "Progress")
    widgets = APPEND(widgets, "Spinner")
    widgets = APPEND(widgets, "Table")
    widgets = APPEND(widgets, "Path")
    widgets = APPEND(widgets, "Directories")
    widgets = APPEND(widgets, "Files")
    widgets = APPEND(widgets, "DirBrowser")
    RETURN widgets
END FUNCTION

' Get properties for a widget type in the Object Browser
FUNCTION GetObjectBrowserProperties(widgetIdx AS INTEGER) AS []STRING
    DIM props AS []STRING

    ' Common properties for all controls
    IF widgetIdx = 0 THEN
        ' Form properties
        props = APPEND(props, "Name      STRING   Form identifier")
        props = APPEND(props, "Caption   STRING   Title bar text")
        props = APPEND(props, "X         INTEGER  Left position")
        props = APPEND(props, "Y         INTEGER  Top position")
        props = APPEND(props, "Width     INTEGER  Form width")
        props = APPEND(props, "Height    INTEGER  Form height")
        props = APPEND(props, "ForeColor INTEGER  Text color")
        props = APPEND(props, "BackColor INTEGER  Background color")
    ELSE
        ' Common control properties
        props = APPEND(props, "Name      STRING   Control identifier")
        props = APPEND(props, "X         INTEGER  Left position")
        props = APPEND(props, "Y         INTEGER  Top position")
        props = APPEND(props, "Width     INTEGER  Control width")
        props = APPEND(props, "Height    INTEGER  Control height")
        props = APPEND(props, "Enabled   BOOLEAN  Interaction state")
        props = APPEND(props, "Visible   BOOLEAN  Visibility state")
        props = APPEND(props, "ZOrder    INTEGER  Stacking order")
        props = APPEND(props, "TabIndex  INTEGER  Tab order")
        props = APPEND(props, "ForeColor INTEGER  Text color")
        props = APPEND(props, "BackColor INTEGER  Background color")

        ' Type-specific properties
        IF widgetIdx = 1 THEN
            ' Button
            props = APPEND(props, "Caption   STRING   Button text")
            props = APPEND(props, "Border    BOOLEAN  Show border")
        ELSEIF widgetIdx = 2 THEN
            ' Label
            props = APPEND(props, "Caption   STRING   Label text")
            props = APPEND(props, "Justify   ENUM     Left/Center/Right")
        ELSEIF widgetIdx = 3 THEN
            ' TextBox
            props = APPEND(props, "Value     STRING   Text content")
            props = APPEND(props, "Placeholder STRING  Empty hint")
            props = APPEND(props, "CharLimit INTEGER  Max characters")
            props = APPEND(props, "EchoMode  ENUM     Normal/Password/None")
        ELSEIF widgetIdx = 4 THEN
            ' CheckBox
            props = APPEND(props, "Caption   STRING   Checkbox label")
            props = APPEND(props, "Value     STRING   Checked state")
        ELSEIF widgetIdx = 5 THEN
            ' Option
            props = APPEND(props, "Caption   STRING   Option label")
            props = APPEND(props, "GroupName STRING   Radio group")
        ELSEIF widgetIdx = 6 THEN
            ' ListBox
            props = APPEND(props, "Items     STRING   Semicolon-separated")
            props = APPEND(props, "Title     STRING   List title")
            props = APPEND(props, "ShowTitle BOOLEAN  Show title bar")
        ELSEIF widgetIdx = 7 THEN
            ' ComboBox
            props = APPEND(props, "Items     STRING   Semicolon-separated")
            props = APPEND(props, "ShowFilter BOOLEAN Filter input")
        ELSEIF widgetIdx = 10 THEN
            ' Timer
            props = APPEND(props, "Interval  INTEGER  Ms between ticks")
        ELSEIF widgetIdx = 11 THEN
            ' TextArea
            props = APPEND(props, "Text      STRING   Text content")
            props = APPEND(props, "Placeholder STRING Empty hint")
            props = APPEND(props, "ShowLineNumbers BOOLEAN Line nums")
        ELSEIF widgetIdx = 12 THEN
            ' Progress
            props = APPEND(props, "Value     STRING   Current value")
            props = APPEND(props, "Total     INTEGER  Maximum value")
            props = APPEND(props, "ShowPct   BOOLEAN  Show percentage")
        ELSEIF widgetIdx = 13 THEN
            ' Spinner
            props = APPEND(props, "Style     ENUM     Line/Dot/MiniDot/...")
        ELSEIF widgetIdx = 14 THEN
            ' Table
            props = APPEND(props, "Columns   STRING   Pipe-separated")
            props = APPEND(props, "Rows      STRING   Semicolon-separated")
            props = APPEND(props, "ShowHeaders BOOLEAN Header row")
        ELSEIF widgetIdx = 15 THEN
            ' Path
            props = APPEND(props, "Path      STRING   Current path value")
            props = APPEND(props, "CharLimit INTEGER  Max characters")
        ELSEIF widgetIdx = 16 THEN
            ' Directories
            props = APPEND(props, "Path        STRING   Current directory")
            props = APPEND(props, "SelectedDir STRING   Currently selected dir")
            props = APPEND(props, "ShowFiles   BOOLEAN  Show files too")
            props = APPEND(props, "Filter      STRING   File filter pattern")
        ELSEIF widgetIdx = 17 THEN
            ' Files
            props = APPEND(props, "Path             STRING   Current directory")
            props = APPEND(props, "SelectedFile     STRING   Selected filename")
            props = APPEND(props, "SelectedFilePath STRING   Full selected path")
            props = APPEND(props, "Pattern          STRING   File filter pattern")
        ELSEIF widgetIdx = 18 THEN
            ' DirBrowser
            props = APPEND(props, "Path        STRING   Current directory")
            props = APPEND(props, "SelectedDir STRING   Currently selected dir")
        ENDIF
    ENDIF
    RETURN props
END FUNCTION

' Get events for a widget type in the Object Browser
FUNCTION GetObjectBrowserEvents(widgetIdx AS INTEGER) AS []STRING
    DIM events AS []STRING

    IF widgetIdx = 0 THEN
        ' Form events
        events = APPEND(events, "Load      Form initialized")
        events = APPEND(events, "Unload    Form closing")
        events = APPEND(events, "Activate  Form gains focus")
        events = APPEND(events, "KeyPress  Key pressed")
    ELSEIF widgetIdx = 1 THEN
        ' Button
        events = APPEND(events, "Click     Button pressed")
    ELSEIF widgetIdx = 2 THEN
        ' Label
        events = APPEND(events, "Click     Label clicked")
    ELSEIF widgetIdx = 3 THEN
        ' TextBox
        events = APPEND(events, "Change    Text changed")
        events = APPEND(events, "Submit    Enter pressed")
        events = APPEND(events, "Blur      Lost focus")
    ELSEIF widgetIdx = 4 OR widgetIdx = 5 THEN
        ' CheckBox / Option
        events = APPEND(events, "Change    State changed")
    ELSEIF widgetIdx = 6 OR widgetIdx = 7 THEN
        ' ListBox / ComboBox
        events = APPEND(events, "Change    Selection changed")
    ELSEIF widgetIdx = 10 THEN
        ' Timer
        events = APPEND(events, "Tick      Interval elapsed")
    ELSEIF widgetIdx = 11 THEN
        ' TextArea
        events = APPEND(events, "Change    Text changed")
        events = APPEND(events, "Blur      Lost focus")
    ELSEIF widgetIdx = 14 THEN
        ' Table
        events = APPEND(events, "Change    Selection changed")
    ELSEIF widgetIdx = 15 THEN
        ' Path
        events = APPEND(events, "Change    Path text changed")
        events = APPEND(events, "Enter     Enter key pressed")
    ELSEIF widgetIdx = 16 THEN
        ' Directories
        events = APPEND(events, "Change    Directory changed")
        events = APPEND(events, "Enter     Directory selected")
        events = APPEND(events, "DblClick  Double-click (navigates)")
    ELSEIF widgetIdx = 17 THEN
        ' Files
        events = APPEND(events, "Change    Selection changed")
        events = APPEND(events, "Enter     File selected")
        events = APPEND(events, "DblClick  File double-clicked")
    ELSEIF widgetIdx = 18 THEN
        ' DirBrowser
        events = APPEND(events, "DirChange   Dir list selection")
        events = APPEND(events, "PathChange  Path input changed")
    ELSE
        events = APPEND(events, "(No events)")
    ENDIF
    RETURN events
END FUNCTION

' Get functions/methods for a widget type in the Object Browser
FUNCTION GetObjectBrowserFunctions(widgetIdx AS INTEGER) AS []STRING
    DIM funcs AS []STRING

    IF widgetIdx = 0 THEN
        ' Form functions
        funcs = APPEND(funcs, "Show()              Display the form")
        funcs = APPEND(funcs, "Hide()              Hide the form")
        funcs = APPEND(funcs, "Close()             Close the form")
        funcs = APPEND(funcs, "Refresh()           Redraw the form")
    ELSEIF widgetIdx = 1 THEN
        ' Button
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "SetCaption(s)       Change button text")
        funcs = APPEND(funcs, "Enable()            Enable the button")
        funcs = APPEND(funcs, "Disable()           Disable the button")
    ELSEIF widgetIdx = 2 THEN
        ' Label
        funcs = APPEND(funcs, "SetCaption(s)       Change label text")
        funcs = APPEND(funcs, "SetJustify(j)       Set alignment (0/1/2)")
    ELSEIF widgetIdx = 3 THEN
        ' TextBox
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "SetText(s)          Set text content")
        funcs = APPEND(funcs, "SetPlaceholder(s)   Set hint text")
        funcs = APPEND(funcs, "SetCharLimit(n)     Set max characters")
    ELSEIF widgetIdx = 4 THEN
        ' CheckBox
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "IsChecked()         Get checked state")
        funcs = APPEND(funcs, "SetChecked(b)       Set checked state")
    ELSEIF widgetIdx = 5 THEN
        ' Option
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "IsSelected()        Get selected state")
        funcs = APPEND(funcs, "SetSelected(b)      Set selected state")
    ELSEIF widgetIdx = 6 THEN
        ' ListBox
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "SelectedIndex()     Get selected index")
        funcs = APPEND(funcs, "SelectedItem()      Get selected item text")
        funcs = APPEND(funcs, "SetItems(items)     Set list items")
        funcs = APPEND(funcs, "AddItem(s)          Add an item")
        funcs = APPEND(funcs, "RemoveItem(idx)     Remove item at index")
        funcs = APPEND(funcs, "ClearItems()        Remove all items")
    ELSEIF widgetIdx = 7 THEN
        ' ComboBox
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "SelectedIndex()     Get selected index")
        funcs = APPEND(funcs, "SelectedItem()      Get selected item text")
        funcs = APPEND(funcs, "SetItems(items)     Set list items")
        funcs = APPEND(funcs, "AddItem(s)          Add an item")
        funcs = APPEND(funcs, "ClearItems()        Remove all items")
    ELSEIF widgetIdx = 8 OR widgetIdx = 9 THEN
        ' HScroll / VScroll
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Value()             Get current value")
        funcs = APPEND(funcs, "SetValue(n)         Set current value")
        funcs = APPEND(funcs, "SetMin(n)           Set minimum value")
        funcs = APPEND(funcs, "SetMax(n)           Set maximum value")
    ELSEIF widgetIdx = 10 THEN
        ' Timer
        funcs = APPEND(funcs, "Start()             Start the timer")
        funcs = APPEND(funcs, "Stop()              Stop the timer")
        funcs = APPEND(funcs, "SetInterval(ms)     Set tick interval")
        funcs = APPEND(funcs, "IsRunning()         Check if active")
    ELSEIF widgetIdx = 11 THEN
        ' TextArea
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "SetText(s)          Set text content")
        funcs = APPEND(funcs, "Line(n)             Get line at index")
        funcs = APPEND(funcs, "LineCount()         Get number of lines")
        funcs = APPEND(funcs, "CursorLine()        Get cursor line")
        funcs = APPEND(funcs, "CursorCol()         Get cursor column")
    ELSEIF widgetIdx = 12 THEN
        ' Progress
        funcs = APPEND(funcs, "Value()             Get current value")
        funcs = APPEND(funcs, "SetValue(n)         Set current value")
        funcs = APPEND(funcs, "SetTotal(n)         Set maximum value")
        funcs = APPEND(funcs, "Percent()           Get percentage done")
    ELSEIF widgetIdx = 13 THEN
        ' Spinner
        funcs = APPEND(funcs, "View()              Render spinner frame")
        funcs = APPEND(funcs, "Tick()              Advance to next frame")
    ELSEIF widgetIdx = 14 THEN
        ' Table
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "SelectedRow()       Get selected row index")
        funcs = APPEND(funcs, "SetRows(rows)       Set table data")
        funcs = APPEND(funcs, "SetColumns(cols)    Set column headers")
        funcs = APPEND(funcs, "AddRow(row)         Add a data row")
        funcs = APPEND(funcs, "ClearRows()         Remove all rows")
    ELSEIF widgetIdx = 15 THEN
        ' Path
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "GetPath()           Get current path")
        funcs = APPEND(funcs, "SetPath(s)          Set path value")
        funcs = APPEND(funcs, "View()              Refresh display")
        funcs = APPEND(funcs, "Update(msg)         Handle input message")
    ELSEIF widgetIdx = 16 THEN
        ' Directories
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "GetPath()           Get current path")
        funcs = APPEND(funcs, "SetPath(s)          Set root path")
        funcs = APPEND(funcs, "View()              Refresh directory list")
        funcs = APPEND(funcs, "Update(msg)         Handle input message")
    ELSEIF widgetIdx = 17 THEN
        ' Files
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "GetPath()           Get current path")
        funcs = APPEND(funcs, "SetPath(s)          Set directory path")
        funcs = APPEND(funcs, "SetPattern(p)       Set file pattern filter")
        funcs = APPEND(funcs, "GetPattern()        Get current pattern")
        funcs = APPEND(funcs, "SetShowHidden(b)    Show/hide hidden files")
        funcs = APPEND(funcs, "View()              Refresh file list")
        funcs = APPEND(funcs, "Update(msg)         Handle input message")
    ELSEIF widgetIdx = 18 THEN
        ' DirBrowser
        funcs = APPEND(funcs, "Focus()             Set input focus")
        funcs = APPEND(funcs, "Blur()              Remove input focus")
        funcs = APPEND(funcs, "Focused()           Check if focused")
        funcs = APPEND(funcs, "GetPath()           Get current path")
        funcs = APPEND(funcs, "SetPath(s)          Set root path")
        funcs = APPEND(funcs, "SetColors(fg,bg)    Set colors")
        funcs = APPEND(funcs, "SetShowHidden(b)    Show/hide hidden dirs")
        funcs = APPEND(funcs, "View()              Refresh directory list")
        funcs = APPEND(funcs, "Update(msg)         Handle input message")
    ELSE
        funcs = APPEND(funcs, "(No functions)")
    ENDIF
    RETURN funcs
END FUNCTION

' Build Object Browser dialog content
FUNCTION GetObjectBrowserContent(m AS VDBTermModel) AS []STRING
    DIM content AS []STRING
    DIM widgets AS []STRING = GetObjectBrowserWidgets()
    DIM widgetCount AS INTEGER = Len(widgets)

    ' Tab bar
    DIM tabLine AS STRING = "  "
    IF m.ObjectBrowserTab = 0 THEN
        tabLine = tabLine & "[Widgets] "
    ELSE
        tabLine = tabLine & " Widgets  "
    ENDIF
    IF m.ObjectBrowserTab = 1 THEN
        tabLine = tabLine & "[Props] "
    ELSE
        tabLine = tabLine & " Props  "
    ENDIF
    IF m.ObjectBrowserTab = 2 THEN
        tabLine = tabLine & "[Events] "
    ELSE
        tabLine = tabLine & " Events  "
    ENDIF
    IF m.ObjectBrowserTab = 3 THEN
        tabLine = tabLine & "[Functions]"
    ELSE
        tabLine = tabLine & " Functions "
    ENDIF
    content = APPEND(content, tabLine)
    content = APPEND(content, "  " & RepeatStr("-", 62))

    ' Main content area (16 lines)
    DIM viewHeight AS INTEGER = 16
    DIM scrollOffset AS INTEGER = m.ObjectBrowserScroll
    DIM i AS INTEGER

    IF m.ObjectBrowserTab = 0 THEN
        ' Widgets tab - show widget list
        FOR i = 0 TO viewHeight - 1
            DIM wIdx AS INTEGER = scrollOffset + i
            IF wIdx < widgetCount THEN
                DIM marker AS STRING = "  "
                IF wIdx = m.ObjectBrowserWidgetIdx THEN
                    marker = "> "
                ENDIF
                content = APPEND(content, "  " & marker & PadRight(widgets[wIdx], 60))
            ELSE
                content = APPEND(content, "  " & RepeatStr(" ", 62))
            ENDIF
        NEXT
    ELSEIF m.ObjectBrowserTab = 1 THEN
        ' Properties tab - show properties for selected widget
        DIM props AS []STRING = GetObjectBrowserProperties(m.ObjectBrowserWidgetIdx)
        DIM propCount AS INTEGER = Len(props)
        content = APPEND(content, "  Properties for: " & widgets[m.ObjectBrowserWidgetIdx])
        content = APPEND(content, "  " & RepeatStr("-", 40))
        FOR i = 0 TO viewHeight - 3
            DIM pIdx AS INTEGER = scrollOffset + i
            IF pIdx < propCount THEN
                content = APPEND(content, "  " & PadRight(props[pIdx], 62))
            ELSE
                content = APPEND(content, "  " & RepeatStr(" ", 62))
            ENDIF
        NEXT
    ELSEIF m.ObjectBrowserTab = 2 THEN
        ' Events tab - show events for selected widget
        DIM events AS []STRING = GetObjectBrowserEvents(m.ObjectBrowserWidgetIdx)
        DIM eventCount AS INTEGER = Len(events)
        content = APPEND(content, "  Events for: " & widgets[m.ObjectBrowserWidgetIdx])
        content = APPEND(content, "  " & RepeatStr("-", 40))
        FOR i = 0 TO viewHeight - 3
            DIM eIdx AS INTEGER = scrollOffset + i
            IF eIdx < eventCount THEN
                content = APPEND(content, "  " & PadRight(events[eIdx], 62))
            ELSE
                content = APPEND(content, "  " & RepeatStr(" ", 62))
            ENDIF
        NEXT
    ELSEIF m.ObjectBrowserTab = 3 THEN
        ' Functions tab - show functions for selected widget
        DIM funcs AS []STRING = GetObjectBrowserFunctions(m.ObjectBrowserWidgetIdx)
        DIM funcCount AS INTEGER = Len(funcs)
        content = APPEND(content, "  Functions for: " & widgets[m.ObjectBrowserWidgetIdx])
        content = APPEND(content, "  " & RepeatStr("-", 40))
        FOR i = 0 TO viewHeight - 3
            DIM fIdx AS INTEGER = scrollOffset + i
            IF fIdx < funcCount THEN
                content = APPEND(content, "  " & PadRight(funcs[fIdx], 62))
            ELSE
                content = APPEND(content, "  " & RepeatStr(" ", 62))
            ENDIF
        NEXT
    ENDIF

    ' Footer
    content = APPEND(content, "  " & RepeatStr("-", 62))
    content = APPEND(content, "  Tab: Switch panel   Up/Down: Navigate   Esc: Close")

    RETURN content
END FUNCTION

' Get the fore/back colors for a theme property by index
FUNCTION GetThemePropColors(theme AS VDBTheme, pIdx AS INTEGER) AS (INTEGER, INTEGER)
    IF pIdx = 0 THEN
        RETURN theme.FormForeColor, theme.FormBackColor
    ELSEIF pIdx = 1 THEN
        RETURN theme.ButtonForeColor, theme.ButtonBackColor
    ELSEIF pIdx = 2 THEN
        RETURN theme.LabelForeColor, theme.LabelBackColor
    ELSEIF pIdx = 3 THEN
        RETURN theme.TextBoxForeColor, theme.TextBoxBackColor
    ELSEIF pIdx = 4 THEN
        RETURN theme.CheckBoxForeColor, theme.CheckBoxBackColor
    ELSEIF pIdx = 5 THEN
        RETURN theme.OptionForeColor, theme.OptionBackColor
    ELSEIF pIdx = 6 THEN
        RETURN theme.ListBoxForeColor, theme.ListBoxBackColor
    ELSEIF pIdx = 7 THEN
        RETURN theme.ComboBoxForeColor, theme.ComboBoxBackColor
    ELSEIF pIdx = 8 THEN
        RETURN theme.FrameForeColor, theme.FrameBackColor
    ELSEIF pIdx = 9 THEN
        RETURN theme.TextAreaForeColor, theme.TextAreaBackColor
    ELSEIF pIdx = 10 THEN
        RETURN theme.ProgressForeColor, theme.ProgressBackColor
    ELSEIF pIdx = 11 THEN
        RETURN theme.SpinnerForeColor, theme.SpinnerBackColor
    ELSEIF pIdx = 12 THEN
        RETURN theme.PathForeColor, theme.PathBackColor
    ELSEIF pIdx = 13 THEN
        RETURN theme.DirectoriesForeColor, theme.DirectoriesBackColor
    ELSEIF pIdx = 14 THEN
        RETURN theme.FilesForeColor, theme.FilesBackColor
    ELSEIF pIdx = 15 THEN
        RETURN theme.DirBrowserForeColor, theme.DirBrowserBackColor
    ELSEIF pIdx = 16 THEN
        RETURN theme.FocusedForeColor, theme.FocusedBackColor
    ELSEIF pIdx = 17 THEN
        RETURN theme.SelectedForeColor, theme.SelectedBackColor
    ELSEIF pIdx = 18 THEN
        RETURN theme.MenuForeColor, theme.MenuBackColor
    ELSEIF pIdx = 19 THEN
        RETURN theme.MenuSelectedForeColor, theme.MenuSelectedBackColor
    ELSEIF pIdx = 20 THEN
        ' MenuShortcut uses MenuBackColor as background (not editable)
        RETURN theme.MenuShortcutForeColor, theme.MenuBackColor
    ENDIF
    RETURN 0, 0
END FUNCTION

' Render ANSI colored text for preview
' restoreDialog: if TRUE, restore dialog colors (fg 252, bg 237) instead of using generic reset
FUNCTION RenderColorPreview(text AS STRING, fg AS INTEGER, bg AS INTEGER, use256 AS BOOLEAN) AS STRING
    RETURN RenderColorPreviewEx(text, fg, bg, use256, FALSE)
END FUNCTION

FUNCTION RenderColorPreviewEx(text AS STRING, fg AS INTEGER, bg AS INTEGER, use256 AS BOOLEAN, restoreDialog AS BOOLEAN) AS STRING
    DIM resetCode AS STRING = Chr(27) & "[0m"
    IF restoreDialog THEN
        ' Restore dialog colors instead of generic reset
        resetCode = Chr(27) & "[38;5;252;48;5;237m"
    ENDIF

    IF use256 THEN
        ' Use 256-color ANSI escape codes (38;5;N for fg, 48;5;N for bg)
        RETURN Chr(27) & "[38;5;" & Str(fg) & ";48;5;" & Str(bg) & "m" & text & resetCode
    ENDIF

    ' Map 16-color index to ANSI codes (0-7 -> 30-37, 8-15 -> 90-97 for bright)
    DIM fgCode AS INTEGER
    DIM bgCode AS INTEGER
    IF fg < 8 THEN
        fgCode = 30 + fg
    ELSE
        fgCode = 90 + (fg - 8)
    ENDIF
    IF bg < 8 THEN
        bgCode = 40 + bg
    ELSE
        bgCode = 100 + (bg - 8)
    ENDIF
    RETURN Chr(27) & "[" & Str(fgCode) & ";" & Str(bgCode) & "m" & text & resetCode
END FUNCTION

' Theme editor content
FUNCTION GetThemeEditorContent(m AS VDBTermModel) AS []STRING
    DIM content AS []STRING
    DIM use256 AS BOOLEAN = m.ThemeEditingTheme.Use256Colors

    ' Theme preset selector
    DIM themeName AS STRING = m.ThemeEditingTheme.Name
    IF themeName = "" THEN
        themeName = "Custom"
    ENDIF

    content = APPEND(content, "")
    content = APPEND(content, "  Theme: [" & PadRight(themeName, 12) & "]  1-4: Presets")
    content = APPEND(content, "")

    ' UseTheme checkbox
    DIM checkMark AS STRING = " "
    IF m.Project.UseTheme THEN
        checkMark = "x"
    ENDIF
    content = APPEND(content, "  [" & checkMark & "] Apply theme to new controls")

    ' Use256Colors checkbox
    DIM colorCheck AS STRING = " "
    IF use256 THEN
        colorCheck = "x"
    ENDIF
    content = APPEND(content, "  [" & colorCheck & "] Use 256-color palette")
    content = APPEND(content, "")

    ' Column headers with focus and selection indicators
    DIM propFocus AS BOOLEAN = (m.ThemeEditorFocus = THEME_FOCUS_PROPS)
    DIM foreHdr AS STRING = "Fore"
    DIM backHdr AS STRING = "Back"
    IF propFocus AND m.ThemeEditorColIdx = 0 THEN
        foreHdr = "[Fore]"
    ELSEIF propFocus AND m.ThemeEditorColIdx = 1 THEN
        backHdr = "[Back]"
    ENDIF

    content = APPEND(content, "  Property            " & PadRight(foreHdr, 6) & PadRight(backHdr, 6) & "Preview")
    content = APPEND(content, "  " & RepeatStr("-", 44))

    ' Property list with scrolling
    DIM props AS []STRING = []STRING{"Form", "Button", "Label", "TextBox", "CheckBox", "Option", "ListBox", "ComboBox", "Frame", "TextArea", "Progress", "Spinner", "Path", "Directories", "Files", "DirBrowser", "Focus", "Selection", "Menu", "MenuSelected", "MenuShortcut"}
    DIM propCount AS INTEGER = Len(props)
    DIM viewHeight AS INTEGER = 8
    DIM scrollOffset AS INTEGER = m.ThemeEditorScroll

    DIM i AS INTEGER
    FOR i = 0 TO viewHeight - 1
        DIM pIdx AS INTEGER = scrollOffset + i
        DIM propLine AS STRING = ""

        IF pIdx < propCount THEN
            DIM marker AS STRING = "  "
            IF pIdx = m.ThemeEditorPropIdx AND propFocus THEN
                marker = "> "
            ENDIF

            DIM propName AS STRING = props[pIdx]
            DIM foreColor AS INTEGER
            DIM backColor AS INTEGER
            foreColor, backColor = GetThemePropColors(m.ThemeEditingTheme, pIdx)

            ' Format the color values - clickable areas
            DIM foreStr AS STRING = PadRight(Str(foreColor), 6)
            DIM backStr AS STRING = PadRight(Str(backColor), 6)

            ' MenuShortcut has no editable Back (uses Menu's back)
            IF pIdx = 20 THEN
                backStr = "-     "
            ENDIF

            ' Show color preview (use Ex version to restore dialog colors)
            DIM preview AS STRING = RenderColorPreviewEx(" Abc ", foreColor, backColor, use256, TRUE)

            propLine = marker & PadRight(propName, 18) & foreStr & backStr & preview
        ELSE
            propLine = RepeatStr(" ", 44)
        ENDIF

        content = APPEND(content, "  " & propLine)
    NEXT

    ' Scroll indicator
    DIM infoLine AS STRING = ""
    IF propCount > viewHeight THEN
        infoLine = "  [" & Str(scrollOffset + 1) & "-" & Str(scrollOffset + viewHeight) & " of " & Str(propCount) & "]"
    ELSE
        infoLine = "  "
    ENDIF
    content = APPEND(content, infoLine)

    content = APPEND(content, "")

    ' Help text
    content = APPEND(content, "  Tab: Cycle focus  Arrows: Navigate")
    IF use256 THEN
        content = APPEND(content, "  Enter: Open color picker")
    ELSE
        content = APPEND(content, "  +/-: Adjust color")
    ENDIF
    content = APPEND(content, "")

    ' Buttons with focus indicator
    DIM btnFocus AS BOOLEAN = (m.ThemeEditorFocus = THEME_FOCUS_BUTTONS)
    DIM applyBtn AS STRING = "< Apply to All >"
    DIM okBtn AS STRING = "< OK >"
    DIM cancelBtn AS STRING = "< Cancel >"

    IF btnFocus THEN
        IF m.ThemeEditorIndex = 0 THEN
            applyBtn = "[Apply to All]"
        ELSEIF m.ThemeEditorIndex = 1 THEN
            okBtn = "[ OK ]"
        ELSEIF m.ThemeEditorIndex = 2 THEN
            cancelBtn = "[Cancel]"
        ENDIF
    ENDIF

    content = APPEND(content, "   " & applyBtn & "  " & okBtn & "  " & cancelBtn)
    content = APPEND(content, "")

    RETURN content
END FUNCTION

' 256-color picker popup dialog content
FUNCTION GetColorPicker256Content(m AS VDBTermModel) AS []STRING
    DIM content AS []STRING

    content = APPEND(content, "")
    content = APPEND(content, "  Click on a color to select, or double-click to apply.")
    content = APPEND(content, "")

    ' Render 16x16 color grid (256 colors)
    DIM row AS INTEGER
    FOR row = 0 TO 15
        DIM rowStr AS STRING = "  "
        DIM col AS INTEGER
        FOR col = 0 TO 15
            DIM colorIdx AS INTEGER = row * 16 + col
            DIM cellChar AS STRING = "  "
            IF row = m.ThemeColorPickerY AND col = m.ThemeColorPickerX THEN
                cellChar = "XX"
            ENDIF
            ' Use 256-color background
            rowStr = rowStr & Chr(27) & "[48;5;" & Str(colorIdx) & "m" & cellChar & Chr(27) & "[0m"
        NEXT
        content = APPEND(content, rowStr)
    NEXT

    content = APPEND(content, "")

    ' Show selected color info
    DIM selectedColor AS INTEGER = m.ThemeColorPickerY * 16 + m.ThemeColorPickerX
    DIM colorPreview AS STRING = Chr(27) & "[48;5;" & Str(selectedColor) & "m    " & Chr(27) & "[0m"
    content = APPEND(content, "  Selected: " & PadRight(Str(selectedColor), 3) & " " & colorPreview)
    content = APPEND(content, "")

    ' Buttons
    DIM okBtn AS STRING = "< OK >"
    DIM cancelBtn AS STRING = "< Cancel >"
    IF m.ThemeEditorIndex = 0 THEN
        okBtn = "[ OK ]"
    ELSE
        cancelBtn = "[Cancel]"
    ENDIF
    content = APPEND(content, "        " & okBtn & "    " & cancelBtn)
    content = APPEND(content, "")

    RETURN content
END FUNCTION

' Dialog rendering
FUNCTION GetDialogLines(m AS VDBTermModel) AS []STRING
    DIM lines AS []STRING
    DIM title AS STRING = ""
    DIM width AS INTEGER = 40
    DIM contentLines AS []STRING

    IF m.DialogMode = DIALOG_HELP THEN
        title = " VDBTerm Help "
        width = 50
        contentLines = APPEND(contentLines, "  VDBTerm - Visual DBasic Terminal IDE")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Keyboard Shortcuts:")
        contentLines = APPEND(contentLines, "    F1     - Help")
        contentLines = APPEND(contentLines, "    F2     - Object Browser")
        contentLines = APPEND(contentLines, "    F3     - Theme Editor")
        contentLines = APPEND(contentLines, "    F5     - Run project")
        contentLines = APPEND(contentLines, "    F7     - Toggle Form/Code view")
        contentLines = APPEND(contentLines, "    F10    - Open menu")
        contentLines = APPEND(contentLines, "    Tab    - Cycle focus areas")
        contentLines = APPEND(contentLines, "    Arrows - Navigate/Move controls")
        contentLines = APPEND(contentLines, "    +/-    - Resize selected control")
        contentLines = APPEND(contentLines, "    Delete - Delete selected control")
        contentLines = APPEND(contentLines, "    Enter  - Add control from toolbox")
        contentLines = APPEND(contentLines, "    Ctrl+Q - Exit")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Mouse Controls:")
        contentLines = APPEND(contentLines, "    Click  - Select panels/controls/menu")
        contentLines = APPEND(contentLines, "    Drag   - Move controls on form")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Press Enter or Esc to close")
    ELSEIF m.DialogMode = DIALOG_ABOUT THEN
        title = " About VDBTerm "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "      VDBTerm v1.0")
        contentLines = APPEND(contentLines, "      Visual DBasic Terminal IDE")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   A modern clone of VBDos Pro")
        contentLines = APPEND(contentLines, "   Written in DBasic for DBasic")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   Create visual terminal applications")
        contentLines = APPEND(contentLines, "   with forms, controls, and events.")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Press Enter or Esc to close")
    ELSEIF m.DialogMode = DIALOG_COMPILE_ERROR THEN
        title = " Compile Errors "
        width = 60

        ' Split errors into lines and display with scrolling
        DIM errorLines AS []STRING = SplitStr(m.CompileErrors, Chr(10))
        DIM maxVisible AS INTEGER = 12
        DIM startLine AS INTEGER = m.CompileErrorScroll
        DIM endLine AS INTEGER = startLine + maxVisible
        IF endLine > Len(errorLines) THEN
            endLine = Len(errorLines)
        ENDIF

        contentLines = APPEND(contentLines, "")

        DIM ei AS INTEGER
        FOR ei = startLine TO endLine - 1
            DIM errLine AS STRING = errorLines[ei]
            ' Truncate long lines
            IF Len(errLine) > width - 4 THEN
                errLine = Left(errLine, width - 7) & "..."
            ENDIF
            contentLines = APPEND(contentLines, "  " & errLine)
        NEXT

        ' Pad remaining lines
        FOR ei = endLine - startLine TO maxVisible - 1
            contentLines = APPEND(contentLines, "")
        NEXT

        ' Show scroll indicator if needed
        IF Len(errorLines) > maxVisible THEN
            DIM scrollInfo AS STRING = "  [" & Str(startLine + 1) & "-" & Str(endLine) & " of " & Str(Len(errorLines)) & " lines - use Up/Down to scroll]"
            contentLines = APPEND(contentLines, scrollInfo)
        ELSE
            contentLines = APPEND(contentLines, "")
        ENDIF

        contentLines = APPEND(contentLines, "")

        ' Render buttons with selection highlight
        DIM okBtn AS STRING = "< OK >"
        DIM copyBtn AS STRING = "< Copy >"
        IF m.CompileErrorBtnIdx = 0 THEN
            okBtn = "[  OK  ]"
        ELSE
            copyBtn = "[  Copy  ]"
        ENDIF
        contentLines = APPEND(contentLines, "          " & okBtn & "       " & copyBtn)
    ELSEIF m.DialogMode = DIALOG_OPEN_PROJECT THEN
        title = " Open Project "
        width = 40
        contentLines = APPEND(contentLines, "   File Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >       < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_PROJECT THEN
        title = " New Project "
        width = 40
        contentLines = APPEND(contentLines, "   Project Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >       < Cancel >")
    ELSEIF m.DialogMode = DIALOG_SAVE_PROJECT THEN
        title = " Save Project "
        width = 40
        contentLines = APPEND(contentLines, "   File Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >       < Cancel >")
    ELSEIF m.DialogMode = DIALOG_FILE_BROWSER THEN
        title = " " & m.FileBrowserTitle & " "
        width = 60

        ' Path display
        DIM displayPath AS STRING = m.FileBrowserPath
        IF Len(displayPath) > 54 THEN
            displayPath = "..." & Right(displayPath, 51)
        ENDIF
        contentLines = APPEND(contentLines, " Path: " & displayPath)
        contentLines = APPEND(contentLines, " " & strings.Repeat("-", 56))

        ' Side-by-side: Directories | Files
        DIM listHeight AS INTEGER = 10
        DIM dirWidth AS INTEGER = 25
        DIM fileWidth AS INTEGER = 28

        ' Header row
        DIM dirHeader AS STRING = " Directories"
        DIM fileHeader AS STRING = " Files (" & m.FileBrowserPattern & ")"
        DIM dirPad AS INTEGER = dirWidth - Len(dirHeader)
        DIM filePad AS INTEGER = fileWidth - Len(fileHeader)
        IF dirPad > 0 THEN
            dirHeader = dirHeader & strings.Repeat(" ", dirPad)
        ENDIF
        IF filePad > 0 THEN
            fileHeader = fileHeader & strings.Repeat(" ", filePad)
        ENDIF
        contentLines = APPEND(contentLines, " " & dirHeader & " | " & fileHeader)

        ' List rows
        DIM row AS INTEGER
        FOR row = 0 TO listHeight - 1
            DIM dirLine AS STRING = ""
            DIM fileLine AS STRING = ""

            ' Directory entry
            DIM dirIdx AS INTEGER = m.FileBrowserDirScroll + row
            IF dirIdx < Len(m.FileBrowserDirs) THEN
                DIM dirName AS STRING = m.FileBrowserDirs[dirIdx]
                IF Len(dirName) > dirWidth - 3 THEN
                    dirName = Left(dirName, dirWidth - 6) & "..."
                ENDIF
                IF dirIdx = m.FileBrowserDirIdx AND m.FileBrowserFocus = FILEBROWSER_FOCUS_DIRS THEN
                    dirLine = ">" & dirName
                ELSE
                    dirLine = " " & dirName
                ENDIF
            ENDIF
            DIM dirLinePad AS INTEGER = dirWidth - Len(dirLine)
            IF dirLinePad > 0 THEN
                dirLine = dirLine & strings.Repeat(" ", dirLinePad)
            ENDIF

            ' File entry
            DIM fileIdx AS INTEGER = m.FileBrowserFileScroll + row
            IF fileIdx < Len(m.FileBrowserFiles) THEN
                DIM fileName AS STRING = m.FileBrowserFiles[fileIdx]
                IF Len(fileName) > fileWidth - 3 THEN
                    fileName = Left(fileName, fileWidth - 6) & "..."
                ENDIF
                IF fileIdx = m.FileBrowserFileIdx AND m.FileBrowserFocus = FILEBROWSER_FOCUS_FILES THEN
                    fileLine = ">" & fileName
                ELSE
                    fileLine = " " & fileName
                ENDIF
            ENDIF
            DIM fileLinePad AS INTEGER = fileWidth - Len(fileLine)
            IF fileLinePad > 0 THEN
                fileLine = fileLine & strings.Repeat(" ", fileLinePad)
            ENDIF

            contentLines = APPEND(contentLines, " " & dirLine & " | " & fileLine)
        NEXT

        contentLines = APPEND(contentLines, " " & strings.Repeat("-", 56))

        ' Show selected file info
        DIM selectedInfo AS STRING = ""
        IF Len(m.FileBrowserFiles) > 0 AND m.FileBrowserFileIdx < Len(m.FileBrowserFiles) THEN
            selectedInfo = "Selected: " & m.FileBrowserFiles[m.FileBrowserFileIdx]
            IF Len(selectedInfo) > 54 THEN
                selectedInfo = Left(selectedInfo, 51) & "..."
            ENDIF
        ELSE
            selectedInfo = "No files found"
        ENDIF
        contentLines = APPEND(contentLines, " " & selectedInfo)
        contentLines = APPEND(contentLines, "")

        ' Buttons
        DIM openBtn AS STRING = "< Open >"
        DIM cancelBtn AS STRING = "< Cancel >"
        IF m.FileBrowserFocus = FILEBROWSER_FOCUS_BUTTONS THEN
            IF m.FileBrowserBtnIdx = 0 THEN
                openBtn = "[  Open  ]"
            ELSE
                cancelBtn = "[ Cancel ]"
            ENDIF
        ENDIF
        contentLines = APPEND(contentLines, "        " & openBtn & "          " & cancelBtn)
    ELSEIF m.DialogMode = DIALOG_SAVE_AS THEN
        title = " Save As "
        width = 44
        contentLines = APPEND(contentLines, "   File Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 34) & "]")
        contentLines = APPEND(contentLines, "")
        DIM checkMark AS STRING = " "
        IF m.SaveAsWidget THEN
            checkMark = "X"
        ENDIF
        contentLines = APPEND(contentLines, "   [" & checkMark & "] Save as Widget (to plugins/widgets/)")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >         < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_FORM THEN
        title = " New Form "
        width = 40
        contentLines = APPEND(contentLines, "   Form Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >       < Cancel >")
    ELSEIF m.DialogMode = DIALOG_NEW_MODULE THEN
        title = " New Module "
        width = 40
        contentLines = APPEND(contentLines, "   Module Name:")
        contentLines = APPEND(contentLines, "   [" & RenderDialogTextField(m.DialogInput, m.DialogCursor, 30) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "   < OK >       < Cancel >")
    ELSEIF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        title = " Exit "
        width = 36
        contentLines = APPEND(contentLines, "  Project has been modified.")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Exit without saving?")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < Yes (Y) >   < No (N) >")
    ELSEIF m.DialogMode = DIALOG_ENVIRONMENT THEN
        title = " Environment Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Snap to Grid:    [" & IIFStr(m.SnapToGrid, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Grid Size:       [" & PadRight(Str(m.GridSize), 3) & "]")
        contentLines = APPEND(contentLines, "  Auto Save:       [ ]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_EDITOR THEN
        title = " Editor Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Tab Size:        [" & PadRight(Str(m.TabSize), 3) & "]")
        contentLines = APPEND(contentLines, "  Auto Indent:     [" & IIFStr(m.AutoIndent, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Line Numbers:    [" & IIFStr(m.ShowLineNumbers, "X", " ") & "]")
        contentLines = APPEND(contentLines, "  Syntax Highlight:[" & IIFStr(m.SyntaxHighlight, "X", " ") & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_COLORS THEN
        title = " Color Options "
        width = 44
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Color Scheme:")
        contentLines = APPEND(contentLines, "    ( ) Classic Blue")
        contentLines = APPEND(contentLines, "    (o) Dark Mode")
        contentLines = APPEND(contentLines, "    ( ) Light Mode")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >        < Cancel >")
    ELSEIF m.DialogMode = DIALOG_MENU_EDITOR THEN
        title = " Menu Editor "
        width = 50
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Menu Items:                        ")
        contentLines = APPEND(contentLines, "  ┌────────────────────────────────┐ ")
        contentLines = APPEND(contentLines, "  │ &File                          │ ")
        contentLines = APPEND(contentLines, "  │   &New                         │ ")
        contentLines = APPEND(contentLines, "  │   &Open                        │ ")
        contentLines = APPEND(contentLines, "  │   &Save                        │ ")
        contentLines = APPEND(contentLines, "  │   -                            │ ")
        contentLines = APPEND(contentLines, "  │   E&xit                        │ ")
        contentLines = APPEND(contentLines, "  └────────────────────────────────┘ ")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  Caption: [" & PadRight(m.DialogInput, 20) & "]")
        contentLines = APPEND(contentLines, "  Name:    [" & PadRight(m.DialogInput2, 20) & "]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  [Insert] [Delete] [Up] [Down]")
        contentLines = APPEND(contentLines, "")
        contentLines = APPEND(contentLines, "  < OK >            < Cancel >")
    ELSEIF m.DialogMode = DIALOG_OBJECT_BROWSER THEN
        title = " Object Browser "
        width = 70
        contentLines = GetObjectBrowserContent(m)
    ELSEIF m.DialogMode = DIALOG_THEME_EDITOR THEN
        title = " Theme Editor "
        width = 52
        contentLines = GetThemeEditorContent(m)
    ELSEIF m.DialogMode = DIALOG_COLOR_PICKER_256 THEN
        title = " 256-Color Picker "
        width = 40
        contentLines = GetColorPicker256Content(m)
    ENDIF

    ' Build dialog box
    DIM innerWidth AS INTEGER = width - 2
    DIM i AS INTEGER

    ' Raw ANSI codes for theme editor (avoids lipgloss interference with color previews)
    DIM dialogColorStart AS STRING = Chr(27) & "[38;5;252;48;5;237m"
    DIM dialogColorReset AS STRING = Chr(27) & "[0m"
    DIM useRawAnsi AS BOOLEAN = (m.DialogMode = DIALOG_THEME_EDITOR OR m.DialogMode = DIALOG_COLOR_PICKER_256)

    ' Top border with title
    DIM titleStart AS INTEGER = (innerWidth - Len(title)) / 2
    DIM borderTop AS STRING = "╔"
    FOR i = 0 TO innerWidth - 1
        IF i >= titleStart AND i < titleStart + Len(title) THEN
            borderTop = borderTop & Mid(title, i - titleStart + 1, 1)
        ELSE
            borderTop = borderTop & "═"
        ENDIF
    NEXT
    borderTop = borderTop & "╗"
    IF useRawAnsi THEN
        lines = APPEND(lines, dialogColorStart & borderTop & dialogColorReset)
    ELSE
        lines = APPEND(lines, styleDialog.Render(borderTop))
    ENDIF

    ' Content lines (use PadRightDisplay to handle ANSI escape codes correctly)
    FOR i = 0 TO Len(contentLines) - 1
        DIM lineContent AS STRING
        IF useRawAnsi THEN
            ' For theme editor: manually add padding with explicit color codes
            DIM contentWidth AS INTEGER = lipgloss.Width(contentLines[i])
            DIM paddingNeeded AS INTEGER = innerWidth - contentWidth
            IF paddingNeeded < 0 THEN
                paddingNeeded = 0
            ENDIF
            ' Add dialog colors before padding to ensure correct background
            lineContent = contentLines[i] & dialogColorStart & RepeatStr(" ", paddingNeeded)
            lines = APPEND(lines, dialogColorStart & "║" & lineContent & "║" & dialogColorReset)
        ELSE
            lineContent = PadRightDisplay(contentLines[i], innerWidth)
            lines = APPEND(lines, styleDialog.Render("║" & lineContent & "║"))
        ENDIF
    NEXT

    ' Bottom border
    DIM borderBottom AS STRING = "╚"
    FOR i = 1 TO innerWidth
        borderBottom = borderBottom & "═"
    NEXT
    borderBottom = borderBottom & "╝"
    IF useRawAnsi THEN
        lines = APPEND(lines, dialogColorStart & borderBottom & dialogColorReset)
    ELSE
        lines = APPEND(lines, styleDialog.Render(borderBottom))
    ENDIF

    RETURN lines
END FUNCTION

FUNCTION GetDialogSize(m AS VDBTermModel) AS (INTEGER, INTEGER)
    IF m.DialogMode = DIALOG_HELP THEN
        RETURN 50, 21
    ELSEIF m.DialogMode = DIALOG_ABOUT THEN
        RETURN 44, 13
    ELSEIF m.DialogMode = DIALOG_CONFIRM_EXIT THEN
        RETURN 36, 7
    ELSEIF m.DialogMode = DIALOG_NEW_PROJECT OR m.DialogMode = DIALOG_SAVE_PROJECT OR m.DialogMode = DIALOG_NEW_FORM OR m.DialogMode = DIALOG_NEW_MODULE OR m.DialogMode = DIALOG_OPEN_PROJECT THEN
        RETURN 40, 6
    ELSEIF m.DialogMode = DIALOG_SAVE_AS THEN
        RETURN 44, 8
    ELSEIF m.DialogMode = DIALOG_ENVIRONMENT THEN
        RETURN 44, 8
    ELSEIF m.DialogMode = DIALOG_EDITOR THEN
        RETURN 44, 9
    ELSEIF m.DialogMode = DIALOG_COLORS THEN
        RETURN 44, 10
    ELSEIF m.DialogMode = DIALOG_MENU_EDITOR THEN
        RETURN 50, 20
    ELSEIF m.DialogMode = DIALOG_OBJECT_BROWSER THEN
        RETURN 70, 22
    ELSEIF m.DialogMode = DIALOG_COMPILE_ERROR THEN
        RETURN 60, 20
    ELSEIF m.DialogMode = DIALOG_THEME_EDITOR THEN
        RETURN 52, 25
    ELSEIF m.DialogMode = DIALOG_COLOR_PICKER_256 THEN
        RETURN 40, 26
    ELSEIF m.DialogMode = DIALOG_FILE_BROWSER THEN
        RETURN 60, 20
    ENDIF
    RETURN 40, 8
END FUNCTION
