' VDBTerm Code Editing
' Functions for manipulating code in the editor

IMPORT "os/exec" AS exec

FUNCTION SetCodeLine(content AS STRING, lineNum AS INTEGER, newLine AS STRING) AS STRING
    DIM lines AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum THEN
                lines = lines & newLine
            ELSE
                lines = lines & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) THEN
                lines = lines & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN lines
END FUNCTION

FUNCTION InsertCodeCharAt(content AS STRING, lineNum AS INTEGER, col AS INTEGER, ch AS STRING) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)
    DIM newLine AS STRING

    IF col <= 0 THEN
        newLine = ch & line
    ELSEIF col >= Len(line) THEN
        newLine = line & ch
    ELSE
        newLine = Left(line, col) & ch & Mid(line, col + 1, Len(line) - col)
    ENDIF

    RETURN SetCodeLine(content, lineNum, newLine)
END FUNCTION

FUNCTION DeleteCodeCharAt(content AS STRING, lineNum AS INTEGER, col AS INTEGER) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)

    IF col < 0 OR col >= Len(line) THEN
        RETURN content
    ENDIF

    DIM newLine AS STRING
    IF col = 0 THEN
        newLine = Mid(line, 2, Len(line) - 1)
    ELSE
        newLine = Left(line, col) & Mid(line, col + 2, Len(line) - col - 1)
    ENDIF

    RETURN SetCodeLine(content, lineNum, newLine)
END FUNCTION

FUNCTION InsertCodeNewLine(content AS STRING, lineNum AS INTEGER, col AS INTEGER) AS STRING
    DIM line AS STRING = GetLine(content, lineNum)
    DIM beforeCursor AS STRING = Left(line, col)
    DIM afterCursor AS STRING = Mid(line, col + 1, Len(line) - col)

    DIM result AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum THEN
                result = result & beforeCursor & Chr(10) & afterCursor
            ELSE
                result = result & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) AND currentLine <> lineNum THEN
                result = result & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN result
END FUNCTION

FUNCTION JoinCodeWithPrevLine(content AS STRING, lineNum AS INTEGER) AS STRING
    IF lineNum <= 1 THEN
        RETURN content
    ENDIF

    DIM prevLine AS STRING = GetLine(content, lineNum - 1)
    DIM currLine AS STRING = GetLine(content, lineNum)
    DIM joinedLine AS STRING = prevLine & currLine

    DIM result AS STRING = ""
    DIM currentLine AS INTEGER = 1
    DIM i AS INTEGER
    DIM lineStart AS INTEGER = 1

    FOR i = 1 TO Len(content) + 1
        DIM ch AS STRING = ""
        IF i <= Len(content) THEN
            ch = Mid(content, i, 1)
        ENDIF

        IF ch = Chr(10) OR i > Len(content) THEN
            IF currentLine = lineNum - 1 THEN
                result = result & joinedLine
            ELSEIF currentLine <> lineNum THEN
                result = result & Mid(content, lineStart, i - lineStart)
            ENDIF

            IF ch = Chr(10) AND currentLine <> lineNum - 1 AND currentLine <> lineNum THEN
                result = result & Chr(10)
            ELSEIF ch = Chr(10) AND currentLine < lineNum - 1 THEN
                result = result & Chr(10)
            ENDIF

            currentLine = currentLine + 1
            lineStart = i + 1
        ENDIF
    NEXT

    RETURN result
END FUNCTION

' ============================================================================
' RUN AND BUILD
' ============================================================================

FUNCTION DoRun(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded THEN
        m.Message = "No project loaded"
        RETURN m, NIL
    ENDIF

    ' Sync code from textarea to form if in code view
    IF m.CodeEditorInited AND m.CurrentFormIdx < Len(m.Project.Forms) THEN
        m.Project.Forms[m.CurrentFormIdx].Code = GetEditorCode(m.CodeEditor)
    ENDIF

    ' Generate code and save to temp file
    DIM code AS STRING = GenerateCode(m.Project, m.PluginRegistry)
    DIM tempPath AS STRING = "/tmp/" & m.Project.Name & "_run.dbas"
    WriteFile(tempPath, code)

    ' First check for transpiler errors using dbasic emit
    ' Use shell redirection to capture output to a file
    DIM errFile AS STRING = "/tmp/" & m.Project.Name & "_errors.txt"
    DIM checkCmd AS POINTER TO exec.Cmd = exec.Command("sh", "-c", "dbasic emit " & tempPath & " > " & errFile & " 2>&1; echo $? > " & errFile & ".rc")
    checkCmd.Run()

    DIM rcContent AS STRING = ReadFile(errFile & ".rc")
    DIM output AS STRING = ReadFile(errFile)

    ' Check if the return code indicates an error (non-zero)
    IF Trim(rcContent) <> "0" THEN
        ' Transpiler error occurred - show error dialog
        m.CompileErrors = output
        m.CompileErrorScroll = 0
        m.CompileErrorBtnIdx = 0
        m.DialogMode = DIALOG_COMPILE_ERROR
        m.Message = "Transpiler errors found"
        RETURN m, NIL
    ENDIF

    ' Now check for Go compilation errors using dbasic build
    DIM buildFile AS STRING = "/tmp/" & m.Project.Name & "_build_errors.txt"
    DIM builtBinary AS STRING = "/tmp/" & m.Project.Name & "_run"
    DIM buildCmd AS POINTER TO exec.Cmd = exec.Command("sh", "-c", "dbasic build " & tempPath & " -o " & builtBinary & " > " & buildFile & " 2>&1; echo $? > " & buildFile & ".rc")
    buildCmd.Run()

    DIM buildRc AS STRING = ReadFile(buildFile & ".rc")
    DIM buildOutput AS STRING = ReadFile(buildFile)

    ' Check if Go compilation failed
    IF Trim(buildRc) <> "0" THEN
        ' Go compilation error - show error dialog
        m.CompileErrors = buildOutput
        m.CompileErrorScroll = 0
        m.CompileErrorBtnIdx = 0
        m.DialogMode = DIALOG_COMPILE_ERROR
        m.Message = "Build errors found"
        RETURN m, NIL
    ENDIF

    ' No errors - run the built program directly
    DIM execCmd AS tea.Cmd = tea.ExecProcess(exec.Command(builtBinary), NIL)

    m.Message = "Running: " & tempPath
    m.WasRunning = TRUE
    RETURN m, execCmd
END FUNCTION

FUNCTION DoBuild(m AS VDBTermModel) AS (tea.Model, tea.Cmd)
    IF NOT m.ProjectLoaded THEN
        m.Message = "No project loaded"
        RETURN m, NIL
    ENDIF

    DIM code AS STRING = GenerateCode(m.Project, m.PluginRegistry)
    DIM outPath AS STRING = m.Project.Name & ".dbas"
    WriteFile(outPath, code)
    m.Message = "Built: " & outPath
    RETURN m, NIL
END FUNCTION
