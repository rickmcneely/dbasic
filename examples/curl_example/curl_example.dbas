' Curl Example - Simple HTTP Client
' Demonstrates using the HTTP helper functions directly

IMPORT "github.com/charmbracelet/bubbletea" AS tea
IMPORT "github.com/charmbracelet/lipgloss" AS lipgloss
IMPORT "fmt" AS fmt
IMPORT "strings" AS strings
IMPORT "net/http" AS http
IMPORT "io" AS io
IMPORT "bytes" AS bytebuf

' ============================================
' HTTP Helper Functions
' ============================================

' Convert bytes to string using fmt.Sprintf
FUNCTION BytesToString(b AS BYTES) AS STRING
    RETURN fmt.Sprintf("%s", b)
END FUNCTION

' Perform an HTTP request and return response body, status code, and error
FUNCTION CurlFetch(urlStr AS STRING, method AS STRING, body AS STRING) AS (STRING, INTEGER, STRING)
    DIM respBody AS STRING = ""
    DIM statusCode AS INTEGER = 0

    IF urlStr = "" THEN
        RETURN "", 0, "URL is empty"
    ENDIF

    DIM req AS POINTER TO http.Request
    DIM reqErr AS error

    IF body <> "" THEN
        req, reqErr = http.NewRequest(method, urlStr, bytebuf.NewBufferString(body))
    ELSE
        req, reqErr = http.NewRequest(method, urlStr, NIL)
    ENDIF

    IF reqErr <> NIL THEN
        RETURN "", 0, fmt.Sprintf("%v", reqErr)
    ENDIF

    DIM client AS http.Client
    DIM resp AS POINTER TO http.Response
    DIM respErr AS error
    resp, respErr = client.Do(req)
    IF respErr <> NIL THEN
        RETURN "", 0, fmt.Sprintf("%v", respErr)
    ENDIF

    statusCode = (^resp).StatusCode

    DIM bodyBytes AS BYTES
    DIM readErr AS error
    bodyBytes, readErr = io.ReadAll((^resp).Body)
    (^resp).Body.Close()

    IF readErr <> NIL THEN
        RETURN "", statusCode, fmt.Sprintf("%v", readErr)
    ENDIF

    respBody = BytesToString(bodyBytes)
    RETURN respBody, statusCode, ""
END FUNCTION

' Perform a simple GET request
FUNCTION CurlGet(url AS STRING) AS (STRING, INTEGER, STRING)
    RETURN CurlFetch(url, "GET", "")
END FUNCTION

' Perform a simple POST request
FUNCTION CurlPost(url AS STRING, body AS STRING) AS (STRING, INTEGER, STRING)
    RETURN CurlFetch(url, "POST", body)
END FUNCTION

' ============================================
' Application Model
' ============================================

TYPE AppModel IMPLEMENTS tea.Model
    DIM url AS STRING
    DIM response AS STRING
    DIM statusCode AS INTEGER
    DIM errorMsg AS STRING
    DIM loading AS BOOLEAN
    DIM width AS INTEGER
    DIM height AS INTEGER
END TYPE

FUNCTION (m AS AppModel) Init() AS tea.Cmd
    RETURN NIL
END FUNCTION

FUNCTION (m AS AppModel) Update(msg AS tea.Msg) AS (tea.Model, tea.Cmd)
    DIM keyMsg AS tea.KeyMsg
    DIM ok AS BOOLEAN
    keyMsg, ok = msg.(tea.KeyMsg)

    IF ok THEN
        DIM key AS STRING = keyMsg.String()
        IF key = "q" OR key = "ctrl+c" THEN
            RETURN m, tea.Quit
        ELSEIF key = "enter" THEN
            ' Fetch the URL
            m.loading = TRUE
            DIM fetchResp AS STRING
            DIM fetchCode AS INTEGER
            DIM fetchErr AS STRING
            fetchResp, fetchCode, fetchErr = CurlGet(m.url)
            m.response = fetchResp
            m.statusCode = fetchCode
            m.errorMsg = fetchErr
            m.loading = FALSE
        ELSEIF key = "1" THEN
            m.url = "https://httpbin.org/get"
            m.response = ""
            m.errorMsg = ""
        ELSEIF key = "2" THEN
            m.url = "https://httpbin.org/ip"
            m.response = ""
            m.errorMsg = ""
        ELSEIF key = "3" THEN
            m.url = "https://httpbin.org/user-agent"
            m.response = ""
            m.errorMsg = ""
        ENDIF
    ENDIF

    DIM sizeMsg AS tea.WindowSizeMsg
    DIM sizeOk AS BOOLEAN
    sizeMsg, sizeOk = msg.(tea.WindowSizeMsg)
    IF sizeOk THEN
        m.width = Int(sizeMsg.Width)
        m.height = Int(sizeMsg.Height)
    ENDIF

    RETURN m, NIL
END FUNCTION

FUNCTION (m AS AppModel) View() AS STRING
    DIM titleStyle AS lipgloss.Style = lipgloss.NewStyle().Bold(TRUE).Foreground(lipgloss.Color("10"))
    DIM urlStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("14"))
    DIM errorStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("9"))
    DIM successStyle AS lipgloss.Style = lipgloss.NewStyle().Foreground(lipgloss.Color("10"))

    DIM output AS STRING = ""
    output = output & titleStyle.Render("Curl Example - HTTP Client") & Chr(10)
    output = output & strings.Repeat("-", 40) & Chr(10)
    output = output & Chr(10)
    output = output & "Current URL: " & urlStyle.Render(m.url) & Chr(10)
    output = output & Chr(10)
    output = output & "Press [1] httpbin.org/get" & Chr(10)
    output = output & "Press [2] httpbin.org/ip" & Chr(10)
    output = output & "Press [3] httpbin.org/user-agent" & Chr(10)
    output = output & "Press [Enter] to fetch" & Chr(10)
    output = output & "Press [q] to quit" & Chr(10)
    output = output & Chr(10)

    IF m.loading THEN
        output = output & "Loading..." & Chr(10)
    ELSEIF m.errorMsg <> "" THEN
        output = output & errorStyle.Render("Error: " & m.errorMsg) & Chr(10)
    ELSEIF m.statusCode > 0 THEN
        output = output & successStyle.Render("Status: HTTP " & fmt.Sprintf("%d", m.statusCode)) & Chr(10)
        output = output & Chr(10)
        output = output & "Response:" & Chr(10)
        output = output & m.response & Chr(10)
    ENDIF

    RETURN output
END FUNCTION

SUB Main()
    DIM model AS AppModel
    model.url = "https://httpbin.org/get"
    model.loading = FALSE

    tea.NewProgram(model, tea.WithAltScreen()).Run()
END SUB
