' =============================================================================
' GAGALA - the 1981 Namco arcade classic, rebuilt
' =============================================================================
'
' Written in DBasic, drawn with Ebitengine.
'
' WHAT THIS PROGRAM IS
'   Gagala plays the game Namco released in 1981: a fighter at the bottom of
'   a tall screen, waves of insect-like aliens that fly in along looping
'   paths, settle into a formation, and then peel off one at a time to dive
'   at you.
'
'   (The arcade one is called Galaga. That name is Namco's, so ours is
'   Gagala -- same game, different badge.)
'
'   The things that make Galaga *Galaga*, all of which are here:
'     * The screen is 224x288 - taller than it is wide, like the real
'       cabinet - and everything is drawn at that size, then scaled up
'     * Three layers of stars drifting down at different speeds, blinking
'     * A 40-strong formation: 4 Boss Galaga, 16 Butterflies, 20 Bees
'     * Enemies fly in along curving paths in groups, they do not just
'       appear in place
'     * The formation breathes - swaying side to side and in and out
'     * Enemies dive at you in loops, dropping bombs
'     * You may only have TWO shots on screen at once. This is the single
'       rule that shapes how Galaga is played.
'     * A Boss Galaga can drop a tractor beam and steal your fighter. Shoot
'       that boss while it holds your fighter and you get it back - flying
'       alongside you, firing twice as fast
'     * Challenging Stages every four levels: 40 enemies fly through in
'       patterns and never shoot back
'     * The real scoring table, where a diving enemy is worth more than one
'       sitting in formation, and a boss with two escorts is worth 1600
'     * The end-of-game shots-fired / hits / hit-miss ratio
'
' HOW THE PROGRAM IS ORGANISED (read in this order)
'   1. CONSTANTS   - screen size, colours, the numbers that define the game
'   2. TYPES       - the shapes of our data (an enemy, a bullet, the game)
'   3. ART         - every sprite and letter, drawn once at start-up
'   4. SOUND       - the arcade bleeps, generated as square waves
'   5. STARFIELD   - the drifting background
'   6. PATHS       - the curved flight paths, and how enemies follow them
'   7. FORMATION   - where the 40 enemies live when they are not attacking
'   8. ENEMIES     - entering, breathing, diving, the tractor beam
'   9. PLAYER      - moving, shooting, dying, the dual fighter
'  10. COLLISIONS  - what hits what, and what it scores
'  11. STAGES      - building a wave, challenging stages, between-stage flow
'  12. DRAWING     - painting the screen
'  13. MAIN        - starts everything up
'
' CONTROLS
'   Left / Right ......... move
'   Space or Z ........... fire
'   1 .................... insert coin and start
'   Esc .................. quit
'   P .................... pause
' =============================================================================


' ======================== IMPORTS ========================

' Ebitengine: the window, the game loop, and drawing.
IMPORT "github.com/hajimehoshi/ebiten/v2" AS ebiten

' vector: filled rectangles and circles.
IMPORT "github.com/hajimehoshi/ebiten/v2/vector" AS vector

' inpututil: tells us the exact moment a key goes down, as opposed to
' whether it is being held.
IMPORT "github.com/hajimehoshi/ebiten/v2/inpututil" AS inpututil

' audio: plays the sound effects we generate.
IMPORT "github.com/hajimehoshi/ebiten/v2/audio" AS audio

' colour, text and numbers.
IMPORT "image/color" AS color
IMPORT "strings" AS strings
IMPORT "strconv" AS strconv
IMPORT "fmt" AS fmt
IMPORT "math" AS math

' os and filepath: to keep the high score somewhere permanent.
IMPORT "os" AS os
IMPORT "path/filepath" AS filepath


' ======================== 1. CONSTANTS ========================

' --- The screen ---
' The real cabinet ran a 224x288 display turned on its side. We draw at
' exactly that size and let Ebitengine scale it up, so every measurement
' below is an arcade pixel.
CONST SCRW AS INTEGER = 224
CONST SCRH AS INTEGER = 288

' Almost everything in the game sits on an 8x8 grid, as it did in 1981.
CONST TILE AS INTEGER = 8

' --- The player ---
CONST PLAYER_Y AS INTEGER = 250      ' how far down the fighter sits
CONST PLAYER_SPEED AS DOUBLE = 1.35  ' pixels per frame
CONST PLAYER_MINX AS INTEGER = 16
CONST PLAYER_MAXX AS INTEGER = 208
CONST DUAL_GAP AS INTEGER = 16       ' spacing between the two dual fighters

' THE most important number in Galaga: you may have two shots in the air at
' once, and no more. Everything about how the game is played comes from it.
CONST MAX_SHOTS AS INTEGER = 2
CONST SHOT_SPEED AS DOUBLE = 4.0
CONST BOMB_SPEED AS DOUBLE = 1.6

CONST START_LIVES AS INTEGER = 3
CONST EXTRA_FIRST AS INTEGER = 20000  ' first extra fighter
CONST EXTRA_EVERY AS INTEGER = 70000  ' and one every this many after

' --- The enemies ---
CONST E_BEE AS INTEGER = 0        ' Zako   - the yellow/blue ones, 20 of them
CONST E_BUTTERFLY AS INTEGER = 1  ' Goei   - the red/white ones, 16 of them
CONST E_BOSS AS INTEGER = 2       ' Boss Galaga - the flagship, 4 of them

' What an enemy is doing right now.
CONST ES_GONE AS INTEGER = 0      ' dead, or not yet used
CONST ES_ENTER AS INTEGER = 1     ' flying in along its entry path
CONST ES_FORM AS INTEGER = 2      ' sitting in the formation, breathing
CONST ES_DIVE AS INTEGER = 3      ' peeled off and attacking
CONST ES_RETURN AS INTEGER = 4    ' flying back up to rejoin the formation
CONST ES_BEAM AS INTEGER = 5      ' a boss hovering with its tractor beam out
CONST ES_DYING AS INTEGER = 6     ' mid-explosion
CONST ES_CAPTURED AS INTEGER = 7  ' a stolen fighter, riding under a boss
CONST ES_WAIT AS INTEGER = 8      ' queued up off-screen, waiting to fly in

' The formation is 10 columns by 5 rows, though not every slot is used.
CONST FORM_COLS AS INTEGER = 10
CONST FORM_ROWS AS INTEGER = 5
CONST FORM_XSPACE AS INTEGER = 16
CONST FORM_YSPACE AS INTEGER = 16
CONST FORM_TOP AS INTEGER = 48    ' y of the top row when the formation is home
CONST ENEMY_COUNT AS INTEGER = 40 ' 4 bosses + 16 butterflies + 20 bees

' --- Scoring, straight from the arcade manual ---
CONST SC_BEE_FORM AS INTEGER = 50
CONST SC_BEE_DIVE AS INTEGER = 100
CONST SC_BUT_FORM AS INTEGER = 80
CONST SC_BUT_DIVE AS INTEGER = 160
CONST SC_BOSS_FORM AS INTEGER = 150
CONST SC_BOSS_DIVE AS INTEGER = 400    ' diving alone
CONST SC_BOSS_ONE AS INTEGER = 800     ' diving with one escort
CONST SC_BOSS_TWO AS INTEGER = 1600    ' diving with two escorts
CONST SC_CHALLENGE AS INTEGER = 100    ' each hit in a Challenging Stage
CONST SC_PERFECT AS INTEGER = 10000    ' all 40 in a Challenging Stage

' --- Game states ---
CONST GS_ATTRACT AS INTEGER = 0      ' the title screen, waiting for a coin
CONST GS_START AS INTEGER = 1        ' "PLAYER 1" then "STAGE 1"
CONST GS_READY AS INTEGER = 2        ' formation flying in
CONST GS_PLAY AS INTEGER = 3         ' the game itself
CONST GS_DYING AS INTEGER = 4        ' the fighter has been hit
CONST GS_CLEAR AS INTEGER = 5        ' wave destroyed, next stage coming
CONST GS_RESULT AS INTEGER = 6       ' Challenging Stage results
CONST GS_OVER AS INTEGER = 7         ' GAME OVER, then the shooting stats

' How long the various announcements stay on screen, in frames (60 = 1s).
CONST T_PLAYER AS INTEGER = 110
CONST T_STAGE AS INTEGER = 110
CONST T_CLEAR AS INTEGER = 90
CONST T_DYING AS INTEGER = 110
CONST T_OVER AS INTEGER = 180
CONST T_RESULT AS INTEGER = 240

' A Challenging Stage happens on stage 3 and then every four stages after.
CONST CHALLENGE_FIRST AS INTEGER = 3
CONST CHALLENGE_EVERY AS INTEGER = 4


' ======================== 2. TYPES ========================

' One leg of a flight path.
'
' HOW THE FLIGHT PATHS WORK
'   The arcade machine did not store a list of positions for every swoop.
'   It stored instructions: "turn 3 degrees left every frame for 40 frames,
'   then fly straight for 20". Follow those with a pen and you draw a loop.
'   That is exactly what we do, and it is why the paths curve so smoothly
'   and why a long loop costs no more memory than a short one.
TYPE PathSeg
    DIM Turn AS DOUBLE      ' degrees to turn each frame (+ or -)
    DIM Frames AS INTEGER   ' how many frames to keep turning for
END TYPE

' One of the forty aliens.
TYPE Enemy
    DIM Kind AS INTEGER      ' E_BEE / E_BUTTERFLY / E_BOSS
    DIM St AS INTEGER        ' ES_* - what it is doing
    DIM X AS DOUBLE          ' where it is, in arcade pixels
    DIM Y AS DOUBLE
    DIM Ang AS DOUBLE        ' heading, in degrees. 0 points straight down.
    DIM Spd AS DOUBLE        ' pixels per frame
    DIM Slot AS INTEGER      ' which formation position it belongs to
    DIM Hits AS INTEGER      ' a Boss Galaga survives the first hit
    DIM Path AS []PathSeg    ' the flight it is currently following
    DIM Leg AS INTEGER       ' which leg of that path it is on
    DIM LegT AS INTEGER      ' how many frames it has spent on this leg
    DIM Timer AS INTEGER     ' general purpose countdown
    DIM Anim AS INTEGER      ' animation frame counter
    DIM Captive AS BOOLEAN   ' TRUE if this boss is carrying your fighter
    DIM Escorts AS INTEGER   ' escorts that dived with it, for scoring
    DIM Shoots AS BOOLEAN    ' allowed to drop bombs on this dive
    DIM Entry AS INTEGER     ' which entry route it flies in on
    DIM Boss AS INTEGER      ' the boss this one is escorting, or -1
END TYPE

' A shot, whether it is yours going up or a bomb coming down.
TYPE Shot
    DIM Live AS BOOLEAN
    DIM X AS DOUBLE
    DIM Y AS DOUBLE
    DIM VX AS DOUBLE
    DIM VY AS DOUBLE
END TYPE

' One star in the drifting background.
TYPE Star
    DIM X AS DOUBLE
    DIM Y AS DOUBLE
    DIM Spd AS DOUBLE        ' the three layers move at different speeds
    DIM Clr AS INTEGER       ' index into the star palette
    DIM Blink AS INTEGER     ' where this star is in its blink cycle
END TYPE

' An explosion.
TYPE Boom
    DIM Live AS BOOLEAN
    DIM X AS DOUBLE
    DIM Y AS DOUBLE
    DIM T AS INTEGER         ' frames since it started
    DIM Player AS BOOLEAN    ' the fighter blows up differently to an alien
END TYPE

' The little score number that floats where an enemy died.
TYPE Popup
    DIM Live AS BOOLEAN
    DIM X AS DOUBLE
    DIM Y AS DOUBLE
    DIM T AS INTEGER
    DIM Pts AS INTEGER
END TYPE

' Everything the game knows, in one place.
TYPE Game
    ' --- overall state ---
    DIM St AS INTEGER            ' GS_* - which part of the game we are in
    DIM Timer AS INTEGER         ' counts down the announcements
    DIM Frame AS INTEGER         ' frames since the program started
    DIM Paused AS BOOLEAN

    ' --- the player ---
    DIM PX AS DOUBLE             ' fighter position
    DIM Lives AS INTEGER
    DIM Score AS INTEGER
    DIM HiScore AS INTEGER
    DIM NextExtra AS INTEGER     ' score at which the next spare fighter comes
    DIM Dual AS BOOLEAN          ' TRUE when flying the rescued double fighter
    DIM Alive AS BOOLEAN
    DIM Captured AS BOOLEAN      ' your fighter is currently held by a boss

    ' --- the wave ---
    DIM Stage AS INTEGER
    DIM Challenge AS BOOLEAN     ' is this stage a Challenging Stage?
    DIM Foe AS []Enemy
    DIM Entering AS INTEGER      ' how many are still flying in
    DIM FormX AS DOUBLE          ' the formation's sway, in pixels
    DIM FormDir AS DOUBLE
    DIM FormSpread AS DOUBLE     ' how far the formation has breathed outward
    DIM SpreadDir AS DOUBLE
    DIM DiveTimer AS INTEGER     ' frames until the next attack is launched
    DIM ChalHits AS INTEGER      ' hits scored in a Challenging Stage
    DIM BeamIdx AS INTEGER       ' the boss currently working its beam, or -1
    DIM Respawn AS INTEGER       ' frames until the next fighter launches
    DIM RescueOn AS BOOLEAN      ' a freed fighter is on its way down to you
    DIM RescueX AS DOUBLE
    DIM RescueY AS DOUBLE
    DIM CapAnim AS INTEGER       ' frames left of the fighter rising up the beam
    DIM CapX AS DOUBLE           ' where it started from
    DIM CapBoss AS INTEGER       ' the boss hauling it up

    ' --- things flying about ---
    DIM Shots AS []Shot          ' yours
    DIM Bombs AS []Shot          ' theirs
    DIM Booms AS []Boom
    DIM Pops AS []Popup
    DIM Stars AS []Star

    ' --- the shooting statistics shown at the end ---
    DIM Fired AS INTEGER
    DIM Hit AS INTEGER

    ' --- where the high score lives ---
    DIM ScFile AS STRING

    ' --- sound ---
    DIM SndFire AS POINTER TO audio.Player
    DIM SndBoom AS POINTER TO audio.Player
    DIM SndDie AS POINTER TO audio.Player
    DIM SndDive AS POINTER TO audio.Player
    DIM SndBeam AS POINTER TO audio.Player
    DIM SndRescue AS POINTER TO audio.Player
    DIM SndExtra AS POINTER TO audio.Player
    DIM SndStart AS POINTER TO audio.Player
    DIM SndCoin AS POINTER TO audio.Player
    DIM Sound AS BOOLEAN
END TYPE

' The one and only audio context.
DIM GAudio AS POINTER TO audio.Context


' ======================== 3. ART ========================
'
' Every picture in the game is written out as text, one character per pixel,
' and turned into a real image once when the program starts. After that we
' just stamp copies of those images onto the screen.
'
' In the picture data below:
'     .  leave this pixel alone (see-through)
'     W  white      R  red        Y  yellow     B  blue
'     G  green      C  cyan       M  magenta    O  orange
'     P  purple     K  black      D  dark blue  S  silver

DIM CWhite AS color.RGBA = color.RGBA{R: 255, G: 255, B: 255, A: 255}
DIM CRed AS color.RGBA = color.RGBA{R: 255, G: 32, B: 32, A: 255}
DIM CYellow AS color.RGBA = color.RGBA{R: 255, G: 216, B: 0, A: 255}
DIM CBlue AS color.RGBA = color.RGBA{R: 60, G: 120, B: 255, A: 255}
DIM CGreen AS color.RGBA = color.RGBA{R: 32, G: 220, B: 64, A: 255}
DIM CCyan AS color.RGBA = color.RGBA{R: 0, G: 232, B: 232, A: 255}
DIM CMagenta AS color.RGBA = color.RGBA{R: 255, G: 96, B: 200, A: 255}
DIM COrange AS color.RGBA = color.RGBA{R: 255, G: 144, B: 32, A: 255}
DIM CPurple AS color.RGBA = color.RGBA{R: 176, G: 96, B: 255, A: 255}
DIM CBlack AS color.RGBA = color.RGBA{R: 0, G: 0, B: 0, A: 255}
DIM CDark AS color.RGBA = color.RGBA{R: 24, G: 40, B: 160, A: 255}
DIM CSilver AS color.RGBA = color.RGBA{R: 190, G: 190, B: 200, A: 255}

' PixColor turns one of those letters into a real colour.
FUNCTION PixColor(ch AS STRING) AS color.RGBA
    SELECT CASE ch
        CASE "W"
            RETURN CWhite
        CASE "R"
            RETURN CRed
        CASE "Y"
            RETURN CYellow
        CASE "B"
            RETURN CBlue
        CASE "G"
            RETURN CGreen
        CASE "C"
            RETURN CCyan
        CASE "M"
            RETURN CMagenta
        CASE "O"
            RETURN COrange
        CASE "P"
            RETURN CPurple
        CASE "K"
            RETURN CBlack
        CASE "D"
            RETURN CDark
        CASE "S"
            RETURN CSilver
    END SELECT
    RETURN CWhite
END FUNCTION

' MakeSprite turns a block of picture text into an image.
FUNCTION MakeSprite(rows AS []STRING) AS POINTER TO ebiten.Image
    DIM h AS INTEGER = Len(rows)
    IF h = 0 THEN
        RETURN ebiten.NewImage(1, 1)
    ENDIF
    DIM w AS INTEGER = Len(rows[0])
    DIM img AS POINTER TO ebiten.Image = ebiten.NewImage(w, h)
    DIM r AS INTEGER
    DIM c AS INTEGER
    FOR r = 0 TO h - 1
        FOR c = 0 TO Len(rows[r]) - 1
            DIM ch AS STRING = Mid(rows[r], c + 1, 1)
            IF ch <> "." AND ch <> " " THEN
                vector.DrawFilledRect(img, Sng(c), Sng(r), Sng(1), Sng(1), PixColor(ch), FALSE)
            ENDIF
        NEXT
    NEXT
    RETURN img
END FUNCTION


' --- The letters ---
'
' A 5x7 alphabet, drawn the same blocky way the arcade machine did it. The
' glyphs are stored in white and tinted to whatever colour we need when they
' are drawn, so one set of pictures covers every colour of text in the game.

FUNCTION GlyphRows(ch AS STRING) AS []STRING
    SELECT CASE ch
        CASE "A"
            RETURN []STRING{".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"}
        CASE "B"
            RETURN []STRING{"####.", "#...#", "#...#", "####.", "#...#", "#...#", "####."}
        CASE "C"
            RETURN []STRING{".###.", "#...#", "#....", "#....", "#....", "#...#", ".###."}
        CASE "D"
            RETURN []STRING{"####.", "#...#", "#...#", "#...#", "#...#", "#...#", "####."}
        CASE "E"
            RETURN []STRING{"#####", "#....", "#....", "###..", "#....", "#....", "#####"}
        CASE "F"
            RETURN []STRING{"#####", "#....", "#....", "###..", "#....", "#....", "#...."}
        CASE "G"
            RETURN []STRING{".###.", "#...#", "#....", "#.###", "#...#", "#...#", ".###."}
        CASE "H"
            RETURN []STRING{"#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"}
        CASE "I"
            RETURN []STRING{".###.", "..#..", "..#..", "..#..", "..#..", "..#..", ".###."}
        CASE "J"
            RETURN []STRING{"..###", "...#.", "...#.", "...#.", "...#.", "#..#.", ".##.."}
        CASE "K"
            RETURN []STRING{"#...#", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "#...#"}
        CASE "L"
            RETURN []STRING{"#....", "#....", "#....", "#....", "#....", "#....", "#####"}
        CASE "M"
            RETURN []STRING{"#...#", "##.##", "#.#.#", "#.#.#", "#...#", "#...#", "#...#"}
        CASE "N"
            RETURN []STRING{"#...#", "##..#", "#.#.#", "#.#.#", "#..##", "#...#", "#...#"}
        CASE "O"
            RETURN []STRING{".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."}
        CASE "P"
            RETURN []STRING{"####.", "#...#", "#...#", "####.", "#....", "#....", "#...."}
        CASE "Q"
            RETURN []STRING{".###.", "#...#", "#...#", "#...#", "#.#.#", "#..#.", ".##.#"}
        CASE "R"
            RETURN []STRING{"####.", "#...#", "#...#", "####.", "#.#..", "#..#.", "#...#"}
        CASE "S"
            RETURN []STRING{".####", "#....", "#....", ".###.", "....#", "....#", "####."}
        CASE "T"
            RETURN []STRING{"#####", "..#..", "..#..", "..#..", "..#..", "..#..", "..#.."}
        CASE "U"
            RETURN []STRING{"#...#", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."}
        CASE "V"
            RETURN []STRING{"#...#", "#...#", "#...#", "#...#", "#...#", ".#.#.", "..#.."}
        CASE "W"
            RETURN []STRING{"#...#", "#...#", "#...#", "#.#.#", "#.#.#", "##.##", "#...#"}
        CASE "X"
            RETURN []STRING{"#...#", "#...#", ".#.#.", "..#..", ".#.#.", "#...#", "#...#"}
        CASE "Y"
            RETURN []STRING{"#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#.."}
        CASE "Z"
            RETURN []STRING{"#####", "....#", "...#.", "..#..", ".#...", "#....", "#####"}
        CASE "0"
            RETURN []STRING{".###.", "#...#", "#..##", "#.#.#", "##..#", "#...#", ".###."}
        CASE "1"
            RETURN []STRING{"..#..", ".##..", "..#..", "..#..", "..#..", "..#..", ".###."}
        CASE "2"
            RETURN []STRING{".###.", "#...#", "....#", "...#.", "..#..", ".#...", "#####"}
        CASE "3"
            RETURN []STRING{"#####", "...#.", "..#..", "...#.", "....#", "#...#", ".###."}
        CASE "4"
            RETURN []STRING{"...#.", "..##.", ".#.#.", "#..#.", "#####", "...#.", "...#."}
        CASE "5"
            RETURN []STRING{"#####", "#....", "####.", "....#", "....#", "#...#", ".###."}
        CASE "6"
            RETURN []STRING{"..##.", ".#...", "#....", "####.", "#...#", "#...#", ".###."}
        CASE "7"
            RETURN []STRING{"#####", "....#", "...#.", "..#..", ".#...", ".#...", ".#..."}
        CASE "8"
            RETURN []STRING{".###.", "#...#", "#...#", ".###.", "#...#", "#...#", ".###."}
        CASE "9"
            RETURN []STRING{".###.", "#...#", "#...#", ".####", "....#", "...#.", ".##.."}
        CASE "-"
            RETURN []STRING{".....", ".....", ".....", "#####", ".....", ".....", "....."}
        CASE "."
            RETURN []STRING{".....", ".....", ".....", ".....", ".....", ".##..", ".##.."}
        CASE ","
            RETURN []STRING{".....", ".....", ".....", ".....", ".##..", ".##..", ".#..."}
        CASE "!"
            RETURN []STRING{"..#..", "..#..", "..#..", "..#..", "..#..", ".....", "..#.."}
        CASE "/"
            RETURN []STRING{"....#", "...#.", "..#..", "..#..", ".#...", "#....", "#...."}
        CASE ":"
            RETURN []STRING{".....", ".##..", ".##..", ".....", ".##..", ".##..", "....."}
        CASE "'"
            RETURN []STRING{"..#..", "..#..", ".....", ".....", ".....", ".....", "....."}
    END SELECT
    RETURN []STRING{".....", ".....", ".....", ".....", ".....", ".....", "....."}
END FUNCTION


' --- The sprites ---
'
' All 16 pixels square, the size the arcade used.
'
' WHICH WAY THE PICTURES POINT
'   Aliens are drawn pointing DOWN the screen, because that is the way they
'   face while sitting in the formation, and because a heading of zero means
'   "down" everywhere else in this program. So an alien flying on heading a
'   is simply its picture turned by a.
'
'   Your fighter is the exception: it is drawn pointing UP, because that is
'   the only way it ever faces. Draw it with NO turn at all. Turning it by
'   180 leaves it flying nose-down, which is exactly the bug that used to be
'   here. The one place the fighter IS turned upside down is when a Boss
'   Galaga has captured it and is carrying it slung beneath itself.

FUNCTION FighterRows() AS []STRING
    RETURN []STRING{ _
        "................", _
        "................", _
        ".......WW.......", _
        ".......WW.......", _
        "......WWWW......", _
        "......WWWW......", _
        "......WWWW......", _
        ".....WWWWWW.....", _
        ".....WWWWWW.....", _
        "..R..WWWWWW..R..", _
        "..RW.WWWWWW.WR..", _
        ".RRWWWWWWWWWWRR.", _
        ".RRWWWWWWWWWWRR.", _
        ".RRWWWW..WWWWRR.", _
        ".RR.WW....WW.RR.", _
        "..R..........R.."}
END FUNCTION

' The Bee - "Zako" in the arcade. Twenty of them, the bottom two rows of
' the formation. Yellow body, blue wings.
FUNCTION BeeRows(frame AS INTEGER) AS []STRING
    IF frame = 0 THEN
        RETURN []STRING{ _
            "................", _
            "................", _
            "..B..........B..", _
            "...B........B...", _
            "....BB....BB....", _
            "....BYYYYYYB....", _
            "...BBYYYYYYBB...", _
            "..BB.YWYYWY.BB..", _
            "..BB.YYYYYY.BB..", _
            "...BB.YYYY.BB...", _
            "....B.YYYY.B....", _
            "......YYYY......", _
            ".......YY.......", _
            "................", _
            "................", _
            "................"}
    ENDIF
    RETURN []STRING{ _
        "................", _
        "...B........B...", _
        "....B......B....", _
        "....BB....BB....", _
        ".....BYYYYB.....", _
        "...BBYYYYYYBB...", _
        "..BBBYYYYYYBBB..", _
        "..BB.YWYYWY.BB..", _
        "...B.YYYYYY.B...", _
        "......YYYY......", _
        "......YYYY......", _
        ".......YY.......", _
        "................", _
        "................", _
        "................", _
        "................"}
END FUNCTION

' The Butterfly - "Goei". Sixteen of them, the middle two rows. Red body,
' white wings.
FUNCTION ButterflyRows(frame AS INTEGER) AS []STRING
    IF frame = 0 THEN
        RETURN []STRING{ _
            "................", _
            "..R..........R..", _
            "...R........R...", _
            "...RR......RR...", _
            "..RWWR.RR.RWWR..", _
            ".RWWWWRRRRWWWWR.", _
            ".RWWW.RRRR.WWWR.", _
            ".RWW..RRRR..WWR.", _
            "..R...RWWR...R..", _
            "......RWWR......", _
            "......RRRR......", _
            ".......RR.......", _
            "................", _
            "................", _
            "................", _
            "................"}
    ENDIF
    RETURN []STRING{ _
        "................", _
        "...R........R...", _
        "....R......R....", _
        "....RR....RR....", _
        "...RWWR.RRWWR...", _
        "..RWWWWRRWWWWR..", _
        "..RWWW.RR.WWWR..", _
        "...RW..RR..WR...", _
        "......RWWR......", _
        "......RWWR......", _
        "......RRRR......", _
        ".......RR.......", _
        "................", _
        "................", _
        "................", _
        "................"}
END FUNCTION

' The Boss Galaga - the flagship. Four of them, along the top row. It takes
' TWO hits: the first one costs it its green and leaves it purple.
FUNCTION BossRows(frame AS INTEGER) AS []STRING
    IF frame = 0 THEN
        RETURN []STRING{ _
            "................", _
            "..GG......GG....", _
            "...GG....GG.....", _
            "....GGGGGG......", _
            "..BBGGGGGGBB....", _
            ".BBBGGGGGGBBB...", _
            ".BB.GGWGGWG.BB..", _
            ".BB.GGGGGGG.BB..", _
            "..B..GGGGGG..B..", _
            ".....GGGGGG.....", _
            "......GGGG......", _
            ".......GG.......", _
            "................", _
            "................", _
            "................", _
            "................"}
    ENDIF
    RETURN []STRING{ _
        "................", _
        "...GG....GG.....", _
        "....GG..GG......", _
        "....GGGGGG......", _
        "...BGGGGGGB.....", _
        "..BBGGGGGGBB....", _
        "..BBGGWGGWGBB...", _
        "..BBGGGGGGGBB...", _
        "...B.GGGGGG.B...", _
        ".....GGGGGG.....", _
        "......GGGG......", _
        ".......GG.......", _
        "................", _
        "................", _
        "................", _
        "................"}
END FUNCTION

' Recolour swaps one colour letter for another everywhere in a picture. It
' is how the damaged Boss Galaga is made: the same drawing with its green
' turned purple, rather than a whole second set of pictures.
FUNCTION Recolour(rows AS []STRING, fromCh AS STRING, toCh AS STRING) AS []STRING
    DIM out AS []STRING
    DIM i AS INTEGER
    FOR i = 0 TO Len(rows) - 1
        out = APPEND(out, strings.ReplaceAll(rows[i], fromCh, toCh))
    NEXT
    RETURN out
END FUNCTION

' Your shot, and their bomb.
FUNCTION ShotRows() AS []STRING
    RETURN []STRING{"WW", "WW", "WW", "YY", "YY", "WW"}
END FUNCTION

FUNCTION BombRows() AS []STRING
    RETURN []STRING{".CC.", "CWWC", "CWWC", ".CC."}
END FUNCTION

' The explosion an alien makes: a little flower that opens and fades.
FUNCTION BoomRows(frame AS INTEGER) AS []STRING
