                "....R.OYYO.R....", _
                ".....R.OO.R.....", _
                "......R..R......", _
                ".......RR.......", _
                "................", _
                "................"}
        CASE 3
            RETURN []STRING{ _
                "................", _
                "..R..........R..", _
                "...R...RR...R...", _
                "....R.R..R.R....", _
                ".....R....R.....", _
                "....R..OO..R....", _
                "...R..O..O..R...", _
                "..RR.O....O.RR..", _
                "..RR.O....O.RR..", _
                "...R..O..O..R...", _
                "....R..OO..R....", _
                ".....R....R.....", _
                "....R.R..R.R....", _
                "...R...RR...R...", _
                "..R..........R..", _
